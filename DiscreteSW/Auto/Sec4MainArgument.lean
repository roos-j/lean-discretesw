open MeasureTheory Set Real Finset
open scoped FourierTransform ContDiff SchwartzMap

variable {n : ℕ}

/-! ### The cutoffs `χ` and `χ̃` -/

/-- `χ̃ = θ = companionCutoff n` is even. -/
lemma companionCutoff_neg (ξ : EuclideanSpace ℝ (Fin n)) :
    companionCutoff n (-ξ) = companionCutoff n ξ := by
  unfold companionCutoff
  refine Finset.prod_congr rfl fun i _ => ?_
  rw [PiLp.neg_apply]
  exact companionBump.neg _

/-- The smooth real even product cutoff `χ(ξ) = θ(2ξ) = ∏ᵢ ψ(2ξᵢ)` of the §9 setup: `0 ≤ χ ≤ 1`,
`χ = 1` on `[-1/2,1/2]ⁿ`, `supp χ ⊆ [-1,1]ⁿ`. -/
noncomputable def liftCutoff (n : ℕ) (ξ : EuclideanSpace ℝ (Fin n)) : ℝ :=
  companionCutoff n ((2 : ℝ) • ξ)

/-- `χ` is a product cutoff: `χ(ξ) = ∏ᵢ ψ(2ξᵢ)`. -/
lemma liftCutoff_eq_prod (ξ : EuclideanSpace ℝ (Fin n)) :
    liftCutoff n ξ = ∏ i, companionBump (2 * ξ i) := by
  simp [liftCutoff, companionCutoff, PiLp.smul_apply, smul_eq_mul]

lemma liftCutoff_nonneg (ξ : EuclideanSpace ℝ (Fin n)) : 0 ≤ liftCutoff n ξ :=
  companionCutoff_nonneg _

lemma liftCutoff_le_one (ξ : EuclideanSpace ℝ (Fin n)) : liftCutoff n ξ ≤ 1 :=
  companionCutoff_le_one _

lemma liftCutoff_neg (ξ : EuclideanSpace ℝ (Fin n)) : liftCutoff n (-ξ) = liftCutoff n ξ := by
  rw [liftCutoff, smul_neg, companionCutoff_neg, liftCutoff]

lemma liftCutoff_eq_one {ξ : EuclideanSpace ℝ (Fin n)} (h : ∀ i, |ξ i| ≤ 1 / 2) :
    liftCutoff n ξ = 1 :=
  companionCutoff_eq_one fun i => by
    rw [PiLp.smul_apply, smul_eq_mul, abs_mul, abs_two]
    linarith [h i]

lemma liftCutoff_eq_zero {ξ : EuclideanSpace ℝ (Fin n)} (h : ¬ ∀ i, |ξ i| < 1) :
    liftCutoff n ξ = 0 := by
  refine companionCutoff_eq_zero fun h' => h fun i => ?_
  have := h' i
  rw [PiLp.smul_apply, smul_eq_mul, abs_mul, abs_two] at this
  linarith

/-- `supp χ ⊆ [-1,1]ⁿ`. -/
lemma support_liftCutoff :
    Function.support (liftCutoff n) ⊆ {ξ | ∀ i, |ξ i| ≤ 1} := fun ξ hξ i => by
  by_contra h
  exact hξ (liftCutoff_eq_zero fun h' => h (h' i).le)

/-- `supp χ̃ ⊆ [-2,2]ⁿ`. -/
lemma support_companionCutoff :
    Function.support (companionCutoff n) ⊆ {ξ | ∀ i, |ξ i| ≤ 2} := fun _ hξ i => by
  by_contra h
  exact hξ (companionCutoff_eq_zero fun h' => h (h' i).le)

lemma contDiff_liftCutoff : ContDiff ℝ ∞ (liftCutoff n) :=
  contDiff_companionCutoff.comp (contDiff_const_smul (2 : ℝ))

lemma hasCompactSupport_liftCutoff : HasCompactSupport (liftCutoff n) :=
  HasCompactSupport.intro (isCompact_box 1) fun _ hξ =>
    liftCutoff_eq_zero fun h => hξ fun i => (h i).le

/-- The cutoff `χ` as a (complex-valued) Schwartz function. -/
noncomputable def liftCutoffSchwartz (n : ℕ) : 𝓢(EuclideanSpace ℝ (Fin n), ℂ) :=
  (hasCompactSupport_liftCutoff (n := n)).comp_left (g := Complex.ofReal) Complex.ofReal_zero
    |>.toSchwartzMap (Complex.ofRealCLM.contDiff.comp contDiff_liftCutoff)

@[simp] lemma liftCutoffSchwartz_apply (ξ : EuclideanSpace ℝ (Fin n)) :
    liftCutoffSchwartz n ξ = (liftCutoff n ξ : ℂ) := rfl

/-- `χ θ = χ` (`θ = χ̃ = 1` on `supp χ`). -/
lemma liftCutoff_mul_companionCutoff (ξ : EuclideanSpace ℝ (Fin n)) :
    liftCutoff n ξ * companionCutoff n ξ = liftCutoff n ξ := by
  by_cases h : liftCutoff n ξ = 0
  · rw [h, zero_mul]
  · rw [companionCutoff_eq_one fun i => support_liftCutoff h i, mul_one]

/-! ### Scales (eq. (9.1), `eq:vs`) -/

/-- `r = paramR p ≥ 1` (for every real `p`). -/
lemma one_le_paramR (p : ℝ) : 1 ≤ paramR p := by unfold paramR; omega

/-- The constant `C_{ρ,r}` of `goodBlocks_eps_threshold` for `ρ = paramRho`, `r = paramR p`
(a fixed choice). -/
noncomputable def liftCrho (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) : ℝ :=
  Classical.choose (goodBlocks_eps_threshold (paramRho_pos n d Ω p) (paramR p) (one_le_paramR p))

lemma liftCrho_spec (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) :
    0 < liftCrho n d Ω p ∧ ∀ N : ℕ, 2 ≤ N → ∀ ε : ℝ, 0 < ε →
      ε ≤ Real.exp (-(liftCrho n d Ω p * (N : ℝ) ^ (2 * paramRho n d Ω p))) →
      ε ≤ (100 * paramR p * (blockStar (goodBlocks (paramRho n d Ω p) N) : ℝ) ^
        (2 * paramR p * goodK (paramRho n d Ω p)))⁻¹ :=
  Classical.choose_spec
    (goodBlocks_eps_threshold (paramRho_pos n d Ω p) (paramR p) (one_le_paramR p))

/-- `N_s = 2^s` of eq. (9.1) (`eq:vs`). -/
def liftN (s : ℕ) : ℕ := 2 ^ s

/-- The constant `C_* = 100 (n + D + 1) + 2 C_{ρ,r} + 2` (`D = 2d`) of eq. (9.1) (`eq:vs`),
chosen so that eq. (9.2) (`eq:scalerequirements`) holds (`exists_liftCStar`). -/
noncomputable def liftCStar (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) : ℝ :=
  100 * ((n : ℝ) + 2 * d + 1) + 2 * liftCrho n d Ω p + 2

/-- `v_s = ⌈C_* (s+1)(1 + 2^{s/(2M)})⌉` of eq. (9.1) (`eq:vs`). -/
noncomputable def liftV (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ) : ℕ :=
  ⌈liftCStar n d Ω p * ((s : ℝ) + 1) *
    (1 + (2 : ℝ) ^ ((s : ℝ) / (2 * (paramM n d Ω p : ℝ))))⌉₊

/-- `L_s = 2^{v_s}` of eq. (9.1) (`eq:vs`). -/
noncomputable def liftL (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ) : ℕ :=
  2 ^ liftV n d Ω p s

/-- `χ_s(ξ) = χ(L_s ξ)` of eq. (9.1) (`eq:vs`). -/
noncomputable def liftChi (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ)
    (ξ : EuclideanSpace ℝ (Fin n)) : ℝ :=
  liftCutoff n ((liftL n d Ω p s : ℝ) • ξ)

/-- `χ̃_s(ξ) = χ̃(L_s ξ)` of eq. (9.1) (`eq:vs`), with `χ̃ = θ = companionCutoff n`. -/
noncomputable def liftChiT (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ)
    (ξ : EuclideanSpace ℝ (Fin n)) : ℝ :=
  companionCutoff n ((liftL n d Ω p s : ℝ) • ξ)

variable {d : ℕ} {Ω : EuclideanSpace ℝ (Fin n) → ℂ} {p : ℝ}

lemma liftCrho_pos : 0 < liftCrho n d Ω p := (liftCrho_spec n d Ω p).1

lemma liftCStar_pos : 0 < liftCStar n d Ω p := by
  have := liftCrho_pos (n := n) (d := d) (Ω := Ω) (p := p)
  unfold liftCStar; positivity

lemma liftL_pos (s : ℕ) : (0 : ℝ) < liftL n d Ω p s := by unfold liftL; positivity

lemma two_le_liftN {s : ℕ} (hs : 1 ≤ s) : 2 ≤ liftN s := by
  unfold liftN
  calc 2 = 2 ^ 1 := rfl
    _ ≤ 2 ^ s := Nat.pow_le_pow_right (by norm_num) hs

/-- The core of eq. (9.2): for every `C ≥ 100 (n + D + 1) + 2 C_{ρ,r} + 2` and every `s`, the
integer `v = ⌈C(s+1)(1 + 2^{s/(2M)})⌉` satisfies `v ≥ 100(n+D+1)(s+1)` and
`4/2^v ≤ exp(-C_{ρ,r} N_s^{2ρ})`. -/
lemma scale_requirements_of_le {C : ℝ}
    (hC : 100 * ((n : ℝ) + 2 * d + 1) + 2 * liftCrho n d Ω p + 2 ≤ C) (s : ℕ) :
    100 * (n + 2 * d + 1) * (s + 1) ≤
        ⌈C * ((s : ℝ) + 1) * (1 + (2 : ℝ) ^ ((s : ℝ) / (2 * (paramM n d Ω p : ℝ))))⌉₊ ∧
      4 / (2 : ℝ) ^ ⌈C * ((s : ℝ) + 1) *
          (1 + (2 : ℝ) ^ ((s : ℝ) / (2 * (paramM n d Ω p : ℝ))))⌉₊ ≤
        Real.exp (-(liftCrho n d Ω p * ((liftN s : ℕ) : ℝ) ^ (2 * paramRho n d Ω p))) := by
  set M : ℝ := (paramM n d Ω p : ℝ)
  set ρ := paramRho n d Ω p
  set K := liftCrho n d Ω p
  have hK : 0 < K := liftCrho_pos
  set t : ℝ := (2 : ℝ) ^ ((s : ℝ) / (2 * M))
  have hM : (2 : ℝ) ≤ M := by simp only [M]; exact_mod_cast two_le_paramM n d Ω p
  have ht1 : 1 ≤ t := Real.one_le_rpow (by norm_num) (by positivity)
  have hs0 : (0 : ℝ) ≤ s := Nat.cast_nonneg s
  have hC0 : 100 * ((n : ℝ) + 2 * d + 1) ≤ C := by linarith
  set v := ⌈C * ((s : ℝ) + 1) * (1 + t)⌉₊
  have hv : C * ((s : ℝ) + 1) * (1 + t) ≤ v := Nat.le_ceil _
  have hCpos : 0 ≤ C := by
    have : (0 : ℝ) ≤ 100 * ((n : ℝ) + 2 * d + 1) := by positivity
    linarith
  have hCs : C * ((s : ℝ) + 1) ≤ C * ((s : ℝ) + 1) * (1 + t) := by
    have : 0 ≤ C * ((s : ℝ) + 1) := by positivity
    nlinarith
  have hCt : C * (1 + t) ≤ C * ((s : ℝ) + 1) * (1 + t) := by
    have : 0 ≤ C * (1 + t) := by positivity
    nlinarith
  refine ⟨?_, ?_⟩
  · have h1 : ((100 * (n + 2 * d + 1) * (s + 1) : ℕ) : ℝ) ≤ v := by
      push_cast
      have : 100 * ((n : ℝ) + 2 * d + 1) * ((s : ℝ) + 1) ≤ C * ((s : ℝ) + 1) :=
        mul_le_mul_of_nonneg_right hC0 (by positivity)
      linarith
    exact_mod_cast h1
  · -- `N_s^{2ρ} ≤ t`
    have hNt : ((liftN s : ℕ) : ℝ) ^ (2 * ρ) ≤ t := by
      have h2ρ : 2 * ρ < 1 / (2 * M) := two_mul_paramRho_lt n d Ω p
      rw [liftN, Nat.cast_pow, Nat.cast_ofNat, ← Real.rpow_natCast, ← Real.rpow_mul (by norm_num)]
      refine Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_
      rw [div_eq_mul_one_div (s : ℝ)]
      exact mul_le_mul_of_nonneg_left h2ρ.le hs0
    have hl2 : (1 / 2 : ℝ) < Real.log 2 := by
      have := Real.log_two_gt_d9; linarith
    have hl2' : Real.log 2 < 1 := by
      have := Real.log_two_lt_d9; linarith
    have hl0 : 0 < Real.log 2 := by linarith
    -- `v log 2 ≥ K N^{2ρ} + 2 log 2`
    have hkey : K * ((liftN s : ℕ) : ℝ) ^ (2 * ρ) + 2 * Real.log 2 ≤ v * Real.log 2 := by
      have h1 : (2 * K + 2) * (1 + t) ≤ v := by
        have : (2 * K + 2) * (1 + t) ≤ C * (1 + t) :=
          mul_le_mul_of_nonneg_right (by linarith) (by linarith)
        linarith
      have h2 : (2 * K + 2) * (1 + t) * Real.log 2 ≤ v * Real.log 2 :=
        mul_le_mul_of_nonneg_right h1 hl0.le
      have h3 : (K + 1) * (1 + t) ≤ (2 * K + 2) * (1 + t) * Real.log 2 := by
        have : 0 ≤ (K + 1) * (1 + t) := by positivity
        nlinarith
      have h4 : K * ((liftN s : ℕ) : ℝ) ^ (2 * ρ) ≤ K * t := mul_le_mul_of_nonneg_left hNt hK.le
      nlinarith
    have h2v : (2 : ℝ) ^ v = Real.exp (v * Real.log 2) := by
      rw [Real.exp_nat_mul, Real.exp_log (by norm_num)]
    have h4 : (4 : ℝ) = Real.exp (2 * Real.log 2) := by
      rw [show (2 : ℝ) * Real.log 2 = ((2 : ℕ) : ℝ) * Real.log 2 by norm_num, Real.exp_nat_mul,
        Real.exp_log (by norm_num)]
      norm_num
    rw [h2v, h4, ← Real.exp_sub]
    exact Real.exp_le_exp.2 (by linarith)

/-- Eq. (9.2) (`eq:scalerequirements`) of the §9 setup, existence of `C_*`: there is `C_* > 0`
such that for every `s ≥ 1`, `v_s = ⌈C_*(s+1)(1 + 2^{s/(2M)})⌉` satisfies
`v_s ≥ 100(n+D+1)(s+1)` (`D = 2d`) and `4/2^{v_s} ≤ exp(-C_{ρ,r} N_s^{2ρ})`; the choice
`C_* = liftCStar` used in `liftV` is such a constant. -/
theorem exists_liftCStar (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) :
    ∃ C : ℝ, 0 < C ∧ C = liftCStar n d Ω p ∧ ∀ s : ℕ, 1 ≤ s →
      100 * (n + 2 * d + 1) * (s + 1) ≤
          ⌈C * ((s : ℝ) + 1) * (1 + (2 : ℝ) ^ ((s : ℝ) / (2 * (paramM n d Ω p : ℝ))))⌉₊ ∧
        4 / (2 : ℝ) ^ ⌈C * ((s : ℝ) + 1) *
            (1 + (2 : ℝ) ^ ((s : ℝ) / (2 * (paramM n d Ω p : ℝ))))⌉₊ ≤
          Real.exp (-(liftCrho n d Ω p * ((liftN s : ℕ) : ℝ) ^ (2 * paramRho n d Ω p))) :=
  ⟨liftCStar n d Ω p, liftCStar_pos, rfl, fun s _ => scale_requirements_of_le le_rfl s⟩

/-- Eq. (9.2) (`eq:scalerequirements`), first requirement: `v_s ≥ 100(n+D+1)(s+1)` (`D = 2d`;
it holds for every `s`, in particular for `s ≥ 1`). -/
theorem liftV_ge (s : ℕ) : 100 * (n + 2 * d + 1) * (s + 1) ≤ liftV n d Ω p s :=
  (scale_requirements_of_le le_rfl s).1

/-- Eq. (9.2) (`eq:scalerequirements`), second requirement: `4/L_s ≤ exp(-C_{ρ,r} N_s^{2ρ})`
(for every `s`, in particular for `s ≥ 1`). -/
theorem four_div_liftL_le (s : ℕ) :
    4 / (liftL n d Ω p s : ℝ) ≤
      Real.exp (-(liftCrho n d Ω p * ((liftN s : ℕ) : ℝ) ^ (2 * paramRho n d Ω p))) := by
  have := (scale_requirements_of_le (n := n) (d := d) (Ω := Ω) (p := p) le_rfl s).2
  rw [liftL, Nat.cast_pow, Nat.cast_ofNat]
  exact this

/-- `L_s ≥ 2^{100(n+D+1)(s+1)}`, a consequence of eq. (9.2) (`eq:scalerequirements`). -/
theorem pow_le_liftL (s : ℕ) : 2 ^ (100 * (n + 2 * d + 1) * (s + 1)) ≤ liftL n d Ω p s :=
  Nat.pow_le_pow_right (by norm_num) (liftV_ge s)

/-- Consequence of eq. (9.2) (`eq:scalerequirements`): for `s ≥ 1`, `ε = 4/L_s` satisfies
hypothesis (7.1) of Theorem 7.7 (`thm:IW`) for the blocks of `𝒰_{N_s}`:
`4/L_s ≤ (100 r q_*^{2rk})⁻¹`. -/
theorem liftEps_threshold {s : ℕ} (hs : 1 ≤ s) :
    4 / (liftL n d Ω p s : ℝ) ≤
      (100 * paramR p * (blockStar (goodBlocks (paramRho n d Ω p) (liftN s)) : ℝ) ^
        (2 * paramR p * goodK (paramRho n d Ω p)))⁻¹ :=
  (liftCrho_spec n d Ω p).2 (liftN s) (two_le_liftN hs) _
    (div_pos (by norm_num) (liftL_pos s)) (four_div_liftL_le s)

/-- Consequence of eq. (9.2) (`eq:scalerequirements`): Theorem 7.7 (`thm:IW`) applies to
`𝒰_{N_s}` with `ε = 4/L_s`. For `1 < p`, `r = paramR p`, there is `C ≥ 0` such that for every
`s ≥ 1`, every bounded measurable `m` supported in `[-2/L_s, 2/L_s]ⁿ` with Euclidean `L^{2r}`
multiplier norm `≤ A`, and every finitely supported `f`,
`‖T_{m;𝒰_{N_s}} f‖_{ℓ^p} ≤ C A ‖f‖_{ℓ^p}`. -/
theorem lift_transference (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ s : ℕ, 1 ≤ s →
      ∀ (m : EuclideanSpace ℝ (Fin n) → ℂ) (B A : ℝ), AEStronglyMeasurable m volume →
      (∀ ξ, ‖m ξ‖ ≤ B) →
      Function.support m ⊆ {ξ | ∀ i, |ξ i| ≤ 2 / (liftL n d Ω p s : ℝ)} →
      (∀ F : 𝓢(EuclideanSpace ℝ (Fin n), ℂ),
        eLpNorm (𝓕⁻ (fun ξ => m ξ * 𝓕 (F : EuclideanSpace ℝ (Fin n) → ℂ) ξ))
          (ENNReal.ofReal (2 * paramR p)) volume ≤
            ENNReal.ofReal A * eLpNorm F (ENNReal.ofReal (2 * paramR p)) volume) →
      ∀ f : (Fin n → ℤ) → ℂ, (Function.support f).Finite →
        eLpNorm (cosetMult (blockProd (goodBlocks (paramRho n d Ω p) (liftN s))) m
            (paramGoodSet n d Ω p (liftN s)) f) (ENNReal.ofReal p) Measure.count ≤
          ENNReal.ofReal (C * A) * eLpNorm f (ENNReal.ofReal p) Measure.count := by
  obtain ⟨C, hC, hT⟩ := coprime_block_multiplier_transference n (goodK (paramRho n d Ω p))
    (paramR p) (one_le_paramR p) (paramR_exponent_range hp).1 (paramR_exponent_range hp).2
  refine ⟨C, hC, fun s hs m B A hm hB hsupp hA f hf => ?_⟩
  have hL := liftL_pos (n := n) (d := d) (Ω := Ω) (p := p) s
  refine hT (goodBlocks (paramRho n d Ω p) (liftN s)) goodBlocks_one_lt
    goodBlocks_pairwise_coprime (4 / (liftL n d Ω p s : ℝ)) (by positivity)
    (liftEps_threshold hs) m B A hm hB ?_ hA f hf
  refine hsupp.trans fun ξ hξ i => ?_
  have := hξ i
  rw [div_div, show (4 : ℝ) / (liftL n d Ω p s * 2) = 2 / liftL n d Ω p s by field_simp; ring]
  exact this

/-! ### Properties of the scaled cutoffs -/

lemma liftChi_nonneg (s : ℕ) (ξ : EuclideanSpace ℝ (Fin n)) : 0 ≤ liftChi n d Ω p s ξ :=
  liftCutoff_nonneg _

lemma liftChi_le_one (s : ℕ) (ξ : EuclideanSpace ℝ (Fin n)) : liftChi n d Ω p s ξ ≤ 1 :=
  liftCutoff_le_one _

lemma liftChiT_nonneg (s : ℕ) (ξ : EuclideanSpace ℝ (Fin n)) : 0 ≤ liftChiT n d Ω p s ξ :=
  companionCutoff_nonneg _

lemma liftChiT_le_one (s : ℕ) (ξ : EuclideanSpace ℝ (Fin n)) : liftChiT n d Ω p s ξ ≤ 1 :=
  companionCutoff_le_one _

/-- `supp χ_s ⊆ [-1/L_s, 1/L_s]ⁿ`. -/
lemma support_liftChi (s : ℕ) :
    Function.support (liftChi n d Ω p s) ⊆
      {ξ | ∀ i, |ξ i| ≤ 1 / (liftL n d Ω p s : ℝ)} := fun ξ hξ i => by
  have hL := liftL_pos (n := n) (d := d) (Ω := Ω) (p := p) s
  have := support_liftCutoff hξ i
  rw [PiLp.smul_apply, smul_eq_mul, abs_mul, abs_of_pos hL] at this
  rw [le_div_iff₀ hL]; linarith

/-- `supp χ̃_s ⊆ [-2/L_s, 2/L_s]ⁿ`. -/
lemma support_liftChiT (s : ℕ) :
    Function.support (liftChiT n d Ω p s) ⊆
      {ξ | ∀ i, |ξ i| ≤ 2 / (liftL n d Ω p s : ℝ)} := fun ξ hξ i => by
  have hL := liftL_pos (n := n) (d := d) (Ω := Ω) (p := p) s
  have := support_companionCutoff hξ i
  rw [PiLp.smul_apply, smul_eq_mul, abs_mul, abs_of_pos hL] at this
  rw [le_div_iff₀ hL]; linarith

/-- `χ_s χ̃_s = χ_s`. -/
lemma liftChi_mul_liftChiT (s : ℕ) (ξ : EuclideanSpace ℝ (Fin n)) :
    liftChi n d Ω p s ξ * liftChiT n d Ω p s ξ = liftChi n d Ω p s ξ :=
  liftCutoff_mul_companionCutoff _

/-- Consequence of eq. (9.2) (`eq:scalerequirements`) (§9 setup, "all bumps centered at
`𝒰_{N_s}` used below are disjoint"): for `s ≥ 1` and any symbol `m`, at most one center
`γ ∈ 𝒰_{N_s}` has `(m χ̃_s)_per(ξ - γ) ≠ 0`. -/
theorem liftBump_center_atMostOne {s : ℕ} (hs : 1 ≤ s) (m : EuclideanSpace ℝ (Fin n) → ℂ)
    {γ γ' : Fin n → ZMod (blockProd (goodBlocks (paramRho n d Ω p) (liftN s)))}
    (hγ : γ ∈ paramGoodSet n d Ω p (liftN s)) (hγ' : γ' ∈ paramGoodSet n d Ω p (liftN s))
    (ξ : EuclideanSpace ℝ (Fin n))
    (h : periodize (fun η => m η * (liftChiT n d Ω p s η : ℂ))
      (ξ - ratPt (blockProd (goodBlocks (paramRho n d Ω p) (liftN s))) γ) ≠ 0)
    (h' : periodize (fun η => m η * (liftChiT n d Ω p s η : ℂ))
      (ξ - ratPt (blockProd (goodBlocks (paramRho n d Ω p) (liftN s))) γ') ≠ 0) :
    γ = γ' := by
  have hL := liftL_pos (n := n) (d := d) (Ω := Ω) (p := p) s
  refine periodize_center_atMostOne (ε := 4 / (liftL n d Ω p s : ℝ)) ?_ goodBlocks_one_lt
    goodBlocks_pairwise_coprime (by positivity) (liftEps_threshold hs) hγ hγ' ξ h h'
  intro η hη i
  have hχ : liftChiT n d Ω p s η ≠ 0 := by
    intro h0; apply hη; rw [h0, Complex.ofReal_zero, mul_zero]
  have := support_liftChiT s hχ i
  refine this.trans ?_
  rw [div_le_iff₀ hL, mul_assoc, div_mul_cancel₀ _ hL.ne']
  norm_num

/-! ### The rational frequencies `𝓡_s`, Gauss sums and the lifted symbols -/

/-- `𝓡_s = {a/q : (a,q) = 1, 0 ≤ a < q, N_s/2 ≤ q < N_s}` of the §9 setup, as the finite set of
pairs `(a, q)` (the condition `N_s/2 ≤ q` is written `N_s ≤ 2q`). -/
def liftRat (s : ℕ) : Finset (ℕ × ℕ) :=
  ((range (liftN s)) ×ˢ (range (liftN s))).filter fun aq =>
    liftN s ≤ 2 * aq.2 ∧ aq.1 < aq.2 ∧ Nat.Coprime aq.1 aq.2

lemma mem_liftRat {s a q : ℕ} :
    (a, q) ∈ liftRat s ↔ liftN s ≤ 2 * q ∧ q < liftN s ∧ a < q ∧ Nat.Coprime a q := by
  simp only [liftRat, mem_filter, mem_product, Finset.mem_range]
  constructor
  · rintro ⟨⟨_, h2⟩, h3, h4, h5⟩; exact ⟨h3, h2, h4, h5⟩
  · rintro ⟨h3, h2, h4, h5⟩; exact ⟨⟨by omega, h2⟩, h3, h4, h5⟩

/-- The §9 setup: `𝓡_s` has at most `N_s²` elements. -/
theorem card_liftRat_le (s : ℕ) : (liftRat s).card ≤ liftN s ^ 2 := by
  refine (card_filter_le _ _).trans ?_
  rw [card_product, card_range, sq]

lemma one_le_of_mem_liftRat {s a q : ℕ} (h : (a, q) ∈ liftRat s) : 1 ≤ q := by
  have := (mem_liftRat.1 h).2.2.1; omega

/-- The integer vector `(zᵢ)ᵢ ∈ ℤⁿ` of a residue vector `z ∈ {0, …, q-1}ⁿ`. -/
def finIntVec {q : ℕ} (z : Fin n → Fin q) : Fin n → ℤ := fun i => ((z i : ℕ) : ℤ)

/-- The Gauss sum `S(α, β) = q^{-n} ∑_{z mod q} e(α P(z) - z · β)`, `α = a/q`, `β = b/q`, of
eq. (`eq:Gaussdef`), in the Mathlib sign convention (the blueprint's `+β · z` becomes `-z · β`),
so that `∑_β S(α, β) e(β · y) = e(α P(y))` (`sum_gaussSum_mul_eC`). -/
noncomputable def gaussSum (n d a q : ℕ) (b : Fin n → Fin q) : ℂ :=
  ((q : ℂ) ^ n)⁻¹ * ∑ z : Fin n → Fin q,
    eC ((a : ℝ) / q * (radialPolyZ n d (finIntVec z) : ℝ) -
      inner ℝ (latEmbed (finIntVec z)) (gridPt q b))

/-- The lifted symbol `Lift_{s,α}[m](ξ) = ∑_{β ∈ T[q]} S(α, β) (m χ_s)_per(ξ - β)`, `α = a/q`,
of eq. (`eq:Liftdef`). -/
noncomputable def liftSym (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s a q : ℕ)
    (m : EuclideanSpace ℝ (Fin n) → ℂ) (ξ : EuclideanSpace ℝ (Fin n)) : ℂ :=
  ∑ b : Fin n → Fin q, gaussSum n d a q b *
    periodize (fun η => m η * (liftChi n d Ω p s η : ℂ)) (ξ - gridPt q b)

/-- `A_{s,α} = Lift_{s,α}[1]` of the §9 setup, `α = a/q`. -/
noncomputable def liftA (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s a q : ℕ) :
    EuclideanSpace ℝ (Fin n) → ℂ :=
  liftSym n d Ω p s a q fun _ => 1

/-- `D_s[m](ξ) = ∑_{β ∈ 𝒰_{N_s}} (m χ̃_s)_per(ξ - β)` of the §9 setup. -/
noncomputable def liftD (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ)
    (m : EuclideanSpace ℝ (Fin n) → ℂ) : EuclideanSpace ℝ (Fin n) → ℂ :=
  cosetSymbol (blockProd (goodBlocks (paramRho n d Ω p) (liftN s)))
    (fun η => m η * (liftChiT n d Ω p s η : ℂ)) (paramGoodSet n d Ω p (liftN s))

/-- `φ_s = 𝓕⁻ χ_s` of Blueprint Lemma 9.1 (`lem:liftkernel`). -/
noncomputable def liftPhi (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ) :
    EuclideanSpace ℝ (Fin n) → ℂ :=
  𝓕⁻ fun ξ => (liftChi n d Ω p s ξ : ℂ)

/-! ### Blueprint Lemma 9.1 (`lem:liftkernel`) -/

/-- The residue vector `y mod q ∈ {0, …, q-1}ⁿ`. -/
def resVec {q : ℕ} (hq : 1 ≤ q) (y : Fin n → ℤ) : Fin n → Fin q := fun i =>
  ⟨(y i % q).toNat, by
    have h0 : (0 : ℤ) < q := by exact_mod_cast hq
    have h1 := Int.emod_nonneg (y i) h0.ne'
    have h2 := Int.emod_lt_of_pos (y i) h0
    omega⟩

lemma finIntVec_resVec {q : ℕ} (hq : 1 ≤ q) (y : Fin n → ℤ) (i : Fin n) :
    finIntVec (resVec hq y) i = y i % q := by
  have h0 : (0 : ℤ) < q := by exact_mod_cast hq
  have h1 := Int.emod_nonneg (y i) h0.ne'
  simp only [finIntVec, resVec]
  omega

/-- `q ∣ yᵢ - zᵢ` for all `i` iff `z = y mod q`. -/
lemma dvd_sub_finIntVec_iff {q : ℕ} (hq : 1 ≤ q) (y : Fin n → ℤ) (z : Fin n → Fin q) :
    (∀ i, (q : ℤ) ∣ (y - finIntVec z) i) ↔ z = resVec hq y := by
  have h0 : (0 : ℤ) < q := by exact_mod_cast hq
  constructor
  · intro h
    funext i
    have hi : finIntVec z i ≡ y i [ZMOD q] := (Int.modEq_iff_dvd.2 (h i))
    have hz0 : 0 ≤ finIntVec z i := by simp [finIntVec]
    have hzq : finIntVec z i < q := by simp only [finIntVec]; exact_mod_cast (z i).2
    have he : finIntVec z i % q = finIntVec z i := Int.emod_eq_of_lt hz0 hzq
    have h2 : finIntVec z i = y i % q := by rw [← he]; exact hi
    have h3 := finIntVec_resVec hq y i
    apply Fin.ext
    have : ((z i : ℕ) : ℤ) = ((resVec hq y i : ℕ) : ℤ) := by
      change finIntVec z i = finIntVec (resVec hq y) i
      rw [h2, h3]
    exact_mod_cast this
  · rintro rfl i
    rw [Pi.sub_apply, finIntVec_resVec, Int.emod_def]
    exact ⟨y i / q, by ring⟩

/-- The finite Gauss-sum identity in the proof of Blueprint Lemma 9.1 (`lem:liftkernel`):
for `q ≥ 1` and `y ∈ ℤⁿ`, `∑_{β ∈ T[q]} S(a/q, β) e(β · y) = e((a/q) P(y))`
(geometric sums and `P(z) ≡ P(y) mod q` for `z ≡ y mod q`). -/
theorem sum_gaussSum_mul_eC (d a : ℕ) {q : ℕ} (hq : 1 ≤ q) (y : Fin n → ℤ) :
    ∑ b : Fin n → Fin q, gaussSum n d a q b * eC (inner ℝ (gridPt q b) (latEmbed y)) =
      eC ((a : ℝ) / q * (radialPolyZ n d y : ℝ)) := by
  set A : (Fin n → ℤ) → ℝ := fun w => (a : ℝ) / q * (radialPolyZ n d w : ℝ)
  have hq0 : (q : ℂ) ≠ 0 := by exact_mod_cast (show q ≠ 0 by omega)
  have hterm : ∀ (b z : Fin n → Fin q),
      eC (A (finIntVec z) - inner ℝ (latEmbed (finIntVec z)) (gridPt q b)) *
        eC (inner ℝ (gridPt q b) (latEmbed y)) =
      eC (A (finIntVec z)) * eC (inner ℝ (gridPt q b) (latEmbed (y - finIntVec z))) := by
    intro b z
    rw [← eC_add, ← eC_add, latEmbed_sub, inner_sub_right, real_inner_comm (gridPt q b)]
    congr 1; ring
  calc ∑ b : Fin n → Fin q, gaussSum n d a q b * eC (inner ℝ (gridPt q b) (latEmbed y))
      = ((q : ℂ) ^ n)⁻¹ * ∑ z : Fin n → Fin q, eC (A (finIntVec z)) *
          ∑ b : Fin n → Fin q, eC (inner ℝ (gridPt q b) (latEmbed (y - finIntVec z))) := by
        simp only [gaussSum, mul_assoc, ← Finset.mul_sum]
        congr 1
        simp only [Finset.sum_mul, Finset.mul_sum]
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl fun z _ => Finset.sum_congr rfl fun b _ => ?_
        exact hterm b z
    _ = ((q : ℂ) ^ n)⁻¹ * ∑ z : Fin n → Fin q,
          if z = resVec hq y then eC (A (finIntVec z)) * (q : ℂ) ^ n else 0 := by
        congr 1
        refine Finset.sum_congr rfl fun z _ => ?_
        rw [sum_eC_gridPt q hq]
        by_cases hz : z = resVec hq y
        · rw [ite_eq_left ((dvd_sub_finIntVec_iff hq y z).2 hz), ite_eq_left hz]
        · rw [ite_eq_right (fun h => hz ((dvd_sub_finIntVec_iff hq y z).1 h)), ite_eq_right hz,
            mul_zero]
    _ = eC (A (finIntVec (resVec hq y))) := by
        rw [Finset.sum_ite_eq' Finset.univ, ite_eq_left (Finset.mem_univ _), mul_comm,
          mul_assoc, mul_inv_cancel₀ (pow_ne_zero _ hq0), mul_one]
    _ = eC (A y) := by
        have hmod : radialPolyZ n d (finIntVec (resVec hq y)) ≡ radialPolyZ n d y [ZMOD q] :=
          radialPolyZ_modEq n d q fun i => by rw [finIntVec_resVec]; exact Int.mod_modEq _ _
        obtain ⟨k, hk⟩ := (Int.modEq_iff_dvd.1 hmod)
        have hqR : (q : ℝ) ≠ 0 := by exact_mod_cast (show q ≠ 0 by omega)
        have hA : A y = A (finIntVec (resVec hq y)) + ((a * k : ℤ) : ℝ) := by
          simp only [A]
          have hk' : (radialPolyZ n d y : ℝ) =
              (radialPolyZ n d (finIntVec (resVec hq y)) : ℝ) + q * k := by
            have := congrArg (fun t : ℤ => (t : ℝ)) hk
            push_cast at this; linarith
          rw [hk']; push_cast; field_simp
        rw [hA, eC_add, eC_intCast, mul_one]

/-- The lifted symbol is integrable on the torus when `m χ_s` is integrable. -/
lemma integrableOn_liftSym {s a q : ℕ} {m : EuclideanSpace ℝ (Fin n) → ℂ}
    (hm : Integrable fun ξ => m ξ * (liftChi n d Ω p s ξ : ℂ)) :
    IntegrableOn (liftSym n d Ω p s a q m) (torusCube n) := by
  rw [show liftSym n d Ω p s a q m = fun ξ => ∑ b : Fin n → Fin q, gaussSum n d a q b *
    periodize (fun η => m η * (liftChi n d Ω p s η : ℂ)) (ξ - gridPt q b) from rfl]
  refine integrable_finsetSum _ fun b _ => ?_
  simp_rw [periodize_comp_sub]
  exact (integrableOn_periodize (hm.comp_sub_right _)).const_mul _

/-- Blueprint Lemma 9.1 (`lem:liftkernel`), eq. (`eq:liftkernel`): for `q ≥ 1`, `α = a/q` and a
symbol `m` with `m χ_s` integrable (e.g. `m` bounded measurable on `supp χ_s`,
`latKernel_liftSym_of_bdd`), the kernel of `Lift_{s,α}[m]` is
`(Lift_{s,α}[m])ˇ(y) = e(α P(y)) (m χ_s)ˇ(y)` for every `y ∈ G` (including `y = 0`). -/
theorem latKernel_liftSym (s a : ℕ) {q : ℕ} (hq : 1 ≤ q) {m : EuclideanSpace ℝ (Fin n) → ℂ}
    (hm : Integrable fun ξ => m ξ * (liftChi n d Ω p s ξ : ℂ)) (y : Fin n → ℤ) :
    latKernel (liftSym n d Ω p s a q m) y =
      eC ((a : ℝ) / q * (radialPolyZ n d y : ℝ)) *
        𝓕⁻ (fun ξ => m ξ * (liftChi n d Ω p s ξ : ℂ)) (latEmbed y) := by
  rw [← sum_gaussSum_mul_eC d a hq y, Finset.sum_mul, latKernel]
  simp only [liftSym, Finset.sum_mul]
  rw [integral_finsetSum _ fun b _ => ?_]
  · refine Finset.sum_congr rfl fun b _ => ?_
    simp_rw [mul_assoc]
    rw [integral_const_mul]
    simp_rw [periodize_comp_sub]
    rw [← latKernel, latKernel_periodize (hm.comp_sub_right _),
      fourierInv_comp_sub (fun η => m η * (liftChi n d Ω p s η : ℂ))]
  · simp_rw [mul_assoc, periodize_comp_sub]
    exact (integrableOn_periodize_mul_eC (hm.comp_sub_right _) y).const_mul _

/-- `χ_s` (as a complex function) is integrable. -/
lemma integrable_liftChi (s : ℕ) :
    Integrable fun ξ : EuclideanSpace ℝ (Fin n) => (liftChi n d Ω p s ξ : ℂ) :=
  (liftCutoffSchwartz n).integrable.comp_smul (liftL_pos s).ne'

/-- `m χ_s` is integrable for `m` a.e.-strongly measurable and bounded on `supp χ_s`. -/
lemma integrable_mul_liftChi {s : ℕ} {m : EuclideanSpace ℝ (Fin n) → ℂ}
    (hm : AEStronglyMeasurable m volume) {B : ℝ}
    (hB : ∀ ξ, liftChi n d Ω p s ξ ≠ 0 → ‖m ξ‖ ≤ B) :
    Integrable fun ξ => m ξ * (liftChi n d Ω p s ξ : ℂ) := by
  have hχ := integrable_liftChi (n := n) (d := d) (Ω := Ω) (p := p) s
  refine Integrable.mono' (hχ.norm.const_mul B) (hm.mul hχ.aestronglyMeasurable)
    (Filter.Eventually.of_forall fun ξ => ?_)
  rw [norm_mul]
  by_cases h : liftChi n d Ω p s ξ = 0
  · simp [h]
  · exact mul_le_mul_of_nonneg_right (hB ξ h) (norm_nonneg _)

/-- Blueprint Lemma 9.1 (`lem:liftkernel`), eq. (`eq:liftkernel`), for bounded measurable `m`
on the support of `χ_s`: for `q ≥ 1`, `α = a/q`, and every `y ∈ G`,
`(Lift_{s,α}[m])ˇ(y) = e(α P(y)) (m χ_s)ˇ(y)`. -/
theorem latKernel_liftSym_of_bdd (s a : ℕ) {q : ℕ} (hq : 1 ≤ q)
    {m : EuclideanSpace ℝ (Fin n) → ℂ} (hm : AEStronglyMeasurable m volume) {B : ℝ}
    (hB : ∀ ξ, liftChi n d Ω p s ξ ≠ 0 → ‖m ξ‖ ≤ B) (y : Fin n → ℤ) :
    latKernel (liftSym n d Ω p s a q m) y =
      eC ((a : ℝ) / q * (radialPolyZ n d y : ℝ)) *
        𝓕⁻ (fun ξ => m ξ * (liftChi n d Ω p s ξ : ℂ)) (latEmbed y) :=
  latKernel_liftSym s a hq (integrable_mul_liftChi hm hB) y

/-- Blueprint Lemma 9.1 (`lem:liftkernel`), "in particular": for `q ≥ 1`, `α = a/q`, the kernel of
`A_{s,α}` is `e(α P(y)) φ_s(y)`, `φ_s = 𝓕⁻ χ_s`, for every `y ∈ G`. -/
theorem latKernel_liftA (s a : ℕ) {q : ℕ} (hq : 1 ≤ q) (y : Fin n → ℤ) :
    latKernel (liftA n d Ω p s a q) y =
      eC ((a : ℝ) / q * (radialPolyZ n d y : ℝ)) * liftPhi n d Ω p s (latEmbed y) := by
  have h := latKernel_liftSym (n := n) (d := d) (Ω := Ω) (p := p) s a hq (m := fun _ => 1)
    (by simpa using integrable_liftChi (n := n) (d := d) (Ω := Ω) (p := p) s) y
  simpa [liftA, liftPhi] using h

/-- Scaling of the envelope bound: there is `C ≥ 0` (depending only on `n`) such that for every
`L > 0`, `|𝓕⁻(χ(L ·))(x)| ≤ C B_L(x)` for all `x ∈ E`. -/
lemma exists_norm_fourierInv_liftCutoff_smul_le (n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ L : ℝ, 0 < L → ∀ x : EuclideanSpace ℝ (Fin n),
      ‖𝓕⁻ (fun ξ => (liftCutoff n (L • ξ) : ℂ)) x‖ ≤ C * envelope n L x := by
  obtain ⟨K, hK, hKb⟩ := exists_norm_le_envelope (𝓕⁻ (liftCutoffSchwartz n))
  refine ⟨K, hK, fun L hL x => ?_⟩
  have hL' : 0 < L⁻¹ := inv_pos.2 hL
  have hfun : (fun ξ : EuclideanSpace ℝ (Fin n) => (liftCutoff n (L • ξ) : ℂ)) =
      fun ξ => liftCutoffSchwartz n ((L⁻¹)⁻¹ • ξ) := by
    funext ξ; rw [inv_inv, liftCutoffSchwartz_apply]
  rw [hfun, fourierInv_comp_inv_smul _ hL', ← SchwartzMap.fourierInv_coe, norm_mul,
    Complex.norm_real, Real.norm_of_nonneg (by positivity)]
  have hb := hKb (L⁻¹ • x)
  have he : envelope n 1 (L⁻¹ • x) = ((1 + ‖x‖ / L) ^ (n + 1))⁻¹ := by
    rw [envelope, norm_smul, Real.norm_of_nonneg hL'.le]
    simp [div_eq_inv_mul]
  rw [he] at hb
  calc (L⁻¹) ^ n * ‖(𝓕⁻ (liftCutoffSchwartz n)) (L⁻¹ • x)‖
      ≤ (L⁻¹) ^ n * (K * ((1 + ‖x‖ / L) ^ (n + 1))⁻¹) :=
        mul_le_mul_of_nonneg_left hb (by positivity)
    _ = K * envelope n L x := by rw [envelope, inv_pow]; ring

/-- Blueprint Lemma 9.1 (`lem:liftkernel`), envelope bound: there is `C ≥ 0` (depending only on
`n`, independent of `s` and of `d, Ω, p`) such that `|φ_s(y)| ≤ C B_{L_s}(y)` for every `s` and
every `y ∈ G`, where `φ_s = 𝓕⁻ χ_s` and `B_R` is the envelope of Lemma 2.4 (`lem:maximal`);
the same bound holds at every point of `E`. -/
theorem norm_liftPhi_le (n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ),
      (∀ x : EuclideanSpace ℝ (Fin n),
        ‖liftPhi n d Ω p s x‖ ≤ C * envelope n (liftL n d Ω p s) x) ∧
      ∀ y : Fin n → ℤ,
        ‖liftPhi n d Ω p s (latEmbed y)‖ ≤ C * latEnvelope n (liftL n d Ω p s) y := by
  obtain ⟨C, hC, h⟩ := exists_norm_fourierInv_liftCutoff_smul_le n
  exact ⟨C, hC, fun d Ω p s =>
    ⟨fun x => h _ (liftL_pos s) x, fun y => h _ (liftL_pos s) (latEmbed y)⟩⟩

/-! ### Blueprint Lemma 9.2 (`lem:arithmax`): arithmetic maximal decay

Proof structure (following the blueprint):
* the complete phase sums `arithG` (`G_Q`, `Q = q r`) and their bounds in both degree cases:
  `norm_arithG_one_le` (`D = 2`, Lemma 3.6), `norm_arithG_slice_le` (`D ≥ 4`, Lemma 3.1 and
  Corollary 3.5), the exceptional densities `card_exc_quad_le`, `card_exc_slice_le` (Lemma 3.2),
  combined in `exists_arithG_bound`;
* the lattice sum of `B_L` over the exceptional set by dyadic shells
  (`arith_tsum_latEnvelope_indicator_le`);
* the `TT*` kernel of a linearization (`integral_arithKer_mul_conj`, via Lemma 9.1) and its bound
  `|H| ≤ C (|G_Q| + Q/L) B_L(h)` (`norm_arithTT_le`, Lemma 3.7);
* Schur and `TT*` (`arith_linearized_bound`, via `band_eLpNorm_kernel_le_of_ttstar`), then
  linearization of the maximal function: eq. (9.5), `arith_maximal_decay`;
* eq. (9.6), `arith_maximal_decay_vector`: the `ℓ²` case by squaring and summing (9.5), the
  endpoints by the domination `(∑_ν sup_α |A f_ν|²)^{1/2} ≤ |φ_s| * (∑_ν |f_ν|²)^{1/2}`
  (Minkowski) and Young, and Marcinkiewicz interpolation for `ℓ²_ν`-valued inputs
  (`arithVec_lp_of_l2`).

Deviations: the period is `Q = q_x q_y` (instead of `lcm(q_x, q_y)`; still `N/2 ≤ Q ≤ N²`); for
`D ≥ 4` the exceptional set is `{h : gcd(D b_y h₁, q_y) > N^{1/2}}` (equal to the blueprint's set
since `(b_y, q_y) = 1`); both exceptional sets have density `≤ C N^{-3/8}` in every interval
`[-R, R]`, `R ≥ N`; the error term uses `Q/L ≤ N²/L ≤ N^{-1}` (from `L_s ≥ N_s³`). -/

section ArithMax

open Polynomial
open scoped ComplexConjugate ENNReal NNReal


/-- The phase `α P(v) - β P(v + h)` of the `TT*` kernel in the proof of Blueprint Lemma 9.2. -/
noncomputable def arithPhase (n d : ℕ) (α β : ℝ) (h v : Fin n → ℤ) : ℝ :=
  α * (radialPolyZ n d v : ℝ) - β * (radialPolyZ n d (v + h) : ℝ)

/-- `X ≡ Y (mod q)` gives `(a/q) Y = (a/q) X + k` with `k ∈ ℤ`. -/
lemma exists_div_mul_eq_add_int (a : ℤ) {q : ℕ} (hq : 1 ≤ q) {X Y : ℤ} (h : X ≡ Y [ZMOD q]) :
    ∃ k : ℤ, (a : ℝ) / q * Y = (a : ℝ) / q * X + k := by
  obtain ⟨k, hk⟩ := (Int.modEq_iff_dvd.1 h)
  have hqR : (q : ℝ) ≠ 0 := by have : (0 : ℝ) < q := by exact_mod_cast hq
                               exact this.ne'
  refine ⟨a * k, ?_⟩
  have hk' : (Y : ℝ) = X + q * k := by
    have := congrArg (fun t : ℤ => (t : ℝ)) hk; push_cast at this; linarith
  rw [hk']; push_cast; field_simp

/-- The phase is periodic modulo `Q = q r` (for `α = a/q`, `β = b/r`). -/
lemma eC_arithPhase_periodic (d : ℕ) (a b : ℤ) {q r : ℕ} (hq : 1 ≤ q) (hr : 1 ≤ r)
    (h : Fin n → ℤ) {v v' : Fin n → ℤ} (hv : ∀ i, v i ≡ v' i [ZMOD (q * r : ℕ)]) :
    eC (arithPhase n d ((a : ℝ) / q) ((b : ℝ) / r) h v) =
      eC (arithPhase n d ((a : ℝ) / q) ((b : ℝ) / r) h v') := by
  have h1 : radialPolyZ n d v ≡ radialPolyZ n d v' [ZMOD q] :=
    radialPolyZ_modEq n d q fun i =>
      Int.ModEq.of_mul_right (r : ℤ) (by have := hv i; push_cast at this; exact this)
  have h2 : radialPolyZ n d (v + h) ≡ radialPolyZ n d (v' + h) [ZMOD r] :=
    radialPolyZ_modEq n d r fun i => by
      simp only [Pi.add_apply]
      exact (Int.ModEq.of_mul_left (q : ℤ)
        (by have := hv i; push_cast at this; exact this)).add_right _
  obtain ⟨k₁, hk₁⟩ := exists_div_mul_eq_add_int a hq h1
  obtain ⟨k₂, hk₂⟩ := exists_div_mul_eq_add_int b hr h2
  have : arithPhase n d ((a : ℝ) / q) ((b : ℝ) / r) h v' =
      arithPhase n d ((a : ℝ) / q) ((b : ℝ) / r) h v + ((k₁ - k₂ : ℤ) : ℝ) := by
    unfold arithPhase; rw [hk₁, hk₂]; push_cast; ring
  rw [this, eC_add, eC_intCast, mul_one]

/-- The normalized complete phase sum
`G = Q^{-n} ∑_{u ∈ [0, Q)ⁿ} e((a/q) P(u) - (b/r) P(u + h))`, `Q = q r`. -/
noncomputable def arithG (n d a q b r : ℕ) (h : Fin n → ℤ) : ℂ :=
  (((q * r : ℕ) : ℂ) ^ n)⁻¹ * ∑ u : Fin n → Fin (q * r),
    eC (arithPhase n d ((a : ℝ) / q) ((b : ℝ) / r) h (finIntVec u))

/-- The trivial bound `|G| ≤ 1`. -/
lemma norm_arithG_le_one (d a b : ℕ) {q r : ℕ} (hq : 1 ≤ q) (hr : 1 ≤ r) (h : Fin n → ℤ) :
    ‖arithG n d a q b r h‖ ≤ 1 := by
  have hQ : (0 : ℝ) < ((q * r : ℕ) : ℝ) := by exact_mod_cast Nat.mul_pos hq hr
  unfold arithG
  rw [norm_mul, norm_inv, norm_pow, Complex.norm_natCast]
  refine (mul_le_mul_of_nonneg_left (norm_sum_le _ _) (by positivity)).trans ?_
  simp only [norm_eC, sum_const, card_univ, Fintype.card_pi, Fintype.card_fin, prod_const,
    nsmul_eq_mul, mul_one]
  push_cast
  rw [inv_mul_cancel₀ (by positivity)]

/-- `e` of a finite sum is the product of the `e`'s. -/
lemma arith_eC_finsetSum {ι : Type*} (s : Finset ι) (f : ι → ℝ) :
    eC (∑ i ∈ s, f i) = ∏ i ∈ s, eC (f i) := by
  unfold eC; push_cast; rw [Finset.mul_sum, Complex.exp_sum]

lemma arithPhase_one (α β : ℝ) (h v : Fin n → ℤ) :
    arithPhase n 1 α β h v = ∑ i, (α * (v i : ℝ) ^ 2 - β * ((v i : ℝ) + h i) ^ 2) := by
  simp [arithPhase, radialPolyZ, Finset.mul_sum, Finset.sum_sub_distrib]

/-- For `D = 2` the complete sum factors over the coordinates. -/
lemma arithG_one_eq_prod (a q b r : ℕ) (h : Fin n → ℤ) :
    arithG n 1 a q b r h = ∏ i, (((q * r : ℕ) : ℂ))⁻¹ * ∑ t : Fin (q * r),
      eC ((a : ℝ) / q * ((t : ℕ) : ℝ) ^ 2 - (b : ℝ) / r * (((t : ℕ) : ℝ) + h i) ^ 2) := by
  unfold arithG
  simp_rw [arithPhase_one, arith_eC_finsetSum]
  rw [Finset.prod_mul_distrib, prod_const, card_univ, Fintype.card_fin, inv_pow]
  congr 1
  rw [Finset.prod_univ_sum, Fintype.piFinset_univ]
  simp [finIntVec]

/-- The one-dimensional quadratic factor in the form of Lemma 3.6. -/
lemma arith_quad_factor_eq (a q b r : ℕ) (hq : 1 ≤ q) (hr : 1 ≤ r) (h0 : ℤ) :
    (((q * r : ℕ) : ℂ))⁻¹ * ∑ t : Fin (q * r),
      eC ((a : ℝ) / q * ((t : ℕ) : ℝ) ^ 2 - (b : ℝ) / r * (((t : ℕ) : ℝ) + h0) ^ 2) =
    eC (-((b : ℝ) / r * (h0 : ℝ) ^ 2)) * ((((q * r : ℕ) : ℂ))⁻¹ * ∑ z ∈ range (q * r),
      eC ((((a * r - b * q : ℤ) : ℝ) * (z : ℝ) ^ 2 + ((-2 * b * h0 * q : ℤ) : ℝ) * z) /
        ((q * r : ℕ) : ℝ))) := by
  have hsum : ∑ t : Fin (q * r),
      eC ((a : ℝ) / q * ((t : ℕ) : ℝ) ^ 2 - (b : ℝ) / r * (((t : ℕ) : ℝ) + h0) ^ 2) =
      eC (-((b : ℝ) / r * (h0 : ℝ) ^ 2)) * ∑ z ∈ range (q * r),
      eC ((((a * r - b * q : ℤ) : ℝ) * (z : ℝ) ^ 2 + ((-2 * b * h0 * q : ℤ) : ℝ) * z) /
        ((q * r : ℕ) : ℝ)) := by
    rw [Fin.sum_univ_eq_sum_range (fun t : ℕ =>
      eC ((a : ℝ) / q * (t : ℝ) ^ 2 - (b : ℝ) / r * ((t : ℝ) + h0) ^ 2)) (q * r), Finset.mul_sum]
    refine sum_congr rfl fun z _ => ?_
    rw [← eC_add]
    congr 1
    have hq0 : (q : ℝ) ≠ 0 := by have : (0 : ℝ) < q := by exact_mod_cast hq
                                 exact this.ne'
    have hr0 : (r : ℝ) ≠ 0 := by have : (0 : ℝ) < r := by exact_mod_cast hr
                                 exact this.ne'
    push_cast
    field_simp
    ring
  rw [hsum]; ring

/-- `√(2/v) ≤ √2 N^{-1/8}` for `v ≥ N^{1/4}`. -/
lemma arith_sqrt_two_div_le {N v : ℝ} (hN : 0 < N) (hv : N ^ (1 / 4 : ℝ) ≤ v) :
    Real.sqrt (2 / v) ≤ Real.sqrt 2 * N ^ (-(1 / 8 : ℝ)) := by
  have h4 : 0 < N ^ (1 / 4 : ℝ) := Real.rpow_pos_of_pos hN _
  have hv0 : 0 < v := h4.trans_le hv
  have e : N ^ (-(1 / 8 : ℝ)) = Real.sqrt ((N ^ (1 / 4 : ℝ))⁻¹) := by
    rw [Real.sqrt_eq_rpow, ← Real.rpow_neg hN.le, ← Real.rpow_mul hN.le]; norm_num
  rw [e, ← Real.sqrt_mul (by norm_num)]
  refine Real.sqrt_le_sqrt ?_
  rw [div_eq_mul_inv]
  gcongr

open scoped Classical in
/-- Blueprint Lemma 9.2, the case `D = 2`: with `v` the reduced denominator of `a/q - b/r`,
`|G| ≤ √2 N^{-1/8}` unless `r ∣ 2 v h₁` for some `1 ≤ v ≤ N^{1/4}`. -/
lemma norm_arithG_one_le {m : ℕ} (a q b r N : ℕ) (hq : 1 ≤ q) (hr : 1 ≤ r) (hN : 1 ≤ N)
    (hbr : Nat.Coprime b r) (h : Fin (m + 1) → ℤ) :
    ‖arithG (m + 1) 1 a q b r h‖ ≤ Real.sqrt 2 * (N : ℝ) ^ (-(1 / 8 : ℝ)) +
      if (∃ v : ℕ, 1 ≤ v ∧ (v : ℝ) ≤ (N : ℝ) ^ (1 / 4 : ℝ) ∧ (r : ℤ) ∣ 2 * v * h 0)
        then 1 else 0 := by
  classical
  have hQ : 1 ≤ q * r := Nat.mul_pos hq hr
  have hN0 : (0 : ℝ) < N := by exact_mod_cast hN
  have hs0 : 0 ≤ Real.sqrt 2 * (N : ℝ) ^ (-(1 / 8 : ℝ)) := by positivity
  set A : ℤ := a * r - b * q
  set B : ℤ := -2 * b * h 0 * q
  set Gq : ℂ := (((q * r : ℕ) : ℂ))⁻¹ * ∑ z ∈ range (q * r),
      eC ((A * (z : ℝ) ^ 2 + B * z) / ((q * r : ℕ) : ℝ)) with hGq
  have hfac : ∀ i, ‖(((q * r : ℕ) : ℂ))⁻¹ * ∑ t : Fin (q * r),
      eC ((a : ℝ) / q * ((t : ℕ) : ℝ) ^ 2 - (b : ℝ) / r * (((t : ℕ) : ℝ) + h i) ^ 2)‖ ≤ 1 := by
    intro i
    rw [norm_mul, norm_inv, Complex.norm_natCast]
    refine (mul_le_mul_of_nonneg_left (norm_sum_le _ _) (by positivity)).trans ?_
    simp only [norm_eC, sum_const, card_univ, Fintype.card_fin, nsmul_eq_mul, mul_one]
    push_cast
    rw [inv_mul_cancel₀ (by positivity)]
  have hmain : ‖arithG (m + 1) 1 a q b r h‖ ≤ ‖Gq‖ := by
    rw [arithG_one_eq_prod, Fin.prod_univ_succ, norm_mul, arith_quad_factor_eq a q b r hq hr,
      norm_mul, norm_eC, one_mul]
    refine mul_le_of_le_one_right (norm_nonneg _) ?_
    rw [norm_prod]
    exact Finset.prod_le_one₀ (fun _ _ => norm_nonneg _) fun i _ => hfac _
  have hG1 : ‖arithG (m + 1) 1 a q b r h‖ ≤ 1 := norm_arithG_le_one 1 a b hq hr h
  set v : ℕ := (q * r) / Int.gcd A (q * r : ℕ) with hv
  have hg0 : 0 < Int.gcd A (q * r : ℕ) :=
    Int.gcd_pos_of_ne_zero_right _ (by exact_mod_cast (show q * r ≠ 0 by omega))
  have hgQ : Int.gcd A (q * r : ℕ) ≤ q * r := by
    have := Int.gcd_dvd_right A ((q * r : ℕ) : ℤ)
    exact Nat.le_of_dvd hQ (by exact_mod_cast this)
  have hv1 : 1 ≤ v := Nat.div_pos hgQ hg0
  by_cases hvN : (N : ℝ) ^ (1 / 4 : ℝ) ≤ v
  · refine hmain.trans ((norm_quadratic_complete_sum_le A B hQ).trans ?_)
    refine (arith_sqrt_two_div_le hN0 hvN).trans ?_
    split_ifs <;> linarith
  · push Not at hvN
    by_cases hG : Gq = 0
    · refine hmain.trans ?_
      rw [hG, norm_zero]
      split_ifs <;> linarith
    · have hdvd := dvd_of_quadratic_complete_sum_ne_zero A B b (h 0) hQ (Dvd.intro_left q rfl)
        (by simpa [Int.gcd_natCast_natCast] using hbr)
        (by rw [Nat.mul_div_cancel _ (by omega)]) hG
      have hex : ∃ v : ℕ, 1 ≤ v ∧ (v : ℝ) ≤ (N : ℝ) ^ (1 / 4 : ℝ) ∧ (r : ℤ) ∣ 2 * v * h 0 :=
        ⟨v, hv1, hvN.le, hdvd⟩
      rw [ite_eq_left hex]
      linarith

/-- The phase `α P(v) - β P(v + h)`, `v = (t, s)`, as a polynomial in the first coordinate `t`
(Blueprint Lemma 3.1). -/
noncomputable def arithPoly {m : ℕ} (d : ℕ) (α β : ℝ) (h : Fin (m + 1) → ℤ) (s : Fin m → ℤ) :
    ℝ[X] :=
  C α * sliceRadialPoly (m + 1) d 0 (fun l => ((Fin.cons 0 s : Fin (m + 1) → ℤ) l : ℝ)) 0 -
    C β * sliceRadialPoly (m + 1) d 0 (fun l => ((Fin.cons 0 s : Fin (m + 1) → ℤ) l : ℝ))
      (fun l => (h l : ℝ))

lemma arithPoly_natDegree_le {m : ℕ} (d : ℕ) (α β : ℝ) (h : Fin (m + 1) → ℤ) (s : Fin m → ℤ) :
    (arithPoly d α β h s).natDegree ≤ 2 * d := by
  refine (natDegree_sub_le _ _).trans (max_le ?_ ?_) <;>
    exact (natDegree_C_mul_le _ _).trans (sliceRadialPoly_natDegree_le _ _ _ _ _)

lemma arithPoly_eval {m : ℕ} (d : ℕ) (α β : ℝ) (h : Fin (m + 1) → ℤ) (s : Fin m → ℤ) (t : ℤ) :
    ∑ k ∈ range (2 * d + 1), (arithPoly d α β h s).coeff k * (t : ℝ) ^ k =
      arithPhase (m + 1) d α β h (Fin.cons t s) := by
  rw [← eval_eq_sum_range' (Nat.lt_succ_of_le (arithPoly_natDegree_le d α β h s)),
    arithPoly, eval_sub, eval_mul, eval_mul, eval_C, eval_C, sliceRadialPoly_eval,
    sliceRadialPoly_eval]
  have hu : Function.update (fun l => ((Fin.cons 0 s : Fin (m + 1) → ℤ) l : ℝ)) 0 (t : ℝ) =
      fun l => ((Fin.cons t s : Fin (m + 1) → ℤ) l : ℝ) := by
    funext l
    refine Fin.cases ?_ (fun k => ?_) l
    · simp
    · rw [Function.update_of_ne (Fin.succ_ne_zero k)]; simp
  rw [hu]
  simp only [arithPhase, radialPolyZ, Pi.add_apply, Pi.zero_apply, add_zero]
  push_cast
  rfl

lemma arithPoly_coeff {m : ℕ} {d : ℕ} (hd : 1 ≤ d) (α β : ℝ) (h : Fin (m + 1) → ℤ)
    (s : Fin m → ℤ) : (arithPoly d α β h s).coeff (2 * d - 1) = -(2 * d * β * h 0) := by
  rw [arithPoly, coeff_sub, coeff_C_mul, coeff_C_mul,
    sliceRadialPoly_coeff_top_sub_one _ (by omega),
    sliceRadialPoly_coeff_top_sub_one _ (by omega)]
  simp only [Pi.zero_apply]
  ring

lemma arith_finIntVec_cons {m q : ℕ} (t : Fin q) (s : Fin m → Fin q) :
    finIntVec (Fin.cons t s : Fin (m + 1) → Fin q) = Fin.cons ((t : ℕ) : ℤ) (finIntVec s) := by
  funext l
  refine Fin.cases ?_ (fun k => ?_) l <;> simp [finIntVec]

/-- Slicing the complete sum in the first coordinate, with `t ∈ [1, Q]` (periodicity). -/
lemma sum_eC_arithPhase_slice {m : ℕ} (d a b : ℕ) {q r : ℕ} (hq : 1 ≤ q) (hr : 1 ≤ r)
    (h : Fin (m + 1) → ℤ) :
    ∑ u : Fin (m + 1) → Fin (q * r), eC (arithPhase (m + 1) d ((a : ℝ) / q) ((b : ℝ) / r) h
        (finIntVec u)) =
      ∑ s : Fin m → Fin (q * r), ∑ t ∈ Icc 1 (q * r),
        eC (∑ k ∈ range (2 * d + 1),
          (arithPoly d ((a : ℝ) / q) ((b : ℝ) / r) h (finIntVec s)).coeff k * (t : ℝ) ^ k) := by
  set Q := q * r
  set F : (Fin m → ℤ) → ℕ → ℂ := fun w t =>
    eC (arithPhase (m + 1) d ((a : ℝ) / q) ((b : ℝ) / r) h (Fin.cons (t : ℤ) w)) with hF
  rw [← (Fin.consEquiv fun _ : Fin (m + 1) => Fin Q).sum_comp, Fintype.sum_prod_type_right]
  refine Fintype.sum_congr _ _ fun s => ?_
  have hc : ∀ t : Fin Q, (Fin.consEquiv fun _ : Fin (m + 1) => Fin Q) (t, s) = Fin.cons t s :=
    fun _ => rfl
  simp only [hc, arith_finIntVec_cons]
  have h1 : ∑ t : Fin Q, eC (arithPhase (m + 1) d ((a : ℝ) / q) ((b : ℝ) / r) h
      (Fin.cons ((t : ℕ) : ℤ) (finIntVec s))) = ∑ t ∈ range Q, F (finIntVec s) t :=
    Fin.sum_univ_eq_sum_range (F (finIntVec s)) Q
  have hper : F (finIntVec s) Q = F (finIntVec s) 0 := by
    simp only [hF]
    refine eC_arithPhase_periodic d a b hq hr h fun i => ?_
    refine Fin.cases ?_ (fun k => ?_) i
    · simp only [Fin.cons_zero, Nat.cast_zero]
      exact Int.modEq_zero_iff_dvd.2 (by simp [Q])
    · simp
  have h2 : ∑ t ∈ range Q, F (finIntVec s) t = ∑ t ∈ Icc 1 Q, F (finIntVec s) t := by
    rw [sum_Icc_one_eq_sum_range]
    have e1 := Finset.sum_range_succ (F (finIntVec s)) Q
    have e2 := Finset.sum_range_succ' (F (finIntVec s)) Q
    rw [hper] at e1
    have := e1.symm.trans e2
    exact add_right_cancel this
  rw [h1, h2]
  refine sum_congr rfl fun t _ => ?_
  simp only [hF]
  congr 1
  rw [← arithPoly_eval d _ _ h (finIntVec s) (t : ℤ)]
  simp

/-- Blueprint Lemma 9.2, the case `D = 2d ≥ 4`: there are `C ≥ 1` and `c > 0` such that if
`N/2 ≤ r ≤ N`, `(b, r) = 1` and `gcd(D b h₁, r) ≤ N^{1/2}`, then `|G| ≤ C N^{-c}` (for every
`a/q`, `q ≥ 1`). The coefficient of `t^{D-1}` on every slice is `-D (b/r) h₁` (Lemma 3.1), whose
reduced denominator lies in `[N^{1/2}/2, N]`, and Corollary 3.5 applies. -/
lemma norm_arithG_slice_le {m d : ℕ} (hd : 2 ≤ d) :
    ∃ C c : ℝ, 1 ≤ C ∧ 0 < c ∧ ∀ (a q b r N : ℕ), 1 ≤ q → 1 ≤ r → 1 ≤ N → N ≤ 2 * r → r ≤ N →
      ∀ h : Fin (m + 1) → ℤ, (Int.gcd (2 * d * b * h 0) r : ℝ) ≤ Real.sqrt N →
        ‖arithG (m + 1) d a q b r h‖ ≤ C * (N : ℝ) ^ (-c) := by
  obtain ⟨C, c, hC, hc, hcor⟩ := norm_sum_slices_le_of_rational_coeff (2 * d)
  refine ⟨C, c, hC, hc, fun a q b r N hq hr hN hNr hrN h hgcd => ?_⟩
  have hQ : 1 ≤ q * r := Nat.mul_pos hq hr
  have hQ0 : (0 : ℝ) < ((q * r : ℕ) : ℝ) := by exact_mod_cast hQ
  have hN1 : (1 : ℝ) ≤ N := by exact_mod_cast hN
  have hr0 : (0 : ℝ) < r := by exact_mod_cast hr
  set X : ℤ := -(2 * d * b * h 0) with hX
  set g : ℕ := Int.gcd X r with hg
  have hg' : g = Int.gcd (2 * d * b * h 0) r := by rw [hg, hX, Int.neg_gcd]
  have hg0 : 0 < g := Int.gcd_pos_of_ne_zero_right _ (by exact_mod_cast (show r ≠ 0 by omega))
  have hgr : g ∣ r := by
    have := Int.gcd_dvd_right X (r : ℤ); exact_mod_cast this
  have hgX : (g : ℤ) ∣ X := Int.gcd_dvd_left X r
  set B' : ℤ := X / g
  set r' : ℕ := r / g
  have hg0R : (g : ℝ) ≠ 0 := by exact_mod_cast hg0.ne'
  have hr'R : (r' : ℝ) = r / g := Nat.cast_div hgr hg0R
  have hB'R : (B' : ℝ) = X / g := by
    rw [Int.cast_div hgX (by exact_mod_cast hg0.ne')]; rfl
  have hcop : Int.gcd B' r' = 1 := by
    have := Int.gcd_div_gcd_div_gcd (i := X) (j := r) (by omega)
    rw [← hg] at this
    convert this using 2
    simp [r']
  -- the coefficient
  have hcoeff : ∀ s : Fin m → Fin (q * r),
      (arithPoly d ((a : ℝ) / q) ((b : ℝ) / r) h (finIntVec s)).coeff (2 * d - 1) =
        (B' : ℝ) / r' := by
    intro s
    rw [arithPoly_coeff (by omega), hB'R, hr'R, hX]
    push_cast
    field_simp
  have hgN : (g : ℝ) ≤ Real.sqrt N := by rw [hg']; exact hgcd
  have hsqrt : Real.sqrt N ^ 2 = N := Real.sq_sqrt (by linarith)
  have hsq0 : 0 < Real.sqrt N := Real.sqrt_pos.2 (by linarith)
  have hg1 : (1 : ℝ) ≤ g := by exact_mod_cast hg0
  have hr'lo : Real.sqrt N / 2 ≤ r' := by
    rw [hr'R, le_div_iff₀ (by linarith)]
    have h2r : (N : ℝ) ≤ 2 * r := by exact_mod_cast hNr
    nlinarith
  have hr'hi : (r' : ℝ) ≤ N := by
    have : r' ≤ N := (Nat.div_le_self r g).trans hrN
    exact_mod_cast this
  have hQN : (N : ℝ) / 2 ≤ ((q * r : ℕ) : ℝ) := by
    have h2r : (N : ℝ) ≤ 2 * r := by exact_mod_cast hNr
    have : (r : ℝ) ≤ ((q * r : ℕ) : ℝ) := by
      exact_mod_cast Nat.le_mul_of_pos_left r hq
    linarith
  have hbound := hcor (univ : Finset (Fin m → Fin (q * r)))
    (fun s k => (arithPoly d ((a : ℝ) / q) ((b : ℝ) / r) h (finIntVec s)).coeff k)
    (fun _ => B') (fun _ => r') (N : ℝ) (q * r) (2 * d - 1) hN1 hQN (by omega) (by omega)
    (fun s _ => hcoeff s) (fun _ _ => hcop) (fun _ _ => hr'lo) (fun _ _ => hr'hi)
  unfold arithG
  rw [sum_eC_arithPhase_slice d a b hq hr h, norm_mul, norm_inv, norm_pow, Complex.norm_natCast]
  rw [card_univ, Fintype.card_pi, prod_const, card_univ, Fintype.card_fin, Fintype.card_fin]
    at hbound
  calc (((q * r : ℕ) : ℝ) ^ (m + 1))⁻¹ * ‖_‖
      ≤ (((q * r : ℕ) : ℝ) ^ (m + 1))⁻¹ *
          (C * (N : ℝ) ^ (-c) * ((q * r : ℕ) : ℝ) * (((q * r) ^ m : ℕ) : ℝ)) :=
        mul_le_mul_of_nonneg_left hbound (by positivity)
    _ = C * (N : ℝ) ^ (-c) := by
        push_cast
        field_simp
        ring

/-- Progression count on `[-R, R]` (Lemma 3.2): `#{t ∈ [-R, R] : g ∣ D t} ≤ 2 D R / g + D + 1`. -/
lemma arith_card_Icc_filter_dvd_le {g D : ℕ} (hg : 0 < g) (hD : 0 < D) (R : ℕ) :
    (#{t ∈ Finset.Icc (-(R : ℤ)) R | (g : ℤ) ∣ D * t} : ℝ) ≤ D * (2 * R) / g + D + 1 :=
  card_filter_dvd_mul_le hg hD (by positivity) (-(R : ℝ)) _ fun t ht => by
    rw [Finset.mem_Icc] at ht
    constructor
    · exact_mod_cast ht.1
    · have : (t : ℝ) ≤ R := by exact_mod_cast ht.2
      linarith

/-- Blueprint Lemma 9.2, exceptional density for `D ≥ 4`: for `(b, r) = 1`, `1 ≤ r ≤ N` and
`R ≥ N`, `#{t ∈ [-R, R] : gcd(D b t, r) > N^{1/2}} ≤ C N^{-3/8} (2R + 1)` (divisor bound with
exponent `1/8` and progression counts). -/
lemma card_exc_slice_le (d : ℕ) (hd : 1 ≤ d) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (b r N : ℕ), 1 ≤ r → r ≤ N → Nat.Coprime b r → ∀ R : ℕ, N ≤ R →
      (#{t ∈ Finset.Icc (-(R : ℤ)) R | Real.sqrt N < (Int.gcd (2 * d * b * t) r : ℝ)} : ℝ) ≤
        C * (N : ℝ) ^ (-(3 / 8 : ℝ)) * (2 * R + 1) := by
  obtain ⟨Cτ, hτ⟩ := card_divisors_le_rpow (ε := 1 / 8) (by norm_num)
  have hCτ : 0 ≤ Cτ := by
    have := hτ 1 one_pos
    simp at this; linarith
  refine ⟨Cτ * (6 * d + 1), by positivity, fun b r N hr hrN hbr R hR => ?_⟩
  classical
  have hN1 : (1 : ℝ) ≤ N := by exact_mod_cast hr.trans hrN
  have hN0 : (0 : ℝ) < N := by linarith
  have hRN : (N : ℝ) ≤ R := by exact_mod_cast hR
  set D : ℕ := 2 * d
  have hD : 0 < D := by omega
  set G : Finset ℕ := r.divisors.filter fun g : ℕ => Real.sqrt N < (g : ℝ)
  have hsub : {t ∈ Finset.Icc (-(R : ℤ)) R | Real.sqrt N < (Int.gcd (2 * d * b * t) r : ℝ)} ⊆
      G.biUnion fun g => {t ∈ Finset.Icc (-(R : ℤ)) R | (g : ℤ) ∣ D * t} := by
    intro t ht
    rw [mem_filter] at ht
    rw [Finset.mem_biUnion]
    set g := Int.gcd (2 * d * b * t) r
    have hgr : g ∣ r := by
      have := Int.gcd_dvd_right (2 * d * b * t) (r : ℤ); exact_mod_cast this
    refine ⟨g, ?_, ?_⟩
    · rw [mem_filter, Nat.mem_divisors]; exact ⟨⟨hgr, by omega⟩, ht.2⟩
    · rw [mem_filter]
      refine ⟨ht.1, ?_⟩
      have h1 : (g : ℤ) ∣ (D * t) * b := by
        have := Int.gcd_dvd_left (2 * d * b * t) (r : ℤ)
        have e : (2 * d * b * t : ℤ) = (D * t) * b := by simp only [D]; push_cast; ring
        exact this.trans (dvd_of_eq e)
      have hcop : IsCoprime (g : ℤ) (b : ℤ) := by
        have hc : Nat.Coprime g b := Nat.Coprime.coprime_dvd_left hgr hbr.symm
        exact Nat.isCoprime_iff_coprime.2 hc
      exact hcop.dvd_of_dvd_mul_right h1
  have hsqrt : Real.sqrt N ^ 2 = N := Real.sq_sqrt hN0.le
  have hsq0 : 0 < Real.sqrt N := Real.sqrt_pos.2 hN0
  have hsqR : Real.sqrt N ≤ R := by
    have : Real.sqrt N ≤ N := by nlinarith [Real.sqrt_nonneg (N : ℝ)]
    linarith
  have hterm : ∀ g ∈ G, (#{t ∈ Finset.Icc (-(R : ℤ)) R | (g : ℤ) ∣ D * t} : ℝ) ≤
      D * (2 * R) / Real.sqrt N + D + 1 := by
    intro g hg
    rw [mem_filter, Nat.mem_divisors] at hg
    have hg0 : 0 < g := Nat.pos_of_dvd_of_pos hg.1.1 (by omega)
    refine (arith_card_Icc_filter_dvd_le hg0 hD R).trans ?_
    gcongr; exact hg.2.le
  have hcardG : (#G : ℝ) ≤ Cτ * (N : ℝ) ^ (1 / 8 : ℝ) := by
    have h1 : (#G : ℝ) ≤ (r.divisors.card : ℝ) := by exact_mod_cast Finset.card_filter_le _ _
    refine h1.trans ((hτ r (by omega)).trans ?_)
    gcongr
  calc (#{t ∈ Finset.Icc (-(R : ℤ)) R | Real.sqrt N < (Int.gcd (2 * d * b * t) r : ℝ)} : ℝ)
      ≤ (#(G.biUnion fun g => {t ∈ Finset.Icc (-(R : ℤ)) R | (g : ℤ) ∣ D * t}) : ℝ) := by
        exact_mod_cast Finset.card_le_card hsub
    _ ≤ ∑ g ∈ G, (#{t ∈ Finset.Icc (-(R : ℤ)) R | (g : ℤ) ∣ D * t} : ℝ) := by
        exact_mod_cast Finset.card_biUnion_le
    _ ≤ ∑ g ∈ G, (D * (2 * R) / Real.sqrt N + D + 1) := sum_le_sum hterm
    _ = #G * (D * (2 * R) / Real.sqrt N + D + 1) := by rw [sum_const, nsmul_eq_mul]
    _ ≤ Cτ * (N : ℝ) ^ (1 / 8 : ℝ) * (D * (2 * R) / Real.sqrt N + D + 1) := by
        gcongr
    _ ≤ Cτ * (6 * d + 1) * (N : ℝ) ^ (-(3 / 8 : ℝ)) * (2 * R + 1) := by
        have e1 : (N : ℝ) ^ (1 / 8 : ℝ) / Real.sqrt N = (N : ℝ) ^ (-(3 / 8 : ℝ)) := by
          rw [Real.sqrt_eq_rpow, ← Real.rpow_sub hN0]; norm_num
        have e2 : (N : ℝ) ^ (1 / 8 : ℝ) = (N : ℝ) ^ (-(3 / 8 : ℝ)) * Real.sqrt N := by
          rw [← e1, div_mul_cancel₀ _ hsq0.ne']
        have hp : 0 ≤ (N : ℝ) ^ (-(3 / 8 : ℝ)) := by positivity
        have hDd : (D : ℝ) = 2 * d := by simp only [D]; push_cast; ring
        have key : (N : ℝ) ^ (1 / 8 : ℝ) * (D * (2 * R) / Real.sqrt N + D + 1) ≤
            (6 * d + 1) * (N : ℝ) ^ (-(3 / 8 : ℝ)) * (2 * R + 1) := by
          rw [mul_add, mul_add, mul_div_assoc', mul_comm ((N : ℝ) ^ (1 / 8 : ℝ)) (D * (2 * R)),
            mul_div_assoc, e1, e2, hDd]
          have hd1 : (1 : ℝ) ≤ d := by exact_mod_cast hd
          nlinarith [mul_nonneg hp hsq0.le, mul_le_mul_of_nonneg_left hsqR hp]
        calc Cτ * (N : ℝ) ^ (1 / 8 : ℝ) * (D * (2 * R) / Real.sqrt N + D + 1)
            = Cτ * ((N : ℝ) ^ (1 / 8 : ℝ) * (D * (2 * R) / Real.sqrt N + D + 1)) := by ring
          _ ≤ Cτ * ((6 * d + 1) * (N : ℝ) ^ (-(3 / 8 : ℝ)) * (2 * R + 1)) :=
            mul_le_mul_of_nonneg_left key hCτ
          _ = _ := by ring

open scoped Classical in
/-- Blueprint Lemma 9.2, exceptional density for `D = 2`: for `N/2 ≤ r` and `R ≥ N`,
`#{t ∈ [-R, R] : r ∣ 2 v t for some 1 ≤ v ≤ N^{1/4}} ≤ 11 N^{-3/8} (2R + 1)`. -/
lemma card_exc_quad_le (r N : ℕ) (hN : 1 ≤ N) (hNr : N ≤ 2 * r) (R : ℕ) (hR : N ≤ R) :
    (#{t ∈ Finset.Icc (-(R : ℤ)) R | ∃ v : ℕ, 1 ≤ v ∧ (v : ℝ) ≤ (N : ℝ) ^ (1 / 4 : ℝ) ∧
        (r : ℤ) ∣ 2 * v * t} : ℝ) ≤ 11 * (N : ℝ) ^ (-(3 / 8 : ℝ)) * (2 * R + 1) := by
  classical
  have hN1 : (1 : ℝ) ≤ N := by exact_mod_cast hN
  have hN0 : (0 : ℝ) < N := by linarith
  have hr : 0 < r := by omega
  have hr0 : (0 : ℝ) < r := by exact_mod_cast hr
  have hRN : (N : ℝ) ≤ R := by exact_mod_cast hR
  set V : ℝ := (N : ℝ) ^ (1 / 4 : ℝ) with hV
  have hV1 : 1 ≤ V := Real.one_le_rpow hN1 (by norm_num)
  set w : ℝ := Real.sqrt N with hw
  have hw0 : 0 < w := Real.sqrt_pos.2 hN0
  have hw2 : w ^ 2 = N := Real.sq_sqrt hN0.le
  have hV2 : V ^ 2 = w := by
    rw [hV, hw, Real.sqrt_eq_rpow, ← Real.rpow_natCast, ← Real.rpow_mul hN0.le]; norm_num
  have hsub : {t ∈ Finset.Icc (-(R : ℤ)) R | ∃ v : ℕ, 1 ≤ v ∧ (v : ℝ) ≤ V ∧
        (r : ℤ) ∣ 2 * v * t} ⊆
      (Finset.Icc 1 ⌊V⌋₊).biUnion fun v =>
        {t ∈ Finset.Icc (-(R : ℤ)) R | (r : ℤ) ∣ ((2 * v : ℕ) : ℤ) * t} := by
    intro t ht
    rw [mem_filter] at ht
    obtain ⟨v, hv1, hvV, hdvd⟩ := ht.2
    rw [Finset.mem_biUnion]
    refine ⟨v, Finset.mem_Icc.2 ⟨hv1, Nat.le_floor hvV⟩, mem_filter.2 ⟨ht.1, ?_⟩⟩
    push_cast; exact hdvd
  have hterm : ∀ v ∈ Finset.Icc 1 ⌊V⌋₊,
      (#{t ∈ Finset.Icc (-(R : ℤ)) R | (r : ℤ) ∣ ((2 * v : ℕ) : ℤ) * t} : ℝ) ≤
        2 * V * (2 * R) / r + 2 * V + 1 := by
    intro v hv
    rw [Finset.mem_Icc] at hv
    have hvV : (v : ℝ) ≤ V := (Nat.le_floor_iff (by linarith)).1 hv.2
    refine (arith_card_Icc_filter_dvd_le hr (by omega) R).trans ?_
    push_cast
    gcongr
  have hcard : (#(Finset.Icc 1 ⌊V⌋₊) : ℝ) ≤ V := by
    rw [Nat.card_Icc, Nat.add_sub_cancel]; exact Nat.floor_le (by linarith)
  have h2r : (N : ℝ) ≤ 2 * r := by exact_mod_cast hNr
  calc (#{t ∈ Finset.Icc (-(R : ℤ)) R | ∃ v : ℕ, 1 ≤ v ∧ (v : ℝ) ≤ V ∧
        (r : ℤ) ∣ 2 * v * t} : ℝ)
      ≤ (#((Finset.Icc 1 ⌊V⌋₊).biUnion fun v =>
          {t ∈ Finset.Icc (-(R : ℤ)) R | (r : ℤ) ∣ ((2 * v : ℕ) : ℤ) * t}) : ℝ) := by
        exact_mod_cast Finset.card_le_card hsub
    _ ≤ ∑ v ∈ Finset.Icc 1 ⌊V⌋₊,
          (#{t ∈ Finset.Icc (-(R : ℤ)) R | (r : ℤ) ∣ ((2 * v : ℕ) : ℤ) * t} : ℝ) := by
        exact_mod_cast Finset.card_biUnion_le
    _ ≤ ∑ v ∈ Finset.Icc 1 ⌊V⌋₊, (2 * V * (2 * R) / r + 2 * V + 1) := sum_le_sum hterm
    _ = #(Finset.Icc 1 ⌊V⌋₊) * (2 * V * (2 * R) / r + 2 * V + 1) := by
        rw [sum_const, nsmul_eq_mul]
    _ ≤ V * (2 * V * (2 * R) / r + 2 * V + 1) := by gcongr
    _ ≤ 11 * R / w := by
        have e1 : 2 * V * (2 * R) / r ≤ 8 * V * R / N := by
          have h4 : (0 : ℝ) ≤ 4 * V * R := by positivity
          rw [div_le_div_iff₀ hr0 hN0]; nlinarith [mul_le_mul_of_nonneg_left h2r h4]
        have e2 : V * (8 * V * R / N) = 8 * R / w := by
          rw [← hw2]; field_simp; rw [← hV2]; ring
        have e3 : V * (2 * V + 1) ≤ 3 * w := by nlinarith
        have e4 : 3 * w ≤ 3 * R / w := by
          rw [le_div_iff₀ hw0]; nlinarith
        calc V * (2 * V * (2 * R) / r + 2 * V + 1)
            = V * (2 * V * (2 * R) / r) + V * (2 * V + 1) := by ring
          _ ≤ V * (8 * V * R / N) + 3 * w := by gcongr
          _ ≤ 8 * R / w + 3 * R / w := by rw [e2]; linarith
          _ = 11 * R / w := by ring
    _ ≤ 11 * (N : ℝ) ^ (-(3 / 8 : ℝ)) * (2 * R + 1) := by
        have e5 : 1 / w ≤ (N : ℝ) ^ (-(3 / 8 : ℝ)) := by
          rw [hw, Real.sqrt_eq_rpow, one_div, ← Real.rpow_neg hN0.le]
          exact Real.rpow_le_rpow_of_exponent_le hN1 (by norm_num)
        have hp : 0 ≤ (N : ℝ) ^ (-(3 / 8 : ℝ)) := by positivity
        calc 11 * R / w = 11 * R * (1 / w) := by ring
          _ ≤ 11 * R * (N : ℝ) ^ (-(3 / 8 : ℝ)) := by gcongr
          _ ≤ 11 * (N : ℝ) ^ (-(3 / 8 : ℝ)) * (2 * R + 1) := by nlinarith

open scoped Classical in
/-- Blueprint Lemma 9.2, the complete-sum bound in both degree cases: there are `c, b > 0` (here
`b = 3/8`) with `|G| ≤ C N^{-c} + 𝟙_{E}(h₁)` for an exceptional set `E ⊆ ℤ` depending only on
`(b, r)` (and `N`), of density at most `C' N^{-3/8}` in every interval `[-R, R]`, `R ≥ N`. -/
lemma exists_arithG_bound {m d : ℕ} (hd : 1 ≤ d) :
    ∃ C c C' : ℝ, 0 ≤ C ∧ 0 < c ∧ 0 ≤ C' ∧ ∀ N b r : ℕ, 1 ≤ N → N ≤ 2 * r → r ≤ N →
      Nat.Coprime b r → ∃ E : Set ℤ,
        (∀ R : ℕ, N ≤ R → (#{t ∈ Finset.Icc (-(R : ℤ)) R | t ∈ E} : ℝ) ≤
          C' * (N : ℝ) ^ (-(3 / 8 : ℝ)) * (2 * R + 1)) ∧
        ∀ (a q : ℕ) (h : Fin (m + 1) → ℤ), 1 ≤ q →
          ‖arithG (m + 1) d a q b r h‖ ≤ C * (N : ℝ) ^ (-c) + if h 0 ∈ E then 1 else 0 := by
  rcases Nat.lt_or_ge d 2 with hd1 | hd2
  · obtain rfl : d = 1 := by omega
    refine ⟨Real.sqrt 2, 1 / 8, 11, by positivity, by norm_num, by norm_num,
      fun N b r hN hNr hrN hbr => ?_⟩
    refine ⟨{t | ∃ v : ℕ, 1 ≤ v ∧ (v : ℝ) ≤ (N : ℝ) ^ (1 / 4 : ℝ) ∧ (r : ℤ) ∣ 2 * v * t},
      fun R hR => ?_, fun a q h hq => ?_⟩
    · simpa only [Set.mem_ofPred_eq] using card_exc_quad_le r N hN hNr R hR
    · simpa only [Set.mem_ofPred_eq] using norm_arithG_one_le a q b r N hq (by omega) hN hbr h
  · obtain ⟨C, c, hC, hc, hsl⟩ := norm_arithG_slice_le (m := m) hd2
    obtain ⟨C', hC', hcnt⟩ := card_exc_slice_le d hd
    refine ⟨C, c, C', by linarith, hc, hC', fun N b r hN hNr hrN hbr => ?_⟩
    refine ⟨{t | Real.sqrt N < (Int.gcd (2 * d * b * t) r : ℝ)}, fun R hR => ?_,
      fun a q h hq => ?_⟩
    · simpa only [Set.mem_ofPred_eq] using hcnt b r N (by omega) hrN hbr R hR
    · by_cases hE : h 0 ∈ {t : ℤ | Real.sqrt N < (Int.gcd (2 * d * b * t) r : ℝ)}
      · rw [ite_eq_left hE]
        have h1 := norm_arithG_le_one (n := m + 1) (q := q) (r := r) d a b hq (by omega) h
        have h2 : 0 ≤ C * (N : ℝ) ^ (-c) := by positivity
        linarith
      · rw [ite_eq_right hE, add_zero]
        exact hsl a q b r N hq (by omega) hN hNr hrN h (not_lt.1 hE)


open scoped Classical in
/-- The lattice points of the cube `|hᵢ| ≤ R` whose first coordinate lies in `E`. -/
lemma arith_count_intCube_inter_le {m : ℕ} (E : Set ℤ) (R : ℕ) {δ : ℝ}
    (hE : (#{t ∈ Finset.Icc (-(R : ℤ)) R | t ∈ E} : ℝ) ≤ δ * (2 * R + 1)) :
    Measure.count (intCube (0 : Fin (m + 1) → ℤ) R ∩ {h | h 0 ∈ E}) ≤
      ENNReal.ofReal (δ * (2 * R + 1) ^ (m + 1)) := by
  set t : Fin (m + 1) → Finset ℤ := fun i =>
    if i = 0 then {t ∈ Finset.Icc (-(R : ℤ)) R | t ∈ E} else Finset.Icc (-(R : ℤ)) R
  have hset : intCube (0 : Fin (m + 1) → ℤ) R ∩ {h | h 0 ∈ E} = (Fintype.piFinset t : Set _) := by
    ext h
    simp only [intCube, Set.mem_inter_iff, Set.mem_ofPred_eq, Pi.zero_apply, sub_zero,
      Finset.mem_coe, Fintype.mem_piFinset, t]
    constructor
    · rintro ⟨h1, h2⟩ i
      split_ifs with hi
      · subst hi; exact mem_filter.2 ⟨Finset.mem_Icc.2 (abs_le.1 (h1 0)), h2⟩
      · exact Finset.mem_Icc.2 (abs_le.1 (h1 i))
    · intro h1
      refine ⟨fun i => ?_, ?_⟩
      · have := h1 i
        split_ifs at this with hi
        · exact abs_le.2 (Finset.mem_Icc.1 (mem_filter.1 this).1)
        · exact abs_le.2 (Finset.mem_Icc.1 this)
      · have := h1 0
        simp only [↓reduceIte] at this
        exact (mem_filter.1 this).2
  rw [hset, Measure.count_apply_finset, Fintype.card_piFinset, Fin.prod_univ_succ]
  simp only [t, ↓reduceIte, Fin.succ_ne_zero, prod_const, card_univ, Fintype.card_fin,
    Int.card_Icc]
  have hc : ((R : ℤ) + 1 - -(R : ℤ)).toNat = 2 * R + 1 := by omega
  rw [hc, ← ENNReal.ofReal_natCast]
  refine ENNReal.ofReal_le_ofReal ?_
  push_cast
  rw [pow_succ']
  have : (0 : ℝ) ≤ (2 * R + 1) ^ m := by positivity
  nlinarith

open scoped Classical in
/-- Blueprint Lemma 9.2, the lattice sum of `B_L` over an exceptional set (dyadic shells): if
`E ⊆ ℤ` has density at most `δ` in every interval `[-R, R]` with `R ≥ L` (`L ≥ 1`), then
`∑_{h : h₁ ∈ E} B_L(h) ≤ C_n δ`, `C_n = envelopeConst n`. -/
lemma arith_tsum_latEnvelope_indicator_le {m : ℕ} {E : Set ℤ} {L δ : ℝ} (hL : 1 ≤ L) (hδ : 0 ≤ δ)
    (hE : ∀ R : ℕ, L ≤ R → (#{t ∈ Finset.Icc (-(R : ℤ)) R | t ∈ E} : ℝ) ≤ δ * (2 * R + 1)) :
    ∑' h : Fin (m + 1) → ℤ, ENNReal.ofReal (latEnvelope (m + 1) L h) *
        (if h 0 ∈ E then 1 else 0) ≤
      ENNReal.ofReal (envelopeConst (m + 1) * δ) := by
  have hL0 : 0 < L := by linarith
  set T : Set (Fin (m + 1) → ℤ) := {h | h 0 ∈ E}
  have hg : ∀ h : Fin (m + 1) → ℤ, (if h 0 ∈ E then (1 : ℝ≥0∞) else 0) = T.indicator 1 h := by
    intro h; by_cases hh : h 0 ∈ E <;> simp [T, hh]
  simp_rw [hg]
  rw [← lintegral_count]
  refine (lintegral_mul_le_tsum_setLIntegral Measure.count
    (AEMeasurable.of_discrete (f := T.indicator 1))
    (fun k => MeasurableSet.of_discrete (s := intCube 0 ⌈2 ^ k * L⌉₊)) _
    (envelope_le_tsum_indicator_int hL0)).trans ?_
  rw [ENNReal.ofReal_mul (by unfold envelopeConst; positivity),
    ← tsum_envelopeCoeff_mul (m + 1) hL0]
  refine ENNReal.tsum_le_tsum fun k => ?_
  gcongr
  rw [lintegral_indicator_one MeasurableSet.of_discrete, Measure.restrict_apply
    MeasurableSet.of_discrete, Set.inter_comm]
  set R : ℕ := ⌈2 ^ k * L⌉₊
  have hk1 : (1 : ℝ) ≤ 2 ^ k * L := one_le_mul_of_one_le_of_one_le (one_le_pow₀ one_le_two) hL
  have hLR : L ≤ R := by
    have : L ≤ 2 ^ k * L := le_mul_of_one_le_left hL0.le (one_le_pow₀ one_le_two)
    exact this.trans (Nat.le_ceil _)
  refine (arith_count_intCube_inter_le E R (hE R hLR)).trans ?_
  rw [← ENNReal.ofReal_mul (by positivity), mul_comm]
  refine ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_right ?_ hδ)
  refine pow_le_pow_left₀ (by positivity) ?_ _
  have := Nat.ceil_lt_add_one (show 0 ≤ 2 ^ k * L by positivity)
  linarith


/-- The Schwartz function `𝓕⁻ χ`, of which `φ_s` is the `L_s`-dilate
(`arith_liftPhi_eq_dilateL`). -/
noncomputable def arithPhiS (n : ℕ) : 𝓢(EuclideanSpace ℝ (Fin n), ℂ) := 𝓕⁻ (liftCutoffSchwartz n)

/-- `φ_s = (𝓕⁻ χ)_{L_s}` is the `L_s`-dilate of the Schwartz function `𝓕⁻ χ`. -/
lemma arith_liftPhi_eq_dilateL (s : ℕ) :
    liftPhi n d Ω p s =
      dilateL (arithPhiS n)
        (liftL n d Ω p s : ℝ) := by
  funext x
  have hL := liftL_pos (n := n) (d := d) (Ω := Ω) (p := p) s
  have hL' : 0 < (liftL n d Ω p s : ℝ)⁻¹ := inv_pos.2 hL
  have hfun : (fun ξ : EuclideanSpace ℝ (Fin n) => (liftChi n d Ω p s ξ : ℂ)) =
      fun ξ => liftCutoffSchwartz n (((liftL n d Ω p s : ℝ)⁻¹)⁻¹ • ξ) := by
    funext ξ; rw [inv_inv, liftCutoffSchwartz_apply]; rfl
  rw [liftPhi, hfun, fourierInv_comp_inv_smul _ hL', arithPhiS, ← SchwartzMap.fourierInv_coe,
    dilateL, inv_pow]

/-- Uniform bounds for `φ_s` on `G`: `|φ_s(y)| ≤ C B_{L_s}(y) ≤ C`, with `∑_y |φ_s(y)| ≤ C C_n`. -/
lemma arith_liftPhi_bounds (n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ),
      (∀ y : Fin n → ℤ, ‖liftPhi n d Ω p s (latEmbed y)‖ ≤
        C * latEnvelope n (liftL n d Ω p s) y) ∧
      (∀ y : Fin n → ℤ, ‖liftPhi n d Ω p s (latEmbed y)‖ ≤ C) ∧
      ∑' y : Fin n → ℤ, ‖liftPhi n d Ω p s (latEmbed y)‖ₑ ≤
        ENNReal.ofReal (C * envelopeConst n) := by
  obtain ⟨C, hC, h⟩ := norm_liftPhi_le n
  refine ⟨C, hC, fun d Ω p s => ⟨(h d Ω p s).2, fun y => ?_, ?_⟩⟩
  · have hL1 : (1 : ℝ) ≤ liftL n d Ω p s := by
      unfold liftL; exact_mod_cast Nat.one_le_two_pow
    refine ((h d Ω p s).2 y).trans (mul_le_of_le_one_right hC ?_)
    unfold latEnvelope envelope
    have h1 : ((liftL n d Ω p s : ℝ) ^ n)⁻¹ ≤ 1 := inv_le_one_of_one_le₀ (one_le_pow₀ hL1)
    have h2 : ((1 + ‖latEmbed y‖ / (liftL n d Ω p s : ℝ)) ^ (n + 1))⁻¹ ≤ 1 :=
      inv_le_one_of_one_le₀ (one_le_pow₀ (by
        have : 0 ≤ ‖latEmbed y‖ / (liftL n d Ω p s : ℝ) := by positivity
        linarith))
    have h3 : 0 ≤ ((liftL n d Ω p s : ℝ) ^ n)⁻¹ := by positivity
    have h4 : 0 ≤ ((1 + ‖latEmbed y‖ / (liftL n d Ω p s : ℝ)) ^ (n + 1))⁻¹ := by positivity
    nlinarith
  · have hL1 : (1 : ℝ) ≤ liftL n d Ω p s := by
      unfold liftL; exact_mod_cast Nat.one_le_two_pow
    obtain ⟨hs, hsum⟩ := summable_latEnvelope_and_tsum_le (n := n) hL1
    calc ∑' y : Fin n → ℤ, ‖liftPhi n d Ω p s (latEmbed y)‖ₑ
        ≤ ∑' y : Fin n → ℤ, ENNReal.ofReal (C * latEnvelope n (liftL n d Ω p s) y) :=
          ENNReal.tsum_le_tsum fun y => by
            rw [← ofReal_norm]; exact ENNReal.ofReal_le_ofReal ((h d Ω p s).2 y)
      _ = ENNReal.ofReal (∑' y, C * latEnvelope n (liftL n d Ω p s) y) :=
          (ENNReal.ofReal_tsum_of_nonneg (fun y => mul_nonneg hC
            (envelope_nonneg (by linarith) _)) (hs.mul_left C)).symm
      _ ≤ ENNReal.ofReal (C * envelopeConst n) := by
          rw [tsum_mul_left]; exact ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_left hsum hC)

/-- Blueprint Lemma 9.1 applied to `f ∈ ℓ¹`:
`A_{s,a/q} f(x) = ∑_y e((a/q) P(x - y)) φ_s(x - y) f(y)`. -/
lemma arith_latMult_liftA_eq (s a : ℕ) {q : ℕ} (hq : 1 ≤ q) {f : (Fin n → ℤ) → ℂ}
    (hf : Summable fun z => ‖f z‖) (x : Fin n → ℤ) :
    latMult (liftA n d Ω p s a q) f x = ∑' y, eC ((a : ℝ) / q * (radialPolyZ n d (x - y) : ℝ)) *
      liftPhi n d Ω p s (latEmbed (x - y)) * f y := by
  have hint : IntegrableOn (liftA n d Ω p s a q) (torusCube n) :=
    integrableOn_liftSym (by simpa using integrable_liftChi (n := n) (d := d) (Ω := Ω) (p := p) s)
  rw [latMult_eq_latConv hint hf, latConv, ← (Equiv.subLeft x).tsum_eq]
  refine tsum_congr fun y => ?_
  simp only [Equiv.subLeft_apply, sub_sub_cancel, latKernel_liftA s a hq]

/-- A counting-measure integral of an absolutely summable function is its sum. -/
lemma arith_integral_count_eq_tsum {α : Type*} [MeasurableSpace α] [MeasurableSingletonClass α]
    [Countable α] {g : α → ℂ} (hg : Summable fun z => ‖g z‖) :
    ∫ z, g z ∂Measure.count = ∑' z, g z := by
  rw [integral_countable (integrable_count_iff.2 hg)]
  simp

/-- `y ↦ |φ_s(y)|` is summable on `G`. -/
lemma arith_summable_norm_liftPhi (s : ℕ) :
    Summable fun y : Fin n → ℤ => ‖liftPhi n d Ω p s (latEmbed y)‖ := by
  obtain ⟨C, hC, h⟩ := arith_liftPhi_bounds n
  have hL1 : (1 : ℝ) ≤ liftL n d Ω p s := by
    unfold liftL; exact_mod_cast Nat.one_le_two_pow
  exact Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (h d Ω p s).1
    ((summable_latEnvelope_and_tsum_le hL1).1.mul_left C)

/-- The kernel `κ(x, y) = e(α_x P(x - y)) φ_s(x - y)` of the linearized operator
`x ↦ A_{s, α_x} f(x)`, with `α_x = a_x / q_x` for the selection `σ(x) = (a_x, q_x)`. -/
noncomputable def arithKer (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ)
    (σ : (Fin n → ℤ) → ℕ × ℕ) (x y : Fin n → ℤ) : ℂ :=
  eC (((σ x).1 : ℝ) / (σ x).2 * (radialPolyZ n d (x - y) : ℝ)) *
    liftPhi n d Ω p s (latEmbed (x - y))

lemma norm_arithKer (s : ℕ) (σ : (Fin n → ℤ) → ℕ × ℕ) (x y : Fin n → ℤ) :
    ‖arithKer n d Ω p s σ x y‖ = ‖liftPhi n d Ω p s (latEmbed (x - y))‖ := by
  rw [arithKer, norm_mul, norm_eC, one_mul]

/-- The linearized operator is the kernel operator of `arithKer`. -/
lemma latMult_liftA_sel_eq (s : ℕ) (σ : (Fin n → ℤ) → ℕ × ℕ) (hσ : ∀ x, 1 ≤ (σ x).2)
    {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) (x : Fin n → ℤ) :
    latMult (liftA n d Ω p s (σ x).1 (σ x).2) f x =
      ∫ y, arithKer n d Ω p s σ x y * f y ∂Measure.count := by
  obtain ⟨C, hC, hb⟩ := arith_liftPhi_bounds n
  rw [arith_latMult_liftA_eq s _ (hσ x) hf, arith_integral_count_eq_tsum]
  · rfl
  · refine Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun y => ?_) (hf.mul_left C)
    rw [norm_mul, norm_arithKer]
    exact mul_le_mul_of_nonneg_right ((hb d Ω p s).2.1 _) (norm_nonneg _)

/-- The `TT*` kernel of the linearization (via Blueprint Lemma 9.1):
`H(x, x') = ∑_z e(α_x P(z) - α_{x'} P(z + h)) φ_s(z) conj φ_s(z + h)`, `h = x' - x`. -/
lemma integral_arithKer_mul_conj (s : ℕ) (σ : (Fin n → ℤ) → ℕ × ℕ) (x x' : Fin n → ℤ) :
    ∫ y, arithKer n d Ω p s σ x y * conj (arithKer n d Ω p s σ x' y) ∂Measure.count =
      ∑' z, eC (arithPhase n d (((σ x).1 : ℝ) / (σ x).2) (((σ x').1 : ℝ) / (σ x').2)
          (x' - x) z) * liftPhi n d Ω p s (latEmbed z) *
        conj (liftPhi n d Ω p s (latEmbed z + latEmbed (x' - x))) := by
  obtain ⟨C, hC, hb⟩ := arith_liftPhi_bounds n
  rw [arith_integral_count_eq_tsum]
  · rw [← (Equiv.subLeft x).tsum_eq]
    refine tsum_congr fun z => ?_
    simp only [Equiv.subLeft_apply, arithKer, sub_sub_cancel, map_mul, conj_eC]
    have e : x' - (x - z) = z + (x' - x) := by abel
    rw [e, latEmbed_add, arithPhase, sub_eq_add_neg _ (_ * _), eC_add]
    ring_nf
  · have hs := (arith_summable_norm_liftPhi (n := n) (d := d) (Ω := Ω) (p := p) s).comp_injective
      (Equiv.subLeft x).injective
    refine Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun y => ?_) (hs.mul_left C)
    rw [norm_mul, RCLike.norm_conj, norm_arithKer, norm_arithKer, mul_comm]
    exact mul_le_mul_of_nonneg_right ((hb d Ω p s).2.1 _) (norm_nonneg _)

/-- `|H(x, x')| = |H(x', x)|` for a `TT*` kernel. -/
lemma arith_enorm_integral_mul_conj_symm {α : Type*} [MeasurableSpace α] {μ : Measure α}
    (k : α → α → ℂ) (x x' : α) :
    ‖∫ z, k x z * conj (k x' z) ∂μ‖ₑ = ‖∫ z, k x' z * conj (k x z) ∂μ‖ₑ := by
  rw [← RCLike.enorm_conj, ← integral_conj]
  congr 2; funext z
  rw [map_mul, RCLike.conj_conj, mul_comm]

/-- Blueprint Lemma 9.2, eq. (`eq:arithH`), via Lemma 3.7 (`lem:periodic`): there is `C`
(depending only on `n`) such that for `α = a/q`, `β = b/r` and `Q = q r ≤ L_s`,
`|H| ≤ C (|G_Q| + Q/L_s) B_{L_s}(h)` for the `TT*` sum
`H = ∑_z e(α P(z) - β P(z + h)) φ_s(z) conj φ_s(z + h)`. -/
lemma norm_arithTT_le (n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s a q b r : ℕ),
      1 ≤ q → 1 ≤ r → ((q * r : ℕ) : ℝ) ≤ liftL n d Ω p s → ∀ h : Fin n → ℤ,
        ‖∑' z, eC (arithPhase n d ((a : ℝ) / q) ((b : ℝ) / r) h z) *
            liftPhi n d Ω p s (latEmbed z) * conj (liftPhi n d Ω p s (latEmbed z + latEmbed h))‖ ≤
          C * (‖arithG n d a q b r h‖ + ((q * r : ℕ) : ℝ) / liftL n d Ω p s) *
            latEnvelope n (liftL n d Ω p s) h := by
  obtain ⟨C, hC, hper⟩ := periodic_riemann_sum (arithPhiS n)
  refine ⟨C, hC, fun d Ω p s a q b r hq hr hQL h => ?_⟩
  have hQ : 1 ≤ q * r := Nat.mul_pos hq hr
  set L : ℝ := (liftL n d Ω p s : ℝ)
  have hL0 : 0 < L := liftL_pos s
  obtain ⟨-, h1, h2⟩ := hper L (q * r) hQ hQL
    (fun z => eC (arithPhase n d ((a : ℝ) / q) ((b : ℝ) / r) h z))
    (fun z z' hzz => eC_arithPhase_periodic d a b hq hr h hzz)
    (fun z => (norm_eC _).le) h
  rw [arith_liftPhi_eq_dilateL]
  set T := ∑' z, eC (arithPhase n d ((a : ℝ) / q) ((b : ℝ) / r) h z) *
    dilateL (arithPhiS n) L (latEmbed z) * conj (dilateL (arithPhiS n) L (latEmbed z + latEmbed h))
  set I := ∫ w, dilateL (arithPhiS n) L w * conj (dilateL (arithPhiS n) L (w + latEmbed h))
  have hG : ((((q * r : ℕ) : ℂ) ^ n)⁻¹ * ∑ u : Fin n → Fin (q * r),
      eC (arithPhase n d ((a : ℝ) / q) ((b : ℝ) / r) h fun i => ((u i : ℕ) : ℤ))) =
      arithG n d a q b r h := rfl
  rw [hG] at h1
  have hB : 0 ≤ latEnvelope n L h := envelope_nonneg hL0 _
  calc ‖T‖ ≤ ‖T - arithG n d a q b r h * I‖ + ‖arithG n d a q b r h * I‖ := by
        have := norm_le_insert' T (arithG n d a q b r h * I); linarith
    _ ≤ C * (((q * r : ℕ) : ℝ) / L) * latEnvelope n L h +
          ‖arithG n d a q b r h‖ * (C * latEnvelope n L h) := by
        rw [norm_mul]; gcongr
    _ = C * (‖arithG n d a q b r h‖ + ((q * r : ℕ) : ℝ) / L) * latEnvelope n L h := by ring

open scoped Classical in
/-- Column sums of a kernel with the bound of eq. (`eq:arithH`): if
`|F(h)| ≤ K (ε + 𝟙_E(h₁)) B_L(h)` and `E` has density `≤ δ` in intervals `[-R, R]`, `R ≥ L`, then
`∑_h |F(h)| ≤ K C_n (ε + δ)`. -/
lemma tsum_enorm_le_of_arith_bound {m : ℕ} {E : Set ℤ} {L ε δ K : ℝ} (hL : 1 ≤ L)
    (hε : 0 ≤ ε) (hδ : 0 ≤ δ) (hK : 0 ≤ K)
    (hE : ∀ R : ℕ, L ≤ R → (#{t ∈ Finset.Icc (-(R : ℤ)) R | t ∈ E} : ℝ) ≤ δ * (2 * R + 1))
    (F : (Fin (m + 1) → ℤ) → ℂ)
    (hF : ∀ h, ‖F h‖ ≤ K * (ε + if h 0 ∈ E then 1 else 0) * latEnvelope (m + 1) L h) :
    ∑' h, ‖F h‖ₑ ≤ ENNReal.ofReal (K * envelopeConst (m + 1) * (ε + δ)) := by
  have hL0 : 0 < L := by linarith
  have hCn : 0 ≤ envelopeConst (m + 1) := by unfold envelopeConst; positivity
  have hpt : ∀ h, ‖F h‖ₑ ≤ ENNReal.ofReal (K * ε) * ENNReal.ofReal (latEnvelope (m + 1) L h) +
      ENNReal.ofReal K * (ENNReal.ofReal (latEnvelope (m + 1) L h) *
        (if h 0 ∈ E then 1 else 0)) := by
    intro h
    have hB := envelope_nonneg (n := m + 1) hL0 (latEmbed h)
    rw [← ofReal_norm]
    refine (ENNReal.ofReal_le_ofReal (hF h)).trans ?_
    split_ifs with hh
    · rw [mul_one, ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul hK,
        ← ENNReal.ofReal_add (by positivity) (by positivity)]
      refine ENNReal.ofReal_le_ofReal (le_of_eq ?_)
      unfold latEnvelope; ring
    · rw [mul_zero, mul_zero, add_zero, add_zero, ← ENNReal.ofReal_mul (by positivity)]
  have hall : ∑' h, ENNReal.ofReal (latEnvelope (m + 1) L h) ≤
      ENNReal.ofReal (envelopeConst (m + 1)) := by
    obtain ⟨hs, hsum⟩ := summable_latEnvelope_and_tsum_le (n := m + 1) hL
    rw [← ENNReal.ofReal_tsum_of_nonneg (f := latEnvelope (m + 1) L)
      (fun h => envelope_nonneg hL0 _) hs]
    exact ENNReal.ofReal_le_ofReal hsum
  have hexc := arith_tsum_latEnvelope_indicator_le (m := m) hL hδ hE
  calc ∑' h, ‖F h‖ₑ
      ≤ ∑' h, (ENNReal.ofReal (K * ε) * ENNReal.ofReal (latEnvelope (m + 1) L h) +
          ENNReal.ofReal K * (ENNReal.ofReal (latEnvelope (m + 1) L h) *
            (if h 0 ∈ E then 1 else 0))) := ENNReal.tsum_le_tsum hpt
    _ = ENNReal.ofReal (K * ε) * ∑' h, ENNReal.ofReal (latEnvelope (m + 1) L h) +
          ENNReal.ofReal K * ∑' h, ENNReal.ofReal (latEnvelope (m + 1) L h) *
            (if h 0 ∈ E then 1 else 0) := by
        rw [ENNReal.tsum_add, ENNReal.tsum_mul_left, ENNReal.tsum_mul_left]
    _ ≤ ENNReal.ofReal (K * ε) * ENNReal.ofReal (envelopeConst (m + 1)) +
          ENNReal.ofReal K * ENNReal.ofReal (envelopeConst (m + 1) * δ) := by
        gcongr
    _ = ENNReal.ofReal (K * envelopeConst (m + 1) * (ε + δ)) := by
        rw [← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul hK,
          ← ENNReal.ofReal_add (by positivity) (by positivity)]
        congr 1; ring

/-- `ℓ¹(ℤⁿ) ⊆ ℓ²(ℤⁿ)`. -/
lemma arith_memLp_two_of_summable {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) :
    MemLp f 2 Measure.count := by
  rw [memLp_two_iff_integrable_sq_norm AEStronglyMeasurable.of_discrete, integrable_count_iff]
  refine Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun z => ?_)
    (hf.mul_left (∑' z, ‖f z‖))
  rw [Real.norm_of_nonneg (by positivity), sq]
  exact mul_le_mul_of_nonneg_right (hf.le_tsum z fun _ _ => norm_nonneg _) (norm_nonneg _)

lemma enorm_arithKer (s : ℕ) (σ : (Fin n → ℤ) → ℕ × ℕ) (x y : Fin n → ℤ) :
    ‖arithKer n d Ω p s σ x y‖ₑ = ‖liftPhi n d Ω p s (latEmbed (x - y))‖ₑ := by
  rw [← ofReal_norm, ← ofReal_norm, norm_arithKer]

/-- `N_s^3 ≤ L_s` (from eq. (9.2), `eq:scalerequirements`). -/
lemma arith_liftN_pow_three_le_liftL (s : ℕ) : ((liftN s : ℕ) : ℝ) ^ 3 ≤ liftL n d Ω p s := by
  have h : liftN s ^ 3 ≤ liftL n d Ω p s := by
    refine le_trans ?_ (pow_le_liftL (n := n) (d := d) (Ω := Ω) (p := p) s)
    rw [liftN, ← pow_mul]
    exact Nat.pow_le_pow_right (by norm_num) (by nlinarith)
  exact_mod_cast h

/-- Blueprint Lemma 9.2, the linearized `ℓ²` bound: for every selection `x ↦ σ(x) = (a_x, q_x)`
of `𝓡_s`, the `TT*` kernel has column (and, by symmetry, row) sums at most `K N_s^{-c₀}`, so by
Schur's test and `TT*` (Lemma 2.5), `‖x ↦ A_{s, α_x} f(x)‖₂ ≤ (K N_s^{-c₀})^{1/2} ‖f‖₂`. -/
lemma arith_linearized_bound {m d : ℕ} (hd : 1 ≤ d) :
    ∃ K c₀ : ℝ, 0 ≤ K ∧ 0 < c₀ ∧ ∀ (Ω : EuclideanSpace ℝ (Fin (m + 1)) → ℂ) (p : ℝ) (s : ℕ),
      1 ≤ s → ∀ σ : (Fin (m + 1) → ℤ) → ℕ × ℕ, (∀ x, σ x ∈ liftRat s) →
      ∀ f : (Fin (m + 1) → ℤ) → ℂ, Summable (fun z => ‖f z‖) →
        eLpNorm (fun x => latMult (liftA (m + 1) d Ω p s (σ x).1 (σ x).2) f x) 2
            Measure.count ≤
          ENNReal.ofReal (K * ((liftN s : ℕ) : ℝ) ^ (-c₀)) ^ (1 / 2 : ℝ) *
            eLpNorm f 2 Measure.count := by
  obtain ⟨Cφ, hCφ, hφ⟩ := arith_liftPhi_bounds (m + 1)
  obtain ⟨Cp, hCp, hTT⟩ := norm_arithTT_le (m + 1)
  obtain ⟨C, c, C', hC, hc, hC', hG⟩ := exists_arithG_bound (m := m) hd
  set Cn := envelopeConst (m + 1) with hCn_def
  have hCn : 0 ≤ Cn := by unfold Cn envelopeConst; positivity
  set c₀ := min c (3 / 8) with hc₀_def
  have hc₀ : 0 < c₀ := lt_min hc (by norm_num)
  refine ⟨Cp * Cn * (C + 1 + C'), c₀, by positivity, hc₀, fun Ω p s hs σ hσ f hf => ?_⟩
  set N : ℕ := liftN s
  set L : ℝ := (liftL (m + 1) d Ω p s : ℝ)
  have hN2 : 2 ≤ N := two_le_liftN hs
  have hN1 : (1 : ℝ) ≤ N := by exact_mod_cast (by omega : 1 ≤ N)
  have hN0 : (0 : ℝ) < N := by linarith
  have hNL3 : (N : ℝ) ^ 3 ≤ L := arith_liftN_pow_three_le_liftL s
  have hNL : (N : ℝ) ≤ L := le_trans (le_self_pow₀ hN1 (by norm_num)) hNL3
  have hL1 : 1 ≤ L := hN1.trans hNL
  have hL0 : 0 < L := by linarith
  have hmem : ∀ x, N ≤ 2 * (σ x).2 ∧ (σ x).2 < N ∧ (σ x).1 < (σ x).2 ∧
      Nat.Coprime (σ x).1 (σ x).2 := fun x => mem_liftRat.1 (hσ x)
  have hq1 : ∀ x, 1 ≤ (σ x).2 := fun x => by have := (hmem x).2.2.1; omega
  set κ := arithKer (m + 1) d Ω p s σ
  rw [show (fun x => latMult (liftA (m + 1) d Ω p s (σ x).1 (σ x).2) f x) =
    fun x => ∫ y, κ x y * f y ∂Measure.count from
      funext fun x => latMult_liftA_sel_eq s σ hq1 hf x]
  set ε : ℝ := C * (N : ℝ) ^ (-c) + (N : ℝ) ^ 2 / L
  set δ : ℝ := C' * (N : ℝ) ^ (-(3 / 8 : ℝ))
  have hε : 0 ≤ ε := by positivity
  have hδ : 0 ≤ δ := by positivity
  -- column sums of the `TT*` kernel
  have hcolH : ∀ x', ∑' x, ‖∫ y, κ x y * conj (κ x' y) ∂Measure.count‖ₑ ≤
      ENNReal.ofReal (Cp * Cn * (ε + δ)) := by
    intro x'
    obtain ⟨hbN, hrN, -, hbr⟩ := hmem x'
    obtain ⟨E, hEd, hEb⟩ := hG N (σ x').1 (σ x').2 (by omega) hbN hrN.le hbr
    rw [← (Equiv.subLeft x').tsum_eq]
    refine tsum_enorm_le_of_arith_bound (m := m) (E := E) hL1 hε hδ hCp (fun R hR => ?_)
      (fun h => ∫ y, κ (x' - h) y * conj (κ x' y) ∂Measure.count) (fun h => ?_)
    · have : N ≤ R := by exact_mod_cast hNL.trans hR
      exact hEd R this
    · rw [integral_arithKer_mul_conj, sub_sub_cancel]
      obtain ⟨haN, hqN, -, -⟩ := hmem (x' - h)
      have hQN : (((σ (x' - h)).2 * (σ x').2 : ℕ) : ℝ) ≤ (N : ℝ) ^ 2 := by
        have : (σ (x' - h)).2 * (σ x').2 ≤ N ^ 2 := by
          rw [sq]; exact Nat.mul_le_mul hqN.le hrN.le
        exact_mod_cast this
      have hQL : (((σ (x' - h)).2 * (σ x').2 : ℕ) : ℝ) ≤ L := hQN.trans
        (le_trans (pow_le_pow_right₀ hN1 (by norm_num)) hNL3)
      refine (hTT d Ω p s _ _ _ _ (hq1 _) (hq1 x') hQL h).trans ?_
      have hB : 0 ≤ latEnvelope (m + 1) L h := envelope_nonneg hL0 _
      have hGb := hEb (σ (x' - h)).1 (σ (x' - h)).2 h (hq1 _)
      have hQ' : (((σ (x' - h)).2 * (σ x').2 : ℕ) : ℝ) / L ≤ (N : ℝ) ^ 2 / L :=
        div_le_div_of_nonneg_right hQN hL0.le
      refine mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left ?_ hCp) hB
      simp only [ε]
      linarith
  -- row sums, by symmetry
  have hrowH : ∀ x, ∑' x', ‖∫ y, κ x y * conj (κ x' y) ∂Measure.count‖ₑ ≤
      ENNReal.ofReal (Cp * Cn * (ε + δ)) := by
    intro x
    simp_rw [arith_enorm_integral_mul_conj_symm κ x]
    exact hcolH x
  have hκm : StronglyMeasurable (Function.uncurry κ) := (Measurable.of_discrete).stronglyMeasurable
  have hsumφ := (hφ d Ω p s).2.2
  have hrow : ∀ x, ∫⁻ y, ‖κ x y‖ₑ ∂Measure.count ≤ ENNReal.ofReal (Cφ * Cn) := by
    intro x
    rw [lintegral_count]
    simp_rw [κ, enorm_arithKer]
    exact ((Equiv.subLeft x).tsum_eq (fun w => ‖liftPhi (m + 1) d Ω p s (latEmbed w)‖ₑ)).trans_le
      hsumφ
  have hcol : ∀ y, ∫⁻ x, ‖κ x y‖ₑ ∂Measure.count ≤ ENNReal.ofReal (Cφ * Cn) := by
    intro y
    rw [lintegral_count]
    simp_rw [κ, enorm_arithKer]
    exact ((Equiv.subRight y).tsum_eq (fun w => ‖liftPhi (m + 1) d Ω p s (latEmbed w)‖ₑ)).trans_le
      hsumφ
  have hM : ∀ x y, ‖κ x y‖ ≤ Cφ := fun x y => by
    simp only [κ]; rw [norm_arithKer]; exact (hφ d Ω p s).2.1 _
  refine (band_eLpNorm_kernel_le_of_ttstar (A := ENNReal.ofReal (Cp * Cn * (ε + δ)))
    hκm ENNReal.ofReal_ne_top hrow hcol hM ?_
    (arith_memLp_two_of_summable hf)).trans ?_
  · intro v _
    rw [lintegral_count, minor_eLpNorm_two_sq]
    simp_rw [lintegral_count]
    exact minor_bilinear_schur _ _ hrowH hcolH
  · refine mul_le_mul_of_nonneg_right (ENNReal.rpow_le_rpow (ENNReal.ofReal_le_ofReal ?_)
      (by norm_num)) zero_le
    -- `ε + δ ≤ (C + 1 + C') N^{-c₀}`
    have h1 : (N : ℝ) ^ (-c) ≤ (N : ℝ) ^ (-c₀) :=
      Real.rpow_le_rpow_of_exponent_le hN1 (by simp only [c₀]; linarith [min_le_left c (3 / 8)])
    have h2 : (N : ℝ) ^ (-(3 / 8 : ℝ)) ≤ (N : ℝ) ^ (-c₀) :=
      Real.rpow_le_rpow_of_exponent_le hN1 (by simp only [c₀]; linarith [min_le_right c (3 / 8)])
    have h3 : (N : ℝ) ^ 2 / L ≤ (N : ℝ) ^ (-c₀) := by
      have e1 : (N : ℝ) ^ 2 / L ≤ (N : ℝ) ^ 2 / (N : ℝ) ^ 3 :=
        div_le_div_of_nonneg_left (by positivity) (by positivity) hNL3
      have e2 : (N : ℝ) ^ 2 / (N : ℝ) ^ 3 = (N : ℝ) ^ (-1 : ℝ) := by
        rw [Real.rpow_neg_one]; field_simp
      have e3 : (N : ℝ) ^ (-1 : ℝ) ≤ (N : ℝ) ^ (-c₀) :=
        Real.rpow_le_rpow_of_exponent_le hN1 (by
          have : c₀ ≤ 3 / 8 := min_le_right _ _
          linarith)
      linarith
    have hCpn : 0 ≤ Cp * Cn := by positivity
    calc Cp * Cn * (ε + δ) ≤ Cp * Cn * ((C + 1 + C') * (N : ℝ) ^ (-c₀)) := by
          refine mul_le_mul_of_nonneg_left ?_ hCpn
          simp only [ε, δ]
          nlinarith [mul_le_mul_of_nonneg_left h1 hC, mul_le_mul_of_nonneg_left h2 hC']
      _ = Cp * Cn * (C + 1 + C') * (N : ℝ) ^ (-c₀) := by ring

/-- `(K N_s^{-c₀})^{1/2} = √K 2^{-(c₀/2) s}`. -/
lemma arith_ofReal_mul_liftN_rpow_half {K c₀ : ℝ} (hK : 0 ≤ K) (s : ℕ) :
    ENNReal.ofReal (K * ((liftN s : ℕ) : ℝ) ^ (-c₀)) ^ (1 / 2 : ℝ) =
      ENNReal.ofReal (Real.sqrt K * (2 : ℝ) ^ (-(c₀ / 2 * s))) := by
  have h2 : ((liftN s : ℕ) : ℝ) ^ (-c₀) = (2 : ℝ) ^ (-(c₀ * s)) := by
    rw [liftN, Nat.cast_pow, Nat.cast_ofNat, ← Real.rpow_natCast, ← Real.rpow_mul (by norm_num)]
    congr 1; ring
  rw [ENNReal.ofReal_rpow_of_nonneg (by positivity) (by norm_num), h2,
    Real.mul_rpow hK (by positivity), ← Real.rpow_mul (by norm_num), Real.sqrt_eq_rpow]
  congr 2; ring_nf

/-- **Blueprint Lemma 9.2 (`lem:arithmax`), eq. (9.5) (`eq:arith2`)**, arithmetic maximal decay
in `ℓ²`: for `n ≥ 1` and `d ≥ 1` (`D = 2d`) there is `γ > 0` (depending only on `n, d`) and a
constant `C` (independent of the parameters `Ω, p` of the §9 setup) such that for every `s ≥ 1`
and every `f ∈ ℓ¹(ℤⁿ)` (in particular every finitely supported `f`),
`‖sup_{α ∈ 𝓡_s} |A_{s,α} f|‖_{ℓ²} ≤ C 2^{-γ s} ‖f‖_{ℓ²}`,
the supremum being over the finite set `𝓡_s = liftRat s` of reduced `α = a/q`,
`N_s/2 ≤ q < N_s`, and `A_{s,a/q} = liftA n d Ω p s a q`. -/
theorem arith_maximal_decay (n d : ℕ) (hn : 1 ≤ n) (hd : 1 ≤ d) :
    ∃ γ : ℝ, 0 < γ ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ),
      1 ≤ s → ∀ f : (Fin n → ℤ) → ℂ, Summable (fun z => ‖f z‖) →
        eLpNorm (fun x => (liftRat s).sup fun aq =>
            ‖latMult (liftA n d Ω p s aq.1 aq.2) f x‖ₑ) 2 Measure.count ≤
          ENNReal.ofReal (C * (2 : ℝ) ^ (-(γ * s))) * eLpNorm f 2 Measure.count := by
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  obtain ⟨K, c₀, hK, hc₀, hlin⟩ := arith_linearized_bound (m := m) hd
  refine ⟨c₀ / 2, by positivity, Real.sqrt K, Real.sqrt_nonneg _, fun Ω p s hs f hf => ?_⟩
  refine eLpNorm_finset_sup_le_of_linearization_op
    (fun (aq : ℕ × ℕ) f x => latMult (liftA (m + 1) d Ω p s aq.1 aq.2) f x) f (liftRat s)
    (fun _ _ => AEStronglyMeasurable.of_discrete) _ fun σ hσ _ => ?_
  refine (hlin Ω p s hs σ hσ f hf).trans (le_of_eq ?_)
  rw [arith_ofReal_mul_liftN_rpow_half hK]

/-! #### The vector-valued estimate (9.6) -/

/-- The maximal function `sup_{α ∈ 𝓡_s} |A_{s,α} u(x)|` (real-valued). -/
noncomputable def arithSup (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ)
    (u : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) : ℝ :=
  (((liftRat s).sup fun aq => ‖latMult (liftA n d Ω p s aq.1 aq.2) u x‖₊ : ℝ≥0) : ℝ)

lemma arithSup_nonneg (s : ℕ) (u : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) :
    0 ≤ arithSup n d Ω p s u x := NNReal.coe_nonneg _

lemma enorm_arithSup (s : ℕ) (u : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) :
    ‖arithSup n d Ω p s u x‖ₑ =
      (liftRat s).sup fun aq => ‖latMult (liftA n d Ω p s aq.1 aq.2) u x‖ₑ := by
  rw [arithSup, Real.enorm_eq_ofReal (NNReal.coe_nonneg _), ENNReal.ofReal_coe_nnreal,
    ENNReal.coe_finset_sup]
  rfl

/-- A bound for a finite supremum of norms. -/
lemma arith_coe_finset_sup_nnnorm_le {α : Type*} {s : Finset α} {g : α → ℂ} {R : ℝ} (hR : 0 ≤ R)
    (h : ∀ a ∈ s, ‖g a‖ ≤ R) : ((s.sup fun a => ‖g a‖₊ : ℝ≥0) : ℝ) ≤ R := by
  have : s.sup (fun a => ‖g a‖₊) ≤ R.toNNReal := Finset.sup_le fun a ha => by
    rw [← NNReal.coe_le_coe, Real.coe_toNNReal _ hR]; exact h a ha
  exact (NNReal.coe_le_coe.2 this).trans_eq (Real.coe_toNNReal _ hR)

lemma norm_le_arithSup {s : ℕ} {aq : ℕ × ℕ} (haq : aq ∈ liftRat s) (u : (Fin n → ℤ) → ℂ)
    (x : Fin n → ℤ) : ‖latMult (liftA n d Ω p s aq.1 aq.2) u x‖ ≤ arithSup n d Ω p s u x := by
  have := Finset.le_sup (f := fun aq : ℕ × ℕ => ‖latMult (liftA n d Ω p s aq.1 aq.2) u x‖₊) haq
  exact_mod_cast this

/-- Subadditivity of the maximal function on `ℓ¹`. -/
lemma arithSup_add_le (s : ℕ) {u v : (Fin n → ℤ) → ℂ} (hu : Summable fun z => ‖u z‖)
    (hv : Summable fun z => ‖v z‖) (x : Fin n → ℤ) :
    arithSup n d Ω p s (u + v) x ≤ arithSup n d Ω p s u x + arithSup n d Ω p s v x := by
  refine arith_coe_finset_sup_nnnorm_le (add_nonneg (arithSup_nonneg s u x) (arithSup_nonneg s v x))
    fun aq haq => ?_
  have hint : IntegrableOn (liftA n d Ω p s aq.1 aq.2) (torusCube n) :=
    integrableOn_liftSym (by simpa using integrable_liftChi (n := n) (d := d) (Ω := Ω) (p := p) s)
  rw [latMult_add hint hu hv, Pi.add_apply]
  exact (norm_add_le _ _).trans (add_le_add (norm_le_arithSup haq u x) (norm_le_arithSup haq v x))

/-- Pointwise domination (Blueprint Lemma 9.1): `sup_α |A_{s,α} u(x)| ≤ ∑_w |φ_s(w)| |u(x - w)|`. -/
lemma arithSup_le_conv (s : ℕ) {u : (Fin n → ℤ) → ℂ} (hu : Summable fun z => ‖u z‖)
    (x : Fin n → ℤ) :
    arithSup n d Ω p s u x ≤ ∑' w, ‖liftPhi n d Ω p s (latEmbed w)‖ * ‖u (x - w)‖ := by
  obtain ⟨C, hC, hb⟩ := arith_liftPhi_bounds n
  have hs : Summable fun w => ‖liftPhi n d Ω p s (latEmbed w)‖ * ‖u (x - w)‖ := by
    refine Summable.of_nonneg_of_le (fun _ => by positivity) (fun w => ?_)
      ((hu.comp_injective (Equiv.subLeft x).injective).mul_left C)
    exact mul_le_mul_of_nonneg_right ((hb d Ω p s).2.1 w) (norm_nonneg _)
  refine arith_coe_finset_sup_nnnorm_le (tsum_nonneg fun _ => by positivity) fun aq haq => ?_
  have hq : 1 ≤ aq.2 := one_le_of_mem_liftRat (a := aq.1) (by simpa using haq)
  rw [arith_latMult_liftA_eq s aq.1 hq hu x]
  have hs' : Summable fun y => ‖eC ((aq.1 : ℝ) / aq.2 * (radialPolyZ n d (x - y) : ℝ)) *
      liftPhi n d Ω p s (latEmbed (x - y)) * u y‖ := by
    have := hs.comp_injective (Equiv.subLeft x).injective
    refine this.congr fun y => ?_
    simp [norm_eC]
  refine (norm_tsum_le_tsum_norm hs').trans (le_of_eq ?_)
  rw [← (Equiv.subLeft x).tsum_eq]
  refine tsum_congr fun w => ?_
  simp [norm_eC]

/-- `(∑_ν sup_{α ∈ 𝓡_s} |A_{s,α} g_ν(x)|²)^{1/2}` for an `ℓ²`-valued input `g = (g_ν)_ν`. -/
noncomputable def arithVec {ι : Type*} [Fintype ι] (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ)
    (p : ℝ) (s : ℕ) (g : (Fin n → ℤ) → EuclideanSpace ℂ ι) (x : Fin n → ℤ) : ℝ :=
  Real.sqrt (∑ ν, arithSup n d Ω p s (fun y => g y ν) x ^ 2)

section Vector

variable {ι : Type*} [Fintype ι]

lemma arith_norm_toLp_le_of_le {u v : ι → ℝ} (h0 : ∀ i, 0 ≤ u i) (h : ∀ i, u i ≤ v i) :
    ‖(WithLp.toLp 2 u : EuclideanSpace ℝ ι)‖ ≤ ‖(WithLp.toLp 2 v : EuclideanSpace ℝ ι)‖ := by
  rw [EuclideanSpace.norm_eq, EuclideanSpace.norm_eq]
  refine Real.sqrt_le_sqrt (Finset.sum_le_sum fun i _ => ?_)
  simp only [Real.norm_eq_abs, sq_abs]
  exact pow_le_pow_left₀ (h0 i) (h i) 2

lemma arithVec_eq_norm (s : ℕ) (g : (Fin n → ℤ) → EuclideanSpace ℂ ι) (x : Fin n → ℤ) :
    arithVec n d Ω p s g x =
      ‖(WithLp.toLp 2 fun ν => arithSup n d Ω p s (fun y => g y ν) x : EuclideanSpace ℝ ι)‖ := by
  rw [EuclideanSpace.norm_eq, arithVec]
  simp only [Real.norm_eq_abs, sq_abs]

lemma arithVec_nonneg (s : ℕ) (g : (Fin n → ℤ) → EuclideanSpace ℂ ι) (x : Fin n → ℤ) :
    0 ≤ arithVec n d Ω p s g x := Real.sqrt_nonneg _

lemma arith_summable_coord {g : (Fin n → ℤ) → EuclideanSpace ℂ ι} (hg : Summable fun x => ‖g x‖)
    (ν : ι) : Summable fun x => ‖g x ν‖ :=
  Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun x => PiLp.norm_apply_le (g x) ν) hg

lemma arithVec_add_le (s : ℕ) {g h : (Fin n → ℤ) → EuclideanSpace ℂ ι}
    (hg : Summable fun x => ‖g x‖) (hh : Summable fun x => ‖h x‖) (x : Fin n → ℤ) :
    arithVec n d Ω p s (g + h) x ≤ arithVec n d Ω p s g x + arithVec n d Ω p s h x := by
  rw [arithVec_eq_norm, arithVec_eq_norm, arithVec_eq_norm]
  have e : ∀ ν, (fun y => (g + h) y ν) = (fun y => g y ν) + (fun y => h y ν) := fun ν => by
    funext y; simp
  refine (arith_norm_toLp_le_of_le (fun ν => arithSup_nonneg _ _ _) (fun ν => ?_)).trans
    ((le_of_eq (congrArg norm (WithLp.toLp_add 2 _ _))).trans (norm_add_le _ _))
  rw [e ν]
  exact arithSup_add_le s (arith_summable_coord hg ν) (arith_summable_coord hh ν) x

/-- Minkowski and Blueprint Lemma 9.1: `(∑_ν sup_α |A_{s,α} g_ν(x)|²)^{1/2} ≤ (|φ_s| * |g|)(x)`. -/
lemma arithVec_le_conv (s : ℕ) {g : (Fin n → ℤ) → EuclideanSpace ℂ ι}
    (hg : Summable fun x => ‖g x‖) (x : Fin n → ℤ) :
    arithVec n d Ω p s g x ≤ ∑' w, ‖liftPhi n d Ω p s (latEmbed w)‖ * ‖g (x - w)‖ := by
  obtain ⟨C, hC, hb⟩ := arith_liftPhi_bounds n
  set a : (Fin n → ℤ) → ℝ := fun w => ‖liftPhi n d Ω p s (latEmbed w)‖
  set V : (Fin n → ℤ) → EuclideanSpace ℝ ι := fun w =>
    a w • (WithLp.toLp 2 fun ν => ‖g (x - w) ν‖ : EuclideanSpace ℝ ι)
  have hnormV : ∀ w, ‖V w‖ = a w * ‖g (x - w)‖ := by
    intro w
    simp only [V, norm_smul, Real.norm_of_nonneg (norm_nonneg _), a]
    congr 1
    rw [EuclideanSpace.norm_eq, EuclideanSpace.norm_eq]
    simp only [norm_norm]
  have hsV : Summable fun w => ‖V w‖ := by
    simp_rw [hnormV]
    refine Summable.of_nonneg_of_le (fun _ => by positivity) (fun w => ?_)
      ((hg.comp_injective (Equiv.subLeft x).injective).mul_left C)
    exact mul_le_mul_of_nonneg_right ((hb d Ω p s).2.1 w) (norm_nonneg _)
  have hV : Summable V := hsV.of_norm
  set W := ∑' w, V w
  have hcoord : ∀ ν, W ν = ∑' w, a w * ‖g (x - w) ν‖ := by
    intro ν
    have := (EuclideanSpace.proj ν : EuclideanSpace ℝ ι →L[ℝ] ℝ).map_tsum hV
    simpa [V, W] using this
  rw [arithVec_eq_norm]
  calc ‖(WithLp.toLp 2 fun ν => arithSup n d Ω p s (fun y => g y ν) x : EuclideanSpace ℝ ι)‖
      ≤ ‖(WithLp.toLp 2 (WithLp.ofLp W) : EuclideanSpace ℝ ι)‖ := by
        refine arith_norm_toLp_le_of_le (fun ν => arithSup_nonneg _ _ _) fun ν => ?_
        refine (arithSup_le_conv s (arith_summable_coord hg ν) x).trans (le_of_eq ?_)
        rw [← hcoord ν]
    _ = ‖W‖ := by rw [WithLp.toLp_ofLp]
    _ ≤ ∑' w, ‖V w‖ := norm_tsum_le_tsum_norm hsV
    _ = ∑' w, ‖liftPhi n d Ω p s (latEmbed w)‖ * ‖g (x - w)‖ := tsum_congr hnormV

/-- `∑_w |φ_s(w)| ≤ C C_n` (real form). -/
lemma arith_tsum_norm_liftPhi_le (n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ),
      ∑' w : Fin n → ℤ, ‖liftPhi n d Ω p s (latEmbed w)‖ ≤ C * envelopeConst n := by
  obtain ⟨C, hC, hb⟩ := arith_liftPhi_bounds n
  refine ⟨C, hC, fun d Ω p s => ?_⟩
  have hL1 : (1 : ℝ) ≤ liftL n d Ω p s := by
    unfold liftL; exact_mod_cast Nat.one_le_two_pow
  obtain ⟨hs, hsum⟩ := summable_latEnvelope_and_tsum_le (n := n) hL1
  calc ∑' w : Fin n → ℤ, ‖liftPhi n d Ω p s (latEmbed w)‖
      ≤ ∑' w, C * latEnvelope n (liftL n d Ω p s) w :=
        (arith_summable_norm_liftPhi s).tsum_le_tsum (hb d Ω p s).1 (hs.mul_left C)
    _ ≤ C * envelopeConst n := by rw [tsum_mul_left]; exact mul_le_mul_of_nonneg_left hsum hC

/-- The endpoint bounds (`ℓ^r`, `1 ≤ r ≤ ∞`, by Young's inequality): for `g ∈ ℓ¹(ℤⁿ; ℓ²)`,
`‖(∑_ν sup_α |A_{s,α} g_ν|²)^{1/2}‖_r ≤ C ‖g‖_r`, `C` independent of `s`. -/
lemma eLpNorm_arithVec_le_young (n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ) {r : ℝ≥0∞},
      1 ≤ r → ∀ {ι : Type*} [Fintype ι] (g : (Fin n → ℤ) → EuclideanSpace ℂ ι),
      Summable (fun x => ‖g x‖) →
        eLpNorm (arithVec n d Ω p s g) r Measure.count ≤
          ENNReal.ofReal C * eLpNorm g r Measure.count := by
  obtain ⟨C, hC, hb⟩ := arith_liftPhi_bounds n
  refine ⟨C * envelopeConst n, by unfold envelopeConst; positivity,
    fun d Ω p s r hr ι _ g hg => ?_⟩
  set G : (Fin n → ℤ) → ℂ := fun x => ((‖g x‖ : ℝ) : ℂ)
  set k : (Fin n → ℤ) → ℂ := fun w => liftPhi n d Ω p s (latEmbed w)
  have hGe : ∀ y, ‖G y‖ₑ = ‖g y‖ₑ := fun y => by
    rw [← ofReal_norm, ← ofReal_norm]; simp [G]
  have hpt : ∀ x, ‖arithVec n d Ω p s g x‖ₑ ≤ ‖∑' w, ‖k w‖ₑ * ‖G (x - w)‖ₑ‖ₑ := by
    intro x
    rw [enorm_eq_self, Real.enorm_eq_ofReal (arithVec_nonneg s g x)]
    have hs : Summable fun w => ‖liftPhi n d Ω p s (latEmbed w)‖ * ‖g (x - w)‖ := by
      refine Summable.of_nonneg_of_le (fun _ => by positivity) (fun w => ?_)
        ((hg.comp_injective (Equiv.subLeft x).injective).mul_left C)
      exact mul_le_mul_of_nonneg_right ((hb d Ω p s).2.1 w) (norm_nonneg _)
    refine (ENNReal.ofReal_le_ofReal (arithVec_le_conv s hg x)).trans (le_of_eq ?_)
    rw [ENNReal.ofReal_tsum_of_nonneg (fun _ => by positivity) hs]
    refine tsum_congr fun w => ?_
    rw [ENNReal.ofReal_mul (norm_nonneg _), ofReal_norm, ofReal_norm]
    rw [hGe]
  refine (eLpNorm_mono_enorm AEStronglyMeasurable.of_discrete hpt).trans
    ((eLpNorm_tsum_enorm_mul_sub_le hr k G).trans ?_)
  have hk : eLpNorm k 1 Measure.count ≤ ENNReal.ofReal (C * envelopeConst n) := by
    rw [eLpNorm_one_eq_lintegral_enorm AEStronglyMeasurable.of_discrete, lintegral_count]
    exact (hb d Ω p s).2.2
  have hG : eLpNorm G r Measure.count = eLpNorm g r Measure.count :=
    eLpNorm_congr_enorm_ae AEStronglyMeasurable.of_discrete AEStronglyMeasurable.of_discrete
      (ae_of_all _ hGe)
  rw [hG]
  gcongr

/-- The `ℓ^∞` endpoint: `|g| ≤ S` implies `(∑_ν sup_α |A_{s,α} g_ν|²)^{1/2} ≤ C S`. -/
lemma arithVec_le_of_norm_le (n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ)
      {ι : Type*} [Fintype ι] (g : (Fin n → ℤ) → EuclideanSpace ℂ ι),
      Summable (fun x => ‖g x‖) → ∀ S : ℝ, (∀ x, ‖g x‖ ≤ S) → ∀ x,
        arithVec n d Ω p s g x ≤ C * S := by
  obtain ⟨C, hC, hb⟩ := arith_liftPhi_bounds n
  obtain ⟨C₁, hC₁, hsum⟩ := arith_tsum_norm_liftPhi_le n
  refine ⟨C₁ * envelopeConst n, by unfold envelopeConst; positivity,
    fun d Ω p s ι _ g hg S hS x => ?_⟩
  have hS0 : 0 ≤ S := (norm_nonneg _).trans (hS 0)
  have hs1 : Summable fun w => ‖liftPhi n d Ω p s (latEmbed w)‖ * ‖g (x - w)‖ := by
    refine Summable.of_nonneg_of_le (fun _ => by positivity) (fun w => ?_)
      ((hg.comp_injective (Equiv.subLeft x).injective).mul_left C)
    exact mul_le_mul_of_nonneg_right ((hb d Ω p s).2.1 w) (norm_nonneg _)
  refine (arithVec_le_conv s hg x).trans ?_
  calc ∑' w, ‖liftPhi n d Ω p s (latEmbed w)‖ * ‖g (x - w)‖
      ≤ ∑' w, ‖liftPhi n d Ω p s (latEmbed w)‖ * S :=
        hs1.tsum_le_tsum (fun w => mul_le_mul_of_nonneg_left (hS _) (norm_nonneg _))
          ((arith_summable_norm_liftPhi s).mul_right S)
    _ = (∑' w, ‖liftPhi n d Ω p s (latEmbed w)‖) * S := tsum_mul_right
    _ ≤ C₁ * envelopeConst n * S := mul_le_mul_of_nonneg_right (hsum d Ω p s) hS0

/-- `‖v‖₂² = ∑_x |v x|²` for counting measure (any normed codomain). -/
lemma arith_eLpNorm_two_sq_eq_tsum {α E : Type*} [MeasurableSpace α] [MeasurableSingletonClass α]
    [Countable α] [NormedAddCommGroup E] (v : α → E) :
    eLpNorm v 2 Measure.count ^ 2 = ∑' x, ‖v x‖ₑ ^ 2 := by
  have := eLpNorm_two_rpow_two (ν := Measure.count) (AEStronglyMeasurable.of_discrete (f := v))
  rw [lintegral_count] at this
  rw [← ENNReal.rpow_natCast, Nat.cast_ofNat, this]
  simp_rw [← ENNReal.rpow_natCast, Nat.cast_ofNat]

lemma arith_enorm_sq_euclidean {𝕜 : Type*} [RCLike 𝕜] (u : EuclideanSpace 𝕜 ι) :
    ‖u‖ₑ ^ 2 = ∑ ν, ‖u ν‖ₑ ^ 2 := by
  rw [← ofReal_norm, EuclideanSpace.norm_eq, ← ENNReal.ofReal_pow (Real.sqrt_nonneg _),
    Real.sq_sqrt (Finset.sum_nonneg fun _ _ => by positivity),
    ENNReal.ofReal_sum_of_nonneg fun _ _ => by positivity]
  refine Finset.sum_congr rfl fun ν _ => ?_
  rw [ENNReal.ofReal_pow (norm_nonneg _), ofReal_norm]

lemma enorm_arithVec_sq (s : ℕ) (g : (Fin n → ℤ) → EuclideanSpace ℂ ι) (x : Fin n → ℤ) :
    ‖arithVec n d Ω p s g x‖ₑ ^ 2 = ∑ ν, ‖arithSup n d Ω p s (fun y => g y ν) x‖ₑ ^ 2 := by
  rw [Real.enorm_eq_ofReal (arithVec_nonneg s g x), arithVec_eq_norm, ofReal_norm,
    arith_enorm_sq_euclidean]

/-- The `ℓ²` case of eq. (9.6): the square function of the maximal functions is bounded on
`ℓ²(ℤⁿ; ℓ²)` with the constant of the scalar bound (9.5) (square and sum over `ν`). -/
lemma eLpNorm_arithVec_two_le {B : ℝ} (s : ℕ)
    (h2 : ∀ u : (Fin n → ℤ) → ℂ, Summable (fun z => ‖u z‖) →
      eLpNorm (fun x => (liftRat s).sup fun aq =>
        ‖latMult (liftA n d Ω p s aq.1 aq.2) u x‖ₑ) 2 Measure.count ≤
          ENNReal.ofReal B * eLpNorm u 2 Measure.count)
    (g : (Fin n → ℤ) → EuclideanSpace ℂ ι) (hg : Summable fun x => ‖g x‖) :
    eLpNorm (arithVec n d Ω p s g) 2 Measure.count ≤
      ENNReal.ofReal B * eLpNorm g 2 Measure.count := by
  have key : eLpNorm (arithVec n d Ω p s g) 2 Measure.count ^ 2 ≤
      1 * (ENNReal.ofReal B * eLpNorm g 2 Measure.count) ^ 2 := by
    rw [one_mul, arith_eLpNorm_two_sq_eq_tsum, mul_pow, arith_eLpNorm_two_sq_eq_tsum]
    simp_rw [enorm_arithVec_sq, arith_enorm_sq_euclidean]
    rw [Summable.tsum_finsetSum (fun _ _ => ENNReal.summable),
      Summable.tsum_finsetSum (fun _ _ => ENNReal.summable), Finset.mul_sum]
    refine Finset.sum_le_sum fun ν _ => ?_
    have h := h2 (fun y => g y ν) (arith_summable_coord hg ν)
    have e1 : eLpNorm (arithSup n d Ω p s (fun y => g y ν)) 2 Measure.count =
        eLpNorm (fun x => (liftRat s).sup fun aq =>
          ‖latMult (liftA n d Ω p s aq.1 aq.2) (fun y => g y ν) x‖ₑ) 2 Measure.count := by
      rw [← eLpNorm_enorm _ AEStronglyMeasurable.of_discrete]
      simp_rw [enorm_arithSup]
    rw [← arith_eLpNorm_two_sq_eq_tsum (arithSup n d Ω p s (fun y => g y ν)),
      ← arith_eLpNorm_two_sq_eq_tsum (fun y => g y ν), e1, ← mul_pow]
    gcongr
  have := band_le_of_sq_le key
  rwa [ENNReal.one_rpow, one_mul] at this

end Vector

/-- The inputs `g ∈ ℓ¹(ℤⁿ; ℓ²)` form a truncation-closed class. -/
lemma arith_isTruncationClosed_summable {ι : Type*} [Fintype ι] :
    IsTruncationClosed {g : (Fin n → ℤ) → EuclideanSpace ℂ ι | Summable fun x => ‖g x‖} := by
  intro g hg s _
  have hg' : Summable fun x => ‖g x‖ := hg
  refine ⟨?_, ?_⟩
  · exact Summable.of_nonneg_of_le (fun _ => norm_nonneg _)
      (fun x => norm_indicator_le_norm_self _ _) hg'
  · exact Summable.of_nonneg_of_le (fun _ => norm_nonneg _)
      (fun x => norm_indicator_le_norm_self _ _) hg'

/-- Marcinkiewicz interpolation (Blueprint Lemma 2.3) of the uniform `ℓ¹` and `ℓ^∞` endpoint
bounds of `g ↦ (∑_ν sup_α |A_{s,α} g_ν|²)^{1/2}` with an `ℓ²` bound `B` (for `ℓ²`-valued inputs):
for `1 < t < ∞`, `‖·‖_t ≤ K B^{a_t} ‖g‖_t`, `a_t = min(2/t, 2/t')`, with `K` independent of `s`,
`B`, the index set and `g`. -/
theorem arithVec_lp_of_l2 (n : ℕ) {t : ℝ} (ht : 1 < t) :
    ∃ K : ℝ≥0∞, K ≠ ⊤ ∧ ∀ (d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ)
      {ι : Type*} [Fintype ι] (B : ℝ≥0),
      (∀ u : (Fin n → ℤ) → ℂ, Summable (fun z => ‖u z‖) →
        eLpNorm (fun x => (liftRat s).sup fun aq =>
          ‖latMult (liftA n d Ω p s aq.1 aq.2) u x‖ₑ) 2 Measure.count ≤
            ENNReal.ofReal B * eLpNorm u 2 Measure.count) →
      ∀ g : (Fin n → ℤ) → EuclideanSpace ℂ ι, Summable (fun x => ‖g x‖) →
        eLpNorm (arithVec n d Ω p s g) (ENNReal.ofReal t) Measure.count ≤
          K * (B : ℝ≥0∞) ^ paramA t * eLpNorm g (ENNReal.ofReal t) Measure.count := by
  obtain ⟨A₁, hA₁, hyoung⟩ := eLpNorm_arithVec_le_young n
  obtain ⟨A₂, hA₂, hinfty⟩ := arithVec_le_of_norm_le n
  set A : ℝ≥0 := (max (max A₁ A₂) 1).toNNReal
  have hA : (A : ℝ≥0∞) = ENNReal.ofReal (max (max A₁ A₂) 1) := rfl
  have hApos : 0 < A := Real.toNNReal_pos.2 (lt_of_lt_of_le one_pos (le_max_right _ _))
  -- the common hypotheses
  have hsub : ∀ d Ω p s (ι : Type _) [Fintype ι], IsSublinearOn (arithVec (ι := ι) n d Ω p s)
      {g | Summable fun x => ‖g x‖} Measure.count := by
    intro d Ω p s ι _ f hf g hg
    refine ae_of_all _ fun x => ?_
    rw [Real.norm_of_nonneg (arithVec_nonneg s _ x), Real.norm_of_nonneg (arithVec_nonneg s _ x),
      Real.norm_of_nonneg (arithVec_nonneg s _ x)]
    exact arithVec_add_le s hf hg x
  have hone : ∀ d Ω p s (ι : Type _) [Fintype ι], HasStrongTypeOn (arithVec (ι := ι) n d Ω p s)
      {g | Summable fun x => ‖g x‖} 1 A Measure.count Measure.count := by
    intro d Ω p s ι _ g hg
    rw [ENNReal.ofReal_one]
    refine (hyoung d Ω p s le_rfl g hg).trans ?_
    rw [hA]; gcongr; exact (le_max_left _ _).trans (le_max_left _ _)
  have hinf : ∀ d Ω p s (ι : Type _) [Fintype ι], HasLinftyBoundOn (arithVec (ι := ι) n d Ω p s)
      {g | Summable fun x => ‖g x‖} A Measure.count := by
    intro d Ω p s ι _ g hg S hS
    refine ae_of_all _ fun x => ?_
    have hS0 : 0 ≤ S := (norm_nonneg _).trans (hS 0)
    rw [Real.norm_of_nonneg (arithVec_nonneg s _ x), Real.coe_toNNReal _ (by positivity)]
    exact (hinfty d Ω p s g hg S hS x).trans
      (mul_le_mul_of_nonneg_right ((le_max_right _ _).trans (le_max_left _ _)) hS0)
  have htwo : ∀ d Ω p s (ι : Type _) [Fintype ι] (B : ℝ≥0),
      (∀ u : (Fin n → ℤ) → ℂ, Summable (fun z => ‖u z‖) →
        eLpNorm (fun x => (liftRat s).sup fun aq =>
          ‖latMult (liftA n d Ω p s aq.1 aq.2) u x‖ₑ) 2 Measure.count ≤
            ENNReal.ofReal B * eLpNorm u 2 Measure.count) →
      HasStrongTypeOn (arithVec (ι := ι) n d Ω p s) {g | Summable fun x => ‖g x‖} 2 B
        Measure.count Measure.count := by
    intro d Ω p s ι _ B h g hg
    rw [ENNReal.ofReal_ofNat, ← ENNReal.ofReal_coe_nnreal]
    exact eLpNorm_arithVec_two_le s h g hg
  rcases lt_trichotomy t 2 with ht2 | rfl | ht2
  · -- `1 < t < 2`: interpolate between `(1,1)` and `(2,2)`, `θ = 2 - 2/t`
    set θ : ℝ := 2 - 2 / t
    have hθ : 1 / t = (1 - θ) / 1 + θ / 2 := by simp only [θ]; field_simp; ring
    have h1θ : 0 ≤ 1 - θ := by
      have : 1 ≤ 2 / t := by rw [le_div_iff₀ (by linarith)]; linarith
      simp only [θ]; linarith
    refine ⟨(marcinkiewiczConst 1 2 t : ℝ≥0∞) * (A : ℝ≥0∞) ^ (1 - θ),
      ENNReal.mul_ne_top ENNReal.coe_ne_top (ENNReal.rpow_ne_top_of_nonneg h1θ ENNReal.coe_ne_top),
      fun d Ω p s ι _ B h g hg => ?_⟩
    rw [paramA_eq_of_le_two ht ht2.le]
    refine (eLpNorm_le_of_hasWeakTypeOn one_pos ht ht2 hθ
      ((hone d Ω p s ι).hasWeakTypeOn one_pos) ((htwo d Ω p s ι B h).hasWeakTypeOn two_pos)
      (hsub d Ω p s ι) arith_isTruncationClosed_summable hg AEStronglyMeasurable.of_discrete
      AEStronglyMeasurable.of_discrete).trans (le_of_eq ?_)
    ring
  · -- `t = 2`
    refine ⟨1, ENNReal.one_ne_top, fun d Ω p s ι _ B h g hg => ?_⟩
    rw [paramA_eq_of_two_le ht le_rfl, div_self two_ne_zero, ENNReal.rpow_one, one_mul]
    exact htwo d Ω p s ι B h g hg
  · -- `2 < t < ∞`: interpolate between `(2,2)` and `(∞,∞)`
    have h1 : 0 ≤ 1 - 2 / t := by rw [sub_nonneg, div_le_one (by linarith)]; linarith
    refine ⟨(marcinkiewiczConstTop 2 t : ℝ≥0∞) * (A : ℝ≥0∞) ^ (1 - 2 / t),
      ENNReal.mul_ne_top ENNReal.coe_ne_top (ENNReal.rpow_ne_top_of_nonneg h1 ENNReal.coe_ne_top),
      fun d Ω p s ι _ B h g hg => ?_⟩
    rw [paramA_eq_of_two_le ht ht2.le]
    calc eLpNorm (arithVec n d Ω p s g) (ENNReal.ofReal t) Measure.count
        ≤ (marcinkiewiczConstTop 2 t : ℝ≥0∞) * (B : ℝ≥0∞) ^ (2 / t) * (A : ℝ≥0∞) ^ (1 - 2 / t) *
            eLpNorm g (ENNReal.ofReal t) Measure.count :=
          eLpNorm_le_of_hasWeakTypeOn_of_linfty two_pos ht2
            ((htwo d Ω p s ι B h).hasWeakTypeOn two_pos) (hinf d Ω p s ι) (hsub d Ω p s ι)
            arith_isTruncationClosed_summable hg AEStronglyMeasurable.of_discrete
            AEStronglyMeasurable.of_discrete (Or.inl hApos)
      _ = _ := by ring

/-- **Blueprint Lemma 9.2 (`lem:arithmax`), eq. (9.6) (`eq:arithvector`)**, the vector-valued
arithmetic maximal decay: for `n ≥ 1`, `d ≥ 1` and `1 < t < ∞` there are `δ_t > 0` and `C_t`
(independent of `Ω, p`, of `s` and of the list) such that for every `s ≥ 1` and every finite
list `(f_ν)_{ν ∈ F}` of functions in `ℓ¹(ℤⁿ)` (e.g. finitely supported),
`‖(∑_ν sup_{α ∈ 𝓡_s} |A_{s,α} f_ν|²)^{1/2}‖_{ℓ^t} ≤ C_t 2^{-δ_t s} ‖(∑_ν |f_ν|²)^{1/2}‖_{ℓ^t}`.
One may take `δ_t = γ min(2/t, 2/t')` (`γ` from eq. (9.5), `arith_maximal_decay`). -/
theorem arith_maximal_decay_vector (n d : ℕ) (hn : 1 ≤ n) (hd : 1 ≤ d) {t : ℝ} (ht : 1 < t) :
    ∃ δ : ℝ, 0 < δ ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ),
      1 ≤ s → ∀ {ι : Type*} (F : Finset ι) (f : ι → (Fin n → ℤ) → ℂ),
        (∀ ν ∈ F, Summable fun z => ‖f ν z‖) →
        eLpNorm (fun x => Real.sqrt (∑ ν ∈ F,
            ((((liftRat s).sup fun aq =>
              ‖latMult (liftA n d Ω p s aq.1 aq.2) (f ν) x‖₊ : ℝ≥0) : ℝ) ^ 2)))
            (ENNReal.ofReal t) Measure.count ≤
          ENNReal.ofReal (C * (2 : ℝ) ^ (-(δ * s))) *
            eLpNorm (fun x => Real.sqrt (∑ ν ∈ F, ‖f ν x‖ ^ 2)) (ENNReal.ofReal t)
              Measure.count := by
  obtain ⟨γ, hγ, C₂, hC₂, h95⟩ := arith_maximal_decay n d hn hd
  obtain ⟨K, hK, hint⟩ := arithVec_lp_of_l2 n ht
  set θ := paramA t
  have hθ : 0 < θ := paramA_pos ht
  refine ⟨γ * θ, by positivity, K.toReal * C₂ ^ θ, by positivity,
    fun Ω p s hs ι F f hf => ?_⟩
  set g : (Fin n → ℤ) → EuclideanSpace ℂ F := fun x => WithLp.toLp 2 fun ν => f ν x
  have hgnorm : ∀ x, ‖g x‖ = Real.sqrt (∑ ν ∈ F, ‖f ν x‖ ^ 2) := by
    intro x
    rw [EuclideanSpace.norm_eq]
    simp only [g]
    rw [Finset.sum_coe_sort F (fun ν => ‖f ν x‖ ^ 2)]
  have hg : Summable fun x => ‖g x‖ := by
    refine Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun x => ?_)
      (summable_sum fun ν hν => hf ν hν)
    rw [hgnorm]
    refine Real.sqrt_le_iff.2 ⟨Finset.sum_nonneg fun _ _ => norm_nonneg _, ?_⟩
    exact Finset.sum_sq_le_sq_sum_of_nonneg fun _ _ => norm_nonneg _
  set B : ℝ := C₂ * (2 : ℝ) ^ (-(γ * s))
  have hB : 0 ≤ B := by positivity
  have h2 : ∀ u : (Fin n → ℤ) → ℂ, Summable (fun z => ‖u z‖) →
      eLpNorm (fun x => (liftRat s).sup fun aq =>
        ‖latMult (liftA n d Ω p s aq.1 aq.2) u x‖ₑ) 2 Measure.count ≤
          ENNReal.ofReal (B.toNNReal : ℝ) * eLpNorm u 2 Measure.count := by
    intro u hu
    rw [Real.coe_toNNReal _ hB]
    exact h95 Ω p s hs u hu
  have hmain := hint d Ω p s B.toNNReal h2 g hg
  have hL : (fun x => Real.sqrt (∑ ν ∈ F,
      ((((liftRat s).sup fun aq =>
        ‖latMult (liftA n d Ω p s aq.1 aq.2) (f ν) x‖₊ : ℝ≥0) : ℝ) ^ 2))) =
      arithVec n d Ω p s g := by
    funext x
    rw [arithVec, ← Finset.sum_coe_sort F]
    rfl
  have hR : eLpNorm g (ENNReal.ofReal t) Measure.count =
      eLpNorm (fun x => Real.sqrt (∑ ν ∈ F, ‖f ν x‖ ^ 2)) (ENNReal.ofReal t) Measure.count :=
    eLpNorm_congr_norm_ae AEStronglyMeasurable.of_discrete AEStronglyMeasurable.of_discrete
      (ae_of_all _ fun x => by
      rw [hgnorm, Real.norm_of_nonneg (Real.sqrt_nonneg _)])
  rw [hL, ← hR]
  refine hmain.trans (le_of_eq ?_)
  congr 1
  change K * ENNReal.ofReal B ^ θ = _
  rw [ENNReal.ofReal_rpow_of_nonneg hB hθ.le, ← ENNReal.ofReal_toReal hK,
    ← ENNReal.ofReal_mul ENNReal.toReal_nonneg, ENNReal.ofReal_toReal hK]
  congr 1
  simp only [B]
  rw [Real.mul_rpow hC₂ (by positivity), ← Real.rpow_mul (by norm_num), mul_assoc]
  congr 3; ring


end ArithMax

/-! ### Blueprint Lemma 9.3 (`lem:liftsquare`): the factorization (9.8) -/

/-- `L_s ≥ 8`. -/
lemma eight_le_liftL (s : ℕ) : (8 : ℝ) ≤ liftL n d Ω p s := by
  have h := pow_le_liftL (n := n) (d := d) (Ω := Ω) (p := p) s
  have h3 : 3 ≤ 100 * (n + 2 * d + 1) * (s + 1) := by nlinarith
  have : (2 : ℕ) ^ 3 ≤ liftL n d Ω p s := (Nat.pow_le_pow_right (by norm_num) h3).trans h
  exact_mod_cast this

/-- `χ_s ≠ 0` forces `χ̃_s ≠ 0` (from `χ_s χ̃_s = χ_s`). -/
lemma liftChiT_ne_zero_of_liftChi_ne_zero {s : ℕ} {η : EuclideanSpace ℝ (Fin n)}
    (h : liftChi n d Ω p s η ≠ 0) : liftChiT n d Ω p s η ≠ 0 := by
  intro h0
  apply h
  rw [← liftChi_mul_liftChiT s η, h0, mul_zero]

/-- The box bound `|ηᵢ| ≤ 2 (1/L_s)` on the support of `χ̃_s`. -/
lemma abs_le_of_liftChiT_ne_zero {s : ℕ} {η : EuclideanSpace ℝ (Fin n)}
    (h : liftChiT n d Ω p s η ≠ 0) (i : Fin n) :
    |η i| ≤ 2 * (1 / (liftL n d Ω p s : ℝ)) := by
  have := support_liftChiT (n := n) (d := d) (Ω := Ω) (p := p) s h i
  rw [mul_one_div]; exact this

/-- At most one lattice translate of `χ̃_s` is nonzero at any point. -/
lemma liftChiT_translate_unique {s : ℕ} {ζ : EuclideanSpace ℝ (Fin n)} {z z' : Fin n → ℤ}
    (hz : liftChiT n d Ω p s (ζ - latEmbed z) ≠ 0)
    (hz' : liftChiT n d Ω p s (ζ - latEmbed z') ≠ 0) : z = z' := by
  have hL := eight_le_liftL (n := n) (d := d) (Ω := Ω) (p := p) s
  have hε4 : 4 * (1 / (liftL n d Ω p s : ℝ)) < 1 := by
    rw [mul_one_div, div_lt_one (by linarith)]; linarith
  refine periodize_atMostOne (m := fun η => (liftChiT n d Ω p s η : ℂ))
    (ε := 1 / (liftL n d Ω p s : ℝ))
    (fun η hη => abs_le_of_liftChiT_ne_zero (by exact_mod_cast hη)) hε4 ζ z z'
    (by exact_mod_cast hz) (by exact_mod_cast hz')

/-- At any point at most one center `β ∈ 𝒰_{N_s}` and one translate `z` have
`χ̃_s(ξ - β - z) ≠ 0` (`s ≥ 1`). -/
lemma liftChiT_center_unique {s : ℕ} (hs : 1 ≤ s)
    {γ γ' : Fin n → ZMod (blockProd (goodBlocks (paramRho n d Ω p) (liftN s)))}
    (hγ : γ ∈ paramGoodSet n d Ω p (liftN s)) (hγ' : γ' ∈ paramGoodSet n d Ω p (liftN s))
    {ξ : EuclideanSpace ℝ (Fin n)} {z z' : Fin n → ℤ}
    (h : liftChiT n d Ω p s
      (ξ - ratPt (blockProd (goodBlocks (paramRho n d Ω p) (liftN s))) γ - latEmbed z) ≠ 0)
    (h' : liftChiT n d Ω p s
      (ξ - ratPt (blockProd (goodBlocks (paramRho n d Ω p) (liftN s))) γ' - latEmbed z') ≠ 0) :
    γ = γ' ∧ z = z' := by
  have hL := liftL_pos (n := n) (d := d) (Ω := Ω) (p := p) s
  have hb : ∀ {η : EuclideanSpace ℝ (Fin n)}, liftChiT n d Ω p s η ≠ 0 → ∀ i,
      |η i| ≤ 2 * (4 / (liftL n d Ω p s : ℝ)) := fun hη i => by
    refine (abs_le_of_liftChiT_ne_zero hη i).trans ?_
    gcongr; norm_num
  have hγγ : γ = γ' := eq_of_near_ratPt goodBlocks_one_lt goodBlocks_pairwise_coprime
    (by positivity) (liftEps_threshold hs) hγ hγ' (z := z) (z' := z') (ξ := ξ)
    (fun i => by simpa [latEmbed_apply] using hb h i)
    (fun i => by simpa [latEmbed_apply] using hb h' i)
  subst hγγ
  exact ⟨rfl, liftChiT_translate_unique h h'⟩

/-- For `g` supported where `χ̃_s ≠ 0`: if `χ̃_s(ζ - z) ≠ 0` then `g_per(ζ) = g(ζ - z)`. -/
lemma periodize_eq_of_liftChiT {s : ℕ} {g : EuclideanSpace ℝ (Fin n) → ℂ}
    (hg : ∀ η, g η ≠ 0 → liftChiT n d Ω p s η ≠ 0) {ζ : EuclideanSpace ℝ (Fin n)}
    {z : Fin n → ℤ} (hz : liftChiT n d Ω p s (ζ - latEmbed z) ≠ 0) :
    periodize g ζ = g (ζ - latEmbed z) := by
  rw [periodize, tsum_eq_single z]
  intro z' hz'
  by_contra h
  exact hz' (liftChiT_translate_unique (hg _ h) hz)

/-- For `g` supported where `χ̃_s ≠ 0`: if no translate of `χ̃_s` is nonzero at `ζ`, then
`g_per(ζ) = 0`. -/
lemma periodize_eq_zero_of_liftChiT {s : ℕ} {g : EuclideanSpace ℝ (Fin n) → ℂ}
    (hg : ∀ η, g η ≠ 0 → liftChiT n d Ω p s η ≠ 0) {ζ : EuclideanSpace ℝ (Fin n)}
    (h : ∀ z : Fin n → ℤ, liftChiT n d Ω p s (ζ - latEmbed z) = 0) : periodize g ζ = 0 := by
  by_contra h'
  obtain ⟨z, hz⟩ := exists_ne_zero_of_periodize_ne_zero h'
  exact hg _ hz (h z)

/-- The good-set periodization of `g` (supported where `χ̃_s ≠ 0`) at an active point:
if `χ̃_s(ξ - β - z) ≠ 0` with `β ∈ 𝒰_{N_s}`, then `∑_{β' ∈ 𝒰} g_per(ξ - β') = g(ξ - β - z)`. -/
lemma cosetSymbol_eq_of_liftChiT {s : ℕ} (hs : 1 ≤ s) {g : EuclideanSpace ℝ (Fin n) → ℂ}
    (hg : ∀ η, g η ≠ 0 → liftChiT n d Ω p s η ≠ 0) {ξ : EuclideanSpace ℝ (Fin n)}
    {β : Fin n → ZMod (blockProd (goodBlocks (paramRho n d Ω p) (liftN s)))}
    (hβ : β ∈ paramGoodSet n d Ω p (liftN s)) {z : Fin n → ℤ}
    (hz : liftChiT n d Ω p s
      (ξ - ratPt (blockProd (goodBlocks (paramRho n d Ω p) (liftN s))) β - latEmbed z) ≠ 0) :
    cosetSymbol (blockProd (goodBlocks (paramRho n d Ω p) (liftN s))) g
        (paramGoodSet n d Ω p (liftN s)) ξ =
      g (ξ - ratPt (blockProd (goodBlocks (paramRho n d Ω p) (liftN s))) β - latEmbed z) := by
  unfold cosetSymbol
  rw [Finset.sum_eq_single_of_mem β hβ, periodize_eq_of_liftChiT hg hz]
  intro β' hβ' hne
  refine periodize_eq_zero_of_liftChiT hg fun z' => ?_
  by_contra h
  exact hne (liftChiT_center_unique hs hβ' hβ h hz).1

/-- The good-set periodization of `g` (supported where `χ̃_s ≠ 0`) vanishes at inactive points. -/
lemma cosetSymbol_eq_zero_of_liftChiT {s : ℕ} {g : EuclideanSpace ℝ (Fin n) → ℂ}
    (hg : ∀ η, g η ≠ 0 → liftChiT n d Ω p s η ≠ 0) {ξ : EuclideanSpace ℝ (Fin n)}
    (h : ∀ β ∈ paramGoodSet n d Ω p (liftN s), ∀ z : Fin n → ℤ, liftChiT n d Ω p s
      (ξ - ratPt (blockProd (goodBlocks (paramRho n d Ω p) (liftN s))) β - latEmbed z) = 0) :
    cosetSymbol (blockProd (goodBlocks (paramRho n d Ω p) (liftN s))) g
        (paramGoodSet n d Ω p (liftN s)) ξ = 0 :=
  Finset.sum_eq_zero fun β hβ => periodize_eq_zero_of_liftChiT hg (h β hβ)

/-- **Blueprint Lemma 9.3 (`lem:liftsquare`), eq. (9.8) (`eq:liftfactor`)**, the exact symbol
factorization: for `s ≥ 1`, `α = a/q ∈ 𝓡_s` and every symbol `m`,
`Lift_{s,α}[m] = A_{s,α} · D_s[m]` pointwise on `E`. -/
theorem liftSym_eq_liftA_mul_liftD {s : ℕ} (hs : 1 ≤ s) {a q : ℕ} (haq : (a, q) ∈ liftRat s)
    (m : EuclideanSpace ℝ (Fin n) → ℂ) (ξ : EuclideanSpace ℝ (Fin n)) :
    liftSym n d Ω p s a q m ξ = liftA n d Ω p s a q ξ * liftD n d Ω p s m ξ := by
  obtain ⟨-, hqN, -, -⟩ := mem_liftRat.1 haq
  have hq1 : 1 ≤ q := one_le_of_mem_liftRat haq
  set Q := blockProd (goodBlocks (paramRho n d Ω p) (liftN s))
  have hgT : ∀ η, m η * (liftChiT n d Ω p s η : ℂ) ≠ 0 → liftChiT n d Ω p s η ≠ 0 :=
    fun η h h0 => h (by rw [h0, Complex.ofReal_zero, mul_zero])
  have hgC : ∀ (c : EuclideanSpace ℝ (Fin n) → ℂ) η, c η * (liftChi n d Ω p s η : ℂ) ≠ 0 →
      liftChiT n d Ω p s η ≠ 0 := fun c η h => liftChiT_ne_zero_of_liftChi_ne_zero
    fun h0 => h (by rw [h0, Complex.ofReal_zero, mul_zero])
  unfold liftA liftSym
  rw [Finset.sum_mul]
  refine Finset.sum_congr rfl fun b _ => ?_
  rw [mul_assoc]
  congr 1
  obtain ⟨hγ, hγpt⟩ := gridEmb_mem_goodSet (n := n) (paramRho_pos n d Ω p) (two_le_liftN hs) hq1
    hqN.le b
  rw [← hγpt]
  by_cases hact : ∃ z : Fin n → ℤ, liftChiT n d Ω p s
      (ξ - ratPt Q (gridEmb Q q b) - latEmbed z) ≠ 0
  · obtain ⟨z, hz⟩ := hact
    rw [periodize_eq_of_liftChiT (hgC m) hz, periodize_eq_of_liftChiT (hgC _) hz, liftD,
      cosetSymbol_eq_of_liftChiT hs hgT hγ hz]
    set η := ξ - ratPt Q (gridEmb Q q b) - latEmbed z
    have h := liftChi_mul_liftChiT (n := n) (d := d) (Ω := Ω) (p := p) s η
    have h' : (liftChi n d Ω p s η : ℂ) * (liftChiT n d Ω p s η : ℂ) = liftChi n d Ω p s η := by
      exact_mod_cast h
    calc m η * (liftChi n d Ω p s η : ℂ)
        = m η * ((liftChi n d Ω p s η : ℂ) * (liftChiT n d Ω p s η : ℂ)) := by rw [h']
      _ = 1 * (liftChi n d Ω p s η : ℂ) * (m η * (liftChiT n d Ω p s η : ℂ)) := by ring
  · push Not at hact
    rw [periodize_eq_zero_of_liftChiT (hgC m) hact, periodize_eq_zero_of_liftChiT (hgC _) hact,
      zero_mul]


/-! #### The operator form of (9.8) -/

lemma continuous_liftChi (s : ℕ) :
    Continuous fun ξ : EuclideanSpace ℝ (Fin n) => (liftChi n d Ω p s ξ : ℂ) :=
  Complex.continuous_ofReal.comp (contDiff_liftCutoff.continuous.comp (continuous_const_smul _))

lemma continuous_liftChiT (s : ℕ) :
    Continuous fun ξ : EuclideanSpace ℝ (Fin n) => (liftChiT n d Ω p s ξ : ℂ) :=
  Complex.continuous_ofReal.comp
    (contDiff_companionCutoff.continuous.comp (continuous_const_smul _))

/-- `A_{s,α}` is continuous. -/
lemma continuous_liftA (s a q : ℕ) : Continuous (liftA n d Ω p s a q) := by
  have hL := eight_le_liftL (n := n) (d := d) (Ω := Ω) (p := p) s
  unfold liftA liftSym
  refine continuous_finsetSum _ fun b _ => continuous_const.mul ?_
  refine (continuous_periodize_of_support (c := 1 / (liftL n d Ω p s : ℝ))
    (continuous_const.mul (continuous_liftChi s)) ?_ fun η hη i => ?_).comp
    (continuous_sub_right _)
  · rw [div_lt_div_iff₀ (by linarith) (by norm_num)]; linarith
  · have h : liftChi n d Ω p s η ≠ 0 := fun h0 => hη (by simp [h0])
    exact support_liftChi s h i

/-- Lifted symbols are `ℤⁿ`-periodic. -/
lemma liftSym_add_latEmbed (s a q : ℕ) (m : EuclideanSpace ℝ (Fin n) → ℂ)
    (ξ : EuclideanSpace ℝ (Fin n)) (k : Fin n → ℤ) :
    liftSym n d Ω p s a q m (ξ + latEmbed k) = liftSym n d Ω p s a q m ξ := by
  unfold liftSym
  refine Finset.sum_congr rfl fun b _ => ?_
  rw [add_sub_right_comm, periodize_add_latEmbed]

/-- The kernel of `A_{s,α}` is in `ℓ¹`. -/
lemma summable_latKernel_liftA (s a : ℕ) {q : ℕ} (hq : 1 ≤ q) :
    Summable fun y => ‖latKernel (liftA n d Ω p s a q) y‖ := by
  refine (arith_summable_norm_liftPhi (n := n) (d := d) (Ω := Ω) (p := p) s).congr fun y => ?_
  rw [latKernel_liftA s a hq, norm_mul, norm_eC, one_mul]

/-- `A_{s,α}` is integrable on the torus. -/
lemma integrableOn_liftA (s a q : ℕ) : IntegrableOn (liftA n d Ω p s a q) (torusCube n) :=
  integrableOn_liftSym (by simpa using integrable_liftChi (n := n) (d := d) (Ω := Ω) (p := p) s)

/-- Composition with a continuous periodic symbol with `ℓ¹` kernel, in convolution form: for
`D` integrable on the torus and `f ∈ ℓ¹`, `(A D)(D) f = Ǎ * (D(D) f)` (the second factor need
not be in `ℓ¹`). -/
lemma latMult_mul_eq_tsum {A D : EuclideanSpace ℝ (Fin n) → ℂ} (hA : Continuous A)
    (hper : ∀ ξ (k : Fin n → ℤ), A (ξ + latEmbed k) = A ξ)
    (hK : Summable fun y => ‖latKernel A y‖) (hD : IntegrableOn D (torusCube n))
    {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) (x : Fin n → ℤ) :
    latMult (fun ξ => A ξ * D ξ) f x = ∑' y, latKernel A y * latMult D f (x - y) := by
  have hH : IntegrableOn (fun ξ => D ξ * latFT f ξ * eC (inner ℝ (latEmbed x) ξ))
      (torusCube n) := by
    refine hD.mul_bdd (c := ∑' z, ‖f z‖)
      (((continuous_latFT hf).mul (by fun_prop : Continuous fun ξ : EuclideanSpace ℝ (Fin n) =>
        eC (inner ℝ (latEmbed x) ξ))).aestronglyMeasurable) ?_ |>.congr ?_
    · exact Filter.Eventually.of_forall fun ξ => by
        rw [Pi.mul_apply, norm_mul, norm_eC, mul_one]; exact norm_latFT_le hf ξ
    · exact Filter.Eventually.of_forall fun ξ => by simp only [Pi.mul_apply]; ring
  have e1 : latMult (fun ξ => A ξ * D ξ) f x = ∫ ξ in torusCube n, latFT (latKernel A) ξ *
      (D ξ * latFT f ξ * eC (inner ℝ (latEmbed x) ξ)) := by
    unfold latMult
    congr 1; funext ξ
    rw [latFT_latKernel_of_continuous hA hper hK ξ]; ring
  rw [e1, integral_latFT_mul hK hH]
  refine tsum_congr fun y => ?_
  congr 1
  unfold latMult
  congr 1; funext ξ
  rw [latEmbed_sub, inner_sub_left, sub_eq_add_neg, eC_add]; ring

/-- `χ̃_s` (as a complex function) is integrable. -/
lemma integrable_liftChiT (s : ℕ) :
    Integrable fun ξ : EuclideanSpace ℝ (Fin n) => (liftChiT n d Ω p s ξ : ℂ) := by
  refine (continuous_liftChiT s).integrable_of_hasCompactSupport ?_
  refine HasCompactSupport.intro (isCompact_box (2 / (liftL n d Ω p s : ℝ))) fun ξ hξ => ?_
  by_contra h
  exact hξ (support_liftChiT s (fun h0 => h (by simp [h0])))

/-- `m χ̃_s` is integrable for `m` a.e. strongly measurable and bounded. -/
lemma integrable_mul_liftChiT {s : ℕ} {m : EuclideanSpace ℝ (Fin n) → ℂ}
    (hm : AEStronglyMeasurable m volume) {B : ℝ} (hB : ∀ ξ, ‖m ξ‖ ≤ B) :
    Integrable fun ξ => m ξ * (liftChiT n d Ω p s ξ : ℂ) := by
  have hχ := integrable_liftChiT (n := n) (d := d) (Ω := Ω) (p := p) s
  exact Integrable.mono' (hχ.norm.const_mul B) (hm.mul hχ.aestronglyMeasurable)
    (Filter.Eventually.of_forall fun ξ => by
      rw [norm_mul]; exact mul_le_mul_of_nonneg_right (hB ξ) (norm_nonneg _))

/-- `D_s[m]` is integrable on the torus for bounded measurable `m`. -/
lemma integrableOn_liftD {s : ℕ} {m : EuclideanSpace ℝ (Fin n) → ℂ}
    (hm : AEStronglyMeasurable m volume) {B : ℝ} (hB : ∀ ξ, ‖m ξ‖ ≤ B) :
    IntegrableOn (liftD n d Ω p s m) (torusCube n) :=
  integrableOn_cosetSymbol (integrable_mul_liftChiT hm hB) _

/-- **Blueprint Lemma 9.3 (`lem:liftsquare`), eq. (9.8), operator form**: for `s ≥ 1`,
`α = a/q ∈ 𝓡_s`, `m` bounded measurable and `f ∈ ℓ¹` (e.g. finitely supported),
`Lift_{s,α}[m](D) f = Ǎ_{s,α} * (D_s[m](D) f)`, i.e. `A_{s,α}(D)` applied (by its `ℓ¹` kernel) to
`D_s[m](D) f` (which is bounded, but need not be in `ℓ¹`). -/
theorem latMult_liftSym_eq_tsum {s : ℕ} (hs : 1 ≤ s) {a q : ℕ} (haq : (a, q) ∈ liftRat s)
    {m : EuclideanSpace ℝ (Fin n) → ℂ} (hm : AEStronglyMeasurable m volume) {B : ℝ}
    (hB : ∀ ξ, ‖m ξ‖ ≤ B) {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖)
    (x : Fin n → ℤ) :
    latMult (liftSym n d Ω p s a q m) f x =
      ∑' y, latKernel (liftA n d Ω p s a q) y * latMult (liftD n d Ω p s m) f (x - y) := by
  have e : liftSym n d Ω p s a q m = fun ξ => liftA n d Ω p s a q ξ * liftD n d Ω p s m ξ :=
    funext (liftSym_eq_liftA_mul_liftD hs haq m)
  rw [e]
  exact latMult_mul_eq_tsum (continuous_liftA s a q) (liftSym_add_latEmbed s a q _)
    (summable_latKernel_liftA s a (one_le_of_mem_liftRat haq)) (integrableOn_liftD hm hB) hf x

/-- **Blueprint Lemma 9.3 (`lem:liftsquare`), eq. (9.8), composition form**: under the hypotheses
of `latMult_liftSym_eq_tsum`, if moreover `D_s[m](D) f ∈ ℓ¹`, then
`Lift_{s,α}[m](D) f = A_{s,α}(D) (D_s[m](D) f)`. -/
theorem latMult_liftSym_eq_latMult {s : ℕ} (hs : 1 ≤ s) {a q : ℕ} (haq : (a, q) ∈ liftRat s)
    {m : EuclideanSpace ℝ (Fin n) → ℂ} (hm : AEStronglyMeasurable m volume) {B : ℝ}
    (hB : ∀ ξ, ‖m ξ‖ ≤ B) {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖)
    (hDf : Summable fun z => ‖latMult (liftD n d Ω p s m) f z‖) :
    latMult (liftSym n d Ω p s a q m) f =
      latMult (liftA n d Ω p s a q) (latMult (liftD n d Ω p s m) f) := by
  funext x
  rw [latMult_liftSym_eq_tsum hs haq hm hB hf x,
    latMult_eq_latConv (integrableOn_liftA s a q) hDf, latConv]


/-! #### The arithmetic vector bound (9.6) for bounded inputs -/

open scoped NNReal ENNReal in
/-- Finite suprema of norms are continuous. -/
lemma tendsto_finset_sup_nnnorm {ι : Type*} (S : Finset ι) {u : ℕ → ι → ℂ} {v : ι → ℂ}
    (h : ∀ i ∈ S, Filter.Tendsto (fun N => u N i) Filter.atTop (nhds (v i))) :
    Filter.Tendsto (fun N => S.sup fun i => ‖u N i‖₊) Filter.atTop
      (nhds (S.sup fun i => ‖v i‖₊)) := by
  classical
  induction S using Finset.induction_on with
  | empty => simp
  | insert a S ha ih =>
    simp only [Finset.sup_insert]
    exact ((continuous_nnnorm.tendsto _).comp (h a (mem_insert_self a S))).max
      (ih fun i hi => h i (mem_insert_of_mem hi))

open scoped NNReal ENNReal in
/-- Eq. (9.6) of Blueprint Lemma 9.2 for bounded inputs (not necessarily in `ℓ¹`), with
`A_{s,α}` acting by its `ℓ¹` kernel `Ǎ_{s,α}`: for `1 < t < ∞` there are `δ_t > 0` and `C_t` such
that for every `s ≥ 1` and every finite list `(g_ν)` of functions bounded by `M`,
`‖(∑_ν sup_{α ∈ 𝓡_s} |Ǎ_{s,α} * g_ν|²)^{1/2}‖_t ≤ C_t 2^{-δ_t s} ‖(∑_ν |g_ν|²)^{1/2}‖_t`.
(Windowing `g_ν w_N ∈ ℓ¹`, `arith_maximal_decay_vector`, and Fatou as `N → ∞`.) -/
theorem arith_maximal_decay_vector_bdd (n d : ℕ) (hn : 1 ≤ n) (hd : 1 ≤ d) {t : ℝ}
    (ht : 1 < t) :
    ∃ δ : ℝ, 0 < δ ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ),
      1 ≤ s → ∀ {ι : Type*} (F : Finset ι) (g : ι → (Fin n → ℤ) → ℂ) (M : ℝ),
        (∀ ν ∈ F, ∀ x, ‖g ν x‖ ≤ M) →
        eLpNorm (fun x => Real.sqrt (∑ ν ∈ F,
            ((((liftRat s).sup fun aq =>
              ‖∑' y, latKernel (liftA n d Ω p s aq.1 aq.2) y * g ν (x - y)‖₊ : ℝ≥0) : ℝ) ^ 2)))
            (ENNReal.ofReal t) Measure.count ≤
          ENNReal.ofReal (C * (2 : ℝ) ^ (-(δ * s))) *
            eLpNorm (fun x => Real.sqrt (∑ ν ∈ F, ‖g ν x‖ ^ 2)) (ENNReal.ofReal t)
              Measure.count := by
  obtain ⟨δ, hδ, C, hC, h⟩ := arith_maximal_decay_vector n d hn hd ht
  refine ⟨δ, hδ, C, hC, fun Ω p s hs ι F g M hM => ?_⟩
  set gN : ℕ → ι → (Fin n → ℤ) → ℂ := fun N ν x => g ν x * windowFun n N x with hgN
  have hgNs : ∀ N, ∀ ν ∈ F, Summable fun z => ‖gN N ν z‖ := by
    intro N ν hν
    refine Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun z => ?_)
      ((summable_windowFun N).mul_left M)
    rw [hgN, norm_mul]
    exact mul_le_mul_of_nonneg_right (hM ν hν z) (norm_nonneg _)
  -- the kernel form of `A_{s,α}` on `ℓ¹`
  have hker : ∀ N, ∀ ν ∈ F, ∀ aq ∈ liftRat s, ∀ x,
      latMult (liftA n d Ω p s aq.1 aq.2) (gN N ν) x =
        ∑' y, latKernel (liftA n d Ω p s aq.1 aq.2) y * gN N ν (x - y) := by
    intro N ν hν aq _ x
    rw [latMult_eq_latConv (integrableOn_liftA s _ _) (hgNs N ν hν), latConv]
  refine eLpNorm_le_of_tendsto_of_eLpNorm_le
    (u := fun N x => Real.sqrt (∑ ν ∈ F,
      ((((liftRat s).sup fun aq =>
        ‖latMult (liftA n d Ω p s aq.1 aq.2) (gN N ν) x‖₊ : ℝ≥0) : ℝ) ^ 2)))
    (fun _ => AEStronglyMeasurable.of_discrete) (Filter.Eventually.of_forall fun x => ?_)
    fun N => ?_
  · -- pointwise convergence
    refine (Real.continuous_sqrt.tendsto _).comp (tendsto_finsetSum _ fun ν hν => ?_)
    refine ((continuous_pow 2).tendsto _).comp ((NNReal.continuous_coe.tendsto _).comp ?_)
    refine tendsto_finset_sup_nnnorm _ fun aq haq => ?_
    have hq : 1 ≤ aq.2 := one_le_of_mem_liftRat (a := aq.1) (by simpa using haq)
    simp_rw [hker _ ν hν aq haq x]
    refine tendsto_tsum_of_dominated_convergence (bound := fun y =>
        ‖latKernel (liftA n d Ω p s aq.1 aq.2) y‖ * M)
      ((summable_latKernel_liftA s aq.1 hq).mul_right M) (fun y => ?_)
      (Filter.Eventually.of_forall fun N y => ?_)
    · have := (tendsto_windowFun (n := n) (x - y)).const_mul (g ν (x - y))
      rw [mul_one] at this
      exact this.const_mul _
    · rw [norm_mul, hgN, norm_mul]
      refine mul_le_mul_of_nonneg_left ?_ (norm_nonneg _)
      calc ‖g ν (x - y)‖ * ‖windowFun n N (x - y)‖ ≤ ‖g ν (x - y)‖ * 1 :=
            mul_le_mul_of_nonneg_left (norm_windowFun_le N _) (norm_nonneg _)
        _ ≤ M := by rw [mul_one]; exact hM ν hν _
  · -- the windowed bound
    refine (h Ω p s hs F (gN N) (hgNs N)).trans ?_
    gcongr
    refine eLpNorm_mono_real AEStronglyMeasurable.of_discrete fun x => ?_
    rw [Real.norm_of_nonneg (Real.sqrt_nonneg _)]
    refine Real.sqrt_le_sqrt (Finset.sum_le_sum fun ν _ => ?_)
    rw [hgN, norm_mul]
    refine pow_le_pow_left₀ (by positivity) ?_ 2
    calc ‖g ν x‖ * ‖windowFun n N x‖ ≤ ‖g ν x‖ * 1 :=
          mul_le_mul_of_nonneg_left (norm_windowFun_le N _) (norm_nonneg _)
      _ = ‖g ν x‖ := mul_one _


/-! #### The `ℓ²` square estimate (9.9) -/

/-- Pointwise: `∑_ν |D_s[m_ν](ξ)|² ≤ sup_η ∑_ν |m_ν(η)|²` (the good-set bumps are disjoint and
`0 ≤ χ̃_s ≤ 1`). -/
lemma sum_norm_sq_liftD_le {s : ℕ} (hs : 1 ≤ s) {ι : Type*} (F : Finset ι)
    (m : ι → EuclideanSpace ℝ (Fin n) → ℂ) {B : ℝ} (hB : ∀ η, ∑ ν ∈ F, ‖m ν η‖ ^ 2 ≤ B ^ 2)
    (ξ : EuclideanSpace ℝ (Fin n)) :
    ∑ ν ∈ F, ‖liftD n d Ω p s (m ν) ξ‖ ^ 2 ≤ B ^ 2 := by
  have hgT : ∀ ν η, m ν η * (liftChiT n d Ω p s η : ℂ) ≠ 0 → liftChiT n d Ω p s η ≠ 0 :=
    fun ν η h h0 => h (by rw [h0, Complex.ofReal_zero, mul_zero])
  by_cases hact : ∃ β ∈ paramGoodSet n d Ω p (liftN s), ∃ z : Fin n → ℤ, liftChiT n d Ω p s
      (ξ - ratPt (blockProd (goodBlocks (paramRho n d Ω p) (liftN s))) β - latEmbed z) ≠ 0
  · obtain ⟨β, hβ, z, hz⟩ := hact
    set η := ξ - ratPt (blockProd (goodBlocks (paramRho n d Ω p) (liftN s))) β - latEmbed z
    refine le_trans (Finset.sum_le_sum fun ν _ => ?_) (hB η)
    rw [liftD, cosetSymbol_eq_of_liftChiT hs (hgT ν) hβ hz, norm_mul, Complex.norm_real,
      Real.norm_of_nonneg (liftChiT_nonneg s η)]
    refine pow_le_pow_left₀ (mul_nonneg (norm_nonneg _) (liftChiT_nonneg s η)) ?_ 2
    exact mul_le_of_le_one_right (norm_nonneg _) (liftChiT_le_one s η)
  · push Not at hact
    rw [Finset.sum_eq_zero fun ν _ => by
      rw [liftD, cosetSymbol_eq_zero_of_liftChiT (hgT ν) hact, norm_zero]; norm_num]
    positivity

/-- A single term of a finite sum of squares is bounded by the bound of the sum. -/
lemma lift_norm_le_of_sum_sq_le {ι : Type*} {F : Finset ι} {a : ι → ℂ} {B : ℝ} (hB0 : 0 ≤ B)
    (h : ∑ ν ∈ F, ‖a ν‖ ^ 2 ≤ B ^ 2) {ν : ι} (hν : ν ∈ F) : ‖a ν‖ ≤ B := by
  have h1 : ‖a ν‖ ^ 2 ≤ B ^ 2 :=
    (Finset.single_le_sum (f := fun ν => ‖a ν‖ ^ 2) (fun _ _ => by positivity) hν).trans h
  exact (pow_le_pow_iff_left₀ (norm_nonneg _) hB0 two_ne_zero).1 h1

/-- `ℓ¹ ⊆ ℓ²` on `ℤⁿ` (summability of `|f|²`). -/
lemma summable_norm_sq_of_summable {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) :
    Summable fun z => ‖f z‖ ^ 2 := by
  refine Summable.of_nonneg_of_le (fun _ => by positivity) (fun z => ?_)
    (hf.mul_left (∑' z, ‖f z‖))
  rw [sq]
  exact mul_le_mul_of_nonneg_right (hf.le_tsum z fun _ _ => norm_nonneg _) (norm_nonneg _)

/-- `‖(∑_ν |g_ν|²)^{1/2}‖₂² = ∑_ν ∑_x |g_ν(x)|²` for square-summable `g_ν` on `ℤⁿ`. -/
lemma eLpNorm_sqrt_sum_sq_two_sq {ι : Type*} (F : Finset ι) (g : ι → (Fin n → ℤ) → ℂ)
    (hg : ∀ ν ∈ F, Summable fun x => ‖g ν x‖ ^ 2) :
    eLpNorm (fun x => Real.sqrt (∑ ν ∈ F, ‖g ν x‖ ^ 2)) 2 Measure.count ^ 2 =
      ENNReal.ofReal (∑ ν ∈ F, ∑' x, ‖g ν x‖ ^ 2) := by
  rw [arith_eLpNorm_two_sq_eq_tsum]
  have e : ∀ x, ‖Real.sqrt (∑ ν ∈ F, ‖g ν x‖ ^ 2)‖ₑ ^ 2 =
      ENNReal.ofReal (∑ ν ∈ F, ‖g ν x‖ ^ 2) := by
    intro x
    rw [Real.enorm_eq_ofReal (Real.sqrt_nonneg _), ← ENNReal.ofReal_pow (Real.sqrt_nonneg _),
      Real.sq_sqrt (Finset.sum_nonneg fun _ _ => by positivity)]
  simp_rw [e]
  rw [← ENNReal.ofReal_tsum_of_nonneg (fun x => Finset.sum_nonneg fun _ _ => by positivity)
    (summable_sum hg), Summable.tsum_finsetSum hg]

/-- The `ℓ²` bound of the proof of eq. (9.9): Parseval (Bessel) and disjointness of the
good-set bumps give `‖(∑_ν |D_s[m_ν](D) f|²)^{1/2}‖₂ ≤ B ‖f‖₂` when
`∑_ν |m_ν(η)|² ≤ B²` for all `η`. -/
lemma eLpNorm_sqrt_sum_liftD_two_le {s : ℕ} (hs : 1 ≤ s) {ι : Type*} (F : Finset ι)
    (m : ι → EuclideanSpace ℝ (Fin n) → ℂ) (hm : ∀ ν ∈ F, AEStronglyMeasurable (m ν) volume)
    {B : ℝ} (hB0 : 0 ≤ B) (hB : ∀ η, ∑ ν ∈ F, ‖m ν η‖ ^ 2 ≤ B ^ 2)
    {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) :
    eLpNorm (fun x => Real.sqrt (∑ ν ∈ F, ‖latMult (liftD n d Ω p s (m ν)) f x‖ ^ 2)) 2
      Measure.count ≤ ENNReal.ofReal B * eLpNorm f 2 Measure.count := by
  set D := fun ν => liftD n d Ω p s (m ν) with hD
  have hmB : ∀ ν ∈ F, ∀ η, ‖m ν η‖ ≤ B := fun ν hν η => lift_norm_le_of_sum_sq_le hB0 (hB η) hν
  have hDB : ∀ ν ∈ F, ∀ ξ, ‖D ν ξ‖ ≤ B := fun ν hν ξ =>
    lift_norm_le_of_sum_sq_le (a := fun ν => D ν ξ) hB0 (sum_norm_sq_liftD_le hs F m hB ξ) hν
  have hDm : ∀ ν ∈ F, AEStronglyMeasurable (D ν) (volume.restrict (torusCube n)) :=
    fun ν hν => (integrableOn_liftD (hm ν hν) (hmB ν hν)).aestronglyMeasurable
  have hBes := fun ν hν => summable_and_tsum_norm_sq_latMult_le_integral (hDm ν hν)
    (fun ξ _ => hDB ν hν ξ) hf
  set S := ∑' z, ‖f z‖
  have hfb : ∀ ξ, ‖latFT f ξ‖ ≤ S := norm_latFT_le hf
  have hint : ∀ ν ∈ F, IntegrableOn (fun ξ => ‖D ν ξ‖ ^ 2 * ‖latFT f ξ‖ ^ 2) (torusCube n) := by
    intro ν hν
    refine integrableOn_torusCube_of_bound
      (((hDm ν hν).norm.pow 2).mul ((continuous_latFT hf).norm.pow 2).aestronglyMeasurable)
      (B ^ 2 * S ^ 2) fun ξ _ => ?_
    rw [Real.norm_of_nonneg (by positivity)]
    gcongr
    · exact hDB ν hν ξ
    · exact hfb ξ
  have hintR : IntegrableOn (fun ξ => B ^ 2 * ‖latFT f ξ‖ ^ 2) (torusCube n) := by
    refine integrableOn_torusCube_of_bound
      ((continuous_const.mul ((continuous_latFT hf).norm.pow 2)).aestronglyMeasurable)
      (B ^ 2 * S ^ 2) fun ξ _ => ?_
    rw [Real.norm_of_nonneg (by positivity)]
    gcongr
    exact hfb ξ
  have hreal : ∑ ν ∈ F, ∑' x, ‖latMult (D ν) f x‖ ^ 2 ≤ B ^ 2 * ∑' x, ‖f x‖ ^ 2 := by
    calc ∑ ν ∈ F, ∑' x, ‖latMult (D ν) f x‖ ^ 2
        ≤ ∑ ν ∈ F, ∫ ξ in torusCube n, ‖D ν ξ‖ ^ 2 * ‖latFT f ξ‖ ^ 2 :=
          Finset.sum_le_sum fun ν hν => (hBes ν hν).2
      _ = ∫ ξ in torusCube n, (∑ ν ∈ F, ‖D ν ξ‖ ^ 2) * ‖latFT f ξ‖ ^ 2 := by
          rw [← integral_finsetSum _ hint]
          congr 1; funext ξ; rw [Finset.sum_mul]
      _ ≤ ∫ ξ in torusCube n, B ^ 2 * ‖latFT f ξ‖ ^ 2 := by
          refine integral_mono_of_nonneg (Filter.Eventually.of_forall fun ξ => by positivity)
            hintR (Filter.Eventually.of_forall fun ξ => ?_)
          exact mul_le_mul_of_nonneg_right (sum_norm_sq_liftD_le hs F m hB ξ) (by positivity)
      _ = B ^ 2 * ∑' x, ‖f x‖ ^ 2 := by rw [integral_const_mul, integral_norm_sq_latFT hf]
  have key : eLpNorm (fun x => Real.sqrt (∑ ν ∈ F, ‖latMult (D ν) f x‖ ^ 2)) 2
      Measure.count ^ 2 ≤ 1 * (ENNReal.ofReal B * eLpNorm f 2 Measure.count) ^ 2 := by
    rw [eLpNorm_sqrt_sum_sq_two_sq F _ fun ν hν => (hBes ν hν).1, one_mul, mul_pow,
      arith_eLpNorm_two_sq_eq_tsum]
    have e : ∑' x, ‖f x‖ₑ ^ 2 = ENNReal.ofReal (∑' x, ‖f x‖ ^ 2) := by
      rw [ENNReal.ofReal_tsum_of_nonneg (fun _ => by positivity)
        (summable_norm_sq_of_summable hf)]
      refine tsum_congr fun x => ?_
      rw [ENNReal.ofReal_pow (norm_nonneg _), ofReal_norm]
    rw [e, ← ENNReal.ofReal_pow hB0, ← ENNReal.ofReal_mul (by positivity)]
    exact ENNReal.ofReal_le_ofReal hreal
  have := band_le_of_sq_le key
  rwa [ENNReal.one_rpow, one_mul] at this

/-- The bounded inputs `D_s[m](D) f` (`|D_s[m](D) f| ≤ ‖D_s[m]‖_{L¹(𝕋ⁿ)} ‖f‖_{ℓ¹}`) of a finite
family, with a common bound. -/
lemma exists_bound_latMult_liftD {s : ℕ} {ι : Type*} (F : Finset ι)
    {m : ι → EuclideanSpace ℝ (Fin n) → ℂ} (hm : ∀ ν ∈ F, AEStronglyMeasurable (m ν) volume)
    {B : ℝ} (hmB : ∀ ν ∈ F, ∀ η, ‖m ν η‖ ≤ B) {f : (Fin n → ℤ) → ℂ}
    (hf : Summable fun z => ‖f z‖) :
    ∃ M : ℝ, ∀ ν ∈ F, ∀ x, ‖latMult (liftD n d Ω p s (m ν)) f x‖ ≤ M := by
  refine ⟨∑ ν ∈ F, (∫ η in torusCube n, ‖liftD n d Ω p s (m ν) η‖) * ∑' z, ‖f z‖,
    fun ν hν x => ?_⟩
  refine (norm_latMult_le (integrableOn_liftD (hm ν hν) (hmB ν hν)) hf x).trans ?_
  exact Finset.single_le_sum (f := fun ν => (∫ η in torusCube n,
    ‖liftD n d Ω p s (m ν) η‖) * ∑' z, ‖f z‖)
    (fun _ _ => mul_nonneg (integral_nonneg fun _ => norm_nonneg _)
      (tsum_nonneg fun _ => norm_nonneg _)) hν

open scoped NNReal ENNReal in
/-- The lifted square function equals the arithmetic square function of the inputs
`D_s[m_ν](D) f` (factorization (9.8), operator form). -/
lemma lift_sqrt_sum_eq {s : ℕ} (hs : 1 ≤ s) {ι : Type*} (F : Finset ι)
    {m : ι → EuclideanSpace ℝ (Fin n) → ℂ} (hm : ∀ ν ∈ F, AEStronglyMeasurable (m ν) volume)
    {B : ℝ} (hmB : ∀ ν ∈ F, ∀ η, ‖m ν η‖ ≤ B) {f : (Fin n → ℤ) → ℂ}
    (hf : Summable fun z => ‖f z‖) :
    (fun x => Real.sqrt (∑ ν ∈ F,
      ((((liftRat s).sup fun aq =>
        ‖latMult (liftSym n d Ω p s aq.1 aq.2 (m ν)) f x‖₊ : ℝ≥0) : ℝ) ^ 2))) =
      fun x => Real.sqrt (∑ ν ∈ F,
      ((((liftRat s).sup fun aq =>
        ‖∑' y, latKernel (liftA n d Ω p s aq.1 aq.2) y *
          latMult (liftD n d Ω p s (m ν)) f (x - y)‖₊ : ℝ≥0) : ℝ) ^ 2)) := by
  funext x
  congr 1
  refine Finset.sum_congr rfl fun ν hν => ?_
  refine congrArg (fun t : ℝ≥0 => (t : ℝ) ^ 2) (Finset.sup_congr rfl fun aq haq => ?_)
  rw [latMult_liftSym_eq_tsum hs (a := aq.1) (q := aq.2) (by simpa using haq) (hm ν hν)
    (hmB ν hν) hf x]

open scoped NNReal ENNReal in
/-- **Blueprint Lemma 9.3 (`lem:liftsquare`), eq. (9.9) (`eq:liftL2square`)**, the `ℓ²` lifted
square estimate: for `n, d ≥ 1` there are `γ > 0` and `C` (independent of `Ω, p`, of `s`, of the
family and of `f`) such that for every `s ≥ 1`, every finite family `(m_ν)_{ν ∈ F}` of
a.e. strongly measurable symbols with `∑_ν |m_ν(η)|² ≤ B²` for all `η` (`B ≥ 0`; i.e.
`B ≥ (sup_η ∑_ν |m_ν(η)|²)^{1/2}`), and every `f ∈ ℓ¹(ℤⁿ)` (e.g. finitely supported),
`‖(∑_ν sup_{α ∈ 𝓡_s} |Lift_{s,α}[m_ν](D) f|²)^{1/2}‖₂ ≤ C 2^{-γ s} B ‖f‖₂`. -/
theorem lift_square_two (n d : ℕ) (hn : 1 ≤ n) (hd : 1 ≤ d) :
    ∃ γ : ℝ, 0 < γ ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ),
      1 ≤ s → ∀ {ι : Type*} (F : Finset ι) (m : ι → EuclideanSpace ℝ (Fin n) → ℂ) (B : ℝ),
        (∀ ν ∈ F, AEStronglyMeasurable (m ν) volume) → 0 ≤ B →
        (∀ η, ∑ ν ∈ F, ‖m ν η‖ ^ 2 ≤ B ^ 2) →
        ∀ f : (Fin n → ℤ) → ℂ, Summable (fun z => ‖f z‖) →
          eLpNorm (fun x => Real.sqrt (∑ ν ∈ F,
              ((((liftRat s).sup fun aq =>
                ‖latMult (liftSym n d Ω p s aq.1 aq.2 (m ν)) f x‖₊ : ℝ≥0) : ℝ) ^ 2)))
              2 Measure.count ≤
            ENNReal.ofReal (C * (2 : ℝ) ^ (-(γ * s)) * B) * eLpNorm f 2 Measure.count := by
  obtain ⟨γ, hγ, C, hC, h⟩ := arith_maximal_decay_vector_bdd n d hn hd (t := 2) one_lt_two
  refine ⟨γ, hγ, C, hC, fun Ω p s hs ι F m B hm hB0 hB f hf => ?_⟩
  have hmB : ∀ ν ∈ F, ∀ η, ‖m ν η‖ ≤ B := fun ν hν η => lift_norm_le_of_sum_sq_le hB0 (hB η) hν
  obtain ⟨M, hM⟩ := exists_bound_latMult_liftD (d := d) (Ω := Ω) (p := p) (s := s) F hm hmB hf
  have h1 := h Ω p s hs F (fun ν => latMult (liftD n d Ω p s (m ν)) f) M hM
  rw [show ENNReal.ofReal 2 = 2 by norm_num] at h1
  rw [lift_sqrt_sum_eq hs F hm hmB hf]
  refine h1.trans ((mul_le_mul' le_rfl (eLpNorm_sqrt_sum_liftD_two_le hs F m hm hB0 hB hf)).trans
    (le_of_eq ?_))
  rw [ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ C * (2 : ℝ) ^ (-(γ * s))), mul_assoc]


/-! #### The `ℓ^p` square estimate (9.10) -/

lemma hasCompactSupport_liftChiT (s : ℕ) :
    HasCompactSupport fun ξ : EuclideanSpace ℝ (Fin n) => (liftChiT n d Ω p s ξ : ℂ) :=
  HasCompactSupport.intro (isCompact_box (2 / (liftL n d Ω p s : ℝ))) fun ξ hξ => by
    by_contra h
    exact hξ (support_liftChiT s (fun h0 => h (by simp [h0])))

/-- `χ̃_s` as a (complex-valued) Schwartz function. -/
noncomputable def liftChiTSchwartz (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ)
    (s : ℕ) : 𝓢(EuclideanSpace ℝ (Fin n), ℂ) :=
  (hasCompactSupport_liftChiT (n := n) (d := d) (Ω := Ω) (p := p) s).toSchwartzMap
    (Complex.ofRealCLM.contDiff.comp
      (contDiff_companionCutoff.comp (contDiff_const_smul (liftL n d Ω p s : ℝ))))

@[simp] lemma liftChiTSchwartz_apply (s : ℕ) (ξ : EuclideanSpace ℝ (Fin n)) :
    liftChiTSchwartz n d Ω p s ξ = (liftChiT n d Ω p s ξ : ℂ) := rfl

/-- The companion cutoff `χ̃ = θ` as a Schwartz function. -/
noncomputable def companionSchwartz (n : ℕ) : 𝓢(EuclideanSpace ℝ (Fin n), ℂ) :=
  (HasCompactSupport.intro (isCompact_box (2 : ℝ)) fun ξ hξ => by
      by_contra h
      exact hξ (support_companionCutoff (n := n) (fun h0 => h (by simp [h0])))
    : HasCompactSupport fun ξ : EuclideanSpace ℝ (Fin n) => (companionCutoff n ξ : ℂ)).toSchwartzMap
    (Complex.ofRealCLM.contDiff.comp contDiff_companionCutoff)

/-- Uniform envelope bound for the kernels of `χ̃_s`: `|𝓕⁻ χ̃_s| ≤ C B_{L_s}` with `C`
depending only on `n`. -/
lemma exists_norm_fourierInv_liftChiT_le (n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ)
      (x : EuclideanSpace ℝ (Fin n)),
      ‖𝓕⁻ (fun ξ => (liftChiT n d Ω p s ξ : ℂ)) x‖ ≤ C * envelope n (liftL n d Ω p s) x := by
  obtain ⟨K, hK, hKb⟩ := exists_norm_le_envelope (𝓕⁻ (companionSchwartz n))
  refine ⟨K, hK, fun d Ω p s x => ?_⟩
  set L : ℝ := (liftL n d Ω p s : ℝ)
  have hL : 0 < L := liftL_pos s
  have hL' : 0 < L⁻¹ := inv_pos.2 hL
  have hfun : (fun ξ : EuclideanSpace ℝ (Fin n) => (liftChiT n d Ω p s ξ : ℂ)) =
      fun ξ => companionSchwartz n ((L⁻¹)⁻¹ • ξ) := by
    funext ξ; rw [inv_inv]; rfl
  rw [hfun, fourierInv_comp_inv_smul _ hL', ← SchwartzMap.fourierInv_coe, norm_mul,
    Complex.norm_real, Real.norm_of_nonneg (by positivity)]
  have hb := hKb (L⁻¹ • x)
  have he : envelope n 1 (L⁻¹ • x) = ((1 + ‖x‖ / L) ^ (n + 1))⁻¹ := by
    rw [envelope, norm_smul, Real.norm_of_nonneg hL'.le]
    simp [div_eq_inv_mul]
  rw [he] at hb
  calc (L⁻¹) ^ n * ‖(𝓕⁻ (companionSchwartz n)) (L⁻¹ • x)‖
      ≤ (L⁻¹) ^ n * (K * ((1 + ‖x‖ / L) ^ (n + 1))⁻¹) :=
        mul_le_mul_of_nonneg_left hb (by positivity)
    _ = K * envelope n L x := by rw [envelope, inv_pow]; ring

/-- Uniform `L¹` bound for the kernels of `χ̃_s`: `‖𝓕⁻ χ̃_s‖_{L¹} ≤ K` with `K` depending only
on `n`. -/
lemma exists_eLpNorm_fourierInv_liftChiT_le (n : ℕ) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ (d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ),
      eLpNorm (𝓕⁻ (fun ξ => (liftChiT n d Ω p s ξ : ℂ))) 1 volume ≤ ENNReal.ofReal K := by
  obtain ⟨C, hC, h⟩ := exists_norm_fourierInv_liftChiT_le n
  have hE : 0 ≤ envelopeConst n := by unfold envelopeConst; positivity
  refine ⟨C * envelopeConst n, by positivity, fun d Ω p s => ?_⟩
  have hL := liftL_pos (n := n) (d := d) (Ω := Ω) (p := p) s
  obtain ⟨hi, hI⟩ := integrable_envelope_and_integral_le (n := n) hL
  have hmeas : AEStronglyMeasurable (𝓕⁻ (fun ξ => (liftChiT n d Ω p s ξ : ℂ))) volume := by
    have e : (fun ξ => (liftChiT n d Ω p s ξ : ℂ)) = ⇑(liftChiTSchwartz n d Ω p s) := rfl
    rw [e, ← SchwartzMap.fourierInv_coe]
    exact (𝓕⁻ (liftChiTSchwartz n d Ω p s)).continuous.aestronglyMeasurable
  refine (eLpNorm_mono_real (g := fun x => C * envelope n (liftL n d Ω p s) x) hmeas
      (h d Ω p s)).trans ?_
  rw [eLpNorm_one_eq_lintegral_enorm (hi.const_mul C).aestronglyMeasurable]
  rw [← ofReal_integral_norm_eq_lintegral_enorm (hi.const_mul C)]
  refine ENNReal.ofReal_le_ofReal ?_
  calc ∫ x, ‖C * envelope n (liftL n d Ω p s) x‖
      = ∫ x, C * envelope n (liftL n d Ω p s) x := by
        congr 1; funext x
        rw [Real.norm_of_nonneg (mul_nonneg hC (envelope_nonneg hL x))]
    _ ≤ C * envelopeConst n := by
        rw [integral_const_mul]; exact mul_le_mul_of_nonneg_left hI hC


open scoped Convolution ENNReal in
/-- Young for the cutoff: if `M` has Euclidean `L^P` multiplier norm `≤ A` on Schwartz inputs
(`1 ≤ P`), then so does `M χ̃_s`, with norm `≤ A K`, where `‖𝓕⁻ χ̃_s‖_{L¹} ≤ K`. -/
lemma eLpNorm_fourierInv_mul_liftChiT_le {s : ℕ} {K : ℝ}
    (hK : eLpNorm (𝓕⁻ (fun ξ => (liftChiT n d Ω p s ξ : ℂ))) 1 volume ≤ ENNReal.ofReal K)
    (hK0 : 0 ≤ K) {P : ℝ≥0∞} (hP : 1 ≤ P) {M : EuclideanSpace ℝ (Fin n) → ℂ} {A : ℝ}
    (hA : ∀ F : 𝓢(EuclideanSpace ℝ (Fin n), ℂ),
      eLpNorm (𝓕⁻ (fun ξ => M ξ * 𝓕 (F : EuclideanSpace ℝ (Fin n) → ℂ) ξ)) P volume ≤
        ENNReal.ofReal A * eLpNorm F P volume)
    (F : 𝓢(EuclideanSpace ℝ (Fin n), ℂ)) :
    eLpNorm (𝓕⁻ (fun ξ => (M ξ * (liftChiT n d Ω p s ξ : ℂ)) *
        𝓕 (F : EuclideanSpace ℝ (Fin n) → ℂ) ξ)) P volume ≤
      ENNReal.ofReal (A * K) * eLpNorm F P volume := by
  set φ : 𝓢(EuclideanSpace ℝ (Fin n), ℂ) := 𝓕⁻ (liftChiTSchwartz n d Ω p s) with hφ
  set G := SchwartzMap.convolution (ContinuousLinearMap.mul ℂ ℂ) φ F with hG
  have hGF : ∀ ξ, 𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ =
      (liftChiT n d Ω p s ξ : ℂ) * 𝓕 (F : EuclideanSpace ℝ (Fin n) → ℂ) ξ := by
    intro ξ
    have h := congrArg (fun H : 𝓢(EuclideanSpace ℝ (Fin n), ℂ) => H ξ)
      (SchwartzMap.fourier_convolution (ContinuousLinearMap.mul ℂ ℂ) φ F)
    simp only [SchwartzMap.pairing_apply_apply, hφ, FourierTransform.fourier_fourierInv_eq,
      ContinuousLinearMap.mul_apply', liftChiTSchwartz_apply] at h
    rw [← SchwartzMap.fourier_coe, h, SchwartzMap.fourier_coe]
  have e : (fun ξ => (M ξ * (liftChiT n d Ω p s ξ : ℂ)) *
      𝓕 (F : EuclideanSpace ℝ (Fin n) → ℂ) ξ) =
      fun ξ => M ξ * 𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ := by
    funext ξ; rw [hGF, mul_assoc]
  rw [e]
  refine (hA G).trans ?_
  have hGc : (G : EuclideanSpace ℝ (Fin n) → ℂ) =
      (φ : EuclideanSpace ℝ (Fin n) → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ, volume]
        (F : EuclideanSpace ℝ (Fin n) → ℂ) :=
    funext fun x => SchwartzMap.convolution_apply _ φ F x
  have hY := (young_convolution_euclidean hP (φ.memLp 1) (F.memLp P)).2.1
  have hφK : eLpNorm (φ : EuclideanSpace ℝ (Fin n) → ℂ) 1 volume ≤ ENNReal.ofReal K := by
    rw [hφ, SchwartzMap.fourierInv_coe]; exact hK
  rw [hGc, ENNReal.ofReal_mul' hK0, mul_assoc]
  gcongr
  exact hY.trans (by gcongr)

open scoped ENNReal in
/-- Lower Khintchine inequality for `L^p` norms (Blueprint Lemma 2.6): if every signed sum
`∑_ν ±g_ν` has `L^p` norm `≤ K` (`0 < p`), then `‖(∑_ν |g_ν|²)^{1/2}‖_p ≤ c_p⁻¹ K`. -/
lemma eLpNorm_sqrt_sum_le_of_rademacher {α : Type*} [MeasurableSpace α] {μ : Measure α}
    {ι : Type*} [DecidableEq ι] (F : Finset ι) (g : ι → α → ℂ)
    (hg : ∀ ν ∈ F, AEStronglyMeasurable (g ν) μ) {p : ℝ} (hp : 0 < p) {K : ℝ≥0∞}
    (h : ∀ u ∈ F.powerset, eLpNorm (fun x => rademacherSum F u (fun ν => g ν x))
      (ENNReal.ofReal p) μ ≤ K) :
    eLpNorm (fun x => Real.sqrt (∑ ν ∈ F, ‖g ν x‖ ^ 2)) (ENNReal.ofReal p) μ ≤
      ENNReal.ofReal (khintchineLowerConst p)⁻¹ * K := by
  set P := ENNReal.ofReal p
  have hP0 : P ≠ 0 := (ENNReal.ofReal_pos.mpr hp).ne'
  have hPtop : P ≠ ⊤ := ENNReal.ofReal_ne_top
  have hPr : P.toReal = p := ENNReal.toReal_ofReal hp.le
  have hc := khintchineLowerConst_pos p
  set c := khintchineLowerConst p
  set S := fun x => Real.sqrt (∑ ν ∈ F, ‖g ν x‖ ^ 2)
  have hSm : AEStronglyMeasurable S μ := aestronglyMeasurable_sqrt_sum_norm_sq F g hg
  have hRm : ∀ u, AEStronglyMeasurable (fun x => rademacherSum F u (fun ν => g ν x)) μ :=
    fun u => aestronglyMeasurable_rademacherSum F u g hg
  have hR : ∀ u ∈ F.powerset, ∫⁻ x, ‖rademacherSum F u (fun ν => g ν x)‖ₑ ^ p ∂μ ≤ K ^ p := by
    intro u hu
    have h1 := h u hu
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hP0 hPtop (hRm u), hPr] at h1
    have h2 := ENNReal.rpow_le_rpow h1 hp.le
    rwa [one_div, ENNReal.rpow_inv_rpow hp.ne'] at h2
  set N : ℝ≥0∞ := (2 ^ F.card : ℝ≥0∞)⁻¹
  have hcS : ∫⁻ x, (ENNReal.ofReal c * ‖S x‖ₑ) ^ p ∂μ ≤ K ^ p := by
    calc ∫⁻ x, (ENNReal.ofReal c * ‖S x‖ₑ) ^ p ∂μ
        ≤ ∫⁻ x, N * ∑ u ∈ F.powerset, ‖rademacherSum F u (fun ν => g ν x)‖ₑ ^ p ∂μ :=
          lintegral_mono fun x => khintchine_lower_enorm ℂ F (fun ν => g ν x) hp
      _ = N * ∑ u ∈ F.powerset, ∫⁻ x, ‖rademacherSum F u (fun ν => g ν x)‖ₑ ^ p ∂μ := by
          rw [lintegral_const_mul' _ _ (ENNReal.inv_ne_top.mpr (by positivity)),
            lintegral_finsetSum']
          intro u _
          exact (hRm u).enorm.pow_const p
      _ ≤ N * ∑ u ∈ F.powerset, K ^ p := by gcongr with u hu; exact hR u hu
      _ = K ^ p := by
          rw [Finset.sum_const, Finset.card_powerset, nsmul_eq_mul, ← mul_assoc]
          rw [show ((2 ^ F.card : ℕ) : ℝ≥0∞) = (2 : ℝ≥0∞) ^ F.card by push_cast; rfl]
          rw [ENNReal.inv_mul_cancel (by positivity) (by simp), one_mul]
  have hcS' : ENNReal.ofReal c * eLpNorm S P μ ≤ K := by
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hP0 hPtop hSm, hPr]
    have e : ENNReal.ofReal c = (ENNReal.ofReal c ^ p) ^ (1 / p) := by
      rw [one_div, ENNReal.rpow_rpow_inv hp.ne']
    rw [e, ← ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← lintegral_const_mul' _ _
      (ENNReal.rpow_ne_top_of_nonneg hp.le ENNReal.ofReal_ne_top)]
    have e2 : ∀ x, ENNReal.ofReal c ^ p * ‖S x‖ₑ ^ p = (ENNReal.ofReal c * ‖S x‖ₑ) ^ p :=
      fun x => (ENNReal.mul_rpow_of_nonneg _ _ hp.le).symm
    simp_rw [e2]
    calc (∫⁻ x, (ENNReal.ofReal c * ‖S x‖ₑ) ^ p ∂μ) ^ (1 / p) ≤ (K ^ p) ^ (1 / p) :=
          ENNReal.rpow_le_rpow hcS (by positivity)
      _ = K := by rw [one_div, ENNReal.rpow_rpow_inv hp.ne']
  have hc0 : ENNReal.ofReal c ≠ 0 := (ENNReal.ofReal_pos.mpr hc).ne'
  calc eLpNorm S P μ = (ENNReal.ofReal c)⁻¹ * (ENNReal.ofReal c * eLpNorm S P μ) := by
        rw [← mul_assoc, ENNReal.inv_mul_cancel hc0 ENNReal.ofReal_ne_top, one_mul]
    _ ≤ (ENNReal.ofReal c)⁻¹ * K := by gcongr
    _ = ENNReal.ofReal c⁻¹ * K := by rw [ENNReal.ofReal_inv_of_pos hc]

/-- `D_s` is linear in the symbol: `D_s[∑_ν c_ν m_ν] = ∑_ν c_ν D_s[m_ν]` (`s ≥ 1`). -/
lemma liftD_sum_smul {s : ℕ} (hs : 1 ≤ s) {ι : Type*} (F : Finset ι) (c : ι → ℂ)
    (m : ι → EuclideanSpace ℝ (Fin n) → ℂ) (ξ : EuclideanSpace ℝ (Fin n)) :
    liftD n d Ω p s (fun η => ∑ ν ∈ F, c ν * m ν η) ξ =
      ∑ ν ∈ F, c ν * liftD n d Ω p s (m ν) ξ := by
  have hgT : ∀ (M : EuclideanSpace ℝ (Fin n) → ℂ) η, M η * (liftChiT n d Ω p s η : ℂ) ≠ 0 →
      liftChiT n d Ω p s η ≠ 0 :=
    fun M η h h0 => h (by rw [h0, Complex.ofReal_zero, mul_zero])
  by_cases hact : ∃ β ∈ paramGoodSet n d Ω p (liftN s), ∃ z : Fin n → ℤ, liftChiT n d Ω p s
      (ξ - ratPt (blockProd (goodBlocks (paramRho n d Ω p) (liftN s))) β - latEmbed z) ≠ 0
  · obtain ⟨β, hβ, z, hz⟩ := hact
    simp only [liftD]
    rw [cosetSymbol_eq_of_liftChiT hs (hgT _) hβ hz, Finset.sum_mul]
    refine Finset.sum_congr rfl fun ν _ => ?_
    rw [cosetSymbol_eq_of_liftChiT hs (hgT _) hβ hz, mul_assoc]
  · push Not at hact
    simp only [liftD]
    rw [cosetSymbol_eq_zero_of_liftChiT (hgT _) hact]
    refine (Finset.sum_eq_zero fun ν _ => ?_).symm
    rw [cosetSymbol_eq_zero_of_liftChiT (hgT _) hact, mul_zero]

open scoped NNReal ENNReal in
/-- **Blueprint Lemma 9.3 (`lem:liftsquare`), eq. (9.10) (`eq:liftLpsquare`)**, the `ℓ^p` lifted
square estimate at the fixed exponent `p > 1` (with `r = paramR p`): for `n, d ≥ 1` there are
`δ_p > 0` and `C_p` (independent of `s`, of the family, of `A` and of `f`) such that for every
`s ≥ 1`, every finite family `(m_ν)_{ν ∈ F}` of bounded a.e. strongly measurable symbols such that
every signed sum `∑_ν ε_ν m_ν` (`ε_ν ∈ {-1, 1}`) has Euclidean `L^{2r}` multiplier norm at most
`A ≥ 0` (on Schwartz inputs), and every finitely supported `f`,
`‖(∑_ν sup_{α ∈ 𝓡_s} |Lift_{s,α}[m_ν](D) f|²)^{1/2}‖_p ≤ C_p 2^{-δ_p s} A ‖f‖_p`. -/
theorem lift_square_p (n d : ℕ) (hn : 1 ≤ n) (hd : 1 ≤ d) (Ω : EuclideanSpace ℝ (Fin n) → ℂ)
    {p : ℝ} (hp : 1 < p) :
    ∃ δ : ℝ, 0 < δ ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ s : ℕ, 1 ≤ s →
      ∀ {ι : Type*} (F : Finset ι) (m : ι → EuclideanSpace ℝ (Fin n) → ℂ) (B A : ℝ),
        (∀ ν ∈ F, AEStronglyMeasurable (m ν) volume) → (∀ ν ∈ F, ∀ η, ‖m ν η‖ ≤ B) →
        0 ≤ A →
        (∀ ε : ι → ℝ, (∀ ν ∈ F, ε ν = 1 ∨ ε ν = -1) →
          ∀ G : 𝓢(EuclideanSpace ℝ (Fin n), ℂ),
            eLpNorm (𝓕⁻ (fun ξ => (∑ ν ∈ F, (ε ν : ℂ) * m ν ξ) *
                𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ))
              (ENNReal.ofReal (2 * paramR p)) volume ≤
            ENNReal.ofReal A * eLpNorm G (ENNReal.ofReal (2 * paramR p)) volume) →
        ∀ f : (Fin n → ℤ) → ℂ, (Function.support f).Finite →
          eLpNorm (fun x => Real.sqrt (∑ ν ∈ F,
              ((((liftRat s).sup fun aq =>
                ‖latMult (liftSym n d Ω p s aq.1 aq.2 (m ν)) f x‖₊ : ℝ≥0) : ℝ) ^ 2)))
              (ENNReal.ofReal p) Measure.count ≤
            ENNReal.ofReal (C * (2 : ℝ) ^ (-(δ * s)) * A) *
              eLpNorm f (ENNReal.ofReal p) Measure.count := by
  obtain ⟨δ, hδ, Cv, hCv, hv⟩ := arith_maximal_decay_vector_bdd n d hn hd hp
  obtain ⟨CT, hCT, hT⟩ := lift_transference n d Ω hp
  obtain ⟨K, hK0, hKb⟩ := exists_eLpNorm_fourierInv_liftChiT_le n
  have hc := khintchineLowerConst_pos p
  set c := khintchineLowerConst p
  refine ⟨δ, hδ, Cv * (c⁻¹ * (CT * K)), by positivity,
    fun s hs ι F m B A hm hmB hA0 hA f hf => ?_⟩
  classical
  have hf1 : Summable fun z => ‖f z‖ := summable_of_finite_support hf
  obtain ⟨M, hM⟩ := exists_bound_latMult_liftD (d := d) (Ω := Ω) (p := p) (s := s) F hm hmB hf1
  set g : ι → (Fin n → ℤ) → ℂ := fun ν => latMult (liftD n d Ω p s (m ν)) f with hg
  rw [lift_sqrt_sum_eq hs F hm hmB hf1]
  refine (hv Ω p s hs F g M hM).trans ?_
  have hP : (1 : ℝ≥0∞) ≤ ENNReal.ofReal (2 * paramR p) := by
    rw [← ENNReal.ofReal_one]
    refine ENNReal.ofReal_le_ofReal ?_
    have := one_le_paramR p
    have : (1 : ℝ) ≤ paramR p := by exact_mod_cast this
    linarith
  have hsq : eLpNorm (fun x => Real.sqrt (∑ ν ∈ F, ‖g ν x‖ ^ 2)) (ENNReal.ofReal p)
      Measure.count ≤ ENNReal.ofReal c⁻¹ *
        (ENNReal.ofReal (CT * (A * K)) * eLpNorm f (ENNReal.ofReal p) Measure.count) := by
    refine eLpNorm_sqrt_sum_le_of_rademacher F g (fun _ _ => AEStronglyMeasurable.of_discrete)
      (by linarith) fun u _ => ?_
    set ε : ι → ℝ := fun ν => if ν ∈ u then 1 else -1 with hε
    set Mu : EuclideanSpace ℝ (Fin n) → ℂ := fun η => ∑ ν ∈ F, (ε ν : ℂ) * m ν η with hMu
    have hmi : ∀ ν ∈ F, IntegrableOn (liftD n d Ω p s (m ν)) (torusCube n) :=
      fun ν hν => integrableOn_liftD (hm ν hν) (hmB ν hν)
    have e : (fun x => rademacherSum F u (fun ν => g ν x)) =
        cosetMult (blockProd (goodBlocks (paramRho n d Ω p) (liftN s)))
          (fun η => Mu η * (liftChiT n d Ω p s η : ℂ)) (paramGoodSet n d Ω p (liftN s)) f := by
      funext x
      have h1 : rademacherSum F u (fun ν => g ν x) = ∑ ν ∈ F, (ε ν : ℂ) * g ν x := by
        unfold rademacherSum
        refine Finset.sum_congr rfl fun ν _ => ?_
        by_cases h : ν ∈ u <;> simp [hε, h]
      rw [h1, cosetMult]
      have h2 := latMult_sum_mul F (fun ν => (ε ν : ℂ)) hmi hf1 x
      rw [← h2]
      congr 1
      funext ξ
      exact (liftD_sum_smul hs F (fun ν => (ε ν : ℂ)) m ξ).symm
    rw [e]
    have hMum : AEStronglyMeasurable (fun η => Mu η * (liftChiT n d Ω p s η : ℂ)) volume :=
      (Finset.aestronglyMeasurable_fun_sum F fun ν hν =>
        (hm ν hν).const_mul _).mul (continuous_liftChiT s).aestronglyMeasurable
    have hMuB : ∀ ξ, ‖Mu ξ * (liftChiT n d Ω p s ξ : ℂ)‖ ≤ F.card * B := by
      intro ξ
      rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (liftChiT_nonneg s ξ)]
      refine (mul_le_of_le_one_right (norm_nonneg _) (liftChiT_le_one s ξ)).trans ?_
      refine (norm_sum_le _ _).trans ?_
      rw [← nsmul_eq_mul, ← Finset.sum_const]
      refine Finset.sum_le_sum fun ν hν => ?_
      rw [norm_mul]
      have : ‖(ε ν : ℂ)‖ = 1 := by by_cases h : ν ∈ u <;> simp [hε, h]
      rw [this, one_mul]; exact hmB ν hν ξ
    have hsupp : Function.support (fun η => Mu η * (liftChiT n d Ω p s η : ℂ)) ⊆
        {ξ | ∀ i, |ξ i| ≤ 2 / (liftL n d Ω p s : ℝ)} := fun ξ hξ =>
      support_liftChiT s fun h0 => hξ (by simp [h0])
    have hmult := fun G => eLpNorm_fourierInv_mul_liftChiT_le (hKb d Ω p s) hK0 hP
      (hA ε fun ν _ => by by_cases h : ν ∈ u <;> simp [hε, h]) G
    exact hT s hs _ _ _ hMum hMuB hsupp hmult f hf
  calc ENNReal.ofReal (Cv * (2 : ℝ) ^ (-(δ * s))) *
        eLpNorm (fun x => Real.sqrt (∑ ν ∈ F, ‖g ν x‖ ^ 2)) (ENNReal.ofReal p) Measure.count
      ≤ ENNReal.ofReal (Cv * (2 : ℝ) ^ (-(δ * s))) * (ENNReal.ofReal c⁻¹ *
        (ENNReal.ofReal (CT * (A * K)) * eLpNorm f (ENNReal.ofReal p) Measure.count)) := by
        gcongr
    _ = _ := by
        rw [← mul_assoc, ← mul_assoc, ← ENNReal.ofReal_mul (by positivity),
          ← ENNReal.ofReal_mul (by positivity)]
        congr 2
        ring


/-! ### Blueprint Lemma 9.4 (`lem:liftenvelope`): positive envelopes for lifted kernels -/

lemma hasCompactSupport_liftChi (s : ℕ) :
    HasCompactSupport fun ξ : EuclideanSpace ℝ (Fin n) => (liftChi n d Ω p s ξ : ℂ) :=
  HasCompactSupport.intro (isCompact_box (1 / (liftL n d Ω p s : ℝ))) fun ξ hξ => by
    by_contra h
    exact hξ (support_liftChi s (fun h0 => h (by simp [h0])))

/-- `χ_s` as a (complex-valued) Schwartz function. -/
noncomputable def liftChiSchwartz (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ)
    (s : ℕ) : 𝓢(EuclideanSpace ℝ (Fin n), ℂ) :=
  (hasCompactSupport_liftChi (n := n) (d := d) (Ω := Ω) (p := p) s).toSchwartzMap
    (Complex.ofRealCLM.contDiff.comp
      (contDiff_liftCutoff.comp (contDiff_const_smul (liftL n d Ω p s : ℝ))))

@[simp] lemma liftChiSchwartz_apply (s : ℕ) (ξ : EuclideanSpace ℝ (Fin n)) :
    liftChiSchwartz n d Ω p s ξ = (liftChi n d Ω p s ξ : ℂ) := rfl

/-- `𝓕 H` is continuous and bounded by `‖H‖_{L¹}` for integrable `H`. -/
lemma continuous_fourier_and_norm_le {H : EuclideanSpace ℝ (Fin n) → ℂ} (hH : Integrable H) :
    Continuous (𝓕 H) ∧ ∀ ξ, ‖𝓕 H ξ‖ ≤ ∫ x, ‖H x‖ := by
  refine ⟨VectorFourier.fourierIntegral_continuous Real.continuous_fourierChar continuous_inner hH,
    fun ξ => ?_⟩
  rw [fourier_eq_integral_eC]
  refine (norm_integral_le_integral_norm _).trans (le_of_eq ?_)
  congr 1; funext x; rw [norm_mul, norm_eC, one_mul]

open scoped Convolution in
/-- The Euclidean kernel of `𝓕H · χ_s` is `H * φ_s` (`H` integrable). -/
lemma fourierInv_fourier_mul_liftChi {H : EuclideanSpace ℝ (Fin n) → ℂ} (hH : Integrable H)
    (s : ℕ) :
    𝓕⁻ (fun ξ => 𝓕 H ξ * (liftChi n d Ω p s ξ : ℂ)) =
      H ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] liftPhi n d Ω p s := by
  set f : 𝓢(EuclideanSpace ℝ (Fin n), ℂ) := 𝓕⁻ (liftChiSchwartz n d Ω p s) with hf
  have hff : 𝓕 (f : EuclideanSpace ℝ (Fin n) → ℂ) = fun ξ => (liftChi n d Ω p s ξ : ℂ) := by
    rw [← SchwartzMap.fourier_coe, hf, FourierTransform.fourier_fourierInv_eq]; rfl
  have hfφ : (f : EuclideanSpace ℝ (Fin n) → ℂ) = liftPhi n d Ω p s := by
    rw [hf, SchwartzMap.fourierInv_coe]; rfl
  have h := fourierInv_fourier_mul_eq_convolution hH (continuous_fourier_and_norm_le hH).2 f
  rw [hff, hfφ] at h
  exact h

open scoped Convolution in
/-- Envelope bound for the kernel: if `|H| ≤ K B_R` (`R > 0`), then
`|H * φ_s| ≤ C K B_{max(R, L_s)}` with `C` depending only on `n`. -/
lemma exists_norm_convolution_liftPhi_le (n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ)
      (H : EuclideanSpace ℝ (Fin n) → ℂ) (K R : ℝ), 0 < R → 0 ≤ K →
      (∀ z, ‖H z‖ ≤ K * envelope n R z) → ∀ y : EuclideanSpace ℝ (Fin n),
        ‖(H ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] liftPhi n d Ω p s) y‖ ≤
          C * K * envelope n (max R (liftL n d Ω p s)) y := by
  obtain ⟨Cφ, hCφ, hφ⟩ := norm_liftPhi_le n
  have hcc : 0 ≤ envelopeConvConst n := by
    unfold envelopeConvConst envelopeConst; positivity
  refine ⟨Cφ * envelopeConvConst n, by positivity, fun d Ω p s H K R hR hK hHK y => ?_⟩
  have hL := liftL_pos (n := n) (d := d) (Ω := Ω) (p := p) s
  obtain ⟨hi, hI⟩ := envelope_conv_le (n := n) hL hR y
  rw [MeasureTheory.convolution_def]
  refine (norm_integral_le_integral_norm _).trans ?_
  calc ∫ t, ‖(ContinuousLinearMap.mul ℂ ℂ) (H t) (liftPhi n d Ω p s (y - t))‖
      ≤ ∫ t, K * Cφ * (envelope n (liftL n d Ω p s) (y - t) * envelope n R t) := by
        refine integral_mono_of_nonneg (Filter.Eventually.of_forall fun _ => norm_nonneg _)
          (hi.const_mul _) (Filter.Eventually.of_forall fun t => ?_)
        simp only [ContinuousLinearMap.mul_apply', norm_mul]
        calc ‖H t‖ * ‖liftPhi n d Ω p s (y - t)‖
            ≤ (K * envelope n R t) * (Cφ * envelope n (liftL n d Ω p s) (y - t)) :=
              mul_le_mul (hHK t) ((hφ d Ω p s).1 _) (norm_nonneg _)
                (mul_nonneg hK (envelope_nonneg hR _))
          _ = _ := by ring
    _ = K * Cφ * ∫ t, envelope n (liftL n d Ω p s) (y - t) * envelope n R t :=
        integral_const_mul _ _
    _ ≤ K * Cφ * (envelopeConvConst n * envelope n (max (liftL n d Ω p s : ℝ) R) y) :=
        mul_le_mul_of_nonneg_left hI (by positivity)
    _ = Cφ * envelopeConvConst n * K * envelope n (max R (liftL n d Ω p s)) y := by
        rw [max_comm]; ring

/-- `1 ≤ L_s`. -/
lemma one_le_liftL (s : ℕ) : (1 : ℝ) ≤ liftL n d Ω p s := by
  have := eight_le_liftL (n := n) (d := d) (Ω := Ω) (p := p) s
  linarith


/-- `B_R * |f| ≤ C_n 𝖬 f` in the form used below: for `R ≥ 1`, `f ∈ ℓ¹` and `x`,
`ofReal (∑_y B_R(y) |f(x - y)|) ≤ C_n 𝖬 f(x)`. -/
lemma ofReal_tsum_latEnvelope_mul_le {R : ℝ} (hR : 1 ≤ R) {f : (Fin n → ℤ) → ℂ}
    (hf : Summable fun z => ‖f z‖) (x : Fin n → ℤ) :
    ENNReal.ofReal (∑' y, latEnvelope n R y * ‖f (x - y)‖) ≤
      ENNReal.ofReal (envelopeConst n) * cubeMaximalInt n f x := by
  obtain ⟨hsE, -⟩ := summable_latEnvelope_and_tsum_le (n := n) hR
  have hfb : ∀ z, ‖f z‖ ≤ ∑' z, ‖f z‖ := fun z => hf.le_tsum z fun _ _ => norm_nonneg _
  have hs2 : Summable fun y => latEnvelope n R y * ‖f (x - y)‖ :=
    Summable.of_nonneg_of_le
      (fun y => mul_nonneg (envelope_nonneg (by linarith) _) (norm_nonneg _))
      (fun y => mul_le_mul_of_nonneg_left (hfb _) (envelope_nonneg (by linarith) _))
      (hsE.mul_right _)
  refine le_trans (le_of_eq ((ENNReal.ofReal_tsum_of_nonneg
    (fun y => mul_nonneg (envelope_nonneg (by linarith) _) (norm_nonneg _)) hs2).trans
      (tsum_congr fun y => ?_))) (tsum_envelope_mul_le_cubeMaximalInt hR f x)
  rw [ENNReal.ofReal_mul (envelope_nonneg (by linarith) _), ofReal_norm]
  rfl

/-- The pointwise envelope bound for lifted symbols `𝓕 H` (the proof of Blueprint Lemma 9.4
(`lem:liftenvelope`), for general kernels): there is `C` depending only on `n` such that, if `H`
is integrable with `|H| ≤ K B_R` (`K ≥ 0`, `R > 0`), then for all `s`, `a`, `q ≥ 1`, `f ∈ ℓ¹`
and `x ∈ ℤⁿ`, `|Lift_{s,a/q}[𝓕 H](D) f(x)| ≤ C K ∑_y B_{max(R, L_s)}(y) |f(x - y)|`
(the lattice kernel is `e((a/q) P(y)) (H *_E φ_s)(y)` by Lemma 9.1). -/
theorem norm_latMult_liftSym_fourier_le (n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s a q : ℕ), 1 ≤ q →
      ∀ (H : EuclideanSpace ℝ (Fin n) → ℂ) (K R : ℝ), Integrable H → 0 < R → 0 ≤ K →
      (∀ z, ‖H z‖ ≤ K * envelope n R z) →
      ∀ f : (Fin n → ℤ) → ℂ, Summable (fun z => ‖f z‖) → ∀ x : Fin n → ℤ,
        ‖latMult (liftSym n d Ω p s a q (𝓕 H)) f x‖ ≤
          C * K * ∑' y, latEnvelope n (max R (liftL n d Ω p s)) y * ‖f (x - y)‖ := by
  obtain ⟨C, hC, hconv⟩ := exists_norm_convolution_liftPhi_le n
  refine ⟨C, hC, fun d Ω p s a q hq H K R hH hR hK hHK f hf x => ?_⟩
  obtain ⟨hFc, hFb⟩ := continuous_fourier_and_norm_le hH
  set R' := max R (liftL n d Ω p s : ℝ) with hR'def
  have hR' : 1 ≤ R' := le_max_of_le_right (one_le_liftL s)
  have hint : IntegrableOn (liftSym n d Ω p s a q (𝓕 H)) (torusCube n) :=
    integrableOn_liftSym (integrable_mul_liftChi hFc.aestronglyMeasurable (fun ξ _ => hFb ξ))
  have hker : ∀ y, ‖latKernel (liftSym n d Ω p s a q (𝓕 H)) y‖ ≤
      C * K * latEnvelope n R' y := by
    intro y
    rw [latKernel_liftSym_of_bdd s a hq hFc.aestronglyMeasurable (fun ξ _ => hFb ξ) y, norm_mul,
      norm_eC, one_mul, fourierInv_fourier_mul_liftChi hH]
    exact hconv d Ω p s H K R hR hK hHK _
  obtain ⟨hsE, -⟩ := summable_latEnvelope_and_tsum_le (n := n) hR'
  have hfb : ∀ z, ‖f z‖ ≤ ∑' z, ‖f z‖ := fun z => hf.le_tsum z fun _ _ => norm_nonneg _
  have hs2 : Summable fun y => latEnvelope n R' y * ‖f (x - y)‖ :=
    Summable.of_nonneg_of_le
      (fun y => mul_nonneg (envelope_nonneg (by linarith) _) (norm_nonneg _))
      (fun y => mul_le_mul_of_nonneg_left (hfb _) (envelope_nonneg (by linarith) _))
      (hsE.mul_right _)
  have hs3 : Summable fun y => C * K * latEnvelope n R' y * ‖f (x - y)‖ :=
    (hs2.mul_left (C * K)).congr fun y => by ring
  have hs1 : Summable fun y => ‖latKernel (liftSym n d Ω p s a q (𝓕 H)) y * f (x - y)‖ :=
    Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun y => by
      rw [norm_mul]; exact mul_le_mul_of_nonneg_right (hker y) (norm_nonneg _)) hs3
  rw [latMult_eq_latConv hint hf, latConv]
  calc ‖∑' y, latKernel (liftSym n d Ω p s a q (𝓕 H)) y * f (x - y)‖
      ≤ ∑' y, ‖latKernel (liftSym n d Ω p s a q (𝓕 H)) y * f (x - y)‖ :=
        norm_tsum_le_tsum_norm hs1
    _ ≤ ∑' y, C * K * latEnvelope n R' y * ‖f (x - y)‖ :=
        hs1.tsum_le_tsum (fun y => by
          rw [norm_mul]; exact mul_le_mul_of_nonneg_right (hker y) (norm_nonneg _)) hs3
    _ = C * K * ∑' y, latEnvelope n R' y * ‖f (x - y)‖ := by
        rw [← tsum_mul_left]; exact tsum_congr fun y => by ring

/-- `|e(μ P) K_j| ≤ C B_{2^j}` uniformly in `j ∈ ℤ` and `μ ∈ ℝ` (Lemma 4.1 and the support of
`K_j` in `|x| < 2^{j+1}`). -/
lemma exists_norm_oscKernel_le {Ω : EuclideanSpace ℝ (Fin n) → ℂ} (hΩ : IsSWProfile Ω) (d : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (j : ℤ) (μ : ℝ) (x : EuclideanSpace ℝ (Fin n)),
      ‖eC (μ * radialPoly n d x) * dyadicKernel Ω j x‖ ≤
        C * envelope n ((2 : ℝ) ^ j) x := by
  obtain ⟨C, hC, hK⟩ := norm_dyadicKernel_le hΩ
  refine ⟨C * 3 ^ (n + 1), by positivity, fun j μ x => ?_⟩
  rw [norm_mul, norm_eC, one_mul]
  have h2 : (0 : ℝ) < 2 ^ j := by positivity
  by_cases hx : dyadicKernel Ω j x = 0
  · rw [hx, norm_zero]
    exact mul_nonneg (by positivity) (envelope_nonneg h2 _)
  have hsupp := (support_dyadicKernel (Ω := Ω) j hx).2
  have hlt : ‖x‖ / 2 ^ j < 2 := by
    rw [div_lt_iff₀ h2]
    calc ‖x‖ < 2 ^ (j + 1) := hsupp
      _ = 2 * 2 ^ j := by rw [zpow_add_one₀ two_ne_zero]; ring
  have hz : (2 : ℝ) ^ (-j * (n : ℤ)) = (((2 : ℝ) ^ j) ^ n)⁻¹ := by
    rw [← zpow_natCast, ← zpow_mul, neg_mul, zpow_neg]
  have h3 : ((1 + ‖x‖ / 2 ^ j) ^ (n + 1))⁻¹ ≥ ((3 : ℝ) ^ (n + 1))⁻¹ := by
    have h0 : 0 ≤ ‖x‖ / 2 ^ j := by positivity
    exact inv_anti₀ (by positivity) (pow_le_pow_left₀ (by positivity) (by linarith) _)
  calc ‖dyadicKernel Ω j x‖ ≤ C * (2 : ℝ) ^ (-j * (n : ℤ)) := hK j x
    _ = C * 3 ^ (n + 1) * ((((2 : ℝ) ^ j) ^ n)⁻¹ * ((3 : ℝ) ^ (n + 1))⁻¹) := by
        rw [hz]; field_simp
    _ ≤ C * 3 ^ (n + 1) * ((((2 : ℝ) ^ j) ^ n)⁻¹ * ((1 + ‖x‖ / 2 ^ j) ^ (n + 1))⁻¹) := by
        gcongr
    _ = C * 3 ^ (n + 1) * envelope n ((2 : ℝ) ^ j) x := rfl

/-- `e(μ P) K_j` is integrable. -/
lemma integrable_oscKernel {Ω : EuclideanSpace ℝ (Fin n) → ℂ} (hΩ : IsSWProfile Ω) (d : ℕ)
    (j : ℤ) (μ : ℝ) :
    Integrable fun x : EuclideanSpace ℝ (Fin n) =>
      eC (μ * radialPoly n d x) * dyadicKernel Ω j x := by
  have hc : Continuous fun x : EuclideanSpace ℝ (Fin n) => eC (μ * radialPoly n d x) := by
    unfold radialPoly; fun_prop
  refine Integrable.mono' (integrable_dyadicKernel hΩ j).norm
    (hc.aestronglyMeasurable.mul (integrable_dyadicKernel hΩ j).aestronglyMeasurable)
    (Filter.Eventually.of_forall fun x => ?_)
  rw [norm_mul, norm_eC, one_mul]

/-- **Blueprint Lemma 9.4 (`lem:liftenvelope`)**, positive envelopes for lifted annular kernels:
for a Stein–Wainger profile `Ω` and `d`, there is `C` (independent of `p`, `s`, `j`, `μ`, `α` and
`f`) such that for every `j ∈ ℤ` (in particular every `j ≥ 1`), every real `μ`, every
`α = a/q` with `q ≥ 1` (in particular every `α ∈ 𝓡_s`), every `f ∈ ℓ¹(ℤⁿ)` (e.g. finitely
supported) and every `x ∈ ℤⁿ`,
`|Lift_{s,α}[Φ_{j,μ}](D) f(x)| ≤ C (B_{max(2^j, L_s)} * |f|)(x) ≤ C C_n 𝖬 f(x)`,
where `Φ_{j,μ} = radialOscPhi Ω d j μ`, `B_R` is the envelope and `𝖬 = cubeMaximalInt`. -/
theorem lift_envelope (n d : ℕ) {Ω : EuclideanSpace ℝ (Fin n) → ℂ} (hΩ : IsSWProfile Ω) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (p : ℝ) (s : ℕ) (j : ℤ) (μ : ℝ) (a q : ℕ), 1 ≤ q →
      ∀ f : (Fin n → ℤ) → ℂ, Summable (fun z => ‖f z‖) → ∀ x : Fin n → ℤ,
        ‖latMult (liftSym n d Ω p s a q (radialOscPhi Ω d j μ)) f x‖ ≤
            C * ∑' y, latEnvelope n (max ((2 : ℝ) ^ j) (liftL n d Ω p s)) y * ‖f (x - y)‖ ∧
          ‖latMult (liftSym n d Ω p s a q (radialOscPhi Ω d j μ)) f x‖ₑ ≤
            ENNReal.ofReal (C * envelopeConst n) * cubeMaximalInt n f x := by
  obtain ⟨C₁, hC₁, h₁⟩ := norm_latMult_liftSym_fourier_le n
  obtain ⟨C₂, hC₂, h₂⟩ := exists_norm_oscKernel_le hΩ d
  refine ⟨C₁ * C₂, by positivity, fun p s j μ a q hq f hf x => ?_⟩
  have hR : (0 : ℝ) < 2 ^ j := by positivity
  have h := h₁ d Ω p s a q hq _ C₂ _ (integrable_oscKernel hΩ d j μ) hR hC₂
    (fun z => h₂ j μ z) f hf x
  have e : radialOscPhi Ω d j μ = 𝓕 fun x => eC (μ * radialPoly n d x) * dyadicKernel Ω j x := by
    funext ξ; rfl
  rw [← e] at h
  refine ⟨h, ?_⟩
  have hR' : 1 ≤ max ((2 : ℝ) ^ j) (liftL n d Ω p s) := le_max_of_le_right (one_le_liftL s)
  rw [← ofReal_norm]
  refine (ENNReal.ofReal_le_ofReal h).trans ?_
  have hS0 : 0 ≤ ∑' y, latEnvelope n (max ((2 : ℝ) ^ j) (liftL n d Ω p s)) y * ‖f (x - y)‖ :=
    tsum_nonneg fun y => mul_nonneg (envelope_nonneg (by linarith) _) (norm_nonneg _)
  rw [ENNReal.ofReal_mul (by positivity)]
  refine (mul_le_mul' le_rfl (ofReal_tsum_latEnvelope_mul_le hR' hf x)).trans (le_of_eq ?_)
  rw [← mul_assoc, ← ENNReal.ofReal_mul (by positivity)]

open scoped ENNReal in
/-- **Blueprint Lemma 9.4 (`lem:liftenvelope`)**, the supremum over all indices at fixed `s`:
with `C` from `lift_envelope`, for every `f ∈ ℓ¹` and `x`,
`sup_{j, μ, α ∈ 𝓡_s} |Lift_{s,α}[Φ_{j,μ}](D) f(x)| ≤ C C_n 𝖬 f(x)`. -/
theorem lift_envelope_sup (n d : ℕ) {Ω : EuclideanSpace ℝ (Fin n) → ℂ} (hΩ : IsSWProfile Ω) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (p : ℝ) (s : ℕ) (f : (Fin n → ℤ) → ℂ), Summable (fun z => ‖f z‖) →
      ∀ x : Fin n → ℤ,
        (⨆ (j : ℤ) (μ : ℝ) (aq ∈ liftRat s),
          ‖latMult (liftSym n d Ω p s aq.1 aq.2 (radialOscPhi Ω d j μ)) f x‖ₑ) ≤
            ENNReal.ofReal (C * envelopeConst n) * cubeMaximalInt n f x := by
  obtain ⟨C, hC, h⟩ := lift_envelope n d hΩ
  refine ⟨C, hC, fun p s f hf x => iSup_le fun j => iSup_le fun μ => iSup₂_le fun aq haq => ?_⟩
  exact (h p s j μ aq.1 aq.2 (one_le_of_mem_liftRat (a := aq.1) (by simpa using haq)) f hf x).2

end Lifting

section Truncation

/-!
## Lifted maximal truncations

Results from §10 ("Lifted maximal truncations") of `blueprints/discrete-sw.tex`: Blueprint
Lemma 10.1 (`lem:lifttrunc`, "The unmodulated lifted maximal truncation"), namely the choice of
the long threshold, the short range, the long range decomposition, the bounds for all long range
pieces (including the long smooth maximum of `τ_J m_K`, via the averaging argument), and
eq. (10.1) itself (`lift_trunc`).

### Conventions

Mathlib Fourier sign, lattice conventions of section `Sampling`, and the §9 setup of
section `Lifting` (`liftSym … s a q m = Lift_{s,a/q}[m]`, `liftRat s = 𝓡_s`,
`liftN s = N_s = 2^s`, `liftV = v_s`). `K_j = dyadicKernel Ω j`, `m_K = dyadicSymbol Ω`,
`τ_J = bpTau J`, `E_J = smoothErr Ω J`. The truncation index `J` ranges over `ℕ` (`J ≥ 1`).

### Definitions

* `truncQ s = Q_s = lcm(1, …, N_s - 1)`; `truncC1 = C₁ = n + 2⌈C_*⌉ + 13` (irreducible);
  `truncJ … s = J_s = 2^{C₁(s+1)}`;
* `truncSym Ω J = ∑_{1 ≤ j < J} 𝓕 K_j`; `binBlock l k = I_{l,k}` (the blocks of Lemma 2.7).

### Results

* eq. (10.2) (`eq:longthreshold`): `truncQ_le` (`Q_s ≤ N^N`), `truncQ_le_two_pow`,
  `logb_truncQ_le` (`log₂ Q_s ≤ s 2^s`), `dvd_truncQ`, `truncJ_spec` and `exists_truncC1`
  (`J_s ≥ v_s + 10`, `√n Q_s ≤ 2^{J_s-3}`, `N^{n+2} Q_s 2^{-J_s} ≤ 2^{-10s}`);
* linearity of the lifting in the symbol: `liftSym_sum_mul`, `latMult_liftSym_sum_mul`,
  `latMult_liftSym_sub`;
* Euclidean multiplier forms of Lemmas 4.3 and 4.5 on Schwartz inputs:
  `eLpNorm_fourierInv_sum_fourier_dyadicKernel_le`,
  `eLpNorm_fourierInv_sum_fourier_smoothErr_le`;
* the short range: `lift_trunc_short`
  (`‖sup_{α, 1 ≤ J ≤ J_s} |Lift[∑_{j<J} 𝓕K_j](D) f|‖_p ≤ C (s+1) 2^{-δs} ‖f‖_p`, via Lemma 2.7
  with the supremum in `α` inside every block square and eq. (9.10) on each binary level);
* the long range decomposition: `truncSym_decomp` (`∑_{j<J} 𝓕K_j = m_K - m_{≥J}`,
  `m_{≥J} = τ_J m_K + Ê_J`) and `truncSym_eq_sub`;
* the long range bounds: `lift_dyadicSymbol_bound` (whole multiplier), `lift_smoothErr_finset`
  and `lift_smoothErr_sup` (smoothing errors, finite `J` sets and all `J ≥ 1`);
* `lift_trunc_of_long`: eq. (10.1) follows from the remaining bound
  `‖sup_{α, J > J_s} |Lift[τ_J m_K](D) f|‖_p ≤ C' 2^{-δ' s} ‖f‖_p` (the long smooth maximum);
* the long smooth maximum `lift_trunc_long`, with ingredients: the expansion
  `Lift_{s,a/q}[m](D) f = ∑_b S(a/q,b/q) M_{b/q} (m χ_s)_per(D) M_{-b/q} f`
  (`latMult_liftSym_eq_sum`), products of periodizations (`periodize_mul_eq`), `τ_J` as
  convolution with the sampled `φ_J` (`latMult_periodize_bpTau_mul`), eq. (10.3) at `u = 0`
  (`latMult_liftSym_bpTau_eq`: `Lift[τ_J m_K](D) f(x) = ∑_y φ_J(y) H_{α,x}(x - y)`) and the inner
  identity `Lift[e(-u · ξ) m_K](D) f(x) = H_{α,x}(x - u)` (`latMult_liftSym_eC_eq`), where
  `G_β = K_s M_{-β} f` (`truncG`, `K_s = (m_K χ_s)_per(D)`, `truncKs`) and
  `H_{α,v} = ∑_β S(α,β) e(v · β) G_β` (`truncH`); the translation bound for `φ_J`
  (`exists_norm_bpPhiDil_sub_le`); `K_s` bounded on `ℓ^p` (`truncKs_bound`); the one-element
  lifted estimate for `e(-u · ξ) m_K` uniformly in `u` (`lift_eC_dyadicSymbol_bound`); the
  pointwise main term / shift error bound (`lift_trunc_long_pointwise`); the change of variables
  over `𝒱_s = {0, …, Q_s - 1}ⁿ` (`sum_tsum_sub_finIntVec_eq`) and the averaging argument
  (`exists_shift_eLpNorm_cubeMaximalInt_le`);
* `lift_trunc`: eq. (10.1) (`eq:lifttrunc`).

The Mathlib sign convention turns the blueprint's `e(u · ξ)` into `e(-u · ξ)` and the blueprint's
`e(-β · x)` into `e(x · β)`. Instead of Minkowski over the averaging space, the proof uses a shift
`u ∈ 𝒱_s` whose shifted main term is at most the average (which gives the same bound).
-/

open MeasureTheory Set Real Finset
open scoped FourierTransform ContDiff SchwartzMap ENNReal NNReal Convolution

variable {n d : ℕ} {Ω : EuclideanSpace ℝ (Fin n) → ℂ} {p : ℝ}

/-! ### The long threshold `J_s` (eq. (10.2), `eq:longthreshold`) -/

/-- `Q_s = lcm(1, …, N_s - 1)` of Blueprint Lemma 10.1 (`lem:lifttrunc`), `N_s = 2^s`. -/
def truncQ (s : ℕ) : ℕ := (Finset.Ico 1 (liftN s)).lcm id

/-- Every `1 ≤ q < N_s` divides `Q_s`. -/
lemma dvd_truncQ {s q : ℕ} (h1 : 1 ≤ q) (h2 : q < liftN s) : q ∣ truncQ s :=
  Finset.dvd_lcm (f := id) (Finset.mem_Ico.2 ⟨h1, h2⟩)

/-- `Q_s ≥ 1`. -/
lemma truncQ_pos (s : ℕ) : 0 < truncQ s := by
  refine Nat.pos_of_ne_zero fun h => ?_
  rw [truncQ, Finset.lcm_eq_zero_iff] at h
  obtain ⟨q, hq, hq0⟩ := h
  have := (Finset.mem_Ico.1 hq).1
  simp only [id] at hq0
  omega

/-- Blueprint Lemma 10.1 (`lem:lifttrunc`), proof: `Q_s ≤ ∏_{1 ≤ q < N} q ≤ N^N` (`N = N_s`). -/
theorem truncQ_le (s : ℕ) : truncQ s ≤ liftN s ^ liftN s := by
  have hN : 1 ≤ liftN s := Nat.one_le_two_pow
  have h1 : truncQ s ∣ ∏ q ∈ Finset.Ico 1 (liftN s), q :=
    Finset.lcm_dvd fun q hq => Finset.dvd_prod_of_mem _ hq
  have hpos : 0 < ∏ q ∈ Finset.Ico 1 (liftN s), q :=
    Finset.prod_pos fun q hq => by have := (Finset.mem_Ico.1 hq).1; omega
  refine (Nat.le_of_dvd hpos h1).trans ?_
  refine (Finset.prod_le_pow_card _ _ (liftN s) fun q hq => (Finset.mem_Ico.1 hq).2.le).trans ?_
  refine Nat.pow_le_pow_right hN ?_
  rw [Nat.card_Ico]; omega

/-- `Q_s ≤ 2^{s 2^s}`. -/
theorem truncQ_le_two_pow (s : ℕ) : truncQ s ≤ 2 ^ (s * 2 ^ s) := by
  have := truncQ_le s
  rwa [liftN, ← pow_mul] at this

/-- Blueprint Lemma 10.1 (`lem:lifttrunc`), proof: `log₂ Q_s ≤ s 2^s`. -/
theorem logb_truncQ_le (s : ℕ) : Real.logb 2 (truncQ s) ≤ s * 2 ^ s := by
  have hQ : (0 : ℝ) < truncQ s := by exact_mod_cast truncQ_pos s
  have h : (truncQ s : ℝ) ≤ (2 : ℝ) ^ ((s : ℝ) * 2 ^ s) := by
    have := truncQ_le_two_pow s
    rw [show ((s : ℝ) * 2 ^ s) = ((s * 2 ^ s : ℕ) : ℝ) by push_cast; ring, Real.rpow_natCast]
    exact_mod_cast this
  calc Real.logb 2 (truncQ s) ≤ Real.logb 2 ((2 : ℝ) ^ ((s : ℝ) * 2 ^ s)) :=
        Real.logb_le_logb_of_le (by norm_num) hQ h
    _ = s * 2 ^ s := by rw [Real.logb_rpow (by norm_num) (by norm_num)]

/-- The integer `C₁ = n + 2⌈C_*⌉ + 13 ≥ 3` of eq. (10.2) (`eq:longthreshold`) (a fixed choice
depending on `n, d, Ω, p` through `C_* = liftCStar`). -/
@[irreducible] noncomputable def truncC1 (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) : ℕ :=
  n + 2 * ⌈liftCStar n d Ω p⌉₊ + 13

lemma truncC1_eq : truncC1 n d Ω p = n + 2 * ⌈liftCStar n d Ω p⌉₊ + 13 := by
  unfold truncC1; rfl

/-- The long threshold `J_s = 2^{C₁(s+1)}` of eq. (10.2) (`eq:longthreshold`). -/
noncomputable def truncJ (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ) : ℕ :=
  2 ^ (truncC1 n d Ω p * (s + 1))

lemma three_le_truncC1 : 3 ≤ truncC1 n d Ω p := by rw [truncC1_eq]; omega

/-- `J_s ≥ 2^{C₁} 4^s`. -/
lemma truncJ_ge (s : ℕ) :
    2 ^ truncC1 n d Ω p * (2 ^ s * 2 ^ s) ≤ truncJ n d Ω p s := by
  have hC := three_le_truncC1 (n := n) (d := d) (Ω := Ω) (p := p)
  calc 2 ^ truncC1 n d Ω p * (2 ^ s * 2 ^ s) = 2 ^ (truncC1 n d Ω p + (s + s)) := by
        rw [pow_add, pow_add]
    _ ≤ truncJ n d Ω p s := Nat.pow_le_pow_right (by norm_num) (by nlinarith)

lemma truncC1_lt_two_pow : truncC1 n d Ω p < 2 ^ truncC1 n d Ω p := Nat.lt_two_pow_self

/-- Arithmetic for the first requirement of eq. (10.2). -/
lemma liftV_threshold_arith {K M : ℝ} {v s : ℕ} {T : ℝ} (hK : 0 < K) (hM : 1 ≤ M)
    (hv : (v : ℝ) < K * ((s : ℝ) + 1) * (1 + (2 : ℝ) ^ ((s : ℝ) / (2 * M))) + 1)
    (hT : 2 * K + 11 ≤ T) : (v : ℝ) + 10 ≤ T * ((2 : ℝ) ^ s * (2 : ℝ) ^ s) := by
  have hts : (2 : ℝ) ^ ((s : ℝ) / (2 * M)) ≤ (2 : ℝ) ^ s := by
    rw [← Real.rpow_natCast]
    refine Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_
    rw [div_le_iff₀ (by linarith : (0 : ℝ) < 2 * M)]
    have : (0 : ℝ) ≤ s := Nat.cast_nonneg s
    nlinarith
  have hs2 : s + 1 ≤ 2 ^ s := Nat.lt_two_pow_self
  have hsa : (s : ℝ) + 1 ≤ (2 : ℝ) ^ s := by exact_mod_cast hs2
  have ha1 : (1 : ℝ) ≤ (2 : ℝ) ^ s := one_le_pow₀ (by norm_num)
  have h1 : K * ((s : ℝ) + 1) * (1 + (2 : ℝ) ^ ((s : ℝ) / (2 * M))) ≤
      K * (2 : ℝ) ^ s * ((2 : ℝ) ^ s + (2 : ℝ) ^ s) := by
    gcongr
  have h2 : (1 : ℝ) ≤ (2 : ℝ) ^ s * (2 : ℝ) ^ s := by nlinarith
  nlinarith

/-- Arithmetic for the second and third requirements of eq. (10.2). -/
lemma truncJ_threshold_arith {n s C J : ℕ} (hC : n + 13 ≤ C) (hT : C < 2 ^ C)
    (hJ : 2 ^ C * (2 ^ s * 2 ^ s) ≤ J) :
    n + s * 2 ^ s + 3 ≤ J ∧ s * (n + 2) + s * 2 ^ s + 10 * s ≤ J := by
  have hs2 : s < 2 ^ s := Nat.lt_two_pow_self
  have h0 : s * 2 ^ s ≤ 2 ^ s * 2 ^ s := Nat.mul_le_mul_right _ hs2.le
  have h1' : 1 ≤ 2 ^ s * 2 ^ s := Nat.one_le_iff_ne_zero.2 (by positivity)
  have hs3 : s ≤ 2 ^ s * 2 ^ s := hs2.le.trans (Nat.le_mul_of_pos_right _ (by positivity))
  generalize 2 ^ s * 2 ^ s = a at *
  generalize 2 ^ C = T at *
  constructor
  · nlinarith
  · nlinarith

/-- **Blueprint Lemma 10.1 (`lem:lifttrunc`), eq. (10.2) (`eq:longthreshold`)**, for the fixed
choice `C₁ = truncC1 ≥ 3`: for every `s` (in particular every `s ≥ 1`), `J_s = 2^{C₁(s+1)}`
satisfies `J_s ≥ v_s + 10`, `√n Q_s ≤ 2^{J_s - 3}` and `N_s^{n+2} Q_s 2^{-J_s} ≤ 2^{-10 s}`. -/
theorem truncJ_spec (s : ℕ) :
    liftV n d Ω p s + 10 ≤ truncJ n d Ω p s ∧
    Real.sqrt n * truncQ s ≤ (2 : ℝ) ^ (truncJ n d Ω p s - 3) ∧
    ((liftN s : ℕ) : ℝ) ^ (n + 2) * truncQ s / (2 : ℝ) ^ truncJ n d Ω p s ≤
      ((2 : ℝ) ^ (10 * s))⁻¹ := by
  have hJ : 2 ^ truncC1 n d Ω p * (2 ^ s * 2 ^ s) ≤ truncJ n d Ω p s := truncJ_ge s
  have hT : truncC1 n d Ω p < 2 ^ truncC1 n d Ω p := truncC1_lt_two_pow
  have hCn : n + 13 ≤ truncC1 n d Ω p := by rw [truncC1_eq]; omega
  have hKC : 2 * liftCStar n d Ω p + 11 ≤ (truncC1 n d Ω p : ℝ) := by
    rw [truncC1_eq]
    have hKc : liftCStar n d Ω p ≤ ⌈liftCStar n d Ω p⌉₊ := Nat.le_ceil _
    push_cast
    have : (0 : ℝ) ≤ n := Nat.cast_nonneg n
    linarith
  have hQ : (truncQ s : ℝ) ≤ (2 : ℝ) ^ (s * 2 ^ s) := by exact_mod_cast truncQ_le_two_pow s
  have hK : 0 < liftCStar n d Ω p := liftCStar_pos
  have hM : (1 : ℝ) ≤ paramM n d Ω p := by
    have : (2 : ℝ) ≤ paramM n d Ω p := by exact_mod_cast two_le_paramM n d Ω p
    linarith
  have hv : (liftV n d Ω p s : ℝ) < liftCStar n d Ω p * ((s : ℝ) + 1) *
      (1 + (2 : ℝ) ^ ((s : ℝ) / (2 * (paramM n d Ω p : ℝ)))) + 1 := by
    have h1 : (0 : ℝ) < (2 : ℝ) ^ ((s : ℝ) / (2 * (paramM n d Ω p : ℝ))) :=
      Real.rpow_pos_of_pos (by norm_num) _
    have h2 : (0 : ℝ) ≤ (s : ℝ) + 1 := by have := Nat.cast_nonneg (α := ℝ) s; linarith
    have h0 : 0 ≤ liftCStar n d Ω p * ((s : ℝ) + 1) *
        (1 + (2 : ℝ) ^ ((s : ℝ) / (2 * (paramM n d Ω p : ℝ)))) :=
      mul_nonneg (mul_nonneg hK.le h2) (by linarith)
    have := Nat.ceil_lt_add_one (R := ℝ) h0
    exact this
  generalize truncJ n d Ω p s = J at *
  generalize truncC1 n d Ω p = C at *
  generalize liftV n d Ω p s = v at *
  generalize liftCStar n d Ω p = K at *
  generalize (paramM n d Ω p : ℝ) = M at *
  obtain ⟨hA, hB⟩ := truncJ_threshold_arith hCn hT hJ
  refine ⟨?_, ?_, ?_⟩
  · have hTC : 2 * K + 11 ≤ ((2 ^ C : ℕ) : ℝ) := by
      have : (C : ℝ) ≤ ((2 ^ C : ℕ) : ℝ) := by exact_mod_cast hT.le
      linarith
    have hbound := liftV_threshold_arith hK hM hv hTC
    have : ((v + 10 : ℕ) : ℝ) ≤ ((2 ^ C * (2 ^ s * 2 ^ s) : ℕ) : ℝ) := by
      push_cast at hbound ⊢; exact hbound
    exact (Nat.cast_le.1 this).trans hJ
  · have hsq : Real.sqrt n ≤ (2 : ℝ) ^ n := by
      have h1 : (n : ℝ) + 1 ≤ 2 ^ n := by
        have : n + 1 ≤ 2 ^ n := Nat.lt_two_pow_self
        exact_mod_cast this
      rw [Real.sqrt_le_left (by positivity)]
      have : (0 : ℝ) ≤ n := Nat.cast_nonneg n
      nlinarith
    have hexp : n + s * 2 ^ s ≤ J - 3 := by omega
    calc Real.sqrt n * truncQ s ≤ (2 : ℝ) ^ n * (2 : ℝ) ^ (s * 2 ^ s) :=
          mul_le_mul hsq hQ (Nat.cast_nonneg _) (by positivity)
      _ = (2 : ℝ) ^ (n + s * 2 ^ s) := by rw [pow_add]
      _ ≤ (2 : ℝ) ^ (J - 3) := pow_le_pow_right₀ (by norm_num) hexp
  · have hN : ((liftN s : ℕ) : ℝ) ^ (n + 2) = (2 : ℝ) ^ (s * (n + 2)) := by
      rw [liftN, Nat.cast_pow, Nat.cast_ofNat, ← pow_mul]
    rw [div_le_iff₀ (by positivity), hN, ← div_eq_inv_mul, le_div_iff₀ (by positivity)]
    calc (2 : ℝ) ^ (s * (n + 2)) * truncQ s * 2 ^ (10 * s)
        ≤ (2 : ℝ) ^ (s * (n + 2)) * 2 ^ (s * 2 ^ s) * 2 ^ (10 * s) := by gcongr
      _ = (2 : ℝ) ^ (s * (n + 2) + s * 2 ^ s + 10 * s) := by rw [pow_add, pow_add]
      _ ≤ (2 : ℝ) ^ J := pow_le_pow_right₀ (by norm_num) hB

/-- **Blueprint Lemma 10.1 (`lem:lifttrunc`), eq. (10.2) (`eq:longthreshold`)**, existence form:
there is an integer `C₁ ≥ 3` such that for every `s ≥ 1`, `J_s = 2^{C₁(s+1)}` satisfies
`J_s ≥ v_s + 10`, `√n Q_s ≤ 2^{J_s - 3}` and `N_s^{n+2} Q_s 2^{-J_s} ≤ 2^{-10 s}`; the choice
`C₁ = truncC1` (used in `truncJ`) is such an integer. -/
theorem exists_truncC1 (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) :
    ∃ C₁ : ℕ, 3 ≤ C₁ ∧ C₁ = truncC1 n d Ω p ∧ ∀ s : ℕ, 1 ≤ s →
      liftV n d Ω p s + 10 ≤ 2 ^ (C₁ * (s + 1)) ∧
      Real.sqrt n * truncQ s ≤ (2 : ℝ) ^ (2 ^ (C₁ * (s + 1)) - 3) ∧
      ((liftN s : ℕ) : ℝ) ^ (n + 2) * truncQ s / (2 : ℝ) ^ (2 ^ (C₁ * (s + 1))) ≤
        ((2 : ℝ) ^ (10 * s))⁻¹ :=
  ⟨truncC1 n d Ω p, three_le_truncC1, rfl, fun s _ => truncJ_spec s⟩

/-! ### Linearity of the lifted symbols in `m` -/

/-- `m χ_s` is supported where `χ̃_s ≠ 0`. -/
lemma liftChiT_ne_zero_of_mul_liftChi_ne_zero {s : ℕ} {m : EuclideanSpace ℝ (Fin n) → ℂ}
    {η : EuclideanSpace ℝ (Fin n)} (h : m η * (liftChi n d Ω p s η : ℂ) ≠ 0) :
    liftChiT n d Ω p s η ≠ 0 :=
  liftChiT_ne_zero_of_liftChi_ne_zero fun h0 => h (by rw [h0, Complex.ofReal_zero, mul_zero])

/-- Linearity of `m ↦ (m χ_s)_per` (at most one translate of `χ_s` is active at each point). -/
lemma periodize_sum_mul_liftChi {s : ℕ} {ι : Type*} (F : Finset ι) (c : ι → ℂ)
    (m : ι → EuclideanSpace ℝ (Fin n) → ℂ) (ζ : EuclideanSpace ℝ (Fin n)) :
    periodize (fun η => (∑ i ∈ F, c i * m i η) * (liftChi n d Ω p s η : ℂ)) ζ =
      ∑ i ∈ F, c i * periodize (fun η => m i η * (liftChi n d Ω p s η : ℂ)) ζ := by
  have hg : ∀ (M : EuclideanSpace ℝ (Fin n) → ℂ) η, M η * (liftChi n d Ω p s η : ℂ) ≠ 0 →
      liftChiT n d Ω p s η ≠ 0 := fun M η h => liftChiT_ne_zero_of_mul_liftChi_ne_zero h
  by_cases h : ∃ z : Fin n → ℤ, liftChiT n d Ω p s (ζ - latEmbed z) ≠ 0
  · obtain ⟨z, hz⟩ := h
    rw [periodize_eq_of_liftChiT (hg _) hz, Finset.sum_mul]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [periodize_eq_of_liftChiT (hg _) hz, mul_assoc]
  · push Not at h
    rw [periodize_eq_zero_of_liftChiT (hg _) h]
    refine (Finset.sum_eq_zero fun i _ => ?_).symm
    rw [periodize_eq_zero_of_liftChiT (hg _) h, mul_zero]

/-- Linearity of the lifted symbol in `m`:
`Lift_{s,α}[∑_i c_i m_i] = ∑_i c_i Lift_{s,α}[m_i]` pointwise. -/
theorem liftSym_sum_mul (s a q : ℕ) {ι : Type*} (F : Finset ι) (c : ι → ℂ)
    (m : ι → EuclideanSpace ℝ (Fin n) → ℂ) (ξ : EuclideanSpace ℝ (Fin n)) :
    liftSym n d Ω p s a q (fun η => ∑ i ∈ F, c i * m i η) ξ =
      ∑ i ∈ F, c i * liftSym n d Ω p s a q (m i) ξ := by
  simp only [liftSym, periodize_sum_mul_liftChi, Finset.mul_sum]
  rw [Finset.sum_comm]
  exact Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun b _ => by ring

/-- Linearity of the lifted operators in the symbol: for bounded a.e. strongly measurable
`m_i` and `f ∈ ℓ¹`, `Lift_{s,α}[∑_i c_i m_i](D) f = ∑_i c_i Lift_{s,α}[m_i](D) f`. -/
theorem latMult_liftSym_sum_mul {s a q : ℕ} {ι : Type*} (F : Finset ι) (c : ι → ℂ)
    {m : ι → EuclideanSpace ℝ (Fin n) → ℂ} (hm : ∀ i ∈ F, AEStronglyMeasurable (m i) volume)
    {B : ℝ} (hB : ∀ i ∈ F, ∀ ξ, ‖m i ξ‖ ≤ B) {f : (Fin n → ℤ) → ℂ}
    (hf : Summable fun z => ‖f z‖) (x : Fin n → ℤ) :
    latMult (liftSym n d Ω p s a q (fun η => ∑ i ∈ F, c i * m i η)) f x =
      ∑ i ∈ F, c i * latMult (liftSym n d Ω p s a q (m i)) f x := by
  have e : liftSym n d Ω p s a q (fun η => ∑ i ∈ F, c i * m i η) =
      fun ξ => ∑ i ∈ F, c i * liftSym n d Ω p s a q (m i) ξ :=
    funext (liftSym_sum_mul s a q F c m)
  rw [e]
  exact latMult_sum_mul F c (fun i hi => integrableOn_liftSym
    (integrable_mul_liftChi (hm i hi) fun ξ _ => hB i hi ξ)) hf x

/-- Two-term form: `Lift[m₁ - m₂](D) f = Lift[m₁](D) f - Lift[m₂](D) f`. -/
theorem latMult_liftSym_sub {s a q : ℕ} {m₁ m₂ : EuclideanSpace ℝ (Fin n) → ℂ}
    (hm₁ : AEStronglyMeasurable m₁ volume) (hm₂ : AEStronglyMeasurable m₂ volume) {B : ℝ}
    (hB₁ : ∀ ξ, ‖m₁ ξ‖ ≤ B) (hB₂ : ∀ ξ, ‖m₂ ξ‖ ≤ B) {f : (Fin n → ℤ) → ℂ}
    (hf : Summable fun z => ‖f z‖) (x : Fin n → ℤ) :
    latMult (liftSym n d Ω p s a q (fun η => m₁ η - m₂ η)) f x =
      latMult (liftSym n d Ω p s a q m₁) f x - latMult (liftSym n d Ω p s a q m₂) f x := by
  have h := latMult_liftSym_sum_mul (d := d) (Ω := Ω) (p := p) (s := s) (a := a) (q := q)
    (Finset.univ : Finset (Fin 2)) ![1, -1] (m := ![m₁, m₂])
    (fun i _ => by fin_cases i <;> simpa) (B := B) (fun i _ => by fin_cases i <;> simpa)
    hf x
  simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one,
    one_mul, neg_one_mul] at h
  simpa only [sub_eq_add_neg] using h

/-! ### The truncated symbols and the signed dyadic multiplier bounds -/

/-- The truncated symbol `∑_{1 ≤ j < J} 𝓕 K_j` of Blueprint Lemma 10.1 (`lem:lifttrunc`)
(Mathlib's Fourier transform; `J ∈ ℕ`, empty for `J ≤ 1`). -/
noncomputable def truncSym (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (J : ℕ)
    (ξ : EuclideanSpace ℝ (Fin n)) : ℂ :=
  ∑ j ∈ Finset.Ico 1 J, 𝓕 (dyadicKernel Ω (j : ℤ)) ξ

/-- `𝓕 K_j` is continuous. -/
lemma continuous_fourier_dyadicKernel (hΩ : IsSWProfile Ω) (j : ℤ) :
    Continuous (𝓕 (dyadicKernel Ω j)) :=
  (continuous_fourier_and_norm_le (integrable_dyadicKernel hΩ j)).1

/-- Finite sums of `𝓕 K_j` over `j ∈ T ⊆ ℕ` are continuous. -/
lemma continuous_sum_fourier_dyadicKernel (hΩ : IsSWProfile Ω) (T : Finset ℕ) :
    Continuous fun ξ : EuclideanSpace ℝ (Fin n) => ∑ j ∈ T, 𝓕 (dyadicKernel Ω (j : ℤ)) ξ :=
  continuous_finsetSum _ fun j _ => continuous_fourier_dyadicKernel hΩ j

/-- Uniform bound `|∑_{j ∈ T} 𝓕 K_j(ξ)| ≤ A` over finite `T ⊆ ℕ`. -/
lemma norm_sum_fourier_dyadicKernel_nat_le (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) :
    ∃ A : ℝ, 0 ≤ A ∧ ∀ (T : Finset ℕ) (ξ : EuclideanSpace ℝ (Fin n)),
      ‖∑ j ∈ T, 𝓕 (dyadicKernel Ω (j : ℤ)) ξ‖ ≤ A := by
  obtain ⟨A, hA0, hA⟩ := sum_norm_fourier_dyadicKernel_le hn hΩ
  refine ⟨A, hA0, fun T ξ => (norm_sum_le _ _).trans ?_⟩
  have := hA (T.map Nat.castEmbedding) ξ
  rwa [Finset.sum_map] at this

/-- Blueprint Lemma 4.3 (`lem:signedK`) in multiplier form on Schwartz inputs: for `1 < t < ∞`
there is `A` such that for every finite `T ⊆ ℕ` and all `|c_j| ≤ 1`,
`‖𝓕⁻((∑_{j ∈ T} c_j 𝓕 K_j) 𝓕 G)‖_t ≤ A ‖G‖_t` for every Schwartz `G`. -/
theorem eLpNorm_fourierInv_sum_fourier_dyadicKernel_le (hn : 1 ≤ n) (hΩ : IsSWProfile Ω)
    {t : ℝ} (ht : 1 < t) :
    ∃ A : ℝ, 0 ≤ A ∧ ∀ (T : Finset ℕ) (c : ℕ → ℂ), (∀ j, ‖c j‖ ≤ 1) →
      ∀ G : 𝓢(EuclideanSpace ℝ (Fin n), ℂ),
        eLpNorm (𝓕⁻ (fun ξ => (∑ j ∈ T, c j * 𝓕 (dyadicKernel Ω (j : ℤ)) ξ) *
            𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ)) (ENNReal.ofReal t) volume ≤
          ENNReal.ofReal A * eLpNorm G (ENNReal.ofReal t) volume := by
  obtain ⟨C, hC0, hC⟩ := exists_eLpNorm_convolution_sum_smul_dyadicKernel_le hn hΩ ht
  obtain ⟨A, hA0, hA⟩ := norm_fourier_sum_smul_dyadicKernel_le hn hΩ
  refine ⟨C, hC0, fun T c hc G => ?_⟩
  set c' : ℤ → ℂ := fun j => c j.toNat with hc'def
  have hc' : ∀ j, ‖c' j‖ ≤ 1 := fun j => hc _
  have hH : Integrable (∑ j ∈ T.map Nat.castEmbedding, c' j • dyadicKernel Ω j) :=
    integrable_finsetSum' _ fun j _ => (integrable_dyadicKernel hΩ j).smul _
  have e : (fun ξ => (∑ j ∈ T, c j * 𝓕 (dyadicKernel Ω (j : ℤ)) ξ) *
      𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ) = fun ξ =>
        𝓕 (∑ j ∈ T.map Nat.castEmbedding, c' j • dyadicKernel Ω j) ξ *
          𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ := by
    funext ξ
    rw [fourier_sum_smul_dyadicKernel hΩ, Finset.sum_map]
    simp [hc'def]
  rw [e, fourierInv_fourier_mul_eq_convolution hH (hA _ c' hc') G]
  exact hC _ c' hc' _ (G.memLp _ _)

/-! ### Binary blocks -/

/-- The dyadic block `I_{l,k} = {k 2^l + 1, …, (k+1) 2^l}` of Blueprint Lemma 2.7
(`lem:binary`). -/
def binBlock (l k : ℕ) : Finset ℕ := Finset.Icc (k * 2 ^ l + 1) ((k + 1) * 2 ^ l)

lemma div_of_mem_binBlock {l k j : ℕ} (h : j ∈ binBlock l k) : (j - 1) / 2 ^ l = k := by
  rw [binBlock, Finset.mem_Icc] at h
  refine Nat.div_eq_of_lt_le (by omega) ?_
  have : 0 < 2 ^ l := by positivity
  omega

/-- A signed sum of block sums is a sum over the union of the (disjoint) blocks, with
coefficient `ε_{(j-1)/2^l}` at `j`. -/
lemma sum_signed_binBlock (l : ℕ) (F : Finset ℕ) (ε : ℕ → ℂ) (g : ℕ → ℂ) :
    ∑ k ∈ F, ε k * ∑ j ∈ binBlock l k, g j =
      ∑ j ∈ F.biUnion (binBlock l),
        (if (j - 1) / 2 ^ l ∈ F then ε ((j - 1) / 2 ^ l) else 0) * g j := by
  classical
  rw [Finset.sum_biUnion]
  · refine Finset.sum_congr rfl fun k hk => ?_
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun j hj => ?_
    rw [div_of_mem_binBlock hj]
    simp only [hk, ↓reduceIte]
  · intro k _ k' _ hkk'
    refine Finset.disjoint_left.2 fun j hj hj' => hkk' ?_
    exact (div_of_mem_binBlock hj).symm.trans (div_of_mem_binBlock hj')

/-! ### The short range `1 ≤ J ≤ J_s` -/

/-- Linearity for the finite dyadic sums: `Lift[∑_{j ∈ T} 𝓕 K_j](D) f = ∑_{j ∈ T} Lift[𝓕 K_j](D) f`
(`f ∈ ℓ¹`). -/
lemma latMult_liftSym_sum_fourier_dyadicKernel (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) {s : ℕ}
    (T : Finset ℕ) (aq : ℕ × ℕ) {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖)
    (x : Fin n → ℤ) :
    latMult (liftSym n d Ω p s aq.1 aq.2
        (fun ξ => ∑ j ∈ T, 𝓕 (dyadicKernel Ω (j : ℤ)) ξ)) f x =
      ∑ j ∈ T, latMult (liftSym n d Ω p s aq.1 aq.2 (𝓕 (dyadicKernel Ω (j : ℤ)))) f x := by
  obtain ⟨B, -, hB⟩ := norm_sum_fourier_dyadicKernel_nat_le hn hΩ
  have := latMult_liftSym_sum_mul (d := d) (Ω := Ω) (p := p) (s := s) (a := aq.1) (q := aq.2)
    T (fun _ => 1) (m := fun j => 𝓕 (dyadicKernel Ω (j : ℤ)))
    (fun j _ => (continuous_fourier_dyadicKernel hΩ _).aestronglyMeasurable)
    (B := B) (fun j _ ξ => by simpa using hB {j} ξ) hf x
  simpa only [one_mul] using this

/-- **Blueprint Lemma 10.1 (`lem:lifttrunc`), the short range `J ≤ J_s`**: for `n, d ≥ 1`,
admissible `Ω` and `1 < p < ∞` there are `δ > 0` and `C` such that for every `s ≥ 1` and every
finitely supported `f`,
`‖sup_{α ∈ 𝓡_s, 1 ≤ J ≤ J_s} |Lift_{s,α}[∑_{1 ≤ j < J} 𝓕 K_j](D) f|‖_p ≤ C (s+1) 2^{-δ s} ‖f‖_p`
(the supremum is the finite maximum over `(α, J) ∈ 𝓡_s × {1, …, J_s}`; `δ` is the exponent of
eq. (9.10), `lift_square_p`). -/
theorem lift_trunc_short (hn : 1 ≤ n) (hd : 1 ≤ d) (hΩ : IsSWProfile Ω) (hp : 1 < p) :
    ∃ δ : ℝ, 0 < δ ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ s : ℕ, 1 ≤ s →
      ∀ f : (Fin n → ℤ) → ℂ, (Function.support f).Finite →
        eLpNorm (fun x => ((((liftRat s) ×ˢ (Finset.Icc 1 (truncJ n d Ω p s))).sup fun aJ =>
            ‖latMult (liftSym n d Ω p s aJ.1.1 aJ.1.2 (truncSym Ω aJ.2)) f x‖₊ : ℝ≥0) : ℝ))
          (ENNReal.ofReal p) Measure.count ≤
        ENNReal.ofReal (C * ((s : ℝ) + 1) * (2 : ℝ) ^ (-(δ * s))) *
          eLpNorm f (ENNReal.ofReal p) Measure.count := by
  obtain ⟨δ, hδ, CL, hCL, hsq⟩ := lift_square_p n d hn hd Ω hp
  have ht : 1 < 2 * (paramR p : ℝ) := by
    have : (1 : ℝ) ≤ paramR p := by exact_mod_cast one_le_paramR p
    linarith
  obtain ⟨A, hA0, hA⟩ := eLpNorm_fourierInv_sum_fourier_dyadicKernel_le hn hΩ ht
  obtain ⟨B, hB0, hB⟩ := norm_sum_fourier_dyadicKernel_nat_le hn hΩ
  have hC1 : (0 : ℝ) ≤ truncC1 n d Ω p := Nat.cast_nonneg _
  refine ⟨δ, hδ, CL * A * ((truncC1 n d Ω p : ℝ) + 1),
    mul_nonneg (mul_nonneg hCL hA0) (by linarith), fun s hs f hf => ?_⟩
  classical
  have hf1 : Summable fun z => ‖f z‖ := summable_of_finite_support hf
  have hJL : truncJ n d Ω p s = 2 ^ (truncC1 n d Ω p * (s + 1)) := rfl
  set L := truncC1 n d Ω p * (s + 1) with hL
  set blk : ℕ → ℕ → EuclideanSpace ℝ (Fin n) → ℂ := fun l k ξ =>
    ∑ j ∈ binBlock l k, 𝓕 (dyadicKernel Ω (j : ℤ)) ξ with hblk
  set Q : ℕ → (Fin n → ℤ) → ℝ := fun l x => Real.sqrt (∑ k ∈ Finset.range (2 ^ (L - l)),
    ((((liftRat s).sup fun aq =>
      ‖latMult (liftSym n d Ω p s aq.1 aq.2 (blk l k)) f x‖₊ : ℝ≥0) : ℝ) ^ 2)) with hQ
  -- the pointwise binary bound, with the supremum over `α` inside each block square
  have hpt : ∀ x, (((liftRat s ×ˢ Finset.Icc 1 (truncJ n d Ω p s)).sup fun aJ =>
      ‖latMult (liftSym n d Ω p s aJ.1.1 aJ.1.2 (truncSym Ω aJ.2)) f x‖₊ : ℝ≥0) : ℝ) ≤
        ∑ l ∈ Finset.range (L + 1), Q l x := by
    intro x
    refine arith_coe_finset_sup_nnnorm_le (Finset.sum_nonneg fun l _ => Real.sqrt_nonneg _) ?_
    rintro ⟨aq, J⟩ haJ
    rw [Finset.mem_product, Finset.mem_Icc] at haJ
    obtain ⟨haq, hJ1, hJ2⟩ := haJ
    have e1 : truncSym Ω J =
        fun ξ => ∑ j ∈ Finset.Icc 1 (J - 1), 𝓕 (dyadicKernel Ω (j : ℤ)) ξ := by
      funext ξ
      unfold truncSym
      congr 1
    simp only
    rw [e1, latMult_liftSym_sum_fourier_dyadicKernel hn hΩ _ aq hf1 x]
    refine (binary_maximal_inequality L _ (J - 1) (by rw [hJL] at hJ2; omega)).trans ?_
    refine Finset.sum_le_sum fun l _ => Real.sqrt_le_sqrt (Finset.sum_le_sum fun k _ => ?_)
    have e2 : ∑ j ∈ Finset.Icc (k * 2 ^ l + 1) ((k + 1) * 2 ^ l),
        latMult (liftSym n d Ω p s aq.1 aq.2 (𝓕 (dyadicKernel Ω (j : ℤ)))) f x =
          latMult (liftSym n d Ω p s aq.1 aq.2 (blk l k)) f x :=
      (latMult_liftSym_sum_fourier_dyadicKernel hn hΩ (binBlock l k) aq hf1 x).symm
    rw [e2]
    have hle := Finset.le_sup
      (f := fun aq : ℕ × ℕ => ‖latMult (liftSym n d Ω p s aq.1 aq.2 (blk l k)) f x‖₊) haq
    have h' : ‖latMult (liftSym n d Ω p s aq.1 aq.2 (blk l k)) f x‖ ≤
        (((liftRat s).sup fun aq =>
          ‖latMult (liftSym n d Ω p s aq.1 aq.2 (blk l k)) f x‖₊ : ℝ≥0) : ℝ) := by
      exact_mod_cast hle
    exact pow_le_pow_left₀ (norm_nonneg _) h' 2
  -- each binary level is bounded by eq. (9.10)
  have hlev : ∀ l, eLpNorm (Q l) (ENNReal.ofReal p) Measure.count ≤
      ENNReal.ofReal (CL * (2 : ℝ) ^ (-(δ * s)) * A) *
        eLpNorm f (ENNReal.ofReal p) Measure.count := by
    intro l
    refine hsq s hs (Finset.range (2 ^ (L - l))) (blk l) B A
      (fun k _ => (continuous_sum_fourier_dyadicKernel hΩ _).aestronglyMeasurable)
      (fun k _ ξ => hB _ ξ) hA0 (fun ε hε G => ?_) f hf
    have e : (fun ξ => (∑ k ∈ Finset.range (2 ^ (L - l)), (ε k : ℂ) * blk l k ξ) *
        𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ) = fun ξ =>
          (∑ j ∈ (Finset.range (2 ^ (L - l))).biUnion (binBlock l),
            (if (j - 1) / 2 ^ l ∈ Finset.range (2 ^ (L - l)) then (ε ((j - 1) / 2 ^ l) : ℂ)
              else 0) * 𝓕 (dyadicKernel Ω (j : ℤ)) ξ) *
            𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ := by
      funext ξ
      congr 1
      exact sum_signed_binBlock l _ (fun k => (ε k : ℂ)) (fun j => 𝓕 (dyadicKernel Ω (j : ℤ)) ξ)
    rw [e]
    refine hA _ _ (fun j => ?_) G
    split_ifs with h
    · rcases hε _ h with h1 | h1 <;> simp [h1]
    · simp
  have hp1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hp.le
  have h2 : (0 : ℝ) ≤ (2 : ℝ) ^ (-(δ * s)) := Real.rpow_nonneg (by norm_num) _
  have hX : 0 ≤ CL * (2 : ℝ) ^ (-(δ * s)) * A := mul_nonneg (mul_nonneg hCL h2) hA0
  calc eLpNorm (fun x => ((((liftRat s) ×ˢ (Finset.Icc 1 (truncJ n d Ω p s))).sup fun aJ =>
            ‖latMult (liftSym n d Ω p s aJ.1.1 aJ.1.2 (truncSym Ω aJ.2)) f x‖₊ : ℝ≥0) : ℝ))
          (ENNReal.ofReal p) Measure.count
      ≤ eLpNorm (∑ l ∈ Finset.range (L + 1), Q l) (ENNReal.ofReal p) Measure.count := by
        refine eLpNorm_mono_real AEStronglyMeasurable.of_discrete fun x => ?_
        rw [Finset.sum_apply, Real.norm_of_nonneg (NNReal.coe_nonneg _)]
        exact hpt x
    _ ≤ ∑ l ∈ Finset.range (L + 1), eLpNorm (Q l) (ENNReal.ofReal p) Measure.count :=
        eLpNorm_sum_le hp1
    _ ≤ ∑ l ∈ Finset.range (L + 1), ENNReal.ofReal (CL * (2 : ℝ) ^ (-(δ * s)) * A) *
          eLpNorm f (ENNReal.ofReal p) Measure.count := Finset.sum_le_sum fun l _ => hlev l
    _ = ENNReal.ofReal (((L + 1 : ℕ) : ℝ) * (CL * (2 : ℝ) ^ (-(δ * s)) * A)) *
          eLpNorm f (ENNReal.ofReal p) Measure.count := by
        rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul,
          ENNReal.ofReal_mul (Nat.cast_nonneg _), ENNReal.ofReal_natCast]
        ring
    _ ≤ ENNReal.ofReal (CL * A * ((truncC1 n d Ω p : ℝ) + 1) * ((s : ℝ) + 1) *
          (2 : ℝ) ^ (-(δ * s))) * eLpNorm f (ENNReal.ofReal p) Measure.count := by
        refine mul_le_mul_left (ENNReal.ofReal_le_ofReal ?_) _
        have hs0 : (0 : ℝ) ≤ s := Nat.cast_nonneg s
        have hL1 : ((L + 1 : ℕ) : ℝ) ≤ ((truncC1 n d Ω p : ℝ) + 1) * ((s : ℝ) + 1) := by
          rw [hL]; push_cast; nlinarith
        calc ((L + 1 : ℕ) : ℝ) * (CL * (2 : ℝ) ^ (-(δ * s)) * A)
            ≤ ((truncC1 n d Ω p : ℝ) + 1) * ((s : ℝ) + 1) * (CL * (2 : ℝ) ^ (-(δ * s)) * A) :=
              mul_le_mul_of_nonneg_right hL1 hX
          _ = _ := by ring

/-! ### The long range `J > J_s`: the decomposition -/

/-- Helper: `∑_{j ∈ [1, J) ⊆ ℕ} g(j) = ∑_{j ∈ [1, J) ⊆ ℤ} g(j)`. -/
lemma sum_Ico_natCast_eq (g : ℤ → ℂ) (J : ℕ) :
    ∑ j ∈ Finset.Ico 1 J, g (j : ℤ) = ∑ j ∈ Finset.Ico (1 : ℤ) J, g j := by
  have h : (Finset.Ico 1 J).map Nat.castEmbedding = Finset.Ico (1 : ℤ) J := by
    ext j
    simp only [Finset.mem_map, Finset.mem_Ico, Nat.castEmbedding_apply]
    constructor
    · rintro ⟨a, ⟨h1, h2⟩, rfl⟩; omega
    · rintro ⟨h1, h2⟩; exact ⟨j.toNat, ⟨by omega, by omega⟩, by omega⟩
  rw [← h, Finset.sum_map]
  rfl

/-- **Blueprint Lemma 10.1 (`lem:lifttrunc`), the long range decomposition**: for `J ≥ 1` and
every `ξ`, the series `m_{≥J}(ξ) = ∑_{j ≥ J} 𝓕 K_j(ξ)` converges absolutely,
`∑_{1 ≤ j < J} 𝓕 K_j = m_K - m_{≥J}` and `m_{≥J} = τ_J m_K + Ê_J` (from Lemma 4.5,
`fourier_smoothErr`; here these are identities everywhere). -/
theorem truncSym_decomp (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) {J : ℕ} (hJ : 1 ≤ J)
    (ξ : EuclideanSpace ℝ (Fin n)) :
    Summable (fun i : ℕ => ‖𝓕 (dyadicKernel Ω ((J : ℤ) + i)) ξ‖) ∧
    truncSym Ω J ξ = dyadicSymbol Ω ξ - ∑' i : ℕ, 𝓕 (dyadicKernel Ω ((J : ℤ) + i)) ξ ∧
    ∑' i : ℕ, 𝓕 (dyadicKernel Ω ((J : ℤ) + i)) ξ =
      bpTau J ξ * dyadicSymbol Ω ξ + 𝓕 (smoothErr Ω J) ξ := by
  have hJ' : (1 : ℤ) ≤ J := by exact_mod_cast hJ
  obtain ⟨-, -, -, -, hF⟩ := fourier_smoothErr hn hΩ hJ'
  obtain ⟨A, -, hA, -⟩ := dyadicSymbol_spec hn hΩ
  refine ⟨(hF ξ).1, ?_, ?_⟩
  · have h := tsum_succ_eq_sum_Ico_add_tsum (g := fun j : ℤ => 𝓕 (dyadicKernel Ω j) ξ)
      (hA ξ).1.of_norm hJ'
    rw [truncSym, sum_Ico_natCast_eq (fun j : ℤ => 𝓕 (dyadicKernel Ω j) ξ), dyadicSymbol, h]
    ring
  · rw [(hF ξ).2]; ring

/-- The long range decomposition in the form used for the operators: for `J ≥ 1`,
`∑_{1 ≤ j < J} 𝓕 K_j = m_K - τ_J m_K - Ê_J` pointwise. -/
theorem truncSym_eq_sub (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) {J : ℕ} (hJ : 1 ≤ J) :
    truncSym Ω J = fun ξ =>
      dyadicSymbol Ω ξ - bpTau J ξ * dyadicSymbol Ω ξ - 𝓕 (smoothErr Ω J) ξ := by
  funext ξ
  obtain ⟨-, h1, h2⟩ := truncSym_decomp hn hΩ hJ ξ
  rw [h1, h2]; ring

/-! #### Measurability and boundedness of the long range symbols -/

lemma aestronglyMeasurable_dyadicSymbol (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) :
    AEStronglyMeasurable (dyadicSymbol Ω) volume := by
  obtain ⟨A, -, hA, -⟩ := dyadicSymbol_spec hn hΩ
  refine aestronglyMeasurable_of_tendsto_ae Filter.atTop (f := fun N ξ =>
    ∑ j ∈ Finset.range N, 𝓕 (dyadicKernel Ω ((j : ℤ) + 1)) ξ) (fun N => ?_)
    (Filter.Eventually.of_forall fun ξ => (hA ξ).2.2.1.tendsto_sum_nat)
  exact (continuous_finsetSum _ fun j _ =>
    continuous_fourier_dyadicKernel hΩ _).aestronglyMeasurable

lemma continuous_bpTau (J : ℤ) : Continuous (bpTau (n := n) J) := by
  have e : bpTau (n := n) J = 𝓕 (bpPhiDilC J) := funext fun ξ => (fourier_bpPhiDil J ξ).symm
  rw [e]
  exact (continuous_fourier_and_norm_le (integrable_bpPhiDilC J)).1

/-- `min(t, t⁻¹) ≤ 1`. -/
lemma min_self_inv_le_one (t : ℝ) : min t t⁻¹ ≤ 1 := by
  rcases le_total t 1 with h | h
  · exact (min_le_left _ _).trans h
  · exact (min_le_right _ _).trans (inv_le_one_of_one_le₀ h)

/-- Uniform bounds and measurability for `m_K`, `τ_J m_K` and `Ê_J` (`J ≥ 1`). -/
lemma long_symbols_bounds (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) :
    ∃ B : ℝ, 0 ≤ B ∧ (∀ ξ, ‖dyadicSymbol Ω ξ‖ ≤ B) ∧
      (∀ (J : ℤ) ξ, ‖bpTau J ξ * dyadicSymbol Ω ξ‖ ≤ B) ∧
      (∀ J : ℤ, 1 ≤ J → ∀ ξ, ‖𝓕 (smoothErr Ω J) ξ‖ ≤ B) ∧
      AEStronglyMeasurable (dyadicSymbol Ω) volume ∧
      (∀ J : ℤ, AEStronglyMeasurable (fun ξ => bpTau J ξ * dyadicSymbol Ω ξ) volume) ∧
      (∀ J : ℤ, 1 ≤ J → Continuous (𝓕 (smoothErr Ω J))) := by
  obtain ⟨Am, hAm0, hAm, -⟩ := dyadicSymbol_spec hn hΩ
  obtain ⟨S₀, S₁, Lτ, hS₀, -, -, hτ⟩ := norm_bpTau_le (n := n)
  obtain ⟨CE, hCE0, hCE⟩ := norm_fourier_smoothErr_le hn hΩ
  have hm := aestronglyMeasurable_dyadicSymbol hn hΩ
  refine ⟨max Am (max (S₀ * Am) CE), le_max_of_le_left hAm0, fun ξ => ?_, fun J ξ => ?_,
    fun J hJ ξ => ?_, hm, fun J => (continuous_bpTau J).aestronglyMeasurable.mul hm,
    fun J hJ => (fourier_smoothErr hn hΩ hJ).2.2.1⟩
  · exact ((hAm ξ).2.2.2).trans (le_max_left _ _)
  · rw [norm_mul]
    refine (mul_le_mul (hτ J ξ).1 (hAm ξ).2.2.2 (norm_nonneg _) hS₀).trans ?_
    exact (le_max_left _ _).trans (le_max_right _ _)
  · refine (hCE J hJ ξ).trans ?_
    have : CE * min (2 ^ J * ‖ξ‖) (2 ^ J * ‖ξ‖)⁻¹ ≤ CE :=
      mul_le_of_le_one_right hCE0 (min_self_inv_le_one _)
    exact this.trans ((le_max_right _ _).trans (le_max_right _ _))

/-! #### Signed multiplier bounds for the long range symbols -/

/-- A multiplier bound for `m` gives the same bound for `± m`. -/
lemma eLpNorm_fourierInv_sign_mul_le {m : EuclideanSpace ℝ (Fin n) → ℂ} {t : ℝ≥0∞} {A : ℝ}
    (h : ∀ G : 𝓢(EuclideanSpace ℝ (Fin n), ℂ),
      eLpNorm (𝓕⁻ (fun ξ => m ξ * 𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ)) t volume ≤
        ENNReal.ofReal A * eLpNorm G t volume)
    {ε : ℝ} (hε : ε = 1 ∨ ε = -1) (G : 𝓢(EuclideanSpace ℝ (Fin n), ℂ)) :
    eLpNorm (𝓕⁻ (fun ξ => ((ε : ℂ) * m ξ) * 𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ)) t volume ≤
      ENNReal.ofReal A * eLpNorm G t volume := by
  rcases hε with rfl | rfl
  · simpa using h G
  · have e : 𝓕⁻ (fun ξ => (((-1 : ℝ) : ℂ) * m ξ) * 𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ) =
        -𝓕⁻ (fun ξ => m ξ * 𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ) := by
      funext x
      simp only [Real.fourierInv_eq, Pi.neg_apply, ← integral_neg]
      congr 1
      funext v
      simp only [Complex.ofReal_neg, Complex.ofReal_one, neg_mul, one_mul, smul_neg]
    rw [e, eLpNorm_neg]
    exact h G

/-- Blueprint Lemma 4.5 (`lem:smootherrors`) in multiplier form on Schwartz inputs: for
`1 < t < ∞` there is `A` such that for every finite `S ⊆ ℕ` of indices `J ≥ 1` and every choice
of signs `ε_J = ±1` (`J ∈ S`), `‖𝓕⁻((∑_{J ∈ S} ε_J Ê_J) 𝓕 G)‖_t ≤ A ‖G‖_t` for Schwartz `G`. -/
theorem eLpNorm_fourierInv_sum_fourier_smoothErr_le (hn : 1 ≤ n) (hΩ : IsSWProfile Ω)
    {t : ℝ} (ht : 1 < t) :
    ∃ A : ℝ, 0 ≤ A ∧ ∀ S : Finset ℕ, (∀ J ∈ S, 1 ≤ J) → ∀ ε : ℕ → ℝ,
      (∀ J ∈ S, ε J = 1 ∨ ε J = -1) → ∀ G : 𝓢(EuclideanSpace ℝ (Fin n), ℂ),
        eLpNorm (𝓕⁻ (fun ξ => (∑ J ∈ S, (ε J : ℂ) * 𝓕 (smoothErr Ω J) ξ) *
            𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ)) (ENNReal.ofReal t) volume ≤
          ENNReal.ofReal A * eLpNorm G (ENNReal.ofReal t) volume := by
  obtain ⟨C, hC0, hC⟩ := exists_eLpNorm_convolution_sum_smul_smoothErr_le hn hΩ ht
  refine ⟨C, hC0, fun S hS ε hε G => ?_⟩
  classical
  set c : ℤ → ℂ := fun J => if J.toNat ∈ S then (ε J.toNat : ℂ) else 0 with hcdef
  have hc : ∀ J, ‖c J‖ ≤ 1 := fun J => by
    simp only [hcdef]
    split_ifs with h
    · rcases hε _ h with h1 | h1 <;> simp [h1]
    · simp
  have hS' : ∀ J ∈ S.map Nat.castEmbedding, (1 : ℤ) ≤ J := by
    intro J hJ
    obtain ⟨j, hj, rfl⟩ := Finset.mem_map.1 hJ
    simp only [Nat.castEmbedding_apply]
    exact_mod_cast hS j hj
  have hint : ∀ J ∈ S.map Nat.castEmbedding, Integrable (smoothErr Ω J) :=
    fun J hJ => integrable_smoothErr hn hΩ (hS' J hJ)
  set H := ∑ J ∈ S.map Nat.castEmbedding, c J • smoothErr Ω J with hH
  have hHi : Integrable H := integrable_finsetSum' _ fun J hJ => (hint J hJ).smul _
  have e : (fun ξ => (∑ J ∈ S, (ε J : ℂ) * 𝓕 (smoothErr Ω J) ξ) *
      𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ) = fun ξ =>
        𝓕 H ξ * 𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ := by
    funext ξ
    rw [hH, fourier_finsetSum_smul _ c hint, Finset.sum_map]
    congr 1
    refine Finset.sum_congr rfl fun j hj => ?_
    simp [hcdef, hj]
  rw [e, fourierInv_fourier_mul_eq_convolution hHi (continuous_fourier_and_norm_le hHi).2 G]
  exact hC _ hS' c hc _ (G.memLp _ _)

/-! #### The bounds for the whole multiplier and for the smoothing errors -/

/-- **Blueprint Lemma 10.1 (`lem:lifttrunc`), long range, the whole multiplier**: the one-element
case of eq. (9.10): there are `δ > 0` and `C` such that for every `s ≥ 1` and finitely supported
`f`, `‖sup_{α ∈ 𝓡_s} |Lift_{s,α}[m_K](D) f|‖_p ≤ C 2^{-δ s} ‖f‖_p`. -/
theorem lift_dyadicSymbol_bound (hn : 1 ≤ n) (hd : 1 ≤ d) (hΩ : IsSWProfile Ω) (hp : 1 < p) :
    ∃ δ : ℝ, 0 < δ ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ s : ℕ, 1 ≤ s →
      ∀ f : (Fin n → ℤ) → ℂ, (Function.support f).Finite →
        eLpNorm (fun x => (((liftRat s).sup fun aq =>
            ‖latMult (liftSym n d Ω p s aq.1 aq.2 (dyadicSymbol Ω)) f x‖₊ : ℝ≥0) : ℝ))
          (ENNReal.ofReal p) Measure.count ≤
        ENNReal.ofReal (C * (2 : ℝ) ^ (-(δ * s))) * eLpNorm f (ENNReal.ofReal p) Measure.count := by
  obtain ⟨δ, hδ, CL, hCL, hsq⟩ := lift_square_p n d hn hd Ω hp
  have ht : 1 < 2 * (paramR p : ℝ) := by
    have : (1 : ℝ) ≤ paramR p := by exact_mod_cast one_le_paramR p
    linarith
  obtain ⟨A, hA0, hA⟩ := exists_eLpNorm_fourierInv_dyadicSymbol_mul_le hn hΩ ht
  obtain ⟨B, -, hB, -, -, hm, -, -⟩ := long_symbols_bounds hn hΩ
  refine ⟨δ, hδ, CL * A, mul_nonneg hCL hA0, fun s hs f hf => ?_⟩
  have h := hsq s hs ({()} : Finset Unit) (fun _ => dyadicSymbol Ω) B A (fun _ _ => hm)
    (fun _ _ => hB) hA0 (fun ε hε G => ?_) f hf
  · simp only [Finset.sum_singleton] at h
    have e : (fun x => Real.sqrt ((((liftRat s).sup fun aq =>
        ‖latMult (liftSym n d Ω p s aq.1 aq.2 (dyadicSymbol Ω)) f x‖₊ : ℝ≥0) : ℝ) ^ 2)) =
        fun x => (((liftRat s).sup fun aq =>
          ‖latMult (liftSym n d Ω p s aq.1 aq.2 (dyadicSymbol Ω)) f x‖₊ : ℝ≥0) : ℝ) := by
      funext x; exact Real.sqrt_sq (NNReal.coe_nonneg _)
    rw [e] at h
    refine h.trans (le_of_eq ?_)
    congr 2; ring
  · simp only [Finset.sum_singleton]
    exact eLpNorm_fourierInv_sign_mul_le hA (hε () (Finset.mem_singleton_self _)) G

/-- **Blueprint Lemma 10.1 (`lem:lifttrunc`), long range, the smoothing errors, finite `J` sets**:
there are `δ > 0` and `C` such that for every `s ≥ 1`, every finite set `S` of integers `J ≥ 1`
and every finitely supported `f`,
`‖sup_{α ∈ 𝓡_s, J ∈ S} |Lift_{s,α}[Ê_J](D) f|‖_p ≤ C 2^{-δ s} ‖f‖_p` (via the square function
of eq. (9.10) and the uniform signed bounds of Lemma 4.5). -/
theorem lift_smoothErr_finset (hn : 1 ≤ n) (hd : 1 ≤ d) (hΩ : IsSWProfile Ω) (hp : 1 < p) :
    ∃ δ : ℝ, 0 < δ ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ s : ℕ, 1 ≤ s → ∀ S : Finset ℕ, (∀ J ∈ S, 1 ≤ J) →
      ∀ f : (Fin n → ℤ) → ℂ, (Function.support f).Finite →
        eLpNorm (fun x => ((((liftRat s) ×ˢ S).sup fun aJ =>
            ‖latMult (liftSym n d Ω p s aJ.1.1 aJ.1.2 (𝓕 (smoothErr Ω aJ.2))) f x‖₊ : ℝ≥0) : ℝ))
          (ENNReal.ofReal p) Measure.count ≤
        ENNReal.ofReal (C * (2 : ℝ) ^ (-(δ * s))) * eLpNorm f (ENNReal.ofReal p) Measure.count := by
  obtain ⟨δ, hδ, CL, hCL, hsq⟩ := lift_square_p n d hn hd Ω hp
  have ht : 1 < 2 * (paramR p : ℝ) := by
    have : (1 : ℝ) ≤ paramR p := by exact_mod_cast one_le_paramR p
    linarith
  obtain ⟨A, hA0, hA⟩ := eLpNorm_fourierInv_sum_fourier_smoothErr_le hn hΩ ht
  obtain ⟨B, -, -, -, hB, -, -, hc⟩ := long_symbols_bounds hn hΩ
  refine ⟨δ, hδ, CL * A, mul_nonneg hCL hA0, fun s hs S hS f hf => ?_⟩
  have hS' : ∀ J ∈ S, (1 : ℤ) ≤ J := fun J hJ => by exact_mod_cast hS J hJ
  have h := hsq s hs S (fun J => 𝓕 (smoothErr Ω J)) B A
    (fun J hJ => (hc J (hS' J hJ)).aestronglyMeasurable) (fun J hJ => hB J (hS' J hJ)) hA0
    (fun ε hε G => hA S hS ε hε G) f hf
  refine le_trans ?_ (h.trans (le_of_eq ?_))
  · refine eLpNorm_mono_real AEStronglyMeasurable.of_discrete fun x => ?_
    rw [Real.norm_of_nonneg (NNReal.coe_nonneg _)]
    refine arith_coe_finset_sup_nnnorm_le (Real.sqrt_nonneg _) ?_
    rintro ⟨aq, J⟩ haJ
    obtain ⟨haq, hJ⟩ := Finset.mem_product.1 haJ
    have hle := Finset.le_sup (f := fun aq : ℕ × ℕ =>
      ‖latMult (liftSym n d Ω p s aq.1 aq.2 (𝓕 (smoothErr Ω J))) f x‖₊) haq
    have h1 : ‖latMult (liftSym n d Ω p s aq.1 aq.2 (𝓕 (smoothErr Ω J))) f x‖ ≤
        (((liftRat s).sup fun aq =>
          ‖latMult (liftSym n d Ω p s aq.1 aq.2 (𝓕 (smoothErr Ω J))) f x‖₊ : ℝ≥0) : ℝ) := by
      exact_mod_cast hle
    refine h1.trans (Real.le_sqrt_of_sq_le ?_)
    exact Finset.single_le_sum (f := fun J : ℕ => ((((liftRat s).sup fun aq =>
      ‖latMult (liftSym n d Ω p s aq.1 aq.2 (𝓕 (smoothErr Ω J))) f x‖₊ : ℝ≥0) : ℝ) ^ 2))
      (fun _ _ => sq_nonneg _) hJ
  · congr 2; ring

/-- Helper: the `ℓ^p` norm of an `ℝ≥0`-valued function, viewed in `ℝ≥0∞` or in `ℝ`. -/
lemma eLpNorm_coe_nnreal_eq {q : ℝ≥0∞} (h : (Fin n → ℤ) → ℝ≥0) :
    eLpNorm (fun x => (h x : ℝ≥0∞)) q Measure.count =
      eLpNorm (fun x => (h x : ℝ)) q Measure.count := by
  have e : (fun x => (h x : ℝ≥0∞)) = fun x => ‖(h x : ℝ)‖ₑ := by
    funext x
    rw [Real.enorm_eq_ofReal (NNReal.coe_nonneg _), ENNReal.ofReal_coe_nnreal]
  rw [e]
  exact eLpNorm_enorm _ AEStronglyMeasurable.of_discrete

/-- Helper: `‖g a‖ₑ ≤ max_{b ∈ S} ‖g b‖₊` for `a ∈ S`. -/
lemma enorm_le_coe_finset_sup {α : Type*} {S : Finset α} {g : α → ℂ} {a : α} (ha : a ∈ S) :
    ‖g a‖ₑ ≤ ((S.sup fun b => ‖g b‖₊ : ℝ≥0) : ℝ≥0∞) := by
  rw [enorm_eq_nnnorm]
  exact ENNReal.coe_le_coe.2 (Finset.le_sup (f := fun b => ‖g b‖₊) ha)

/-- **Blueprint Lemma 10.1 (`lem:lifttrunc`), long range, the smoothing errors, all `J`**: there
are `δ > 0` and `C` such that for every `s ≥ 1` and every finitely supported `f`,
`‖sup_{α ∈ 𝓡_s, J ≥ 1} |Lift_{s,α}[Ê_J](D) f|‖_p ≤ C 2^{-δ s} ‖f‖_p` (the supremum over all
integers `J ≥ 1`, as an extended nonnegative function; in particular over all `J > J_s`),
from the finite-set bound and Lemma 2.1 (`lem:finite`). -/
theorem lift_smoothErr_sup (hn : 1 ≤ n) (hd : 1 ≤ d) (hΩ : IsSWProfile Ω) (hp : 1 < p) :
    ∃ δ : ℝ, 0 < δ ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ s : ℕ, 1 ≤ s →
      ∀ f : (Fin n → ℤ) → ℂ, (Function.support f).Finite →
        eLpNorm (fun x => ⨆ J : ℕ, ⨆ (_ : 1 ≤ J), (liftRat s).sup fun aq =>
            ‖latMult (liftSym n d Ω p s aq.1 aq.2 (𝓕 (smoothErr Ω J))) f x‖ₑ)
          (ENNReal.ofReal p) Measure.count ≤
        ENNReal.ofReal (C * (2 : ℝ) ^ (-(δ * s))) * eLpNorm f (ENNReal.ofReal p) Measure.count := by
  obtain ⟨δ, hδ, C, hC, h⟩ := lift_smoothErr_finset hn hd hΩ hp
  refine ⟨δ, hδ, C, hC, fun s hs f hf => ?_⟩
  classical
  refine eLpNorm_iSup_le_of_finset_count ENNReal.ofReal_ne_top _ _ fun F => ?_
  have hF : ∀ J ∈ F.filter (1 ≤ ·), 1 ≤ J := fun J hJ => (Finset.mem_filter.1 hJ).2
  refine le_trans ?_ ((h s hs _ hF f hf).trans_eq' (eLpNorm_coe_nnreal_eq _).symm)
  refine eLpNorm_mono_enorm AEStronglyMeasurable.of_discrete fun x => ?_
  rw [enorm_eq_self, enorm_eq_self]
  refine Finset.sup_le fun J hJ => iSup_le fun hJ1 => Finset.sup_le fun aq haq => ?_
  exact enorm_le_coe_finset_sup (g := fun aJ : (ℕ × ℕ) × ℕ =>
    latMult (liftSym n d Ω p s aJ.1.1 aJ.1.2 (𝓕 (smoothErr Ω aJ.2))) f x)
    (a := (aq, J)) (Finset.mem_product.2 ⟨haq, Finset.mem_filter.2 ⟨hJ, hJ1⟩⟩)

/-! ### Assembly: reduction of eq. (10.1) to the long smooth maximum -/

/-- Helper: for `θ < δ` there is `K` with `(s+1) 2^{-δ s} ≤ K 2^{-θ s}` for all `s ∈ ℕ`. -/
lemma exists_add_one_mul_rpow_le {δ θ : ℝ} (hθδ : θ < δ) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ s : ℕ,
      ((s : ℝ) + 1) * (2 : ℝ) ^ (-(δ * s)) ≤ K * (2 : ℝ) ^ (-(θ * s)) := by
  set b := Real.log 2 * (δ - θ) with hb
  have hb0 : 0 < b := mul_pos (Real.log_pos (by norm_num)) (by linarith)
  have hbi : 0 < b⁻¹ := inv_pos.2 hb0
  refine ⟨1 + b⁻¹, by linarith, fun s => ?_⟩
  have hs0 : (0 : ℝ) ≤ s := Nat.cast_nonneg s
  have hsplit : (2 : ℝ) ^ (-(δ * s)) =
      (2 : ℝ) ^ (-((δ - θ) * s)) * (2 : ℝ) ^ (-(θ * s)) := by
    rw [← Real.rpow_add (by norm_num)]; ring_nf
  have hexp : (2 : ℝ) ^ ((δ - θ) * s) = Real.exp (b * s) := by
    rw [Real.rpow_def_of_pos (by norm_num), hb, mul_assoc]
  have hkey : (s : ℝ) + 1 ≤ (1 + b⁻¹) * (2 : ℝ) ^ ((δ - θ) * s) := by
    rw [hexp]
    have h1 := Real.add_one_le_exp (b * s)
    have h2 : (s : ℝ) + 1 ≤ (1 + b⁻¹) * (b * s + 1) := by
      have e : (1 + b⁻¹) * (b * s + 1) = b * s + 1 + (b⁻¹ * b) * s + b⁻¹ := by ring
      rw [e, inv_mul_cancel₀ hb0.ne']
      have := mul_nonneg hb0.le hs0
      linarith
    exact h2.trans (mul_le_mul_of_nonneg_left h1 (by linarith))
  have hpos : 0 < (2 : ℝ) ^ ((δ - θ) * s) := Real.rpow_pos_of_pos (by norm_num) _
  rw [hsplit, Real.rpow_neg (by norm_num), ← mul_assoc]
  refine mul_le_mul_of_nonneg_right ?_ (Real.rpow_nonneg (by norm_num) _)
  rw [← div_eq_mul_inv, div_le_iff₀ hpos]
  exact hkey

/-- **Blueprint Lemma 10.1 (`lem:lifttrunc`), eq. (10.1) (`eq:lifttrunc`), reduced to the long
smooth maximum** (the remaining obligation): for `n, d ≥ 1`, admissible `Ω` and `1 < p < ∞`,
suppose that there are `δ' > 0` and `C'` such that for every `s ≥ 1` and every finitely
supported `f`,
`‖sup_{α ∈ 𝓡_s, J > J_s} |Lift_{s,α}[τ_J m_K](D) f|‖_p ≤ C' 2^{-δ' s} ‖f‖_p`.
Then there are `θ > 0` and `C` such that for every `s ≥ 1` and every finitely supported `f`,
`‖sup_{α ∈ 𝓡_s, J ≥ 1} |Lift_{s,α}[∑_{1 ≤ j < J} 𝓕 K_j](D) f|‖_p ≤ C 2^{-θ s} ‖f‖_p`
(suprema over integers `J`, as extended nonnegative functions). -/
theorem lift_trunc_of_long (hn : 1 ≤ n) (hd : 1 ≤ d) (hΩ : IsSWProfile Ω) (hp : 1 < p)
    (hlong : ∃ δ : ℝ, 0 < δ ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ s : ℕ, 1 ≤ s →
      ∀ f : (Fin n → ℤ) → ℂ, (Function.support f).Finite →
        eLpNorm (fun x => ⨆ J : ℕ, ⨆ (_ : truncJ n d Ω p s < J), (liftRat s).sup fun aq =>
            ‖latMult (liftSym n d Ω p s aq.1 aq.2
              (fun ξ => bpTau J ξ * dyadicSymbol Ω ξ)) f x‖ₑ)
          (ENNReal.ofReal p) Measure.count ≤
        ENNReal.ofReal (C * (2 : ℝ) ^ (-(δ * s))) * eLpNorm f (ENNReal.ofReal p) Measure.count) :
    ∃ θ : ℝ, 0 < θ ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ s : ℕ, 1 ≤ s →
      ∀ f : (Fin n → ℤ) → ℂ, (Function.support f).Finite →
        eLpNorm (fun x => ⨆ J : ℕ, ⨆ (_ : 1 ≤ J), (liftRat s).sup fun aq =>
            ‖latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω J)) f x‖ₑ)
          (ENNReal.ofReal p) Measure.count ≤
        ENNReal.ofReal (C * (2 : ℝ) ^ (-(θ * s))) * eLpNorm f (ENNReal.ofReal p) Measure.count := by
  obtain ⟨δ₁, hδ₁, C₁, hC₁, hS⟩ := lift_trunc_short hn hd hΩ hp
  obtain ⟨δ₂, hδ₂, C₂, hC₂, hM⟩ := lift_dyadicSymbol_bound hn hd hΩ hp
  obtain ⟨δ₃, hδ₃, C₃, hC₃, hE⟩ := lift_smoothErr_sup hn hd hΩ hp
  obtain ⟨δ₄, hδ₄, C₄, hC₄, hT⟩ := hlong
  set δm := min (min δ₁ δ₂) (min δ₃ δ₄) with hδm
  have hδm0 : 0 < δm := lt_min (lt_min hδ₁ hδ₂) (lt_min hδ₃ hδ₄)
  set θ := δm / 2 with hθ
  have hθ0 : 0 < θ := by rw [hθ]; linarith
  have hθδ : θ < δm := by rw [hθ]; linarith
  have hθ1 : θ < δ₁ := hθδ.trans_le ((min_le_left _ _).trans (min_le_left _ _))
  have hle : ∀ δ, δm ≤ δ → ∀ s : ℕ, (2 : ℝ) ^ (-(δ * s)) ≤ (2 : ℝ) ^ (-(θ * s)) := by
    intro δ hδ s
    refine Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_
    have : (0 : ℝ) ≤ s := Nat.cast_nonneg s
    have : θ ≤ δ := hθδ.le.trans hδ
    nlinarith
  obtain ⟨K, hK0, hK⟩ := exists_add_one_mul_rpow_le hθ1
  refine ⟨θ, hθ0, C₁ * K + C₂ + C₃ + C₄,
    add_nonneg (add_nonneg (add_nonneg (mul_nonneg hC₁ hK0) hC₂) hC₃) hC₄,
    fun s hs f hf => ?_⟩
  have hf1 : Summable fun z => ‖f z‖ := summable_of_finite_support hf
  obtain ⟨B, hB0, hBm, hBτ, hBE, hmm, hmτ, hcE⟩ := long_symbols_bounds hn hΩ
  set SR : (Fin n → ℤ) → ℝ≥0∞ := fun x => ((((liftRat s) ×ˢ (Finset.Icc 1 (truncJ n d Ω p s))).sup
    fun aJ => ‖latMult (liftSym n d Ω p s aJ.1.1 aJ.1.2 (truncSym Ω aJ.2)) f x‖₊ : ℝ≥0) :
      ℝ≥0∞) with hSR
  set MK : (Fin n → ℤ) → ℝ≥0∞ := fun x => (((liftRat s).sup fun aq =>
    ‖latMult (liftSym n d Ω p s aq.1 aq.2 (dyadicSymbol Ω)) f x‖₊ : ℝ≥0) : ℝ≥0∞) with hMK
  set TA : (Fin n → ℤ) → ℝ≥0∞ := fun x => ⨆ J : ℕ, ⨆ (_ : truncJ n d Ω p s < J),
    (liftRat s).sup fun aq => ‖latMult (liftSym n d Ω p s aq.1 aq.2
      (fun ξ => bpTau J ξ * dyadicSymbol Ω ξ)) f x‖ₑ with hTA
  set EE : (Fin n → ℤ) → ℝ≥0∞ := fun x => ⨆ J : ℕ, ⨆ (_ : 1 ≤ J),
    (liftRat s).sup fun aq => ‖latMult (liftSym n d Ω p s aq.1 aq.2
      (𝓕 (smoothErr Ω J))) f x‖ₑ with hEE
  -- the pointwise splitting into the short range and the three long range pieces
  have hpt : ∀ x, (⨆ J : ℕ, ⨆ (_ : 1 ≤ J), (liftRat s).sup fun aq =>
      ‖latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω J)) f x‖ₑ) ≤
        SR x + MK x + TA x + EE x := by
    intro x
    refine iSup_le fun J => iSup_le fun hJ => Finset.sup_le fun aq haq => ?_
    by_cases hJs : J ≤ truncJ n d Ω p s
    · have h1 : ‖latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω J)) f x‖ₑ ≤ SR x :=
        enorm_le_coe_finset_sup (g := fun aJ : (ℕ × ℕ) × ℕ =>
          latMult (liftSym n d Ω p s aJ.1.1 aJ.1.2 (truncSym Ω aJ.2)) f x) (a := (aq, J))
          (Finset.mem_product.2 ⟨haq, Finset.mem_Icc.2 ⟨hJ, hJs⟩⟩)
      refine h1.trans ?_
      rw [add_assoc, add_assoc]
      exact le_self_add
    · push Not at hJs
      have hJ' : (1 : ℤ) ≤ J := by exact_mod_cast hJ
      have e1 := latMult_liftSym_sub (d := d) (Ω := Ω) (p := p) (s := s) (a := aq.1) (q := aq.2)
        (m₁ := fun ξ => dyadicSymbol Ω ξ - bpTau J ξ * dyadicSymbol Ω ξ)
        (m₂ := 𝓕 (smoothErr Ω J)) (hmm.sub (hmτ J)) (hcE J hJ').aestronglyMeasurable
        (B := B + B) (fun ξ => (norm_sub_le _ _).trans (add_le_add (hBm ξ) (hBτ J ξ)))
        (fun ξ => (hBE J hJ' ξ).trans (by linarith)) hf1 x
      have e2 := latMult_liftSym_sub (d := d) (Ω := Ω) (p := p) (s := s) (a := aq.1) (q := aq.2)
        (m₁ := dyadicSymbol Ω) (m₂ := fun ξ => bpTau J ξ * dyadicSymbol Ω ξ) hmm (hmτ J)
        (B := B) hBm (hBτ J) hf1 x
      beta_reduce at e1 e2
      rw [truncSym_eq_sub hn hΩ hJ, e1, e2]
      have h1 : ‖latMult (liftSym n d Ω p s aq.1 aq.2 (dyadicSymbol Ω)) f x‖ₑ ≤ MK x :=
        enorm_le_coe_finset_sup (g := fun aq : ℕ × ℕ =>
          latMult (liftSym n d Ω p s aq.1 aq.2 (dyadicSymbol Ω)) f x) haq
      have h2 : ‖latMult (liftSym n d Ω p s aq.1 aq.2
          (fun ξ => bpTau J ξ * dyadicSymbol Ω ξ)) f x‖ₑ ≤ TA x :=
        le_iSup_of_le J (le_iSup_of_le hJs (Finset.le_sup (f := fun aq : ℕ × ℕ =>
          ‖latMult (liftSym n d Ω p s aq.1 aq.2
            (fun ξ => bpTau J ξ * dyadicSymbol Ω ξ)) f x‖ₑ) haq))
      have h3 : ‖latMult (liftSym n d Ω p s aq.1 aq.2 (𝓕 (smoothErr Ω J))) f x‖ₑ ≤ EE x :=
        le_iSup_of_le J (le_iSup_of_le hJ (Finset.le_sup (f := fun aq : ℕ × ℕ =>
          ‖latMult (liftSym n d Ω p s aq.1 aq.2 (𝓕 (smoothErr Ω J))) f x‖ₑ) haq))
      calc _ ≤ ‖latMult (liftSym n d Ω p s aq.1 aq.2 (dyadicSymbol Ω)) f x -
              latMult (liftSym n d Ω p s aq.1 aq.2
                (fun ξ => bpTau J ξ * dyadicSymbol Ω ξ)) f x‖ₑ +
            ‖latMult (liftSym n d Ω p s aq.1 aq.2 (𝓕 (smoothErr Ω J))) f x‖ₑ := enorm_sub_le
        _ ≤ ‖latMult (liftSym n d Ω p s aq.1 aq.2 (dyadicSymbol Ω)) f x‖ₑ +
              ‖latMult (liftSym n d Ω p s aq.1 aq.2
                (fun ξ => bpTau J ξ * dyadicSymbol Ω ξ)) f x‖ₑ +
            ‖latMult (liftSym n d Ω p s aq.1 aq.2 (𝓕 (smoothErr Ω J))) f x‖ₑ :=
          add_le_add enorm_sub_le le_rfl
        _ ≤ MK x + TA x + EE x := add_le_add (add_le_add h1 h2) h3
        _ ≤ SR x + MK x + TA x + EE x := by
          rw [add_assoc (SR x), add_assoc (SR x)]
          rw [add_assoc (MK x)]
          exact le_add_self
  have hp1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hp.le
  set X : ℝ := (2 : ℝ) ^ (-(θ * s)) with hX
  have hX0 : 0 ≤ X := Real.rpow_nonneg (by norm_num) _
  set nf := eLpNorm f (ENNReal.ofReal p) Measure.count
  have hSRb : eLpNorm SR (ENNReal.ofReal p) Measure.count ≤ ENNReal.ofReal (C₁ * K * X) * nf := by
    rw [hSR, eLpNorm_coe_nnreal_eq]
    refine (hS s hs f hf).trans (mul_le_mul_left (ENNReal.ofReal_le_ofReal ?_) _)
    have := hK s
    rw [mul_assoc, mul_assoc]
    exact mul_le_mul_of_nonneg_left this hC₁
  have hMKb : eLpNorm MK (ENNReal.ofReal p) Measure.count ≤ ENNReal.ofReal (C₂ * X) * nf := by
    rw [hMK, eLpNorm_coe_nnreal_eq]
    refine (hM s hs f hf).trans (mul_le_mul_left (ENNReal.ofReal_le_ofReal ?_) _)
    exact mul_le_mul_of_nonneg_left (hle δ₂ ((min_le_left _ _).trans (min_le_right _ _)) s) hC₂
  have hTAb : eLpNorm TA (ENNReal.ofReal p) Measure.count ≤ ENNReal.ofReal (C₄ * X) * nf := by
    refine (hT s hs f hf).trans (mul_le_mul_left (ENNReal.ofReal_le_ofReal ?_) _)
    exact mul_le_mul_of_nonneg_left (hle δ₄ ((min_le_right _ _).trans (min_le_right _ _)) s) hC₄
  have hEEb : eLpNorm EE (ENNReal.ofReal p) Measure.count ≤ ENNReal.ofReal (C₃ * X) * nf := by
    refine (hE s hs f hf).trans (mul_le_mul_left (ENNReal.ofReal_le_ofReal ?_) _)
    exact mul_le_mul_of_nonneg_left (hle δ₃ ((min_le_right _ _).trans (min_le_left _ _)) s) hC₃
  calc eLpNorm (fun x => ⨆ J : ℕ, ⨆ (_ : 1 ≤ J), (liftRat s).sup fun aq =>
          ‖latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω J)) f x‖ₑ)
          (ENNReal.ofReal p) Measure.count
      ≤ eLpNorm (SR + MK + TA + EE) (ENNReal.ofReal p) Measure.count := by
        refine eLpNorm_mono_enorm AEStronglyMeasurable.of_discrete fun x => ?_
        rw [enorm_eq_self, enorm_eq_self]
        exact hpt x
    _ ≤ eLpNorm SR (ENNReal.ofReal p) Measure.count + eLpNorm MK (ENNReal.ofReal p) Measure.count +
          eLpNorm TA (ENNReal.ofReal p) Measure.count +
          eLpNorm EE (ENNReal.ofReal p) Measure.count := by
        refine (eLpNorm_add_le hp1).trans (add_le_add ?_ le_rfl)
        refine (eLpNorm_add_le hp1).trans (add_le_add ?_ le_rfl)
        exact eLpNorm_add_le hp1
    _ ≤ ENNReal.ofReal (C₁ * K * X) * nf + ENNReal.ofReal (C₂ * X) * nf +
          ENNReal.ofReal (C₄ * X) * nf + ENNReal.ofReal (C₃ * X) * nf :=
        add_le_add (add_le_add (add_le_add hSRb hMKb) hTAb) hEEb
    _ = ENNReal.ofReal ((C₁ * K + C₂ + C₃ + C₄) * X) * nf := by
        rw [← add_mul, ← add_mul, ← add_mul, ← ENNReal.ofReal_add (by positivity) (by positivity),
          ← ENNReal.ofReal_add (by positivity) (by positivity),
          ← ENNReal.ofReal_add (by positivity) (by positivity)]
        congr 2
        ring

/-! ### The long smooth maximum `τ_J m_K`, `J > J_s` (second part of the proof) -/

/-! #### Symbol calculus: Gauss sums, the expansion of `Lift`, modulation, products -/

/-- `|S(α, β)| ≤ 1`. -/
lemma norm_gaussSum_le_one (a : ℕ) {q : ℕ} (hq : 1 ≤ q) (b : Fin n → Fin q) :
    ‖gaussSum n d a q b‖ ≤ 1 := by
  unfold gaussSum
  rw [norm_mul, norm_inv, norm_pow, Complex.norm_natCast]
  have hq0 : (0 : ℝ) < (q : ℝ) ^ n := by
    have : (0 : ℝ) < q := by exact_mod_cast hq
    positivity
  rw [inv_mul_le_iff₀ hq0, mul_one]
  refine (norm_sum_le _ _).trans ?_
  simp [norm_eC]

/-- The lifted operator as a sum of modulated periodic multipliers:
`Lift_{s,a/q}[m](D) f(x) = ∑_b S(a/q, b/q) e(x · b/q) (m χ_s)_per(D) (M_{-b/q} f)(x)`. -/
lemma latMult_liftSym_eq_sum {s a q : ℕ} {m : EuclideanSpace ℝ (Fin n) → ℂ}
    (hm : Integrable fun ξ => m ξ * (liftChi n d Ω p s ξ : ℂ))
    {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) (x : Fin n → ℤ) :
    latMult (liftSym n d Ω p s a q m) f x = ∑ b : Fin n → Fin q, gaussSum n d a q b *
      (eC (inner ℝ (latEmbed x) (gridPt q b)) *
        latMult (periodize fun η => m η * (liftChi n d Ω p s η : ℂ))
          (latModulate (-gridPt q b) f) x) := by
  have e : liftSym n d Ω p s a q m = fun ξ => ∑ b : Fin n → Fin q, gaussSum n d a q b *
      (fun ξ => periodize (fun η => m η * (liftChi n d Ω p s η : ℂ)) (ξ - gridPt q b)) ξ := rfl
  rw [e, latMult_sum_mul _ _ (fun b _ => ?_) hf x]
  · refine Finset.sum_congr rfl fun b _ => ?_
    rw [latMult_comp_sub (periodize_add_latEmbed _) (gridPt q b) f]
    rfl
  · simp_rw [periodize_comp_sub]
    exact integrableOn_periodize (hm.comp_sub_right _)

/-- `(e(-u · η) g)_per = e(-u · ζ) g_per` for `u ∈ ℤⁿ`. -/
lemma periodize_eC_mul (u : Fin n → ℤ) (g : EuclideanSpace ℝ (Fin n) → ℂ)
    (ζ : EuclideanSpace ℝ (Fin n)) :
    periodize (fun η => eC (-inner ℝ (latEmbed u) η) * g η) ζ =
      eC (-inner ℝ (latEmbed u) ζ) * periodize g ζ := by
  unfold periodize
  rw [← tsum_mul_left]
  congr 1; funext k
  simp only
  congr 1
  rw [inner_sub_right, neg_sub, sub_eq_add_neg, eC_add, inner_latEmbed_latEmbed, eC_intCast,
    one_mul]

/-- Output translation: `[e(-u · ξ) P](D) g (x) = P(D) g (x - u)`. -/
lemma latMult_eC_mul (u : Fin n → ℤ) (P : EuclideanSpace ℝ (Fin n) → ℂ)
    (g : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) :
    latMult (fun ξ => eC (-inner ℝ (latEmbed u) ξ) * P ξ) g x = latMult P g (x - u) := by
  unfold latMult
  congr 1; funext ξ
  rw [latEmbed_sub, inner_sub_left, sub_eq_add_neg, eC_add]; ring

/-- Products of periodizations of symbols supported in `[-1/4, 1/4]ⁿ` are periodizations of the
products. -/
lemma periodize_mul_eq {A B : EuclideanSpace ℝ (Fin n) → ℂ}
    (hA : ∀ η, A η ≠ 0 → ∀ i, |η i| ≤ 1 / 4) (hB : ∀ η, B η ≠ 0 → ∀ i, |η i| ≤ 1 / 4)
    (ζ : EuclideanSpace ℝ (Fin n)) :
    periodize (fun η => A η * B η) ζ = periodize A ζ * periodize B ζ := by
  have huniq : ∀ k k' : Fin n → ℤ, (∀ i, |(ζ - latEmbed k) i| ≤ 1 / 4) →
      (∀ i, |(ζ - latEmbed k') i| ≤ 1 / 4) → k = k' := by
    intro k k' hk hk'
    refine eq_of_abs_sub_intCast_le (ε := 1 / 8) (η := ζ) (by norm_num) (fun i => ?_) (fun i => ?_)
    · have := hk i; simp only [PiLp.sub_apply, latEmbed_apply] at this; linarith
    · have := hk' i; simp only [PiLp.sub_apply, latEmbed_apply] at this; linarith
  by_cases h : ∃ k : Fin n → ℤ, B (ζ - latEmbed k) ≠ 0
  · obtain ⟨k, hk⟩ := h
    have hB' : periodize B ζ = B (ζ - latEmbed k) := by
      rw [periodize, tsum_eq_single k]
      intro k' hk'
      by_contra h'
      exact hk' (huniq _ _ (hB _ h') (hB _ hk))
    have hA' : periodize A ζ = A (ζ - latEmbed k) := by
      rw [periodize, tsum_eq_single k]
      intro k' hk'
      by_contra h'
      exact hk' (huniq _ _ (hA _ h') (hB _ hk))
    rw [hA', hB', periodize, tsum_eq_single k]
    intro k' hk'
    by_contra h'
    have h2 : B (ζ - latEmbed k') ≠ 0 := fun h0 => h' (by simp [h0])
    exact hk' (huniq _ _ (hB _ h2) (hB _ hk))
  · push Not at h
    have h1 : periodize B ζ = 0 := by simp [periodize, h]
    have h2 : periodize (fun η => A η * B η) ζ = 0 := by simp [periodize, h]
    rw [h1, h2, mul_zero]

/-- `supp τ_J ⊆ [-1/16, 1/16]ⁿ` for `J ≥ 0`. -/
lemma bpTau_ne_zero_abs_le {J : ℤ} (hJ : 0 ≤ J) (η : EuclideanSpace ℝ (Fin n))
    (hη : bpTau J η ≠ 0) (i : Fin n) : |η i| ≤ 1 / 16 := by
  by_contra h
  push Not at h
  apply hη
  refine bpTau_eq_zero J ⟨i, lt_of_le_of_lt ?_ h⟩
  have : (2 : ℝ) ^ (-J) ≤ 1 := zpow_le_one_of_nonpos₀ (by norm_num) (by omega)
  linarith

lemma integrable_bpTau {J : ℤ} (hJ : 0 ≤ J) : Integrable (bpTau (n := n) J) :=
  (continuous_bpTau J).integrable_of_hasCompactSupport
    (HasCompactSupport.intro (isCompact_box (1 / 16)) fun ξ hξ => by
      by_contra h
      exact hξ (bpTau_ne_zero_abs_le hJ ξ h))

/-- `𝓕⁻ τ_J = φ_J`. -/
lemma fourierInv_bpTau {J : ℤ} (hJ : 0 ≤ J) : 𝓕⁻ (bpTau (n := n) J) = bpPhiDilC J := by
  have e : bpTau (n := n) J = 𝓕 (bpPhiDilC J) := funext fun ξ => (fourier_bpPhiDil J ξ).symm
  have hi : Integrable (𝓕 (bpPhiDilC (n := n) J)) := e ▸ integrable_bpTau hJ
  rw [e]
  exact (contDiff_bpPhiDilC J).continuous.fourierInv_fourier_eq (integrable_bpPhiDilC J) hi

/-- The lattice kernel of `(τ_J)_per` is the sampled `φ_J`. -/
lemma latKernel_periodize_bpTau {J : ℤ} (hJ : 0 ≤ J) (y : Fin n → ℤ) :
    latKernel (periodize (bpTau J)) y = (bpPhiDil J (latEmbed y) : ℂ) := by
  rw [latKernel_periodize (integrable_bpTau hJ), fourierInv_bpTau hJ]; rfl

/-- The sampled `φ_J` is in `ℓ¹` (`J ≥ 0`). -/
lemma summable_bpPhiDil_latEmbed {J : ℤ} (hJ : 0 ≤ J) :
    Summable fun y : Fin n → ℤ => ‖(bpPhiDil J (latEmbed y) : ℂ)‖ := by
  have hR : (1 : ℝ) ≤ 2 ^ J := one_le_zpow₀ (by norm_num) hJ
  refine Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun y => ?_)
    ((summable_latEnvelope_and_tsum_le (n := n) hR).1.mul_left (bpPhiConst n))
  rw [Complex.norm_real, Real.norm_of_nonneg (bpPhiDil_nonneg _ _)]
  exact bpPhiDil_le_envelope J _

lemma continuous_periodize_bpTau {J : ℤ} (hJ : 0 ≤ J) :
    Continuous (periodize (bpTau (n := n) J)) :=
  continuous_periodize_of_support (continuous_bpTau J) (c := 1 / 16) (by norm_num)
    (bpTau_ne_zero_abs_le hJ)

/-- Blueprint Lemma 6.1 in the form used for (10.3): multiplication of a symbol `g` supported in
`[-1/4, 1/4]ⁿ` by `τ_J` corresponds, after periodization, to convolution with the sampled `φ_J`. -/
lemma latMult_periodize_bpTau_mul {J : ℤ} (hJ : 0 ≤ J) {g : EuclideanSpace ℝ (Fin n) → ℂ}
    (hg : Integrable g) (hgs : ∀ η, g η ≠ 0 → ∀ i, |η i| ≤ 1 / 4) {f : (Fin n → ℤ) → ℂ}
    (hf : Summable fun z => ‖f z‖) (x : Fin n → ℤ) :
    latMult (periodize fun η => bpTau J η * g η) f x =
      ∑' y, (bpPhiDil J (latEmbed y) : ℂ) * latMult (periodize g) f (x - y) := by
  have e : periodize (fun η => bpTau J η * g η) =
      fun ξ => periodize (bpTau J) ξ * periodize g ξ :=
    funext (periodize_mul_eq (fun η h i => (bpTau_ne_zero_abs_le hJ η h i).trans (by norm_num))
      hgs)
  rw [e, latMult_mul_eq_tsum (continuous_periodize_bpTau hJ) (periodize_add_latEmbed _)
    ((summable_bpPhiDil_latEmbed hJ).congr fun y => by rw [latKernel_periodize_bpTau hJ])
    (integrableOn_periodize hg) hf x]
  simp_rw [latKernel_periodize_bpTau hJ]

/-! #### The operators `K_s`, `G_β = K_s M_{-β} f` and `H_{α,v}` -/

/-- The symbol `(m_K χ_s)_per` of the lattice operator `K_s` of Blueprint Lemma 10.1. -/
noncomputable def truncKs (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ) :
    EuclideanSpace ℝ (Fin n) → ℂ :=
  periodize fun η => dyadicSymbol Ω η * (liftChi n d Ω p s η : ℂ)

/-- `G_β = K_s M_{-β} f`, `β = b/q`, of Blueprint Lemma 10.1. -/
noncomputable def truncG (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s q : ℕ)
    (b : Fin n → Fin q) (f : (Fin n → ℤ) → ℂ) : (Fin n → ℤ) → ℂ :=
  latMult (truncKs n d Ω p s) (latModulate (-gridPt q b) f)

/-- `H_{α,v}(z) = ∑_{β ∈ T[q]} S(α, β) e(v · β) G_β(z)`, `α = a/q`, of Blueprint Lemma 10.1
(Mathlib sign). -/
noncomputable def truncH (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s a q : ℕ)
    (f : (Fin n → ℤ) → ℂ) (v z : Fin n → ℤ) : ℂ :=
  ∑ b : Fin n → Fin q, gaussSum n d a q b *
    (eC (inner ℝ (latEmbed v) (gridPt q b)) * truncG n d Ω p s q b f z)

lemma integrable_dyadicSymbol_mul_liftChi (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) (s : ℕ) :
    Integrable fun η => dyadicSymbol Ω η * (liftChi n d Ω p s η : ℂ) := by
  obtain ⟨B, -, hB, -, -, hm, -, -⟩ := long_symbols_bounds hn hΩ
  exact integrable_mul_liftChi hm fun ξ _ => hB ξ

/-- `supp (m χ_s) ⊆ [-1/8, 1/8]ⁿ`. -/
lemma mul_liftChi_ne_zero_abs_le {s : ℕ} {m : EuclideanSpace ℝ (Fin n) → ℂ}
    (η : EuclideanSpace ℝ (Fin n)) (h : m η * (liftChi n d Ω p s η : ℂ) ≠ 0) (i : Fin n) :
    |η i| ≤ 1 / 8 := by
  have h1 : liftChi n d Ω p s η ≠ 0 := fun h0 => h (by rw [h0, Complex.ofReal_zero, mul_zero])
  have h2 := support_liftChi (n := n) (d := d) (Ω := Ω) (p := p) s h1 i
  have hL := eight_le_liftL (n := n) (d := d) (Ω := Ω) (p := p) s
  refine h2.trans ?_
  rw [div_le_div_iff₀ (by linarith) (by norm_num)]; linarith

lemma summable_latModulate {β : EuclideanSpace ℝ (Fin n)} {f : (Fin n → ℤ) → ℂ}
    (hf : Summable fun z => ‖f z‖) : Summable fun z => ‖latModulate β f z‖ :=
  hf.congr fun z => by rw [latModulate, norm_mul, norm_eC, one_mul]

/-- `G_β` is bounded for `f ∈ ℓ¹`. -/
lemma truncG_bounded (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) (s q : ℕ) (b : Fin n → Fin q)
    {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) :
    ∃ M : ℝ, ∀ z, ‖truncG n d Ω p s q b f z‖ ≤ M :=
  ⟨_, fun z => norm_latMult_le (integrableOn_periodize
    (integrable_dyadicSymbol_mul_liftChi (d := d) (p := p) hn hΩ s)) (summable_latModulate hf) z⟩

/-- **Eq. (10.3) (`eq:Ishift`) at `u = 0`**: for `J ≥ 0`,
`Lift_{s,a/q}[τ_J m_K](D) f(x) = ∑_y φ_J(y) H_{a/q,x}(x - y)` (`f ∈ ℓ¹`). -/
lemma latMult_liftSym_bpTau_eq (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) {J : ℤ} (hJ : 0 ≤ J)
    (s a q : ℕ) {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) (x : Fin n → ℤ) :
    latMult (liftSym n d Ω p s a q (fun ξ => bpTau J ξ * dyadicSymbol Ω ξ)) f x =
      ∑' y, (bpPhiDil J (latEmbed y) : ℂ) * truncH n d Ω p s a q f x (x - y) := by
  obtain ⟨B, -, -, hBτ, -, hm, hmτ, -⟩ := long_symbols_bounds hn hΩ
  have hint : Integrable fun ξ => (bpTau J ξ * dyadicSymbol Ω ξ) * (liftChi n d Ω p s ξ : ℂ) :=
    integrable_mul_liftChi (hmτ J) fun ξ _ => hBτ J ξ
  rw [latMult_liftSym_eq_sum hint hf x]
  have e2 : ∀ b : Fin n → Fin q, latMult (periodize fun η =>
      (bpTau J η * dyadicSymbol Ω η) * (liftChi n d Ω p s η : ℂ)) (latModulate (-gridPt q b) f) x =
      ∑' y, (bpPhiDil J (latEmbed y) : ℂ) * truncG n d Ω p s q b f (x - y) := by
    intro b
    have e3 : (fun η => (bpTau J η * dyadicSymbol Ω η) * (liftChi n d Ω p s η : ℂ)) =
        fun η => bpTau J η * (dyadicSymbol Ω η * (liftChi n d Ω p s η : ℂ)) := by
      funext η; ring
    rw [e3]
    exact latMult_periodize_bpTau_mul hJ (integrable_dyadicSymbol_mul_liftChi hn hΩ s)
      (fun η h i => (mul_liftChi_ne_zero_abs_le η h i).trans (by norm_num))
      (summable_latModulate hf) x
  simp_rw [e2]
  unfold truncH
  simp_rw [Finset.mul_sum]
  rw [Summable.tsum_finsetSum]
  · refine Finset.sum_congr rfl fun b _ => ?_
    rw [← tsum_mul_left, ← tsum_mul_left]
    congr 1; funext y; ring
  · intro b _
    obtain ⟨M, hM⟩ := truncG_bounded (d := d) (p := p) hn hΩ s q b hf
    refine Summable.of_norm_bounded ((summable_bpPhiDil_latEmbed hJ).mul_right M) fun y => ?_
    rw [norm_mul, norm_mul, norm_mul, norm_eC, one_mul]
    refine mul_le_mul_of_nonneg_left ?_ (norm_nonneg _)
    calc ‖gaussSum n d a q b‖ * ‖truncG n d Ω p s q b f (x - y)‖
        ≤ 1 * M := by
          rcases Nat.eq_zero_or_pos q with rfl | hq
          · exact (b ⟨0, by omega⟩).elim0
          · exact mul_le_mul (norm_gaussSum_le_one a hq b) (hM _) (norm_nonneg _) zero_le_one
      _ = M := one_mul M

/-- **The inner expression of the averaging argument**: `u ∈ ℤⁿ`,
`Lift_{s,a/q}[e(-u · ξ) m_K](D) f(x) = H_{a/q,x}(x - u)` (`f ∈ ℓ¹`). -/
lemma latMult_liftSym_eC_eq (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) (u : Fin n → ℤ) (s a q : ℕ)
    {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) (x : Fin n → ℤ) :
    latMult (liftSym n d Ω p s a q
        (fun ξ => eC (-inner ℝ (latEmbed u) ξ) * dyadicSymbol Ω ξ)) f x =
      truncH n d Ω p s a q f x (x - u) := by
  obtain ⟨B, -, hB, -, -, hm, -, -⟩ := long_symbols_bounds hn hΩ
  have hint : Integrable fun ξ => (eC (-inner ℝ (latEmbed u) ξ) * dyadicSymbol Ω ξ) *
      (liftChi n d Ω p s ξ : ℂ) := by
    refine integrable_mul_liftChi (((by fun_prop : Continuous fun ξ : EuclideanSpace ℝ (Fin n) =>
      eC (-inner ℝ (latEmbed u) ξ))).aestronglyMeasurable.mul hm) (B := B) fun ξ _ => ?_
    rw [norm_mul, norm_eC, one_mul]; exact hB ξ
  rw [latMult_liftSym_eq_sum hint hf x]
  unfold truncH truncG
  refine Finset.sum_congr rfl fun b _ => ?_
  have e : periodize (fun η => (eC (-inner ℝ (latEmbed u) η) * dyadicSymbol Ω η) *
      (liftChi n d Ω p s η : ℂ)) =
      fun ζ => eC (-inner ℝ (latEmbed u) ζ) * truncKs n d Ω p s ζ := by
    funext ζ
    rw [truncKs, ← periodize_eC_mul]
    congr 1; funext η; ring
  rw [e, latMult_eC_mul]

/-! #### The translation bound for `φ_J` -/

/-- The translation bound of Blueprint Lemma 10.1: there is `C` such that for all `J ∈ ℤ` and
`‖z‖ ≤ 2^J`, `|φ_J(w) - φ_J(w - z)| ≤ C ‖z‖ 2^{-J} B_{2^J}(w)` (mean value theorem and the
Schwartz derivative bounds for `φ`). -/
lemma exists_norm_bpPhiDil_sub_le (n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (J : ℤ) (w z : EuclideanSpace ℝ (Fin n)), ‖z‖ ≤ (2 : ℝ) ^ J →
      ‖(bpPhiDil J w : ℂ) - (bpPhiDil J (w - z) : ℂ)‖ ≤
        C * ‖z‖ * ((2 : ℝ) ^ J)⁻¹ * envelope n ((2 : ℝ) ^ J) w := by
  obtain ⟨Q, hQ0, hQ⟩ := norm_iteratedFDeriv_bpPhiDilC_le (n := n) 1 (n + 1)
  refine ⟨Q * 2 ^ (n + 1), by positivity, fun J w z hz => ?_⟩
  set R : ℝ := (2 : ℝ) ^ J with hRdef
  have hR : 0 < R := by positivity
  have hM : ∀ t ∈ Icc (0 : ℝ) 1, ‖fderiv ℝ (bpPhiDilC J) (w - t • z)‖ ≤
      Q * 2 ^ (n + 1) * R⁻¹ * envelope n R w := by
    intro t ht
    have h1 := hQ J (w - t • z)
    rw [norm_iteratedFDeriv_one] at h1
    refine h1.trans ?_
    have htz : ‖t • z‖ ≤ R := by
      rw [norm_smul, Real.norm_of_nonneg ht.1]
      calc t * ‖z‖ ≤ 1 * R := mul_le_mul ht.2 hz (norm_nonneg _) zero_le_one
        _ = R := one_mul R
    have htri : ‖w‖ ≤ ‖w - t • z‖ + ‖t • z‖ := by
      have := norm_add_le (w - t • z) (t • z)
      rwa [sub_add_cancel] at this
    set a := 1 + ‖w - t • z‖ / R with ha
    set b := 1 + ‖w‖ / R with hb
    have ha0 : 0 < a := by positivity
    have hb0 : 0 < b := by positivity
    have hlow : b ≤ 2 * a := by
      rw [ha, hb]
      have : ‖w‖ / R ≤ ‖w - t • z‖ / R + 1 := by
        rw [div_add_one hR.ne', div_le_div_iff_of_pos_right hR]; linarith
      have : 0 ≤ ‖w - t • z‖ / R := by positivity
      linarith
    have hpow : b ^ (n + 1) ≤ 2 ^ (n + 1) * a ^ (n + 1) := by
      rw [← mul_pow]; exact pow_le_pow_left₀ hb0.le hlow _
    have hR' : ((2 : ℝ) ^ J) = R := rfl
    rw [hR', envelope, ← hb]
    rw [div_le_iff₀ (by positivity)]
    calc Q = Q * 2 ^ (n + 1) * R⁻¹ * ((R ^ n)⁻¹ * (b ^ (n + 1))⁻¹) *
          (R ^ (n + 1) * b ^ (n + 1) / 2 ^ (n + 1)) := by
          field_simp; ring
      _ ≤ Q * 2 ^ (n + 1) * R⁻¹ * ((R ^ n)⁻¹ * (b ^ (n + 1))⁻¹) * (R ^ (n + 1) * a ^ (n + 1)) := by
          refine mul_le_mul_of_nonneg_left ?_ (by positivity)
          rw [div_le_iff₀ (by positivity), mul_assoc, mul_comm (a ^ (n + 1))]
          exact mul_le_mul_of_nonneg_left hpow (by positivity)
  have hdiff : Differentiable ℝ (bpPhiDilC (n := n) J) :=
    (contDiff_bpPhiDilC J).differentiable (by simp)
  have h := norm_sub_le_of_norm_fderiv_segment hdiff hM (s := 1) ⟨zero_le_one, le_rfl⟩
  rw [one_smul, mul_one] at h
  rw [norm_sub_rev]
  calc ‖(bpPhiDil J (w - z) : ℂ) - (bpPhiDil J w : ℂ)‖
      = ‖bpPhiDilC J (w - z) - bpPhiDilC J w‖ := rfl
    _ ≤ Q * 2 ^ (n + 1) * R⁻¹ * envelope n R w * ‖z‖ := h
    _ = Q * 2 ^ (n + 1) * ‖z‖ * R⁻¹ * envelope n R w := by ring

/-! #### Bounds and periodicity of `H_{α,v}` -/

lemma norm_truncH_le (s a : ℕ) {q : ℕ} (hq : 1 ≤ q) (f : (Fin n → ℤ) → ℂ) (v z : Fin n → ℤ) :
    ‖truncH n d Ω p s a q f v z‖ ≤ ∑ b : Fin n → Fin q, ‖truncG n d Ω p s q b f z‖ := by
  unfold truncH
  refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun b _ => ?_)
  rw [norm_mul, norm_mul, norm_eC, one_mul]
  calc ‖gaussSum n d a q b‖ * ‖truncG n d Ω p s q b f z‖ ≤ 1 * ‖truncG n d Ω p s q b f z‖ :=
        mul_le_mul_of_nonneg_right (norm_gaussSum_le_one a hq b) (norm_nonneg _)
    _ = _ := one_mul _

/-- `H_{α,v}` depends on `v` only modulo `q`. -/
lemma truncH_congr (s a : ℕ) {q : ℕ} (hq : 1 ≤ q) (f : (Fin n → ℤ) → ℂ) {v v' : Fin n → ℤ}
    (h : ∀ i, (q : ℤ) ∣ v i - v' i) (z : Fin n → ℤ) :
    truncH n d Ω p s a q f v z = truncH n d Ω p s a q f v' z := by
  unfold truncH
  refine Finset.sum_congr rfl fun b _ => ?_
  choose k hk using h
  have hq0 : (q : ℝ) ≠ 0 := by exact_mod_cast (show q ≠ 0 by omega)
  have e : inner ℝ (latEmbed v) (gridPt q b) =
      inner ℝ (latEmbed v') (gridPt q b) + ((∑ i, k i * ((b i : ℕ) : ℤ) : ℤ) : ℝ) := by
    simp only [gridPt, PiLp.inner_apply, latEmbed_apply, RCLike.inner_apply, conj_trivial]
    push_cast
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun i _ => ?_
    have hki : (v i : ℝ) = v' i + q * k i := by
      have := congrArg (fun t : ℤ => (t : ℝ)) (hk i)
      push_cast at this; linarith
    rw [hki]
    field_simp
  rw [e, eC_add, eC_intCast, mul_one]

/-- The change of variables of the averaging argument: for `F(v, z)` depending on `v` only
modulo `Q`, `∑_{u ∈ 𝒱} ∑_x F(x, x - u) = ∑_{v ∈ 𝒱} ∑_z F(v, z)`, `𝒱 = {0, …, Q-1}ⁿ`
(the bijection `(x, u) ↦ (z = x - u, v = x mod Q)`). -/
lemma sum_tsum_sub_finIntVec_eq {Q : ℕ} [NeZero Q]
    (F : (Fin n → ℤ) → (Fin n → ℤ) → ℝ≥0∞)
    (hF : ∀ v v' z, (∀ i, (Q : ℤ) ∣ v i - v' i) → F v z = F v' z) :
    ∑ u : Fin n → Fin Q, ∑' x, F x (x - finIntVec u) =
      ∑ v : Fin n → Fin Q, ∑' z, F (finIntVec v) z := by
  have h1 : ∀ u : Fin n → Fin Q, ∑' x, F x (x - finIntVec u) = ∑' z, F (z + finIntVec u) z := by
    intro u
    rw [← (Equiv.addRight (finIntVec u)).tsum_eq]
    simp only [Equiv.coe_addRight, add_sub_cancel_right]
  simp_rw [h1]
  rw [← Summable.tsum_finsetSum (fun _ _ => ENNReal.summable),
    ← Summable.tsum_finsetSum (fun _ _ => ENNReal.summable)]
  congr 1; funext z
  have hQ : 1 ≤ Q := Nat.one_le_iff_ne_zero.2 (NeZero.ne Q)
  set c : Fin n → Fin Q := resVec hQ z with hc
  refine Fintype.sum_equiv (Equiv.addLeft c) _ _ fun u => hF _ _ _ fun i => ?_
  have hci : ((c i : ℕ) : ℤ) = z i % Q := finIntVec_resVec hQ z i
  have e : finIntVec ((Equiv.addLeft c) u) i = (z i % Q + ((u i : ℕ) : ℤ)) % Q := by
    simp only [Equiv.coe_addLeft, finIntVec, Pi.add_apply, Fin.val_add]
    push_cast
    rw [hci]
  rw [e, Pi.add_apply]
  have hm : (z i % Q + ((u i : ℕ) : ℤ)) % Q ≡ z i + finIntVec u i [ZMOD Q] :=
    (Int.mod_modEq _ _).trans ((Int.mod_modEq _ _).add_right _)
  exact hm.dvd


/-! #### `ℓ^p` bookkeeping for `ℝ≥0∞`-valued functions on `ℤⁿ` -/

lemma eLpNorm_count_ennreal_eq (g : (Fin n → ℤ) → ℝ≥0∞) {p : ℝ} (hp : 0 < p) :
    eLpNorm g (ENNReal.ofReal p) Measure.count = (∑' x, g x ^ p) ^ (1 / p) := by
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simpa using hp) ENNReal.ofReal_ne_top
    AEStronglyMeasurable.of_discrete, ENNReal.toReal_ofReal hp.le, lintegral_count]
  simp only [enorm_eq_self]

lemma eLpNorm_count_const_mul (c : ℝ≥0∞) (g : (Fin n → ℤ) → ℝ≥0∞) {p : ℝ} (hp : 0 < p) :
    eLpNorm (fun x => c * g x) (ENNReal.ofReal p) Measure.count =
      c * eLpNorm g (ENNReal.ofReal p) Measure.count := by
  rw [eLpNorm_count_ennreal_eq _ hp, eLpNorm_count_ennreal_eq _ hp]
  simp_rw [ENNReal.mul_rpow_of_nonneg _ _ hp.le]
  rw [ENNReal.tsum_mul_left, ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul,
    mul_one_div_cancel hp.ne', ENNReal.rpow_one]

lemma tsum_rpow_le_of_eLpNorm_count_le {g : (Fin n → ℤ) → ℝ≥0∞} {X : ℝ≥0∞} {p : ℝ}
    (hp : 0 < p) (h : eLpNorm g (ENNReal.ofReal p) Measure.count ≤ X) :
    ∑' x, g x ^ p ≤ X ^ p := by
  rw [eLpNorm_count_ennreal_eq _ hp] at h
  have h2 := ENNReal.rpow_le_rpow h hp.le
  rwa [← ENNReal.rpow_mul, one_div_mul_cancel hp.ne', ENNReal.rpow_one] at h2

lemma eLpNorm_count_le_of_tsum_rpow_le {g : (Fin n → ℤ) → ℝ≥0∞} {X : ℝ≥0∞} {p : ℝ}
    (hp : 0 < p) (h : ∑' x, g x ^ p ≤ X ^ p) :
    eLpNorm g (ENNReal.ofReal p) Measure.count ≤ X := by
  rw [eLpNorm_count_ennreal_eq _ hp]
  have h2 := ENNReal.rpow_le_rpow h (by positivity : (0 : ℝ) ≤ 1 / p)
  rwa [← ENNReal.rpow_mul, mul_one_div_cancel hp.ne', ENNReal.rpow_one] at h2

/-! #### `K_s` is bounded on `ℓ^p` -/

open scoped Convolution in
/-- Young for a Schwartz cutoff `χ'`: if `M` has Euclidean `L^P` multiplier norm `≤ A` on Schwartz
inputs (`1 ≤ P`) and `‖𝓕⁻ χ'‖_{L¹} ≤ K`, then `M χ'` has multiplier norm `≤ A K`. -/
lemma eLpNorm_fourierInv_mul_schwartz_le (χ' : 𝓢(EuclideanSpace ℝ (Fin n), ℂ)) {K : ℝ}
    (hK : eLpNorm (𝓕⁻ (χ' : EuclideanSpace ℝ (Fin n) → ℂ)) 1 volume ≤ ENNReal.ofReal K)
    (hK0 : 0 ≤ K) {P : ℝ≥0∞} (hP : 1 ≤ P) {M : EuclideanSpace ℝ (Fin n) → ℂ} {A : ℝ}
    (hA : ∀ F : 𝓢(EuclideanSpace ℝ (Fin n), ℂ),
      eLpNorm (𝓕⁻ (fun ξ => M ξ * 𝓕 (F : EuclideanSpace ℝ (Fin n) → ℂ) ξ)) P volume ≤
        ENNReal.ofReal A * eLpNorm F P volume)
    (F : 𝓢(EuclideanSpace ℝ (Fin n), ℂ)) :
    eLpNorm (𝓕⁻ (fun ξ => (M ξ * χ' ξ) * 𝓕 (F : EuclideanSpace ℝ (Fin n) → ℂ) ξ)) P volume ≤
      ENNReal.ofReal (A * K) * eLpNorm F P volume := by
  set φ : 𝓢(EuclideanSpace ℝ (Fin n), ℂ) := 𝓕⁻ χ' with hφ
  set G := SchwartzMap.convolution (ContinuousLinearMap.mul ℂ ℂ) φ F with hG
  have hGF : ∀ ξ, 𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ =
      χ' ξ * 𝓕 (F : EuclideanSpace ℝ (Fin n) → ℂ) ξ := by
    intro ξ
    have h := congrArg (fun H : 𝓢(EuclideanSpace ℝ (Fin n), ℂ) => H ξ)
      (SchwartzMap.fourier_convolution (ContinuousLinearMap.mul ℂ ℂ) φ F)
    simp only [SchwartzMap.pairing_apply_apply, hφ, FourierTransform.fourier_fourierInv_eq,
      ContinuousLinearMap.mul_apply'] at h
    rw [← SchwartzMap.fourier_coe, h, SchwartzMap.fourier_coe]
  have e : (fun ξ => (M ξ * χ' ξ) * 𝓕 (F : EuclideanSpace ℝ (Fin n) → ℂ) ξ) =
      fun ξ => M ξ * 𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ := by
    funext ξ; rw [hGF, mul_assoc]
  rw [e]
  refine (hA G).trans ?_
  have hGc : (G : EuclideanSpace ℝ (Fin n) → ℂ) =
      (φ : EuclideanSpace ℝ (Fin n) → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ, volume]
        (F : EuclideanSpace ℝ (Fin n) → ℂ) :=
    funext fun x => SchwartzMap.convolution_apply _ φ F x
  have hY := (young_convolution_euclidean hP (φ.memLp 1) (F.memLp P)).2.1
  have hφK : eLpNorm (φ : EuclideanSpace ℝ (Fin n) → ℂ) 1 volume ≤ ENNReal.ofReal K := by
    rw [hφ, SchwartzMap.fourierInv_coe]; exact hK
  rw [hGc, ENNReal.ofReal_mul' hK0, mul_assoc]
  gcongr
  exact hY.trans (by gcongr)

/-- Uniform `L¹` bound for `φ_s = 𝓕⁻ χ_s`. -/
lemma exists_eLpNorm_liftPhi_le (n : ℕ) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ (d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ),
      eLpNorm (liftPhi n d Ω p s) 1 volume ≤ ENNReal.ofReal K := by
  obtain ⟨C, hC, h⟩ := norm_liftPhi_le n
  have hE : 0 ≤ envelopeConst n := by unfold envelopeConst; positivity
  refine ⟨C * envelopeConst n, by positivity, fun d Ω p s => ?_⟩
  have hL := liftL_pos (n := n) (d := d) (Ω := Ω) (p := p) s
  obtain ⟨hi, hI⟩ := integrable_envelope_and_integral_le (n := n) hL
  have hmeas : AEStronglyMeasurable (liftPhi n d Ω p s) volume := by
    have e : liftPhi n d Ω p s = ((𝓕⁻ (liftChiSchwartz n d Ω p s) :
        𝓢(EuclideanSpace ℝ (Fin n), ℂ)) : EuclideanSpace ℝ (Fin n) → ℂ) := by
      rw [SchwartzMap.fourierInv_coe]; rfl
    rw [e]
    exact (𝓕⁻ (liftChiSchwartz n d Ω p s) :
      𝓢(EuclideanSpace ℝ (Fin n), ℂ)).continuous.aestronglyMeasurable
  refine (eLpNorm_mono_real (g := fun x => C * envelope n (liftL n d Ω p s) x) hmeas
      (h d Ω p s).1).trans ?_
  rw [eLpNorm_one_eq_lintegral_enorm (hi.const_mul C).aestronglyMeasurable]
  rw [← ofReal_integral_norm_eq_lintegral_enorm (hi.const_mul C)]
  refine ENNReal.ofReal_le_ofReal ?_
  calc ∫ x, ‖C * envelope n (liftL n d Ω p s) x‖
      = ∫ x, C * envelope n (liftL n d Ω p s) x := by
        congr 1; funext x
        rw [Real.norm_of_nonneg (mul_nonneg hC (envelope_nonneg hL x))]
    _ ≤ C * envelopeConst n := by
        rw [integral_const_mul]; exact mul_le_mul_of_nonneg_left hI hC

/-- `K_s = (m_K χ_s)_per(D)` is bounded on `ℓ^p` uniformly in `s` (Blueprint Lemma 10.1, proof:
Lemma 6.2 `sampling_single`, Lemma 4.3 and Young for the cutoff). -/
theorem truncKs_bound (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) (hp : 1 < p) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (s : ℕ) (g : (Fin n → ℤ) → ℂ), (Function.support g).Finite →
      eLpNorm (latMult (truncKs n d Ω p s) g) (ENNReal.ofReal p) Measure.count ≤
        ENNReal.ofReal C * eLpNorm g (ENNReal.ofReal p) Measure.count := by
  obtain ⟨CS, hCS, hS⟩ := sampling_single n
  obtain ⟨A, hA0, hA⟩ := exists_eLpNorm_fourierInv_dyadicSymbol_mul_le hn hΩ hp
  obtain ⟨K, hK0, hK⟩ := exists_eLpNorm_liftPhi_le n
  obtain ⟨B, hB0, hB, -, -, -, -, -⟩ := long_symbols_bounds hn hΩ
  refine ⟨CS * (A * K), by positivity, fun s g hg => ?_⟩
  have hP : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hp.le
  have hKs : eLpNorm (𝓕⁻ ((liftChiSchwartz n d Ω p s : 𝓢(EuclideanSpace ℝ (Fin n), ℂ)) :
      EuclideanSpace ℝ (Fin n) → ℂ)) 1 volume ≤ ENNReal.ofReal K := by
    have e : 𝓕⁻ ((liftChiSchwartz n d Ω p s : 𝓢(EuclideanSpace ℝ (Fin n), ℂ)) :
        EuclideanSpace ℝ (Fin n) → ℂ) = liftPhi n d Ω p s := rfl
    rw [e]; exact hK d Ω p s
  refine hS p hp.le (fun η => dyadicSymbol Ω η * (liftChi n d Ω p s η : ℂ)) B (A * K)
    (integrable_dyadicSymbol_mul_liftChi hn hΩ s).aestronglyMeasurable (fun ξ => ?_)
    (fun η hη i => mul_liftChi_ne_zero_abs_le η hη i) (fun F => ?_) g hg
  · rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (liftChi_nonneg s ξ)]
    calc ‖dyadicSymbol Ω ξ‖ * liftChi n d Ω p s ξ ≤ B * 1 :=
          mul_le_mul (hB ξ) (liftChi_le_one s ξ) (liftChi_nonneg s ξ) hB0
      _ = B := mul_one B
  · exact eLpNorm_fourierInv_mul_schwartz_le (liftChiSchwartz n d Ω p s) hKs hK0 hP hA F

/-! #### The one-element lifted estimate for the translated multipliers `e(-u · ξ) m_K` -/

/-- Output translation on `E`: `𝓕⁻(e(-u · ξ) h)(x) = 𝓕⁻ h (x - u)`. -/
lemma fourierInv_eC_mul (u : EuclideanSpace ℝ (Fin n)) (h : EuclideanSpace ℝ (Fin n) → ℂ) :
    𝓕⁻ (fun ξ => eC (-inner ℝ u ξ) * h ξ) = fun x => 𝓕⁻ h (x - u) := by
  funext x
  rw [fourierInv_eq_integral_eC, fourierInv_eq_integral_eC]
  congr 1; funext ξ
  rw [inner_sub_right, real_inner_comm u ξ, sub_eq_add_neg, eC_add]; ring

/-- **Blueprint Lemma 10.1 (`lem:lifttrunc`), proof: the one-element case of eq. (9.10) for the
translated multipliers**: there are `δ > 0` and `C` such that for every `s ≥ 1`, every `u ∈ ℤⁿ`
and every finitely supported `f`,
`‖sup_{α ∈ 𝓡_s} |Lift_{s,α}[e(-u · ξ) m_K](D) f|‖_p ≤ C 2^{-δ s} ‖f‖_p` (uniformly in `u`: the
multiplier `e(-u · ξ) m_K` is an output translate of `m_K(D)`). -/
theorem lift_eC_dyadicSymbol_bound (hn : 1 ≤ n) (hd : 1 ≤ d) (hΩ : IsSWProfile Ω) (hp : 1 < p) :
    ∃ δ : ℝ, 0 < δ ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ s : ℕ, 1 ≤ s → ∀ u : Fin n → ℤ,
      ∀ f : (Fin n → ℤ) → ℂ, (Function.support f).Finite →
        eLpNorm (fun x => (((liftRat s).sup fun aq =>
            ‖latMult (liftSym n d Ω p s aq.1 aq.2
              (fun ξ => eC (-inner ℝ (latEmbed u) ξ) * dyadicSymbol Ω ξ)) f x‖₊ : ℝ≥0) : ℝ))
          (ENNReal.ofReal p) Measure.count ≤
        ENNReal.ofReal (C * (2 : ℝ) ^ (-(δ * s))) * eLpNorm f (ENNReal.ofReal p) Measure.count := by
  obtain ⟨δ, hδ, CL, hCL, hsq⟩ := lift_square_p n d hn hd Ω hp
  have ht : 1 < 2 * (paramR p : ℝ) := by
    have : (1 : ℝ) ≤ paramR p := by exact_mod_cast one_le_paramR p
    linarith
  obtain ⟨A, hA0, hA⟩ := exists_eLpNorm_fourierInv_dyadicSymbol_mul_le hn hΩ ht
  obtain ⟨B, -, hB, -, -, hm, -, -⟩ := long_symbols_bounds hn hΩ
  refine ⟨δ, hδ, CL * A, mul_nonneg hCL hA0, fun s hs u f hf => ?_⟩
  set mu : EuclideanSpace ℝ (Fin n) → ℂ :=
    fun ξ => eC (-inner ℝ (latEmbed u) ξ) * dyadicSymbol Ω ξ with hmu_def
  have hmu : AEStronglyMeasurable mu volume :=
    ((by fun_prop : Continuous fun ξ : EuclideanSpace ℝ (Fin n) =>
      eC (-inner ℝ (latEmbed u) ξ))).aestronglyMeasurable.mul hm
  have hBu : ∀ ξ, ‖mu ξ‖ ≤ B := fun ξ => by
    simp only [mu]; rw [norm_mul, norm_eC, one_mul]; exact hB ξ
  have hAu : ∀ G : 𝓢(EuclideanSpace ℝ (Fin n), ℂ),
      eLpNorm (𝓕⁻ (fun ξ => mu ξ * 𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ))
        (ENNReal.ofReal (2 * paramR p)) volume ≤
      ENNReal.ofReal A * eLpNorm G (ENNReal.ofReal (2 * paramR p)) volume := by
    intro G
    have e : (fun ξ => mu ξ * 𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ) = fun ξ =>
        eC (-inner ℝ (latEmbed u) ξ) *
          (dyadicSymbol Ω ξ * 𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ) := by
      funext ξ; simp only [mu]; ring
    have hGi : Integrable (𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ)) := by
      rw [← SchwartzMap.fourier_coe]; exact (𝓕 G).integrable
    have hi : Integrable fun ξ => dyadicSymbol Ω ξ * 𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ :=
      hGi.bdd_mul (c := B) hm (Filter.Eventually.of_forall hB)
    rw [e, fourierInv_eC_mul]
    have hc := continuous_fourierInv_of_integrable hi
    have h2 : eLpNorm (fun x => 𝓕⁻ (fun ξ => dyadicSymbol Ω ξ *
        𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ) (x - latEmbed u))
          (ENNReal.ofReal (2 * paramR p)) volume =
        eLpNorm (𝓕⁻ (fun ξ => dyadicSymbol Ω ξ * 𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ))
          (ENNReal.ofReal (2 * paramR p)) volume :=
      eLpNorm_comp_measurePreserving hc.aestronglyMeasurable
        (measurePreserving_sub_right volume (latEmbed u))
    rw [h2]
    exact hA G
  have h := hsq s hs ({()} : Finset Unit) (fun _ => mu) B A (fun _ _ => hmu)
    (fun _ _ => hBu) hA0 (fun ε hε G => ?_) f hf
  · simp only [Finset.sum_singleton] at h
    have e : (fun x => Real.sqrt ((((liftRat s).sup fun aq =>
        ‖latMult (liftSym n d Ω p s aq.1 aq.2 mu) f x‖₊ : ℝ≥0) : ℝ) ^ 2)) =
        fun x => (((liftRat s).sup fun aq =>
          ‖latMult (liftSym n d Ω p s aq.1 aq.2 mu) f x‖₊ : ℝ≥0) : ℝ) := by
      funext x; exact Real.sqrt_sq (NNReal.coe_nonneg _)
    rw [e] at h
    refine h.trans (le_of_eq ?_)
    congr 2; ring
  · simp only [Finset.sum_singleton]
    exact eLpNorm_fourierInv_sign_mul_le hAu (hε () (Finset.mem_singleton_self _)) G


/-! #### The pointwise bound: shifted main term plus shift error -/

/-- `‖u‖ ≤ √n Q` for `u ∈ 𝒱 = {0, …, Q-1}ⁿ`. -/
lemma norm_latEmbed_finIntVec_le {Q : ℕ} (u : Fin n → Fin Q) :
    ‖latEmbed (finIntVec u)‖ ≤ Real.sqrt n * Q := by
  rw [EuclideanSpace.norm_eq]
  have h : ∑ i, ‖(latEmbed (finIntVec u)) i‖ ^ 2 ≤ n * (Q : ℝ) ^ 2 := by
    calc ∑ i, ‖(latEmbed (finIntVec u)) i‖ ^ 2 ≤ ∑ _i : Fin n, (Q : ℝ) ^ 2 :=
          Finset.sum_le_sum fun i _ => by
            rw [latEmbed_apply, Real.norm_eq_abs, sq_abs]
            have e : ((finIntVec u i : ℤ) : ℝ) = ((u i : ℕ) : ℝ) := by simp [finIntVec]
            rw [e]
            have h1 : ((u i : ℕ) : ℝ) ≤ Q := by exact_mod_cast (u i).isLt.le
            have h0 : (0 : ℝ) ≤ ((u i : ℕ) : ℝ) := Nat.cast_nonneg _
            nlinarith
      _ = n * (Q : ℝ) ^ 2 := by simp
  calc Real.sqrt (∑ i, ‖(latEmbed (finIntVec u)) i‖ ^ 2) ≤ Real.sqrt (n * (Q : ℝ) ^ 2) :=
        Real.sqrt_le_sqrt h
    _ = Real.sqrt n * Q := by
        rw [Real.sqrt_mul (Nat.cast_nonneg _), Real.sqrt_sq (Nat.cast_nonneg _)]

/-- The maximal function `sup_{α ∈ 𝓡_s} |H_{α,v}|` of the averaging argument, as a real
function of `z` (for fixed `v`). -/
noncomputable def truncHsup (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ)
    (f : (Fin n → ℤ) → ℂ) (v z : Fin n → ℤ) : ℝ :=
  (((liftRat s).sup fun aq => ‖truncH n d Ω p s aq.1 aq.2 f v z‖₊ : ℝ≥0) : ℝ)

lemma enorm_truncHsup (s : ℕ) (f : (Fin n → ℤ) → ℂ) (v z : Fin n → ℤ) :
    ‖truncHsup n d Ω p s f v z‖ₑ =
      (((liftRat s).sup fun aq => ‖truncH n d Ω p s aq.1 aq.2 f v z‖₊ : ℝ≥0) : ℝ≥0∞) := by
  rw [truncHsup, Real.enorm_eq_ofReal (NNReal.coe_nonneg _), ENNReal.ofReal_coe_nnreal]

/-- **Pointwise form of eqs. (10.3)–(10.4)**: for `J > J₀` with `‖u‖ ≤ R ≤ 2^{J₀}`,
`sup_{α, J > J₀} |Lift_{s,α}[τ_J m_K](D) f(x)| ≤ C 𝖬(sup_α |H_{α,x}|)(x - u)
  + C_φ C_n R 2^{-J₀} ∑_{α ∈ 𝓡_s} ∑_{β ∈ T[q]} 𝖬 G_β(x)`
(the first term is the shifted main term `sup |φ_J * H_{α,x}|(x - u)`, the second the shift
error; `C = bpPhiConst n * envelopeConst n`, `C_n = envelopeConst n`). -/
lemma lift_trunc_long_pointwise (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) {Cφ : ℝ} (hCφ : 0 ≤ Cφ)
    (hφ : ∀ (J : ℤ) (w z : EuclideanSpace ℝ (Fin n)), ‖z‖ ≤ (2 : ℝ) ^ J →
      ‖(bpPhiDil J w : ℂ) - (bpPhiDil J (w - z) : ℂ)‖ ≤
        Cφ * ‖z‖ * ((2 : ℝ) ^ J)⁻¹ * envelope n ((2 : ℝ) ^ J) w)
    {s : ℕ} {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) {J₀ : ℕ} {u : Fin n → ℤ}
    {R : ℝ} (hR : ‖latEmbed u‖ ≤ R) (hRJ : R ≤ (2 : ℝ) ^ J₀) (x : Fin n → ℤ) :
    (⨆ J : ℕ, ⨆ (_ : J₀ < J), (liftRat s).sup fun aq =>
      ‖latMult (liftSym n d Ω p s aq.1 aq.2 (fun ξ => bpTau J ξ * dyadicSymbol Ω ξ)) f x‖ₑ) ≤
    ENNReal.ofReal (bpPhiConst n * envelopeConst n) *
        cubeMaximalInt n (truncHsup n d Ω p s f x) (x - u) +
      ENNReal.ofReal (Cφ * envelopeConst n * R * ((2 : ℝ) ^ J₀)⁻¹) *
        ∑ aq ∈ liftRat s, ∑ b : Fin n → Fin aq.2,
          cubeMaximalInt n (truncG n d Ω p s aq.2 b f) x := by
  refine iSup_le fun J => iSup_le fun hJ => Finset.sup_le fun aq haq => ?_
  obtain ⟨a, q⟩ := aq
  have hq : 1 ≤ q := one_le_of_mem_liftRat haq
  have hJ0 : (0 : ℤ) ≤ (J : ℤ) := Nat.cast_nonneg _
  have h2J : (2 : ℝ) ^ J₀ ≤ (2 : ℝ) ^ (J : ℤ) := by
    rw [zpow_natCast]; exact pow_le_pow_right₀ (by norm_num) hJ.le
  have hR0 : 0 ≤ R := (norm_nonneg _).trans hR
  have hE0 : 0 ≤ envelopeConst n := by unfold envelopeConst; positivity
  rw [latMult_liftSym_bpTau_eq hn hΩ hJ0 s a q hf x]
  set H := truncH n d Ω p s a q f x with hH
  set φ : (Fin n → ℤ) → ℂ := fun y => (bpPhiDil (J : ℤ) (latEmbed y) : ℂ) with hφdef
  have hsplit : ∀ y, φ y * H (x - y) =
      φ (y - u) * H (x - y) + (φ y - φ (y - u)) * H (x - y) := fun y => by ring
  -- the shifted main term
  have h1 : ∑' y, ‖φ (y - u)‖ₑ * ‖H (x - y)‖ₑ ≤
      ENNReal.ofReal (bpPhiConst n * envelopeConst n) *
        cubeMaximalInt n (truncHsup n d Ω p s f x) (x - u) := by
    rw [← (Equiv.addRight u).tsum_eq]
    simp only [Equiv.coe_addRight, add_sub_cancel_right]
    refine le_trans (ENNReal.tsum_le_tsum fun w => ?_)
      (tsum_bpPhiDil_latEmbed_mul_le_cubeMaximalInt hJ0 (truncHsup n d Ω p s f x) (x - u))
    have e1 : ‖φ w‖ₑ = ENNReal.ofReal (bpPhiDil (J : ℤ) (latEmbed w)) := by
      rw [hφdef, ← ofReal_norm, Complex.norm_real,
        Real.norm_of_nonneg (bpPhiDil_nonneg _ _)]
    have e2 : x - (w + u) = x - u - w := by abel
    rw [e1, e2, enorm_truncHsup]
    gcongr
    exact enorm_le_coe_finset_sup (g := fun aq : ℕ × ℕ =>
      truncH n d Ω p s aq.1 aq.2 f x (x - u - w)) (a := (a, q)) haq
  -- the shift error
  have h2 : ∑' y, ‖φ y - φ (y - u)‖ₑ * ‖H (x - y)‖ₑ ≤
      ENNReal.ofReal (Cφ * envelopeConst n * R * ((2 : ℝ) ^ J₀)⁻¹) *
        ∑ aq ∈ liftRat s, ∑ b : Fin n → Fin aq.2,
          cubeMaximalInt n (truncG n d Ω p s aq.2 b f) x := by
    set c : ℝ := Cφ * R * ((2 : ℝ) ^ J₀)⁻¹ with hc
    have hc0 : 0 ≤ c := by positivity
    have hterm : ∀ y, ‖φ y - φ (y - u)‖ₑ * ‖H (x - y)‖ₑ ≤
        ENNReal.ofReal c * ∑ b : Fin n → Fin q,
          ENNReal.ofReal (latEnvelope n ((2 : ℝ) ^ (J : ℤ)) y) *
            ‖truncG n d Ω p s q b f (x - y)‖ₑ := by
      intro y
      have hd := hφ (J : ℤ) (latEmbed y) (latEmbed u) (hR.trans (hRJ.trans h2J))
      rw [← latEmbed_sub] at hd
      have hd' : ‖φ y - φ (y - u)‖ ≤ c * latEnvelope n ((2 : ℝ) ^ (J : ℤ)) y := by
        refine hd.trans ?_
        rw [latEnvelope, hc]
        have henv : 0 ≤ envelope n ((2 : ℝ) ^ (J : ℤ)) (latEmbed y) :=
          envelope_nonneg (by positivity) _
        have hinv : ((2 : ℝ) ^ (J : ℤ))⁻¹ ≤ ((2 : ℝ) ^ J₀)⁻¹ :=
          inv_anti₀ (by positivity) h2J
        gcongr
      have hH' : ‖H (x - y)‖ₑ ≤ ∑ b : Fin n → Fin q, ‖truncG n d Ω p s q b f (x - y)‖ₑ := by
        rw [← ofReal_norm]
        refine (ENNReal.ofReal_le_ofReal (norm_truncH_le s a hq f x (x - y))).trans (le_of_eq ?_)
        rw [ENNReal.ofReal_sum_of_nonneg (fun b _ => norm_nonneg _)]
        simp only [ofReal_norm]
      calc ‖φ y - φ (y - u)‖ₑ * ‖H (x - y)‖ₑ
          ≤ ENNReal.ofReal (c * latEnvelope n ((2 : ℝ) ^ (J : ℤ)) y) *
              ∑ b : Fin n → Fin q, ‖truncG n d Ω p s q b f (x - y)‖ₑ := by
            gcongr
            rw [← ofReal_norm]; exact ENNReal.ofReal_le_ofReal hd'
        _ = _ := by
            rw [ENNReal.ofReal_mul hc0, mul_assoc, Finset.mul_sum]
    refine (ENNReal.tsum_le_tsum hterm).trans ?_
    rw [ENNReal.tsum_mul_left, Summable.tsum_finsetSum (fun _ _ => ENNReal.summable)]
    have hR1 : (1 : ℝ) ≤ (2 : ℝ) ^ (J : ℤ) := one_le_zpow₀ (by norm_num) hJ0
    calc ENNReal.ofReal c * ∑ b : Fin n → Fin q, ∑' y,
          ENNReal.ofReal (latEnvelope n ((2 : ℝ) ^ (J : ℤ)) y) *
            ‖truncG n d Ω p s q b f (x - y)‖ₑ
        ≤ ENNReal.ofReal c * ∑ b : Fin n → Fin q,
            ENNReal.ofReal (envelopeConst n) * cubeMaximalInt n (truncG n d Ω p s q b f) x := by
          gcongr with b
          exact tsum_envelope_mul_le_cubeMaximalInt hR1 _ x
      _ = ENNReal.ofReal (Cφ * envelopeConst n * R * ((2 : ℝ) ^ J₀)⁻¹) *
            ∑ b : Fin n → Fin q, cubeMaximalInt n (truncG n d Ω p s q b f) x := by
          rw [← Finset.mul_sum, ← mul_assoc, ← ENNReal.ofReal_mul hc0, hc]
          congr 2; ring
      _ ≤ _ := by
          gcongr
          exact Finset.single_le_sum (f := fun aq : ℕ × ℕ => ∑ b : Fin n → Fin aq.2,
            cubeMaximalInt n (truncG n d Ω p s aq.2 b f) x) (fun _ _ => zero_le) haq
  calc ‖∑' y, φ y * H (x - y)‖ₑ ≤ ∑' y, ‖φ y * H (x - y)‖ₑ := enorm_tsum_le_tsum_enorm
    _ ≤ ∑' y, (‖φ (y - u)‖ₑ * ‖H (x - y)‖ₑ + ‖φ y - φ (y - u)‖ₑ * ‖H (x - y)‖ₑ) :=
        ENNReal.tsum_le_tsum fun y => by
          rw [hsplit y]
          refine (enorm_add_le _ _).trans (le_of_eq ?_)
          rw [enorm_mul, enorm_mul]
    _ = ∑' y, ‖φ (y - u)‖ₑ * ‖H (x - y)‖ₑ + ∑' y, ‖φ y - φ (y - u)‖ₑ * ‖H (x - y)‖ₑ :=
        ENNReal.tsum_add
    _ ≤ _ := add_le_add h1 h2


/-! #### The averaging argument over `𝒱_s` -/

/-- **The averaging argument of Blueprint Lemma 10.1**: let `h(v, z)` depend on `v` only modulo
`Q`, and suppose that for every `u ∈ 𝒱 = {0, …, Q-1}ⁿ` the function `x ↦ h(x, x - u)` has
`ℓ^p` norm `≤ X` (`1 < p`). Then for some `u ∈ 𝒱`, `‖x ↦ 𝖬(h(x, ·))(x - u)‖_p ≤ C_{n,p} X`.
(Average the `p`-th powers over `u`, change variables `(x, u) ↦ (z = x - u, v = x mod Q)`,
apply the maximal theorem for each fixed `v`, and change variables back.) -/
lemma exists_shift_eLpNorm_cubeMaximalInt_le {Q : ℕ} [NeZero Q] (hp : 1 < p)
    (h : (Fin n → ℤ) → (Fin n → ℤ) → ℝ)
    (hper : ∀ v v' : Fin n → ℤ, (∀ i, (Q : ℤ) ∣ v i - v' i) → h v = h v') {X : ℝ≥0∞}
    (hX : ∀ u : Fin n → Fin Q,
      eLpNorm (fun x => h x (x - finIntVec u)) (ENNReal.ofReal p) Measure.count ≤ X) :
    ∃ u : Fin n → Fin Q,
      eLpNorm (fun x => cubeMaximalInt n (h x) (x - finIntVec u)) (ENNReal.ofReal p)
        Measure.count ≤ hlMaximalConst (5 ^ n) p * X := by
  have hp0 : 0 < p := by linarith
  set CMe := hlMaximalConst (5 ^ n) p with hCMe
  have hA : ∀ u : Fin n → Fin Q, ∑' x, ‖h x (x - finIntVec u)‖ₑ ^ p ≤ X ^ p := by
    intro u
    refine tsum_rpow_le_of_eLpNorm_count_le (g := fun x => ‖h x (x - finIntVec u)‖ₑ) hp0 ?_
    rw [eLpNorm_enorm _ AEStronglyMeasurable.of_discrete]
    exact hX u
  have hB : ∀ v, ∑' z, cubeMaximalInt n (h v) z ^ p ≤ CMe ^ p * ∑' z, ‖h v z‖ₑ ^ p := by
    intro v
    have h1 := eLpNorm_cubeMaximalInt_le (n := n) hp (h v)
    rw [← eLpNorm_enorm (h v) AEStronglyMeasurable.of_discrete,
      eLpNorm_count_ennreal_eq (fun x => ‖h v x‖ₑ) hp0] at h1
    refine (tsum_rpow_le_of_eLpNorm_count_le hp0 h1).trans (le_of_eq ?_)
    rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le, ← ENNReal.rpow_mul, one_div_mul_cancel hp0.ne',
      ENNReal.rpow_one]
  set a : (Fin n → Fin Q) → ℝ≥0∞ := fun u =>
    ∑' x, cubeMaximalInt n (h x) (x - finIntVec u) ^ p with ha
  have hsum : ∑ u, a u ≤ CMe ^ p * ((Fintype.card (Fin n → Fin Q) : ℝ≥0∞) * X ^ p) := by
    have e1 := sum_tsum_sub_finIntVec_eq (Q := Q)
      (fun v z => cubeMaximalInt n (h v) z ^ p) (fun v v' z hvv => by rw [hper v v' hvv])
    have e2 := sum_tsum_sub_finIntVec_eq (Q := Q)
      (fun v z => ‖h v z‖ₑ ^ p) (fun v v' z hvv => by rw [hper v v' hvv])
    calc ∑ u, a u = ∑ v : Fin n → Fin Q, ∑' z, cubeMaximalInt n (h (finIntVec v)) z ^ p := e1
      _ ≤ ∑ v : Fin n → Fin Q, CMe ^ p * ∑' z, ‖h (finIntVec v) z‖ₑ ^ p :=
          Finset.sum_le_sum fun v _ => hB _
      _ = CMe ^ p * ∑ u : Fin n → Fin Q, ∑' x, ‖h x (x - finIntVec u)‖ₑ ^ p := by
          rw [← Finset.mul_sum, e2]
      _ ≤ CMe ^ p * ∑ _u : Fin n → Fin Q, X ^ p := by
          gcongr with u; exact hA u
      _ = CMe ^ p * ((Fintype.card (Fin n → Fin Q) : ℝ≥0∞) * X ^ p) := by
          rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
  obtain ⟨u, -, hu⟩ := Finset.exists_min_image Finset.univ a Finset.univ_nonempty
  refine ⟨u, eLpNorm_count_le_of_tsum_rpow_le hp0 ?_⟩
  have hc0 : (Fintype.card (Fin n → Fin Q) : ℝ≥0∞) ≠ 0 := by
    simp [NeZero.ne Q]
  have hct : (Fintype.card (Fin n → Fin Q) : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _
  have h3 : (Fintype.card (Fin n → Fin Q) : ℝ≥0∞) * a u ≤
      (Fintype.card (Fin n → Fin Q) : ℝ≥0∞) * (CMe ^ p * X ^ p) := by
    calc (Fintype.card (Fin n → Fin Q) : ℝ≥0∞) * a u = ∑ _v : Fin n → Fin Q, a u := by
          rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
      _ ≤ ∑ v, a v := Finset.sum_le_sum fun v _ => hu v (Finset.mem_univ v)
      _ ≤ _ := hsum.trans (le_of_eq (by ring))
  rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le]
  exact (ENNReal.mul_le_mul_iff_right hc0 hct).1 h3

/-! #### The long smooth maximum -/

/-- `sup_α |H_{α,v}|` depends on `v` only modulo `Q_s`. -/
lemma truncHsup_congr {s : ℕ} (f : (Fin n → ℤ) → ℂ) {v v' : Fin n → ℤ}
    (h : ∀ i, (truncQ s : ℤ) ∣ v i - v' i) :
    truncHsup n d Ω p s f v = truncHsup n d Ω p s f v' := by
  funext z
  unfold truncHsup
  congr 1
  refine Finset.sup_congr rfl fun aq haq => ?_
  have hq : 1 ≤ aq.2 := one_le_of_mem_liftRat (a := aq.1) haq
  have hqN : aq.2 < liftN s := (mem_liftRat.1 haq).2.1
  have h' : ∀ i, (aq.2 : ℤ) ∣ v i - v' i := fun i =>
    (Int.natCast_dvd_natCast.2 (dvd_truncQ hq hqN)).trans (h i)
  rw [truncH_congr s aq.1 hq f h' z]

lemma eLpNorm_latModulate (β : EuclideanSpace ℝ (Fin n)) (f : (Fin n → ℤ) → ℂ) {P : ℝ≥0∞} :
    eLpNorm (latModulate β f) P Measure.count = eLpNorm f P Measure.count :=
  eLpNorm_congr_norm_ae AEStronglyMeasurable.of_discrete AEStronglyMeasurable.of_discrete
    (ae_of_all _ fun x => by rw [latModulate, norm_mul, norm_eC, one_mul])

/-- The shift error in `ℓ^p`: `‖∑_{α ∈ 𝓡_s} ∑_{β ∈ T[q]} 𝖬 G_β‖_p ≤ N_s^{n+2} C_{n,p} C_K ‖f‖_p`. -/
lemma eLpNorm_sum_cubeMaximalInt_truncG_le (hp : 1 < p) {CK : ℝ}
    (hK : ∀ (s : ℕ) (g : (Fin n → ℤ) → ℂ), (Function.support g).Finite →
      eLpNorm (latMult (truncKs n d Ω p s) g) (ENNReal.ofReal p) Measure.count ≤
        ENNReal.ofReal CK * eLpNorm g (ENNReal.ofReal p) Measure.count)
    (s : ℕ) {f : (Fin n → ℤ) → ℂ} (hf : (Function.support f).Finite) :
    eLpNorm (fun x => ∑ aq ∈ liftRat s, ∑ b : Fin n → Fin aq.2,
        cubeMaximalInt n (truncG n d Ω p s aq.2 b f) x) (ENNReal.ofReal p) Measure.count ≤
      ((liftN s ^ (n + 2) : ℕ) : ℝ≥0∞) * (hlMaximalConst (5 ^ n) p *
        (ENNReal.ofReal CK * eLpNorm f (ENNReal.ofReal p) Measure.count)) := by
  have hp1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hp.le
  set K := hlMaximalConst (5 ^ n) p *
    (ENNReal.ofReal CK * eLpNorm f (ENNReal.ofReal p) Measure.count) with hKdef
  have hG : ∀ q (b : Fin n → Fin q), eLpNorm (cubeMaximalInt n (truncG n d Ω p s q b f))
      (ENNReal.ofReal p) Measure.count ≤ K := by
    intro q b
    refine (eLpNorm_cubeMaximalInt_le (n := n) hp _).trans ?_
    rw [hKdef]
    gcongr
    refine (hK s _ (hf.subset fun x hx => ?_)).trans (le_of_eq ?_)
    · intro h0; apply hx; simp [latModulate, h0]
    · rw [eLpNorm_latModulate]
  have e : (fun x => ∑ aq ∈ liftRat s, ∑ b : Fin n → Fin aq.2,
      cubeMaximalInt n (truncG n d Ω p s aq.2 b f) x) =
      ∑ aq ∈ liftRat s, ∑ b : Fin n → Fin aq.2, cubeMaximalInt n (truncG n d Ω p s aq.2 b f) := by
    funext x; simp only [Finset.sum_apply]
  rw [e]
  refine (eLpNorm_sum_le hp1).trans ?_
  refine (Finset.sum_le_sum fun aq _ => eLpNorm_sum_le hp1).trans ?_
  refine (Finset.sum_le_sum fun aq _ => Finset.sum_le_sum fun b _ => hG aq.2 b).trans ?_
  simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fun, Fintype.card_fin, nsmul_eq_mul]
  rw [← Finset.sum_mul]
  gcongr
  have hle : ∑ aq ∈ liftRat s, aq.2 ^ n ≤ liftN s ^ (n + 2) := by
    calc ∑ aq ∈ liftRat s, aq.2 ^ n ≤ ∑ _aq ∈ liftRat s, liftN s ^ n :=
          Finset.sum_le_sum fun aq haq => Nat.pow_le_pow_left (mem_liftRat.1 haq).2.1.le n
      _ = (liftRat s).card * liftN s ^ n := by rw [Finset.sum_const, smul_eq_mul]
      _ ≤ liftN s ^ 2 * liftN s ^ n := Nat.mul_le_mul_right _ (card_liftRat_le s)
      _ = liftN s ^ (n + 2) := by rw [← pow_add, add_comm]
  exact_mod_cast hle

/-- **Blueprint Lemma 10.1 (`lem:lifttrunc`), the long smooth maximum** (proof, lines on
eqs. (10.3)–(10.4) and the averaging argument): for `n, d ≥ 1`, admissible `Ω` and `1 < p < ∞`
there are `δ > 0` and `C` such that for every `s ≥ 1` and every finitely supported `f`,
`‖sup_{α ∈ 𝓡_s, J > J_s} |Lift_{s,α}[τ_J m_K](D) f|‖_p ≤ C 2^{-δ s} ‖f‖_p`
(the supremum over all integers `J > J_s`, as an extended nonnegative function). -/
theorem lift_trunc_long (hn : 1 ≤ n) (hd : 1 ≤ d) (hΩ : IsSWProfile Ω) (hp : 1 < p) :
    ∃ δ : ℝ, 0 < δ ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ s : ℕ, 1 ≤ s →
      ∀ f : (Fin n → ℤ) → ℂ, (Function.support f).Finite →
        eLpNorm (fun x => ⨆ J : ℕ, ⨆ (_ : truncJ n d Ω p s < J), (liftRat s).sup fun aq =>
            ‖latMult (liftSym n d Ω p s aq.1 aq.2
              (fun ξ => bpTau J ξ * dyadicSymbol Ω ξ)) f x‖ₑ)
          (ENNReal.ofReal p) Measure.count ≤
        ENNReal.ofReal (C * (2 : ℝ) ^ (-(δ * s))) *
          eLpNorm f (ENNReal.ofReal p) Measure.count := by
  obtain ⟨δL, hδL, CL, hCL, hL⟩ := lift_eC_dyadicSymbol_bound hn hd hΩ hp
  obtain ⟨CK, hCK, hK⟩ := truncKs_bound (d := d) hn hΩ hp
  obtain ⟨Cφ, hCφ, hφ⟩ := exists_norm_bpPhiDil_sub_le n
  have hp0 : 0 < p := by linarith
  have hp1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hp.le
  set CM := (hlMaximalConst (5 ^ n) p).toReal with hCM
  have hCMe : hlMaximalConst (5 ^ n) p = ENNReal.ofReal CM :=
    (ENNReal.ofReal_toReal (hlMaximalConst_ne_top _ hp0)).symm
  have hCM0 : 0 ≤ CM := ENNReal.toReal_nonneg
  have hE0 : 0 ≤ envelopeConst n := by unfold envelopeConst; positivity
  have hB0 : 0 ≤ bpPhiConst n := bpPhiConst_nonneg
  set c1 := bpPhiConst n * envelopeConst n with hc1
  set δ := min δL 10 with hδ
  refine ⟨δ, lt_min hδL (by norm_num),
    c1 * CM * CL + Cφ * envelopeConst n * Real.sqrt n * CM * CK, by positivity,
    fun s hs f hf => ?_⟩
  have hf1 : Summable fun z => ‖f z‖ := summable_of_finite_support hf
  have : NeZero (truncQ s) := ⟨(truncQ_pos s).ne'⟩
  obtain ⟨-, hsq, hNQ⟩ := truncJ_spec (n := n) (d := d) (Ω := Ω) (p := p) s
  set Js := truncJ n d Ω p s with hJs
  set R := Real.sqrt n * (truncQ s : ℝ) with hRdef
  have hR0 : 0 ≤ R := by positivity
  have hRJ : R ≤ (2 : ℝ) ^ Js :=
    hsq.trans (pow_le_pow_right₀ (by norm_num) (Nat.sub_le _ _))
  set Er : (Fin n → ℤ) → ℝ≥0∞ := fun x => ∑ aq ∈ liftRat s, ∑ b : Fin n → Fin aq.2,
    cubeMaximalInt n (truncG n d Ω p s aq.2 b f) x with hEr
  set c2 := Cφ * envelopeConst n * R * ((2 : ℝ) ^ Js)⁻¹ with hc2
  have hc20 : 0 ≤ c2 := by positivity
  set nf := eLpNorm f (ENNReal.ofReal p) Measure.count with hnf
  -- the averaging argument: a good shift `u ∈ 𝒱_s`
  have hX : ∀ u : Fin n → Fin (truncQ s),
      eLpNorm (fun x => truncHsup n d Ω p s f x (x - finIntVec u)) (ENNReal.ofReal p)
        Measure.count ≤ ENNReal.ofReal (CL * (2 : ℝ) ^ (-(δL * s))) * nf := by
    intro u
    have e : (fun x => truncHsup n d Ω p s f x (x - finIntVec u)) = fun x =>
        (((liftRat s).sup fun aq => ‖latMult (liftSym n d Ω p s aq.1 aq.2
          (fun ξ => eC (-inner ℝ (latEmbed (finIntVec u)) ξ) * dyadicSymbol Ω ξ)) f x‖₊ :
            ℝ≥0) : ℝ) := by
      funext x
      unfold truncHsup
      congr 1
      refine Finset.sup_congr rfl fun aq _ => ?_
      rw [latMult_liftSym_eC_eq hn hΩ _ s aq.1 aq.2 hf1 x]
    rw [e]
    exact hL s hs _ f hf
  obtain ⟨u, hu⟩ := exists_shift_eLpNorm_cubeMaximalInt_le hp (truncHsup n d Ω p s f)
    (fun v v' h => truncHsup_congr f h) hX
  set W : (Fin n → ℤ) → ℝ≥0∞ := fun x =>
    cubeMaximalInt n (truncHsup n d Ω p s f x) (x - finIntVec u) with hW
  -- the pointwise bound
  have hpt : ∀ x, (⨆ J : ℕ, ⨆ (_ : Js < J), (liftRat s).sup fun aq =>
      ‖latMult (liftSym n d Ω p s aq.1 aq.2 (fun ξ => bpTau J ξ * dyadicSymbol Ω ξ)) f x‖ₑ) ≤
        ENNReal.ofReal c1 * W x + ENNReal.ofReal c2 * Er x := fun x =>
    lift_trunc_long_pointwise hn hΩ hCφ hφ hf1 (norm_latEmbed_finIntVec_le u) hRJ x
  have hErb := eLpNorm_sum_cubeMaximalInt_truncG_le (d := d) (Ω := Ω) hp hK s hf
  rw [hCMe] at hu hErb
  have hN : ((liftN s ^ (n + 2) : ℕ) : ℝ≥0∞) =
      ENNReal.ofReal (((liftN s : ℕ) : ℝ) ^ (n + 2)) := by
    rw [← ENNReal.ofReal_natCast]; push_cast; rfl
  rw [hN] at hErb
  have h2L : (2 : ℝ) ^ (-(δL * s)) ≤ (2 : ℝ) ^ (-(δ * s)) := by
    refine Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_
    have : δ ≤ δL := min_le_left _ _
    have : (0 : ℝ) ≤ s := Nat.cast_nonneg s
    nlinarith
  have h2E : ((2 : ℝ) ^ (10 * s))⁻¹ ≤ (2 : ℝ) ^ (-(δ * s)) := by
    rw [← Real.rpow_natCast, ← Real.rpow_neg (by norm_num)]
    refine Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_
    have : δ ≤ 10 := min_le_right _ _
    have : (0 : ℝ) ≤ s := Nat.cast_nonneg s
    push_cast; nlinarith
  have hQ2 : c2 * ((liftN s : ℕ) : ℝ) ^ (n + 2) =
      Cφ * envelopeConst n * Real.sqrt n *
        (((liftN s : ℕ) : ℝ) ^ (n + 2) * truncQ s / (2 : ℝ) ^ Js) := by
    rw [hc2, hRdef]; field_simp
  calc eLpNorm (fun x => ⨆ J : ℕ, ⨆ (_ : Js < J), (liftRat s).sup fun aq =>
          ‖latMult (liftSym n d Ω p s aq.1 aq.2
            (fun ξ => bpTau J ξ * dyadicSymbol Ω ξ)) f x‖ₑ) (ENNReal.ofReal p) Measure.count
      ≤ eLpNorm (fun x => ENNReal.ofReal c1 * W x + ENNReal.ofReal c2 * Er x)
          (ENNReal.ofReal p) Measure.count := by
        refine eLpNorm_mono_enorm AEStronglyMeasurable.of_discrete fun x => ?_
        rw [enorm_eq_self, enorm_eq_self]
        exact hpt x
    _ ≤ eLpNorm (fun x => ENNReal.ofReal c1 * W x) (ENNReal.ofReal p) Measure.count +
          eLpNorm (fun x => ENNReal.ofReal c2 * Er x) (ENNReal.ofReal p) Measure.count :=
        eLpNorm_add_le (f := fun x => ENNReal.ofReal c1 * W x)
          (g := fun x => ENNReal.ofReal c2 * Er x) hp1
    _ = ENNReal.ofReal c1 * eLpNorm W (ENNReal.ofReal p) Measure.count +
          ENNReal.ofReal c2 * eLpNorm Er (ENNReal.ofReal p) Measure.count := by
        rw [eLpNorm_count_const_mul _ _ hp0, eLpNorm_count_const_mul _ _ hp0]
    _ ≤ ENNReal.ofReal c1 * (ENNReal.ofReal CM *
            (ENNReal.ofReal (CL * (2 : ℝ) ^ (-(δL * s))) * nf)) +
          ENNReal.ofReal c2 * (ENNReal.ofReal (((liftN s : ℕ) : ℝ) ^ (n + 2)) *
            (ENNReal.ofReal CM * (ENNReal.ofReal CK * nf))) := by
        gcongr
    _ = ENNReal.ofReal (c1 * CM * CL * (2 : ℝ) ^ (-(δL * s)) +
          c2 * ((liftN s : ℕ) : ℝ) ^ (n + 2) * CM * CK) * nf := by
        have h2 : (0 : ℝ) ≤ (2 : ℝ) ^ (-(δL * s)) := Real.rpow_nonneg (by norm_num) _
        rw [ENNReal.ofReal_add (by positivity) (by positivity)]
        simp only [ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ c1),
          ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ c1 * CM),
          ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ c1 * CM * CL),
          ENNReal.ofReal_mul hCL, ENNReal.ofReal_mul hc20,
          ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ c2 * ((liftN s : ℕ) : ℝ) ^ (n + 2)),
          ENNReal.ofReal_mul (by positivity :
            (0 : ℝ) ≤ c2 * ((liftN s : ℕ) : ℝ) ^ (n + 2) * CM)]
        ring
    _ ≤ ENNReal.ofReal ((c1 * CM * CL + Cφ * envelopeConst n * Real.sqrt n * CM * CK) *
          (2 : ℝ) ^ (-(δ * s))) * nf := by
        gcongr ENNReal.ofReal ?_ * nf
        rw [mul_assoc (c2 * _), mul_comm (c2 * _) (CM * CK), hQ2]
        have h3 : Cφ * envelopeConst n * Real.sqrt n *
            (((liftN s : ℕ) : ℝ) ^ (n + 2) * truncQ s / (2 : ℝ) ^ Js) ≤
            Cφ * envelopeConst n * Real.sqrt n * (2 : ℝ) ^ (-(δ * s)) :=
          mul_le_mul_of_nonneg_left (hNQ.trans h2E) (by positivity)
        have h4 : c1 * CM * CL * (2 : ℝ) ^ (-(δL * s)) ≤ c1 * CM * CL * (2 : ℝ) ^ (-(δ * s)) :=
          mul_le_mul_of_nonneg_left h2L (by positivity)
        have h5 : CM * CK * (Cφ * envelopeConst n * Real.sqrt n *
            (((liftN s : ℕ) : ℝ) ^ (n + 2) * truncQ s / (2 : ℝ) ^ Js)) ≤
            CM * CK * (Cφ * envelopeConst n * Real.sqrt n * (2 : ℝ) ^ (-(δ * s))) :=
          mul_le_mul_of_nonneg_left h3 (by positivity)
        nlinarith

/-- **Blueprint Lemma 10.1 (`lem:lifttrunc`), eq. (10.1) (`eq:lifttrunc`)**: for `n, d ≥ 1`,
admissible `Ω` and `1 < p < ∞` there are `θ_p > 0` and `C_p` such that for every `s ≥ 1` and
every finitely supported `f`,
`‖sup_{α ∈ 𝓡_s, J ≥ 1} |Lift_{s,α}[∑_{1 ≤ j < J} 𝓕 K_j](D) f|‖_p ≤ C_p 2^{-θ_p s} ‖f‖_p`
(the supremum over integers `J ≥ 1`, as an extended nonnegative function). -/
theorem lift_trunc (hn : 1 ≤ n) (hd : 1 ≤ d) (hΩ : IsSWProfile Ω) (hp : 1 < p) :
    ∃ θ : ℝ, 0 < θ ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ s : ℕ, 1 ≤ s →
      ∀ f : (Fin n → ℤ) → ℂ, (Function.support f).Finite →
        eLpNorm (fun x => ⨆ J : ℕ, ⨆ (_ : 1 ≤ J), (liftRat s).sup fun aq =>
            ‖latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω J)) f x‖ₑ)
          (ENNReal.ofReal p) Measure.count ≤
        ENNReal.ofReal (C * (2 : ℝ) ^ (-(θ * s))) * eLpNorm f (ENNReal.ofReal p) Measure.count :=
  lift_trunc_of_long hn hd hΩ hp (lift_trunc_long hn hd hΩ hp)

end Truncation

section Bands

/-!
## Lifted oscillatory bands and their assembly

Results from §11 ("Lifted oscillatory bands and their assembly") of
`blueprints/discrete-sw.tex`: Blueprint Lemma 11.1 (`lem:middleband`, "A uniform-in-band
arithmetic gain"), Blueprint Lemma 11.2 (`lem:highband`, "The high-band analytic gain") and
Blueprint Theorem 11.3 (`thm:liftedSW`, "Lifted polynomial partial sums").

### Conventions

Mathlib Fourier sign, lattice conventions of section `Sampling`, and the §9 setup of
section `Lifting` (`liftSym … s a q m = Lift_{s,a/q}[m]`, `liftRat s = 𝓡_s`,
`liftChi … s = χ_s`). `Φ_{j,μ} = radialOscPhi Ω d j μ = 𝓕(e(μ P) K_j)`, `D = 2d`.

### Definitions

* `bandOp n d Ω p s ℓ f x = 𝓑_{s,ℓ} f(x) =
  sup_{α ∈ 𝓡_s, j ≥ 1, 2^ℓ ≤ |μ| 2^{Dj} ≤ 2^{ℓ+1}} |Lift_{s,α}[Φ_{j,μ}](D) f(x)|`
  (valued in `[0, ∞]`); `bandOp_eq_iSup` rewrites it as a supremum over the admissible
  triples `bandIdx d s ℓ`.
* `liftedPartialMax n d Ω p s f x = 𝒫_s f(x) =
  sup_{α ∈ 𝓡_s, μ ∈ ℝ, 1 ≤ a ≤ b} |Lift_{s,α}[∑_{j=a}^b Φ_{j,μ}](D) f(x)|` (integers `a, b`).

### Results

* Blueprint Lemma 11.2 (`lem:highband`): `bandOp_high` (`ℓ ≥ 0`:
  `‖𝓑_{s,ℓ} f‖_p ≤ C_p 2^{(n+2)s} 2^{-σ_p ℓ} ‖f‖_p`, `σ_p = (2D)^{-1} min(1/p, 1/p')`).
  Ingredients: the Euclidean family `Φ_{j,μ} χ_s` is the annular family applied to `χ_s(D) F`
  (`band_euclid_max`, via Lemma 5.3 `eLpNorm_contBandMax_le` and Young), the sampling transfer
  (`band_periodized_finset`, Lemma 6.2 `sampling_maximal`), the passage to all admissible
  parameters (`band_periodized_sup`, Lemma 2.1) and the expansion of the lift into modulated
  periodizations (`bandOp_le_sum`).
* Blueprint Lemma 11.1 (`lem:middleband`): `bandOp_uniform` (there is `b_p > 0` with
  `‖𝓑_{s,ℓ} f‖_p ≤ C_p 2^{-b_p s} ‖f‖_p` for every integer `ℓ`).
  Ingredients: the kernel expansion of the lifted operators (`latMult_liftSym_eq_finsum`), the
  differentiation in the dilation parameter `u` (`hasDerivAt_latMult_liftSym`), the fundamental
  theorem of calculus square inequality (`enorm_sq_le_of_hasDerivAt`), the uniform `ℓ²` bound for
  finite families (`band_two_finset`, from eq. (9.9) `lift_square_two` and (5.2), (5.3)),
  the weak `(1,1)` and `ℓ^∞` bounds (Lemma 9.4 `lift_envelope` and the maximal theorem) and
  Marcinkiewicz interpolation (`band_lp_finset`); `b_p = γ min(2/p, 2/p')`.
* Blueprint Theorem 11.3 (`thm:liftedSW`, eq. (11.1)): `lift_partial_sums` (there is `c_p > 0`
  with `‖𝒫_s f‖_p ≤ C_p 2^{-c_p s} ‖f‖_p`). Ingredients: the pointwise decomposition
  `liftedPartialMax_le` into middle bands, high bands (at most one `j` per band,
  `band_log_injective`), twice the maximal function of Lemma 10.1 (the low indices form an
  initial interval, `filter_Icc_eq_Ico`) and the low error `C 2^{-B_s} 𝖬 f`
  (`exists_norm_oscErr_le` and the envelope form `norm_latMult_liftSym_fourier_le`), and
  Minkowski for the infinite high-band majorant (`eLpNorm_tsum_le_count`). Here
  `B_s = N s` with `N σ_p ≥ n + 3`, and `c_p = min(θ_p, b_p/2, 1)`.
-/

open MeasureTheory Set Real Finset
open scoped FourierTransform ContDiff SchwartzMap ENNReal NNReal Convolution

variable {n d : ℕ} {Ω : EuclideanSpace ℝ (Fin n) → ℂ} {p : ℝ}

/-! ### The band operator -/

/-- The band maximal operator of §11:
`𝓑_{s,ℓ} f(x) = sup_{α ∈ 𝓡_s, j ≥ 1, 2^ℓ ≤ |μ| 2^{Dj} ≤ 2^{ℓ+1}} |Lift_{s,α}[Φ_{j,μ}](D) f(x)|`
(`D = 2d`), valued in `[0, ∞]`. -/
noncomputable def bandOp (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ) (ℓ : ℤ)
    (f : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) : ℝ≥0∞ :=
  ⨆ (aq ∈ liftRat s) (j : ℤ) (_ : 1 ≤ j) (μ : ℝ)
    (_ : (2 : ℝ) ^ ℓ ≤ |μ| * (2 : ℝ) ^ ((2 * d : ℤ) * j) ∧
      |μ| * (2 : ℝ) ^ ((2 * d : ℤ) * j) ≤ (2 : ℝ) ^ (ℓ + 1)),
    ‖latMult (liftSym n d Ω p s aq.1 aq.2 (radialOscPhi Ω d j μ)) f x‖ₑ

/-- The admissible triples `(α, j, μ)` of `𝓑_{s,ℓ}`. -/
def bandIdx (d s : ℕ) (ℓ : ℤ) : Set ((ℕ × ℕ) × ℤ × ℝ) :=
  {i | i.1 ∈ liftRat s ∧ 1 ≤ i.2.1 ∧ ((2 : ℝ) ^ ℓ ≤ |i.2.2| * (2 : ℝ) ^ ((2 * d : ℤ) * i.2.1) ∧
      |i.2.2| * (2 : ℝ) ^ ((2 * d : ℤ) * i.2.1) ≤ (2 : ℝ) ^ (ℓ + 1))}

/-- `𝓑_{s,ℓ}` as a supremum over the admissible triples. -/
lemma bandOp_eq_iSup (s : ℕ) (ℓ : ℤ) (f : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) :
    bandOp n d Ω p s ℓ f x = ⨆ i : bandIdx d s ℓ,
      ‖latMult (liftSym n d Ω p s i.1.1.1 i.1.1.2 (radialOscPhi Ω d i.1.2.1 i.1.2.2)) f x‖ₑ := by
  refine le_antisymm (iSup₂_le fun aq haq => iSup₂_le fun j hj => iSup₂_le fun μ hμ => ?_)
    (iSup_le fun i => ?_)
  · exact le_iSup_of_le (⟨(aq, j, μ), haq, hj, hμ⟩ : bandIdx d s ℓ) le_rfl
  · obtain ⟨⟨aq, j, μ⟩, h1, h2, h3⟩ := i
    exact le_iSup₂_of_le aq h1 (le_iSup₂_of_le j h2 (le_iSup₂_of_le μ h3 le_rfl))

/-- The band condition `2^ℓ ≤ |μ| 2^{Dj} ≤ 2^{ℓ+1}` is `IsBandAdm d 2^ℓ (j, μ)`. -/
lemma isBandAdm_of_band {ℓ j : ℤ} {μ : ℝ}
    (h : (2 : ℝ) ^ ℓ ≤ |μ| * (2 : ℝ) ^ ((2 * d : ℤ) * j) ∧
      |μ| * (2 : ℝ) ^ ((2 * d : ℤ) * j) ≤ (2 : ℝ) ^ (ℓ + 1)) :
    IsBandAdm d ((2 : ℝ) ^ ℓ) (j, μ) := by
  refine ⟨h.1, ?_⟩
  have := h.2
  rw [zpow_add_one₀ two_ne_zero] at this
  change |μ| * (2 : ℝ) ^ ((2 * d : ℤ) * j) ≤ 2 * 2 ^ ℓ
  linarith

/-! ### Blueprint Lemma 11.2 (`lem:highband`) -/

/-- `Φ_{j,μ}` is continuous and bounded by `‖K_j‖_{L¹}`. -/
lemma continuous_radialOscPhi_and_le (hΩ : IsSWProfile Ω) (j : ℤ) (μ : ℝ) :
    Continuous (radialOscPhi Ω d j μ) ∧
      ∀ ξ, ‖radialOscPhi Ω d j μ ξ‖ ≤ ∫ x, ‖bandKer n d Ω (j, μ) x‖ :=
  continuous_fourier_and_norm_le (integrable_oscKernel hΩ d j μ)

/-- The Euclidean maximal family with symbols `Φ_{j,μ} χ_s` (the proof of Blueprint Lemma 11.2,
first step): it is the continuous annular family applied to `χ_s(D) F`, so for `T ≥ 1` and every
finite family of parameters `a u` with `T ≤ |μ| 2^{Dj} ≤ 2T`, the maximal function is bounded on
`L^p(E)` by `C T^{-σ_p}` (Lemma 5.3 and Young, uniformly in `s`). -/
lemma band_euclid_max (hn : 1 ≤ n) (hd : 1 ≤ d) (hΩ : IsSWProfile Ω) (hp : 1 < p) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (s : ℕ) (T : ℝ), 1 ≤ T → ∀ {ι : Type*} (U : Finset ι) (a : ι → ℤ × ℝ),
      (∀ u ∈ U, IsBandAdm d T (a u)) → ∀ F : 𝓢(EuclideanSpace ℝ (Fin n), ℂ),
        eLpNorm (fun x => U.sup fun u => ‖𝓕⁻ (fun ξ => (radialOscPhi Ω d (a u).1 (a u).2 ξ *
            (liftChi n d Ω p s ξ : ℂ)) * 𝓕 (F : EuclideanSpace ℝ (Fin n) → ℂ) ξ) x‖ₑ)
          (ENNReal.ofReal p) volume ≤
        ENNReal.ofReal (C * T ^ (-(1 / (2 * (2 * d : ℝ)) * min (1 / p) (1 - 1 / p)))) *
          eLpNorm F (ENNReal.ofReal p) volume := by
  obtain ⟨Cb, hCb⟩ := eLpNorm_contBandMax_le hn hd hΩ hp
  obtain ⟨K, hK0, hK⟩ := exists_eLpNorm_liftPhi_le n
  refine ⟨max Cb 0 * K, by positivity, fun s T hT ι U a hU F => ?_⟩
  set σ := 1 / (2 * (2 * d : ℝ)) * min (1 / p) (1 - 1 / p)
  have hP : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hp.le
  set φ : 𝓢(EuclideanSpace ℝ (Fin n), ℂ) := 𝓕⁻ (liftChiSchwartz n d Ω p s) with hφ
  set G := SchwartzMap.convolution (ContinuousLinearMap.mul ℂ ℂ) φ F with hG
  have hGF : ∀ ξ, 𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ =
      liftChiSchwartz n d Ω p s ξ * 𝓕 (F : EuclideanSpace ℝ (Fin n) → ℂ) ξ := by
    intro ξ
    have h := congrArg (fun H : 𝓢(EuclideanSpace ℝ (Fin n), ℂ) => H ξ)
      (SchwartzMap.fourier_convolution (ContinuousLinearMap.mul ℂ ℂ) φ F)
    simp only [SchwartzMap.pairing_apply_apply, hφ, FourierTransform.fourier_fourierInv_eq,
      ContinuousLinearMap.mul_apply'] at h
    rw [← SchwartzMap.fourier_coe, h, SchwartzMap.fourier_coe]
  have hconv : ∀ u, 𝓕⁻ (fun ξ => (radialOscPhi Ω d (a u).1 (a u).2 ξ *
      (liftChi n d Ω p s ξ : ℂ)) * 𝓕 (F : EuclideanSpace ℝ (Fin n) → ℂ) ξ) =
      fun x => bandConv n d Ω (a u) G x := by
    intro u
    have hH : Integrable (bandKer n d Ω (a u)) :=
      (continuous_bandKer hΩ (a u)).integrable_of_hasCompactSupport (hasCompactSupport_bandKer _)
    have e : (fun ξ => (radialOscPhi Ω d (a u).1 (a u).2 ξ *
        (liftChi n d Ω p s ξ : ℂ)) * 𝓕 (F : EuclideanSpace ℝ (Fin n) → ℂ) ξ) =
        fun ξ => 𝓕 (bandKer n d Ω (a u)) ξ * 𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ := by
      funext ξ; rw [hGF, liftChiSchwartz_apply, ← mul_assoc]; rfl
    rw [e, fourierInv_fourier_mul_eq_convolution hH (continuous_fourier_and_norm_le hH).2 G]
    funext x
    rw [convolution_def]
    rfl
  have hfl : LocallyIntegrable (G : EuclideanSpace ℝ (Fin n) → ℂ) volume :=
    G.integrable.locallyIntegrable
  have heq : (fun x => U.sup fun u => ‖𝓕⁻ (fun ξ => (radialOscPhi Ω d (a u).1 (a u).2 ξ *
      (liftChi n d Ω p s ξ : ℂ)) * 𝓕 (F : EuclideanSpace ℝ (Fin n) → ℂ) ξ) x‖ₑ) =
      fun x => U.sup fun u => ‖bandConv n d Ω (a u) G x‖ₑ := by
    funext x; simp only [hconv]
  rw [heq]
  have hmeas : Measurable (fun x => U.sup fun u => ‖bandConv n d Ω (a u) G x‖ₑ) := by
    simp_rw [Finset.sup_eq_iSup]
    exact Measurable.biSup _ U.countable_toSet fun u _ =>
      (continuous_bandConv hΩ (a u) hfl).measurable.enorm
  have hpt : ∀ x, ‖(U.sup fun u => ‖bandConv n d Ω (a u) G x‖ₑ)‖ₑ ≤
      ‖contBandMax n d Ω T G x‖ₑ := by
    intro x
    rw [enorm_eq_self, enorm_eq_self]
    refine Finset.sup_le fun u hu => ?_
    rw [contBandMax_eq]
    exact le_iSup₂_of_le (a u) (hU u hu) le_rfl
  refine (eLpNorm_mono_enorm hmeas.aestronglyMeasurable hpt).trans ?_
  refine (hCb T hT G (G.memLp _)).trans ?_
  have hGc : (G : EuclideanSpace ℝ (Fin n) → ℂ) =
      (φ : EuclideanSpace ℝ (Fin n) → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ, volume]
        (F : EuclideanSpace ℝ (Fin n) → ℂ) :=
    funext fun x => SchwartzMap.convolution_apply _ φ F x
  have hY := (young_convolution_euclidean hP (φ.memLp 1) (F.memLp (ENNReal.ofReal p))).2.1
  have hφK : eLpNorm (φ : EuclideanSpace ℝ (Fin n) → ℂ) 1 volume ≤ ENNReal.ofReal K := by
    rw [hφ, SchwartzMap.fourierInv_coe]; exact hK d Ω p s
  have hGF' : eLpNorm (G : EuclideanSpace ℝ (Fin n) → ℂ) (ENNReal.ofReal p) volume ≤
      ENNReal.ofReal K * eLpNorm F (ENNReal.ofReal p) volume := by
    rw [hGc]; exact hY.trans (by gcongr)
  have hT0 : 0 < T := by linarith
  have hTσ : 0 ≤ T ^ (-σ) := Real.rpow_nonneg hT0.le _
  calc ENNReal.ofReal (Cb * T ^ (-σ)) * eLpNorm (G : EuclideanSpace ℝ (Fin n) → ℂ)
        (ENNReal.ofReal p) volume
      ≤ ENNReal.ofReal (max Cb 0 * T ^ (-σ)) *
          (ENNReal.ofReal K * eLpNorm F (ENNReal.ofReal p) volume) := by
        gcongr
        exact le_max_left _ _
    _ = ENNReal.ofReal (max Cb 0 * K * T ^ (-σ)) * eLpNorm F (ENNReal.ofReal p) volume := by
        rw [← mul_assoc, ← ENNReal.ofReal_mul (by positivity)]
        congr 2; ring

/-- The sampling transfer (the proof of Blueprint Lemma 11.2, Lemma 6.2): for every finite family
of band parameters, the maximal function of the periodizations `(Φ_{j,μ} χ_s)_per(D)` is bounded
on `ℓ^p(ℤⁿ)` by `C T^{-σ_p}`. -/
lemma band_periodized_finset (hn : 1 ≤ n) (hd : 1 ≤ d) (hΩ : IsSWProfile Ω) (hp : 1 < p) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (s : ℕ) (T : ℝ), 1 ≤ T → ∀ {ι : Type*} (U : Finset ι) (a : ι → ℤ × ℝ),
      (∀ u ∈ U, IsBandAdm d T (a u)) → ∀ g : (Fin n → ℤ) → ℂ, (Function.support g).Finite →
        eLpNorm (fun x => U.sup fun u => ‖latMult (periodize fun η =>
            radialOscPhi Ω d (a u).1 (a u).2 η * (liftChi n d Ω p s η : ℂ)) g x‖ₑ)
          (ENNReal.ofReal p) Measure.count ≤
        ENNReal.ofReal (C * T ^ (-(1 / (2 * (2 * d : ℝ)) * min (1 / p) (1 - 1 / p)))) *
          eLpNorm g (ENNReal.ofReal p) Measure.count := by
  obtain ⟨CS, hCS, hS⟩ := sampling_maximal n
  obtain ⟨CA, hCA, hA⟩ := band_euclid_max (p := p) hn hd hΩ hp
  refine ⟨CS * CA, by positivity, fun s T hT ι U a hU g hg => ?_⟩
  set σ := 1 / (2 * (2 * d : ℝ)) * min (1 / p) (1 - 1 / p)
  have hL := eight_le_liftL (n := n) (d := d) (Ω := Ω) (p := p) s
  set B : ℝ := ∑ u ∈ U, ∫ x, ‖bandKer n d Ω (a u) x‖ with hB
  have h := hS p hp.le U (fun u η => radialOscPhi Ω d (a u).1 (a u).2 η *
      (liftChi n d Ω p s η : ℂ)) B (CA * T ^ (-σ))
    (fun u _ => ((continuous_radialOscPhi_and_le hΩ (a u).1 (a u).2).1.mul
      (continuous_liftChi s)).aestronglyMeasurable)
    (fun u hu ξ => ?_) (fun u _ ξ hξ i => ?_) (hA s T hT U a hU) g hg
  · refine h.trans (le_of_eq ?_)
    congr 2; ring
  · rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (liftChi_nonneg s ξ)]
    have h1 := (continuous_radialOscPhi_and_le (d := d) hΩ (a u).1 (a u).2).2 ξ
    have h2 : ∫ x, ‖bandKer n d Ω (a u) x‖ ≤ B :=
      Finset.single_le_sum (f := fun u => ∫ x, ‖bandKer n d Ω (a u) x‖)
        (fun u _ => integral_nonneg fun _ => norm_nonneg _) hu
    calc ‖radialOscPhi Ω d (a u).1 (a u).2 ξ‖ * liftChi n d Ω p s ξ
        ≤ ‖radialOscPhi Ω d (a u).1 (a u).2 ξ‖ * 1 :=
          mul_le_mul_of_nonneg_left (liftChi_le_one s ξ) (norm_nonneg _)
      _ ≤ B := by rw [mul_one]; exact h1.trans h2
  · have hχ : liftChi n d Ω p s ξ ≠ 0 := fun h0 => hξ (by simp [h0])
    have h1 := support_liftChi s hχ i
    have h2 : 1 / (liftL n d Ω p s : ℝ) ≤ 1 / 8 :=
      one_div_le_one_div_of_le (by norm_num) hL
    exact h1.trans h2

/-- The sampling transfer for all band parameters (the proof of Blueprint Lemma 11.2, with
Lemma 2.1): the supremum over all `(j, μ)` with `T ≤ |μ| 2^{Dj} ≤ 2T`. -/
lemma band_periodized_sup (hn : 1 ≤ n) (hd : 1 ≤ d) (hΩ : IsSWProfile Ω) (hp : 1 < p) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (s : ℕ) (T : ℝ), 1 ≤ T → ∀ g : (Fin n → ℤ) → ℂ,
      (Function.support g).Finite →
        eLpNorm (fun x => ⨆ u : {u : ℤ × ℝ // IsBandAdm d T u}, ‖latMult (periodize fun η =>
            radialOscPhi Ω d u.1.1 u.1.2 η * (liftChi n d Ω p s η : ℂ)) g x‖ₑ)
          (ENNReal.ofReal p) Measure.count ≤
        ENNReal.ofReal (C * T ^ (-(1 / (2 * (2 * d : ℝ)) * min (1 / p) (1 - 1 / p)))) *
          eLpNorm g (ENNReal.ofReal p) Measure.count := by
  obtain ⟨C, hC, h⟩ := band_periodized_finset (p := p) hn hd hΩ hp
  refine ⟨C, hC, fun s T hT g hg => ?_⟩
  exact eLpNorm_iSup_le_of_finset_count ENNReal.ofReal_ne_top _ _
    (fun F => h s T hT F Subtype.val (fun u _ => u.2) g hg)

/-- The pointwise expansion of the lift (the proof of Blueprint Lemma 11.2): `|S(α, β)| ≤ 1`,
modulation, and the rational supremum bounded by the sum over the pairs `(α, β)`. -/
lemma bandOp_le_sum (hΩ : IsSWProfile Ω) (s : ℕ) (ℓ : ℤ) {f : (Fin n → ℤ) → ℂ}
    (hf : (Function.support f).Finite) (x : Fin n → ℤ) :
    bandOp n d Ω p s ℓ f x ≤ ∑ aq ∈ liftRat s, ∑ b : Fin n → Fin aq.2,
      ⨆ u : {u : ℤ × ℝ // IsBandAdm d ((2 : ℝ) ^ ℓ) u}, ‖latMult (periodize fun η =>
        radialOscPhi Ω d u.1.1 u.1.2 η * (liftChi n d Ω p s η : ℂ))
          (latModulate (-gridPt aq.2 b) f) x‖ₑ := by
  have hf1 : Summable fun z => ‖f z‖ := summable_of_finite_support hf
  refine iSup₂_le fun aq haq => iSup₂_le fun j _ => iSup₂_le fun μ hμ => ?_
  set Y : (ℕ × ℕ) → ℝ≥0∞ := fun aq => ∑ b : Fin n → Fin aq.2,
      ⨆ u : {u : ℤ × ℝ // IsBandAdm d ((2 : ℝ) ^ ℓ) u}, ‖latMult (periodize fun η =>
        radialOscPhi Ω d u.1.1 u.1.2 η * (liftChi n d Ω p s η : ℂ))
          (latModulate (-gridPt aq.2 b) f) x‖ₑ with hY
  refine le_trans ?_ (Finset.single_le_sum (f := Y) (fun _ _ => zero_le) haq)
  have hq : 1 ≤ aq.2 := one_le_of_mem_liftRat (a := aq.1) (by simpa using haq)
  obtain ⟨hc, hb⟩ := continuous_radialOscPhi_and_le (d := d) hΩ j μ
  have hint : Integrable fun ξ => radialOscPhi Ω d j μ ξ * (liftChi n d Ω p s ξ : ℂ) :=
    integrable_mul_liftChi hc.aestronglyMeasurable (fun ξ _ => hb ξ)
  rw [latMult_liftSym_eq_sum hint hf1 x]
  refine (enorm_sum_le _ _).trans (Finset.sum_le_sum fun b _ => ?_)
  rw [enorm_mul, enorm_mul]
  have h1 : ‖gaussSum n d aq.1 aq.2 b‖ₑ ≤ 1 := by
    rw [← ofReal_norm, ← ENNReal.ofReal_one]
    exact ENNReal.ofReal_le_ofReal (norm_gaussSum_le_one aq.1 hq b)
  have h2 : ‖eC (inner ℝ (latEmbed x) (gridPt aq.2 b))‖ₑ = 1 := by
    rw [← ofReal_norm, norm_eC, ENNReal.ofReal_one]
  rw [h2, one_mul]
  calc ‖gaussSum n d aq.1 aq.2 b‖ₑ * ‖latMult (periodize fun η =>
        radialOscPhi Ω d j μ η * (liftChi n d Ω p s η : ℂ)) (latModulate (-gridPt aq.2 b) f) x‖ₑ
      ≤ 1 * ‖latMult (periodize fun η =>
        radialOscPhi Ω d j μ η * (liftChi n d Ω p s η : ℂ)) (latModulate (-gridPt aq.2 b) f) x‖ₑ :=
        mul_le_mul_left h1 _
    _ = _ := one_mul _
    _ ≤ _ := le_iSup_of_le (⟨(j, μ), isBandAdm_of_band hμ⟩ :
        {u : ℤ × ℝ // IsBandAdm d ((2 : ℝ) ^ ℓ) u}) le_rfl

/-- **Blueprint Lemma 11.2 (`lem:highband`)**, the high-band analytic gain: for `n, d ≥ 1`, an
admissible profile `Ω` and `1 < p < ∞` there is `C_p` such that for every `s ≥ 1`, every
integer `ℓ ≥ 0` and every finitely supported `f`,
`‖𝓑_{s,ℓ} f‖_p ≤ C_p 2^{(n+2)s} 2^{-σ_p ℓ} ‖f‖_p`, where
`σ_p = (2D)^{-1} min(1/p, 1/p')` (`D = 2d`) is the exponent of Lemma 5.3
(`eLpNorm_contBandMax_le`). -/
theorem bandOp_high (hn : 1 ≤ n) (hd : 1 ≤ d) (hΩ : IsSWProfile Ω) (hp : 1 < p) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ s : ℕ, 1 ≤ s → ∀ ℓ : ℤ, 0 ≤ ℓ →
      ∀ f : (Fin n → ℤ) → ℂ, (Function.support f).Finite →
        eLpNorm (bandOp n d Ω p s ℓ f) (ENNReal.ofReal p) Measure.count ≤
          ENNReal.ofReal (C * (2 : ℝ) ^ ((n + 2) * s) *
            (2 : ℝ) ^ (-(1 / (2 * (2 * d : ℝ)) * min (1 / p) (1 - 1 / p) * ℓ))) *
            eLpNorm f (ENNReal.ofReal p) Measure.count := by
  obtain ⟨C, hC, h⟩ := band_periodized_sup (p := p) hn hd hΩ hp
  refine ⟨C, hC, fun s _ ℓ hℓ f hf => ?_⟩
  set σ := 1 / (2 * (2 * d : ℝ)) * min (1 / p) (1 - 1 / p)
  have hp1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hp.le
  have hT : (1 : ℝ) ≤ (2 : ℝ) ^ ℓ := one_le_zpow₀ (by norm_num) hℓ
  set Y : ∀ q : ℕ, (Fin n → Fin q) → (Fin n → ℤ) → ℝ≥0∞ := fun q b x =>
      ⨆ u : {u : ℤ × ℝ // IsBandAdm d ((2 : ℝ) ^ ℓ) u}, ‖latMult (periodize fun η =>
        radialOscPhi Ω d u.1.1 u.1.2 η * (liftChi n d Ω p s η : ℂ))
          (latModulate (-gridPt q b) f) x‖ₑ with hYdef
  set K := ENNReal.ofReal (C * ((2 : ℝ) ^ ℓ) ^ (-σ)) * eLpNorm f (ENNReal.ofReal p) Measure.count
  have hYb : ∀ q (b : Fin n → Fin q), eLpNorm (Y q b) (ENNReal.ofReal p) Measure.count ≤ K := by
    intro q b
    refine (h s _ hT _ (hf.subset fun x hx => ?_)).trans (le_of_eq ?_)
    · intro h0; apply hx; simp [latModulate, h0]
    · rw [eLpNorm_latModulate]
  have hpt : ∀ x, ‖bandOp n d Ω p s ℓ f x‖ₑ ≤
      ‖(∑ aq ∈ liftRat s, ∑ b : Fin n → Fin aq.2, Y aq.2 b) x‖ₑ := by
    intro x
    rw [enorm_eq_self, enorm_eq_self]
    simp only [Finset.sum_apply]
    exact bandOp_le_sum hΩ s ℓ hf x
  refine (eLpNorm_mono_enorm AEStronglyMeasurable.of_discrete hpt).trans ?_
  refine (eLpNorm_sum_le hp1).trans ?_
  refine (Finset.sum_le_sum fun aq _ => eLpNorm_sum_le hp1).trans ?_
  refine (Finset.sum_le_sum fun aq _ => Finset.sum_le_sum fun b _ => hYb aq.2 b).trans ?_
  simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fun, Fintype.card_fin, nsmul_eq_mul]
  rw [← Finset.sum_mul]
  have hle : ∑ aq ∈ liftRat s, aq.2 ^ n ≤ liftN s ^ (n + 2) := by
    calc ∑ aq ∈ liftRat s, aq.2 ^ n ≤ ∑ _aq ∈ liftRat s, liftN s ^ n :=
          Finset.sum_le_sum fun aq haq => Nat.pow_le_pow_left (mem_liftRat.1 haq).2.1.le n
      _ = (liftRat s).card * liftN s ^ n := by rw [Finset.sum_const, smul_eq_mul]
      _ ≤ liftN s ^ 2 * liftN s ^ n := Nat.mul_le_mul_right _ (card_liftRat_le s)
      _ = liftN s ^ (n + 2) := by rw [← pow_add, add_comm]
  have hle' : (∑ aq ∈ liftRat s, ((aq.2 ^ n : ℕ) : ℝ≥0∞)) ≤ ((liftN s ^ (n + 2) : ℕ) : ℝ≥0∞) := by
    exact_mod_cast hle
  have e2 : ((liftN s ^ (n + 2) : ℕ) : ℝ≥0∞) = ENNReal.ofReal ((2 : ℝ) ^ ((n + 2) * s)) := by
    rw [← ENNReal.ofReal_natCast]; congr 1; simp [liftN, ← pow_mul, mul_comm]
  have e3 : ((2 : ℝ) ^ ℓ) ^ (-σ) = (2 : ℝ) ^ (-(σ * ℓ)) := by
    rw [← Real.rpow_intCast, ← Real.rpow_mul (by norm_num)]; congr 1; ring
  calc (∑ aq ∈ liftRat s, ((aq.2 ^ n : ℕ) : ℝ≥0∞)) * K
      ≤ ((liftN s ^ (n + 2) : ℕ) : ℝ≥0∞) * K := mul_le_mul' hle' le_rfl
    _ = ENNReal.ofReal (C * (2 : ℝ) ^ ((n + 2) * s) * (2 : ℝ) ^ (-(σ * ℓ))) *
          eLpNorm f (ENNReal.ofReal p) Measure.count := by
        rw [e2]; simp only [K]; rw [e3, ← mul_assoc, ← ENNReal.ofReal_mul (by positivity)]
        congr 2; ring

/-! ### Blueprint Lemma 11.1 (`lem:middleband`): differentiation in the dilation parameter -/

/-- The kernel expansion of the lifted operators on finitely supported inputs (Lemma 9.1):
`Lift_{s,a/q}[m](D) f(x) = ∑_{z ∈ S} e((a/q) P(x - z)) (m χ_s)ˇ(x - z) f(z)` for bounded measurable
`m` and `f` vanishing off the finite set `S`. -/
lemma latMult_liftSym_eq_finsum (s a : ℕ) {q : ℕ} (hq : 1 ≤ q)
    {m : EuclideanSpace ℝ (Fin n) → ℂ} (hm : AEStronglyMeasurable m volume) {B : ℝ}
    (hB : ∀ ξ, ‖m ξ‖ ≤ B) {f : (Fin n → ℤ) → ℂ} {S : Finset (Fin n → ℤ)}
    (hS : ∀ z ∉ S, f z = 0) (x : Fin n → ℤ) :
    latMult (liftSym n d Ω p s a q m) f x = ∑ z ∈ S,
      eC ((a : ℝ) / q * (radialPolyZ n d (x - z) : ℝ)) *
        𝓕⁻ (fun ξ => m ξ * (liftChi n d Ω p s ξ : ℂ)) (latEmbed (x - z)) * f z := by
  have hf : Summable fun z => ‖f z‖ :=
    summable_of_ne_finset_zero (s := S) fun z hz => by simp [hS z hz]
  rw [latMult_eq_latConv (integrableOn_liftSym (integrable_mul_liftChi hm fun ξ _ => hB ξ)) hf,
    latConv, ← (Equiv.subLeft x).tsum_eq,
    tsum_eq_sum (s := S) fun z hz => by simp [Equiv.subLeft_apply, hS z hz]]
  refine Finset.sum_congr rfl fun z _ => ?_
  simp only [Equiv.subLeft_apply, sub_sub_cancel]
  rw [latKernel_liftSym_of_bdd s a hq hm (fun ξ _ => hB ξ)]

/-- Differentiation of `(M_v χ_s)ˇ(w)` in the parameter `v` under the integral sign. -/
lemma hasDerivAt_fourierInv_mul_liftChi (s : ℕ) {M M' : ℝ → EuclideanSpace ℝ (Fin n) → ℂ}
    (hMm : ∀ v, AEStronglyMeasurable (M v) volume)
    (hM'm : ∀ v, AEStronglyMeasurable (M' v) volume) {B B' : ℝ}
    (hB : ∀ v ξ, ‖M v ξ‖ ≤ B) (hB' : ∀ v ξ, ‖M' v ξ‖ ≤ B')
    (hder : ∀ v ξ, HasDerivAt (fun v => M v ξ) (M' v ξ) v)
    (w : EuclideanSpace ℝ (Fin n)) (v : ℝ) :
    HasDerivAt (fun v => 𝓕⁻ (fun ξ => M v ξ * (liftChi n d Ω p s ξ : ℂ)) w)
      (𝓕⁻ (fun ξ => M' v ξ * (liftChi n d Ω p s ξ : ℂ)) w) v := by
  simp only [fourierInv_eq_integral_eC]
  have hχ := integrable_liftChi (n := n) (d := d) (Ω := Ω) (p := p) s
  have hc : Continuous fun ξ : EuclideanSpace ℝ (Fin n) => eC (inner ℝ ξ w) := by fun_prop
  refine (hasDerivAt_integral_of_dominated_loc_of_deriv_le
    (F := fun v ξ => eC (inner ℝ ξ w) * (M v ξ * (liftChi n d Ω p s ξ : ℂ)))
    (F' := fun v ξ => eC (inner ℝ ξ w) * (M' v ξ * (liftChi n d Ω p s ξ : ℂ)))
    (bound := fun ξ => B' * ‖(liftChi n d Ω p s ξ : ℂ)‖) (s := univ) Filter.univ_mem
    (Filter.Eventually.of_forall fun v =>
      hc.aestronglyMeasurable.mul ((hMm v).mul hχ.aestronglyMeasurable)) ?_
    (hc.aestronglyMeasurable.mul ((hM'm v).mul hχ.aestronglyMeasurable))
    (ae_of_all _ fun ξ v' _ => ?_) (hχ.norm.const_mul B')
    (ae_of_all _ fun ξ v' _ => ?_)).2
  · refine Integrable.mono' (hχ.norm.const_mul B)
      (hc.aestronglyMeasurable.mul ((hMm v).mul hχ.aestronglyMeasurable))
      (ae_of_all _ fun ξ => ?_)
    rw [norm_mul, norm_eC, one_mul, norm_mul]
    exact mul_le_mul_of_nonneg_right (hB v ξ) (norm_nonneg _)
  · rw [norm_mul, norm_eC, one_mul, norm_mul]
    exact mul_le_mul_of_nonneg_right (hB' v' ξ) (norm_nonneg _)
  · exact ((hder v' ξ).mul_const _).const_mul _

/-- Continuity of `(M'_v χ_s)ˇ(w)` in the parameter `v` (dominated convergence). -/
lemma continuous_fourierInv_mul_liftChi (s : ℕ) {M' : ℝ → EuclideanSpace ℝ (Fin n) → ℂ}
    (hM'm : ∀ v, AEStronglyMeasurable (M' v) volume) {B' : ℝ} (hB' : ∀ v ξ, ‖M' v ξ‖ ≤ B')
    (hc : ∀ ξ, Continuous fun v => M' v ξ) (w : EuclideanSpace ℝ (Fin n)) :
    Continuous fun v => 𝓕⁻ (fun ξ => M' v ξ * (liftChi n d Ω p s ξ : ℂ)) w := by
  simp only [fourierInv_eq_integral_eC]
  have hχ := integrable_liftChi (n := n) (d := d) (Ω := Ω) (p := p) s
  have hce : Continuous fun ξ : EuclideanSpace ℝ (Fin n) => eC (inner ℝ ξ w) := by fun_prop
  refine continuous_of_dominated (bound := fun ξ => B' * ‖(liftChi n d Ω p s ξ : ℂ)‖)
    (fun v => hce.aestronglyMeasurable.mul ((hM'm v).mul hχ.aestronglyMeasurable))
    (fun v => ae_of_all _ fun ξ => ?_) (hχ.norm.const_mul B')
    (ae_of_all _ fun ξ => continuous_const.mul ((hc ξ).mul continuous_const))
  rw [norm_mul, norm_eC, one_mul, norm_mul]
  exact mul_le_mul_of_nonneg_right (hB' v ξ) (norm_nonneg _)

/-- Differentiation of the lifted operators in the parameter (the proof of Blueprint
Lemma 11.1): for bounded measurable symbols `M_v` with bounded measurable `v`-derivatives `M'_v`
(continuous in `v`) and finitely supported `f`, `v ↦ Lift_{s,a/q}[M_v](D) f(x)` has derivative
`Lift_{s,a/q}[M'_v](D) f(x)`, which is continuous in `v`. -/
lemma hasDerivAt_latMult_liftSym (s a : ℕ) {q : ℕ} (hq : 1 ≤ q)
    {M M' : ℝ → EuclideanSpace ℝ (Fin n) → ℂ}
    (hMm : ∀ v, AEStronglyMeasurable (M v) volume)
    (hM'm : ∀ v, AEStronglyMeasurable (M' v) volume) {B B' : ℝ}
    (hB : ∀ v ξ, ‖M v ξ‖ ≤ B) (hB' : ∀ v ξ, ‖M' v ξ‖ ≤ B')
    (hder : ∀ v ξ, HasDerivAt (fun v => M v ξ) (M' v ξ) v)
    (hc : ∀ ξ, Continuous fun v => M' v ξ)
    {f : (Fin n → ℤ) → ℂ} (hf : (Function.support f).Finite) (x : Fin n → ℤ) :
    (∀ v, HasDerivAt (fun v => latMult (liftSym n d Ω p s a q (M v)) f x)
      (latMult (liftSym n d Ω p s a q (M' v)) f x) v) ∧
    Continuous fun v => latMult (liftSym n d Ω p s a q (M' v)) f x := by
  set S := hf.toFinset
  have hS : ∀ z ∉ S, f z = 0 := fun z hz => by simpa [S] using hz
  have e1 : (fun v => latMult (liftSym n d Ω p s a q (M v)) f x) = fun v => ∑ z ∈ S,
      eC ((a : ℝ) / q * (radialPolyZ n d (x - z) : ℝ)) *
        𝓕⁻ (fun ξ => M v ξ * (liftChi n d Ω p s ξ : ℂ)) (latEmbed (x - z)) * f z :=
    funext fun v => latMult_liftSym_eq_finsum s a hq (hMm v) (hB v) hS x
  have e2 : (fun v => latMult (liftSym n d Ω p s a q (M' v)) f x) = fun v => ∑ z ∈ S,
      eC ((a : ℝ) / q * (radialPolyZ n d (x - z) : ℝ)) *
        𝓕⁻ (fun ξ => M' v ξ * (liftChi n d Ω p s ξ : ℂ)) (latEmbed (x - z)) * f z :=
    funext fun v => latMult_liftSym_eq_finsum s a hq (hM'm v) (hB' v) hS x
  refine ⟨fun v => ?_, ?_⟩
  · rw [e1, show latMult (liftSym n d Ω p s a q (M' v)) f x = _ from congrFun e2 v]
    exact HasDerivAt.fun_sum fun z _ =>
      ((hasDerivAt_fourierInv_mul_liftChi s hMm hM'm hB hB' hder _ v).const_mul _).mul_const _
  · rw [e2]
    exact continuous_finsetSum S fun z _ =>
      (continuous_const.mul (continuous_fourierInv_mul_liftChi s hM'm hB' hc _)).mul
        continuous_const

/-- The fundamental theorem of calculus square inequality (the proof of Blueprint Lemma 11.1):
for `φ` with continuous derivative `φ'` and `u ∈ [1, 2]`,
`|φ(u)|² ≤ |φ(1)|² + 2 ∫_1^2 |φ| |φ'|`. -/
lemma enorm_sq_le_of_hasDerivAt {φ φ' : ℝ → ℂ} (hφ : ∀ v, HasDerivAt φ (φ' v) v)
    (hφ' : Continuous φ') {u : ℝ} (hu : u ∈ Icc (1 : ℝ) 2) :
    ‖φ u‖ₑ ^ 2 ≤ ‖φ 1‖ₑ ^ 2 + 2 * ∫⁻ v in Ioc (1 : ℝ) 2, ‖φ v‖ₑ * ‖φ' v‖ₑ := by
  have hφc : Continuous φ := continuous_iff_continuousAt.2 fun v => (hφ v).continuousAt
  have hg : ∀ v, HasDerivAt (fun v => ‖φ v‖ ^ 2) (2 * inner ℝ (φ v) (φ' v)) v :=
    fun v => (hφ v).norm_sq
  have hgc : Continuous fun v => 2 * inner ℝ (φ v) (φ' v) := continuous_const.mul (hφc.inner hφ')
  have hFTC := intervalIntegral.integral_eq_sub_of_hasDerivAt (a := 1) (b := u)
    (fun v _ => hg v) (hgc.intervalIntegrable _ _)
  have hh : Continuous fun v => ‖φ v‖ * ‖φ' v‖ := hφc.norm.mul hφ'.norm
  have h1 : ∫ v in (1 : ℝ)..u, 2 * inner ℝ (φ v) (φ' v) ≤
      ∫ v in (1 : ℝ)..u, 2 * (‖φ v‖ * ‖φ' v‖) :=
    intervalIntegral.integral_mono_on hu.1 (hgc.intervalIntegrable _ _)
      ((continuous_const.mul hh).intervalIntegrable _ _) fun v _ => by
        have := real_inner_le_norm (φ v) (φ' v); linarith
  have h2 : ∫ v in (1 : ℝ)..u, 2 * (‖φ v‖ * ‖φ' v‖) ≤
      ∫ v in (1 : ℝ)..2, 2 * (‖φ v‖ * ‖φ' v‖) :=
    intervalIntegral.integral_mono_interval le_rfl hu.1 hu.2
      (Filter.Eventually.of_forall fun v => by positivity)
      ((continuous_const.mul hh).intervalIntegrable _ _)
  have hI0 : 0 ≤ ∫ v in (1 : ℝ)..2, ‖φ v‖ * ‖φ' v‖ :=
    intervalIntegral.integral_nonneg (by norm_num) fun v _ => by positivity
  have h3 : ‖φ u‖ ^ 2 ≤ ‖φ 1‖ ^ 2 + 2 * ∫ v in (1 : ℝ)..2, ‖φ v‖ * ‖φ' v‖ := by
    simp only [intervalIntegral.integral_const_mul] at h1 h2 hFTC; linarith
  have hint : IntegrableOn (fun v => ‖φ v‖ * ‖φ' v‖) (Ioc (1 : ℝ) 2) :=
    (hh.integrableOn_Icc (a := 1) (b := 2)).mono_set Ioc_subset_Icc_self
  have h4 : ENNReal.ofReal (∫ v in (1 : ℝ)..2, ‖φ v‖ * ‖φ' v‖) =
      ∫⁻ v in Ioc (1 : ℝ) 2, ‖φ v‖ₑ * ‖φ' v‖ₑ := by
    rw [intervalIntegral.integral_of_le (by norm_num),
      ofReal_integral_eq_lintegral_ofReal hint (ae_of_all _ fun v => by positivity)]
    congr 1; funext v; rw [ENNReal.ofReal_mul (norm_nonneg _), ofReal_norm, ofReal_norm]
  calc ‖φ u‖ₑ ^ 2 = ENNReal.ofReal (‖φ u‖ ^ 2) := by
        rw [← ofReal_norm, ENNReal.ofReal_pow (norm_nonneg _)]
    _ ≤ ENNReal.ofReal (‖φ 1‖ ^ 2 + 2 * ∫ v in (1 : ℝ)..2, ‖φ v‖ * ‖φ' v‖) :=
        ENNReal.ofReal_le_ofReal h3
    _ = ‖φ 1‖ₑ ^ 2 + 2 * ∫⁻ v in Ioc (1 : ℝ) 2, ‖φ v‖ₑ * ‖φ' v‖ₑ := by
        rw [ENNReal.ofReal_add (by positivity) (by positivity), ENNReal.ofReal_mul (by norm_num),
          h4, ← ofReal_norm, ENNReal.ofReal_pow (norm_nonneg _)]
        norm_num

/-- `∑_x ∫ g_x ≤ ∫ ∑_x g_x` for `[0, ∞]`-valued functions (no measurability needed). -/
lemma tsum_lintegral_le_lintegral_tsum {α β : Type*} [MeasurableSpace α] {μ : Measure α}
    (g : β → α → ℝ≥0∞) : ∑' b, ∫⁻ a, g b a ∂μ ≤ ∫⁻ a, ∑' b, g b a ∂μ := by
  classical
  rw [ENNReal.tsum_eq_iSup_sum]
  refine iSup_le fun S => ?_
  refine le_trans ?_ (lintegral_mono fun a => ENNReal.sum_le_tsum S)
  induction S using Finset.induction_on with
  | empty => simp
  | insert b S hb ih =>
    rw [Finset.sum_insert hb]
    refine (add_le_add le_rfl ih).trans (le_trans (le_lintegral_add _ _) (le_of_eq ?_))
    congr 1; funext a; rw [Finset.sum_insert hb]

/-- `(t, η) ↦ Ψ_a(t, η)` is continuous for continuous compactly supported amplitudes. -/
lemma continuous_radialOscInt {a : EuclideanSpace ℝ (Fin n) → ℂ} (ha : Continuous a)
    {S : Set (EuclideanSpace ℝ (Fin n))} (hS : IsCompact S) (haS : ∀ z, z ∉ S → a z = 0) :
    Continuous fun q : ℝ × EuclideanSpace ℝ (Fin n) => radialOscInt d a q.1 q.2 := by
  unfold radialOscInt
  have hai : Integrable a := osc_integrable_of_vanish ha hS haS
  have hP : Continuous (radialPoly n d) := (contDiff_radialPoly d).continuous
  refine continuous_of_dominated (bound := fun z => ‖a z‖) (fun q => ?_)
    (fun q => ae_of_all _ fun z => ?_) hai.norm (ae_of_all _ fun z => ?_)
  · exact (((continuous_eC.comp ((continuous_const.mul hP).sub
      (continuous_id.inner continuous_const))).mul ha)).aestronglyMeasurable
  · rw [norm_mul, norm_eC, one_mul]
  · exact (continuous_eC.comp ((continuous_fst.mul continuous_const).sub
      (continuous_const.inner continuous_snd))).mul continuous_const


/-- The `u`-derivative symbol `∂_u Φ_{j, σ u 2^{ℓ-Dj}} = σ 2^ℓ (∂_t Ψ)(σ u 2^ℓ, 2^j ξ)` of (5.3). -/
noncomputable def bandDerSym (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (d : ℕ) (σ : ℝ) (ℓ j : ℤ) (v : ℝ)
    (ξ : EuclideanSpace ℝ (Fin n)) : ℂ :=
  ((σ * (2 : ℝ) ^ ℓ : ℝ) : ℂ) *
    radialOscInt d (radialOscAmpDeriv Ω d) (σ * v * (2 : ℝ) ^ ℓ) ((2 : ℝ) ^ j • ξ)

/-- The lifted band operators are continuously differentiable in the dilation parameter `u`
(the proof of Blueprint Lemma 11.1): `∂_u Lift[Φ_{j, σ u 2^{ℓ-Dj}}](D) f(x) =
Lift[∂_u Φ_{j, σ u 2^{ℓ-Dj}}](D) f(x)` for finitely supported `f`. -/
lemma band_deriv_props (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) (s a : ℕ) {q : ℕ} (hq : 1 ≤ q)
    (σ : ℝ) (ℓ j : ℤ) {f : (Fin n → ℤ) → ℂ} (hf : (Function.support f).Finite)
    (x : Fin n → ℤ) :
    (∀ v, HasDerivAt (fun v => latMult (liftSym n d Ω p s a q
        (radialOscPhi Ω d j (σ * v * (2 : ℝ) ^ (ℓ - (2 * d : ℤ) * j)))) f x)
      (latMult (liftSym n d Ω p s a q (bandDerSym Ω d σ ℓ j v)) f x) v) ∧
    Continuous fun v => latMult (liftSym n d Ω p s a q (bandDerSym Ω d σ ℓ j v)) f x := by
  have ha := isRadialOscAmp_radialOscAmpDeriv hn hΩ d
  have hcont := continuous_radialOscInt (d := d) ha.1.continuous isCompact_radialOscAnnulus ha.2.1
  refine hasDerivAt_latMult_liftSym s a hq
    (M := fun v => radialOscPhi Ω d j (σ * v * (2 : ℝ) ^ (ℓ - (2 * d : ℤ) * j)))
    (M' := bandDerSym Ω d σ ℓ j)
    (fun v => (continuous_radialOscPhi_and_le hΩ j _).1.aestronglyMeasurable)
    (fun v => (continuous_const.mul (hcont.comp (continuous_const.prodMk
      (continuous_const_smul _)))).aestronglyMeasurable)
    (B := ∫ x, ‖dyadicKernel Ω j x‖) (B' := |σ * (2 : ℝ) ^ ℓ| * ∫ z, ‖radialOscAmpDeriv Ω d z‖)
    (fun v ξ => ?_) (fun v ξ => ?_) (fun v ξ => hasDerivAt_radialOscPhi_u hΩ d σ j ℓ ξ v)
    (fun ξ => continuous_const.mul (hcont.comp (Continuous.prodMk (by fun_prop)
      continuous_const))) hf x
  · have h := (continuous_radialOscPhi_and_le (d := d) hΩ j
      (σ * v * (2 : ℝ) ^ (ℓ - (2 * d : ℤ) * j))).2 ξ
    simpa only [norm_bandKer] using h
  · rw [bandDerSym, norm_mul, Complex.norm_real, Real.norm_eq_abs]
    exact mul_le_mul_of_nonneg_left (norm_radialOscInt_le _ _ _ _) (abs_nonneg _)

/-- A single term is bounded by the square function of the suprema. -/
lemma enorm_le_enorm_sqrt_sum_sup {ι κ : Type*} (J : Finset ι) (A : Finset κ)
    (w : ι → κ → ℂ) {j : ι} (hj : j ∈ J) {a : κ} (ha : a ∈ A) :
    ‖w j a‖ₑ ≤ ‖Real.sqrt (∑ j ∈ J, (((A.sup fun a => ‖w j a‖₊ : ℝ≥0)) : ℝ) ^ 2)‖ₑ := by
  rw [← ofReal_norm, ← ofReal_norm]
  refine ENNReal.ofReal_le_ofReal ?_
  rw [Real.norm_of_nonneg (Real.sqrt_nonneg _)]
  have h1 : ‖w j a‖ ≤ ((A.sup fun a => ‖w j a‖₊ : ℝ≥0) : ℝ) := by
    exact_mod_cast Finset.le_sup (f := fun a => ‖w j a‖₊) ha
  calc ‖w j a‖ ≤ Real.sqrt ((((A.sup fun a => ‖w j a‖₊ : ℝ≥0)) : ℝ) ^ 2) := by
        rw [Real.sqrt_sq (NNReal.coe_nonneg _)]; exact h1
    _ ≤ _ := Real.sqrt_le_sqrt (Finset.single_le_sum
        (f := fun j => (((A.sup fun a => ‖w j a‖₊ : ℝ≥0)) : ℝ) ^ 2)
        (fun _ _ => by positivity) hj)

/-- The finite maximal functions of `𝓑_{s,ℓ}`:
`max_{(α, j, μ) ∈ F} |Lift_{s,α}[Φ_{j,μ}](D) f(x)|` for a finite set `F` of admissible triples. -/
noncomputable def bandFin (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ) (ℓ : ℤ)
    (F : Finset (bandIdx d s ℓ)) (f : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) : ℝ :=
  ((F.sup fun i =>
    ‖latMult (liftSym n d Ω p s i.1.1.1 i.1.1.2 (radialOscPhi Ω d i.1.2.1 i.1.2.2)) f x‖₊ :
      ℝ≥0) : ℝ)

lemma enorm_bandFin (s : ℕ) (ℓ : ℤ) (F : Finset (bandIdx d s ℓ)) (f : (Fin n → ℤ) → ℂ)
    (x : Fin n → ℤ) : ‖bandFin n d Ω p s ℓ F f x‖ₑ = F.sup fun i =>
      ‖latMult (liftSym n d Ω p s i.1.1.1 i.1.1.2 (radialOscPhi Ω d i.1.2.1 i.1.2.2)) f x‖ₑ := by
  rw [bandFin, Real.enorm_eq_ofReal (NNReal.coe_nonneg _), ENNReal.ofReal_coe_nnreal,
    ENNReal.coe_finset_sup]
  rfl

lemma bandFin_nonneg (s : ℕ) (ℓ : ℤ) (F : Finset (bandIdx d s ℓ)) (f : (Fin n → ℤ) → ℂ)
    (x : Fin n → ℤ) : 0 ≤ bandFin n d Ω p s ℓ F f x := NNReal.coe_nonneg _

/-- Every admissible `μ` is `σ u 2^{ℓ - Dj}` with `σ = ±1` and `u ∈ [1, 2]`. -/
lemma exists_sign_dil {ℓ j : ℤ} {μ : ℝ}
    (h1 : (2 : ℝ) ^ ℓ ≤ |μ| * (2 : ℝ) ^ ((2 * d : ℤ) * j))
    (h2 : |μ| * (2 : ℝ) ^ ((2 * d : ℤ) * j) ≤ (2 : ℝ) ^ (ℓ + 1)) :
    ∃ σ : ℝ, (σ = 1 ∨ σ = -1) ∧ ∃ u ∈ Icc (1 : ℝ) 2,
      μ = σ * u * (2 : ℝ) ^ (ℓ - (2 * d : ℤ) * j) := by
  have hX0 : 0 < (2 : ℝ) ^ ((2 * d : ℤ) * j) := by positivity
  have hT0 : 0 < (2 : ℝ) ^ ℓ := by positivity
  have h2' : |μ| * (2 : ℝ) ^ ((2 * d : ℤ) * j) ≤ 2 * (2 : ℝ) ^ ℓ := by
    rw [zpow_add_one₀ two_ne_zero] at h2; linarith
  have hsub : (2 : ℝ) ^ (ℓ - (2 * d : ℤ) * j) =
      (2 : ℝ) ^ ℓ / (2 : ℝ) ^ ((2 * d : ℤ) * j) := by
    rw [zpow_sub₀ two_ne_zero]
  refine ⟨if 0 ≤ μ then 1 else -1, by split_ifs <;> simp,
    |μ| * (2 : ℝ) ^ ((2 * d : ℤ) * j) / (2 : ℝ) ^ ℓ, ⟨?_, ?_⟩, ?_⟩
  · rw [le_div_iff₀ hT0]; linarith
  · rw [div_le_iff₀ hT0]; linarith
  · rw [hsub]
    split_ifs with hμ
    · rw [abs_of_nonneg hμ]; field_simp
    · rw [abs_of_neg (not_le.1 hμ)]; field_simp

/-- **The uniform `ℓ²` bound for finite families** (the proof of Blueprint Lemma 11.1, `p = 2`):
there are `γ > 0` and `C` such that for every `p`, `s ≥ 1`, `ℓ ∈ ℤ`, every finite set `F` of
admissible triples and every finitely supported `f`,
`‖max_{F} |Lift_{s,α}[Φ_{j,μ}](D) f|‖₂ ≤ C 2^{-γ s} ‖f‖₂`. The proof uses the fundamental theorem
of calculus in `u`, Cauchy–Schwarz, eq. (9.9) and eqs. (5.2), (5.3). -/
lemma band_two_finset (hn : 1 ≤ n) (hd : 1 ≤ d) (hΩ : IsSWProfile Ω) :
    ∃ γ : ℝ, 0 < γ ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ (p : ℝ) (s : ℕ), 1 ≤ s → ∀ (ℓ : ℤ)
      (F : Finset (bandIdx d s ℓ)) (f : (Fin n → ℤ) → ℂ), (Function.support f).Finite →
        eLpNorm (bandFin n d Ω p s ℓ F f) 2 Measure.count ≤
          ENNReal.ofReal (C * (2 : ℝ) ^ (-(γ * s))) * eLpNorm f 2 Measure.count := by
  obtain ⟨γ, hγ, CL, hCL, hsq⟩ := lift_square_two n d hn hd
  obtain ⟨CG, hCG, hG⟩ := radialOscPhi_square hn hd hΩ
  obtain ⟨CH, hCH, hH⟩ := radialOscPhi_deriv_square hn hd hΩ
  refine ⟨γ, hγ, CL * Real.sqrt (2 * (CG + 2 * Real.sqrt (CG * CH))), by positivity,
    fun p s hs ℓ F f hf => ?_⟩
  have hf1 : Summable fun z => ‖f z‖ := summable_of_finite_support hf
  set J : Finset ℤ := F.image fun i => i.1.2.1 with hJ
  set cG : ℝ := if 0 ≤ ℓ then (2 : ℝ) ^ (-(n : ℤ) * ℓ) else 1 with hcG
  set cH : ℝ := if 0 ≤ ℓ then (2 : ℝ) ^ ((2 - n : ℤ) * ℓ) else (2 : ℝ) ^ (2 * ℓ) with hcH
  have hcG0 : 0 ≤ cG := by rw [hcG]; split_ifs <;> positivity
  have hcH0 : 0 ≤ cH := by rw [hcH]; split_ifs <;> positivity
  have hcG1 : cG ≤ 1 := by
    rw [hcG]; split_ifs with hℓ
    · exact zpow_le_one_of_nonpos₀ (by norm_num) (by nlinarith)
    · exact le_rfl
  have hcGH : cG * cH ≤ 1 := by
    rw [hcG, hcH]; split_ifs with hℓ
    · rw [← zpow_add₀ two_ne_zero]
      exact zpow_le_one_of_nonpos₀ (by norm_num) (by
        have : (1 : ℤ) ≤ n := by exact_mod_cast hn
        nlinarith)
    · rw [one_mul]; exact zpow_le_one_of_nonpos₀ (by norm_num) (by omega)
  set BG := Real.sqrt (CG * cG) with hBG
  set BH := Real.sqrt (CH * cH) with hBH
  set K : ℝ := CL * (2 : ℝ) ^ (-(γ * s)) with hK
  have hK0 : 0 ≤ K := by positivity
  set N := eLpNorm f 2 Measure.count with hN
  -- the square functions
  set g : ℝ → ℝ → (Fin n → ℤ) → ℝ := fun σ v x => Real.sqrt (∑ j ∈ J,
    ((((liftRat s).sup fun aq => ‖latMult (liftSym n d Ω p s aq.1 aq.2
      (radialOscPhi Ω d j (σ * v * (2 : ℝ) ^ (ℓ - (2 * d : ℤ) * j)))) f x‖₊ : ℝ≥0)) : ℝ) ^ 2)
    with hgdef
  set h : ℝ → ℝ → (Fin n → ℤ) → ℝ := fun σ v x => Real.sqrt (∑ j ∈ J,
    ((((liftRat s).sup fun aq => ‖latMult (liftSym n d Ω p s aq.1 aq.2
      (bandDerSym Ω d σ ℓ j v)) f x‖₊ : ℝ≥0)) : ℝ) ^ 2) with hhdef
  have hgL2 : ∀ σ : ℝ, (σ = 1 ∨ σ = -1) → ∀ v ∈ Icc (1 : ℝ) 2,
      eLpNorm (g σ v) 2 Measure.count ≤ ENNReal.ofReal (K * BG) * N := by
    intro σ hσ v hv
    exact hsq Ω p s hs J (fun j => radialOscPhi Ω d j (σ * v * (2 : ℝ) ^ (ℓ - (2 * d : ℤ) * j)))
      BG (fun j _ => (continuous_radialOscPhi_and_le hΩ j _).1.aestronglyMeasurable)
      (Real.sqrt_nonneg _) (fun η => by
        rw [hBG, Real.sq_sqrt (by positivity)]; exact hG σ hσ v hv ℓ J η) f hf1
  have hhL2 : ∀ σ : ℝ, (σ = 1 ∨ σ = -1) → ∀ v ∈ Icc (1 : ℝ) 2,
      eLpNorm (h σ v) 2 Measure.count ≤ ENNReal.ofReal (K * BH) * N := by
    intro σ hσ v hv
    have ha := isRadialOscAmp_radialOscAmpDeriv hn hΩ d
    have hcont := continuous_radialOscInt (d := d) ha.1.continuous isCompact_radialOscAnnulus
      ha.2.1
    exact hsq Ω p s hs J (fun j => bandDerSym Ω d σ ℓ j v) BH
      (fun j _ => (continuous_const.mul (hcont.comp (continuous_const.prodMk
        (continuous_const_smul _)))).aestronglyMeasurable)
      (Real.sqrt_nonneg _) (fun η => by
        rw [hBH, Real.sq_sqrt (by positivity)]; exact (hH σ hσ v hv ℓ J η).2) f hf1
  -- the pointwise square inequality
  set Q : ℝ → (Fin n → ℤ) → ℝ≥0∞ := fun σ x => ‖g σ 1 x‖ₑ ^ 2 +
    2 * ∫⁻ v in Ioc (1 : ℝ) 2, ‖g σ v x‖ₑ * ‖h σ v x‖ₑ with hQ
  have hpt : ∀ x, ‖bandFin n d Ω p s ℓ F f x‖ₑ ^ 2 ≤ Q 1 x + Q (-1) x := by
    intro x
    have key : ∀ i ∈ F, ‖latMult (liftSym n d Ω p s i.1.1.1 i.1.1.2
        (radialOscPhi Ω d i.1.2.1 i.1.2.2)) f x‖ₑ ^ 2 ≤ Q 1 x + Q (-1) x := by
      rintro ⟨⟨aq, j, μ⟩, haq, hj, hb1, hb2⟩ hi
      have hjJ : j ∈ J := Finset.mem_image.2 ⟨_, hi, rfl⟩
      have hq : 1 ≤ aq.2 := one_le_of_mem_liftRat (a := aq.1) (by simpa using haq)
      obtain ⟨σ, hσ, u, hu, hμ⟩ := exists_sign_dil (d := d) (ℓ := ℓ) (j := j) (μ := μ) hb1 hb2
      subst hμ
      obtain ⟨hder, hcont⟩ := band_deriv_props (p := p) hn hΩ s aq.1 hq σ ℓ j hf x
      have hF := enorm_sq_le_of_hasDerivAt hder hcont hu
      have hQσ : Q σ x ≤ Q 1 x + Q (-1) x := by
        rcases hσ with rfl | rfl
        · exact le_self_add
        · exact le_add_self
      refine le_trans ?_ hQσ
      refine hF.trans (add_le_add (pow_le_pow_left' ?_ 2)
        (mul_le_mul' le_rfl (lintegral_mono fun v => mul_le_mul' ?_ ?_)))
      · exact enorm_le_enorm_sqrt_sum_sup J (liftRat s) (fun j aq => latMult (liftSym n d Ω p s
          aq.1 aq.2 (radialOscPhi Ω d j (σ * 1 * (2 : ℝ) ^ (ℓ - (2 * d : ℤ) * j)))) f x) hjJ haq
      · exact enorm_le_enorm_sqrt_sum_sup J (liftRat s) (fun j aq => latMult (liftSym n d Ω p s
          aq.1 aq.2 (radialOscPhi Ω d j (σ * v * (2 : ℝ) ^ (ℓ - (2 * d : ℤ) * j)))) f x) hjJ haq
      · exact enorm_le_enorm_sqrt_sum_sup J (liftRat s) (fun j aq => latMult (liftSym n d Ω p s
          aq.1 aq.2 (bandDerSym Ω d σ ℓ j v)) f x) hjJ haq
    rw [enorm_bandFin]
    rcases F.eq_empty_or_nonempty with hF | hF
    · simp [hF]
    · obtain ⟨i, hi, he⟩ := Finset.exists_mem_eq_sup F hF (fun i => ‖latMult (liftSym n d Ω p s
        i.1.1.1 i.1.1.2 (radialOscPhi Ω d i.1.2.1 i.1.2.2)) f x‖ₑ)
      rw [he]; exact key i hi
  -- summation in `x`
  set A := ENNReal.ofReal (K * BG) * N with hA
  set B := ENNReal.ofReal (K * BH) * N with hB
  have hQsum : ∀ σ : ℝ, (σ = 1 ∨ σ = -1) → ∑' x, Q σ x ≤ A ^ 2 + 2 * (A * B) := by
    intro σ hσ
    have h1 : ∑' x, ‖g σ 1 x‖ₑ ^ 2 ≤ A ^ 2 := by
      rw [← arith_eLpNorm_two_sq_eq_tsum]
      exact pow_le_pow_left' (hgL2 σ hσ 1 ⟨le_rfl, one_le_two⟩) 2
    have h2 : ∑' x, ∫⁻ v in Ioc (1 : ℝ) 2, ‖g σ v x‖ₑ * ‖h σ v x‖ₑ ≤ A * B := by
      refine (tsum_lintegral_le_lintegral_tsum _).trans ?_
      refine (setLIntegral_mono' (g := fun _ => A * B) measurableSet_Ioc
        fun v hv => ?_).trans (le_of_eq ?_)
      · have hvI : v ∈ Icc (1 : ℝ) 2 := Ioc_subset_Icc_self hv
        rw [← lintegral_count]
        exact (band_lintegral_enorm_mul_le AEStronglyMeasurable.of_discrete
          AEStronglyMeasurable.of_discrete).trans (mul_le_mul' (hgL2 σ hσ v hvI) (hhL2 σ hσ v hvI))
      · rw [setLIntegral_const, Real.volume_Ioc]; norm_num
    simp only [hQ]
    rw [ENNReal.tsum_add, ENNReal.tsum_mul_left]
    exact add_le_add h1 (mul_le_mul' le_rfl h2)
  have htot : eLpNorm (bandFin n d Ω p s ℓ F f) 2 Measure.count ^ 2 ≤
      2 * (A ^ 2 + 2 * (A * B)) := by
    rw [arith_eLpNorm_two_sq_eq_tsum]
    calc ∑' x, ‖bandFin n d Ω p s ℓ F f x‖ₑ ^ 2 ≤ ∑' x, (Q 1 x + Q (-1) x) :=
          ENNReal.tsum_le_tsum hpt
      _ = ∑' x, Q 1 x + ∑' x, Q (-1) x := ENNReal.tsum_add
      _ ≤ (A ^ 2 + 2 * (A * B)) + (A ^ 2 + 2 * (A * B)) :=
          add_le_add (hQsum 1 (Or.inl rfl)) (hQsum (-1) (Or.inr rfl))
      _ = 2 * (A ^ 2 + 2 * (A * B)) := by ring
  -- the constants
  set Z : ℝ := 2 * ((K * BG) ^ 2 + 2 * ((K * BG) * (K * BH))) with hZ
  have hZ0 : 0 ≤ Z := by positivity
  have eZ : 2 * (A ^ 2 + 2 * (A * B)) = ENNReal.ofReal Z * N ^ 2 := by
    have hKG : 0 ≤ K * BG := mul_nonneg hK0 (Real.sqrt_nonneg _)
    have hKH : 0 ≤ K * BH := mul_nonneg hK0 (Real.sqrt_nonneg _)
    rw [hZ, ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 2), ENNReal.ofReal_add (pow_nonneg hKG 2)
      (mul_nonneg (by norm_num) (mul_nonneg hKG hKH)),
      ENNReal.ofReal_pow hKG, ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 2),
      ENNReal.ofReal_mul hKG, hA, hB]
    simp only [ENNReal.ofReal_ofNat]
    ring
  rw [eZ] at htot
  have h3 := band_le_of_sq_le htot
  refine h3.trans (mul_le_mul_left ?_ _)
  rw [ENNReal.ofReal_rpow_of_nonneg hZ0 (by norm_num), ← Real.sqrt_eq_rpow]
  refine ENNReal.ofReal_le_ofReal ?_
  have hBG2 : BG ^ 2 ≤ CG := by
    rw [hBG, Real.sq_sqrt (by positivity)]; nlinarith
  have hBGH : BG * BH ≤ Real.sqrt (CG * CH) := by
    rw [hBG, hBH, ← Real.sqrt_mul (by positivity)]
    refine Real.sqrt_le_sqrt ?_
    calc CG * cG * (CH * cH) = CG * CH * (cG * cH) := by ring
      _ ≤ CG * CH * 1 := mul_le_mul_of_nonneg_left hcGH (by positivity)
      _ = CG * CH := mul_one _
  have hW : Z ≤ (K * Real.sqrt (2 * (CG + 2 * Real.sqrt (CG * CH)))) ^ 2 := by
    rw [mul_pow, Real.sq_sqrt (by positivity), hZ]
    have hK2 : 0 ≤ K ^ 2 := by positivity
    nlinarith
  calc Real.sqrt Z ≤ Real.sqrt ((K * Real.sqrt (2 * (CG + 2 * Real.sqrt (CG * CH)))) ^ 2) :=
        Real.sqrt_le_sqrt hW
    _ = K * Real.sqrt (2 * (CG + 2 * Real.sqrt (CG * CH))) := Real.sqrt_sq (by positivity)
    _ = CL * Real.sqrt (2 * (CG + 2 * Real.sqrt (CG * CH))) * (2 : ℝ) ^ (-(γ * s)) := by
        rw [hK]; ring


/-! ### Blueprint Lemma 11.1 (`lem:middleband`): endpoint bounds and interpolation -/

lemma one_le_of_mem_bandIdx {s : ℕ} {ℓ : ℤ} (i : bandIdx d s ℓ) : 1 ≤ i.1.1.2 :=
  one_le_of_mem_liftRat (a := i.1.1.1) (by simpa using i.2.1)

/-- Subadditivity of the finite maximal functions on `ℓ¹`. -/
lemma bandFin_add_le (hΩ : IsSWProfile Ω) (s : ℕ) (ℓ : ℤ) (F : Finset (bandIdx d s ℓ))
    {f g : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) (hg : Summable fun z => ‖g z‖)
    (x : Fin n → ℤ) :
    bandFin n d Ω p s ℓ F (f + g) x ≤ bandFin n d Ω p s ℓ F f x + bandFin n d Ω p s ℓ F g x := by
  refine arith_coe_finset_sup_nnnorm_le
    (add_nonneg (bandFin_nonneg s ℓ F f x) (bandFin_nonneg s ℓ F g x)) fun i hi => ?_
  obtain ⟨hc, hb⟩ := continuous_radialOscPhi_and_le (d := d) hΩ i.1.2.1 i.1.2.2
  have hint := integrableOn_liftSym (n := n) (d := d) (Ω := Ω) (p := p) (a := i.1.1.1)
    (q := i.1.1.2) (integrable_mul_liftChi (s := s) hc.aestronglyMeasurable (fun ξ _ => hb ξ))
  rw [latMult_add hint hf hg, Pi.add_apply]
  refine (norm_add_le _ _).trans (add_le_add ?_ ?_)
  · exact_mod_cast Finset.le_sup (f := fun i : bandIdx d s ℓ =>
      ‖latMult (liftSym n d Ω p s i.1.1.1 i.1.1.2 (radialOscPhi Ω d i.1.2.1 i.1.2.2)) f x‖₊) hi
  · exact_mod_cast Finset.le_sup (f := fun i : bandIdx d s ℓ =>
      ‖latMult (liftSym n d Ω p s i.1.1.1 i.1.1.2 (radialOscPhi Ω d i.1.2.1 i.1.2.2)) g x‖₊) hi

/-- Finitely supported functions form a truncation closed class. -/
lemma isTruncationClosed_finite_support :
    IsTruncationClosed {f : (Fin n → ℤ) → ℂ | (Function.support f).Finite} := by
  intro f hf s _
  have hf' : (Function.support f).Finite := hf
  refine ⟨hf'.subset fun x hx => ?_, hf'.subset fun x hx => ?_⟩
  · intro h0; apply hx; simp [Set.indicator_apply, h0]
  · intro h0; apply hx; simp [Set.indicator_apply, h0]

/-- Weak type `(1, 1)` of the finite maximal functions, uniformly in `p, s, ℓ, F` (Lemma 9.4 and
the maximal theorem on `ℤⁿ`). -/
lemma hasWeakTypeOn_one_bandFin (hΩ : IsSWProfile Ω) :
    ∃ A : ℝ≥0, ∀ (p : ℝ) (s : ℕ) (ℓ : ℤ) (F : Finset (bandIdx d s ℓ)),
      HasWeakTypeOn (bandFin n d Ω p s ℓ F) {f | (Function.support f).Finite} 1 A
        Measure.count Measure.count := by
  obtain ⟨C, hC, hdom⟩ := lift_envelope n d hΩ
  have hE : 0 ≤ envelopeConst n := by unfold envelopeConst; positivity
  set c : ℝ := C * envelopeConst n + 1 with hc
  have hc0 : 0 < c := by positivity
  refine ⟨(5 ^ n : ℝ≥0) * c.toNNReal, fun p s ℓ F f hf t ht => ?_⟩
  have hf1 : Summable fun z => ‖f z‖ := summable_of_finite_support hf
  by_cases htop : t = (⊤ : ℝ≥0∞)
  · simp [distributionFunction, htop]
  set c' : ℝ≥0∞ := ENNReal.ofReal c with hc'
  have hc'0 : c' ≠ 0 := by rw [hc']; simpa using hc0
  have hc't : c' ≠ (⊤ : ℝ≥0∞) := ENNReal.ofReal_ne_top
  have hsub : {x | t < ‖bandFin n d Ω p s ℓ F f x‖ₑ} ⊆
      {x | t / c' < cubeMaximalInt n f x} := by
    intro x hx
    simp only [mem_ofPred_eq] at hx ⊢
    rw [ENNReal.div_lt_iff (Or.inl hc'0) (Or.inl hc't)]
    refine hx.trans_le ?_
    rw [enorm_bandFin]
    refine Finset.sup_le fun i _ => ((hdom p s i.1.2.1 i.1.2.2 i.1.1.1 i.1.1.2
      (one_le_of_mem_bandIdx i) f hf1 x).2).trans ?_
    rw [mul_comm]
    gcongr
    exact ENNReal.ofReal_le_ofReal (by linarith)
  have hw := cubeMaximalInt_weak_one n f (t / c')
  calc distributionFunction (bandFin n d Ω p s ℓ F f) t Measure.count
      ≤ Measure.count {x | t / c' < cubeMaximalInt n f x} := measure_mono hsub
    _ ≤ ((5 ^ n : ℝ≥0) : ℝ≥0∞) / (t / c') * ∫⁻ y, ‖f y‖ₑ ∂Measure.count := hw
    _ = ((((5 ^ n : ℝ≥0) * c.toNNReal : ℝ≥0) : ℝ≥0∞) *
          eLpNorm f (ENNReal.ofReal 1) Measure.count / t) ^ (1 : ℝ) := by
        rw [ENNReal.rpow_one, ENNReal.ofReal_one,
          eLpNorm_one_eq_lintegral_enorm AEStronglyMeasurable.of_discrete, ENNReal.coe_mul]
        change _ = _ * c' * _ / t
        rw [ENNReal.div_eq_inv_mul (b := t / c'), ENNReal.inv_div (Or.inl hc't) (Or.inl hc'0)]
        simp only [div_eq_mul_inv]
        ring

/-- The `ℓ^∞` bound of the finite maximal functions, uniformly in `p, s, ℓ, F` (Lemma 9.4 and the
lattice sum of the envelope). -/
lemma hasLinftyBoundOn_bandFin (hΩ : IsSWProfile Ω) :
    ∃ A : ℝ≥0, 0 < A ∧ ∀ (p : ℝ) (s : ℕ) (ℓ : ℤ) (F : Finset (bandIdx d s ℓ)),
      HasLinftyBoundOn (bandFin n d Ω p s ℓ F) {f | (Function.support f).Finite} A
        Measure.count := by
  obtain ⟨C, hC, hdom⟩ := lift_envelope n d hΩ
  have hE : 0 ≤ envelopeConst n := by unfold envelopeConst; positivity
  refine ⟨(C * envelopeConst n + 1).toNNReal, Real.toNNReal_pos.2 (by positivity),
    fun p s ℓ F f hf S hS => ae_of_all _ fun x => ?_⟩
  have hf1 : Summable fun z => ‖f z‖ := summable_of_finite_support hf
  have hS0 : 0 ≤ S := (norm_nonneg _).trans (hS 0)
  rw [Real.norm_of_nonneg (bandFin_nonneg s ℓ F f x), Real.coe_toNNReal _ (by positivity)]
  refine arith_coe_finset_sup_nnnorm_le (by positivity) fun i _ => ?_
  refine ((hdom p s i.1.2.1 i.1.2.2 i.1.1.1 i.1.1.2 (one_le_of_mem_bandIdx i) f hf1 x).1).trans ?_
  set R := max ((2 : ℝ) ^ i.1.2.1) (liftL n d Ω p s : ℝ) with hRdef
  have hR : 1 ≤ R := le_max_of_le_right (one_le_liftL s)
  obtain ⟨hsE, hsum⟩ := summable_latEnvelope_and_tsum_le (n := n) hR
  have hle : ∀ y, latEnvelope n R y * ‖f (x - y)‖ ≤ latEnvelope n R y * S := fun y =>
    mul_le_mul_of_nonneg_left (hS _) (envelope_nonneg (by linarith) _)
  have h1 : ∑' y, latEnvelope n R y * ‖f (x - y)‖ ≤ ∑' y, latEnvelope n R y * S :=
    Summable.tsum_le_tsum hle (Summable.of_nonneg_of_le
      (fun y => mul_nonneg (envelope_nonneg (by linarith) _) (norm_nonneg _)) hle
      (hsE.mul_right S)) (hsE.mul_right S)
  rw [tsum_mul_right] at h1
  calc C * ∑' y, latEnvelope n R y * ‖f (x - y)‖
      ≤ C * ((∑' y, latEnvelope n R y) * S) := mul_le_mul_of_nonneg_left h1 hC
    _ ≤ C * (envelopeConst n * S) := by gcongr
    _ ≤ (C * envelopeConst n + 1) * S := by nlinarith

/-- Marcinkiewicz interpolation (Blueprint Lemma 2.3) of the uniform weak `(1,1)` and `ℓ^∞` bounds
with the `ℓ²` bound `C 2^{-γ s}` of `band_two_finset`: for `1 < t < ∞`,
`‖max_F |Lift_{s,α}[Φ_{j,μ}](D) f|‖_t ≤ C_t 2^{-γ a_t s} ‖f‖_t`, `a_t = min(2/t, 2/t')`. -/
lemma band_lp_finset (hn : 1 ≤ n) (hd : 1 ≤ d) (hΩ : IsSWProfile Ω) {t : ℝ} (ht : 1 < t) :
    ∃ γ : ℝ, 0 < γ ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ (p : ℝ) (s : ℕ), 1 ≤ s → ∀ (ℓ : ℤ)
      (F : Finset (bandIdx d s ℓ)) (f : (Fin n → ℤ) → ℂ), (Function.support f).Finite →
        eLpNorm (bandFin n d Ω p s ℓ F f) (ENNReal.ofReal t) Measure.count ≤
          ENNReal.ofReal (C * (2 : ℝ) ^ (-(γ * paramA t * s))) *
            eLpNorm f (ENNReal.ofReal t) Measure.count := by
  obtain ⟨γ, hγ, C₂, hC₂, h2⟩ := band_two_finset hn hd hΩ
  obtain ⟨A₁, hA₁⟩ := hasWeakTypeOn_one_bandFin (n := n) (d := d) hΩ
  obtain ⟨A₂, hA₂pos, hA₂⟩ := hasLinftyBoundOn_bandFin (n := n) (d := d) hΩ
  set D := {f : (Fin n → ℤ) → ℂ | (Function.support f).Finite}
  set Bs : ℕ → ℝ≥0 := fun s => (C₂ * (2 : ℝ) ^ (-(γ * s))).toNNReal with hBs
  have hsub : ∀ p s ℓ (F : Finset (bandIdx d s ℓ)),
      IsSublinearOn (bandFin n d Ω p s ℓ F) D Measure.count := by
    intro p s ℓ F f hf g hg
    refine ae_of_all _ fun x => ?_
    rw [Real.norm_of_nonneg (bandFin_nonneg s ℓ F _ x),
      Real.norm_of_nonneg (bandFin_nonneg s ℓ F _ x),
      Real.norm_of_nonneg (bandFin_nonneg s ℓ F _ x)]
    exact bandFin_add_le hΩ s ℓ F (summable_of_finite_support hf)
      (summable_of_finite_support hg) x
  have htwo : ∀ p s, 1 ≤ s → ∀ ℓ (F : Finset (bandIdx d s ℓ)),
      HasStrongTypeOn (bandFin n d Ω p s ℓ F) D 2 (Bs s) Measure.count Measure.count := by
    intro p s hs ℓ F f hf
    rw [ENNReal.ofReal_ofNat]
    exact h2 p s hs ℓ F f hf
  -- the interpolated bound with a constant `K` and the power `a_t` of the `ℓ²` constant
  obtain ⟨K, hK, hKb⟩ : ∃ K : ℝ≥0∞, K ≠ ⊤ ∧ ∀ (p : ℝ) (s : ℕ), 1 ≤ s → ∀ (ℓ : ℤ)
      (F : Finset (bandIdx d s ℓ)) (f : (Fin n → ℤ) → ℂ), (Function.support f).Finite →
        eLpNorm (bandFin n d Ω p s ℓ F f) (ENNReal.ofReal t) Measure.count ≤
          K * (Bs s : ℝ≥0∞) ^ paramA t * eLpNorm f (ENNReal.ofReal t) Measure.count := by
    rcases lt_trichotomy t 2 with ht2 | rfl | ht2
    · set θ : ℝ := 2 - 2 / t
      have hθ : 1 / t = (1 - θ) / 1 + θ / 2 := by simp only [θ]; field_simp; ring
      have h1θ : 0 ≤ 1 - θ := by
        have : 1 ≤ 2 / t := by rw [le_div_iff₀ (by linarith)]; linarith
        simp only [θ]; linarith
      refine ⟨(marcinkiewiczConst 1 2 t : ℝ≥0∞) * (A₁ : ℝ≥0∞) ^ (1 - θ),
        ENNReal.mul_ne_top ENNReal.coe_ne_top
          (ENNReal.rpow_ne_top_of_nonneg h1θ ENNReal.coe_ne_top),
        fun p s hs ℓ F f hf => ?_⟩
      rw [paramA_eq_of_le_two ht ht2.le]
      refine (eLpNorm_le_of_hasWeakTypeOn one_pos ht ht2 hθ
        (hA₁ p s ℓ F) ((htwo p s hs ℓ F).hasWeakTypeOn two_pos)
        (hsub p s ℓ F) isTruncationClosed_finite_support hf AEStronglyMeasurable.of_discrete
        AEStronglyMeasurable.of_discrete).trans (le_of_eq ?_)
      ring
    · refine ⟨1, ENNReal.one_ne_top, fun p s hs ℓ F f hf => ?_⟩
      rw [paramA_eq_of_two_le ht le_rfl, div_self two_ne_zero, ENNReal.rpow_one, one_mul]
      exact htwo p s hs ℓ F f hf
    · have h1 : 0 ≤ 1 - 2 / t := by rw [sub_nonneg, div_le_one (by linarith)]; linarith
      refine ⟨(marcinkiewiczConstTop 2 t : ℝ≥0∞) * (A₂ : ℝ≥0∞) ^ (1 - 2 / t),
        ENNReal.mul_ne_top ENNReal.coe_ne_top (ENNReal.rpow_ne_top_of_nonneg h1 ENNReal.coe_ne_top),
        fun p s hs ℓ F f hf => ?_⟩
      rw [paramA_eq_of_two_le ht ht2.le]
      calc eLpNorm (bandFin n d Ω p s ℓ F f) (ENNReal.ofReal t) Measure.count
          ≤ (marcinkiewiczConstTop 2 t : ℝ≥0∞) * (Bs s : ℝ≥0∞) ^ (2 / t) *
              (A₂ : ℝ≥0∞) ^ (1 - 2 / t) * eLpNorm f (ENNReal.ofReal t) Measure.count :=
            eLpNorm_le_of_hasWeakTypeOn_of_linfty two_pos ht2
              ((htwo p s hs ℓ F).hasWeakTypeOn two_pos) (hA₂ p s ℓ F) (hsub p s ℓ F)
              isTruncationClosed_finite_support hf AEStronglyMeasurable.of_discrete
              AEStronglyMeasurable.of_discrete (Or.inl hA₂pos)
        _ = _ := by ring
  have ha := paramA_pos ht
  refine ⟨γ, hγ, K.toReal * C₂ ^ paramA t, by positivity, fun p s hs ℓ F f hf => ?_⟩
  refine (hKb p s hs ℓ F f hf).trans (le_of_eq ?_)
  congr 1
  have e1 : ((Bs s : ℝ≥0) : ℝ≥0∞) = ENNReal.ofReal (C₂ * (2 : ℝ) ^ (-(γ * s))) := rfl
  rw [e1, ENNReal.ofReal_rpow_of_nonneg (by positivity) ha.le,
    Real.mul_rpow hC₂ (by positivity), ← Real.rpow_mul (by norm_num),
    ← ENNReal.ofReal_toReal hK, ← ENNReal.ofReal_mul ENNReal.toReal_nonneg]
  congr 1
  rw [ENNReal.ofReal_toReal hK]
  ring_nf

/-- **Blueprint Lemma 11.1 (`lem:middleband`)**, a uniform-in-band arithmetic gain: for
`n, d ≥ 1`, an admissible profile `Ω` and `1 < p < ∞` there are `b_p > 0` and `C_p` such that
for every `s ≥ 1`, every integer `ℓ` and every finitely supported `f`,
`‖𝓑_{s,ℓ} f‖_p ≤ C_p 2^{-b_p s} ‖f‖_p`, where
`𝓑_{s,ℓ} f = sup_{α ∈ 𝓡_s, j ≥ 1, 2^ℓ ≤ |μ| 2^{Dj} ≤ 2^{ℓ+1}} |Lift_{s,α}[Φ_{j,μ}](D) f|`
(`bandOp`). One may take `b_p = γ min(2/p, 2/p')` (`γ` from eq. (9.9)). -/
theorem bandOp_uniform (hn : 1 ≤ n) (hd : 1 ≤ d) (hΩ : IsSWProfile Ω) (hp : 1 < p) :
    ∃ b : ℝ, 0 < b ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ s : ℕ, 1 ≤ s → ∀ ℓ : ℤ,
      ∀ f : (Fin n → ℤ) → ℂ, (Function.support f).Finite →
        eLpNorm (bandOp n d Ω p s ℓ f) (ENNReal.ofReal p) Measure.count ≤
          ENNReal.ofReal (C * (2 : ℝ) ^ (-(b * s))) *
            eLpNorm f (ENNReal.ofReal p) Measure.count := by
  obtain ⟨γ, hγ, C, hC, h⟩ := band_lp_finset hn hd hΩ hp
  refine ⟨γ * paramA p, mul_pos hγ (paramA_pos hp), C, hC, fun s hs ℓ f hf => ?_⟩
  have e : bandOp n d Ω p s ℓ f = fun x => ⨆ i : bandIdx d s ℓ,
      ‖latMult (liftSym n d Ω p s i.1.1.1 i.1.1.2 (radialOscPhi Ω d i.1.2.1 i.1.2.2)) f x‖ₑ :=
    funext fun x => bandOp_eq_iSup s ℓ f x
  rw [e]
  refine eLpNorm_iSup_le_of_finset_count ENNReal.ofReal_ne_top _ _ fun F => ?_
  have h1 := h p s hs ℓ F f hf
  rw [← eLpNorm_enorm _ AEStronglyMeasurable.of_discrete] at h1
  simpa only [enorm_bandFin] using h1

/-! ### Blueprint Theorem 11.3 (`thm:liftedSW`) -/

/-- Minkowski for countable sums of `[0, ∞]`-valued functions on `ℤⁿ` (finite sums and monotone
convergence). -/
lemma eLpNorm_tsum_le_count {q : ℝ≥0∞} (hq : 1 ≤ q) (hq' : q ≠ ⊤)
    (g : ℕ → (Fin n → ℤ) → ℝ≥0∞) :
    eLpNorm (fun x => ∑' k, g k x) q Measure.count ≤ ∑' k, eLpNorm (g k) q Measure.count := by
  have e : (fun x => ∑' k, g k x) = fun x => ⨆ N : ℕ, ∑ k ∈ Finset.range N, g k x :=
    funext fun x => ENNReal.tsum_eq_iSup_nat
  rw [e]
  refine eLpNorm_iSup_le_of_finset_count hq' _ _ fun F => ?_
  have hpt : ∀ x, ‖F.sup fun N => ∑ k ∈ Finset.range N, g k x‖ₑ ≤
      ‖(∑ k ∈ Finset.range (F.sup id), g k) x‖ₑ := by
    intro x
    rw [enorm_eq_self, enorm_eq_self, Finset.sum_apply]
    exact Finset.sup_le fun N hN => Finset.sum_le_sum_of_subset
      (Finset.range_mono (Finset.le_sup (f := id) hN))
  refine (eLpNorm_mono_enorm AEStronglyMeasurable.of_discrete hpt).trans ?_
  exact (eLpNorm_sum_le hq).trans (ENNReal.sum_le_tsum _)

/-- The indices of `[a, b]` satisfying a downward closed condition form an initial interval
`[a, c)`. -/
lemma filter_Icc_eq_Ico (a b : ℕ) (P : ℕ → Prop) [DecidablePred P]
    (hP : ∀ i j, i ≤ j → P j → P i) :
    ∃ c, a ≤ c ∧ (Finset.Icc a b).filter P = Finset.Ico a c := by
  refine ⟨((Finset.Icc a b).filter P).sup (· + 1) ⊔ a, le_sup_right, ?_⟩
  ext j
  simp only [Finset.mem_filter, Finset.mem_Icc, Finset.mem_Ico]
  constructor
  · rintro ⟨⟨h1, h2⟩, h3⟩
    refine ⟨h1, lt_of_lt_of_le (Nat.lt_succ_self j) (le_sup_of_le_left ?_)⟩
    exact Finset.le_sup (f := (· + 1)) (Finset.mem_filter.2 ⟨Finset.mem_Icc.2 ⟨h1, h2⟩, h3⟩)
  · rintro ⟨h1, h2⟩
    rcases lt_sup_iff.1 h2 with h | h
    · obtain ⟨i, hi, hji⟩ := Finset.lt_sup_iff.1 h
      simp only [Finset.mem_filter, Finset.mem_Icc] at hi
      exact ⟨⟨h1, by omega⟩, hP j i (by omega) hi.2⟩
    · omega

/-- Linearity of the lifted operators over finite sums of continuous bounded symbols. -/
lemma latMult_liftSym_finsetSum {s a q : ℕ} {ι : Type*} (F : Finset ι)
    {m : ι → EuclideanSpace ℝ (Fin n) → ℂ} (hc : ∀ i, Continuous (m i)) {M : ι → ℝ}
    (hM : ∀ i ξ, ‖m i ξ‖ ≤ M i) {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖)
    (x : Fin n → ℤ) :
    latMult (liftSym n d Ω p s a q (fun ξ => ∑ i ∈ F, m i ξ)) f x =
      ∑ i ∈ F, latMult (liftSym n d Ω p s a q (m i)) f x := by
  have hM0 : ∀ i, 0 ≤ M i := fun i => (norm_nonneg _).trans (hM i 0)
  have h := latMult_liftSym_sum_mul (d := d) (Ω := Ω) (p := p) (s := s) (a := a) (q := q) F
    (fun _ => 1) (m := m) (fun i _ => (hc i).aestronglyMeasurable) (B := ∑ i ∈ F, M i)
    (fun i hi ξ => (hM i ξ).trans (Finset.single_le_sum (fun j _ => hM0 j) hi)) hf x
  simpa only [one_mul] using h

/-- For `j < j'`, `4 |μ| 2^{Dj} ≤ |μ| 2^{Dj'}` (`D = 2d ≥ 2`). -/
lemma band_weight_four_mul_le (hd : 1 ≤ d) {μ : ℝ} {j j' : ℕ} (h : j < j') :
    4 * (|μ| * (2 : ℝ) ^ ((2 * d : ℤ) * (j : ℤ))) ≤ |μ| * (2 : ℝ) ^ ((2 * d : ℤ) * (j' : ℤ)) := by
  have e : (2 : ℝ) ^ ((2 * d : ℤ) * (j' : ℤ)) =
      (2 : ℝ) ^ ((2 * d : ℤ) * (j : ℤ)) * (2 : ℝ) ^ ((2 * d : ℤ) * ((j' : ℤ) - j)) := by
    rw [← zpow_add₀ two_ne_zero]; congr 1; ring
  have h4 : (4 : ℝ) ≤ (2 : ℝ) ^ ((2 * d : ℤ) * ((j' : ℤ) - j)) := by
    have : (2 : ℤ) ≤ (2 * d : ℤ) * ((j' : ℤ) - j) := by
      have h1 : (1 : ℤ) ≤ (j' : ℤ) - j := by omega
      have h2 : (2 : ℤ) ≤ 2 * (d : ℤ) := by omega
      nlinarith
    calc (4 : ℝ) = (2 : ℝ) ^ (2 : ℤ) := by norm_num
      _ ≤ _ := zpow_le_zpow_right₀ (by norm_num) this
  rw [e]
  have h0 : 0 ≤ |μ| * (2 : ℝ) ^ ((2 * d : ℤ) * (j : ℤ)) := by positivity
  nlinarith

/-- At most one scale lies in a band: `j ↦ ⌊log₂(|μ| 2^{Dj})⌋` is injective where `μ ≠ 0`. -/
lemma band_log_injective (hd : 1 ≤ d) {μ : ℝ} (hμ : μ ≠ 0) {j j' : ℕ}
    (h : Int.log 2 (|μ| * (2 : ℝ) ^ ((2 * d : ℤ) * (j : ℤ))) =
      Int.log 2 (|μ| * (2 : ℝ) ^ ((2 * d : ℤ) * (j' : ℤ)))) : j = j' := by
  have key : ∀ i i' : ℕ, i < i' → Int.log 2 (|μ| * (2 : ℝ) ^ ((2 * d : ℤ) * (i : ℤ))) ≠
      Int.log 2 (|μ| * (2 : ℝ) ^ ((2 * d : ℤ) * (i' : ℤ))) := by
    intro i i' hii' he
    set X := |μ| * (2 : ℝ) ^ ((2 * d : ℤ) * (i : ℤ))
    set X' := |μ| * (2 : ℝ) ^ ((2 * d : ℤ) * (i' : ℤ))
    have hX : 0 < X := by positivity
    have h1 := Int.zpow_log_le_self (b := 2) (by norm_num) hX
    have h2 := Int.lt_zpow_succ_log_self (b := 2) (by norm_num) X'
    rw [← he, zpow_add_one₀ (by norm_num)] at h2
    have h3 := band_weight_four_mul_le (μ := μ) hd hii'
    push_cast at h1 h2
    nlinarith
  rcases lt_trichotomy j j' with hl | he | hl
  · exact absurd h (key j j' hl)
  · exact he
  · exact absurd h.symm (key j' j hl)

/-- The maximal lifted polynomial partial sums of Blueprint Theorem 11.3 (`thm:liftedSW`):
`𝒫_s f(x) = sup_{α ∈ 𝓡_s, μ ∈ ℝ, 1 ≤ a ≤ b} |Lift_{s,α}[∑_{j=a}^b Φ_{j,μ}](D) f(x)|`
(integers `a, b`), valued in `[0, ∞]`. -/
noncomputable def liftedPartialMax (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ)
    (s : ℕ) (f : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) : ℝ≥0∞ :=
  ⨆ (aq ∈ liftRat s) (μ : ℝ) (a : ℕ) (b : ℕ) (_ : 1 ≤ a ∧ a ≤ b),
    ‖latMult (liftSym n d Ω p s aq.1 aq.2
      (fun ξ => ∑ j ∈ Finset.Icc a b, radialOscPhi Ω d j μ ξ)) f x‖ₑ

/-- The low-band error kernel (the proof of Blueprint Theorem 11.3): on the support of `K_j`,
`|e(μ P) - 1| ≤ C |μ| 2^{Dj}`, hence `|(e(μ P) - 1) K_j| ≤ C |μ| 2^{Dj} B_{2^j}`. -/
lemma exists_norm_oscErr_le (hΩ : IsSWProfile Ω) (d : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (j : ℤ) (μ : ℝ) (z : EuclideanSpace ℝ (Fin n)),
      ‖eC (μ * radialPoly n d z) * dyadicKernel Ω j z - dyadicKernel Ω j z‖ ≤
        C * (|μ| * (2 : ℝ) ^ ((2 * d : ℤ) * j)) * envelope n ((2 : ℝ) ^ j) z := by
  obtain ⟨C₂, hC₂, h₂⟩ := exists_norm_oscKernel_le hΩ d
  refine ⟨2 * π * 2 ^ (2 * d) * C₂, by positivity, fun j μ z => ?_⟩
  have hK : ‖dyadicKernel Ω j z‖ ≤ C₂ * envelope n ((2 : ℝ) ^ j) z := by
    simpa [eC_zero] using h₂ j 0 z
  have henv : 0 ≤ envelope n ((2 : ℝ) ^ j) z := envelope_nonneg (by positivity) _
  rw [← sub_one_mul, norm_mul]
  by_cases hz : dyadicKernel Ω j z = 0
  · rw [hz, norm_zero, mul_zero]; positivity
  have hsupp := (support_dyadicKernel (Ω := Ω) j hz).2
  have he : ‖eC (μ * radialPoly n d z) - 1‖ ≤
      2 * π * 2 ^ (2 * d) * (|μ| * (2 : ℝ) ^ ((2 * d : ℤ) * j)) := by
    rw [radialPoly_eq_norm_pow]
    have h1 := norm_eC_sub_eC_le (μ * ‖z‖ ^ (2 * d)) 0
    rw [eC_zero, sub_zero, abs_mul, abs_pow, abs_norm] at h1
    have h2 : ‖z‖ ^ (2 * d) ≤ 2 ^ (2 * d) * (2 : ℝ) ^ ((2 * d : ℤ) * j) := by
      calc ‖z‖ ^ (2 * d) ≤ ((2 : ℝ) ^ (j + 1)) ^ (2 * d) :=
            pow_le_pow_left₀ (norm_nonneg _) hsupp.le _
        _ = _ := by
          rw [← zpow_natCast, ← zpow_mul, ← zpow_natCast (2 : ℝ) (2 * d), ← zpow_add₀ two_ne_zero]
          congr 1; push_cast; ring
    calc _ ≤ 2 * π * (|μ| * ‖z‖ ^ (2 * d)) := h1
      _ ≤ 2 * π * (|μ| * (2 ^ (2 * d) * (2 : ℝ) ^ ((2 * d : ℤ) * j))) := by gcongr
      _ = _ := by ring
  calc ‖eC (μ * radialPoly n d z) - 1‖ * ‖dyadicKernel Ω j z‖
      ≤ (2 * π * 2 ^ (2 * d) * (|μ| * (2 : ℝ) ^ ((2 * d : ℤ) * j))) *
          (C₂ * envelope n ((2 : ℝ) ^ j) z) :=
        mul_le_mul he hK (norm_nonneg _) (by positivity)
    _ = _ := by ring

/-- The pointwise decomposition of `𝒫_s f` (the proof of Blueprint Theorem 11.3): for every
`B ∈ ℕ`, uniformly in `α, μ, a, b`,
`𝒫_s f ≤ ∑_{-B ≤ ℓ < B} 𝓑_{s,ℓ} f + ∑_{ℓ ≥ B} 𝓑_{s,ℓ} f + 2 T f + C 2^{-B} 𝖬 f`, where `T f` is the
maximal function of Lemma 10.1 (`lift_trunc`). -/
lemma liftedPartialMax_le (hd : 1 ≤ d) (hΩ : IsSWProfile Ω) :
    ∃ Ce : ℝ, 0 ≤ Ce ∧ ∀ (s B : ℕ) (f : (Fin n → ℤ) → ℂ), (Function.support f).Finite →
      ∀ x : Fin n → ℤ, liftedPartialMax n d Ω p s f x ≤
        (∑ ℓ ∈ Finset.Ico (-(B : ℤ)) B, bandOp n d Ω p s ℓ f x) +
        (∑' k : ℕ, bandOp n d Ω p s ((B : ℤ) + k) f x) +
        ((⨆ J : ℕ, ⨆ (_ : 1 ≤ J), (liftRat s).sup fun aq =>
            ‖latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω J)) f x‖ₑ) +
          (⨆ J : ℕ, ⨆ (_ : 1 ≤ J), (liftRat s).sup fun aq =>
            ‖latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω J)) f x‖ₑ)) +
        ENNReal.ofReal (Ce * (2 : ℝ) ^ (-(B : ℤ))) * cubeMaximalInt n f x := by
  obtain ⟨C₁, hC₁, h₁⟩ := norm_latMult_liftSym_fourier_le n
  obtain ⟨C₃, hC₃, h₃⟩ := exists_norm_oscErr_le (n := n) hΩ d
  have hE0 : 0 ≤ envelopeConst n := by unfold envelopeConst; positivity
  refine ⟨C₁ * C₃ * envelopeConst n * 2 ^ (2 * d), by positivity, ?_⟩
  intro s B f hf x
  classical
  set T := (⨆ J : ℕ, ⨆ (_ : 1 ≤ J), (liftRat s).sup fun aq =>
    ‖latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω J)) f x‖ₑ) with hT
  have hf1 : Summable fun z => ‖f z‖ := summable_of_finite_support hf
  refine iSup₂_le fun aq haq => iSup_le fun μ => iSup_le fun a => iSup_le fun b =>
    iSup_le fun hab => ?_
  have hq : 1 ≤ aq.2 := one_le_of_mem_liftRat (a := aq.1) (by simpa using haq)
  set X : ℕ → ℝ := fun j => |μ| * (2 : ℝ) ^ ((2 * d : ℤ) * (j : ℤ)) with hX
  set L := (Finset.Icc a b).filter (fun j => X j < (2 : ℝ) ^ (-(B : ℤ))) with hL
  set R := (Finset.Icc a b).filter (fun j => ¬ X j < (2 : ℝ) ^ (-(B : ℤ))) with hR
  -- linearity in the symbol
  have hsum : latMult (liftSym n d Ω p s aq.1 aq.2
      (fun ξ => ∑ j ∈ Finset.Icc a b, radialOscPhi Ω d j μ ξ)) f x =
      ∑ j ∈ L, latMult (liftSym n d Ω p s aq.1 aq.2 (radialOscPhi Ω d j μ)) f x +
        ∑ j ∈ R, latMult (liftSym n d Ω p s aq.1 aq.2 (radialOscPhi Ω d j μ)) f x := by
    rw [latMult_liftSym_finsetSum (Finset.Icc a b) (m := fun j : ℕ => radialOscPhi Ω d j μ)
      (fun j => (continuous_radialOscPhi_and_le hΩ j μ).1)
      (fun j ξ => (continuous_radialOscPhi_and_le hΩ j μ).2 ξ) hf1 x]
    exact (Finset.sum_filter_add_sum_filter_not _ _ _).symm
  -- `Φ_{j,μ} = 𝓕 K_j + 𝓕((e(μP) - 1) K_j)`
  have hLdec : ∀ j : ℕ, latMult (liftSym n d Ω p s aq.1 aq.2 (radialOscPhi Ω d j μ)) f x =
      latMult (liftSym n d Ω p s aq.1 aq.2 (𝓕 (dyadicKernel Ω j))) f x +
      latMult (liftSym n d Ω p s aq.1 aq.2 (𝓕 (fun z =>
        eC (μ * radialPoly n d z) * dyadicKernel Ω j z - dyadicKernel Ω j z))) f x := by
    intro j
    have hi1 := integrable_oscKernel hΩ d (j : ℤ) μ
    have hi2 := integrable_dyadicKernel hΩ (j : ℤ)
    have e : 𝓕 (fun z => eC (μ * radialPoly n d z) * dyadicKernel Ω j z - dyadicKernel Ω j z) =
        fun ξ => radialOscPhi Ω d j μ ξ - 𝓕 (dyadicKernel Ω j) ξ := by
      funext ξ
      exact fourier_sub_apply hi1 hi2 ξ
    obtain ⟨hc1, hb1⟩ := continuous_radialOscPhi_and_le (d := d) hΩ j μ
    obtain ⟨hc2, hb2⟩ := continuous_fourier_and_norm_le hi2
    rw [e, latMult_liftSym_sub hc1.aestronglyMeasurable hc2.aestronglyMeasurable
      (B := (∫ z, ‖bandKer n d Ω ((j : ℤ), μ) z‖) + ∫ z, ‖dyadicKernel Ω j z‖)
      (fun ξ => (hb1 ξ).trans (le_add_of_nonneg_right (integral_nonneg fun _ => norm_nonneg _)))
      (fun ξ => (hb2 ξ).trans (le_add_of_nonneg_left (integral_nonneg fun _ => norm_nonneg _)))
      hf1 x]
    ring
  -- the low indices form an initial interval `[a, c)`
  obtain ⟨c, hac, hLc⟩ := filter_Icc_eq_Ico a b (fun j => X j < (2 : ℝ) ^ (-(B : ℤ)))
    (fun i j hij hj => lt_of_le_of_lt (mul_le_mul_of_nonneg_left
      (zpow_le_zpow_right₀ (by norm_num) (mul_le_mul_of_nonneg_left (by exact_mod_cast hij)
        (by positivity))) (abs_nonneg μ)) hj)
  have htr : ∀ J : ℕ, latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω J)) f x =
      ∑ j ∈ Finset.Ico 1 J,
        latMult (liftSym n d Ω p s aq.1 aq.2 (𝓕 (dyadicKernel Ω (j : ℤ)))) f x := fun J =>
    latMult_liftSym_finsetSum (Finset.Ico 1 J) (m := fun j : ℕ => 𝓕 (dyadicKernel Ω (j : ℤ)))
      (fun j => continuous_fourier_dyadicKernel hΩ j)
      (fun j ξ => (continuous_fourier_and_norm_le (integrable_dyadicKernel hΩ j)).2 ξ) hf1 x
  have hTle : ∀ J : ℕ, 1 ≤ J →
      ‖latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω J)) f x‖ₑ ≤ T := by
    intro J hJ
    have hh : aq ∈ liftRat s := haq
    have h1 : ‖latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω J)) f x‖ₑ ≤
        (liftRat s).sup (fun aq : ℕ × ℕ =>
          ‖latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω J)) f x‖ₑ) :=
      Finset.le_sup (f := fun aq : ℕ × ℕ =>
        ‖latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω J)) f x‖ₑ) hh
    refine h1.trans ?_
    rw [hT]
    exact le_iSup₂_of_le (f := fun (J : ℕ) (_ : 1 ≤ J) => (liftRat s).sup fun aq =>
      ‖latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω J)) f x‖ₑ) J hJ le_rfl
  have hlow1 : ∑ j ∈ L, latMult (liftSym n d Ω p s aq.1 aq.2 (𝓕 (dyadicKernel Ω j))) f x =
      latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω c)) f x -
        latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω a)) f x := by
    have hLc' : L = Finset.Ico a c := by rw [hL]; convert hLc
    rw [htr, htr, hLc', ← Finset.sum_Ico_consecutive _ hab.1 hac]; ring
  -- the low error
  have herr : ∀ j : ℕ, ‖latMult (liftSym n d Ω p s aq.1 aq.2 (𝓕 (fun z =>
        eC (μ * radialPoly n d z) * dyadicKernel Ω j z - dyadicKernel Ω j z))) f x‖ₑ ≤
      ENNReal.ofReal (C₁ * C₃ * envelopeConst n * X j) * cubeMaximalInt n f x := by
    intro j
    have hR0 : (0 : ℝ) < 2 ^ (j : ℤ) := by positivity
    have hK0 : 0 ≤ C₃ * X j := by positivity
    have h := h₁ d Ω p s aq.1 aq.2 hq _ (C₃ * X j) _
      ((integrable_oscKernel hΩ d (j : ℤ) μ).sub (integrable_dyadicKernel hΩ (j : ℤ))) hR0 hK0
      (fun z => h₃ j μ z) f hf1 x
    have hR' : 1 ≤ max ((2 : ℝ) ^ (j : ℤ)) (liftL n d Ω p s) :=
      le_max_of_le_right (one_le_liftL s)
    have hS0 : 0 ≤ ∑' y, latEnvelope n (max ((2 : ℝ) ^ (j : ℤ)) (liftL n d Ω p s)) y *
        ‖f (x - y)‖ :=
      tsum_nonneg fun y => mul_nonneg (envelope_nonneg (by linarith) _) (norm_nonneg _)
    rw [← ofReal_norm]
    refine (ENNReal.ofReal_le_ofReal h).trans ?_
    rw [ENNReal.ofReal_mul (by positivity)]
    refine (mul_le_mul' le_rfl (ofReal_tsum_latEnvelope_mul_le hR' hf1 x)).trans (le_of_eq ?_)
    rw [← mul_assoc, ← ENNReal.ofReal_mul (by positivity)]
    congr 2; ring
  have hgeo : ∑ j ∈ L, X j ≤ 2 ^ (2 * d) * (2 : ℝ) ^ (-(B : ℤ)) := by
    rcases L.eq_empty_or_nonempty with hLe | hLne
    · rw [hLe, Finset.sum_empty]; positivity
    set m := L.max' hLne
    have hmL : m ∈ L := L.max'_mem hLne
    have hXm : X m < (2 : ℝ) ^ (-(B : ℤ)) := (Finset.mem_filter.1 hmL).2
    have hXj : ∀ j : ℕ, X j = |μ| * ((2 : ℝ) ^ (2 * d)) ^ j := by
      intro j
      simp only [hX]
      rw [show ((2 * d : ℤ) * (j : ℤ)) = ((2 * d * j : ℕ) : ℤ) by push_cast; ring, zpow_natCast,
        pow_mul]
    have hlt : ∀ j ∈ L, j < m + 1 := fun j hj => Nat.lt_succ_of_le (L.le_max' j hj)
    have h2 : 2 ≤ 2 ^ (2 * d) :=
      calc 2 = 2 ^ 1 := by norm_num
        _ ≤ 2 ^ (2 * d) := Nat.pow_le_pow_right (by norm_num) (by omega)
    have hg := (Nat.cast_le (α := ℝ)).2 (Nat.geomSum_lt h2 hlt).le
    push_cast at hg
    calc ∑ j ∈ L, X j = |μ| * ∑ j ∈ L, ((2 : ℝ) ^ (2 * d)) ^ j := by
          rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun j _ => hXj j
      _ ≤ |μ| * ((2 : ℝ) ^ (2 * d)) ^ (m + 1) := mul_le_mul_of_nonneg_left hg (abs_nonneg _)
      _ = 2 ^ (2 * d) * X m := by rw [hXj, pow_succ]; ring
      _ ≤ 2 ^ (2 * d) * (2 : ℝ) ^ (-(B : ℤ)) := by gcongr
  have hlow2 : ‖∑ j ∈ L, latMult (liftSym n d Ω p s aq.1 aq.2 (𝓕 (fun z =>
        eC (μ * radialPoly n d z) * dyadicKernel Ω j z - dyadicKernel Ω j z))) f x‖ₑ ≤
      ENNReal.ofReal (C₁ * C₃ * envelopeConst n * 2 ^ (2 * d) * (2 : ℝ) ^ (-(B : ℤ))) *
        cubeMaximalInt n f x := by
    refine (enorm_sum_le _ _).trans ((Finset.sum_le_sum fun j _ => herr j).trans ?_)
    rw [← Finset.sum_mul, ← ENNReal.ofReal_sum_of_nonneg (fun j _ => by positivity)]
    gcongr
    rw [← Finset.mul_sum]
    calc C₁ * C₃ * envelopeConst n * ∑ j ∈ L, X j
        ≤ C₁ * C₃ * envelopeConst n * (2 ^ (2 * d) * (2 : ℝ) ^ (-(B : ℤ))) :=
          mul_le_mul_of_nonneg_left hgeo (by positivity)
      _ = _ := by ring
  -- the bands
  have hRpos : ∀ j ∈ R, 0 < X j := fun j hj =>
    lt_of_lt_of_le (by positivity) (not_lt.1 (Finset.mem_filter.1 hj).2)
  set lg : ℕ → ℤ := fun j => Int.log 2 (X j) with hlg
  have hlg1 : ∀ j ∈ R, (2 : ℝ) ^ (lg j) ≤ X j ∧ X j ≤ (2 : ℝ) ^ (lg j + 1) := by
    intro j hj
    have h1 := Int.zpow_log_le_self (b := 2) (by norm_num) (hRpos j hj)
    have h2 := Int.lt_zpow_succ_log_self (b := 2) (by norm_num) (X j)
    push_cast at h1 h2
    exact ⟨h1, h2.le⟩
  have hlgB : ∀ j ∈ R, -(B : ℤ) ≤ lg j := by
    intro j hj
    have h1 : (2 : ℝ) ^ (-(B : ℤ)) ≤ X j := not_lt.1 (Finset.mem_filter.1 hj).2
    have h2 := Int.lt_zpow_succ_log_self (b := 2) (by norm_num) (X j)
    push_cast at h2
    have h3 : (2 : ℝ) ^ (-(B : ℤ)) < (2 : ℝ) ^ (lg j + 1) := h1.trans_lt h2
    have := (zpow_lt_zpow_iff_right₀ (by norm_num : (1 : ℝ) < 2)).1 h3
    omega
  have hμ : ∀ j ∈ R, μ ≠ 0 := fun j hj h0 => by
    have := hRpos j hj; simp [hX, h0] at this
  have hband : ∀ j ∈ R, ‖latMult (liftSym n d Ω p s aq.1 aq.2 (radialOscPhi Ω d j μ)) f x‖ₑ ≤
      bandOp n d Ω p s (lg j) f x := by
    intro j hj
    have hj1 : (1 : ℤ) ≤ (j : ℤ) := by
      have := (Finset.mem_Icc.1 (Finset.mem_filter.1 hj).1).1
      have := hab.1
      omega
    exact le_iSup₂_of_le aq haq (le_iSup₂_of_le (j : ℤ) hj1 (le_iSup₂_of_le μ (hlg1 j hj) le_rfl))
  have hRsum : ‖∑ j ∈ R, latMult (liftSym n d Ω p s aq.1 aq.2 (radialOscPhi Ω d j μ)) f x‖ₑ ≤
      (∑ ℓ ∈ Finset.Ico (-(B : ℤ)) B, bandOp n d Ω p s ℓ f x) +
        ∑' k : ℕ, bandOp n d Ω p s ((B : ℤ) + k) f x := by
    refine (enorm_sum_le _ _).trans ((Finset.sum_le_sum hband).trans ?_)
    rw [← Finset.sum_image (f := fun ℓ => bandOp n d Ω p s ℓ f x) (s := R) (g := lg)
      (by intro j hj j' hj' h; exact band_log_injective hd (hμ j hj) h)]
    set S := R.image lg with hSdef
    have hS : ∀ ℓ ∈ S, -(B : ℤ) ≤ ℓ := by
      intro ℓ hℓ
      obtain ⟨j, hj, rfl⟩ := Finset.mem_image.1 hℓ
      exact hlgB j hj
    rw [← Finset.sum_filter_add_sum_filter_not S (fun ℓ => ℓ < (B : ℤ))]
    refine add_le_add (Finset.sum_le_sum_of_subset fun ℓ hℓ => ?_) ?_
    · obtain ⟨h1, h2⟩ := Finset.mem_filter.1 hℓ
      exact Finset.mem_Ico.2 ⟨hS ℓ h1, h2⟩
    · calc ∑ ℓ ∈ S.filter (fun ℓ => ¬ ℓ < (B : ℤ)), bandOp n d Ω p s ℓ f x
          = ∑ ℓ ∈ S.filter (fun ℓ => ¬ ℓ < (B : ℤ)),
              (fun k : ℕ => bandOp n d Ω p s ((B : ℤ) + k) f x) (ℓ - (B : ℤ)).toNat := by
            refine Finset.sum_congr rfl fun ℓ hℓ => ?_
            have := not_lt.1 (Finset.mem_filter.1 hℓ).2
            simp only
            rw [show (B : ℤ) + ((ℓ - (B : ℤ)).toNat : ℤ) = ℓ by omega]
        _ = ∑ k ∈ (S.filter (fun ℓ => ¬ ℓ < (B : ℤ))).image (fun ℓ : ℤ => (ℓ - (B : ℤ)).toNat),
              bandOp n d Ω p s ((B : ℤ) + k) f x := by
            rw [Finset.sum_image]
            intro ℓ hℓ ℓ' hℓ' h
            have h1 := not_lt.1 (Finset.mem_filter.1 hℓ).2
            have h2 := not_lt.1 (Finset.mem_filter.1 hℓ').2
            simp only at h
            omega
        _ ≤ _ := ENNReal.sum_le_tsum _
  -- assembly
  rw [hsum]
  have hLsplit : ∑ j ∈ L, latMult (liftSym n d Ω p s aq.1 aq.2 (radialOscPhi Ω d j μ)) f x =
      (latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω c)) f x -
        latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω a)) f x) +
      ∑ j ∈ L, latMult (liftSym n d Ω p s aq.1 aq.2 (𝓕 (fun z =>
        eC (μ * radialPoly n d z) * dyadicKernel Ω j z - dyadicKernel Ω j z))) f x := by
    rw [Finset.sum_congr rfl fun j _ => hLdec j, Finset.sum_add_distrib, hlow1]
  rw [hLsplit]
  have hsub : ‖latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω c)) f x -
      latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω a)) f x‖ₑ ≤ T + T :=
    (enorm_sub_le).trans (add_le_add (hTle c (by have := hab.1; omega)) (hTle a hab.1))
  calc _ ≤ ‖latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω c)) f x -
        latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω a)) f x‖ₑ +
      ‖∑ j ∈ L, latMult (liftSym n d Ω p s aq.1 aq.2 (𝓕 (fun z =>
        eC (μ * radialPoly n d z) * dyadicKernel Ω j z - dyadicKernel Ω j z))) f x‖ₑ +
      ‖∑ j ∈ R, latMult (liftSym n d Ω p s aq.1 aq.2 (radialOscPhi Ω d j μ)) f x‖ₑ :=
        (enorm_add_le _ _).trans (add_le_add (enorm_add_le _ _) le_rfl)
    _ ≤ (T + T) + ENNReal.ofReal (C₁ * C₃ * envelopeConst n * 2 ^ (2 * d) *
          (2 : ℝ) ^ (-(B : ℤ))) * cubeMaximalInt n f x +
        ((∑ ℓ ∈ Finset.Ico (-(B : ℤ)) B, bandOp n d Ω p s ℓ f x) +
          ∑' k : ℕ, bandOp n d Ω p s ((B : ℤ) + k) f x) := by
        gcongr
    _ = _ := by ring

/-- **Blueprint Theorem 11.3 (`thm:liftedSW`)**, lifted polynomial partial sums, eq. (11.1)
(`eq:liftedSW`): for `n, d ≥ 1`, an admissible profile `Ω` and `1 < p < ∞` there are `c_p > 0` and
`C_p` such that for every `s ≥ 1` and every finitely supported `f`,
`‖sup_{α ∈ 𝓡_s, μ ∈ ℝ, 1 ≤ a ≤ b < ∞} |Lift_{s,α}[∑_{j=a}^b Φ_{j,μ}](D) f|‖_p`
`≤ C_p 2^{-c_p s} ‖f‖_p`,
where the maximal expression is `𝒫_s f = liftedPartialMax n d Ω p s f` (integers `a, b`, as an
extended nonnegative function). -/
theorem lift_partial_sums (hn : 1 ≤ n) (hd : 1 ≤ d) (hΩ : IsSWProfile Ω) (hp : 1 < p) :
    ∃ c : ℝ, 0 < c ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ s : ℕ, 1 ≤ s →
      ∀ f : (Fin n → ℤ) → ℂ, (Function.support f).Finite →
        eLpNorm (liftedPartialMax n d Ω p s f) (ENNReal.ofReal p) Measure.count ≤
          ENNReal.ofReal (C * (2 : ℝ) ^ (-(c * s))) *
            eLpNorm f (ENNReal.ofReal p) Measure.count := by
  obtain ⟨Ch, hCh, hH⟩ := bandOp_high hn hd hΩ hp
  obtain ⟨b, hb, Cu, hCu, hU⟩ := bandOp_uniform hn hd hΩ hp
  obtain ⟨θ, hθ, Ct, hCt, hT⟩ := lift_trunc hn hd hΩ hp
  obtain ⟨Ce, hCe, hpt⟩ := liftedPartialMax_le (p := p) hd hΩ
  obtain ⟨K, hK0, hK⟩ := exists_add_one_mul_rpow_le (δ := b) (θ := b / 2) (by linarith)
  set σ := 1 / (2 * (2 * d : ℝ)) * min (1 / p) (1 - 1 / p) with hσ
  have hσ0 : 0 < σ := by
    have h1 : 0 < 1 / p := by have : (0 : ℝ) < p := by linarith
                              positivity
    have h2 : 0 < 1 - 1 / p := by
      rw [sub_pos, div_lt_one (by linarith)]; exact hp
    have hd' : (0 : ℝ) < d := by exact_mod_cast hd
    exact mul_pos (by positivity) (lt_min h1 h2)
  set ρ := (2 : ℝ) ^ (-σ) with hρ
  have hρ0 : 0 ≤ ρ := by positivity
  have hρ1 : ρ < 1 := Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by linarith)
  have hρ1' : 0 ≤ (1 - ρ)⁻¹ := inv_nonneg.2 (by linarith)
  set N : ℕ := ⌈(n + 3 : ℝ) / σ⌉₊ + 1 with hNdef
  have hN : (n + 3 : ℝ) ≤ σ * N := by
    have h := Nat.le_ceil ((n + 3 : ℝ) / σ)
    rw [div_le_iff₀ hσ0] at h
    have : ((N : ℕ) : ℝ) = (⌈(n + 3 : ℝ) / σ⌉₊ : ℝ) + 1 := by rw [hNdef]; push_cast; ring
    rw [this]; nlinarith
  have hN1 : 1 ≤ N := by rw [hNdef]; omega
  set CM := (hlMaximalConst (5 ^ n) p).toReal with hCMdef
  have hCM : hlMaximalConst (5 ^ n) p = ENNReal.ofReal CM :=
    (ENNReal.ofReal_toReal (hlMaximalConst_ne_top _ (by linarith))).symm
  have hCM0 : 0 ≤ CM := ENNReal.toReal_nonneg
  set c := min (min θ (b / 2)) 1 with hc
  have hc0 : 0 < c := lt_min (lt_min hθ (by linarith)) one_pos
  set A1 := Ch * (1 - ρ)⁻¹ with hA1
  set A2 := 2 * (N : ℝ) * Cu * K with hA2
  set A4 := Ce * CM with hA4
  have hA1' : 0 ≤ A1 := mul_nonneg hCh hρ1'
  have hA2' : 0 ≤ A2 := by positivity
  have hA4' : 0 ≤ A4 := mul_nonneg hCe hCM0
  refine ⟨c, hc0, A1 + A2 + 2 * Ct + A4, by positivity, fun s hs f hf => ?_⟩
  set B : ℕ := N * s with hBdef
  set nf := eLpNorm f (ENNReal.ofReal p) Measure.count with hnf
  have hp1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hp.le
  have hs0 : (0 : ℝ) ≤ s := Nat.cast_nonneg s
  set Mid : (Fin n → ℤ) → ℝ≥0∞ := fun x => ∑ ℓ ∈ Finset.Ico (-(B : ℤ)) B, bandOp n d Ω p s ℓ f x
    with hMid
  set High : (Fin n → ℤ) → ℝ≥0∞ := fun x => ∑' k : ℕ, bandOp n d Ω p s ((B : ℤ) + k) f x
    with hHigh
  set Tr : (Fin n → ℤ) → ℝ≥0∞ := fun x => ⨆ J : ℕ, ⨆ (_ : 1 ≤ J), (liftRat s).sup fun aq =>
    ‖latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω J)) f x‖ₑ with hTr
  set Er : (Fin n → ℤ) → ℝ≥0∞ := fun x =>
    ENNReal.ofReal (Ce * (2 : ℝ) ^ (-(B : ℤ))) * cubeMaximalInt n f x with hEr
  have hmaj : ∀ x, ‖liftedPartialMax n d Ω p s f x‖ₑ ≤ ‖(Mid + High + (Tr + Tr) + Er) x‖ₑ := by
    intro x; rw [enorm_eq_self, enorm_eq_self]; exact hpt s B f hf x
  -- the high bands
  have hHighB : eLpNorm High (ENNReal.ofReal p) Measure.count ≤
      ENNReal.ofReal (A1 * (2 : ℝ) ^ (-(s : ℝ))) * nf := by
    refine (eLpNorm_tsum_le_count hp1 ENNReal.ofReal_ne_top _).trans ?_
    have hterm : ∀ k : ℕ, eLpNorm (bandOp n d Ω p s ((B : ℤ) + k) f) (ENNReal.ofReal p)
        Measure.count ≤
        ENNReal.ofReal (Ch * (2 : ℝ) ^ ((n + 2) * s) * (2 : ℝ) ^ (-(σ * B)) * ρ ^ k) * nf := by
      intro k
      refine (hH s hs _ (by positivity) f hf).trans (le_of_eq ?_)
      congr 2
      rw [show -(σ * ((((B : ℤ) + (k : ℤ) : ℤ)) : ℝ)) = -(σ * B) + (-σ) * k by push_cast; ring,
        Real.rpow_add two_pos, Real.rpow_mul_natCast (by norm_num)]
      ring
    refine (ENNReal.tsum_le_tsum hterm).trans ?_
    rw [ENNReal.tsum_mul_right, ← ENNReal.ofReal_tsum_of_nonneg (fun k => by positivity)
      ((summable_geometric_of_lt_one hρ0 hρ1).mul_left _), tsum_mul_left,
      tsum_geometric_of_lt_one hρ0 hρ1]
    gcongr ?_ * nf
    apply ENNReal.ofReal_le_ofReal
    have hexp : (2 : ℝ) ^ ((n + 2) * s) * (2 : ℝ) ^ (-(σ * B)) ≤ (2 : ℝ) ^ (-(s : ℝ)) := by
      rw [← Real.rpow_natCast, ← Real.rpow_add two_pos]
      apply Real.rpow_le_rpow_of_exponent_le (by norm_num)
      have h := mul_le_mul_of_nonneg_right hN hs0
      rw [hBdef]; push_cast
      nlinarith
    calc Ch * (2 : ℝ) ^ ((n + 2) * s) * (2 : ℝ) ^ (-(σ * B)) * (1 - ρ)⁻¹
        = A1 * ((2 : ℝ) ^ ((n + 2) * s) * (2 : ℝ) ^ (-(σ * B))) := by rw [hA1]; ring
      _ ≤ A1 * (2 : ℝ) ^ (-(s : ℝ)) := mul_le_mul_of_nonneg_left hexp hA1'
  -- the middle bands
  have hMidB : eLpNorm Mid (ENNReal.ofReal p) Measure.count ≤
      ENNReal.ofReal (A2 * (2 : ℝ) ^ (-(b / 2 * s))) * nf := by
    have e : Mid = ∑ ℓ ∈ Finset.Ico (-(B : ℤ)) B, bandOp n d Ω p s ℓ f := by
      funext x; rw [hMid, Finset.sum_apply]
    rw [e]
    refine (eLpNorm_sum_le hp1).trans ?_
    refine (Finset.sum_le_sum fun ℓ _ => hU s hs ℓ f hf).trans ?_
    rw [Finset.sum_const, Int.card_Ico, nsmul_eq_mul,
      show ((B : ℤ) - -(B : ℤ)).toNat = 2 * B by omega, ← mul_assoc]
    gcongr ?_ * nf
    rw [← ENNReal.ofReal_natCast, ← ENNReal.ofReal_mul (by positivity)]
    apply ENNReal.ofReal_le_ofReal
    have h := hK s
    rw [hBdef]; push_cast
    calc 2 * ((N : ℝ) * s) * (Cu * (2 : ℝ) ^ (-(b * s)))
        = 2 * N * Cu * ((s : ℝ) * (2 : ℝ) ^ (-(b * s))) := by ring
      _ ≤ 2 * N * Cu * (((s : ℝ) + 1) * (2 : ℝ) ^ (-(b * s))) := by gcongr; linarith
      _ ≤ 2 * N * Cu * (K * (2 : ℝ) ^ (-(b / 2 * s))) := by gcongr
      _ = A2 * (2 : ℝ) ^ (-(b / 2 * s)) := by rw [hA2]; ring
  -- the truncated partial sums (Lemma 10.1)
  have hTrB : eLpNorm Tr (ENNReal.ofReal p) Measure.count ≤
      ENNReal.ofReal (Ct * (2 : ℝ) ^ (-(θ * s))) * nf := hT s hs f hf
  -- the low error
  have hErB : eLpNorm Er (ENNReal.ofReal p) Measure.count ≤
      ENNReal.ofReal (A4 * (2 : ℝ) ^ (-(s : ℝ))) * nf := by
    rw [hEr, eLpNorm_count_const_mul _ _ (by linarith : (0 : ℝ) < p)]
    refine (mul_le_mul' le_rfl (eLpNorm_cubeMaximalInt_le (n := n) hp f)).trans ?_
    rw [hCM, ← mul_assoc, ← ENNReal.ofReal_mul (by positivity)]
    gcongr ?_ * nf
    apply ENNReal.ofReal_le_ofReal
    have h2 : (2 : ℝ) ^ (-(B : ℤ)) ≤ (2 : ℝ) ^ (-(s : ℝ)) := by
      rw [← Real.rpow_intCast]
      apply Real.rpow_le_rpow_of_exponent_le (by norm_num)
      have : (1 : ℝ) ≤ N := by exact_mod_cast hN1
      rw [hBdef]; push_cast
      nlinarith
    calc Ce * (2 : ℝ) ^ (-(B : ℤ)) * CM = A4 * (2 : ℝ) ^ (-(B : ℤ)) := by rw [hA4]; ring
      _ ≤ A4 * (2 : ℝ) ^ (-(s : ℝ)) := mul_le_mul_of_nonneg_left h2 hA4'
  -- assembly
  have hz1 : (2 : ℝ) ^ (-(s : ℝ)) ≤ (2 : ℝ) ^ (-(c * s)) :=
    Real.rpow_le_rpow_of_exponent_le (by norm_num)
      (neg_le_neg (by nlinarith [min_le_right (min θ (b / 2)) 1]))
  have hz2 : (2 : ℝ) ^ (-(b / 2 * s)) ≤ (2 : ℝ) ^ (-(c * s)) :=
    Real.rpow_le_rpow_of_exponent_le (by norm_num) (neg_le_neg (mul_le_mul_of_nonneg_right
      ((min_le_left _ _).trans (min_le_right _ _)) hs0))
  have hz3 : (2 : ℝ) ^ (-(θ * s)) ≤ (2 : ℝ) ^ (-(c * s)) :=
    Real.rpow_le_rpow_of_exponent_le (by norm_num) (neg_le_neg (mul_le_mul_of_nonneg_right
      ((min_le_left _ _).trans (min_le_left _ _)) hs0))
  calc eLpNorm (liftedPartialMax n d Ω p s f) (ENNReal.ofReal p) Measure.count
      ≤ eLpNorm (Mid + High + (Tr + Tr) + Er) (ENNReal.ofReal p) Measure.count :=
        eLpNorm_mono_enorm AEStronglyMeasurable.of_discrete hmaj
    _ ≤ eLpNorm Mid (ENNReal.ofReal p) Measure.count +
          eLpNorm High (ENNReal.ofReal p) Measure.count +
          (eLpNorm Tr (ENNReal.ofReal p) Measure.count +
            eLpNorm Tr (ENNReal.ofReal p) Measure.count) +
          eLpNorm Er (ENNReal.ofReal p) Measure.count :=
        (eLpNorm_add_le hp1).trans (add_le_add ((eLpNorm_add_le hp1).trans
          (add_le_add (eLpNorm_add_le hp1) (eLpNorm_add_le hp1))) le_rfl)
    _ ≤ ENNReal.ofReal (A2 * (2 : ℝ) ^ (-(b / 2 * s))) * nf +
          ENNReal.ofReal (A1 * (2 : ℝ) ^ (-(s : ℝ))) * nf +
          (ENNReal.ofReal (Ct * (2 : ℝ) ^ (-(θ * s))) * nf +
            ENNReal.ofReal (Ct * (2 : ℝ) ^ (-(θ * s))) * nf) +
          ENNReal.ofReal (A4 * (2 : ℝ) ^ (-(s : ℝ))) * nf := by
        gcongr
    _ = ENNReal.ofReal (A2 * (2 : ℝ) ^ (-(b / 2 * s)) + A1 * (2 : ℝ) ^ (-(s : ℝ)) +
          (Ct * (2 : ℝ) ^ (-(θ * s)) + Ct * (2 : ℝ) ^ (-(θ * s))) +
          A4 * (2 : ℝ) ^ (-(s : ℝ))) * nf := by
        rw [ENNReal.ofReal_add (by positivity) (by positivity),
          ENNReal.ofReal_add (by positivity) (by positivity),
          ENNReal.ofReal_add (by positivity) (by positivity),
          ENNReal.ofReal_add (by positivity) (by positivity)]
        ring
    _ ≤ ENNReal.ofReal ((A1 + A2 + 2 * Ct + A4) * (2 : ℝ) ^ (-(c * s))) * nf := by
        gcongr ?_ * nf
        apply ENNReal.ofReal_le_ofReal
        have e1 := mul_le_mul_of_nonneg_left hz1 hA1'
        have e2 := mul_le_mul_of_nonneg_left hz2 hA2'
        have e3 := mul_le_mul_of_nonneg_left hz3 hCt
        have e4 := mul_le_mul_of_nonneg_left hz1 hA4'
        nlinarith

end Bands

end Auto
