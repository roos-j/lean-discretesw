      exact squeeze_zero (fun _ => norm_nonneg _)
        (fun R => abs_swMax_sub_le (d := d) hΩ hp hf (hfR R) x) hc
    · refine (hfin _ (support_indicator_latBox_finite n R f)).trans ?_
      gcongr
      exact eLpNorm_indicator_le f (latBox_finite n R).measurableSet
  refine ⟨fun lam x => (summable_norm_swTerm hΩ hp hf lam x).of_norm.subtype _,
    fun x => ((absolute_convergence_and_parameter_continuity (d := d) hΩ hp).2.1 f hf x).2.2.2.2.1,
