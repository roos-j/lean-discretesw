-/

open Finset

variable {n : ℕ}

/-! ### Block products -/

/-- `Q_A = ∏_{q ∈ A} q` (with `Q_∅ = 1`) of Blueprint Definition 7.1 (`def:blocks`). -/
def blockProd (A : Finset ℕ) : ℕ := ∏ q ∈ A, q

/-- `q_* = max(2, max S)` of Blueprint Definition 7.1 (`def:blocks`). -/
def blockStar (S : Finset ℕ) : ℕ := max 2 (S.sup id)

lemma blockProd_pos {A : Finset ℕ} (hA : ∀ q ∈ A, 1 < q) : 0 < blockProd A :=
  Finset.prod_pos fun q hq => lt_trans Nat.zero_lt_one (hA q hq)

/-- The instance needed to form finite sets of points of `T[Q_S]`. -/
lemma neZero_blockProd {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q) : NeZero (blockProd S) :=
  ⟨(blockProd_pos hS1).ne'⟩

lemma dvd_blockProd {A : Finset ℕ} {q : ℕ} (hq : q ∈ A) : q ∣ blockProd A :=
  Finset.dvd_prod_of_mem _ hq

lemma blockProd_dvd_blockProd {A B : Finset ℕ} (h : A ⊆ B) : blockProd A ∣ blockProd B :=
  Finset.prod_dvd_prod_of_subset _ _ _ h

lemma two_le_blockStar (S : Finset ℕ) : 2 ≤ blockStar S := le_max_left _ _

lemma le_blockStar {S : Finset ℕ} {q : ℕ} (hq : q ∈ S) : q ≤ blockStar S :=
  le_trans (Finset.le_sup (f := id) hq) (le_max_right _ _)

lemma blockProd_le_pow {S A : Finset ℕ} (hA : A ⊆ S) : blockProd A ≤ blockStar S ^ A.card :=
  Finset.prod_le_pow_card _ _ _ fun _ hq => le_blockStar (hA hq)

lemma coprime_blockProd {S A : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime) {q : ℕ}
    (hq : q ∈ S) (hA : A ⊆ S) (hqA : q ∉ A) : Nat.Coprime q (blockProd A) :=
  Nat.Coprime.prod_right fun _ hp => hS hq (hA hp) (fun h => hqA (h ▸ hp))

lemma blockProd_dvd_of_forall_dvd {S A : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    (hA : A ⊆ S) {m : ℕ} (h : ∀ q ∈ A, q ∣ m) : blockProd A ∣ m := by
  induction A using Finset.induction_on with
  | empty => simp [blockProd]
  | insert a A haA ih =>
    rw [blockProd, Finset.prod_insert haA]
    have hA' : A ⊆ S := fun x hx => hA (Finset.mem_insert_of_mem hx)
    exact Nat.Coprime.mul_dvd_of_dvd_of_dvd
      (coprime_blockProd hS (hA (Finset.mem_insert_self a A)) hA' haA)
      (h a (Finset.mem_insert_self a A))
      (ih hA' fun q hq => h q (Finset.mem_insert_of_mem hq))

lemma blockProd_erase_mul {A : Finset ℕ} {q : ℕ} (hq : q ∈ A) :
    q * blockProd (A.erase q) = blockProd A := Finset.mul_prod_erase A id hq

/-! ### Reduction modulo a block -/

/-- Reduction of `x ∈ T[Q]` modulo `q` (coordinatewise `ZMod.cast`), used to read off block
components. -/
def blockRed (q : ℕ) {Q : ℕ} (x : Fin n → ZMod Q) : Fin n → ZMod q := fun i => (x i).cast

/-- Reduction modulo `q ∣ Q` as an additive homomorphism. -/
def blockRedHom {q Q : ℕ} (h : q ∣ Q) : (Fin n → ZMod Q) →+ (Fin n → ZMod q) :=
  (ZMod.castHom h (ZMod q)).toAddMonoidHom.compLeft (Fin n)

lemma blockRedHom_apply {q Q : ℕ} (h : q ∣ Q) (x : Fin n → ZMod Q) :
    blockRedHom h x = blockRed q x := rfl

lemma cast_eq_zero_iff_dvd_val {q Q : ℕ} [NeZero Q] (y : ZMod Q) :
    ((y.cast : ZMod q) = 0) ↔ q ∣ y.val := by
  rw [← ZMod.natCast_val, ZMod.natCast_eq_zero_iff]

lemma eq_zero_of_forall_cast_eq_zero {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] (y : ZMod (blockProd S)) (h : ∀ q ∈ S, (y.cast : ZMod q) = 0) :
    y = 0 := by
  have hd : blockProd S ∣ y.val := blockProd_dvd_of_forall_dvd hS subset_rfl fun q hq =>
    (cast_eq_zero_iff_dvd_val y).1 (h q hq)
  rw [← ZMod.val_eq_zero]
  exact Nat.eq_zero_of_dvd_of_lt hd (ZMod.val_lt y)

/-- A point of `T[Q_S]` all of whose reductions modulo the blocks vanish is zero. -/
lemma eq_zero_of_forall_blockRed {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] (x : Fin n → ZMod (blockProd S))
    (h : ∀ q ∈ S, blockRed q x = 0) : x = 0 := by
  funext i
  exact eq_zero_of_forall_cast_eq_zero hS (x i) fun q hq => congrFun (h q hq) i

/-- Points of `T[Q_S]` are determined by their reductions modulo the blocks. -/
lemma ext_blockRed {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {x y : Fin n → ZMod (blockProd S)}
    (h : ∀ q ∈ S, blockRed q x = blockRed q y) : x = y := by
  rw [← sub_eq_zero]
  refine eq_zero_of_forall_blockRed hS _ fun q hq => ?_
  rw [← blockRedHom_apply (dvd_blockProd hq), map_sub, blockRedHom_apply, blockRedHom_apply,
    h q hq, sub_self]


lemma blockRed_add {q Q : ℕ} (h : q ∣ Q) (x y : Fin n → ZMod Q) :
    blockRed q (x + y) = blockRed q x + blockRed q y := map_add (blockRedHom h) x y

lemma blockRed_neg {q Q : ℕ} (h : q ∣ Q) (x : Fin n → ZMod Q) :
    blockRed q (-x) = -blockRed q x := map_neg (blockRedHom h) x

lemma blockRed_sub {q Q : ℕ} (h : q ∣ Q) (x y : Fin n → ZMod Q) :
    blockRed q (x - y) = blockRed q x - blockRed q y := map_sub (blockRedHom h) x y

lemma blockRed_zero {q Q : ℕ} (h : q ∣ Q) : blockRed q (0 : Fin n → ZMod Q) = 0 :=
  map_zero (blockRedHom h)

lemma blockRed_nsmul {q Q : ℕ} (h : q ∣ Q) (d : ℕ) (x : Fin n → ZMod Q) :
    blockRed q (d • x) = d • blockRed q x := map_nsmul (blockRedHom h) d x

lemma blockRed_zsmul {q Q : ℕ} (h : q ∣ Q) (d : ℤ) (x : Fin n → ZMod Q) :
    blockRed q (d • x) = d • blockRed q x := map_zsmul (blockRedHom h) d x

lemma blockRed_sum {q Q : ℕ} (h : q ∣ Q) {ι : Type*} (s : Finset ι) (f : ι → Fin n → ZMod Q) :
    blockRed q (∑ j ∈ s, f j) = ∑ j ∈ s, blockRed q (f j) := map_sum (blockRedHom h) f s

/-- Multiplication by an integer coprime to `p` is injective on `(ZMod p)ⁿ`. -/
lemma eq_zero_of_nsmul_eq_zero_of_coprime {p c : ℕ} (hc : Nat.Coprime c p)
    {v : Fin n → ZMod p} (h : c • v = 0) : v = 0 := by
  funext i
  have hi := congrFun h i
  simp only [Pi.smul_apply, nsmul_eq_mul, Pi.zero_apply] at hi
  rw [← ZMod.coe_unitOfCoprime c hc] at hi
  exact (Units.mul_right_eq_zero _).1 hi

/-! ### The CRT idempotents and block projections -/

/-- The CRT idempotent `e_q ∈ ZMod Q_S`: `e_q ≡ 1 mod q` and `e_q ≡ 0 mod p` for `p ∈ S`,
`p ≠ q` (`cast_blockIdem`). -/
def blockIdem (S : Finset ℕ) (q : ℕ) : ZMod (blockProd S) :=
  (((blockProd (S.erase q) : ℕ) : ℤ) * Nat.gcdA (blockProd (S.erase q)) q : ℤ)

lemma cast_blockIdem {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime) {p q : ℕ}
    (hp : p ∈ S) (hq : q ∈ S) :
    ((blockIdem S q).cast : ZMod p) = if p = q then 1 else 0 := by
  unfold blockIdem
  rw [ZMod.cast_intCast (dvd_blockProd hp)]
  push_cast
  split_ifs with hpq
  · subst hpq
    have hcop : Nat.Coprime (blockProd (S.erase p)) p :=
      (coprime_blockProd hS hp (Finset.erase_subset p S) (Finset.notMem_erase p S)).symm
    have h := Nat.gcd_eq_gcd_ab (blockProd (S.erase p)) p
    rw [Nat.Coprime.gcd_eq_one hcop] at h
    have h' := congrArg (Int.cast : ℤ → ZMod p) h
    push_cast at h'
    rw [ZMod.natCast_self, zero_mul, add_zero] at h'
    exact h'.symm
  · have : ((blockProd (S.erase q) : ℕ) : ZMod p) = 0 :=
      (ZMod.natCast_eq_zero_iff _ _).2 (dvd_blockProd (Finset.mem_erase.2 ⟨hpq, hp⟩))
    rw [this, zero_mul]

/-- `e_A = ∑_{q ∈ S ∩ A} e_q`. -/
def blockIdemSet (S A : Finset ℕ) : ZMod (blockProd S) := ∑ q ∈ S.filter (· ∈ A), blockIdem S q

lemma cast_blockIdemSet {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime) (A : Finset ℕ)
    {p : ℕ} (hp : p ∈ S) :
    ((blockIdemSet S A).cast : ZMod p) = if p ∈ A then 1 else 0 := by
  unfold blockIdemSet
  rw [← ZMod.castHom_apply (h := dvd_blockProd hp) (R := ZMod p), map_sum]
  simp_rw [ZMod.castHom_apply]
  rw [Finset.sum_congr rfl fun q hq => cast_blockIdem hS hp (Finset.mem_filter.1 hq).1,
    Finset.sum_ite_eq]
  simp [hp]

/-- The `A`-part `e_A · x` of a point `x ∈ T[Q_S]`: its reduction modulo `p ∈ S` is that of `x`
for `p ∈ A` and zero otherwise (`blockRed_blockProj`). The `q`-th block component of
Blueprint Definition 7.1 (`def:blocks`) is `blockProj S {q} x`. -/
def blockProj (S A : Finset ℕ) (x : Fin n → ZMod (blockProd S)) : Fin n → ZMod (blockProd S) :=
  blockIdemSet S A • x

lemma blockProj_add (S A : Finset ℕ) (x y : Fin n → ZMod (blockProd S)) :
    blockProj S A (x + y) = blockProj S A x + blockProj S A y := smul_add _ _ _

lemma blockRed_blockProj {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime) (A : Finset ℕ)
    {p : ℕ} (hp : p ∈ S) (x : Fin n → ZMod (blockProd S)) :
    blockRed p (blockProj S A x) = if p ∈ A then blockRed p x else 0 := by
  funext i
  simp only [blockRed, blockProj, Pi.smul_apply, smul_eq_mul]
  rw [ZMod.cast_mul (dvd_blockProd hp), cast_blockIdemSet hS A hp]
  split_ifs <;> simp [blockRed]

/-! ### Block supports -/

/-- The block support `{q ∈ S | x ≢ 0 mod q}` of `x ∈ T[Q_S]`: the set of blocks whose
component is nonzero (`mem_blockSupp_iff`). -/
def blockSupp (S : Finset ℕ) (x : Fin n → ZMod (blockProd S)) : Finset ℕ :=
  S.filter fun q => blockRed q x ≠ 0

lemma mem_blockSupp {S : Finset ℕ} {x : Fin n → ZMod (blockProd S)} {q : ℕ} :
    q ∈ blockSupp S x ↔ q ∈ S ∧ blockRed q x ≠ 0 := Finset.mem_filter

lemma blockSupp_subset (S : Finset ℕ) (x : Fin n → ZMod (blockProd S)) : blockSupp S x ⊆ S :=
  Finset.filter_subset _ _

lemma blockRed_eq_zero_of_not_mem {S : Finset ℕ} {x : Fin n → ZMod (blockProd S)} {q : ℕ}
    (hq : q ∈ S) (h : q ∉ blockSupp S x) : blockRed q x = 0 := by
  by_contra h'
  exact h (mem_blockSupp.2 ⟨hq, h'⟩)

lemma blockSupp_blockProj {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime) (A : Finset ℕ)
    (x : Fin n → ZMod (blockProd S)) : blockSupp S (blockProj S A x) = blockSupp S x ∩ A := by
  ext p
  simp only [mem_blockSupp, Finset.mem_inter]
  constructor
  · rintro ⟨hp, h⟩
    rw [blockRed_blockProj hS A hp] at h
    split_ifs at h with hpA
    · exact ⟨⟨hp, h⟩, hpA⟩
    · exact absurd rfl h
  · rintro ⟨⟨hp, h⟩, hpA⟩
    refine ⟨hp, ?_⟩
    rw [blockRed_blockProj hS A hp, ite_eq_left hpA]
    exact h

lemma blockProj_eq_self {S A : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {x : Fin n → ZMod (blockProd S)} (h : blockSupp S x ⊆ A) :
    blockProj S A x = x := by
  refine ext_blockRed hS fun p hp => ?_
  rw [blockRed_blockProj hS A hp]
  split_ifs with hpA
  · rfl
  · exact (blockRed_eq_zero_of_not_mem hp fun h' => hpA (h h')).symm

lemma blockProj_eq_zero {S A : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {x : Fin n → ZMod (blockProd S)} (h : Disjoint (blockSupp S x) A) :
    blockProj S A x = 0 := by
  refine eq_zero_of_forall_blockRed hS _ fun p hp => ?_
  rw [blockRed_blockProj hS A hp]
  split_ifs with hpA
  · exact blockRed_eq_zero_of_not_mem hp fun h' => Finset.disjoint_left.1 h h' hpA
  · rfl

/-- If `A, B` are disjoint and cover the support of `x`, then `x = e_A x + e_B x`. -/
lemma blockProj_add_blockProj {S A B : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] (hAB : Disjoint A B) {x : Fin n → ZMod (blockProd S)}
    (h : blockSupp S x ⊆ A ∪ B) : blockProj S A x + blockProj S B x = x := by
  refine ext_blockRed hS fun p hp => ?_
  rw [blockRed_add (dvd_blockProd hp), blockRed_blockProj hS A hp, blockRed_blockProj hS B hp]
  by_cases hpA : p ∈ A
  · rw [ite_eq_left hpA, ite_eq_right (Finset.disjoint_left.1 hAB hpA), add_zero]
  · by_cases hpB : p ∈ B
    · rw [ite_eq_right hpA, ite_eq_left hpB, zero_add]
    · rw [ite_eq_right hpA, ite_eq_right hpB, add_zero]
      refine (blockRed_eq_zero_of_not_mem hp fun h' => ?_).symm
      rcases Finset.mem_union.1 (h h') with h'' | h''
      exacts [hpA h'', hpB h'']

lemma blockProj_add_blockProj_sdiff {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] (A : Finset ℕ) (x : Fin n → ZMod (blockProd S)) :
    blockProj S A x + blockProj S (S \ A) x = x := by
  refine blockProj_add_blockProj hS Finset.disjoint_sdiff fun q hq => ?_
  by_cases hqA : q ∈ A
  · exact Finset.mem_union_left _ hqA
  · exact Finset.mem_union_right _ (Finset.mem_sdiff.2 ⟨blockSupp_subset S x hq, hqA⟩)

lemma blockSupp_eq_empty_iff {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {x : Fin n → ZMod (blockProd S)} : blockSupp S x = ∅ ↔ x = 0 := by
  constructor
  · intro h
    exact eq_zero_of_forall_blockRed hS x fun q hq =>
      blockRed_eq_zero_of_not_mem hq (by simp [h])
  · rintro rfl
    exact Finset.filter_false_of_mem fun q hq h => h (blockRed_zero (dvd_blockProd hq))

lemma blockSupp_zero (S : Finset ℕ) : blockSupp S (0 : Fin n → ZMod (blockProd S)) = ∅ :=
  Finset.filter_false_of_mem fun _ hq h => h (blockRed_zero (dvd_blockProd hq))

lemma blockSupp_neg (S : Finset ℕ) (x : Fin n → ZMod (blockProd S)) :
    blockSupp S (-x) = blockSupp S x := by
  ext q
  simp only [mem_blockSupp]
  constructor
  · rintro ⟨hq, h⟩
    rw [blockRed_neg (dvd_blockProd hq), neg_ne_zero] at h
    exact ⟨hq, h⟩
  · rintro ⟨hq, h⟩
    rw [blockRed_neg (dvd_blockProd hq), neg_ne_zero]
    exact ⟨hq, h⟩

lemma blockSupp_add_subset (S : Finset ℕ) (x y : Fin n → ZMod (blockProd S)) :
    blockSupp S (x + y) ⊆ blockSupp S x ∪ blockSupp S y := by
  intro q hq
  obtain ⟨hqS, h⟩ := mem_blockSupp.1 hq
  rw [blockRed_add (dvd_blockProd hqS)] at h
  by_contra h'
  simp only [Finset.mem_union, not_or] at h'
  rw [blockRed_eq_zero_of_not_mem hqS h'.1, blockRed_eq_zero_of_not_mem hqS h'.2, add_zero] at h
  exact h rfl

/-- Direct block decomposition: supports of sums with disjoint supports are unions. -/
lemma blockSupp_add_of_disjoint (S : Finset ℕ) {x y : Fin n → ZMod (blockProd S)}
    (h : Disjoint (blockSupp S x) (blockSupp S y)) :
    blockSupp S (x + y) = blockSupp S x ∪ blockSupp S y := by
  refine Finset.Subset.antisymm (blockSupp_add_subset S x y) fun q hq => ?_
  rcases Finset.mem_union.1 hq with hx | hy
  · obtain ⟨hqS, h'⟩ := mem_blockSupp.1 hx
    refine mem_blockSupp.2 ⟨hqS, ?_⟩
    rw [blockRed_add (dvd_blockProd hqS),
      blockRed_eq_zero_of_not_mem hqS (Finset.disjoint_left.1 h hx), add_zero]
    exact h'
  · obtain ⟨hqS, h'⟩ := mem_blockSupp.1 hy
    refine mem_blockSupp.2 ⟨hqS, ?_⟩
    rw [blockRed_add (dvd_blockProd hqS),
      blockRed_eq_zero_of_not_mem hqS (Finset.disjoint_right.1 h hy), zero_add]
    exact h'

/-- The block component `blockProj S {q} x` vanishes iff `x ≡ 0 mod q`. -/
lemma blockProj_singleton_eq_zero_iff {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {q : ℕ} (hq : q ∈ S) (x : Fin n → ZMod (blockProd S)) :
    blockProj S {q} x = 0 ↔ blockRed q x = 0 := by
  constructor
  · intro h
    have := blockRed_blockProj hS {q} hq x
    rwa [h, blockRed_zero (dvd_blockProd hq), ite_eq_left (Finset.mem_singleton_self q), eq_comm]
      at this
  · intro h
    refine blockProj_eq_zero hS (Finset.disjoint_singleton_right.2 fun h' => ?_)
    exact (mem_blockSupp.1 h').2 h

/-- The block support is the set of blocks `q ∈ S` whose component `blockProj S {q} x` is
nonzero (the reading of Blueprint Definition 7.1 (`def:blocks`)). -/
lemma mem_blockSupp_iff {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {x : Fin n → ZMod (blockProd S)} {q : ℕ} :
    q ∈ blockSupp S x ↔ q ∈ S ∧ blockProj S {q} x ≠ 0 := by
  rw [mem_blockSupp]
  constructor
  · rintro ⟨hq, h⟩
    exact ⟨hq, fun h' => h ((blockProj_singleton_eq_zero_iff hS hq x).1 h')⟩
  · rintro ⟨hq, h⟩
    exact ⟨hq, fun h' => h ((blockProj_singleton_eq_zero_iff hS hq x).2 h')⟩


/-! ### The subgroups `T[d] ⊆ T[Q]` -/

/-- `T[d] = (d⁻¹ℤ/ℤ)ⁿ` inside `T[Q]` (for `d ∣ Q`): the points killed by `d`. -/
def blockGrid (Q d : ℕ) [NeZero Q] : Finset (Fin n → ZMod Q) :=
  Finset.univ.filter fun x => d • x = 0

lemma mem_blockGrid {Q d : ℕ} [NeZero Q] {x : Fin n → ZMod Q} :
    x ∈ blockGrid Q d ↔ d • x = 0 := by simp [blockGrid]

/-- For `A ⊆ S`: `x ∈ T[Q_A]` iff the block support of `x` is contained in `A`. -/
lemma nsmul_blockProd_eq_zero_iff {S A : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] (hA : A ⊆ S) {x : Fin n → ZMod (blockProd S)} :
    blockProd A • x = 0 ↔ blockSupp S x ⊆ A := by
  constructor
  · intro h p hp
    obtain ⟨hpS, hne⟩ := mem_blockSupp.1 hp
    by_contra hpA
    have h' := congrArg (blockRed p) h
    rw [blockRed_nsmul (dvd_blockProd hpS), blockRed_zero (dvd_blockProd hpS)] at h'
    exact hne (eq_zero_of_nsmul_eq_zero_of_coprime (coprime_blockProd hS hpS hA hpA).symm h')
  · intro h
    refine eq_zero_of_forall_blockRed hS _ fun p hp => ?_
    rw [blockRed_nsmul (dvd_blockProd hp)]
    by_cases hpA : p ∈ A
    · funext i
      simp only [Pi.smul_apply, nsmul_eq_mul, Pi.zero_apply]
      rw [(ZMod.natCast_eq_zero_iff _ _).2 (dvd_blockProd hpA), zero_mul]
    · rw [blockRed_eq_zero_of_not_mem hp fun h' => hpA (h h'), smul_zero]

lemma mem_blockGrid_blockProd_iff {S A : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] (hA : A ⊆ S) {x : Fin n → ZMod (blockProd S)} :
    x ∈ blockGrid (blockProd S) (blockProd A) ↔ blockSupp S x ⊆ A := by
  rw [mem_blockGrid, nsmul_blockProd_eq_zero_iff hS hA]

lemma blockGrid_blockProd_eq_filter {S A : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] (hA : A ⊆ S) :
    blockGrid (blockProd S) (blockProd A) =
      Finset.univ.filter fun x : Fin n → ZMod (blockProd S) => blockSupp S x ⊆ A := by
  ext x
  rw [mem_blockGrid_blockProd_iff hS hA]
  simp

lemma mem_blockGrid_singleton_iff {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {q : ℕ} (hq : q ∈ S) {x : Fin n → ZMod (blockProd S)} :
    x ∈ blockGrid (blockProd S) q ↔ blockSupp S x ⊆ {q} := by
  have := mem_blockGrid_blockProd_iff (x := x) hS (Finset.singleton_subset_iff.2 hq)
  simpa only [blockProd, Finset.prod_singleton] using this

/-- The `q`-th block component of `x` lies in `T[q]`. -/
lemma blockProj_singleton_mem_blockGrid {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {q : ℕ} (hq : q ∈ S) (x : Fin n → ZMod (blockProd S)) :
    blockProj S {q} x ∈ blockGrid (blockProd S) q := by
  rw [mem_blockGrid_singleton_iff hS hq, blockSupp_blockProj hS]
  exact Finset.inter_subset_right

lemma nsmul_eq_zero_of_dvd {Q d d' : ℕ} (h : d ∣ d') {x : Fin n → ZMod Q} (hx : d • x = 0) :
    d' • x = 0 := by
  obtain ⟨m, rfl⟩ := h
  rw [mul_comm, mul_smul, hx, smul_zero]

/-! ### Blueprint Definition 7.1 (`def:blocks`): the block-sum bijection -/

/-- Sums of block components with `a_q ∈ T[q]` (`q ∈ A`) lie in `T[Q_A]`. -/
lemma sum_mem_blockGrid_blockProd {S A : Finset ℕ} [NeZero (blockProd S)]
    (a : A → Fin n → ZMod (blockProd S)) (ha : ∀ q : A, a q ∈ blockGrid (blockProd S) q.1) :
    ∑ q, a q ∈ blockGrid (blockProd S) (blockProd A) := by
  rw [mem_blockGrid, Finset.smul_sum]
  refine Finset.sum_eq_zero fun q _ => ?_
  exact nsmul_eq_zero_of_dvd (dvd_blockProd q.2) (mem_blockGrid.1 (ha q))

/-- The map `∏_{q ∈ A} T[q] → T[Q_A]` that adds its coordinates. -/
def blockSumMap (S A : Finset ℕ) [NeZero (blockProd S)]
    (a : (q : A) → blockGrid (n := n) (blockProd S) (q : ℕ)) :
    blockGrid (n := n) (blockProd S) (blockProd A) :=
  ⟨∑ q, (a q : Fin n → ZMod (blockProd S)),
    sum_mem_blockGrid_blockProd (fun q => (a q : Fin n → ZMod (blockProd S))) fun q => (a q).2⟩

/-- The `p`-th block component of a sum of block components `a_q ∈ T[q]` is `a_p`. -/
lemma blockProj_sum_blockGrid {S A : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] (hA : A ⊆ S) (a : A → Fin n → ZMod (blockProd S))
    (ha : ∀ q : A, a q ∈ blockGrid (blockProd S) q.1) (p : A) :
    blockProj S {(p : ℕ)} (∑ q, a q) = a p := by
  rw [blockProj, Finset.smul_sum, Finset.sum_eq_single p]
  · exact blockProj_eq_self hS ((mem_blockGrid_singleton_iff hS (hA p.2)).1 (ha p))
  · intro q _ hqp
    refine blockProj_eq_zero hS (Finset.disjoint_singleton_right.2 fun h => hqp ?_)
    have := (mem_blockGrid_singleton_iff hS (hA q.2)).1 (ha q) h
    exact Subtype.ext (Finset.mem_singleton.1 this).symm
  · intro h; exact absurd (Finset.mem_univ p) h

/-- Every point is the sum of its block components over `A ⊇ supp x`. -/
lemma sum_blockProj_singleton {S A : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {x : Fin n → ZMod (blockProd S)} (hx : blockSupp S x ⊆ A) :
    ∑ q ∈ A, blockProj S {q} x = x := by
  refine ext_blockRed hS fun p hp => ?_
  rw [blockRed_sum (dvd_blockProd hp)]
  simp_rw [blockRed_blockProj hS _ hp, Finset.mem_singleton]
  rw [Finset.sum_ite_eq]
  split_ifs with hpA
  · rfl
  · exact (blockRed_eq_zero_of_not_mem hp fun h => hpA (hx h)).symm

/-- Blueprint Definition 7.1 (`def:blocks`), first claim: for a finite set `S` of pairwise
coprime integers `> 1` and `A ⊆ S`, the map `∏_{q ∈ A} T[q] → T[Q_A]` that adds its coordinates
is a bijection (here `T[d] = (d⁻¹ℤ/ℤ)ⁿ` is realized inside `T[Q_S]` as `blockGrid (Q_S) d`). -/
theorem blockSum_bijective {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {A : Finset ℕ} (hA : A ⊆ S) :
    Function.Bijective (blockSumMap (n := n) S A) := by
  constructor
  · intro a b hab
    have hab' := congrArg Subtype.val hab
    simp only [blockSumMap] at hab'
    funext p
    apply Subtype.ext
    rw [← blockProj_sum_blockGrid hS hA (fun q => (a q : Fin n → ZMod (blockProd S)))
      (fun q => (a q).2) p, hab',
      blockProj_sum_blockGrid hS hA (fun q => (b q : Fin n → ZMod (blockProd S)))
      (fun q => (b q).2) p]
  · rintro ⟨x, hx⟩
    rw [mem_blockGrid_blockProd_iff hS hA] at hx
    refine ⟨fun q => ⟨blockProj S {(q : ℕ)} x, blockProj_singleton_mem_blockGrid hS (hA q.2) x⟩,
      Subtype.ext ?_⟩
    simp only [blockSumMap]
    rw [Finset.sum_coe_sort A (fun q => blockProj S {q} x)]
    exact sum_blockProj_singleton hS hx

/-- Blueprint Definition 7.1 (`def:blocks`), unique decomposition: every point `x` of `T[Q_A]`
(`A ⊆ S`) is uniquely a sum `∑_{q ∈ A} a_q` with `a_q ∈ T[q]`, namely `a_q = blockProj S {q} x`. -/
theorem existsUnique_blockDecomp {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {A : Finset ℕ} (hA : A ⊆ S) {x : Fin n → ZMod (blockProd S)}
    (hx : x ∈ blockGrid (blockProd S) (blockProd A)) :
    ∃! a : A → Fin n → ZMod (blockProd S),
      (∀ q : A, a q ∈ blockGrid (blockProd S) q.1) ∧ ∑ q, a q = x := by
  rw [mem_blockGrid_blockProd_iff hS hA] at hx
  refine ⟨fun q => blockProj S {(q : ℕ)} x,
    ⟨fun q => blockProj_singleton_mem_blockGrid hS (hA q.2) x, ?_⟩, ?_⟩
  · rw [Finset.sum_coe_sort A (fun q => blockProj S {q} x)]
    exact sum_blockProj_singleton hS hx
  · rintro a ⟨ha, rfl⟩
    funext p
    exact (blockProj_sum_blockGrid hS hA a ha p).symm

/-! ### The sets `Σ_A`, `Σ_{≤k}`, `Σ^{A₀}` -/

/-- `Σ_A`: the points of `T[Q_S]` whose `q`-th block component is nonzero exactly for `q ∈ A`
(Blueprint Definition 7.1 (`def:blocks`)). -/
def sigmaBlock (S : Finset ℕ) [NeZero (blockProd S)] (A : Finset ℕ) :
    Finset (Fin n → ZMod (blockProd S)) :=
  Finset.univ.filter fun x => blockSupp S x = A

/-- `Σ_{≤k} = ⋃_{|A| ≤ k} Σ_A` (Blueprint Definition 7.1 (`def:blocks`)). -/
def sigmaLe (S : Finset ℕ) [NeZero (blockProd S)] (k : ℕ) :
    Finset (Fin n → ZMod (blockProd S)) :=
  Finset.univ.filter fun x => (blockSupp S x).card ≤ k

/-- `Σ^{A₀} = ⋃_{B ⊆ S \ A₀, |B| ≤ k - |A₀|} Σ_B` (Blueprint Definition 7.1 (`def:blocks`)). -/
def sigmaUpper (S : Finset ℕ) [NeZero (blockProd S)] (k : ℕ) (A₀ : Finset ℕ) :
    Finset (Fin n → ZMod (blockProd S)) :=
  Finset.univ.filter fun x => Disjoint (blockSupp S x) A₀ ∧ (blockSupp S x).card + A₀.card ≤ k

lemma mem_sigmaBlock {S A : Finset ℕ} [NeZero (blockProd S)] {x : Fin n → ZMod (blockProd S)} :
    x ∈ sigmaBlock S A ↔ blockSupp S x = A := by simp [sigmaBlock]

lemma mem_sigmaLe {S : Finset ℕ} [NeZero (blockProd S)] {k : ℕ}
    {x : Fin n → ZMod (blockProd S)} : x ∈ sigmaLe S k ↔ (blockSupp S x).card ≤ k := by
  simp [sigmaLe]

lemma mem_sigmaUpper {S : Finset ℕ} [NeZero (blockProd S)] {k : ℕ} {A₀ : Finset ℕ}
    {x : Fin n → ZMod (blockProd S)} :
    x ∈ sigmaUpper S k A₀ ↔ Disjoint (blockSupp S x) A₀ ∧ (blockSupp S x).card + A₀.card ≤ k := by
  simp [sigmaUpper]

/-- Membership in `Σ_A` in the blueprint's words: the `q`-th component is nonzero for every
`q ∈ A` and zero for `q ∈ S \ A` (and `A ⊆ S`). -/
lemma mem_sigmaBlock_iff {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {A : Finset ℕ} {x : Fin n → ZMod (blockProd S)} :
    x ∈ sigmaBlock S A ↔ A ⊆ S ∧ (∀ q ∈ A, blockProj S {q} x ≠ 0) ∧
      (∀ q ∈ S, q ∉ A → blockProj S {q} x = 0) := by
  rw [mem_sigmaBlock]
  constructor
  · rintro rfl
    refine ⟨blockSupp_subset S x, fun q hq => ((mem_blockSupp_iff hS).1 hq).2,
      fun q hq hqA => ?_⟩
    by_contra h
    exact hqA ((mem_blockSupp_iff hS).2 ⟨hq, h⟩)
  · rintro ⟨hAS, h1, h2⟩
    ext q
    rw [mem_blockSupp_iff hS]
    constructor
    · rintro ⟨hq, h⟩
      by_contra hqA
      exact h (h2 q hq hqA)
    · intro hq
      exact ⟨hAS hq, h1 q hq⟩

lemma sigmaBlock_subset_blockGrid {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {A : Finset ℕ} (hA : A ⊆ S) :
    sigmaBlock (n := n) S A ⊆ blockGrid (blockProd S) (blockProd A) := by
  intro x hx
  rw [mem_blockGrid_blockProd_iff hS hA, (mem_sigmaBlock.1 hx)]

lemma sigmaBlock_eq_empty {S : Finset ℕ} [NeZero (blockProd S)] {A : Finset ℕ} (hA : ¬ A ⊆ S) :
    sigmaBlock (n := n) S A = ∅ :=
  Finset.filter_false_of_mem fun x _ h => hA (h ▸ blockSupp_subset S x)

lemma sigmaUpper_subset_sigmaLe (S : Finset ℕ) [NeZero (blockProd S)] (k : ℕ)
    (A₀ : Finset ℕ) : sigmaUpper (n := n) S k A₀ ⊆ sigmaLe S k := by
  intro x hx
  rw [mem_sigmaUpper] at hx
  rw [mem_sigmaLe]
  omega

lemma sigmaBlock_subset_sigmaLe (S : Finset ℕ) [NeZero (blockProd S)] {k : ℕ} {A : Finset ℕ}
    (hA : A.card ≤ k) : sigmaBlock (n := n) S A ⊆ sigmaLe S k := by
  intro x hx
  rw [mem_sigmaLe, mem_sigmaBlock.1 hx]
  exact hA

/-- The sets `Σ_A` are pairwise disjoint (each point has a unique block support). -/
lemma pairwiseDisjoint_sigmaBlock (S : Finset ℕ) [NeZero (blockProd S)] :
    (Set.univ : Set (Finset ℕ)).PairwiseDisjoint (sigmaBlock (n := n) S) := by
  intro A _ B _ hAB
  refine Finset.disjoint_left.2 fun x hA hB => hAB ?_
  rw [← mem_sigmaBlock.1 hA, ← mem_sigmaBlock.1 hB]

/-- Blueprint Definition 7.1 (`def:blocks`), second claim, for `Σ_{≤k}`:
`Σ_{≤k} = ⋃_{A ⊆ S, |A| ≤ k} Σ_A`, and the union is disjoint (`pairwiseDisjoint_sigmaBlock`). -/
theorem sigmaLe_eq_biUnion (S : Finset ℕ) [NeZero (blockProd S)] (k : ℕ) :
    sigmaLe (n := n) S k = (S.powerset.filter fun A => A.card ≤ k).biUnion (sigmaBlock S) := by
  ext x
  simp only [mem_sigmaLe, Finset.mem_biUnion, Finset.mem_filter, Finset.mem_powerset,
    mem_sigmaBlock]
  constructor
  · intro h
    exact ⟨blockSupp S x, ⟨blockSupp_subset S x, h⟩, rfl⟩
  · rintro ⟨A, ⟨_, hA⟩, rfl⟩
    exact hA

/-- Blueprint Definition 7.1 (`def:blocks`), second claim, for `Σ^{A₀}` (with `|A₀| ≤ k`):
`Σ^{A₀} = ⋃_{B ⊆ S \ A₀, |B| ≤ k - |A₀|} Σ_B`, a disjoint union
(`pairwiseDisjoint_sigmaBlock`). -/
theorem sigmaUpper_eq_biUnion (S : Finset ℕ) [NeZero (blockProd S)] (k : ℕ) {A₀ : Finset ℕ}
    (hA₀ : A₀.card ≤ k) :
    sigmaUpper (n := n) S k A₀ =
      ((S \ A₀).powerset.filter fun B => B.card ≤ k - A₀.card).biUnion (sigmaBlock S) := by
  ext x
  simp only [mem_sigmaUpper, Finset.mem_biUnion, Finset.mem_filter, Finset.mem_powerset,
    mem_sigmaBlock]
  constructor
  · rintro ⟨hd, hc⟩
    refine ⟨blockSupp S x, ⟨fun q hq => Finset.mem_sdiff.2 ⟨blockSupp_subset S x hq,
      Finset.disjoint_left.1 hd hq⟩, by omega⟩, rfl⟩
  · rintro ⟨B, ⟨hB, hc⟩, rfl⟩
    refine ⟨Finset.disjoint_left.2 fun q hq => (Finset.mem_sdiff.1 (hB hq)).2, by omega⟩

/-- Sums over `Σ_{≤k}` split over the disjoint pieces `Σ_A`. -/
theorem sum_sigmaLe {M : Type*} [AddCommMonoid M] (S : Finset ℕ) [NeZero (blockProd S)] (k : ℕ)
    (f : (Fin n → ZMod (blockProd S)) → M) :
    ∑ x ∈ sigmaLe S k, f x =
      ∑ A ∈ S.powerset.filter (fun A => A.card ≤ k), ∑ x ∈ sigmaBlock S A, f x := by
  rw [sigmaLe_eq_biUnion, Finset.sum_biUnion]
  exact (pairwiseDisjoint_sigmaBlock S).subset (Set.subset_univ _)

/-- Sums over `Σ^{A₀}` split over the disjoint pieces `Σ_B`, `B ⊆ S \ A₀`, `|B| ≤ k - |A₀|`. -/
theorem sum_sigmaUpper {M : Type*} [AddCommMonoid M] (S : Finset ℕ) [NeZero (blockProd S)]
    (k : ℕ) {A₀ : Finset ℕ} (hA₀ : A₀.card ≤ k) (f : (Fin n → ZMod (blockProd S)) → M) :
    ∑ x ∈ sigmaUpper S k A₀, f x =
      ∑ B ∈ (S \ A₀).powerset.filter (fun B => B.card ≤ k - A₀.card),
        ∑ x ∈ sigmaBlock S B, f x := by
  rw [sigmaUpper_eq_biUnion S k hA₀, Finset.sum_biUnion]
  exact (pairwiseDisjoint_sigmaBlock S).subset (Set.subset_univ _)


/-! ### Direct block decomposition and cosets `α + Σ_{A₀}` -/

/-- For `α ∈ Σ_{A₁}`, `β ∈ Σ_{A₀}` with `A₁ ∩ A₀ = ∅`: `α + β ∈ Σ_{A₀ ∪ A₁}`. -/
lemma add_mem_sigmaBlock_union (S : Finset ℕ) [NeZero (blockProd S)] {A₀ A₁ : Finset ℕ}
    (hd : Disjoint A₁ A₀) {α β : Fin n → ZMod (blockProd S)} (hα : α ∈ sigmaBlock S A₁)
    (hβ : β ∈ sigmaBlock S A₀) : α + β ∈ sigmaBlock S (A₀ ∪ A₁) := by
  rw [mem_sigmaBlock] at hα hβ ⊢
  rw [blockSupp_add_of_disjoint S (by rwa [hα, hβ]), hα, hβ, Finset.union_comm]

/-- The map `(α, β) ↦ α + β` is a bijection `Σ_{A₁} × Σ_{A₀} → Σ_{A₀ ∪ A₁}` for disjoint
`A₁, A₀` (the direct block decomposition), with inverse `x ↦ (e_{A₁} x, e_{A₀} x)`. -/
theorem sigmaBlock_add_bijOn {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {A₀ A₁ : Finset ℕ} (hd : Disjoint A₁ A₀) :
    Set.BijOn (fun p : (Fin n → ZMod (blockProd S)) × (Fin n → ZMod (blockProd S)) => p.1 + p.2)
      ((sigmaBlock (n := n) S A₁ ×ˢ sigmaBlock (n := n) S A₀ : Finset _) : Set _)
      ((sigmaBlock (n := n) S (A₀ ∪ A₁) : Finset _) : Set _) := by
  refine Set.InvOn.bijOn (f' := fun x => (blockProj S A₁ x, blockProj S A₀ x)) ⟨?_, ?_⟩ ?_ ?_
  · rintro ⟨α, β⟩ h
    simp only [Finset.coe_product, Set.mem_prod, Finset.mem_coe, mem_sigmaBlock] at h
    obtain ⟨hα, hβ⟩ := h
    simp only [blockProj_add, Prod.mk.injEq]
    refine ⟨?_, ?_⟩
    · rw [blockProj_eq_self hS hα.le, blockProj_eq_zero hS (hβ ▸ hd.symm), add_zero]
    · rw [blockProj_eq_zero hS (hα ▸ hd), blockProj_eq_self hS hβ.le, zero_add]
  · intro x hx
    simp only [Finset.mem_coe, mem_sigmaBlock] at hx
    exact blockProj_add_blockProj hS hd (by rw [hx, Finset.union_comm])
  · rintro ⟨α, β⟩ h
    simp only [Finset.coe_product, Set.mem_prod, Finset.mem_coe] at h
    exact add_mem_sigmaBlock_union S hd h.1 h.2
  · intro x hx
    simp only [Finset.mem_coe, mem_sigmaBlock] at hx
    simp only [Finset.coe_product, Set.mem_prod, Finset.mem_coe, mem_sigmaBlock,
      blockSupp_blockProj hS, hx]
    constructor
    · ext q; simp only [Finset.mem_inter, Finset.mem_union]
      constructor
      · exact fun h => h.2
      · exact fun h => ⟨Or.inr h, h⟩
    · ext q; simp only [Finset.mem_inter, Finset.mem_union]
      constructor
      · exact fun h => h.2
      · exact fun h => ⟨Or.inl h, h⟩

/-- The direct block decomposition in sum form (used in Blueprint Lemmas 7.4–7.5):
for disjoint `A₁, A₀`, `f_{A₀ ∪ A₁} = ∑_{α ∈ Σ_{A₁}} f_{A₀,α}` where
`f_{A₀,α} = ∑_{β ∈ Σ_{A₀}} f_{α+β}`. -/
theorem sum_sigmaBlock_union {M : Type*} [AddCommMonoid M] {S : Finset ℕ}
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {A₀ A₁ : Finset ℕ}
    (hd : Disjoint A₁ A₀) (f : (Fin n → ZMod (blockProd S)) → M) :
    ∑ x ∈ sigmaBlock S (A₀ ∪ A₁), f x =
      ∑ α ∈ sigmaBlock S A₁, ∑ β ∈ sigmaBlock S A₀, f (α + β) := by
  rw [← Finset.sum_product' (f := fun α β => f (α + β))]
  symm
  exact Finset.sum_nbij (fun p => p.1 + p.2) (sigmaBlock_add_bijOn hS hd).mapsTo
    (sigmaBlock_add_bijOn hS hd).injOn (sigmaBlock_add_bijOn hS hd).surjOn fun _ _ => rfl

/-- Cosets `α + Σ_{A₀}`, `α ∈ Σ^{A₀}` (used in Blueprint Lemma 7.6): a point `x` lies in the
coset of `(A₀, α)` iff `A₀ ⊆ blockSupp S x`, `|blockSupp S x| ≤ k` and `α = e_{S \ A₀} x`; in
particular a center with support `A` occurs in some such coset exactly when `A₀ ⊆ A`, and then
`α` is uniquely determined. -/
theorem mem_coset_iff {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {k : ℕ} {A₀ : Finset ℕ}
    (x α : Fin n → ZMod (blockProd S)) :
    (α ∈ sigmaUpper S k A₀ ∧ x - α ∈ sigmaBlock S A₀) ↔
      (A₀ ⊆ blockSupp S x ∧ (blockSupp S x).card ≤ k ∧ α = blockProj S (S \ A₀) x) := by
  rw [mem_sigmaUpper, mem_sigmaBlock]
  constructor
  · rintro ⟨⟨hd, hc⟩, hβ⟩
    have hx : x = α + (x - α) := by abel
    have hsupp : blockSupp S x = blockSupp S α ∪ A₀ := by
      rw [hx, blockSupp_add_of_disjoint S (by rwa [hβ]), hβ]
    refine ⟨hsupp ▸ Finset.subset_union_right, ?_, ?_⟩
    · rw [hsupp, Finset.card_union_of_disjoint hd]; exact hc
    · rw [hx, blockProj_add, blockProj_eq_self hS (fun q hq => Finset.mem_sdiff.2
        ⟨blockSupp_subset S α hq, Finset.disjoint_left.1 hd hq⟩),
        blockProj_eq_zero hS (hβ ▸ Finset.disjoint_sdiff), add_zero]
  · rintro ⟨hsub, hc, rfl⟩
    have hsplit := blockProj_add_blockProj_sdiff hS A₀ x
    have hxa : x - blockProj S (S \ A₀) x = blockProj S A₀ x := by
      rw [sub_eq_iff_eq_add]; exact hsplit.symm
    have h1 : blockSupp S (blockProj S (S \ A₀) x) = blockSupp S x \ A₀ := by
      rw [blockSupp_blockProj hS]
      ext q
      simp only [Finset.mem_inter, Finset.mem_sdiff]
      constructor
      · exact fun h => ⟨h.1, h.2.2⟩
      · exact fun h => ⟨h.1, blockSupp_subset S x h.1, h.2⟩
    refine ⟨⟨?_, ?_⟩, ?_⟩
    · rw [h1]; exact Finset.sdiff_disjoint
    · have := Finset.card_le_card hsub
      rw [h1, Finset.card_sdiff_of_subset hsub]; omega
    · rw [hxa, blockSupp_blockProj hS, Finset.inter_eq_right.2 hsub]

/-! ### The embedding into `E` and the full grids `T[d]` -/

/-- The point `((xᵢ).val / Q)ᵢ ∈ [0,1)ⁿ ⊂ E` representing `x ∈ T[Q] = (Q⁻¹ℤ/ℤ)ⁿ`. -/
noncomputable def ratPt (Q : ℕ) (x : Fin n → ZMod Q) : EuclideanSpace ℝ (Fin n) :=
  WithLp.toLp 2 (fun i => ((x i).val : ℝ) / Q)

@[simp] lemma ratPt_apply (Q : ℕ) (x : Fin n → ZMod Q) (i : Fin n) :
    ratPt Q x i = ((x i).val : ℝ) / Q := rfl

lemma ratPt_injective (Q : ℕ) [NeZero Q] : Function.Injective (ratPt (n := n) Q) := by
  intro x y h
  funext i
  have hi := congrArg (fun v : EuclideanSpace ℝ (Fin n) => v i) h
  simp only [ratPt_apply] at hi
  have hQ : (Q : ℝ) ≠ 0 := Nat.cast_ne_zero.2 (NeZero.ne Q)
  rw [div_left_inj' hQ, Nat.cast_inj] at hi
  exact ZMod.val_injective Q hi

/-- The grid point `b ↦ b · (Q/d)` of `T[d] ⊆ T[Q]`, `b ∈ {0, …, d-1}ⁿ`. -/
def gridEmb (Q d : ℕ) (b : Fin n → Fin d) : Fin n → ZMod Q :=
  fun i => (((b i : ℕ) * (Q / d) : ℕ) : ZMod Q)

lemma val_gridEmb {Q d : ℕ} [NeZero Q] (hd : d ∣ Q) (b : Fin n → Fin d) (i : Fin n) :
    (gridEmb Q d b i).val = (b i : ℕ) * (Q / d) := by
  unfold gridEmb
  rw [ZMod.val_natCast, Nat.mod_eq_of_lt]
  have hd0 : 0 < d := (b i).pos
  have hQd : 0 < Q / d := Nat.div_pos (Nat.le_of_dvd (Nat.pos_of_ne_zero (NeZero.ne Q)) hd) hd0
  calc (b i : ℕ) * (Q / d) < d * (Q / d) := Nat.mul_lt_mul_of_pos_right (b i).2 hQd
    _ = Q := Nat.mul_div_cancel' hd

/-- `gridEmb` realizes the grid points `gridPt d b` of `gridSym`. -/
lemma ratPt_gridEmb {Q d : ℕ} [NeZero Q] (hd : d ∣ Q) (b : Fin n → Fin d) :
    ratPt Q (gridEmb Q d b) = gridPt d b := by
  ext i
  simp only [ratPt_apply, gridPt, PiLp.toLp_apply, val_gridEmb hd]
  have hd0 : (0 : ℝ) < d := Nat.cast_pos.2 (b i).pos
  have hQ : (Q : ℝ) = d * ((Q / d : ℕ) : ℝ) := by exact_mod_cast (Nat.mul_div_cancel' hd).symm
  have hQd : ((Q / d : ℕ) : ℝ) ≠ 0 := by
    intro h; rw [h, mul_zero] at hQ; exact NeZero.ne Q (by exact_mod_cast hQ)
  rw [hQ]; push_cast; field_simp

lemma gridEmb_injective {Q d : ℕ} [NeZero Q] (hd : d ∣ Q) :
    Function.Injective (gridEmb (n := n) Q d) := by
  intro b b' h
  funext i
  have h1 := congrArg (fun x => (x i).val) h
  simp only [val_gridEmb hd] at h1
  have hQd : 0 < Q / d :=
    Nat.div_pos (Nat.le_of_dvd (Nat.pos_of_ne_zero (NeZero.ne Q)) hd) (b i).pos
  exact Fin.ext (Nat.eq_of_mul_eq_mul_right hQd h1)

lemma gridEmb_mem_blockGrid {Q d : ℕ} [NeZero Q] (hd : d ∣ Q) (b : Fin n → Fin d) :
    gridEmb Q d b ∈ blockGrid Q d := by
  rw [mem_blockGrid]
  funext i
  simp only [Pi.smul_apply, gridEmb, nsmul_eq_mul, Pi.zero_apply]
  rw [← Nat.cast_mul, mul_left_comm, Nat.mul_div_cancel' hd, ZMod.natCast_eq_zero_iff]
  exact Dvd.intro_left _ rfl

lemma exists_gridEmb_eq {Q d : ℕ} [NeZero Q] (hd : d ∣ Q) {x : Fin n → ZMod Q}
    (hx : x ∈ blockGrid Q d) : ∃ b, gridEmb Q d b = x := by
  rw [mem_blockGrid] at hx
  have hQ0 : 0 < Q := Nat.pos_of_ne_zero (NeZero.ne Q)
  have hd0 : 0 < d := Nat.pos_of_dvd_of_pos hd hQ0
  have hQd : d * (Q / d) = Q := Nat.mul_div_cancel' hd
  have key : ∀ i, ∃ t : Fin d, (t : ℕ) * (Q / d) = (x i).val := by
    intro i
    have h1 := congrFun hx i
    simp only [Pi.smul_apply, nsmul_eq_mul, Pi.zero_apply] at h1
    rw [← ZMod.natCast_zmod_val (x i), ← Nat.cast_mul, ZMod.natCast_eq_zero_iff] at h1
    have h2 : d * (Q / d) ∣ d * (x i).val := by rw [hQd]; exact h1
    obtain ⟨t, ht⟩ := (Nat.mul_dvd_mul_iff_left hd0).1 h2
    refine ⟨⟨t, ?_⟩, by rw [ht, mul_comm]⟩
    have hlt := ZMod.val_lt (x i)
    rw [ht] at hlt
    nth_rewrite 2 [← hQd] at hlt
    rw [mul_comm d] at hlt
    exact Nat.lt_of_mul_lt_mul_left hlt
  choose b hb using key
  refine ⟨b, funext fun i => ?_⟩
  simp only [gridEmb]
  rw [hb i, ZMod.natCast_zmod_val]

/-- Sums over `T[d] ⊆ T[Q]` in the coordinates of `gridSym`. -/
theorem sum_blockGrid_eq_sum_gridPt {M : Type*} [AddCommMonoid M] {Q d : ℕ} [NeZero Q]
    (hd : d ∣ Q) (g : EuclideanSpace ℝ (Fin n) → M) :
    ∑ x ∈ blockGrid Q d, g (ratPt Q x) = ∑ b : Fin n → Fin d, g (gridPt d b) := by
  symm
  refine Finset.sum_bij (fun b _ => gridEmb Q d b) (fun b _ => gridEmb_mem_blockGrid hd b)
    (fun b _ b' _ h => gridEmb_injective hd h) (fun x hx => ?_) (fun b _ => by
      rw [ratPt_gridEmb hd])
  obtain ⟨b, rfl⟩ := exists_gridEmb_eq hd hx
  exact ⟨b, Finset.mem_univ _, rfl⟩

/-- The full-grid multiplier `T_{m;T[d]}` is `Δ_d m = gridSym d m` of Blueprint Lemma 6.2. -/
theorem sum_blockGrid_periodize_eq_gridSym {Q d : ℕ} [NeZero Q] (hd : d ∣ Q)
    (m : EuclideanSpace ℝ (Fin n) → ℂ) (ξ : EuclideanSpace ℝ (Fin n)) :
    ∑ x ∈ blockGrid Q d, periodize m (ξ - ratPt Q x) = gridSym d m ξ :=
  sum_blockGrid_eq_sum_gridPt hd (fun β => periodize m (ξ - β))

/-- `#T[d] = dⁿ`. -/
theorem card_blockGrid {Q d : ℕ} [NeZero Q] (hd : d ∣ Q) :
    (blockGrid (n := n) Q d).card = d ^ n := by
  have := sum_blockGrid_eq_sum_gridPt (n := n) (M := ℕ) hd (fun _ => 1)
  simp only [Finset.sum_const, smul_eq_mul, mul_one, Finset.card_univ, Fintype.card_fun,
    Fintype.card_fin] at this
  exact this

/-- `#Σ_A ≤ Q_Aⁿ`. -/
theorem card_sigmaBlock_le {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {A : Finset ℕ} (hA : A ⊆ S) :
    (sigmaBlock (n := n) S A).card ≤ blockProd A ^ n := by
  rw [← card_blockGrid (Q := blockProd S) (blockProd_dvd_blockProd hA)]
  exact Finset.card_le_card (sigmaBlock_subset_blockGrid hS hA)

/-! ### Inclusion–exclusion (eq. `inclusionexclusion` of Blueprint Lemma 7.6) -/

lemma sum_superset_neg_one_pow (C A₀ : Finset ℕ) :
    ∑ B ∈ A₀.powerset.filter (fun B => C ⊆ B), (-1 : ℤ) ^ (A₀.card - B.card) =
      if C = A₀ then 1 else 0 := by
  by_cases hC : C ⊆ A₀
  · rw [Finset.sum_nbij' (fun B => A₀ \ B) (fun D => A₀ \ D)
      (t := (A₀ \ C).powerset) (g := fun D => (-1 : ℤ) ^ D.card)]
    · rw [Finset.sum_powerset_neg_one_pow_card]
      by_cases h : C = A₀
      · simp [h]
      · have h' : A₀ \ C ≠ ∅ := fun h' =>
          h (Finset.Subset.antisymm hC (Finset.sdiff_eq_empty_iff_subset.1 h'))
        simp [h, h']
    · intro B hB
      simp only [Finset.mem_filter, Finset.mem_powerset] at hB ⊢
      exact Finset.sdiff_subset_sdiff subset_rfl hB.2
    · intro D hD
      simp only [Finset.mem_filter, Finset.mem_powerset] at hD ⊢
      refine ⟨Finset.sdiff_subset, fun q hq => Finset.mem_sdiff.2 ⟨hC hq, fun hqD => ?_⟩⟩
      exact (Finset.mem_sdiff.1 (hD hqD)).2 hq
    · intro B hB
      simp only [Finset.mem_filter, Finset.mem_powerset] at hB
      exact Finset.sdiff_sdiff_eq_self hB.1
    · intro D hD
      simp only [Finset.mem_powerset] at hD
      exact Finset.sdiff_sdiff_eq_self (hD.trans Finset.sdiff_subset)
    · intro B hB
      simp only [Finset.mem_filter, Finset.mem_powerset] at hB
      rw [Finset.card_sdiff_of_subset hB.1]
  · rw [ite_eq_right (fun h => hC h.le)]
    refine Finset.sum_eq_zero fun B hB => ?_
    simp only [Finset.mem_filter, Finset.mem_powerset] at hB
    exact absurd (hB.2.trans hB.1) hC

/-- Inclusion–exclusion on which block components vanish (eq. `inclusionexclusion` of Blueprint
Lemma 7.6): for `A₀ ⊆ S`,
`∑_{x ∈ Σ_{A₀}} f x = ∑_{B ⊆ A₀} (-1)^{|A₀|-|B|} ∑_{x ∈ T[Q_B]} f x`. -/
theorem sum_sigmaBlock_inclusion_exclusion {M : Type*} [AddCommGroup M] {S : Finset ℕ}
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {A₀ : Finset ℕ}
    (hA₀ : A₀ ⊆ S) (f : (Fin n → ZMod (blockProd S)) → M) :
    ∑ x ∈ sigmaBlock S A₀, f x =
      ∑ B ∈ A₀.powerset, (-1 : ℤ) ^ (A₀.card - B.card) •
        ∑ x ∈ blockGrid (blockProd S) (blockProd B), f x := by
  have hgrid : ∑ B ∈ A₀.powerset, (-1 : ℤ) ^ (A₀.card - B.card) •
        ∑ x ∈ blockGrid (blockProd S) (blockProd B), f x =
      ∑ B ∈ A₀.powerset, (-1 : ℤ) ^ (A₀.card - B.card) •
        ∑ x ∈ Finset.univ.filter (fun x : Fin n → ZMod (blockProd S) => blockSupp S x ⊆ B),
          f x :=
    Finset.sum_congr rfl fun B hB => by
      rw [blockGrid_blockProd_eq_filter hS ((Finset.mem_powerset.1 hB).trans hA₀)]
  rw [hgrid]
  simp_rw [Finset.sum_filter, Finset.smul_sum]
  rw [Finset.sum_comm]
  simp_rw [smul_ite, smul_zero, ← Finset.sum_filter, ← Finset.sum_smul,
    sum_superset_neg_one_pow, ite_smul, one_smul, zero_smul]
  rw [← Finset.sum_filter]
  rfl


/-! ### The separation property (7.1) -/

/-- `ratPt Q x ∈ ℤⁿ` iff `x = 0`. -/
lemma ratPt_mem_range_latEmbed_iff {Q : ℕ} [NeZero Q] (x : Fin n → ZMod Q) :
    ratPt Q x ∈ Set.range (latEmbed (n := n)) ↔ x = 0 := by
  constructor
  · rintro ⟨z, hz⟩
    funext i
    have hi := congrArg (fun v : EuclideanSpace ℝ (Fin n) => v i) hz
    simp only [latEmbed_apply, ratPt_apply] at hi
    have hQ : (0 : ℝ) < Q := Nat.cast_pos.2 (Nat.pos_of_ne_zero (NeZero.ne Q))
    have h0 : (0 : ℝ) ≤ (x i).val / Q := by positivity
    have h1 : ((x i).val : ℝ) / Q < 1 := by
      rw [div_lt_one hQ]; exact_mod_cast ZMod.val_lt (x i)
    rw [← hi] at h0 h1
    have hz0 : z i = 0 := by
      have a : (0 : ℤ) ≤ z i := by exact_mod_cast h0
      have b : z i < 1 := by exact_mod_cast h1
      omega
    rw [hz0, Int.cast_zero, eq_comm, div_eq_zero_iff] at hi
    rcases hi with h | h
    · rw [Pi.zero_apply, ← ZMod.val_eq_zero]; exact_mod_cast h
    · exact absurd h hQ.ne'
  · rintro rfl
    exact ⟨0, by ext i; simp [ratPt_apply, latEmbed_apply]⟩

lemma ratPt_intCast_coord (Q : ℕ) [NeZero Q] (w : ℤ) :
    ∃ z : ℤ, (((w : ZMod Q)).val : ℝ) / Q = w / Q + z := by
  refine ⟨-(w / (Q : ℤ)), ?_⟩
  have hQ : (Q : ℝ) ≠ 0 := Nat.cast_ne_zero.2 (NeZero.ne Q)
  have h1 : (((w : ZMod Q).val : ℤ)) = w % Q := ZMod.val_intCast w
  have h3 : ((w : ZMod Q).val : ℝ) = ((w % (Q : ℤ) : ℤ) : ℝ) := by
    rw [← h1]; simp
  rw [h3, Int.emod_def]
  push_cast
  field_simp
  ring

/-- The embedding `ratPt` is additive modulo `ℤⁿ`: for integer coefficients `σ_j`,
`ratPt (∑ σ_j α_j) - ∑ σ_j ratPt α_j ∈ ℤⁿ`. -/
theorem ratPt_sum_zsmul_sub_mem {Q : ℕ} [NeZero Q] {ι : Type*} (s : Finset ι) (σ : ι → ℤ)
    (α : ι → Fin n → ZMod Q) :
    ∃ z : Fin n → ℤ,
      ratPt Q (∑ j ∈ s, σ j • α j) = ∑ j ∈ s, σ j • ratPt Q (α j) + latEmbed z := by
  have key : ∀ i, ∃ z : ℤ, (((∑ j ∈ s, σ j • α j) i).val : ℝ) / Q =
      ∑ j ∈ s, (σ j : ℝ) * (((α j i).val : ℝ) / Q) + z := by
    intro i
    have hw : (∑ j ∈ s, σ j • α j) i = ((∑ j ∈ s, σ j * ((α j i).val : ℤ) : ℤ) : ZMod Q) := by
      simp only [Finset.sum_apply, zsmul_eq_mul]
      push_cast
      simp
    obtain ⟨z, hz⟩ := ratPt_intCast_coord Q (∑ j ∈ s, σ j * ((α j i).val : ℤ))
    refine ⟨z, ?_⟩
    rw [hw, hz]
    push_cast
    rw [Finset.sum_div]
    congr 1
    refine Finset.sum_congr rfl fun j _ => ?_
    ring
  choose z hz using key
  refine ⟨z, ?_⟩
  ext i
  simp only [ratPt_apply, hz i, PiLp.add_apply, latEmbed_apply]
  simp

lemma sum_zsmul_ratPt_mem_range_iff {Q : ℕ} [NeZero Q] {ι : Type*} (s : Finset ι)
    (σ : ι → ℤ) (α : ι → Fin n → ZMod Q) :
    ∑ j ∈ s, σ j • ratPt Q (α j) ∈ Set.range (latEmbed (n := n)) ↔
      ∑ j ∈ s, σ j • α j = 0 := by
  obtain ⟨z, hz⟩ := ratPt_sum_zsmul_sub_mem s σ α
  rw [← ratPt_mem_range_latEmbed_iff, hz]
  constructor
  · rintro ⟨w, hw⟩
    exact ⟨w + z, by rw [latEmbed_add, hw]⟩
  · rintro ⟨w, hw⟩
    refine ⟨w - z, ?_⟩
    rw [latEmbed_sub, hw, add_sub_cancel_right]

/-- A nonzero `y ∈ ZMod Q` killed by `D` has `y/Q` at distance `≥ 1/D` from every integer. -/
lemma inv_le_abs_sub_int {Q D : ℕ} [NeZero Q] {y : ZMod Q} (hy : y ≠ 0) (hD : D • y = 0)
    (z : ℤ) : ((D : ℝ))⁻¹ ≤ |(y.val : ℝ) / Q - z| := by
  rcases Nat.eq_zero_or_pos D with rfl | hD0
  · simp
  have hQ0 : 0 < Q := Nat.pos_of_ne_zero (NeZero.ne Q)
  have h1 : Q ∣ D * y.val := by
    rw [nsmul_eq_mul, ← ZMod.natCast_zmod_val y, ← Nat.cast_mul, ZMod.natCast_eq_zero_iff] at hD
    exact hD
  obtain ⟨t, ht⟩ := h1
  have hv0 : 0 < y.val := Nat.pos_of_ne_zero fun h => hy ((ZMod.val_eq_zero y).1 h)
  have hvQ := ZMod.val_lt y
  have ht0 : 0 < t := by
    rcases Nat.eq_zero_or_pos t with h | h
    · rw [h, mul_zero] at ht
      exact absurd ht (Nat.mul_pos hD0 hv0).ne'
    · exact h
  have htD : t < D := by
    by_contra h
    replace h := not_lt.1 h
    have : Q * D ≤ Q * t := Nat.mul_le_mul_left Q h
    have : D * y.val < D * Q := Nat.mul_lt_mul_of_pos_left hvQ hD0
    nlinarith
  have hDr : (0 : ℝ) < D := Nat.cast_pos.2 hD0
  have hQr : (0 : ℝ) < Q := Nat.cast_pos.2 hQ0
  have key : (y.val : ℝ) / Q - z = (((t : ℤ) - z * D : ℤ) : ℝ) / D := by
    have h' : (D : ℝ) * y.val = Q * t := by exact_mod_cast ht
    field_simp
    push_cast
    linear_combination h'
  rw [key, abs_div, abs_of_pos hDr, inv_eq_one_div]
  refine div_le_div_of_nonneg_right ?_ hDr.le
  have hne : (t : ℤ) - z * D ≠ 0 := by
    intro h
    have ht' : (t : ℤ) = z * D := by linarith
    have ht0' : (0 : ℤ) < t := by exact_mod_cast ht0
    have htD' : (t : ℤ) < D := by exact_mod_cast htD
    rcases le_or_gt z 0 with hz | hz
    · nlinarith
    · nlinarith
  exact_mod_cast Int.one_le_abs hne

/-- The `ε`-condition (7.1) gives `4rε < q_*^{-2rk}` (any base `q ≥ 1`, any exponent). -/
lemma four_mul_lt_of_le_eps {q r m : ℕ} (hq : 1 ≤ q) {ε : ℝ}
    (hεr : ε ≤ (100 * r * (q : ℝ) ^ m)⁻¹) : 4 * r * ε < ((q : ℝ) ^ m)⁻¹ := by
  have hX : (0 : ℝ) < (q : ℝ) ^ m := pow_pos (by exact_mod_cast hq) m
  rcases Nat.eq_zero_or_pos r with rfl | hr
  · simp [hX]
  have hr' : (0 : ℝ) < r := Nat.cast_pos.2 hr
  have c : (0 : ℝ) < 100 * r * (q : ℝ) ^ m := by positivity
  have h1 := mul_le_mul_of_nonneg_left hεr c.le
  rw [mul_inv_cancel₀ c.ne'] at h1
  rw [← one_div, lt_div_iff₀ hX]
  nlinarith

/-- Blueprint Definition 7.1 (`def:blocks`), separation property (7.1), quantitative form:
if `α_j ∈ Σ_{≤k}` for `j` in a finite index set `s` with `|s| ≤ 2r` (at most `2r` centers),
`σ_j ∈ ℤ` (e.g. signs `±1`), and the `i`-th coordinate of `∑ σ_j α_j` is nonzero in
`Q_S⁻¹ℤ/ℤ`, then the `i`-th coordinate of `∑ σ_j α_j ∈ E` has distance at least
`q_*^{-2rk}` from every integer. (Its denominator divides a product of at most `2rk` blocks.) -/
theorem separation_quantitative {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} {ι : Type*}
    (s : Finset ι) (hs : s.card ≤ 2 * r) (α : ι → Fin n → ZMod (blockProd S))
    (hα : ∀ j ∈ s, α j ∈ sigmaLe S k) (σ : ι → ℤ) {i : Fin n}
    (hi : (∑ j ∈ s, σ j • α j) i ≠ 0) (z : ℤ) :
    ((blockStar S : ℝ) ^ (2 * r * k))⁻¹ ≤
      |(∑ j ∈ s, σ j • ratPt (blockProd S) (α j)) i - z| := by
  set D := ∏ j ∈ s, blockProd (blockSupp S (α j)) with hDdef
  have hDy : D • (∑ j ∈ s, σ j • α j) = 0 := by
    rw [Finset.smul_sum]
    refine Finset.sum_eq_zero fun j hj => ?_
    rw [smul_comm, nsmul_eq_zero_of_dvd (Finset.dvd_prod_of_mem _ hj)
      ((nsmul_blockProd_eq_zero_iff hS (blockSupp_subset S (α j))).2 subset_rfl), smul_zero]
  have hDi : D • (∑ j ∈ s, σ j • α j) i = 0 := by
    have := congrFun hDy i
    simpa only [Pi.smul_apply, Pi.zero_apply] using this
  have hq1 : 1 ≤ blockStar S := le_trans (by norm_num) (two_le_blockStar S)
  have hDpos : 0 < D := Finset.prod_pos fun j _ =>
    blockProd_pos fun q hq => hS1 q (blockSupp_subset S (α j) hq)
  have hDle : D ≤ blockStar S ^ (2 * r * k) := by
    calc D ≤ (blockStar S ^ k) ^ s.card := by
          refine Finset.prod_le_pow_card _ _ _ fun j hj => ?_
          exact (blockProd_le_pow (blockSupp_subset S (α j))).trans
            (Nat.pow_le_pow_right hq1 (mem_sigmaLe.1 (hα j hj)))
      _ ≤ (blockStar S ^ k) ^ (2 * r) := Nat.pow_le_pow_right (Nat.one_le_pow _ _ hq1) hs
      _ = blockStar S ^ (2 * r * k) := by rw [← pow_mul, mul_comm k]
  obtain ⟨z0, hz0⟩ := ratPt_sum_zsmul_sub_mem s σ α
  have hcoord := congrArg (fun v : EuclideanSpace ℝ (Fin n) => v i) hz0
  simp only [ratPt_apply, PiLp.add_apply, latEmbed_apply] at hcoord
  have hmain := inv_le_abs_sub_int hi hDi (z0 i + z)
  have heq : (∑ j ∈ s, σ j • ratPt (blockProd S) (α j)) i - z =
      (((∑ j ∈ s, σ j • α j) i).val : ℝ) / (blockProd S) - ((z0 i + z : ℤ) : ℝ) := by
    rw [hcoord]; push_cast; ring
  rw [heq]
  refine le_trans ?_ hmain
  have hDr : (0 : ℝ) < D := Nat.cast_pos.2 hDpos
  rw [← Nat.cast_pow]
  exact inv_anti₀ hDr (by exact_mod_cast hDle)

/-- Blueprint Definition 7.1 (`def:blocks`), separation property (7.1): let `q_* = max(2, max S)`
and `0 < ε ≤ (100 r q_*^{2rk})⁻¹`. If `α_j ∈ Σ_{≤k}` (at most `2r` of them), `|σ_j| ≤ 1`
(e.g. signs `±1`) and `∑ σ_j α_j ≠ 0` in `T[Q_S]`, then for all perturbations `δ_j ∈ E` with
`‖δ_j‖_∞ ≤ 2ε` the perturbed sum `∑ σ_j (α_j + δ_j)` is not in `ℤⁿ`. -/
theorem separation {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} {ε : ℝ}
    (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹) {ι : Type*}
    (s : Finset ι) (hs : s.card ≤ 2 * r) (α : ι → Fin n → ZMod (blockProd S))
    (hα : ∀ j ∈ s, α j ∈ sigmaLe S k) (σ : ι → ℤ) (hσ : ∀ j ∈ s, |σ j| ≤ 1)
    (h : ∑ j ∈ s, σ j • α j ≠ 0) (δ : ι → EuclideanSpace ℝ (Fin n))
    (hδ : ∀ j ∈ s, ∀ i, |δ j i| ≤ 2 * ε) :
    ∑ j ∈ s, σ j • (ratPt (blockProd S) (α j) + δ j) ∉ Set.range (latEmbed (n := n)) := by
  obtain ⟨i, hi⟩ := Function.ne_iff.1 h
  rintro ⟨z, hz⟩
  have hlt := four_mul_lt_of_le_eps (q := blockStar S) (r := r) (m := 2 * r * k)
    (le_trans (by norm_num) (two_le_blockStar S)) hεr
  have hquant := separation_quantitative hS1 hS s hs α hα σ hi (z i)
  have hcoord := congrArg (fun v : EuclideanSpace ℝ (Fin n) => v i) hz
  simp only [latEmbed_apply, smul_add, Finset.sum_add_distrib, PiLp.add_apply] at hcoord
  have hsub : (∑ j ∈ s, σ j • ratPt (blockProd S) (α j)) i - z i =
      -(∑ j ∈ s, σ j • δ j) i := by rw [hcoord]; ring
  rw [hsub, abs_neg] at hquant
  have hbound : |(∑ j ∈ s, σ j • δ j) i| ≤ 4 * r * ε := by
    have e : (∑ j ∈ s, σ j • δ j) i = ∑ j ∈ s, (σ j : ℝ) * δ j i := by simp [zsmul_eq_mul]
    rw [e]
    calc |∑ j ∈ s, (σ j : ℝ) * δ j i| ≤ ∑ j ∈ s, |(σ j : ℝ) * δ j i| :=
          Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ _j ∈ s, 2 * ε := by
          refine Finset.sum_le_sum fun j hj => ?_
          rw [abs_mul]
          have h1 : |(σ j : ℝ)| ≤ 1 := by
            rw [← Int.cast_abs]; exact_mod_cast hσ j hj
          calc |(σ j : ℝ)| * |δ j i| ≤ 1 * (2 * ε) :=
                mul_le_mul h1 (hδ j hj i) (abs_nonneg _) zero_le_one
            _ = 2 * ε := one_mul _
      _ = s.card * (2 * ε) := by rw [Finset.sum_const, nsmul_eq_mul]
      _ ≤ (2 * r : ℕ) * (2 * ε) := by
          refine mul_le_mul_of_nonneg_right (by exact_mod_cast hs) (by positivity)
      _ = 4 * r * ε := by push_cast; ring
  linarith

/-- The separation property (7.1) with the non-cancellation hypothesis stated in `E`:
`∑ σ_j α_j ∉ ℤⁿ` for the embedded centers. -/
theorem separation_of_not_mem {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} {ε : ℝ}
    (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹) {ι : Type*}
    (s : Finset ι) (hs : s.card ≤ 2 * r) (α : ι → Fin n → ZMod (blockProd S))
    (hα : ∀ j ∈ s, α j ∈ sigmaLe S k) (σ : ι → ℤ) (hσ : ∀ j ∈ s, |σ j| ≤ 1)
    (h : ∑ j ∈ s, σ j • ratPt (blockProd S) (α j) ∉ Set.range (latEmbed (n := n)))
    (δ : ι → EuclideanSpace ℝ (Fin n)) (hδ : ∀ j ∈ s, ∀ i, |δ j i| ≤ 2 * ε) :
    ∑ j ∈ s, σ j • (ratPt (blockProd S) (α j) + δ j) ∉ Set.range (latEmbed (n := n)) :=
  separation hS1 hS hε hεr s hs α hα σ hσ
    (fun h0 => h ((sum_zsmul_ratPt_mem_range_iff s σ α).2 h0)) δ hδ

/-! ### Blueprint Lemma 7.2 (`lem:superorth`): superorthogonality from a singleton index -/

section Superorthogonality

/-- Elementary symmetric sums of nonnegative reals are bounded by powers of the full sum
(helper for Blueprint Lemma 7.2 (`lem:superorth`)). -/
lemma superorth_esymm_le {ι : Type*} (x : ι → ℝ) (hx : ∀ i, 0 ≤ x i) :
    ∀ (s : Finset ι) (l : ℕ), ∑ V ∈ s.powersetCard l, ∏ v ∈ V, x v ≤ (∑ v ∈ s, x v) ^ l := by
  classical
  intro s
  induction s using Finset.induction_on with
  | empty =>
    intro l
    cases l with
    | zero => simp
    | succ l => rw [powersetCard_eq_empty.2 (by simp)]; simp
  | @insert a s has ih =>
    intro l
    cases l with
    | zero => simp
    | succ l =>
      have hP : 0 ≤ ∑ v ∈ s, x v := sum_nonneg fun v _ => hx v
      rw [powersetCard_succ_insert has, sum_union, sum_image, sum_insert has]
      · have h1 := ih (l + 1)
        have h2 : ∑ V ∈ s.powersetCard l, ∏ v ∈ insert a V, x v
            = x a * ∑ V ∈ s.powersetCard l, ∏ v ∈ V, x v := by
          rw [mul_sum]
          refine sum_congr rfl fun V hV => ?_
          rw [prod_insert]
          exact fun h => has ((mem_powersetCard.1 hV).1 h)
        rw [h2]
        have h3 := mul_le_mul_of_nonneg_left (ih l) (hx a)
        calc _ ≤ (∑ v ∈ s, x v) ^ (l + 1) + x a * (∑ v ∈ s, x v) ^ l := add_le_add h1 h3
          _ ≤ (x a + ∑ v ∈ s, x v) ^ (l + 1) := by
            rw [pow_succ, pow_succ]
            have := pow_le_pow_left₀ hP (le_add_of_nonneg_left (hx a)) l
            nlinarith [hx a, pow_nonneg hP l]
      · intro V hV W hW hVW
        have hV' : a ∉ V := fun h => has ((mem_powersetCard.1 hV).1 h)
        have hW' : a ∉ W := fun h => has ((mem_powersetCard.1 hW).1 h)
        rw [← erase_insert hV', ← erase_insert hW']
        exact congrArg (fun U => U.erase a) hVW
      · rw [disjoint_left]
        intro V hV hV2
        obtain ⟨W, -, rfl⟩ := mem_image.1 hV2
        exact has ((mem_powersetCard.1 hV).1 (mem_insert_self a W))

open Classical in
/-- Blueprint Lemma 7.2 (`lem:superorth`), combinatorial core of the first assertion: the sum of
`∏_q a_{(i q).1} a_{(i q).2}` over all `r`-tuples of index pairs in `s` in which no index occurs
exactly once is at most `(r + 1) r^{2r} (∑_{j ∈ s} a_j²)^r`, for `a ≥ 0`. -/
lemma superorth_comb {ι : Type*} [DecidableEq ι] (s : Finset ι) (a : ι → ℝ)
    (ha : ∀ i, 0 ≤ a i) (r : ℕ) :
    ∑ i ∈ (Fintype.piFinset fun _ : Fin r => s ×ˢ s) with
        ¬ ∃ v, #{q | (i q).1 = v} + #{q | (i q).2 = v} = 1,
      ∏ q, a (i q).1 * a (i q).2
      ≤ ((r + 1) * r ^ (2 * r) : ℝ) * (∑ j ∈ s, a j ^ 2) ^ r := by
  set t := ∑ j ∈ s, a j ^ 2 with ht
  have ht0 : 0 ≤ t := sum_nonneg fun j _ => sq_nonneg _
  set M := Real.sqrt t
  have hM0 : 0 ≤ M := Real.sqrt_nonneg _
  have haM : ∀ v ∈ s, a v ≤ M := fun v hv =>
    Real.le_sqrt_of_sq_le (single_le_sum (f := fun j => a j ^ 2)
      (fun j _ => sq_nonneg _) hv)
  set NS := (Fintype.piFinset fun _ : Fin r => s ×ˢ s).filter
    (fun i : Fin r → ι × ι => ¬ ∃ v, #{q | (i q).1 = v} + #{q | (i q).2 = v} = 1)
  let V : (Fin r → ι × ι) → Finset ι := fun i =>
    (univ.image fun q => (i q).1) ∪ (univ.image fun q => (i q).2)
  let cnt : (Fin r → ι × ι) → ι → ℕ := fun i v => #{q | (i q).1 = v} + #{q | (i q).2 = v}
  let Φ : Finset ι → ℝ := fun W => t ^ (r - #W) * ∏ v ∈ W, a v ^ 2
  have hΦ0 : ∀ W, 0 ≤ Φ W := fun W => mul_nonneg (pow_nonneg ht0 _)
    (prod_nonneg fun v _ => sq_nonneg _)
  -- Step 1: rewriting the product over the positions
  have hprod : ∀ i : Fin r → ι × ι, ∏ q, a (i q).1 * a (i q).2 = ∏ v ∈ V i, a v ^ cnt i v := by
    intro i
    have key : ∀ g : Fin r → ι, univ.image g ⊆ V i →
        ∏ q, a (g q) = ∏ v ∈ V i, a v ^ #{q | g q = v} := by
      intro g hg
      rw [prod_comp (s := univ) a g]
      refine prod_subset hg fun v _ hv => ?_
      have : ({q | g q = v} : Finset (Fin r)) = ∅ := by
        rw [filter_eq_empty_iff]
        intro q _ hq
        exact hv (mem_image.2 ⟨q, mem_univ _, hq⟩)
      rw [this, card_empty, pow_zero]
    rw [prod_mul_distrib, key (fun q => (i q).1) subset_union_left,
      key (fun q => (i q).2) subset_union_right, ← prod_mul_distrib]
    refine prod_congr rfl fun v _ => ?_
    rw [← pow_add]
  -- Step 2: counting in a tuple without singletons
  have hsumcnt : ∀ i : Fin r → ι × ι, ∑ v ∈ V i, cnt i v = 2 * r := by
    intro i
    have e1 : #(univ : Finset (Fin r)) = ∑ v ∈ V i, #{q | (i q).1 = v} :=
      card_eq_sum_card_fiberwise (f := fun q => (i q).1) (fun q _ =>
        mem_union_left _ (mem_image_of_mem (f := fun q => (i q).1) (mem_univ q)))
    have e2 : #(univ : Finset (Fin r)) = ∑ v ∈ V i, #{q | (i q).2 = v} :=
      card_eq_sum_card_fiberwise (f := fun q => (i q).2) (fun q _ =>
        mem_union_right _ (mem_image_of_mem (f := fun q => (i q).2) (mem_univ q)))
    simp only [cnt, sum_add_distrib, ← e1, ← e2, card_univ, Fintype.card_fin]
    ring
  have hcnt2 : ∀ i ∈ NS, ∀ v ∈ V i, 2 ≤ cnt i v := by
    intro i hi v hv
    have hne : cnt i v ≠ 1 := fun h => (mem_filter.1 hi).2 ⟨v, h⟩
    have hpos : 0 < cnt i v := by
      rcases mem_union.1 hv with h | h
      · obtain ⟨q, -, hq⟩ := mem_image.1 h
        have : 0 < #({q | (i q).1 = v} : Finset (Fin r)) :=
          card_pos.2 ⟨q, mem_filter.2 ⟨mem_univ _, hq⟩⟩
        simp only [cnt]; omega
      · obtain ⟨q, -, hq⟩ := mem_image.1 h
        have : 0 < #({q | (i q).2 = v} : Finset (Fin r)) :=
          card_pos.2 ⟨q, mem_filter.2 ⟨mem_univ _, hq⟩⟩
        simp only [cnt]; omega
    omega
  have hVs : ∀ i ∈ NS, V i ⊆ s := by
    intro i hi v hv
    have hi' := Fintype.mem_piFinset.1 (mem_filter.1 hi).1
    rcases mem_union.1 hv with h | h
    · obtain ⟨q, -, rfl⟩ := mem_image.1 h
      exact (mem_product.1 (hi' q)).1
    · obtain ⟨q, -, rfl⟩ := mem_image.1 h
      exact (mem_product.1 (hi' q)).2
  have hVcard : ∀ i ∈ NS, #(V i) ≤ r := by
    intro i hi
    have := card_nsmul_le_sum (V i) (cnt i) 2 (hcnt2 i hi)
    rw [hsumcnt, smul_eq_mul] at this
    omega
  -- Step 3: pointwise bound for a surviving tuple
  have hpt : ∀ i ∈ NS, ∏ q, a (i q).1 * a (i q).2 ≤ Φ (V i) := by
    intro i hi
    rw [hprod]
    have h1 : ∀ v ∈ V i, a v ^ cnt i v ≤ a v ^ 2 * M ^ (cnt i v - 2) := by
      intro v hv
      have h2 := hcnt2 i hi v hv
      calc a v ^ cnt i v = a v ^ 2 * a v ^ (cnt i v - 2) := by
            rw [← pow_add]; congr 1; omega
        _ ≤ a v ^ 2 * M ^ (cnt i v - 2) :=
            mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (ha v) (haM v (hVs i hi hv)) _)
              (sq_nonneg _)
    calc ∏ v ∈ V i, a v ^ cnt i v ≤ ∏ v ∈ V i, (a v ^ 2 * M ^ (cnt i v - 2)) :=
          prod_le_prod₀ (fun v _ => pow_nonneg (ha v) _) h1
      _ = (∏ v ∈ V i, a v ^ 2) * M ^ (∑ v ∈ V i, (cnt i v - 2)) := by
          rw [prod_mul_distrib, prod_pow_eq_pow_sum]
      _ = Φ (V i) := by
          have hsub : ∑ v ∈ V i, (cnt i v - 2) = 2 * (r - #(V i)) := by
            have h3 : ∑ v ∈ V i, (cnt i v - 2) + ∑ v ∈ V i, 2 = ∑ v ∈ V i, cnt i v := by
              rw [← sum_add_distrib]
              exact sum_congr rfl fun v hv => Nat.sub_add_cancel (hcnt2 i hi v hv)
            rw [hsumcnt, sum_const, smul_eq_mul] at h3
            have := hVcard i hi
            omega
          rw [hsub, pow_mul, Real.sq_sqrt ht0, mul_comm]
  -- Step 4: grouping the tuples according to their sets of values
  have hfib : ∀ W : Finset ι, #(W) ≤ r → #{i ∈ NS | V i = W} ≤ r ^ (2 * r) := by
    intro W hW
    calc #{i ∈ NS | V i = W} ≤ #(Fintype.piFinset fun _ : Fin r => W ×ˢ W) := by
          refine card_le_card fun i hi => ?_
          obtain ⟨-, hiW⟩ := mem_filter.1 hi
          refine Fintype.mem_piFinset.2 fun q => mem_product.2 ⟨?_, ?_⟩
          · rw [← hiW]; exact mem_union_left _ (mem_image_of_mem _ (mem_univ q))
          · rw [← hiW]; exact mem_union_right _ (mem_image_of_mem _ (mem_univ q))
      _ = (#W * #W) ^ r := by simp
      _ ≤ (r * r) ^ r := Nat.pow_le_pow_left (Nat.mul_le_mul hW hW) _
      _ = r ^ (2 * r) := by rw [← pow_two, ← pow_mul, mul_comm]
  set P := s.powerset.filter (fun W => #W ≤ r)
  have hstep4 : ∑ i ∈ NS, Φ (V i) ≤ (r ^ (2 * r) : ℝ) * ∑ W ∈ P, Φ W := by
    rw [sum_comp (s := NS) Φ V, mul_sum]
    calc ∑ W ∈ NS.image V, #{i ∈ NS | V i = W} • Φ W
        ≤ ∑ W ∈ NS.image V, (r ^ (2 * r) : ℝ) * Φ W := by
          refine sum_le_sum fun W hW => ?_
          obtain ⟨i, hi, rfl⟩ := mem_image.1 hW
          rw [nsmul_eq_mul]
          refine mul_le_mul_of_nonneg_right ?_ (hΦ0 _)
          exact_mod_cast hfib _ (hVcard i hi)
      _ ≤ ∑ W ∈ P, (r ^ (2 * r) : ℝ) * Φ W := by
          refine sum_le_sum_of_subset_of_nonneg ?_ fun W _ _ =>
            mul_nonneg (by positivity) (hΦ0 W)
          intro W hW
          obtain ⟨i, hi, rfl⟩ := mem_image.1 hW
          exact mem_filter.2 ⟨mem_powerset.2 (hVs i hi), hVcard i hi⟩
  -- Step 5: summing over the cardinalities
  have hstep5 : ∑ W ∈ P, Φ W ≤ (r + 1 : ℝ) * t ^ r := by
    rw [← sum_fiberwise_of_maps_to (s := P) (t := range (r + 1)) (g := fun W => #W)
      (fun W hW => mem_range.2 (Nat.lt_succ_of_le (mem_filter.1 hW).2))]
    calc ∑ l ∈ range (r + 1), ∑ W ∈ P with #W = l, Φ W
        ≤ ∑ _l ∈ range (r + 1), t ^ r := by
          refine sum_le_sum fun l hl => ?_
          have hl' : l ≤ r := Nat.lt_succ_iff.1 (mem_range.1 hl)
          have hPl : ({W ∈ P | #W = l} : Finset (Finset ι)) = s.powersetCard l := by
            ext W
            simp only [P, mem_filter, mem_powerset, mem_powersetCard]
            constructor
            · rintro ⟨⟨h1, -⟩, h2⟩; exact ⟨h1, h2⟩
            · rintro ⟨h1, h2⟩; exact ⟨⟨h1, h2 ▸ hl'⟩, h2⟩
          rw [hPl]
          calc ∑ W ∈ s.powersetCard l, Φ W
              = t ^ (r - l) * ∑ W ∈ s.powersetCard l, ∏ v ∈ W, a v ^ 2 := by
                rw [mul_sum]
                refine sum_congr rfl fun W hW => ?_
                simp only [Φ, (mem_powersetCard.1 hW).2]
            _ ≤ t ^ (r - l) * t ^ l :=
                mul_le_mul_of_nonneg_left
                  (superorth_esymm_le (fun v => a v ^ 2) (fun v => sq_nonneg _) s l)
                  (pow_nonneg ht0 _)
            _ = t ^ r := by rw [← pow_add, Nat.sub_add_cancel hl']
      _ = (r + 1 : ℝ) * t ^ r := by simp
  calc ∑ i ∈ NS, ∏ q, a (i q).1 * a (i q).2 ≤ ∑ i ∈ NS, Φ (V i) := sum_le_sum hpt
    _ ≤ (r ^ (2 * r) : ℝ) * ((r + 1 : ℝ) * t ^ r) :=
        hstep4.trans (mul_le_mul_of_nonneg_left hstep5 (by positivity))
    _ = ((r + 1) * r ^ (2 * r) : ℝ) * t ^ r := by ring

open MeasureTheory
open scoped ENNReal

section SuperorthSingleton

variable {X : Type*} [MeasurableSpace X] {μ : Measure X}
  {𝕜 : Type*} [RCLike 𝕜] {H : Type*} [NormedAddCommGroup H] [InnerProductSpace 𝕜 H]

/-- Expansion of `‖∑_{i∈s} v_i‖^{2r} = ⟪∑ v_i, ∑ v_i⟫^r` into a sum over `r`-tuples of index pairs
(helper for Blueprint Lemma 7.2 (`lem:superorth`)). -/
lemma superorth_norm_pow_expand {ι : Type*} (s : Finset ι) (v : ι → H) (r : ℕ) :
    ((‖∑ i ∈ s, v i‖ ^ (2 * r) : ℝ) : 𝕜) =
      ∑ i ∈ (Fintype.piFinset fun _ : Fin r => s ×ˢ s),
        ∏ q, inner 𝕜 (v (i q).1) (v (i q).2) := by
  have h : inner 𝕜 (∑ i ∈ s, v i) (∑ i ∈ s, v i) =
      ∑ p ∈ s ×ˢ s, inner 𝕜 (v p.1) (v p.2) := by
    rw [sum_inner, sum_product]
    simp_rw [inner_sum]
  rw [pow_mul, RCLike.ofReal_pow, RCLike.ofReal_pow, ← inner_self_eq_norm_sq_to_K, h, sum_pow']

/-- Blueprint Lemma 7.2 (`lem:superorth`), first assertion, integrated `2r`-th moment form:
under the singleton vanishing hypothesis,
`∫ ‖∑_{i∈s} f_i‖^{2r} ≤ (r+1) r^{2r} ∫ (∑_{i∈s} ‖f_i‖²)^r`. -/
theorem superorth_singleton_integral_le {ι : Type*} [DecidableEq ι] {r : ℕ} (s : Finset ι)
    (f : ι → X → H) (hf : ∀ i ∈ s, MemLp (f i) ((2 * r : ℕ) : ℝ≥0∞) μ)
    (hvan : ∀ i : Fin r → ι × ι, (∀ q, (i q).1 ∈ s ∧ (i q).2 ∈ s) →
      (∃ v, #{q | (i q).1 = v} + #{q | (i q).2 = v} = 1) →
        ∫ x, ∏ q, inner 𝕜 (f (i q).1 x) (f (i q).2 x) ∂μ = 0) :
    ∫ x, ‖∑ i ∈ s, f i x‖ ^ (2 * r) ∂μ ≤
      ((r + 1) * r ^ (2 * r) : ℝ) * ∫ x, (∑ i ∈ s, ‖f i x‖ ^ 2) ^ r ∂μ := by
  classical
  rcases Nat.eq_zero_or_pos r with rfl | hr
  · simp
  set T := Fintype.piFinset fun _ : Fin r => s ×ˢ s
  let m : X → ℝ := fun x => ∑ j ∈ s, ‖f j x‖
  have hm0 : ∀ x, 0 ≤ m x := fun x => sum_nonneg fun j _ => norm_nonneg _
  have hfm : ∀ j ∈ s, ∀ x, ‖f j x‖ ≤ m x := fun j hj x =>
    single_le_sum (f := fun j => ‖f j x‖) (fun j _ => norm_nonneg _) hj
  have hmLp : MemLp m ((2 * r : ℕ) : ℝ≥0∞) μ :=
    memLp_finsetSum s fun j hj => (hf j hj).norm
  have hmint : Integrable (fun x => m x ^ (2 * r)) μ := by
    have := hmLp.integrable_norm_pow (by omega)
    simpa [Real.norm_of_nonneg (hm0 _)] using this
  have hmeas : ∀ j ∈ s, AEStronglyMeasurable (f j) μ := fun j hj => (hf j hj).aestronglyMeasurable
  -- the products and their absolute versions
  let P : (Fin r → ι × ι) → X → 𝕜 := fun i x => ∏ q, inner 𝕜 (f (i q).1 x) (f (i q).2 x)
  let Q : (Fin r → ι × ι) → X → ℝ := fun i x => ∏ q, ‖f (i q).1 x‖ * ‖f (i q).2 x‖
  have hT : ∀ i ∈ T, ∀ q, (i q).1 ∈ s ∧ (i q).2 ∈ s := fun i hi q =>
    mem_product.1 (Fintype.mem_piFinset.1 hi q)
  have hQm : ∀ i ∈ T, ∀ x, Q i x ≤ m x ^ (2 * r) := by
    intro i hi x
    calc Q i x ≤ ∏ _q : Fin r, m x * m x :=
          prod_le_prod₀ (fun q _ => mul_nonneg (norm_nonneg _) (norm_nonneg _))
            fun q _ => mul_le_mul (hfm _ (hT i hi q).1 x) (hfm _ (hT i hi q).2 x)
              (norm_nonneg _) (hm0 x)
      _ = m x ^ (2 * r) := by
          rw [prod_const, card_univ, Fintype.card_fin, ← pow_two, ← pow_mul]
  have hPQ : ∀ i x, ‖P i x‖ ≤ Q i x := by
    intro i x
    refine (Finset.norm_prod_le _ _).trans (prod_le_prod₀ (fun q _ => norm_nonneg _)
      fun q _ => norm_inner_le_norm _ _)
  have hQ0 : ∀ i x, 0 ≤ Q i x := fun i x =>
    prod_nonneg fun q _ => mul_nonneg (norm_nonneg _) (norm_nonneg _)
  have hPint : ∀ i ∈ T, Integrable (P i) μ := by
    intro i hi
    refine hmint.mono' ?_ (ae_of_all _ fun x => (hPQ i x).trans (hQm i hi x))
    exact Finset.aestronglyMeasurable_fun_prod _ fun q _ =>
      (hmeas _ (hT i hi q).1).inner (hmeas _ (hT i hi q).2)
  have hQint : ∀ i ∈ T, Integrable (Q i) μ := by
    intro i hi
    refine hmint.mono' ?_ (ae_of_all _ fun x => ?_)
    · exact Finset.aestronglyMeasurable_fun_prod _ fun q _ =>
        (hmeas _ (hT i hi q).1).norm.mul (hmeas _ (hT i hi q).2).norm
    · rw [Real.norm_of_nonneg (hQ0 i x)]; exact hQm i hi x
  have hgint : Integrable (fun x => (∑ i ∈ s, ‖f i x‖ ^ 2) ^ r) μ := by
    refine hmint.mono' ?_ (ae_of_all _ fun x => ?_)
    · exact ((Finset.aestronglyMeasurable_fun_sum s fun i hi => (hmeas i hi).norm.pow 2).pow r)
    · have h0 : 0 ≤ ∑ i ∈ s, ‖f i x‖ ^ 2 := sum_nonneg fun _ _ => sq_nonneg _
      rw [Real.norm_of_nonneg (pow_nonneg h0 _), pow_mul]
      refine pow_le_pow_left₀ h0 ?_ r
      calc ∑ i ∈ s, ‖f i x‖ ^ 2 ≤ ∑ i ∈ s, ‖f i x‖ * m x :=
            sum_le_sum fun i hi => by
              rw [pow_two]; exact mul_le_mul_of_nonneg_left (hfm i hi x) (norm_nonneg _)
        _ = m x ^ 2 := by rw [← sum_mul, pow_two]
  -- the expansion
  have hexp : ∀ x, ‖∑ i ∈ s, f i x‖ ^ (2 * r) = RCLike.re (∑ i ∈ T, P i x) := by
    intro x
    rw [← superorth_norm_pow_expand (𝕜 := 𝕜) s (fun i => f i x) r, RCLike.ofReal_re]
  have hsumint : Integrable (fun x => ∑ i ∈ T, P i x) μ := integrable_finsetSum _ hPint
  set NS := T.filter fun i => ¬ ∃ v, #{q | (i q).1 = v} + #{q | (i q).2 = v} = 1
  have h1 : ∫ x, ‖∑ i ∈ s, f i x‖ ^ (2 * r) ∂μ = ∑ i ∈ NS, RCLike.re (∫ x, P i x ∂μ) := by
    simp_rw [hexp]
    rw [integral_re hsumint, integral_finsetSum _ hPint, map_sum,
      ← sum_filter_add_sum_filter_not T
        (fun i => ∃ v, #{q | (i q).1 = v} + #{q | (i q).2 = v} = 1)]
    rw [sum_eq_zero (s := T.filter _) fun i hi => by
      rw [mem_filter] at hi
      rw [hvan i (hT i hi.1) hi.2, map_zero], zero_add]
  have h2 : ∀ i ∈ NS, RCLike.re (∫ x, P i x ∂μ) ≤ ∫ x, Q i x ∂μ := by
    intro i hi
    have hiT := (mem_filter.1 hi).1
    calc RCLike.re (∫ x, P i x ∂μ) ≤ ‖∫ x, P i x ∂μ‖ := RCLike.re_le_norm _
      _ ≤ ∫ x, ‖P i x‖ ∂μ := norm_integral_le_integral_norm _
      _ ≤ ∫ x, Q i x ∂μ := integral_mono (hPint i hiT).norm (hQint i hiT) (hPQ i)
  calc ∫ x, ‖∑ i ∈ s, f i x‖ ^ (2 * r) ∂μ ≤ ∑ i ∈ NS, ∫ x, Q i x ∂μ := by
        rw [h1]; exact sum_le_sum h2
    _ = ∫ x, ∑ i ∈ NS, Q i x ∂μ :=
        (integral_finsetSum _ fun i hi => hQint i (mem_filter.1 hi).1).symm
    _ ≤ ∫ x, ((r + 1) * r ^ (2 * r) : ℝ) * (∑ i ∈ s, ‖f i x‖ ^ 2) ^ r ∂μ := by
        refine integral_mono (integrable_finsetSum _ fun i hi => hQint i (mem_filter.1 hi).1)
          (hgint.const_mul _) fun x => ?_
        exact superorth_comb s (fun i => ‖f i x‖) (fun i => norm_nonneg _) r
    _ = _ := integral_const_mul _ _


/-- Blueprint Lemma 7.2 (`lem:superorth`), first assertion. Let `f_i : X → H` (`i ∈ s`, `s`
finite) be finitely many functions with values in a real or complex inner product space `H`,
each in `L^{2r}(μ)`. Suppose that every integral `∫ ∏_{q<r} ⟪f_{i_q}, f_{i'_q}⟫ dμ` vanishes
whenever some index occurs exactly once among the `2r` indices `i_0, i'_0, …, i_{r-1}, i'_{r-1}`
(an `r`-tuple of index pairs `((i_q, i'_q))_q`). Then
`‖∑_{i∈s} f_i‖_{2r} ≤ C_r ‖(∑_{i∈s} ‖f_i‖²)^{1/2}‖_{2r}` with `C_r = 2r`. -/
theorem superorth_singleton {ι : Type*} [DecidableEq ι] {r : ℕ} (s : Finset ι)
    (f : ι → X → H) (hf : ∀ i ∈ s, MemLp (f i) (ENNReal.ofReal (2 * r)) μ)
    (hvan : ∀ i : Fin r → ι × ι, (∀ q, (i q).1 ∈ s ∧ (i q).2 ∈ s) →
      (∃ v, #{q | (i q).1 = v} + #{q | (i q).2 = v} = 1) →
        ∫ x, ∏ q, inner 𝕜 (f (i q).1 x) (f (i q).2 x) ∂μ = 0) :
    eLpNorm (∑ i ∈ s, f i) (ENNReal.ofReal (2 * r)) μ ≤
      (2 * r : ℝ≥0∞) * eLpNorm (fun x => Real.sqrt (∑ i ∈ s, ‖f i x‖ ^ 2))
        (ENNReal.ofReal (2 * r)) μ := by
  rcases Nat.eq_zero_or_pos r with rfl | hr
  · have hm : AEStronglyMeasurable (∑ i ∈ s, f i) μ :=
      Finset.aestronglyMeasurable_sum s fun i hi => (hf i hi).aestronglyMeasurable
    simp [eLpNorm_exponent_zero hm]
  have hp : ENNReal.ofReal (2 * r) = ((2 * r : ℕ) : ℝ≥0∞) := by
    rw [← ENNReal.ofReal_natCast]; congr 1; push_cast; ring
  have hp0 : (0 : ℝ) < 2 * r := by positivity
  have hf' : ∀ i ∈ s, MemLp (f i) ((2 * r : ℕ) : ℝ≥0∞) μ := fun i hi => hp ▸ hf i hi
  have hmeas : ∀ j ∈ s, AEStronglyMeasurable (f j) μ :=
    fun j hj => (hf j hj).aestronglyMeasurable
  have hFLp : MemLp (fun x => ∑ i ∈ s, f i x) ((2 * r : ℕ) : ℝ≥0∞) μ := memLp_finsetSum s hf'
  have hFint := hFLp.integrable_norm_pow (by omega)
  have hmain := superorth_singleton_integral_le (𝕜 := 𝕜) s f hf' hvan
  set C : ℝ := (r + 1) * r ^ (2 * r)
  set g : X → ℝ := fun x => ∑ i ∈ s, ‖f i x‖ ^ 2
  have hg0 : ∀ x, 0 ≤ g x := fun x => sum_nonneg fun _ _ => sq_nonneg _
  have hsum : (∑ i ∈ s, f i) = fun x => ∑ i ∈ s, f i x := by ext x; simp
  have hsqm : AEStronglyMeasurable (fun x => Real.sqrt (∑ i ∈ s, ‖f i x‖ ^ 2)) μ :=
    Real.continuous_sqrt.comp_aestronglyMeasurable
      (Finset.aestronglyMeasurable_fun_sum s fun i hi => (hmeas i hi).norm.pow 2)
  rw [hsum, eLpNorm_ofReal_eq_lintegral hFLp.aestronglyMeasurable hp0,
    eLpNorm_ofReal_eq_lintegral hsqm hp0]
  have hpow : ∀ y : ℝ, 0 ≤ y → ENNReal.ofReal y ^ (2 * r : ℝ) = ENNReal.ofReal (y ^ (2 * r)) := by
    intro y hy
    rw [ENNReal.ofReal_rpow_of_nonneg hy hp0.le, show (2 * r : ℝ) = ((2 * r : ℕ) : ℝ) by
      push_cast; ring, Real.rpow_natCast]
  have hL : ∫⁻ x, ‖∑ i ∈ s, f i x‖ₑ ^ (2 * r : ℝ) ∂μ =
      ENNReal.ofReal (∫ x, ‖∑ i ∈ s, f i x‖ ^ (2 * r) ∂μ) := by
    rw [ofReal_integral_eq_lintegral_ofReal hFint (ae_of_all _ fun x => by positivity)]
    refine lintegral_congr fun x => ?_
    rw [← ofReal_norm, hpow _ (norm_nonneg _)]
  have hR : ENNReal.ofReal (∫ x, g x ^ r ∂μ) ≤
      ∫⁻ x, ‖Real.sqrt (g x)‖ₑ ^ (2 * r : ℝ) ∂μ := by
    calc ENNReal.ofReal (∫ x, g x ^ r ∂μ) ≤ ‖∫ x, g x ^ r ∂μ‖ₑ := by
          rw [Real.enorm_eq_ofReal_abs]; exact ENNReal.ofReal_le_ofReal (le_abs_self _)
      _ ≤ ∫⁻ x, ‖g x ^ r‖ₑ ∂μ := enorm_integral_le_lintegral_enorm _
      _ = _ := by
          refine lintegral_congr fun x => ?_
          rw [← ofReal_norm, ← ofReal_norm, hpow _ (norm_nonneg _),
            Real.norm_of_nonneg (pow_nonneg (hg0 x) _),
            Real.norm_of_nonneg (Real.sqrt_nonneg _), pow_mul, Real.sq_sqrt (hg0 x)]
  have hlint : ∫⁻ x, ‖∑ i ∈ s, f i x‖ₑ ^ (2 * r : ℝ) ∂μ ≤
      ENNReal.ofReal C * ∫⁻ x, ‖Real.sqrt (g x)‖ₑ ^ (2 * r : ℝ) ∂μ := by
    rw [hL]
    calc ENNReal.ofReal (∫ x, ‖∑ i ∈ s, f i x‖ ^ (2 * r) ∂μ)
        ≤ ENNReal.ofReal (C * ∫ x, g x ^ r ∂μ) := ENNReal.ofReal_le_ofReal hmain
      _ = ENNReal.ofReal C * ENNReal.ofReal (∫ x, g x ^ r ∂μ) :=
          ENNReal.ofReal_mul (by positivity)
      _ ≤ _ := by gcongr
  have hC : ENNReal.ofReal C ^ (1 / (2 * r : ℝ)) ≤ (2 * r : ℝ≥0∞) := by
    have h1 : (r + 1 : ℕ) ≤ 2 ^ (2 * r) :=
      (Nat.lt_two_pow_self).le.trans (Nat.pow_le_pow_right (by norm_num) (by omega))
    have h2 : C ≤ (2 * r : ℝ) ^ (2 * r) := by
      have h1' : (r + 1 : ℝ) ≤ 2 ^ (2 * r) := by exact_mod_cast h1
      rw [mul_pow]
      exact mul_le_mul_of_nonneg_right h1' (by positivity)
    calc ENNReal.ofReal C ^ (1 / (2 * r : ℝ))
        ≤ ENNReal.ofReal ((2 * r : ℝ) ^ (2 * r)) ^ (1 / (2 * r : ℝ)) :=
          ENNReal.rpow_le_rpow (ENNReal.ofReal_le_ofReal h2) (by positivity)
      _ = (2 * r : ℝ≥0∞) := by
          rw [← hpow _ hp0.le, ← ENNReal.rpow_mul, mul_one_div_cancel hp0.ne', ENNReal.rpow_one,
            ENNReal.ofReal_mul (by norm_num), ENNReal.ofReal_natCast]
          simp
  calc (∫⁻ x, ‖∑ i ∈ s, f i x‖ₑ ^ (2 * r : ℝ) ∂μ) ^ (1 / (2 * r : ℝ))
      ≤ (ENNReal.ofReal C * ∫⁻ x, ‖Real.sqrt (g x)‖ₑ ^ (2 * r : ℝ) ∂μ) ^ (1 / (2 * r : ℝ)) :=
        ENNReal.rpow_le_rpow hlint (by positivity)
    _ = ENNReal.ofReal C ^ (1 / (2 * r : ℝ)) *
          (∫⁻ x, ‖Real.sqrt (g x)‖ₑ ^ (2 * r : ℝ) ∂μ) ^ (1 / (2 * r : ℝ)) :=
        ENNReal.mul_rpow_of_nonneg _ _ (by positivity)
    _ ≤ _ := by gcongr


/-- Splitting a sum over `piFinset S` for `(l+1)`-tuples into the first coordinate and the tail
(helper for Blueprint Lemma 7.2 (`lem:superorth`)). -/
lemma superorth_sum_piFinset_succ {ι M : Type*} [AddCommMonoid M] {l : ℕ}
    (S : Fin (l + 1) → Finset ι) (φ : (Fin (l + 1) → ι) → M) :
    ∑ a ∈ Fintype.piFinset S, φ a =
      ∑ a0 ∈ S 0, ∑ a' ∈ Fintype.piFinset (fun j : Fin l => S j.succ), φ (Fin.cons a0 a') := by
  classical
  have h := Finset.filter_piFinset_eq_map_consEquiv S (fun _ => True)
  simp only [filter_true_of_mem (fun _ _ => trivial)] at h
  rw [h, sum_map, sum_product]
  rfl

/-- Integrability of the products `∏_q ⟪f_{i_q}, f_{i'_q}⟫` of `2r` functions in `L^{2r}`
(helper for Blueprint Lemma 7.2 (`lem:superorth`)). -/
lemma superorth_integrable_prod {ι : Type*} {r : ℕ} (hr : 0 < r) (s : Finset ι)
    (f : ι → X → H) (hf : ∀ i ∈ s, MemLp (f i) (ENNReal.ofReal (2 * r)) μ)
    (i : Fin r → ι × ι) (hi : ∀ q, (i q).1 ∈ s ∧ (i q).2 ∈ s) :
    Integrable (fun x => ∏ q, inner 𝕜 (f (i q).1 x) (f (i q).2 x)) μ := by
  have hp : ENNReal.ofReal (2 * r) = ((2 * r : ℕ) : ℝ≥0∞) := by
    rw [← ENNReal.ofReal_natCast]; congr 1; push_cast; ring
  let m : X → ℝ := fun x => ∑ j ∈ s, ‖f j x‖
  have hm0 : ∀ x, 0 ≤ m x := fun x => sum_nonneg fun j _ => norm_nonneg _
  have hfm : ∀ j ∈ s, ∀ x, ‖f j x‖ ≤ m x := fun j hj x =>
    single_le_sum (f := fun j => ‖f j x‖) (fun j _ => norm_nonneg _) hj
  have hmLp : MemLp m ((2 * r : ℕ) : ℝ≥0∞) μ :=
    memLp_finsetSum s fun j hj => (hp ▸ hf j hj).norm
  have hmint : Integrable (fun x => m x ^ (2 * r)) μ := by
    have := hmLp.integrable_norm_pow (by omega)
    simpa [Real.norm_of_nonneg (hm0 _)] using this
  refine hmint.mono' ?_ (ae_of_all _ fun x => ?_)
  · exact Finset.aestronglyMeasurable_fun_prod _ fun q _ =>
      (hf _ (hi q).1).aestronglyMeasurable.inner (hf _ (hi q).2).aestronglyMeasurable
  · calc ‖∏ q, inner 𝕜 (f (i q).1 x) (f (i q).2 x)‖
        ≤ ∏ q, ‖f (i q).1 x‖ * ‖f (i q).2 x‖ :=
          (Finset.norm_prod_le _ _).trans (prod_le_prod₀ (fun q _ => norm_nonneg _)
            fun q _ => norm_inner_le_norm _ _)
      _ ≤ ∏ _q : Fin r, m x * m x :=
          prod_le_prod₀ (fun q _ => mul_nonneg (norm_nonneg _) (norm_nonneg _))
            fun q _ => mul_le_mul (hfm _ (hi q).1 x) (hfm _ (hi q).2 x)
              (norm_nonneg _) (hm0 x)
      _ = m x ^ (2 * r) := by
          rw [prod_const, card_univ, Fintype.card_fin, ← pow_two, ← pow_mul]

end SuperorthSingleton

section SuperorthMulti

universe u

variable {X : Type*} [MeasurableSpace X] {μ : Measure X} {𝕜 : Type*} [RCLike 𝕜]

/-- Blueprint Lemma 7.2 (`lem:superorth`), iterated form used in the proof of the second
assertion: functions `g_a` indexed by `l`-tuples `a ∈ ∏_j S_j`. If every integral
`∫ ∏_{q<r} ⟪g_{a_q}, g_{a'_q}⟫` vanishes whenever for some coordinate `j` some value occurs
exactly once among the `j`-th coordinates of the `2r` tuples, then
`‖∑_a g_a‖_{2r} ≤ (2r)^l ‖(∑_a ‖g_a‖²)^{1/2}‖_{2r}`. -/
theorem superorth_multi {ι : Type u} [DecidableEq ι] {r : ℕ} (hr : 0 < r) :
    ∀ (l : ℕ) (H : Type u) [NormedAddCommGroup H] [InnerProductSpace 𝕜 H]
      (S : Fin l → Finset ι) (g : (Fin l → ι) → X → H),
      (∀ a ∈ Fintype.piFinset S, MemLp (g a) (ENNReal.ofReal (2 * r)) μ) →
      (∀ i : Fin r → (Fin l → ι) × (Fin l → ι),
        (∀ q, (i q).1 ∈ Fintype.piFinset S ∧ (i q).2 ∈ Fintype.piFinset S) →
        (∃ j v, #{q | (i q).1 j = v} + #{q | (i q).2 j = v} = 1) →
          ∫ x, ∏ q, inner 𝕜 (g (i q).1 x) (g (i q).2 x) ∂μ = 0) →
      eLpNorm (∑ a ∈ Fintype.piFinset S, g a) (ENNReal.ofReal (2 * r)) μ ≤
        (2 * r : ℝ≥0∞) ^ l * eLpNorm (fun x => Real.sqrt (∑ a ∈ Fintype.piFinset S, ‖g a x‖ ^ 2))
          (ENNReal.ofReal (2 * r)) μ := by
  intro l
  induction l with
  | zero =>
    intro H _ _ S g hg _
    have hu : Fintype.piFinset S = {Fin.elim0} := by
      ext a; simp only [Fintype.mem_piFinset, mem_singleton]
      exact ⟨fun _ => Subsingleton.elim _ _, fun _ j => j.elim0⟩
    rw [hu, sum_singleton, pow_zero, one_mul]
    simp only [sum_singleton, Real.sqrt_sq (norm_nonneg _)]
    rw [eLpNorm_norm _ (hg _ (hu ▸ mem_singleton_self _)).aestronglyMeasurable]
  | succ l ih =>
    intro H _ _ S g hg hvan
    classical
    set S0 := S 0
    set S' : Fin l → Finset ι := fun j => S j.succ
    have hcons : ∀ a0 ∈ S0, ∀ a' ∈ Fintype.piFinset S', Fin.cons a0 a' ∈ Fintype.piFinset S := by
      intro a0 h0 a' h'
      rw [Fin.mem_piFinset_iff_zero_tail]
      exact ⟨by simpa using h0, by simpa [Fin.tail] using h'⟩
    -- the first-coordinate functions
    let F : ι → X → H := fun a0 x => ∑ a' ∈ Fintype.piFinset S', g (Fin.cons a0 a') x
    -- the vector-valued functions of the tail
    let G : (Fin l → ι) → X → PiLp 2 (fun _ : S0 => H) := fun a' x =>
      WithLp.toLp 2 (fun b : S0 => g (Fin.cons (b : ι) a') x)
    set pS := Fintype.piFinset S
    set pS' := Fintype.piFinset S'
    set p := ENNReal.ofReal (2 * r)
    -- (A) the total sum is the sum of the first-coordinate functions
    have hsumF : (∑ a ∈ pS, g a) = ∑ a0 ∈ S0, F a0 := by
      ext x
      simp only [Finset.sum_apply, F]
      exact superorth_sum_piFinset_succ S (fun a => g a x)
    have hF : ∀ a0 ∈ S0, MemLp (F a0) p μ := fun a0 h0 =>
      memLp_finsetSum _ fun a' h' => hg _ (hcons a0 h0 a' h')
    -- (B) the singleton vanishing for the first-coordinate functions
    have hvanF : ∀ i : Fin r → ι × ι, (∀ q, (i q).1 ∈ S0 ∧ (i q).2 ∈ S0) →
        (∃ v, #{q | (i q).1 = v} + #{q | (i q).2 = v} = 1) →
          ∫ x, ∏ q, inner 𝕜 (F (i q).1 x) (F (i q).2 x) ∂μ = 0 := by
      rintro i hi ⟨v, hv⟩
      have h1 : ∀ x q, inner 𝕜 (F (i q).1 x) (F (i q).2 x) = ∑ t ∈ pS' ×ˢ pS',
          inner 𝕜 (g (Fin.cons (i q).1 t.1) x) (g (Fin.cons (i q).2 t.2) x) := by
        intro x q
        simp only [F]
        rw [sum_inner, sum_product]
        simp_rw [inner_sum]
        rfl
      have h2 : ∀ x, ∏ q, inner 𝕜 (F (i q).1 x) (F (i q).2 x) =
          ∑ τ ∈ Fintype.piFinset (fun _ : Fin r => pS' ×ˢ pS'),
            ∏ q, inner 𝕜 (g (Fin.cons (i q).1 (τ q).1) x) (g (Fin.cons (i q).2 (τ q).2) x) := by
        intro x
        simp_rw [h1 x]
        rw [prod_univ_sum]
      have hmemτ : ∀ τ ∈ Fintype.piFinset (fun _ : Fin r => pS' ×ˢ pS'), ∀ q,
          (Fin.cons (i q).1 (τ q).1 : Fin (l + 1) → ι) ∈ pS ∧
            (Fin.cons (i q).2 (τ q).2 : Fin (l + 1) → ι) ∈ pS := by
        intro τ hτ q
        have hτq := mem_product.1 (Fintype.mem_piFinset.1 hτ q)
        exact ⟨hcons _ (hi q).1 _ hτq.1, hcons _ (hi q).2 _ hτq.2⟩
      simp_rw [h2]
      rw [integral_finsetSum _ fun τ hτ =>
        superorth_integrable_prod hr pS g hg
          (fun q => (Fin.cons (i q).1 (τ q).1, Fin.cons (i q).2 (τ q).2)) (hmemτ τ hτ)]
      refine sum_eq_zero fun τ hτ => hvan
        (fun q => (Fin.cons (i q).1 (τ q).1, Fin.cons (i q).2 (τ q).2)) (hmemτ τ hτ)
        ⟨0, v, by simpa using hv⟩
    have h1 := superorth_singleton (𝕜 := 𝕜) S0 F hF hvanF
    -- (C) the vector-valued functions
    have hGrep : ∀ a' x, G a' x = ∑ b : S0, PiLp.single 2 b (g (Fin.cons (b : ι) a') x) := by
      intro a' x
      rw [WithLp.ext_iff]
      ext c
      simp [G, PiLp.ofLp_single, Pi.single_apply]
    have hGmeas : ∀ a' ∈ pS', AEStronglyMeasurable (G a') μ := by
      intro a' h'
      have : G a' = fun x => ∑ b : S0, PiLp.single 2 b (g (Fin.cons (b : ι) a') x) := by
        ext1 x; exact hGrep a' x
      rw [this]
      refine Finset.aestronglyMeasurable_fun_sum _ fun b _ => ?_
      have hc : Continuous fun y : H => PiLp.single 2 (β := fun _ : S0 => H) b y :=
        (PiLp.continuous_toLp 2 (fun _ : S0 => H)).comp (continuous_single (A := fun _ : S0 => H) b)
      exact hc.comp_aestronglyMeasurable (hg _ (hcons _ b.2 _ h')).aestronglyMeasurable
    have hG : ∀ a' ∈ pS', MemLp (G a') p μ := by
      intro a' h'
      have hm : MemLp (fun x => ∑ b : S0, ‖g (Fin.cons (b : ι) a') x‖) p μ :=
        memLp_finsetSum univ fun b _ => (hg _ (hcons _ b.2 _ h')).norm
      refine MemLp.of_le hm (hGmeas a' h') (ae_of_all _ fun x => ?_)
      rw [hGrep, Real.norm_of_nonneg (sum_nonneg fun _ _ => norm_nonneg _)]
      refine (norm_sum_le _ _).trans (le_of_eq ?_)
      simp [PiLp.norm_single]
    -- (D) the singleton vanishing for the vector-valued functions
    have hvanG : ∀ i : Fin r → (Fin l → ι) × (Fin l → ι),
        (∀ q, (i q).1 ∈ pS' ∧ (i q).2 ∈ pS') →
        (∃ j v, #{q | (i q).1 j = v} + #{q | (i q).2 j = v} = 1) →
          ∫ x, ∏ q, inner 𝕜 (G (i q).1 x) (G (i q).2 x) ∂μ = 0 := by
      rintro i hi ⟨j, v, hv⟩
      have h2 : ∀ x, ∏ q, inner 𝕜 (G (i q).1 x) (G (i q).2 x) =
          ∑ σ ∈ Fintype.piFinset (fun _ : Fin r => (univ : Finset S0)),
            ∏ q, inner 𝕜 (g (Fin.cons (σ q : ι) (i q).1) x)
              (g (Fin.cons (σ q : ι) (i q).2) x) := by
        intro x
        simp only [G, PiLp.inner_apply]
        rw [prod_univ_sum]
      have hmemσ : ∀ σ : Fin r → S0, ∀ q,
          (Fin.cons (σ q : ι) (i q).1 : Fin (l + 1) → ι) ∈ pS ∧
            (Fin.cons (σ q : ι) (i q).2 : Fin (l + 1) → ι) ∈ pS := fun σ q =>
        ⟨hcons _ (σ q).2 _ (hi q).1, hcons _ (σ q).2 _ (hi q).2⟩
      simp_rw [h2]
      rw [integral_finsetSum _ fun σ _ =>
        superorth_integrable_prod hr pS g hg
          (fun q => (Fin.cons (σ q : ι) (i q).1, Fin.cons (σ q : ι) (i q).2)) (hmemσ σ)]
      refine sum_eq_zero fun σ _ => hvan
        (fun q => (Fin.cons (σ q : ι) (i q).1, Fin.cons (σ q : ι) (i q).2)) (hmemσ σ)
        ⟨j.succ, v, by simpa using hv⟩
    have h2 := ih (PiLp 2 (fun _ : S0 => H)) S' G hG hvanG
    -- (E) the square functions
    have hsq1 : (fun x => Real.sqrt (∑ a0 ∈ S0, ‖F a0 x‖ ^ 2)) =
        fun x => ‖(∑ a' ∈ pS', G a') x‖ := by
      ext x
      rw [PiLp.norm_eq_of_L2, ← sum_coe_sort S0 (fun a0 => ‖F a0 x‖ ^ 2)]
      congr 1
      refine sum_congr rfl fun c _ => ?_
      simp [G, F, Finset.sum_apply]
      rfl
    have hsq2 : ∀ x, ∑ a' ∈ pS', ‖G a' x‖ ^ 2 = ∑ a ∈ pS, ‖g a x‖ ^ 2 := by
      intro x
      rw [superorth_sum_piFinset_succ S (fun a => ‖g a x‖ ^ 2), sum_comm]
      refine sum_congr rfl fun a' _ => ?_
      rw [PiLp.norm_sq_eq_of_L2, ← sum_coe_sort S0 (fun a0 => ‖g (Fin.cons a0 a') x‖ ^ 2)]
    have hGsum_meas : AEStronglyMeasurable (∑ a' ∈ pS', G a') μ :=
      Finset.aestronglyMeasurable_sum _ fun a' h' => hGmeas a' h'
    rw [hsumF]
    calc eLpNorm (∑ a0 ∈ S0, F a0) p μ
        ≤ (2 * r : ℝ≥0∞) * eLpNorm (fun x => Real.sqrt (∑ a0 ∈ S0, ‖F a0 x‖ ^ 2)) p μ := h1
      _ = (2 * r : ℝ≥0∞) * eLpNorm (∑ a' ∈ pS', G a') p μ := by
          rw [hsq1, eLpNorm_norm _ hGsum_meas]
      _ ≤ (2 * r : ℝ≥0∞) * ((2 * r : ℝ≥0∞) ^ l *
            eLpNorm (fun x => Real.sqrt (∑ a' ∈ pS', ‖G a' x‖ ^ 2)) p μ) := by gcongr
      _ = (2 * r : ℝ≥0∞) ^ (l + 1) *
            eLpNorm (fun x => Real.sqrt (∑ a ∈ pS, ‖g a x‖ ^ 2)) p μ := by
          simp_rw [hsq2]; rw [pow_succ]; ring


/-- Blueprint Lemma 7.2 (`lem:superorth`), second assertion for sets of one fixed cardinality `l`
(via random colorings, done as an exact finite average over all colorings `U → Fin l`):
`‖∑_{A ⊆ U, #A = l} f_A‖_{2r} ≤ (2rl)^l ‖(∑_{A ⊆ U, #A = l} ‖f_A‖²)^{1/2}‖_{2r}`. -/
theorem superorth_card {υ : Type u} [DecidableEq υ] {H : Type u} [NormedAddCommGroup H]
    [InnerProductSpace 𝕜 H] {r : ℕ} (hr : 0 < r) (l : ℕ) (U : Finset υ)
    (f : Finset υ → X → H)
    (hf : ∀ A ∈ U.powersetCard l, MemLp (f A) (ENNReal.ofReal (2 * r)) μ)
    (hvan : ∀ A : Fin r → Finset υ × Finset υ,
      (∀ q, (A q).1 ∈ U.powersetCard l ∧ (A q).2 ∈ U.powersetCard l) →
      (∃ u, #{q | u ∈ (A q).1} + #{q | u ∈ (A q).2} = 1) →
        ∫ x, ∏ q, inner 𝕜 (f (A q).1 x) (f (A q).2 x) ∂μ = 0) :
    eLpNorm (∑ A ∈ U.powersetCard l, f A) (ENNReal.ofReal (2 * r)) μ ≤
      (2 * r * l : ℝ≥0∞) ^ l * eLpNorm (fun x => Real.sqrt (∑ A ∈ U.powersetCard l, ‖f A x‖ ^ 2))
        (ENNReal.ofReal (2 * r)) μ := by
  classical
  set p := ENNReal.ofReal (2 * r)
  set 𝒜 := U.powersetCard l
  have hsqm : AEStronglyMeasurable (fun x => Real.sqrt (∑ A ∈ 𝒜, ‖f A x‖ ^ 2)) μ :=
    Real.continuous_sqrt.comp_aestronglyMeasurable
      (Finset.aestronglyMeasurable_fun_sum _ fun A hA => (hf A hA).aestronglyMeasurable.norm.pow 2)
  rcases Nat.eq_zero_or_pos l with rfl | hl
  · have h0 : 𝒜 = {∅} := powersetCard_zero U
    simp only [h0, sum_singleton, pow_zero, one_mul, Real.sqrt_sq (norm_nonneg _)]
    rw [eLpNorm_norm _ (hf ∅ (by simp [h0])).aestronglyMeasurable]
  by_cases hUl : l ≤ #U
  swap
  · have h0 : 𝒜 = ∅ := powersetCard_eq_empty.2 (not_le.1 hUl)
    simp only [h0, sum_empty]
    rw [eLpNorm_zero]; exact zero_le
  -- colorings of `U` with `l` colors
  let z : Fin l := ⟨0, hl⟩
  let col : (U → Fin l) → υ → Fin l := fun c u => if h : u ∈ U then c ⟨u, h⟩ else z
  let tr : (U → Fin l) → Finset υ → Prop := fun c A => ∀ j, ∃ u ∈ A, col c u = j
  let T : Finset υ → ℕ := fun A => #{c : U → Fin l | tr c A}
  set Tmin := l ^ (#U - l) with hTmin
  -- every `l`-set is transversal for at least `l ^ (#U - l)` colorings
  have hT : ∀ A ∈ 𝒜, Tmin ≤ T A := by
    intro A hA
    obtain ⟨hAU, hAl⟩ := mem_powersetCard.1 hA
    let e : A ≃ Fin l := A.equivFin.trans (finCongr hAl)
    let ext : ((U \ A : Finset υ) → Fin l) → (U → Fin l) := fun d u =>
      if h : (u : υ) ∈ A then e ⟨u, h⟩ else d ⟨u, mem_sdiff.2 ⟨u.2, h⟩⟩
    have hext_inj : Function.Injective ext := by
      intro d d' hdd
      funext w
      have hw := mem_sdiff.1 w.2
      have := congrFun hdd ⟨w, hw.1⟩
      simp only [ext, dite_eq_right hw.2] at this
      exact this
    have hext_tr : ∀ d, tr (ext d) A := by
      intro d j
      refine ⟨e.symm j, (e.symm j).2, ?_⟩
      have hU : ((e.symm j : A) : υ) ∈ U := hAU (e.symm j).2
      simp only [col, dite_eq_left hU, ext, dite_eq_left (e.symm j).2]
      simp
    calc Tmin = Fintype.card ((U \ A : Finset υ) → Fin l) := by
          rw [Fintype.card_fun, Fintype.card_fin, Fintype.card_coe, card_sdiff_of_subset hAU, hAl]
      _ = #((univ : Finset ((U \ A : Finset υ) → Fin l)).image ext) := by
          rw [card_image_of_injective _ hext_inj, card_univ]
      _ ≤ T A := by
          refine card_le_card fun c hc => ?_
          obtain ⟨d, -, rfl⟩ := mem_image.1 hc
          exact mem_filter.2 ⟨mem_univ _, hext_tr d⟩
  have hTpos : 0 < Tmin := pow_pos hl _
  have hTA0 : ∀ A ∈ 𝒜, (T A : 𝕜) ≠ 0 := fun A hA => by
    have := (hTpos.trans_le (hT A hA)).ne'
    exact_mod_cast this
  -- the average over colorings
  have hid : (∑ A ∈ 𝒜, f A) =
      ∑ c : U → Fin l, ∑ A ∈ 𝒜 with tr c A, fun x => (T A : 𝕜)⁻¹ • f A x := by
    ext x
    simp only [Finset.sum_apply]
    simp_rw [sum_filter]
    rw [sum_comm]
    refine sum_congr rfl fun A hA => ?_
    rw [← sum_filter, sum_const, ← Nat.cast_smul_eq_nsmul 𝕜, smul_smul,
      mul_inv_cancel₀ (hTA0 A hA), one_smul]
  -- the bound for a fixed coloring
  set E := eLpNorm (fun x => Real.sqrt (∑ A ∈ 𝒜, ‖f A x‖ ^ 2)) p μ
  have hc : ∀ c : U → Fin l,
      eLpNorm (∑ A ∈ 𝒜 with tr c A, fun x => (T A : 𝕜)⁻¹ • f A x) p μ ≤
        (2 * r : ℝ≥0∞) ^ l * ((Tmin : ℝ≥0∞)⁻¹ * E) := by
    intro c
    let S : Fin l → Finset υ := fun j => U.filter fun u => col c u = j
    let φ : (Fin l → υ) → Finset υ := fun a => univ.image a
    have hS : ∀ a ∈ Fintype.piFinset S, ∀ j, a j ∈ U ∧ col c (a j) = j := fun a ha j =>
      mem_filter.1 (Fintype.mem_piFinset.1 ha j)
    have hinjS : ∀ a ∈ Fintype.piFinset S, Function.Injective a := by
      intro a ha j j₂ hjj
      rw [← (hS a ha j).2, ← (hS a ha j₂).2, hjj]
    have hφmem : ∀ a ∈ Fintype.piFinset S, φ a ∈ 𝒜 ∧ tr c (φ a) := by
      intro a ha
      refine ⟨mem_powersetCard.2 ⟨fun u hu => ?_, ?_⟩,
        fun j => ⟨a j, mem_image_of_mem _ (mem_univ j), (hS a ha j).2⟩⟩
      · obtain ⟨j, -, rfl⟩ := mem_image.1 hu; exact (hS a ha j).1
      · rw [card_image_of_injective _ (hinjS a ha), card_univ, Fintype.card_fin]
    have hφinj : Set.InjOn φ (Fintype.piFinset S) := by
      intro a ha b hb hab
      funext j
      have hj : a j ∈ φ b := hab ▸ mem_image_of_mem _ (mem_univ j)
      obtain ⟨j₂, -, hj₂⟩ := mem_image.1 hj
      have : j₂ = j := by rw [← (hS b hb j₂).2, hj₂, (hS a ha j).2]
      rw [← hj₂, this]
    have himage : (Fintype.piFinset S).image φ = 𝒜.filter (tr c) := by
      ext A
      constructor
      · intro hA
        obtain ⟨a, ha, rfl⟩ := mem_image.1 hA
        exact mem_filter.2 (hφmem a ha)
      · intro hA
        obtain ⟨hA𝒜, htr⟩ := mem_filter.1 hA
        obtain ⟨hAU, hAl⟩ := mem_powersetCard.1 hA𝒜
        choose a ha hac using htr
        have hapi : a ∈ Fintype.piFinset S := Fintype.mem_piFinset.2 fun j =>
          mem_filter.2 ⟨hAU (ha j), hac j⟩
        refine mem_image.2 ⟨a, hapi, ?_⟩
        refine eq_of_subset_of_card_le (fun u hu => ?_) ?_
        · obtain ⟨j, -, rfl⟩ := mem_image.1 hu; exact ha j
        · rw [hAl, card_image_of_injective _ (hinjS a hapi), card_univ, Fintype.card_fin]
    let g : (Fin l → υ) → X → H := fun a x => (T (φ a) : 𝕜)⁻¹ • f (φ a) x
    have hG : (∑ A ∈ 𝒜 with tr c A, fun x => (T A : 𝕜)⁻¹ • f A x) =
        ∑ a ∈ Fintype.piFinset S, g a := by
      rw [← himage, sum_image hφinj]
    have hgm : ∀ a ∈ Fintype.piFinset S, MemLp (g a) p μ := fun a ha =>
      (hf _ (hφmem a ha).1).const_smul _
    have hvang : ∀ i : Fin r → (Fin l → υ) × (Fin l → υ),
        (∀ q, (i q).1 ∈ Fintype.piFinset S ∧ (i q).2 ∈ Fintype.piFinset S) →
        (∃ j v, #{q | (i q).1 j = v} + #{q | (i q).2 j = v} = 1) →
          ∫ x, ∏ q, inner 𝕜 (g (i q).1 x) (g (i q).2 x) ∂μ = 0 := by
      rintro i hi ⟨j, v, hv⟩
      have hvj : col c v = j := by
        by_contra hcon
        have h1 : #({q | (i q).1 j = v} : Finset (Fin r)) = 0 := by
          rw [card_eq_zero, filter_eq_empty_iff]
          intro q _ hq; exact hcon (hq ▸ (hS _ (hi q).1 j).2)
        have h2 : #({q | (i q).2 j = v} : Finset (Fin r)) = 0 := by
          rw [card_eq_zero, filter_eq_empty_iff]
          intro q _ hq; exact hcon (hq ▸ (hS _ (hi q).2 j).2)
        omega
      have key : ∀ a ∈ Fintype.piFinset S, (v ∈ φ a ↔ a j = v) := by
        intro a ha
        constructor
        · intro hv₂
          obtain ⟨j₂, -, hj₂⟩ := mem_image.1 hv₂
          have : j₂ = j := by rw [← (hS a ha j₂).2, hj₂, hvj]
          rw [← this]; exact hj₂
        · intro h; rw [← h]; exact mem_image_of_mem _ (mem_univ j)
      have hB := hvan (fun q => (φ (i q).1, φ (i q).2))
        (fun q => ⟨(hφmem _ (hi q).1).1, (hφmem _ (hi q).2).1⟩) ⟨v, by
          rw [filter_congr (fun q _ => key _ (hi q).1), filter_congr (fun q _ => key _ (hi q).2)]
          exact hv⟩
      have hprod : ∀ x, ∏ q, inner 𝕜 (g (i q).1 x) (g (i q).2 x) =
          (∏ q, (starRingEnd 𝕜 ((T (φ (i q).1) : 𝕜)⁻¹) * (T (φ (i q).2) : 𝕜)⁻¹)) *
            ∏ q, inner 𝕜 (f (φ (i q).1) x) (f (φ (i q).2) x) := by
        intro x
        rw [← prod_mul_distrib]
        refine prod_congr rfl fun q _ => ?_
        simp only [g, inner_smul_left, inner_smul_right]
        ring
      simp_rw [hprod]
      rw [integral_const_mul, hB, mul_zero]
    have hmain := superorth_multi (μ := μ) (𝕜 := 𝕜) hr l H S g hgm hvang
    have hgsqm : AEStronglyMeasurable
        (fun x => Real.sqrt (∑ a ∈ Fintype.piFinset S, ‖g a x‖ ^ 2)) μ :=
      Real.continuous_sqrt.comp_aestronglyMeasurable
        (Finset.aestronglyMeasurable_fun_sum _ fun a ha =>
          (hgm a ha).aestronglyMeasurable.norm.pow 2)
    have hTmin0 : (0 : ℝ) < Tmin := by exact_mod_cast hTpos
    have hpt : ∀ x, ‖Real.sqrt (∑ a ∈ Fintype.piFinset S, ‖g a x‖ ^ 2)‖ ≤
        (Tmin : ℝ)⁻¹ * Real.sqrt (∑ A ∈ 𝒜, ‖f A x‖ ^ 2) := by
      intro x
      rw [Real.norm_of_nonneg (Real.sqrt_nonneg _)]
      have h1 : ∑ a ∈ Fintype.piFinset S, ‖g a x‖ ^ 2 ≤
          ((Tmin : ℝ)⁻¹) ^ 2 * ∑ A ∈ 𝒜, ‖f A x‖ ^ 2 := by
        have h2 : ∑ a ∈ Fintype.piFinset S, ‖g a x‖ ^ 2 =
            ∑ A ∈ 𝒜 with tr c A, ‖(T A : 𝕜)⁻¹ • f A x‖ ^ 2 := by
          rw [← himage, sum_image hφinj]
        rw [h2, mul_sum]
        calc ∑ A ∈ 𝒜 with tr c A, ‖(T A : 𝕜)⁻¹ • f A x‖ ^ 2
            ≤ ∑ A ∈ 𝒜 with tr c A, ((Tmin : ℝ)⁻¹) ^ 2 * ‖f A x‖ ^ 2 := by
              refine sum_le_sum fun A hA => ?_
              have hA𝒜 := (mem_filter.1 hA).1
              rw [norm_smul, mul_pow, norm_inv, RCLike.norm_natCast]
              refine mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (by positivity) ?_ 2)
                (sq_nonneg _)
              exact inv_anti₀ hTmin0 (by exact_mod_cast hT A hA𝒜)
          _ ≤ ∑ A ∈ 𝒜, ((Tmin : ℝ)⁻¹) ^ 2 * ‖f A x‖ ^ 2 :=
              sum_le_sum_of_subset_of_nonneg (filter_subset _ _) fun _ _ _ => by positivity
      calc Real.sqrt (∑ a ∈ Fintype.piFinset S, ‖g a x‖ ^ 2)
          ≤ Real.sqrt (((Tmin : ℝ)⁻¹) ^ 2 * ∑ A ∈ 𝒜, ‖f A x‖ ^ 2) := Real.sqrt_le_sqrt h1
        _ = (Tmin : ℝ)⁻¹ * Real.sqrt (∑ A ∈ 𝒜, ‖f A x‖ ^ 2) := by
          rw [Real.sqrt_mul (by positivity), Real.sqrt_sq (by positivity)]
    have hE : eLpNorm (fun x => Real.sqrt (∑ a ∈ Fintype.piFinset S, ‖g a x‖ ^ 2)) p μ ≤
        (Tmin : ℝ≥0∞)⁻¹ * E := by
      calc _ ≤ eLpNorm (fun x => (Tmin : ℝ)⁻¹ * Real.sqrt (∑ A ∈ 𝒜, ‖f A x‖ ^ 2)) p μ :=
            eLpNorm_mono_real hgsqm hpt
        _ = (Tmin : ℝ≥0∞)⁻¹ * E := by
            have h := eLpNorm_const_smul ((Tmin : ℝ)⁻¹)
              (fun x => Real.sqrt (∑ A ∈ 𝒜, ‖f A x‖ ^ 2)) p μ
            have h' : ((Tmin : ℝ)⁻¹ • fun x => Real.sqrt (∑ A ∈ 𝒜, ‖f A x‖ ^ 2)) =
                fun x => (Tmin : ℝ)⁻¹ * Real.sqrt (∑ A ∈ 𝒜, ‖f A x‖ ^ 2) := by
              ext x; simp
            rw [← h', h]
            congr 1
            rw [enorm_inv (by positivity), Real.enorm_natCast]
    rw [hG]
    calc _ ≤ _ := hmain
      _ ≤ (2 * r : ℝ≥0∞) ^ l * ((Tmin : ℝ≥0∞)⁻¹ * E) := by gcongr
  have hp1 : 1 ≤ p := by
    rw [ENNReal.one_le_ofReal]
    have : (1 : ℝ) ≤ r := by exact_mod_cast hr
    linarith
  rw [hid]
  calc eLpNorm (∑ c : U → Fin l, ∑ A ∈ 𝒜 with tr c A, fun x => (T A : 𝕜)⁻¹ • f A x) p μ
      ≤ ∑ c : U → Fin l, eLpNorm (∑ A ∈ 𝒜 with tr c A, fun x => (T A : 𝕜)⁻¹ • f A x) p μ :=
        eLpNorm_sum_le hp1
    _ ≤ ∑ _c : U → Fin l, (2 * r : ℝ≥0∞) ^ l * ((Tmin : ℝ≥0∞)⁻¹ * E) :=
        sum_le_sum fun c _ => hc c
    _ = ((l ^ #U : ℕ) : ℝ≥0∞) * ((2 * r : ℝ≥0∞) ^ l * ((Tmin : ℝ≥0∞)⁻¹ * E)) := by
        rw [sum_const, card_univ, Fintype.card_fun, Fintype.card_fin, Fintype.card_coe,
          nsmul_eq_mul]
    _ = (2 * r * l : ℝ≥0∞) ^ l * E := by
        have h1 : ((l ^ #U : ℕ) : ℝ≥0∞) = (Tmin : ℝ≥0∞) * (l : ℝ≥0∞) ^ l := by
          rw [hTmin, ← Nat.cast_pow, ← Nat.cast_mul, ← pow_add, Nat.sub_add_cancel hUl]
        have h2 : (Tmin : ℝ≥0∞) * (Tmin : ℝ≥0∞)⁻¹ = 1 :=
          ENNReal.mul_inv_cancel (by exact_mod_cast hTpos.ne') (ENNReal.natCast_ne_top _)
        rw [h1, show (2 * r * l : ℝ≥0∞) ^ l = (2 * r : ℝ≥0∞) ^ l * (l : ℝ≥0∞) ^ l from
          mul_pow _ _ _]
        calc (Tmin : ℝ≥0∞) * (l : ℝ≥0∞) ^ l * ((2 * r : ℝ≥0∞) ^ l * ((Tmin : ℝ≥0∞)⁻¹ * E))
            = ((Tmin : ℝ≥0∞) * (Tmin : ℝ≥0∞)⁻¹) *
                ((2 * r : ℝ≥0∞) ^ l * (l : ℝ≥0∞) ^ l * E) := by ring
          _ = _ := by rw [h2, one_mul]


/-- Blueprint Lemma 7.2 (`lem:superorth`), second assertion. Let `U` be a finite set, `k ∈ ℕ`,
and let `f_A : X → H` (`A ⊆ U`, `#A ≤ k`) be functions in `L^{2r}(μ)` with values in a real or
complex inner product space `H`. Suppose that every integral
`∫ ∏_{q<r} ⟪f_{A_q}, f_{A'_q}⟫ dμ` (an `r`-tuple of pairs `(A_q, A'_q)` of such sets) vanishes
whenever some element `u` belongs to exactly one of the `2r` sets `A_0, A'_0, …, A_{r-1}, A'_{r-1}`.
Then `‖∑_A f_A‖_{2r} ≤ C_{k,r} ‖(∑_A ‖f_A‖²)^{1/2}‖_{2r}` (sums over `A ⊆ U`, `#A ≤ k`), with
`C_{k,r} = ∑_{l=0}^{k} (2rl)^l` depending only on `k` and `r`. -/
theorem superorth_subset {υ : Type u} [DecidableEq υ] {H : Type u} [NormedAddCommGroup H]
    [InnerProductSpace 𝕜 H] {r : ℕ} (k : ℕ) (U : Finset υ) (f : Finset υ → X → H)
    (hf : ∀ A ⊆ U, #A ≤ k → MemLp (f A) (ENNReal.ofReal (2 * r)) μ)
    (hvan : ∀ A : Fin r → Finset υ × Finset υ,
      (∀ q, ((A q).1 ⊆ U ∧ #(A q).1 ≤ k) ∧ ((A q).2 ⊆ U ∧ #(A q).2 ≤ k)) →
      (∃ u, #{q | u ∈ (A q).1} + #{q | u ∈ (A q).2} = 1) →
        ∫ x, ∏ q, inner 𝕜 (f (A q).1 x) (f (A q).2 x) ∂μ = 0) :
    eLpNorm (∑ A ∈ U.powerset with #A ≤ k, f A) (ENNReal.ofReal (2 * r)) μ ≤
      (∑ l ∈ range (k + 1), (2 * r * l : ℝ≥0∞) ^ l) *
        eLpNorm (fun x => Real.sqrt (∑ A ∈ U.powerset with #A ≤ k, ‖f A x‖ ^ 2))
          (ENNReal.ofReal (2 * r)) μ := by
  classical
  set P := U.powerset.filter fun A => #A ≤ k
  have hfP : ∀ A ∈ P, MemLp (f A) (ENNReal.ofReal (2 * r)) μ := fun A hA => by
    obtain ⟨h1, h2⟩ := mem_filter.1 hA
    exact hf A (mem_powerset.1 h1) h2
  rcases Nat.eq_zero_or_pos r with rfl | hr
  · have hm : AEStronglyMeasurable (∑ A ∈ P, f A) μ :=
      Finset.aestronglyMeasurable_sum _ fun A hA => (hfP A hA).aestronglyMeasurable
    simp [eLpNorm_exponent_zero hm]
  set p := ENNReal.ofReal (2 * r)
  have hp1 : 1 ≤ p := by
    rw [ENNReal.one_le_ofReal]
    have : (1 : ℝ) ≤ r := by exact_mod_cast hr
    linarith
  have hPl : ∀ l ∈ range (k + 1), ({A ∈ P | #A = l} : Finset (Finset υ)) = U.powersetCard l := by
    intro l hl
    have hl' : l ≤ k := Nat.lt_succ_iff.1 (mem_range.1 hl)
    ext A
    simp only [P, mem_filter, mem_powerset, mem_powersetCard]
    constructor
    · rintro ⟨⟨h1, -⟩, h2⟩; exact ⟨h1, h2⟩
    · rintro ⟨h1, h2⟩; exact ⟨⟨h1, h2 ▸ hl'⟩, h2⟩
  have hsplit : (∑ A ∈ P, f A) = ∑ l ∈ range (k + 1), ∑ A ∈ U.powersetCard l, f A := by
    rw [← sum_fiberwise_of_maps_to (s := P) (t := range (k + 1)) (g := fun A => #A)
      (fun A hA => mem_range.2 (Nat.lt_succ_of_le (mem_filter.1 hA).2))]
    exact sum_congr rfl fun l hl => by rw [hPl l hl]
  set E := eLpNorm (fun x => Real.sqrt (∑ A ∈ P, ‖f A x‖ ^ 2)) p μ
  have hl : ∀ l ∈ range (k + 1), eLpNorm (∑ A ∈ U.powersetCard l, f A) p μ ≤
      (2 * r * l : ℝ≥0∞) ^ l * E := by
    intro l hl
    have hsub : U.powersetCard l ⊆ P := by
      rw [← hPl l hl]; exact filter_subset _ _
    have h1 := superorth_card (μ := μ) (𝕜 := 𝕜) hr l U f (fun A hA => hfP A (hsub hA))
      (fun A hA hs => hvan A (fun q => by
        have h1 := mem_filter.1 (hsub (hA q).1)
        have h2 := mem_filter.1 (hsub (hA q).2)
        exact ⟨⟨mem_powerset.1 h1.1, h1.2⟩, ⟨mem_powerset.1 h2.1, h2.2⟩⟩) hs)
    refine h1.trans (mul_le_mul_right ?_ _)
    refine eLpNorm_mono_real (Real.continuous_sqrt.comp_aestronglyMeasurable
      (Finset.aestronglyMeasurable_fun_sum _ fun A hA =>
        (hfP A (hsub hA)).aestronglyMeasurable.norm.pow 2)) fun x => ?_
    rw [Real.norm_of_nonneg (Real.sqrt_nonneg _)]
    exact Real.sqrt_le_sqrt (sum_le_sum_of_subset_of_nonneg hsub fun _ _ _ => sq_nonneg _)
  rw [hsplit]
  calc eLpNorm (∑ l ∈ range (k + 1), ∑ A ∈ U.powersetCard l, f A) p μ
      ≤ ∑ l ∈ range (k + 1), eLpNorm (∑ A ∈ U.powersetCard l, f A) p μ := eLpNorm_sum_le hp1
    _ ≤ ∑ l ∈ range (k + 1), (2 * r * l : ℝ≥0∞) ^ l * E := sum_le_sum hl
    _ = _ := (sum_mul _ _ _).symm

end SuperorthMulti
end Superorthogonality


/-! ### Blueprint Lemma 7.3 (`lem:sunflower`): a weighted sunflower inequality -/

section Sunflower

variable {α : Type*} [DecidableEq α]

open scoped Nat in
/-- Blueprint Lemma 7.3 (`lem:sunflower`), sunflower step of the proof (Erdős–Rado): a family
`𝓕` of distinct `l`-element sets with `#𝓕 > l! (r-1)^l` contains `r` distinct sets
`B 0, …, B (r-1)` whose pairwise intersections are all equal (to some `A₀`). -/
theorem sunflower_erdos_rado (r : ℕ) : ∀ (l : ℕ) (𝓕 : Finset (Finset α)),
    (∀ A ∈ 𝓕, #A = l) → l ! * (r - 1) ^ l < #𝓕 →
    ∃ B : Fin r → Finset α, Function.Injective B ∧ (∀ i, B i ∈ 𝓕) ∧
      ∃ A₀, ∀ i j, i ≠ j → B i ∩ B j = A₀ := by
  intro l
  induction l with
  | zero =>
    intro 𝓕 h𝓕 hc
    exfalso
    have : #𝓕 ≤ 1 := Finset.card_le_one.2 fun a ha b hb => by
      rw [Finset.card_eq_zero.1 (h𝓕 a ha), Finset.card_eq_zero.1 (h𝓕 b hb)]
    simp at hc; omega
  | succ l ih =>
    intro 𝓕 h𝓕 hc
    classical
    set P := 𝓕.powerset.filter
      (fun D : Finset (Finset α) => (D : Set (Finset α)).PairwiseDisjoint id) with hP
    have hPne : P.Nonempty := ⟨∅, by simp [hP]⟩
    obtain ⟨D, hDP, hDmax⟩ := Finset.exists_max_image P Finset.card hPne
    have hDsub : D ⊆ 𝓕 := mem_powerset.1 (mem_filter.1 hDP).1
    have hDdisj : (D : Set (Finset α)).PairwiseDisjoint id := (mem_filter.1 hDP).2
    by_cases hDr : r ≤ #D
    · obtain ⟨D', hD'D, hD'c⟩ := Finset.exists_subset_card_eq hDr
      let e : Fin r ≃ D' := (D'.equivFin.trans (finCongr hD'c)).symm
      refine ⟨fun i => (e i).1, Subtype.val_injective.comp e.injective,
        fun i => hDsub (hD'D (e i).2), ∅, fun i j hij => ?_⟩
      have hne : (e i).1 ≠ (e j).1 := fun h => hij (e.injective (Subtype.val_injective h))
      exact Finset.disjoint_iff_inter_eq_empty.1
        (hDdisj (hD'D (e i).2) (hD'D (e j).2) hne)
    · push Not at hDr
      set U := D.biUnion id with hU
      have hUc : #U ≤ (r - 1) * (l + 1) := by
        calc #U ≤ ∑ A ∈ D, #A := Finset.card_biUnion_le
          _ = ∑ A ∈ D, (l + 1) := sum_congr rfl fun A hA => h𝓕 A (hDsub hA)
          _ = #D * (l + 1) := by rw [sum_const, smul_eq_mul]
          _ ≤ (r - 1) * (l + 1) := Nat.mul_le_mul_right _ (by omega)
      have hmeet : ∀ A ∈ 𝓕, ∃ x ∈ U, x ∈ A := by
        intro A hA
        by_contra hcon
        push Not at hcon
        have hAne : A.Nonempty := by
          rw [← Finset.card_pos, h𝓕 A hA]; omega
        have hAD : A ∉ D := by
          intro hAD
          obtain ⟨y, hy⟩ := hAne
          exact hcon y (mem_biUnion.2 ⟨A, hAD, hy⟩) hy
        have hins : insert A D ∈ P := by
          refine mem_filter.2 ⟨mem_powerset.2 (insert_subset hA hDsub), ?_⟩
          rw [coe_insert]
          refine hDdisj.insert fun B hB _ => ?_
          exact Finset.disjoint_left.2 fun y hyA hyB =>
            hcon y (mem_biUnion.2 ⟨B, hB, hyB⟩) hyA
        have := hDmax _ hins
        rw [card_insert_of_notMem hAD] at this
        omega
      have hex : ∃ x ∈ U, l ! * (r - 1) ^ l < #(𝓕.filter (x ∈ ·)) := by
        by_contra hcon
        push Not at hcon
        have h1 : 𝓕 ⊆ U.biUnion (fun x => 𝓕.filter (x ∈ ·)) := fun A hA => by
          obtain ⟨x, hxU, hxA⟩ := hmeet A hA
          exact mem_biUnion.2 ⟨x, hxU, mem_filter.2 ⟨hA, hxA⟩⟩
        have h2 : #𝓕 ≤ #U * (l ! * (r - 1) ^ l) := by
          calc #𝓕 ≤ #(U.biUnion (fun x => 𝓕.filter (x ∈ ·))) := card_le_card h1
            _ ≤ ∑ x ∈ U, #(𝓕.filter (x ∈ ·)) := card_biUnion_le
            _ ≤ ∑ x ∈ U, l ! * (r - 1) ^ l := sum_le_sum hcon
            _ = _ := by rw [sum_const, smul_eq_mul]
        have h3 : #U * (l ! * (r - 1) ^ l) ≤ (l + 1)! * (r - 1) ^ (l + 1) := by
          calc #U * (l ! * (r - 1) ^ l) ≤ (r - 1) * (l + 1) * (l ! * (r - 1) ^ l) :=
                Nat.mul_le_mul_right _ hUc
            _ = (l + 1)! * (r - 1) ^ (l + 1) := by
                rw [Nat.factorial_succ, pow_succ]; ring
        omega
      obtain ⟨x, -, hx⟩ := hex
      set 𝓕x := 𝓕.filter (x ∈ ·) with h𝓕x
      have hinj : Set.InjOn (fun s : Finset α => s.erase x) 𝓕x := fun a ha b hb hab =>
        Finset.erase_injOn' x (mem_filter.1 ha).2 (mem_filter.1 hb).2 hab
      have hcard : #(𝓕x.image (·.erase x)) = #𝓕x := card_image_of_injOn hinj
      obtain ⟨B', hB'inj, hB'mem, A₀', hA₀'⟩ := ih (𝓕x.image (·.erase x))
        (fun A hA => by
          obtain ⟨A', hA', rfl⟩ := mem_image.1 hA
          have := mem_filter.1 hA'
          rw [card_erase_of_mem this.2, h𝓕 A' this.1]; rfl)
        (by rw [hcard]; exact hx)
      have hB'x : ∀ i, x ∉ B' i ∧ insert x (B' i) ∈ 𝓕 := fun i => by
        obtain ⟨A', hA', hA'e⟩ := mem_image.1 (hB'mem i)
        have := mem_filter.1 hA'
        rw [← hA'e, insert_erase this.2]
        exact ⟨notMem_erase _ _, this.1⟩
      refine ⟨fun i => insert x (B' i), fun i j hij => hB'inj ?_, fun i => (hB'x i).2,
        insert x A₀', fun i j hij => ?_⟩
      · have := congrArg (·.erase x) hij
        simpa [erase_insert (hB'x i).1, erase_insert (hB'x j).1] using this
      · simp only
        rw [← insert_inter_distrib, hA₀' i j hij]

open scoped Nat in
/-- Blueprint Lemma 7.3 (`lem:sunflower`), consequence of the sunflower step: any family of at
least `M = 1 + ∑_{l=0}^k l! (r-1)^l` distinct sets of size `≤ k` contains `r` distinct sets
whose pairwise intersections are all equal. -/
theorem sunflower_of_card_le (r k : ℕ) (𝓕 : Finset (Finset α)) (h𝓕 : ∀ A ∈ 𝓕, #A ≤ k)
    (hM : 1 + ∑ l ∈ range (k + 1), l ! * (r - 1) ^ l ≤ #𝓕) :
    ∃ B : Fin r → Finset α, Function.Injective B ∧ (∀ i, B i ∈ 𝓕) ∧
      ∃ A₀, ∀ i j, i ≠ j → B i ∩ B j = A₀ := by
  have hex : ∃ l ∈ range (k + 1), l ! * (r - 1) ^ l < #(𝓕.filter (fun A => #A = l)) := by
    by_contra hcon
    push Not at hcon
    have := card_eq_sum_card_fiberwise (f := fun A => #A) (t := range (k + 1))
      (s := 𝓕) fun A hA => mem_range.2 (Nat.lt_succ_of_le (h𝓕 A hA))
    have := sum_le_sum hcon
    omega
  obtain ⟨l, -, hl⟩ := hex
  obtain ⟨B, hBinj, hBmem, A₀, hA₀⟩ :=
    sunflower_erdos_rado r l _ (fun A hA => (mem_filter.1 hA).2) hl
  exact ⟨B, hBinj, fun i => (mem_filter.1 (hBmem i)).1, A₀, hA₀⟩


/-- `B` is a sunflower tuple with core `A₀`. -/
def SunflowerCore {r : ℕ} (B : Fin r → Finset α) (A₀ : Finset α) : Prop :=
  (∀ i, A₀ ⊆ B i) ∧ ∀ i j, i ≠ j → B i ∩ B j = A₀

/-- Splitting off the first coordinate of a sum over `(Fin (m+1) → β)`-tuples. -/
lemma sum_piFinset_succ_const {β : Type*} (F : Finset β) (m : ℕ) (f : (Fin (m + 1) → β) → ℝ) :
    ∑ B ∈ Fintype.piFinset (fun _ : Fin (m + 1) => F), f B =
      ∑ A ∈ F, ∑ B ∈ Fintype.piFinset (fun _ : Fin m => F), f (Fin.cons A B) := by
  rw [← Finset.sum_product']
  refine Finset.sum_bij' (fun B _ => (B 0, Fin.tail B)) (fun p _ => Fin.cons p.1 p.2)
    ?_ ?_ ?_ ?_ ?_
  · intro B hB
    simp only [Fintype.mem_piFinset] at hB
    exact mem_product.2 ⟨hB 0, Fintype.mem_piFinset.2 fun i => hB _⟩
  · intro p hp
    obtain ⟨h1, h2⟩ := mem_product.1 hp
    rw [Fintype.mem_piFinset] at h2 ⊢
    intro i
    refine Fin.cases ?_ (fun j => ?_) i
    · simpa using h1
    · simpa using h2 j
  · intro B _; simp
  · intro p _; simp
  · intro B _; simp

/-- Light case: disjoint petals outside `Z` occur with weight `≥ W^m / 2^m`. -/
lemma sunflower_light (r : ℕ) (Z : Finset α) (F : Finset (Finset α)) (w : Finset α → ℝ)
    (hw : ∀ A ∈ F, 0 ≤ w A)
    (hlight : ∀ B ∈ F, 2 * r * ∑ A ∈ F with ¬ Disjoint (A \ Z) (B \ Z), w A ≤ ∑ A ∈ F, w A) :
    ∀ m ≤ r, (∑ A ∈ F, w A) ^ m ≤ 2 ^ m * ∑ B ∈ Fintype.piFinset (fun _ : Fin m => F) with
      (∀ i j, i ≠ j → Disjoint (B i \ Z) (B j \ Z)), ∏ i, w (B i) := by
  set W := ∑ A ∈ F, w A with hW
  have hW0 : 0 ≤ W := sum_nonneg hw
  intro m
  induction m with
  | zero => intro _; simp
  | succ m ih =>
    intro hm
    have ih := ih (by omega)
    set Sm := ∑ B ∈ Fintype.piFinset (fun _ : Fin m => F) with
      (∀ i j, i ≠ j → Disjoint (B i \ Z) (B j \ Z)), ∏ i, w (B i) with hSm
    have hprod0 : ∀ B ∈ Fintype.piFinset (fun _ : Fin m => F), 0 ≤ ∏ i, w (B i) :=
      fun B hB => prod_nonneg fun i _ => hw _ (Fintype.mem_piFinset.1 hB i)
    -- the inner sum
    have hinner : ∀ B ∈ Fintype.piFinset (fun _ : Fin m => F),
        W / 2 ≤ ∑ A ∈ F with (∀ j, Disjoint (A \ Z) (B j \ Z)), w A := by
      intro B hB
      have hBF := Fintype.mem_piFinset.1 hB
      set X := fun j => ∑ A ∈ F with ¬ Disjoint (A \ Z) (B j \ Z), w A
      have h1 : W ≤ (∑ A ∈ F with (∀ j, Disjoint (A \ Z) (B j \ Z)), w A) + ∑ j, X j := by
        simp only [X, sum_filter]
        rw [Finset.sum_comm, ← sum_add_distrib]
        refine sum_le_sum fun A hA => ?_
        split_ifs with h
        · exact le_add_of_nonneg_right (sum_nonneg fun j _ => by
            split_ifs <;> first | exact hw A hA | exact le_rfl)
        · push Not at h
          obtain ⟨j, hj⟩ := h
          rw [zero_add]
          refine le_trans ?_ (single_le_sum (f := fun j => if ¬ Disjoint (A \ Z) (B j \ Z)
            then w A else 0) (fun j _ => by split_ifs <;> first | exact hw A hA | exact le_rfl)
            (mem_univ j))
          simp [hj]
      have h2 : 2 * r * ∑ j, X j ≤ r * W := by
        rw [mul_sum]
        calc ∑ j, 2 * r * X j ≤ ∑ _j : Fin m, W := sum_le_sum fun j _ => hlight _ (hBF j)
          _ = m * W := by simp
          _ ≤ r * W := mul_le_mul_of_nonneg_right (by exact_mod_cast (by omega : m ≤ r)) hW0
      have hr : (0 : ℝ) < r := by exact_mod_cast (by omega : 0 < r)
      have h3 : 2 * ∑ j, X j ≤ W := by
        have : r * (2 * ∑ j, X j) ≤ r * W := by linarith
        exact le_of_mul_le_mul_left this hr
      linarith
    have hstep : W / 2 * Sm ≤ ∑ B ∈ Fintype.piFinset (fun _ : Fin (m + 1) => F) with
        (∀ i j, i ≠ j → Disjoint (B i \ Z) (B j \ Z)), ∏ i, w (B i) := by
      rw [sum_filter, sum_piFinset_succ_const, hSm, sum_filter, mul_sum]
      calc ∑ B ∈ Fintype.piFinset (fun _ : Fin m => F), W / 2 *
            (if ∀ i j, i ≠ j → Disjoint (B i \ Z) (B j \ Z) then ∏ i, w (B i) else 0)
          ≤ ∑ B ∈ Fintype.piFinset (fun _ : Fin m => F),
            ∑ A ∈ F, (if (∀ i j, i ≠ j → Disjoint (B i \ Z) (B j \ Z)) ∧
              (∀ j, Disjoint (A \ Z) (B j \ Z)) then w A * ∏ i, w (B i) else 0) := by
            refine sum_le_sum fun B hB => ?_
            split_ifs with hB'
            · simp only [and_iff_right hB']
              rw [← sum_filter, ← sum_mul]
              exact mul_le_mul_of_nonneg_right (hinner B hB) (hprod0 B hB)
            · rw [mul_zero]
              exact sum_nonneg fun A _ => by
                split_ifs with h
                · exact absurd h.1 hB'
                · exact le_rfl
        _ = ∑ A ∈ F, ∑ B ∈ Fintype.piFinset (fun _ : Fin m => F),
            (if (∀ i j, i ≠ j → Disjoint (B i \ Z) (B j \ Z)) ∧
              (∀ j, Disjoint (A \ Z) (B j \ Z)) then w A * ∏ i, w (B i) else 0) := sum_comm
        _ ≤ _ := by
            refine sum_le_sum fun A hA => sum_le_sum fun B hB => ?_
            split_ifs with h h'
            · rw [Fin.prod_univ_succ]; simp
            · exfalso; apply h'
              intro i j hij
              induction i using Fin.cases with
              | zero =>
                induction j using Fin.cases with
                | zero => exact absurd rfl hij
                | succ j => simpa using h.2 j
              | succ i =>
                induction j using Fin.cases with
                | zero => simpa using (h.2 i).symm
                | succ j => simpa using h.1 i j (fun e => hij (by rw [e]))
            · rw [Fin.prod_univ_succ]
              simp only [Fin.cons_zero, Fin.cons_succ]
              exact mul_nonneg (hw A hA) (hprod0 B hB)
            · exact le_rfl
    calc W ^ (m + 1) = W * W ^ m := by ring
      _ ≤ W * (2 ^ m * Sm) := mul_le_mul_of_nonneg_left ih hW0
      _ = 2 ^ (m + 1) * (W / 2 * Sm) := by ring
      _ ≤ _ := mul_le_mul_of_nonneg_left hstep (by positivity)

/-- Weight of sets meeting `B` outside `Z` is at most the sum of element weights over `B \ Z`. -/
lemma sum_not_disjoint_le (Z B : Finset α) (F : Finset (Finset α)) (w : Finset α → ℝ)
    (hw : ∀ A ∈ F, 0 ≤ w A) :
    ∑ A ∈ F with ¬ Disjoint (A \ Z) (B \ Z), w A ≤
      ∑ x ∈ B \ Z, ∑ A ∈ F with x ∈ A, w A := by
  simp only [sum_filter]
  rw [Finset.sum_comm]
  refine sum_le_sum fun A hA => ?_
  have hnn : 0 ≤ ∑ x ∈ B \ Z, if x ∈ A then w A else 0 :=
    sum_nonneg fun j _ => by split_ifs <;> first | exact hw A hA | exact le_rfl
  by_cases h : Disjoint (A \ Z) (B \ Z)
  · simpa [h] using hnn
  · obtain ⟨x, hxA, hxB⟩ := Finset.not_disjoint_iff.1 h
    have := single_le_sum (f := fun x => if x ∈ A then w A else 0)
      (fun j _ => by split_ifs <;> first | exact hw A hA | exact le_rfl) hxB
    simpa [h, (mem_sdiff.1 hxA).1] using this

/-- The explicit constant `C_{k,r} = (2(r+1)(k+1))^{r(k+1)}` of the weighted sunflower
inequality. -/
noncomputable def sunflowerConst (k r : ℕ) : ℝ := (2 * (r + 1) * (k + 1) : ℝ) ^ (r * (k + 1))

/-- The constant `sunflowerConst k r` is at least `1`. -/
lemma one_le_sunflowerConst (k r : ℕ) : 1 ≤ sunflowerConst k r :=
  one_le_pow₀ (by nlinarith [(Nat.cast_nonneg r : (0:ℝ) ≤ r), (Nat.cast_nonneg k : (0:ℝ) ≤ k)])

open Classical in
/-- Light case of `sunflower_core`: every element outside `Z` has small weight. -/
lemma sunflower_core_light (r k : ℕ) (Z : Finset α) (F : Finset (Finset α))
    (w : Finset α → ℝ) (hF : ∀ A ∈ F, Z ⊆ A ∧ #(A \ Z) ≤ k) (hw : ∀ A ∈ F, 0 ≤ w A)
    (hl : ∀ x ∉ Z, 2 * r * (k : ℝ) * ∑ A ∈ F with x ∈ A, w A ≤ ∑ A ∈ F, w A) :
    (∑ A ∈ F, w A) ^ r ≤ sunflowerConst k r *
      ∑ B ∈ Fintype.piFinset (fun _ : Fin r => F) with (∃ A₀, SunflowerCore B A₀),
        ∏ i, w (B i) := by
  set W := ∑ A ∈ F, w A with hW
  have hW0 : 0 ≤ W := sum_nonneg hw
  have hr0 : (0 : ℝ) ≤ r := Nat.cast_nonneg r
  have hlight : ∀ B ∈ F, 2 * r * ∑ A ∈ F with ¬ Disjoint (A \ Z) (B \ Z), w A ≤ W := by
    intro B hB
    have h1 := sum_not_disjoint_le Z B F w hw
    have h1' := mul_le_mul_of_nonneg_left h1 (by positivity : (0 : ℝ) ≤ 2 * r)
    refine h1'.trans ?_
    have h2 : (k : ℝ) * (2 * r * ∑ x ∈ B \ Z, ∑ A ∈ F with x ∈ A, w A) ≤ k * W := by
      rw [mul_sum, mul_sum]
      calc ∑ x ∈ B \ Z, (k : ℝ) * (2 * r * ∑ A ∈ F with x ∈ A, w A) ≤ ∑ _x ∈ B \ Z, W :=
            sum_le_sum fun x hx => by have := hl x (mem_sdiff.1 hx).2; linarith
        _ = #(B \ Z) * W := by simp
        _ ≤ k * W := mul_le_mul_of_nonneg_right (by exact_mod_cast (hF B hB).2) hW0
    rcases Nat.eq_zero_or_pos k with hk | hk
    · have : B \ Z = ∅ := card_eq_zero.1 (by have := (hF B hB).2; omega)
      rw [this]; simpa using hW0
    · have hk' : (0 : ℝ) < k := by exact_mod_cast hk
      exact le_of_mul_le_mul_left h2 hk'
  have hmain := sunflower_light r Z F w hw hlight r le_rfl
  have hsub : ∑ B ∈ Fintype.piFinset (fun _ : Fin r => F) with
        (∀ i j, i ≠ j → Disjoint (B i \ Z) (B j \ Z)), ∏ i, w (B i) ≤
      ∑ B ∈ Fintype.piFinset (fun _ : Fin r => F) with (∃ A₀, SunflowerCore B A₀),
        ∏ i, w (B i) := by
    refine sum_le_sum_of_subset_of_nonneg (fun B hB => ?_) (fun B hB _ => ?_)
    · obtain ⟨hB1, hB2⟩ := mem_filter.1 hB
      refine mem_filter.2 ⟨hB1, Z, fun i => (hF _ (Fintype.mem_piFinset.1 hB1 i)).1,
        fun i j hij => ?_⟩
      ext x
      simp only [mem_inter]
      constructor
      · rintro ⟨hxi, hxj⟩
        by_contra hxZ
        exact Finset.disjoint_left.1 (hB2 i j hij) (mem_sdiff.2 ⟨hxi, hxZ⟩)
          (mem_sdiff.2 ⟨hxj, hxZ⟩)
      · intro hxZ
        exact ⟨(hF _ (Fintype.mem_piFinset.1 hB1 i)).1 hxZ,
          (hF _ (Fintype.mem_piFinset.1 hB1 j)).1 hxZ⟩
    · exact prod_nonneg fun i _ =>
        hw _ (Fintype.mem_piFinset.1 (mem_filter.1 hB).1 i)
  have hC : (2 : ℝ) ^ r ≤ sunflowerConst k r := by
    unfold sunflowerConst
    have hk0 : (0 : ℝ) ≤ k := Nat.cast_nonneg k
    calc (2 : ℝ) ^ r ≤ 2 ^ (r * (k + 1)) :=
          pow_le_pow_right₀ (by norm_num) (Nat.le_mul_of_pos_right r (Nat.succ_pos k))
      _ ≤ _ := pow_le_pow_left₀ (by norm_num) (by nlinarith) _
  have hS0 : 0 ≤ ∑ B ∈ Fintype.piFinset (fun _ : Fin r => F) with (∃ A₀, SunflowerCore B A₀),
        ∏ i, w (B i) :=
    sum_nonneg fun B hB => prod_nonneg fun i _ =>
      hw _ (Fintype.mem_piFinset.1 (mem_filter.1 hB).1 i)
  calc W ^ r ≤ 2 ^ r * _ := hmain
    _ ≤ 2 ^ r * _ := mul_le_mul_of_nonneg_left hsub (by positivity)
    _ ≤ _ := mul_le_mul_of_nonneg_right hC hS0

open Classical in
/-- Relative form of the weighted sunflower inequality: sets containing `Z` with at most `k`
further elements. -/
theorem sunflower_core (r : ℕ) : ∀ (k : ℕ) (Z : Finset α) (F : Finset (Finset α))
    (w : Finset α → ℝ), (∀ A ∈ F, Z ⊆ A ∧ #(A \ Z) ≤ k) → (∀ A ∈ F, 0 ≤ w A) →
    (∑ A ∈ F, w A) ^ r ≤ sunflowerConst k r *
      ∑ B ∈ Fintype.piFinset (fun _ : Fin r => F) with (∃ A₀, SunflowerCore B A₀),
        ∏ i, w (B i) := by
  intro k
  induction k with
  | zero =>
    intro Z F w hF hw
    exact sunflower_core_light r 0 Z F w hF hw (fun x _ => by simpa using sum_nonneg hw)
  | succ k ih =>
    intro Z F w hF hw
    set W := ∑ A ∈ F, w A with hW
    have hW0 : 0 ≤ W := sum_nonneg hw
    by_cases hh : ∃ x ∉ Z, W < 2 * r * ((k + 1 : ℕ) : ℝ) * ∑ A ∈ F with x ∈ A, w A
    · obtain ⟨x, hxZ, hx⟩ := hh
      have hF' : ∀ A ∈ F.filter (x ∈ ·), insert x Z ⊆ A ∧ #(A \ insert x Z) ≤ k := by
        intro A hA
        obtain ⟨hAF, hxA⟩ := mem_filter.1 hA
        refine ⟨insert_subset hxA (hF A hAF).1, ?_⟩
        rw [sdiff_insert, card_erase_of_mem (mem_sdiff.2 ⟨hxA, hxZ⟩)]
        have := (hF A hAF).2
        omega
      have h1 := ih (insert x Z) (F.filter (x ∈ ·)) w hF' (fun A hA => hw A (mem_filter.1 hA).1)
      have hsub : ∑ B ∈ Fintype.piFinset (fun _ : Fin r => F.filter (x ∈ ·)) with
            (∃ A₀, SunflowerCore B A₀), ∏ i, w (B i) ≤
          ∑ B ∈ Fintype.piFinset (fun _ : Fin r => F) with (∃ A₀, SunflowerCore B A₀),
            ∏ i, w (B i) := by
        refine sum_le_sum_of_subset_of_nonneg (fun B hB => ?_) (fun B hB _ => ?_)
        · obtain ⟨hB1, hB2⟩ := mem_filter.1 hB
          exact mem_filter.2 ⟨Fintype.mem_piFinset.2 fun i =>
            (mem_filter.1 (Fintype.mem_piFinset.1 hB1 i)).1, hB2⟩
        · exact prod_nonneg fun i _ =>
            hw _ (Fintype.mem_piFinset.1 (mem_filter.1 hB).1 i)
      have hS0 : 0 ≤ ∑ B ∈ Fintype.piFinset (fun _ : Fin r => F.filter (x ∈ ·)) with
            (∃ A₀, SunflowerCore B A₀), ∏ i, w (B i) :=
        sum_nonneg fun B hB => prod_nonneg fun i _ =>
          hw _ (mem_filter.1 (Fintype.mem_piFinset.1 (mem_filter.1 hB).1 i)).1
      have hr0 : (0 : ℝ) ≤ r := Nat.cast_nonneg r
      have hk0 : (0 : ℝ) ≤ k := Nat.cast_nonneg k
      have hC : (2 * r * ((k + 1 : ℕ) : ℝ)) ^ r * sunflowerConst k r ≤
          sunflowerConst (k + 1) r := by
        unfold sunflowerConst
        push_cast
        rw [show r * (k + 1 + 1) = r + r * (k + 1) by ring, pow_add]
        exact mul_le_mul (pow_le_pow_left₀ (by positivity) (by nlinarith) _)
          (pow_le_pow_left₀ (by positivity) (by nlinarith) _) (by positivity) (by positivity)
      calc W ^ r ≤ (2 * r * ((k + 1 : ℕ) : ℝ) * ∑ A ∈ F with x ∈ A, w A) ^ r :=
            pow_le_pow_left₀ hW0 hx.le r
        _ = (2 * r * ((k + 1 : ℕ) : ℝ)) ^ r * (∑ A ∈ F with x ∈ A, w A) ^ r := mul_pow _ _ _
        _ ≤ (2 * r * ((k + 1 : ℕ) : ℝ)) ^ r * (sunflowerConst k r *
            ∑ B ∈ Fintype.piFinset (fun _ : Fin r => F.filter (x ∈ ·)) with
              (∃ A₀, SunflowerCore B A₀), ∏ i, w (B i)) := by
            refine mul_le_mul_of_nonneg_left ?_ (by positivity)
            simpa [sum_filter] using h1
        _ ≤ (2 * r * ((k + 1 : ℕ) : ℝ)) ^ r * (sunflowerConst k r *
            ∑ B ∈ Fintype.piFinset (fun _ : Fin r => F) with
              (∃ A₀, SunflowerCore B A₀), ∏ i, w (B i)) := by
            refine mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hsub ?_) (by positivity)
            exact zero_le_one.trans (one_le_sunflowerConst k r)
        _ ≤ _ := by
            rw [← mul_assoc]
            exact mul_le_mul_of_nonneg_right hC (hS0.trans hsub)
    · push Not at hh
      exact sunflower_core_light r (k + 1) Z F w hF hw hh

/-- Blueprint Lemma 7.3 (`lem:sunflower`), inequality (7.2) (`eq:weightedflower`): for weights
`w_A ≥ 0` on the subsets `A ⊆ S` with `|A| ≤ k`,
`(∑_A w_A)^r ≤ C_{k,r} ∑_{A₀} ∑_{(A_1,…,A_r)} ∏_{i=1}^r w_{A₀ ∪ A_i}`, where `A₀` ranges over
the subsets of `S` with `|A₀| ≤ k` and the inner sum over `r`-tuples of pairwise disjoint
(possibly empty) petals `A_i ⊆ S \ A₀` with `|A₀ ∪ A_i| ≤ k`. The constant is
`C_{k,r} = sunflowerConst k r = (2(r+1)(k+1))^{r(k+1)}`, depending only on `k` and `r`. -/
theorem weighted_sunflower (S : Finset α) (k r : ℕ) (w : Finset α → ℝ)
    (hw : ∀ A ⊆ S, #A ≤ k → 0 ≤ w A) :
    (∑ A ∈ S.powerset with #A ≤ k, w A) ^ r ≤ sunflowerConst k r *
      ∑ A₀ ∈ S.powerset with #A₀ ≤ k,
        ∑ t ∈ Fintype.piFinset (fun _ : Fin r => (S \ A₀).powerset) with
            ((∀ i j, i ≠ j → Disjoint (t i) (t j)) ∧ ∀ i, #(A₀ ∪ t i) ≤ k),
          ∏ i, w (A₀ ∪ t i) := by
  classical
  set F := S.powerset.filter (fun A => #A ≤ k) with hFdef
  have hFmem : ∀ A, A ∈ F ↔ A ⊆ S ∧ #A ≤ k := fun A => by simp [hFdef]
  have hwF : ∀ A ∈ F, 0 ≤ w A := fun A hA => hw A ((hFmem A).1 hA).1 ((hFmem A).1 hA).2
  have h := sunflower_core r k ∅ F w
    (fun A hA => ⟨empty_subset _, by simpa using ((hFmem A).1 hA).2⟩) hwF
  refine h.trans (mul_le_mul_of_nonneg_left ?_ (zero_le_one.trans (one_le_sunflowerConst k r)))
  set T : Finset α → Finset (Fin r → Finset α) := fun A₀ =>
    (Fintype.piFinset (fun _ : Fin r => (S \ A₀).powerset)).filter
      (fun t => (∀ i j, i ≠ j → Disjoint (t i) (t j)) ∧ ∀ i, #(A₀ ∪ t i) ≤ k) with hT
  refine le_trans ?_ (Finset.sum_sigma F T (fun p => ∏ i, w (p.1 ∪ p.2 i))).le
  set G := (Fintype.piFinset (fun _ : Fin r => F)).filter (fun B => ∃ A₀, SunflowerCore B A₀)
  have hGmem : ∀ B ∈ G, (∀ i, B i ∈ F) ∧ ∃ A₀, SunflowerCore B A₀ := fun B hB => by
    obtain ⟨h1, h2⟩ := mem_filter.1 hB
    exact ⟨Fintype.mem_piFinset.1 h1, h2⟩
  have hcore : ∀ B ∈ G, ∃ A₀ ∈ F, SunflowerCore B A₀ := by
    intro B hB
    obtain ⟨hBF, A₀, hA₀⟩ := hGmem B hB
    rcases Nat.eq_zero_or_pos r with hr | hr
    · refine ⟨∅, (hFmem ∅).2 ⟨empty_subset _, by simp⟩, fun i => ?_, fun i => ?_⟩
      · exact absurd i.2 (by omega)
      · exact absurd i.2 (by omega)
    · have h0 := (hFmem _).1 (hBF ⟨0, hr⟩)
      exact ⟨A₀, (hFmem _).2 ⟨(hA₀.1 _).trans h0.1, (card_le_card (hA₀.1 _)).trans h0.2⟩, hA₀⟩
  let c : (Fin r → Finset α) → Finset α := fun B =>
    if h : ∃ A₀ ∈ F, SunflowerCore B A₀ then h.choose else ∅
  have hc : ∀ B ∈ G, c B ∈ F ∧ SunflowerCore B (c B) := fun B hB => by
    simp only [c]
    split_ifs with h'
    · exact h'.choose_spec
    · exact absurd (hcore B hB) h'
  let φ : (Fin r → Finset α) → (Σ _ : Finset α, Fin r → Finset α) :=
    fun B => ⟨c B, fun i => B i \ c B⟩
  refine sum_le_sum_of_injOn φ ?_ ?_ ?_ ?_
  · intro B₁ hB₁ B₂ hB₂ he
    simp only [φ, Sigma.mk.inj_iff, heq_eq_eq] at he
    obtain ⟨he1, he2⟩ := he
    funext i
    rw [← union_sdiff_of_subset ((hc B₁ hB₁).2.1 i), ← union_sdiff_of_subset ((hc B₂ hB₂).2.1 i),
      ← he1]
    have := congrFun he2 i
    rw [← he1] at this
    rw [this]
  · intro p hp
    obtain ⟨B, hB, rfl⟩ := mem_image.1 hp
    obtain ⟨hcF, hcore1, hcore2⟩ := hc B hB
    have hBF := (hGmem B hB).1
    refine mem_sigma.2 ⟨hcF, mem_filter.2 ⟨Fintype.mem_piFinset.2 fun i => ?_, ?_, fun i => ?_⟩⟩
    · exact mem_powerset.2 (sdiff_subset_sdiff ((hFmem _).1 (hBF i)).1 le_rfl)
    · intro i j hij
      refine Finset.disjoint_left.2 fun x hxi hxj => ?_
      have : x ∈ B i ∩ B j := mem_inter.2 ⟨(mem_sdiff.1 hxi).1, (mem_sdiff.1 hxj).1⟩
      rw [hcore2 i j hij] at this
      exact (mem_sdiff.1 hxi).2 this
    · change #(c B ∪ (B i \ c B)) ≤ k
      rw [union_sdiff_of_subset (hcore1 i)]
      exact ((hFmem _).1 (hBF i)).2
  · intro B hB
    change ∏ i, w (B i) ≤ ∏ i, w (c B ∪ (B i \ c B))
    refine le_of_eq (prod_congr rfl fun i _ => ?_)
    rw [union_sdiff_of_subset ((hc B hB).2.1 i)]
  · intro p hp _
    obtain ⟨hp1, hp2⟩ := mem_sigma.1 hp
    obtain ⟨hp3, -, hp4⟩ := mem_filter.1 hp2
    refine prod_nonneg fun i _ => hw _ ?_ (hp4 i)
    have h1 := ((hFmem _).1 hp1).1
    have h2 := mem_powerset.1 (Fintype.mem_piFinset.1 hp3 i)
    exact union_subset h1 (h2.trans sdiff_subset)

end Sunflower

/-! ### Blueprint Lemma 7.4 (`lem:blockorthog`): two Fourier orthogonality statements -/

section BlockOrthog

open MeasureTheory
open scoped Pointwise ComplexConjugate

/-- The neighborhood `α + [-ε, ε]ⁿ + ℤⁿ` of the rational center `α ∈ T[Q]` in `E` (Fourier
supports in Blueprint Lemma 7.4 (`lem:blockorthog`)). -/
def ratNbhd (Q : ℕ) (ε : ℝ) (α : Fin n → ZMod Q) : Set (EuclideanSpace ℝ (Fin n)) :=
  {ξ | ∃ z : Fin n → ℤ, ∀ i, |ξ i - ratPt Q α i - z i| ≤ ε}

/-- Points of the cube `α + [-ε, ε]ⁿ` lie in `ratNbhd Q ε α`. -/
lemma mem_ratNbhd_of_abs_le {Q : ℕ} {ε : ℝ} {α : Fin n → ZMod Q}
    {ξ : EuclideanSpace ℝ (Fin n)} (h : ∀ i, |ξ i - ratPt Q α i| ≤ ε) :
    ξ ∈ ratNbhd Q ε α :=
  ⟨0, fun i => by simpa using h i⟩

/-- `f_A = ∑_{α ∈ Σ_A} f_α` of Blueprint Lemma 7.4 (`lem:blockorthog`). -/
noncomputable def blockFun (S : Finset ℕ) [NeZero (blockProd S)]
    (f : (Fin n → ZMod (blockProd S)) → (Fin n → ℤ) → ℂ) (A : Finset ℕ) (x : Fin n → ℤ) : ℂ :=
  ∑ α ∈ sigmaBlock S A, f α x

/-- `f_{A₀,α} = ∑_{β ∈ Σ_{A₀}} f_{α+β}` of Blueprint Lemma 7.4 (`lem:blockorthog`). -/
noncomputable def cosetFun (S : Finset ℕ) [NeZero (blockProd S)]
    (f : (Fin n → ZMod (blockProd S)) → (Fin n → ℤ) → ℂ) (A₀ : Finset ℕ)
    (α : Fin n → ZMod (blockProd S)) (x : Fin n → ℤ) : ℂ :=
  ∑ β ∈ sigmaBlock S A₀, f (α + β) x

/-- `Σ_{A₁} ⊆ Σ^{A₀}` for `A₁` disjoint from `A₀` with `|A₀| + |A₁| ≤ k`. -/
lemma sigmaBlock_subset_sigmaUpper (S : Finset ℕ) [NeZero (blockProd S)] {k : ℕ}
    {A₀ A₁ : Finset ℕ} (hd : Disjoint A₁ A₀) (hk : A₁.card + A₀.card ≤ k) :
    sigmaBlock (n := n) S A₁ ⊆ sigmaUpper S k A₀ := by
  intro x hx
  rw [mem_sigmaBlock] at hx
  rw [mem_sigmaUpper, hx]
  exact ⟨hd, hk⟩

/-- The direct block decomposition `f_{A₀ ∪ A₁} = ∑_{α ∈ Σ_{A₁}} f_{A₀,α}` for disjoint `A₁, A₀`
(used in Blueprint Lemma 7.5 (`lem:normdescription`)). -/
theorem blockFun_union_eq_sum_cosetFun {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] (f : (Fin n → ZMod (blockProd S)) → (Fin n → ℤ) → ℂ)
    {A₀ A₁ : Finset ℕ} (hd : Disjoint A₁ A₀) (x : Fin n → ℤ) :
    blockFun S f (A₀ ∪ A₁) x = ∑ α ∈ sigmaBlock S A₁, cosetFun S f A₀ α x :=
  sum_sigmaBlock_union hS hd (fun α => f α x)

/-- Separation of Fourier supports: for centers `a_q, b_q ∈ Σ_{≤k}` (`q < r`) with
`∑ a_q ≠ ∑ b_q`, the neighborhoods `∑_q (a_q + [-ε,ε]ⁿ) + ℤⁿ` and `∑_q (b_q + [-ε,ε]ⁿ) + ℤⁿ` are
disjoint (helper for Blueprint Lemma 7.4 (`lem:blockorthog`), via the separation property (7.1)). -/
theorem disjoint_sum_ratNbhd {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} {ε : ℝ}
    (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    (a b : Fin r → Fin n → ZMod (blockProd S)) (ha : ∀ q, a q ∈ sigmaLe S k)
    (hb : ∀ q, b q ∈ sigmaLe S k) (hne : ∑ q, a q ≠ ∑ q, b q) :
    Disjoint ((∑ q, ratNbhd (blockProd S) ε (a q)) + Set.range (latEmbed (n := n)))
      ((∑ q, ratNbhd (blockProd S) ε (b q)) + Set.range (latEmbed (n := n))) := by
  rw [Set.disjoint_left]
  rintro ξ ⟨x, hx, _, ⟨w, rfl⟩, rfl⟩ ⟨y, hy, _, ⟨w', rfl⟩, hxy⟩
  obtain ⟨g, hg, rfl⟩ := (Set.mem_finsetSum _ _ _).1 hx
  obtain ⟨h, hh, rfl⟩ := (Set.mem_finsetSum _ _ _).1 hy
  choose z hz using fun q => hg (Finset.mem_univ q)
  choose z' hz' using fun q => hh (Finset.mem_univ q)
  let α : Fin r ⊕ Fin r → Fin n → ZMod (blockProd S) := Sum.elim a b
  let σ : Fin r ⊕ Fin r → ℤ := Sum.elim (fun _ => 1) (fun _ => -1)
  let δ : Fin r ⊕ Fin r → EuclideanSpace ℝ (Fin n) :=
    Sum.elim (fun q => g q - ratPt (blockProd S) (a q) - latEmbed (z q))
      (fun q => h q - ratPt (blockProd S) (b q) - latEmbed (z' q))
  have hsep := separation hS1 hS hε hεr (Finset.univ : Finset (Fin r ⊕ Fin r))
    (by simp; omega) α (by rintro (q | q) -; exacts [ha q, hb q]) σ
    (by rintro (q | q) - <;> simp [σ])
    (by
      simp only [α, σ, Fintype.sum_sum_type, Sum.elim_inl, Sum.elim_inr, one_smul, neg_smul,
        Finset.sum_neg_distrib, ← sub_eq_add_neg, sub_ne_zero]
      exact hne) δ
    (by
      rintro (q | q) - i
      · simp only [δ, Sum.elim_inl, PiLp.sub_apply, latEmbed_apply]
        exact (hz q i).trans (by linarith)
      · simp only [δ, Sum.elim_inr, PiLp.sub_apply, latEmbed_apply]
        exact (hz' q i).trans (by linarith))
  apply hsep
  refine ⟨w' - w - ∑ q, z q + ∑ q, z' q, ?_⟩
  ext i
  have hi := congrArg (fun v : EuclideanSpace ℝ (Fin n) => v i) hxy
  simp only [PiLp.add_apply, latEmbed_apply] at hi
  simp [Fintype.sum_sum_type, α, σ, δ, latEmbed_apply, Finset.sum_add_distrib,
    Finset.sum_sub_distrib, Finset.sum_neg_distrib]
  simp only [WithLp.ofLp_sum, Finset.sum_apply] at hi
  linarith

/-- Products of `r ≥ 1` sequences in `ℓ¹` are in `ℓ¹`. -/
lemma summable_norm_prod_fin {r : ℕ} (hr : 0 < r) {u : Fin r → (Fin n → ℤ) → ℂ}
    (hu : ∀ q, Summable fun z => ‖u q z‖) : Summable fun z => ‖∏ q, u q z‖ :=
  haveI : Nonempty (Fin r) := ⟨⟨0, hr⟩⟩
  (latFT_prod_eq_zero_of_not_mem (s := Finset.univ) Finset.univ_nonempty
    (S := fun _ => Set.univ) (fun q _ => hu q)
    (fun _ _ ξ hξ => absurd (Set.mem_univ ξ) hξ)).1

section Hyp

variable {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} {ε : ℝ}
    (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    {f : (Fin n → ZMod (blockProd S)) → (Fin n → ℤ) → ℂ}
    (hf : ∀ α ∈ sigmaLe S k, Summable fun z => ‖f α z‖)
    (hsupp : ∀ α ∈ sigmaLe S k, ∀ ξ ∉ ratNbhd (blockProd S) ε α, latFT (f α) ξ = 0)
include hS1 hS hε hεr hf hsupp

/-- Orthogonality of two products `∏_q f_{a_q}`, `∏_q f_{b_q}` of `r` Fourier-localized pieces
whose center sums differ (helper for Blueprint Lemma 7.4 (`lem:blockorthog`)). -/
theorem tsum_prod_mul_conj_prod_ratNbhd_eq_zero
    (a b : Fin r → Fin n → ZMod (blockProd S)) (ha : ∀ q, a q ∈ sigmaLe S k)
    (hb : ∀ q, b q ∈ sigmaLe S k) (hne : ∑ q, a q ≠ ∑ q, b q) :
    ∑' x, (∏ q, f (a q) x) * conj (∏ q, f (b q) x) = 0 := by
  rcases Nat.eq_zero_or_pos r with rfl | hr
  · exact absurd (by simp) hne
  have : Nonempty (Fin r) := ⟨⟨0, hr⟩⟩
  exact tsum_prod_mul_conj_prod_eq_zero Finset.univ_nonempty Finset.univ_nonempty
    (u := fun q => f (a q)) (v := fun q => f (b q))
    (fun q _ => hf _ (ha q)) (fun q _ => hsupp _ (ha q)) (fun q _ => hf _ (hb q))
    (fun q _ => hsupp _ (hb q)) (disjoint_sum_ratNbhd hS1 hS hε hεr a b ha hb hne)

/-- Orthogonality of two finite sums of products of Fourier-localized pieces, when every pair
of center tuples has different sums (helper for Blueprint Lemma 7.4 (`lem:blockorthog`)). -/
theorem tsum_sum_prod_mul_conj_sum_prod_eq_zero {κ κ' : Type*} (P : Finset κ) (P' : Finset κ')
    (a : κ → Fin r → Fin n → ZMod (blockProd S)) (b : κ' → Fin r → Fin n → ZMod (blockProd S))
    (ha : ∀ j ∈ P, ∀ q, a j q ∈ sigmaLe S k) (hb : ∀ j ∈ P', ∀ q, b j q ∈ sigmaLe S k)
    (hne : ∀ j ∈ P, ∀ j' ∈ P', ∑ q, a j q ≠ ∑ q, b j' q) :
    ∑' x, (∑ j ∈ P, ∏ q, f (a j q) x) * conj (∑ j' ∈ P', ∏ q, f (b j' q) x) = 0 := by
  rcases Nat.eq_zero_or_pos r with rfl | hr
  · rcases P.eq_empty_or_nonempty with rfl | ⟨j, hj⟩
    · simp
    rcases P'.eq_empty_or_nonempty with rfl | ⟨j', hj'⟩
    · simp
    exact absurd (by simp) (hne j hj j' hj')
  have hsum : ∀ j ∈ P, ∀ j' ∈ P',
      Summable fun x => (∏ q, f (a j q) x) * conj (∏ q, f (b j' q) x) := fun j hj j' hj' =>
    Summable.of_norm (by
      simpa [norm_mul] using summable_norm_mul
        (summable_norm_prod_fin hr fun q => hf _ (ha j hj q))
        (summable_norm_prod_fin hr fun q => hf _ (hb j' hj' q)))
  simp_rw [map_sum, Finset.sum_mul_sum]
  rw [Summable.tsum_finsetSum (fun j hj => summable_sum fun j' hj' => hsum j hj j' hj')]
  refine Finset.sum_eq_zero fun j hj => ?_
  rw [Summable.tsum_finsetSum (fun j' hj' => hsum j hj j' hj')]
  exact Finset.sum_eq_zero fun j' hj' =>
    tsum_prod_mul_conj_prod_ratNbhd_eq_zero hS1 hS hε hεr hf hsupp _ _ (ha j hj) (hb j' hj')
      (hne j hj j' hj')

end Hyp

/-- Blueprint Lemma 7.4 (`lem:blockorthog`), first assertion. Let `S` be a finite set of pairwise
coprime integers `> 1`, `k, r ∈ ℕ`, `0 < ε ≤ (100 r q_*^{2rk})⁻¹`, and for each `α ∈ Σ_{≤k}` let
`f_α ∈ ℓ¹(ℤⁿ)` have Fourier transform vanishing off `α + [-ε,ε]ⁿ + ℤⁿ`. Then the functions
`f_A = ∑_{α ∈ Σ_A} f_α` (`A ⊆ S`, `|A| ≤ k`) satisfy the subset vanishing condition of Blueprint
Lemma 7.2 (`lem:superorth`), exactly in the form of the hypothesis `hvan` of `superorth_subset`
(`U = S`, counting measure on `ℤⁿ`, `H = ℂ`): if some `u` belongs to exactly one of the `2r` sets
`A_0, A'_0, …, A_{r-1}, A'_{r-1}`, then `∑_x ∏_q ⟪f_{A_q}(x), f_{A'_q}(x)⟫ = 0`. -/
theorem blockorthog_superorth {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} {ε : ℝ}
    (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    (f : (Fin n → ZMod (blockProd S)) → (Fin n → ℤ) → ℂ)
    (hf : ∀ α ∈ sigmaLe S k, Summable fun z => ‖f α z‖)
    (hsupp : ∀ α ∈ sigmaLe S k, ∀ ξ ∉ ratNbhd (blockProd S) ε α, latFT (f α) ξ = 0) :
    ∀ A : Fin r → Finset ℕ × Finset ℕ,
      (∀ q, ((A q).1 ⊆ S ∧ #(A q).1 ≤ k) ∧ ((A q).2 ⊆ S ∧ #(A q).2 ≤ k)) →
      (∃ u, #{q | u ∈ (A q).1} + #{q | u ∈ (A q).2} = 1) →
        ∫ x, ∏ q, inner ℂ (blockFun S f (A q).1 x) (blockFun S f (A q).2 x) ∂Measure.count
          = 0 := by
  intro A hA ⟨u, hu⟩
  -- the block `u` and the sign structure of its unique occurrence
  have hzero : ∀ (B : Fin r → Finset ℕ) (α : Fin r → Fin n → ZMod (blockProd S)),
      (∀ q, α q ∈ sigmaBlock S (B q)) → u ∈ S → (∀ q, u ∉ B q) →
        blockRed u (∑ q, α q) = 0 := by
    intro B α hα huS h0
    rw [blockRed_sum (dvd_blockProd huS)]
    exact Finset.sum_eq_zero fun q _ =>
      blockRed_eq_zero_of_not_mem huS (by rw [mem_sigmaBlock.1 (hα q)]; exact h0 q)
  have hone : ∀ (B : Fin r → Finset ℕ) (α : Fin r → Fin n → ZMod (blockProd S)),
      (∀ q, α q ∈ sigmaBlock S (B q)) → u ∈ S → #{q | u ∈ B q} = 1 →
        blockRed u (∑ q, α q) ≠ 0 := by
    intro B α hα huS h1
    obtain ⟨q0, hq0⟩ := Finset.card_eq_one.1 h1
    have hq : ∀ q, u ∈ B q ↔ q = q0 := fun q => by
      have := congrArg (q ∈ ·) hq0
      simpa using this
    rw [blockRed_sum (dvd_blockProd huS), Finset.sum_eq_single q0]
    · exact (mem_blockSupp.1 (by rw [mem_sigmaBlock.1 (hα q0)]; exact (hq q0).2 rfl)).2
    · intro q _ hq'
      exact blockRed_eq_zero_of_not_mem huS
        (by rw [mem_sigmaBlock.1 (hα q)]; exact fun h => hq' ((hq q).1 h))
    · intro h; exact absurd (Finset.mem_univ q0) h
  have hne : ∀ β ∈ Fintype.piFinset (fun q => sigmaBlock (n := n) S (A q).2),
      ∀ α ∈ Fintype.piFinset (fun q => sigmaBlock S (A q).1), ∑ q, β q ≠ ∑ q, α q := by
    intro β hβ α hα heq
    have hβ' := Fintype.mem_piFinset.1 hβ
    have hα' := Fintype.mem_piFinset.1 hα
    have huS : u ∈ S := by
      by_contra huS
      have h1 : ∀ q, u ∉ (A q).1 := fun q h => huS ((hA q).1.1 h)
      have h2 : ∀ q, u ∉ (A q).2 := fun q h => huS ((hA q).2.1 h)
      simp [h1, h2] at hu
    have hred := congrArg (blockRed u) heq
    rcases Nat.add_eq_one_iff.1 hu with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · rw [Finset.card_eq_zero, Finset.filter_eq_empty_iff] at h1
      exact hone _ β hβ' huS h2 (hred.trans (hzero _ α hα' huS fun q => h1 (Finset.mem_univ q)))
    · rw [Finset.card_eq_zero, Finset.filter_eq_empty_iff] at h2
      exact hone _ α hα' huS h1
        (hred.symm.trans (hzero _ β hβ' huS fun q => h2 (Finset.mem_univ q)))
  have e : ∀ x, ∏ q, inner ℂ (blockFun S f (A q).1 x) (blockFun S f (A q).2 x) =
      (∑ β ∈ Fintype.piFinset (fun q => sigmaBlock S (A q).2), ∏ q, f (β q) x) *
        conj (∑ α ∈ Fintype.piFinset (fun q => sigmaBlock S (A q).1), ∏ q, f (α q) x) := by
    intro x
    simp only [RCLike.inner_apply', blockFun]
    rw [Finset.prod_mul_distrib, mul_comm, ← map_prod, Finset.prod_univ_sum,
      Finset.prod_univ_sum]
  have key : ∑' x, ∏ q, inner ℂ (blockFun S f (A q).1 x) (blockFun S f (A q).2 x) = 0 := by
    simp_rw [e]
    exact tsum_sum_prod_mul_conj_sum_prod_eq_zero hS1 hS hε hεr hf hsupp _ _ id id
      (fun β hβ q => sigmaBlock_subset_sigmaLe S (hA q).2.2 (Fintype.mem_piFinset.1 hβ q))
      (fun α hα q => sigmaBlock_subset_sigmaLe S (hA q).1.2 (Fintype.mem_piFinset.1 hα q)) hne
  by_cases hint : Integrable
      (fun x => ∏ q, inner ℂ (blockFun S f (A q).1 x) (blockFun S f (A q).2 x)) Measure.count
  · rw [integral_countable hint]
    simpa [count_real_singleton] using key
  · exact integral_undef hint

/-- `∏_i f_{A₀, s_i} = ∑_{β ∈ Σ_{A₀}^r} ∏_i f_{s_i + β_i}` (expansion of a product of coset
functions). -/
lemma prod_cosetFun_eq_sum {S : Finset ℕ} [NeZero (blockProd S)] {r : ℕ}
    (f : (Fin n → ZMod (blockProd S)) → (Fin n → ℤ) → ℂ) (A₀ : Finset ℕ)
    (s : Fin r → Fin n → ZMod (blockProd S)) (x : Fin n → ℤ) :
    ∏ i, cosetFun S f A₀ (s i) x =
      ∑ β ∈ Fintype.piFinset (fun _ : Fin r => sigmaBlock (n := n) S A₀),
        ∏ i, f (s i + β i) x :=
  Finset.prod_univ_sum (fun _ => sigmaBlock S A₀) (fun i β => f (s i + β) x)

/-- Blueprint Lemma 7.4 (`lem:blockorthog`), second assertion. In the setting of
`blockorthog_superorth`, fix a core `A₀` and pairwise disjoint petals `A_1, …, A_r ⊆ S \ A₀`
with `|A₀ ∪ A_i| ≤ k`. For tuples `t, t'` with `t_i, t'_i ∈ Σ_{A_i}` (so `t_i ∈ Σ^{A₀}`, see
`sigmaBlock_subset_sigmaUpper`) and `t ≠ t'`, the products `∏_i f_{A₀,t_i}` and
`∏_i f_{A₀,t'_i}` are orthogonal in `ℓ²(ℤⁿ)`:
`∑_x (∏_i f_{A₀,t_i}(x)) · conj (∏_i f_{A₀,t'_i}(x)) = 0`. -/
theorem blockorthog_petals {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} {ε : ℝ}
    (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    (f : (Fin n → ZMod (blockProd S)) → (Fin n → ℤ) → ℂ)
    (hf : ∀ α ∈ sigmaLe S k, Summable fun z => ‖f α z‖)
    (hsupp : ∀ α ∈ sigmaLe S k, ∀ ξ ∉ ratNbhd (blockProd S) ε α, latFT (f α) ξ = 0)
    {A₀ : Finset ℕ} {A : Fin r → Finset ℕ} (hA : ∀ i, A i ⊆ S \ A₀)
    (hdisj : ∀ i j, i ≠ j → Disjoint (A i) (A j)) (hcard : ∀ i, #(A₀ ∪ A i) ≤ k)
    {t t' : Fin r → Fin n → ZMod (blockProd S)} (ht : ∀ i, t i ∈ sigmaBlock S (A i))
    (ht' : ∀ i, t' i ∈ sigmaBlock S (A i)) (htt' : t ≠ t') :
    ∑' x, (∏ i, cosetFun S f A₀ (t i) x) * conj (∏ i, cosetFun S f A₀ (t' i) x) = 0 := by
  have hd : ∀ i, Disjoint (A i) A₀ := fun i =>
    Finset.disjoint_of_subset_left (hA i) Finset.sdiff_disjoint
  have hmem : ∀ s : Fin r → Fin n → ZMod (blockProd S), (∀ i, s i ∈ sigmaBlock S (A i)) →
      ∀ β ∈ Fintype.piFinset (fun _ : Fin r => sigmaBlock (n := n) S A₀), ∀ i,
        s i + β i ∈ sigmaLe S k := fun s hs β hβ i =>
    sigmaBlock_subset_sigmaLe S (hcard i)
      (add_mem_sigmaBlock_union S (hd i) (hs i) (Fintype.mem_piFinset.1 hβ i))
  -- a block `u` in the petal `A i0` where `t` and `t'` differ
  obtain ⟨i0, hi0⟩ := Function.ne_iff.1 htt'
  obtain ⟨u, huS, hu⟩ : ∃ u ∈ S, blockRed u (t i0) ≠ blockRed u (t' i0) := by
    by_contra h
    push Not at h
    exact hi0 (ext_blockRed hS h)
  have huA : u ∈ A i0 := by
    by_contra h
    refine hu ?_
    rw [blockRed_eq_zero_of_not_mem huS (by rw [mem_sigmaBlock.1 (ht i0)]; exact h),
      blockRed_eq_zero_of_not_mem huS (by rw [mem_sigmaBlock.1 (ht' i0)]; exact h)]
  have huA₀ : u ∉ A₀ := (Finset.mem_sdiff.1 (hA i0 huA)).2
  have hred : ∀ s : Fin r → Fin n → ZMod (blockProd S), (∀ i, s i ∈ sigmaBlock S (A i)) →
      ∀ β ∈ Fintype.piFinset (fun _ : Fin r => sigmaBlock (n := n) S A₀),
        blockRed u (∑ i, (s i + β i)) = blockRed u (s i0) := by
    intro s hs β hβ
    have hβ0 : ∀ i, blockRed u (β i) = 0 := fun i =>
      blockRed_eq_zero_of_not_mem huS
        (by rw [mem_sigmaBlock.1 (Fintype.mem_piFinset.1 hβ i)]; exact huA₀)
    rw [blockRed_sum (dvd_blockProd huS), Finset.sum_eq_single i0]
    · rw [blockRed_add (dvd_blockProd huS), hβ0, add_zero]
    · intro i _ hi
      rw [blockRed_add (dvd_blockProd huS), hβ0, add_zero]
      exact blockRed_eq_zero_of_not_mem huS (by
        rw [mem_sigmaBlock.1 (hs i)]
        exact fun h => Finset.disjoint_left.1 (hdisj i0 i (Ne.symm hi)) huA h)
    · intro h; exact absurd (Finset.mem_univ i0) h
  simp_rw [prod_cosetFun_eq_sum]
  refine tsum_sum_prod_mul_conj_sum_prod_eq_zero hS1 hS hε hεr hf hsupp
    (Fintype.piFinset (fun _ : Fin r => sigmaBlock (n := n) S A₀))
    (Fintype.piFinset (fun _ : Fin r => sigmaBlock (n := n) S A₀))
    (fun β i => t i + β i) (fun β i => t' i + β i) (hmem t ht) (hmem t' ht') ?_
  intro β hβ β' hβ' heq
  have := congrArg (blockRed u) heq
  rw [hred t ht β hβ, hred t' ht' β' hβ'] at this
  exact hu this

/-- Pythagoras for finite orthogonal families in `ℓ¹(ℤⁿ)`:
`∑_x |∑_t F_t(x)|² = ∑_t ∑_x |F_t(x)|²` when `∑_x F_t(x) conj (F_{t'}(x)) = 0` for `t ≠ t'`. -/
theorem tsum_norm_sq_sum_eq_of_orthogonal {κ : Type*} (T : Finset κ)
    (F : κ → (Fin n → ℤ) → ℂ) (hF : ∀ t ∈ T, Summable fun x => ‖F t x‖)
    (horth : ∀ t ∈ T, ∀ t' ∈ T, t ≠ t' → ∑' x, F t x * conj (F t' x) = 0) :
    ∑' x, ‖∑ t ∈ T, F t x‖ ^ 2 = ∑ t ∈ T, ∑' x, ‖F t x‖ ^ 2 := by
  have hsq : ∀ z : ℂ, ((‖z‖ ^ 2 : ℝ) : ℂ) = z * conj z := fun z => by
    rw [Complex.mul_conj']; push_cast; rfl
  have hs : ∀ t ∈ T, ∀ t' ∈ T, Summable fun x => F t x * conj (F t' x) := fun t ht t' ht' =>
    Summable.of_norm (by simpa [norm_mul] using summable_norm_mul (hF t ht) (hF t' ht'))
  apply Complex.ofReal_injective
  rw [Complex.ofReal_tsum, Complex.ofReal_sum]
  simp_rw [Complex.ofReal_tsum, hsq, map_sum, Finset.sum_mul_sum]
  rw [Summable.tsum_finsetSum (fun t ht => summable_sum fun t' ht' => hs t ht t' ht')]
  refine Finset.sum_congr rfl fun t ht => ?_
  rw [Summable.tsum_finsetSum (fun t' ht' => hs t ht t' ht'), Finset.sum_eq_single t]
  · intro t' ht' hne; exact horth t ht t' ht' (Ne.symm hne)
  · intro h; exact absurd ht h

/-- Blueprint Lemma 7.4 (`lem:blockorthog`), consequence of the second assertion (as used in
Blueprint Lemma 7.5 (`lem:normdescription`)): in the setting of `blockorthog_petals`, with the
direct block decomposition `f_{A₀ ∪ A_i} = ∑_{α_i ∈ Σ_{A_i}} f_{A₀,α_i}`,
`‖∏_i f_{A₀ ∪ A_i}‖_2² = ∑_{t : t_i ∈ Σ_{A_i}} ‖∏_i f_{A₀,t_i}‖_2²`. -/
theorem blockorthog_norm_sq {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} {ε : ℝ}
    (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    (f : (Fin n → ZMod (blockProd S)) → (Fin n → ℤ) → ℂ)
    (hf : ∀ α ∈ sigmaLe S k, Summable fun z => ‖f α z‖)
    (hsupp : ∀ α ∈ sigmaLe S k, ∀ ξ ∉ ratNbhd (blockProd S) ε α, latFT (f α) ξ = 0)
    {A₀ : Finset ℕ} {A : Fin r → Finset ℕ} (hA : ∀ i, A i ⊆ S \ A₀)
    (hdisj : ∀ i j, i ≠ j → Disjoint (A i) (A j)) (hcard : ∀ i, #(A₀ ∪ A i) ≤ k) :
    ∑' x, ‖∏ i, blockFun S f (A₀ ∪ A i) x‖ ^ 2 =
      ∑ t ∈ Fintype.piFinset (fun i => sigmaBlock (n := n) S (A i)),
        ∑' x, ‖∏ i, cosetFun S f A₀ (t i) x‖ ^ 2 := by
  have hd : ∀ i, Disjoint (A i) A₀ := fun i =>
    Finset.disjoint_of_subset_left (hA i) Finset.sdiff_disjoint
  have e : ∀ x, ∏ i, blockFun S f (A₀ ∪ A i) x =
      ∑ t ∈ Fintype.piFinset (fun i => sigmaBlock (n := n) S (A i)),
        ∏ i, cosetFun S f A₀ (t i) x := fun x => by
    simp_rw [blockFun_union_eq_sum_cosetFun hS f (hd _)]
    exact Finset.prod_univ_sum (fun i => sigmaBlock S (A i)) (fun i α => cosetFun S f A₀ α x)
  simp_rw [e]
  rcases Nat.eq_zero_or_pos r with rfl | hr
  · simp
  refine tsum_norm_sq_sum_eq_of_orthogonal _ _ (fun t ht => ?_) (fun t ht t' ht' htt' =>
    blockorthog_petals hS1 hS hε hεr f hf hsupp hA hdisj hcard (Fintype.mem_piFinset.1 ht)
      (Fintype.mem_piFinset.1 ht') htt')
  refine summable_norm_prod_fin hr fun i => ?_
  refine Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun x => norm_sum_le _ _)
    (summable_sum fun β hβ => hf _ ?_)
  exact sigmaBlock_subset_sigmaLe S (hcard i)
    (add_mem_sigmaBlock_union S (hd i) (Fintype.mem_piFinset.1 ht i) hβ)

end BlockOrthog

/-! ### Blueprint Lemma 7.5 (`lem:normdescription`): a norm description -/

section NormDescription

open MeasureTheory
open scoped ENNReal

/-- Nonnegative summable sequences have summable powers `u^m`, `m ≥ 1`
(helper for Blueprint Lemma 7.5 (`lem:normdescription`)). -/
lemma summable_pow_of_summable_nonneg {ι : Type*} {u : ι → ℝ} (h0 : ∀ x, 0 ≤ u x)
    (hu : Summable u) {m : ℕ} (hm : 1 ≤ m) : Summable fun x => u x ^ m := by
  obtain ⟨j, rfl⟩ : ∃ j, m = j + 1 := ⟨m - 1, by omega⟩
  refine Summable.of_nonneg_of_le (fun x => pow_nonneg (h0 x) _) (fun x => ?_)
    (hu.mul_left ((∑' y, u y) ^ j))
  rw [pow_succ]
  exact mul_le_mul_of_nonneg_right
    (pow_le_pow_left₀ (h0 x) (hu.le_tsum x fun y _ => h0 y) j) (h0 x)

/-- `‖z‖ₑ ^ m = ofReal (‖z‖ ^ m)` (helper for Blueprint Lemma 7.5 (`lem:normdescription`)). -/
lemma enorm_pow_eq_ofReal {E : Type*} [NormedAddCommGroup E] (z : E) (m : ℕ) :
    ‖z‖ₑ ^ m = ENNReal.ofReal (‖z‖ ^ m) := by
  rw [← ofReal_norm, ENNReal.ofReal_pow (norm_nonneg _)]

/-- `‖√y‖ₑ ^ (2r) = (ofReal y) ^ r` for `y ≥ 0`. -/
lemma enorm_sqrt_pow_two_mul {y : ℝ} (hy : 0 ≤ y) (r : ℕ) :
    ‖Real.sqrt y‖ₑ ^ (2 * r) = ENNReal.ofReal y ^ r := by
  rw [enorm_pow_eq_ofReal, Real.norm_of_nonneg (Real.sqrt_nonneg _), pow_mul,
    Real.sq_sqrt hy, ENNReal.ofReal_pow hy]

/-- For `r ≥ 1`, `‖g‖_{2r}^{2r} = ∑_x ‖g(x)‖^{2r}` on `ℤⁿ` with counting measure. -/
lemma eLpNorm_count_pow_eq_tsum {E : Type*} [NormedAddCommGroup E] {r : ℕ} (hr : 0 < r)
    (g : (Fin n → ℤ) → E) :
    eLpNorm g (ENNReal.ofReal (2 * r)) Measure.count ^ (2 * r) = ∑' x, ‖g x‖ₑ ^ (2 * r) := by
  have hp : (0 : ℝ) < 2 * r := by positivity
  have hc : ((2 * r : ℕ) : ℝ) = 2 * r := by push_cast; ring
  rw [eLpNorm_ofReal_eq_lintegral AEStronglyMeasurable.of_discrete hp, lintegral_count,
    ← ENNReal.rpow_natCast, ← ENNReal.rpow_mul, hc, one_div_mul_cancel hp.ne', ENNReal.rpow_one]
  refine tsum_congr fun x => ?_
  rw [← hc, ENNReal.rpow_natCast]

/-- `∑_x ‖g x‖ₑ ^ m = ofReal (∑_x ‖g x‖ ^ m)` when `‖g‖ ^ m` is summable. -/
lemma tsum_enorm_pow_eq_ofReal {E : Type*} [NormedAddCommGroup E] {g : (Fin n → ℤ) → E}
    {m : ℕ} (hg : Summable fun x => ‖g x‖ ^ m) :
    ∑' x, ‖g x‖ₑ ^ m = ENNReal.ofReal (∑' x, ‖g x‖ ^ m) := by
  rw [ENNReal.ofReal_tsum_of_nonneg (fun x => by positivity) hg]
  exact tsum_congr fun x => enorm_pow_eq_ofReal _ _

/-- Sequences in `ℓ¹(ℤⁿ)` lie in `ℓ^{2r}(ℤⁿ)`. -/
lemma memLp_count_of_summable {E : Type*} [NormedAddCommGroup E] {r : ℕ} (hr : 0 < r)
    {g : (Fin n → ℤ) → E} (hg : Summable fun x => ‖g x‖) :
    MemLp g (ENNReal.ofReal (2 * r)) Measure.count := by
  rw [memLp_iff]
  have h := eLpNorm_count_pow_eq_tsum hr g
  rw [tsum_enorm_pow_eq_ofReal (summable_pow_of_summable_nonneg (fun x => norm_nonneg (g x)) hg
    (m := 2 * r) (by omega))] at h
  by_contra hc
  rw [not_lt, top_le_iff] at hc
  rw [hc, ENNReal.top_pow (by omega)] at h
  exact ENNReal.ofReal_ne_top h.symm
/-- Each `α ∈ Σ^{A₀}` has a unique petal support: sums over `r`-tuples of points of `Σ^{A₀}`
split over the tuples of petals `t_i ⊆ S \ A₀` with `|A₀ ∪ t_i| ≤ k`
(helper for Blueprint Lemma 7.5 (`lem:normdescription`)). -/
lemma sum_piFinset_sigmaUpper {M : Type*} [AddCommMonoid M] (S : Finset ℕ)
    [NeZero (blockProd S)]
    (k r : ℕ) (A₀ : Finset ℕ) (H : (Fin r → Fin n → ZMod (blockProd S)) → M) :
    ∑ t ∈ Fintype.piFinset (fun _ : Fin r => (S \ A₀).powerset) with ∀ i, #(A₀ ∪ t i) ≤ k,
        ∑ s ∈ Fintype.piFinset (fun i => sigmaBlock (n := n) S (t i)), H s =
      ∑ s ∈ Fintype.piFinset (fun _ : Fin r => sigmaUpper (n := n) S k A₀), H s := by
  classical
  rw [← sum_fiberwise_of_maps_to
    (g := fun (s : Fin r → Fin n → ZMod (blockProd S)) (i : Fin r) => blockSupp S (s i))
    (t := (Fintype.piFinset (fun _ : Fin r => (S \ A₀).powerset)).filter
      fun t => ∀ i, #(A₀ ∪ t i) ≤ k)]
  · refine sum_congr rfl fun t ht => ?_
    obtain ⟨ht1, ht2⟩ := mem_filter.1 ht
    have ht1' := Fintype.mem_piFinset.1 ht1
    congr 1
    ext s
    simp only [mem_filter, Fintype.mem_piFinset, mem_sigmaUpper, mem_sigmaBlock]
    refine ⟨fun h => ⟨fun i => ?_, funext h⟩, fun h => congrFun h.2⟩
    · have hd : Disjoint (t i) A₀ :=
        Finset.disjoint_of_subset_left (mem_powerset.1 (ht1' i)) Finset.sdiff_disjoint
      rw [h i]
      refine ⟨hd, ?_⟩
      have := ht2 i
      rw [card_union_of_disjoint hd.symm] at this
      omega
  · intro s hs
    have hs' := Fintype.mem_piFinset.1 hs
    refine mem_filter.2 ⟨Fintype.mem_piFinset.2 fun i => mem_powerset.2 fun q hq => ?_,
      fun i => ?_⟩
    · exact mem_sdiff.2 ⟨blockSupp_subset S _ hq,
        Finset.disjoint_left.1 (mem_sigmaUpper.1 (hs' i)).1 hq⟩
    · have := (mem_sigmaUpper.1 (hs' i)).2
      dsimp only
      exact (card_union_le _ _).trans (by omega)

/-- `∑_{s ∈ U^r} ∑_x ‖∏_i g_{s_i}(x)‖² = ∑_x (∑_{α ∈ U} ‖g_α(x)‖²)^r` (in `ℝ≥0∞`). -/
lemma sum_piFinset_tsum_enorm_prod {κ : Type*} (U : Finset κ) (r : ℕ)
    (g : κ → (Fin n → ℤ) → ℂ) :
    ∑ s ∈ Fintype.piFinset (fun _ : Fin r => U), ∑' x, ‖∏ i, g (s i) x‖ₑ ^ 2 =
      ∑' x, (∑ α ∈ U, ‖g α x‖ₑ ^ 2) ^ r := by
  rw [← Summable.tsum_finsetSum (fun _ _ => ENNReal.summable)]
  refine tsum_congr fun x => ?_
  rw [sum_pow']
  refine sum_congr rfl fun s _ => ?_
  rw [prod_pow, ← ofReal_norm, norm_prod, ENNReal.ofReal_prod_of_nonneg (fun _ _ => norm_nonneg _)]
  simp only [ofReal_norm]
/-- The constant `C_{k,r} = (∑_{l ≤ k} (2rl)^l)^{2r} · sunflowerConst k r` of Blueprint
Lemma 7.5 (`lem:normdescription`): the `2r`-th power of the constant of `superorth_subset`
times the constant of `weighted_sunflower`; it depends only on `k` and `r`. -/
noncomputable def normDescConst (k r : ℕ) : ℝ :=
  (∑ l ∈ range (k + 1), ((2 * r * l : ℕ) : ℝ) ^ l) ^ (2 * r) * sunflowerConst k r

/-- The constant of Blueprint Lemma 7.5 (`lem:normdescription`) is nonnegative. -/
lemma normDescConst_nonneg (k r : ℕ) : 0 ≤ normDescConst k r :=
  mul_nonneg (by positivity) (zero_le_one.trans (one_le_sunflowerConst k r))

/-- `normDescConst k r` in `ℝ≥0∞`, in the form produced by `superorth_subset` and
`weighted_sunflower`. -/
lemma ofReal_normDescConst (k r : ℕ) :
    ENNReal.ofReal (normDescConst k r) =
      (∑ l ∈ range (k + 1), (2 * r * l : ℝ≥0∞) ^ l) ^ (2 * r) *
        ENNReal.ofReal (sunflowerConst k r) := by
  rw [normDescConst, ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_pow (by positivity),
    ENNReal.ofReal_sum_of_nonneg (fun _ _ => by positivity)]
  congr 2
  refine sum_congr rfl fun l _ => ?_
  rw [ENNReal.ofReal_pow (by positivity), ENNReal.ofReal_natCast]
  push_cast
  ring

/-- The block functions `f_A` (`|A| ≤ k`) are in `ℓ¹`. -/
lemma summable_blockFun {S : Finset ℕ} [NeZero (blockProd S)] {k : ℕ}
    {f : (Fin n → ZMod (blockProd S)) → (Fin n → ℤ) → ℂ}
    (hf : ∀ α ∈ sigmaLe S k, Summable fun z => ‖f α z‖) {A : Finset ℕ} (hA : #A ≤ k) :
    Summable fun x => ‖blockFun S f A x‖ :=
  Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun _ => norm_sum_le _ _)
    (summable_sum fun α hα => hf α (sigmaBlock_subset_sigmaLe S hA hα))

/-- The coset functions `f_{A₀,α}` (`α ∈ Σ^{A₀}`) are in `ℓ¹`. -/
lemma summable_cosetFun {S : Finset ℕ} [NeZero (blockProd S)] {k : ℕ}
    {f : (Fin n → ZMod (blockProd S)) → (Fin n → ℤ) → ℂ}
    (hf : ∀ α ∈ sigmaLe S k, Summable fun z => ‖f α z‖) {A₀ : Finset ℕ}
    {α : Fin n → ZMod (blockProd S)} (hα : α ∈ sigmaUpper S k A₀) :
    Summable fun x => ‖cosetFun S f A₀ α x‖ := by
  obtain ⟨hd, hc⟩ := mem_sigmaUpper.1 hα
  refine Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun _ => norm_sum_le _ _)
    (summable_sum fun β hβ => hf _ ?_)
  exact sigmaBlock_subset_sigmaLe S ((card_union_le _ _).trans (by omega))
    (add_mem_sigmaBlock_union S hd (mem_sigmaBlock.2 rfl) hβ)

/-- Blueprint Lemma 7.5 (`lem:normdescription`), eq. (7.3) (`eq:normdescription`), in
`ℝ≥0∞`-valued form. Let `S` be a finite set of pairwise coprime integers `> 1`, `k ∈ ℕ`,
`r ≥ 1`, `0 < ε ≤ (100 r q_*^{2rk})⁻¹`, and for each `α ∈ Σ_{≤k}` let `f_α ∈ ℓ¹(ℤⁿ)` have Fourier
transform vanishing off `α + [-ε,ε]ⁿ + ℤⁿ` (the setting of Blueprint Lemma 7.4
(`lem:blockorthog`)). With `f_{A₀,α} = cosetFun S f A₀ α`,
`∑_x |∑_{α ∈ Σ_{≤k}} f_α(x)|^{2r} ≤
C_{k,r} ∑_{A₀ ⊆ S, |A₀| ≤ k} ∑_x (∑_{α ∈ Σ^{A₀}} |f_{A₀,α}(x)|²)^r`,
with `C_{k,r} = normDescConst k r` depending only on `k` and `r`. -/
theorem normdescription_enorm {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} (hr : 0 < r)
    {ε : ℝ} (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    (f : (Fin n → ZMod (blockProd S)) → (Fin n → ℤ) → ℂ)
    (hf : ∀ α ∈ sigmaLe S k, Summable fun z => ‖f α z‖)
    (hsupp : ∀ α ∈ sigmaLe S k, ∀ ξ ∉ ratNbhd (blockProd S) ε α, latFT (f α) ξ = 0) :
    ∑' x, ‖∑ α ∈ sigmaLe S k, f α x‖ₑ ^ (2 * r) ≤
      ENNReal.ofReal (normDescConst k r) *
        ∑ A₀ ∈ S.powerset with #A₀ ≤ k,
          ∑' x, (∑ α ∈ sigmaUpper S k A₀, ‖cosetFun S f A₀ α x‖ₑ ^ 2) ^ r := by
  classical
  set P := S.powerset.filter fun A => #A ≤ k with hP
  set F := blockFun S f with hF
  set C1 : ℝ≥0∞ := ∑ l ∈ range (k + 1), (2 * r * l : ℝ≥0∞) ^ l with hC1
  set C2 := sunflowerConst k r with hC2
  have hFs : ∀ A, #A ≤ k → Summable fun x => ‖F A x‖ := fun A hA => summable_blockFun hf hA
  have hsq : ∀ {g : (Fin n → ℤ) → ℂ}, (Summable fun x => ‖g x‖) →
      Summable fun x => ‖g x‖ ^ 2 :=
    fun hg => summable_pow_of_summable_nonneg (fun _ => norm_nonneg _) hg (by norm_num)
  -- Step 1: superorthogonality of the `f_A` (Lemmas 7.2 and 7.4)
  have h1 : ∑' x, ‖∑ α ∈ sigmaLe S k, f α x‖ₑ ^ (2 * r) ≤
      C1 ^ (2 * r) * ∑' x, ENNReal.ofReal ((∑ A ∈ P, ‖F A x‖ ^ 2) ^ r) := by
    have h := superorth_subset (μ := Measure.count) (𝕜 := ℂ) (r := r) k S F
      (fun A _ hk => memLp_count_of_summable hr (hFs A hk))
      (blockorthog_superorth hS1 hS hε hεr f hf hsupp)
    have h' := pow_le_pow_left₀ zero_le h (2 * r)
    rw [mul_pow, eLpNorm_count_pow_eq_tsum hr, eLpNorm_count_pow_eq_tsum hr] at h'
    convert h' using 2
    · funext x
      rw [Finset.sum_apply, sum_sigmaLe]
      rfl
    · refine tsum_congr fun x => ?_
      rw [enorm_sqrt_pow_two_mul (sum_nonneg fun _ _ => sq_nonneg _),
        ENNReal.ofReal_pow (sum_nonneg fun _ _ => sq_nonneg _)]
  -- Step 2: the weighted sunflower inequality at each point (Lemma 7.3)
  have h2 : ∀ x, ENNReal.ofReal ((∑ A ∈ P, ‖F A x‖ ^ 2) ^ r) ≤
      ENNReal.ofReal C2 * ∑ A₀ ∈ P,
        ∑ t ∈ Fintype.piFinset (fun _ : Fin r => (S \ A₀).powerset) with
            ((∀ i j, i ≠ j → Disjoint (t i) (t j)) ∧ ∀ i, #(A₀ ∪ t i) ≤ k),
          ‖∏ i, F (A₀ ∪ t i) x‖ₑ ^ 2 := by
    intro x
    have h := weighted_sunflower S k r (fun A => ‖F A x‖ ^ 2) (fun _ _ _ => sq_nonneg _)
    refine (ENNReal.ofReal_le_ofReal h).trans (le_of_eq ?_)
    rw [ENNReal.ofReal_mul (zero_le_one.trans (one_le_sunflowerConst k r)),
      ENNReal.ofReal_sum_of_nonneg fun A₀ _ => sum_nonneg fun t _ =>
        prod_nonneg fun i _ => sq_nonneg _]
    congr 1
    refine sum_congr rfl fun A₀ _ => ?_
    rw [ENNReal.ofReal_sum_of_nonneg fun t _ => prod_nonneg fun i _ => sq_nonneg _]
    refine sum_congr rfl fun t _ => ?_
    rw [enorm_pow_eq_ofReal, norm_prod, prod_pow]
  -- Step 3: sum in `x`
  have h3 : ∑' x, ENNReal.ofReal ((∑ A ∈ P, ‖F A x‖ ^ 2) ^ r) ≤
      ENNReal.ofReal C2 * ∑ A₀ ∈ P,
        ∑ t ∈ Fintype.piFinset (fun _ : Fin r => (S \ A₀).powerset) with
            ((∀ i j, i ≠ j → Disjoint (t i) (t j)) ∧ ∀ i, #(A₀ ∪ t i) ≤ k),
          ∑' x, ‖∏ i, F (A₀ ∪ t i) x‖ₑ ^ 2 := by
    refine (ENNReal.tsum_le_tsum h2).trans (le_of_eq ?_)
    rw [ENNReal.tsum_mul_left, Summable.tsum_finsetSum (fun _ _ => ENNReal.summable)]
    congr 1
    exact sum_congr rfl fun A₀ _ => Summable.tsum_finsetSum (fun _ _ => ENNReal.summable)
  -- Step 4: expansion of `‖∏_i f_{A₀ ∪ A_i}‖₂²` by the second orthogonality (Lemma 7.4)
  have h4 : ∀ A₀ ∈ P, ∀ t ∈ (Fintype.piFinset (fun _ : Fin r => (S \ A₀).powerset)).filter
        (fun t => (∀ i j, i ≠ j → Disjoint (t i) (t j)) ∧ ∀ i, #(A₀ ∪ t i) ≤ k),
      ∑' x, ‖∏ i, F (A₀ ∪ t i) x‖ₑ ^ 2 =
        ∑ s ∈ Fintype.piFinset (fun i => sigmaBlock (n := n) S (t i)),
          ∑' x, ‖∏ i, cosetFun S f A₀ (s i) x‖ₑ ^ 2 := by
    intro A₀ _ t ht
    obtain ⟨ht1, hdisj, hcard⟩ := mem_filter.1 ht
    have hA : ∀ i, t i ⊆ S \ A₀ := fun i => mem_powerset.1 (Fintype.mem_piFinset.1 ht1 i)
    have hd : ∀ i, Disjoint (t i) A₀ := fun i =>
      Finset.disjoint_of_subset_left (hA i) Finset.sdiff_disjoint
    have e := blockorthog_norm_sq hS1 hS hε hεr f hf hsupp hA hdisj hcard
    rw [tsum_enorm_pow_eq_ofReal (hsq (summable_norm_prod_fin hr fun i => hFs _ (hcard i))),
      hF, e, ENNReal.ofReal_sum_of_nonneg fun s _ => tsum_nonneg fun x => sq_nonneg _]
    refine sum_congr rfl fun s hs => ?_
    have hsU : ∀ i, s i ∈ sigmaUpper S k A₀ := fun i =>
      sigmaBlock_subset_sigmaUpper S (hd i)
        (by have := hcard i; rw [card_union_of_disjoint (hd i).symm] at this; omega)
        (Fintype.mem_piFinset.1 hs i)
    rw [tsum_enorm_pow_eq_ofReal
      (hsq (summable_norm_prod_fin hr fun i => summable_cosetFun hf (hsU i)))]
  -- Step 5: drop the disjointness of the petals and regroup by petal supports
  have h5 : ∀ A₀ ∈ P,
      ∑ t ∈ Fintype.piFinset (fun _ : Fin r => (S \ A₀).powerset) with
          ((∀ i j, i ≠ j → Disjoint (t i) (t j)) ∧ ∀ i, #(A₀ ∪ t i) ≤ k),
        ∑' x, ‖∏ i, F (A₀ ∪ t i) x‖ₑ ^ 2 ≤
      ∑' x, (∑ α ∈ sigmaUpper S k A₀, ‖cosetFun S f A₀ α x‖ₑ ^ 2) ^ r := by
    intro A₀ hA₀
    rw [sum_congr rfl (h4 A₀ hA₀), ← sum_piFinset_tsum_enorm_prod,
      ← sum_piFinset_sigmaUpper S k r A₀]
    refine sum_le_sum_of_subset fun t ht => ?_
    obtain ⟨ht1, -, hcard⟩ := mem_filter.1 ht
    exact mem_filter.2 ⟨ht1, hcard⟩
  calc ∑' x, ‖∑ α ∈ sigmaLe S k, f α x‖ₑ ^ (2 * r)
      ≤ C1 ^ (2 * r) * ∑' x, ENNReal.ofReal ((∑ A ∈ P, ‖F A x‖ ^ 2) ^ r) := h1
    _ ≤ C1 ^ (2 * r) * (ENNReal.ofReal C2 * ∑ A₀ ∈ P,
          ∑' x, (∑ α ∈ sigmaUpper S k A₀, ‖cosetFun S f A₀ α x‖ₑ ^ 2) ^ r) := by
        gcongr
        exact h3.trans (mul_le_mul_right (sum_le_sum h5) _)
    _ = _ := by rw [ofReal_normDescConst, mul_assoc]

/-- Blueprint Lemma 7.5 (`lem:normdescription`), eq. (7.3) (`eq:normdescription`): in the
setting of Blueprint Lemma 7.4 (`lem:blockorthog`) (see `blockorthog_superorth`), for `r ≥ 1`,
`‖∑_{α ∈ Σ_{≤k}} f_α‖_{2r}^{2r} ≤ C_{k,r} ∑_{|A₀| ≤ k} ‖(f_{A₀,α})_{α ∈ Σ^{A₀}}‖_{ℓ^{2r}(ℓ²)}^{2r}`,
written out as
`∑_x |∑_{α ∈ Σ_{≤k}} f_α(x)|^{2r} ≤
C_{k,r} ∑_{A₀ ⊆ S, |A₀| ≤ k} ∑_x (∑_{α ∈ Σ^{A₀}} |f_{A₀,α}(x)|²)^r`,
with `C_{k,r} = normDescConst k r = (∑_{l ≤ k} (2rl)^l)^{2r} · sunflowerConst k r`, depending
only on `k` and `r`. (All series converge: every sequence involved is in `ℓ¹`.) -/
theorem normdescription {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} (hr : 0 < r)
    {ε : ℝ} (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    (f : (Fin n → ZMod (blockProd S)) → (Fin n → ℤ) → ℂ)
    (hf : ∀ α ∈ sigmaLe S k, Summable fun z => ‖f α z‖)
    (hsupp : ∀ α ∈ sigmaLe S k, ∀ ξ ∉ ratNbhd (blockProd S) ε α, latFT (f α) ξ = 0) :
    ∑' x, ‖∑ α ∈ sigmaLe S k, f α x‖ ^ (2 * r) ≤
      normDescConst k r *
        ∑ A₀ ∈ S.powerset with #A₀ ≤ k,
          ∑' x, (∑ α ∈ sigmaUpper S k A₀, ‖cosetFun S f A₀ α x‖ ^ 2) ^ r := by
  classical
  have h := normdescription_enorm hS1 hS hr hε hεr f hf hsupp
  have hsq : ∀ {g : (Fin n → ℤ) → ℂ}, (Summable fun x => ‖g x‖) →
      Summable fun x => ‖g x‖ ^ 2 :=
    fun hg => summable_pow_of_summable_nonneg (fun _ => norm_nonneg _) hg (by norm_num)
  have hR : ∀ A₀ : Finset ℕ,
      Summable fun x => (∑ α ∈ sigmaUpper S k A₀, ‖cosetFun S f A₀ α x‖ ^ 2) ^ r := by
    intro A₀
    have e : ∀ x, (∑ α ∈ sigmaUpper S k A₀, ‖cosetFun S f A₀ α x‖ ^ 2) ^ r =
        ∑ s ∈ Fintype.piFinset (fun _ : Fin r => sigmaUpper (n := n) S k A₀),
          ‖∏ i, cosetFun S f A₀ (s i) x‖ ^ 2 := by
      intro x
      rw [sum_pow']
      exact sum_congr rfl fun s _ => by rw [norm_prod, prod_pow]
    simp_rw [e]
    exact summable_sum fun s hs => hsq (summable_norm_prod_fin hr fun i =>
      summable_cosetFun hf (Fintype.mem_piFinset.1 hs i))
  have hL : Summable fun x => ‖∑ α ∈ sigmaLe S k, f α x‖ ^ (2 * r) :=
    summable_pow_of_summable_nonneg (fun _ => norm_nonneg _)
      (Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun _ => norm_sum_le _ _)
        (summable_sum fun α hα => hf α hα)) (by omega)
  have hnn : ∀ A₀ : Finset ℕ,
      0 ≤ ∑' x, (∑ α ∈ sigmaUpper S k A₀, ‖cosetFun S f A₀ α x‖ ^ 2) ^ r := fun A₀ =>
    tsum_nonneg fun x => by positivity
  rw [← ENNReal.ofReal_le_ofReal_iff
      (mul_nonneg (normDescConst_nonneg k r) (sum_nonneg fun A₀ _ => hnn A₀)),
    ENNReal.ofReal_mul (normDescConst_nonneg k r),
    ENNReal.ofReal_sum_of_nonneg (fun A₀ _ => hnn A₀), ← tsum_enorm_pow_eq_ofReal hL]
  refine h.trans (le_of_eq ?_)
  congr 1
  refine sum_congr rfl fun A₀ _ => ?_
  rw [ENNReal.ofReal_tsum_of_nonneg (fun x => by positivity) (hR A₀)]
  refine tsum_congr fun x => ?_
  rw [ENNReal.ofReal_pow (sum_nonneg fun _ _ => sq_nonneg _),
    ENNReal.ofReal_sum_of_nonneg fun _ _ => sq_nonneg _]
  simp_rw [enorm_pow_eq_ofReal]

/-- Blueprint Lemma 7.5 (`lem:normdescription`), eq. (7.3) (`eq:normdescription`), in
`eLpNorm` form on `ℤⁿ` with counting measure: for `r ≥ 1`,
`‖∑_{α ∈ Σ_{≤k}} f_α‖_{2r}^{2r} ≤ C_{k,r} ∑_{A₀ ⊆ S, |A₀| ≤ k}
‖(∑_{α ∈ Σ^{A₀}} |f_{A₀,α}|²)^{1/2}‖_{2r}^{2r}` with `C_{k,r} = normDescConst k r`. -/
theorem normdescription_eLpNorm {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} (hr : 0 < r)
    {ε : ℝ} (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    (f : (Fin n → ZMod (blockProd S)) → (Fin n → ℤ) → ℂ)
    (hf : ∀ α ∈ sigmaLe S k, Summable fun z => ‖f α z‖)
    (hsupp : ∀ α ∈ sigmaLe S k, ∀ ξ ∉ ratNbhd (blockProd S) ε α, latFT (f α) ξ = 0) :
    eLpNorm (∑ α ∈ sigmaLe S k, f α) (ENNReal.ofReal (2 * r)) Measure.count ^ (2 * r) ≤
      ENNReal.ofReal (normDescConst k r) *
        ∑ A₀ ∈ S.powerset with #A₀ ≤ k,
          eLpNorm (fun x => Real.sqrt (∑ α ∈ sigmaUpper S k A₀, ‖cosetFun S f A₀ α x‖ ^ 2))
            (ENNReal.ofReal (2 * r)) Measure.count ^ (2 * r) := by
  rw [eLpNorm_count_pow_eq_tsum hr]
  simp_rw [eLpNorm_count_pow_eq_tsum hr]
  refine (le_of_eq ?_).trans ((normdescription_enorm hS1 hS hr hε hεr f hf hsupp).trans
    (le_of_eq ?_))
  · exact tsum_congr fun x => by rw [Finset.sum_apply]
  · congr 1
    refine sum_congr rfl fun A₀ _ => tsum_congr fun x => ?_
    rw [enorm_sqrt_pow_two_mul (sum_nonneg fun _ _ => sq_nonneg _),
      ENNReal.ofReal_sum_of_nonneg fun _ _ => sq_nonneg _]
    simp_rw [enorm_pow_eq_ofReal]

end NormDescription


/-! ### Blueprint Lemma 7.6 (`lem:companion`): companion projections -/

section Companion

open MeasureTheory Set Real
open scoped ComplexConjugate FourierTransform ContDiff SchwartzMap LineDeriv Laplacian

/-- The one-dimensional profile of the companion cutoff: a smooth bump on `ℝ` equal to `1` on
`[-1,1]` and vanishing outside `(-2,2)`. -/
noncomputable def companionBump : ContDiffBump (0 : ℝ) := ⟨1, 2, one_pos, one_lt_two⟩

/-- The fixed smooth product cutoff `θ(ξ) = ∏ᵢ ψ(ξᵢ)` of Blueprint Lemma 7.6 (`lem:companion`). -/
noncomputable def companionCutoff (n : ℕ) (ξ : EuclideanSpace ℝ (Fin n)) : ℝ :=
  ∏ i, companionBump (ξ i)

lemma companionCutoff_nonneg (ξ : EuclideanSpace ℝ (Fin n)) : 0 ≤ companionCutoff n ξ :=
  Finset.prod_nonneg fun _ _ => companionBump.nonneg

lemma companionCutoff_le_one (ξ : EuclideanSpace ℝ (Fin n)) : companionCutoff n ξ ≤ 1 :=
  Finset.prod_le_one₀ (fun _ _ => companionBump.nonneg) fun _ _ => companionBump.le_one

lemma companionCutoff_eq_one {ξ : EuclideanSpace ℝ (Fin n)} (h : ∀ i, |ξ i| ≤ 1) :
    companionCutoff n ξ = 1 :=
  Finset.prod_eq_one fun i _ => companionBump.one_of_mem_closedBall (by
    rw [Metric.mem_closedBall, dist_zero_right, Real.norm_eq_abs]; exact h i)

lemma companionCutoff_eq_zero {ξ : EuclideanSpace ℝ (Fin n)} (h : ¬ ∀ i, |ξ i| < 2) :
    companionCutoff n ξ = 0 := by
  push Not at h
  obtain ⟨i, hi⟩ := h
  refine Finset.prod_eq_zero (Finset.mem_univ i) ?_
  rw [← Function.notMem_support, companionBump.support_eq]
  simp only [Metric.mem_ball, dist_zero_right, Real.norm_eq_abs, not_lt]
  exact hi

lemma contDiff_companionCutoff : ContDiff ℝ ∞ (companionCutoff n) := by
  unfold companionCutoff
  refine contDiff_prod fun i _ => companionBump.contDiff.comp ?_
  exact (EuclideanSpace.proj (𝕜 := ℝ) i).contDiff

lemma isCompact_box (c : ℝ) : IsCompact {ξ : EuclideanSpace ℝ (Fin n) | ∀ i, |ξ i| ≤ c} := by
  have : {ξ : EuclideanSpace ℝ (Fin n) | ∀ i, |ξ i| ≤ c} =
      (EuclideanSpace.equiv (Fin n) ℝ) ⁻¹' Set.pi Set.univ fun _ => Set.Icc (-c) c := by
    ext ξ; simp [abs_le, Pi.le_def, forall_and]
  rw [this]
  exact (EuclideanSpace.equiv (Fin n) ℝ).toHomeomorph.isCompact_preimage.2
    (isCompact_univ_pi fun _ => isCompact_Icc)

lemma hasCompactSupport_companionCutoff : HasCompactSupport (companionCutoff n) := by
  refine HasCompactSupport.intro (isCompact_box 2) fun ξ hξ => companionCutoff_eq_zero ?_
  intro h; exact hξ fun i => (h i).le

/-- The cutoff `θ` as a (complex-valued) Schwartz function. -/
noncomputable def cutoffSchwartz (n : ℕ) : 𝓢(EuclideanSpace ℝ (Fin n), ℂ) :=
  (hasCompactSupport_companionCutoff (n := n)).comp_left (g := Complex.ofReal) Complex.ofReal_zero
    |>.toSchwartzMap (Complex.ofRealCLM.contDiff.comp contDiff_companionCutoff)

@[simp] lemma cutoffSchwartz_apply (ξ : EuclideanSpace ℝ (Fin n)) :
    cutoffSchwartz n ξ = (companionCutoff n ξ : ℂ) := rfl

/-- One step `L f = f - (4π²)⁻¹ Δ f` of the operator whose `(n+1)`-th power multiplies the inverse
Fourier transform by `(1 + |y|²)^{n+1}`. -/
noncomputable def lapStep (f : 𝓢(EuclideanSpace ℝ (Fin n), ℂ)) :
    𝓢(EuclideanSpace ℝ (Fin n), ℂ) :=
  f - ((4 * π ^ 2 : ℝ)⁻¹ : ℂ) • Δ f

lemma fourierInv_lineDeriv_apply (f : 𝓢(EuclideanSpace ℝ (Fin n), ℂ))
    (m y : EuclideanSpace ℝ (Fin n)) :
    𝓕⁻ (∂_{m} f) y = -(2 * π * Complex.I) * (inner ℝ y m : ℂ) * 𝓕⁻ f y := by
  rw [SchwartzMap.fourierInv_lineDerivOp_eq]
  have : (inner ℝ · m).HasTemperateGrowth := by fun_prop
  simp [SchwartzMap.smulLeftCLM_apply_apply this]
  ring

lemma fourierInv_laplacian_apply (f : 𝓢(EuclideanSpace ℝ (Fin n), ℂ))
    (y : EuclideanSpace ℝ (Fin n)) :
    𝓕⁻ (Δ f) y = -(4 * π ^ 2 * ‖y‖ ^ 2 : ℝ) * 𝓕⁻ f y := by
  set b := EuclideanSpace.basisFun (Fin n) ℝ
  rw [SchwartzMap.laplacian_eq_sum b, FourierTransform.fourierInv_sum, _root_.sum_apply]
  simp_rw [fourierInv_lineDeriv_apply]
  rw [← b.sum_sq_inner_left y]
  push_cast
  rw [Finset.mul_sum, ← Finset.sum_neg_distrib, Finset.sum_mul]
  refine Finset.sum_congr rfl fun i _ => ?_
  have : (2 * π * Complex.I) ^ 2 = -(4 * π ^ 2) := by
    rw [mul_pow, Complex.I_sq]; ring
  linear_combination (inner ℝ y (b i) : ℂ) ^ 2 * 𝓕⁻ f y * this

lemma fourierInv_lapStep_apply (f : 𝓢(EuclideanSpace ℝ (Fin n), ℂ))
    (y : EuclideanSpace ℝ (Fin n)) :
    𝓕⁻ (lapStep f) y = (1 + ‖y‖ ^ 2 : ℝ) * 𝓕⁻ f y := by
  rw [lapStep, sub_eq_add_neg, FourierTransform.fourierInv_add,
    FourierTransform.fourierInv_neg, FourierTransform.fourierInv_smul]
  simp only [add_apply, neg_apply, smul_apply,
    fourierInv_laplacian_apply, smul_eq_mul]
  have : (π : ℂ) ≠ 0 := by exact_mod_cast Real.pi_ne_zero
  push_cast
  field_simp

lemma tsupport_lineDeriv_subset (g : 𝓢(EuclideanSpace ℝ (Fin n), ℂ))
    (m : EuclideanSpace ℝ (Fin n)) :
    tsupport ⇑(∂_{m} g : 𝓢(EuclideanSpace ℝ (Fin n), ℂ)) ⊆ tsupport g :=
  closure_minimal (fun x hx => support_fderiv_subset (𝕜 := ℝ) (f := ⇑g)
    (show fderiv ℝ g x ≠ 0 from fun h => hx (by
      rw [SchwartzMap.lineDerivOp_apply_eq_fderiv, h]; rfl))) (isClosed_tsupport _)

lemma support_laplacian_subset (f : 𝓢(EuclideanSpace ℝ (Fin n), ℂ)) :
    Function.support ⇑(Δ f : 𝓢(EuclideanSpace ℝ (Fin n), ℂ)) ⊆ tsupport f := by
  set b := EuclideanSpace.basisFun (Fin n) ℝ
  intro x hx
  rw [SchwartzMap.laplacian_eq_sum b, Function.mem_support, _root_.sum_apply] at hx
  obtain ⟨i, -, hi⟩ := Finset.exists_ne_zero_of_sum_ne_zero hx
  exact tsupport_lineDeriv_subset f (b i) (tsupport_lineDeriv_subset _ (b i)
    (subset_tsupport _ hi))

lemma support_lapStep_subset (f : 𝓢(EuclideanSpace ℝ (Fin n), ℂ)) :
    Function.support (lapStep f) ⊆ tsupport f := by
  intro x hx
  by_contra h
  apply hx
  have h1 : f x = 0 := image_eq_zero_of_notMem_tsupport h
  have h2 : (Δ f) x = 0 := by
    by_contra h2; exact h (support_laplacian_subset f h2)
  simp [lapStep, h1, h2]

/-- The Schwartz function `Φ = L^{n+1} θ`, whose inverse Fourier transform is
`(1 + |y|²)^{n+1} θ̌(y)` and whose support lies in `[-2,2]ⁿ` (the weighted bump of the proof of
Blueprint Lemma 7.6 (`lem:companion`)). -/
noncomputable def companionPhi (n : ℕ) : 𝓢(EuclideanSpace ℝ (Fin n), ℂ) :=
  lapStep^[n + 1] (cutoffSchwartz n)

lemma fourierInv_lapStep_iterate (f : 𝓢(EuclideanSpace ℝ (Fin n), ℂ)) (j : ℕ)
    (y : EuclideanSpace ℝ (Fin n)) :
    𝓕⁻ (lapStep^[j] f) y = ((1 + ‖y‖ ^ 2) ^ j : ℝ) * 𝓕⁻ f y := by
  induction j with
  | zero => simp
  | succ j ih =>
    rw [Function.iterate_succ_apply', fourierInv_lapStep_apply, ih]
    push_cast; ring

lemma fourierInv_companionPhi (y : EuclideanSpace ℝ (Fin n)) :
    𝓕⁻ (companionPhi n) y = ((1 + ‖y‖ ^ 2) ^ (n + 1) : ℝ) * 𝓕⁻ (cutoffSchwartz n) y :=
  fourierInv_lapStep_iterate _ _ _

lemma isClosed_box (c : ℝ) : IsClosed {ξ : EuclideanSpace ℝ (Fin n) | ∀ i, |ξ i| ≤ c} :=
  (isCompact_box c).isClosed

lemma tsupport_cutoffSchwartz_subset :
    tsupport ⇑(cutoffSchwartz n) ⊆ {ξ : EuclideanSpace ℝ (Fin n) | ∀ i, |ξ i| ≤ 2} := by
  refine closure_minimal (fun ξ hξ => ?_) (isClosed_box 2)
  by_contra h
  apply hξ
  rw [cutoffSchwartz_apply, companionCutoff_eq_zero, Complex.ofReal_zero]
  intro h'; exact h fun i => (h' i).le

lemma tsupport_lapStep_iterate_subset (j : ℕ) :
    tsupport ⇑(lapStep^[j] (cutoffSchwartz n)) ⊆
      {ξ : EuclideanSpace ℝ (Fin n) | ∀ i, |ξ i| ≤ 2} := by
  induction j with
  | zero => exact tsupport_cutoffSchwartz_subset
  | succ j ih =>
    rw [Function.iterate_succ_apply']
    exact closure_minimal ((support_lapStep_subset _).trans ih) (isClosed_box 2)

lemma companionPhi_eq_zero {ξ : EuclideanSpace ℝ (Fin n)} (h : ¬ ∀ i, |ξ i| ≤ 2) :
    companionPhi n ξ = 0 :=
  image_eq_zero_of_notMem_tsupport fun h' => h (tsupport_lapStep_iterate_subset _ h')

/-- `θ_ε(ξ) = θ(ξ/ε)` (Blueprint Lemma 7.6 (`lem:companion`)). -/
noncomputable def cutoffEps (n : ℕ) (ε : ℝ) (ξ : EuclideanSpace ℝ (Fin n)) : ℂ :=
  (companionCutoff n (ε⁻¹ • ξ) : ℂ)

/-- `φ_ε(ξ) = Φ(ξ/ε)`: its inverse Fourier transform is `(1 + ε²|y|²)^{n+1} θ̌_ε(y)`. -/
noncomputable def phiEps (n : ℕ) (ε : ℝ) (ξ : EuclideanSpace ℝ (Fin n)) : ℂ :=
  companionPhi n (ε⁻¹ • ξ)

lemma norm_cutoffEps_le (ε : ℝ) (ξ : EuclideanSpace ℝ (Fin n)) : ‖cutoffEps n ε ξ‖ ≤ 1 := by
  rw [cutoffEps, Complex.norm_real, Real.norm_of_nonneg (companionCutoff_nonneg _)]
  exact companionCutoff_le_one _

lemma cutoffEps_eq_one {ε : ℝ} (hε : 0 < ε) {ξ : EuclideanSpace ℝ (Fin n)}
    (h : ∀ i, |ξ i| ≤ ε) : cutoffEps n ε ξ = 1 := by
  rw [cutoffEps, companionCutoff_eq_one, Complex.ofReal_one]
  intro i
  simp only [PiLp.smul_apply, smul_eq_mul, abs_mul, abs_inv, abs_of_pos hε]
  rw [inv_mul_le_iff₀ hε, mul_one]; exact h i

lemma abs_le_of_smul_box {ε : ℝ} (hε : 0 < ε) {ξ : EuclideanSpace ℝ (Fin n)}
    (h : ∀ i, |(ε⁻¹ • ξ) i| ≤ 2) (i : Fin n) : |ξ i| ≤ 2 * ε := by
  have := h i
  simp only [PiLp.smul_apply, smul_eq_mul, abs_mul, abs_inv, abs_of_pos hε] at this
  rwa [inv_mul_le_iff₀ hε, mul_comm] at this

lemma cutoffEps_eq_zero {ε : ℝ} (hε : 0 < ε) {ξ : EuclideanSpace ℝ (Fin n)}
    (h : ¬ ∀ i, |ξ i| ≤ 2 * ε) : cutoffEps n ε ξ = 0 := by
  rw [cutoffEps, companionCutoff_eq_zero, Complex.ofReal_zero]
  intro h'; exact h (abs_le_of_smul_box hε fun i => (h' i).le)

lemma phiEps_eq_zero {ε : ℝ} (hε : 0 < ε) {ξ : EuclideanSpace ℝ (Fin n)}
    (h : ¬ ∀ i, |ξ i| ≤ 2 * ε) : phiEps n ε ξ = 0 := by
  rw [phiEps, companionPhi_eq_zero]
  intro h'; exact h (abs_le_of_smul_box hε h')

lemma continuous_cutoffEps (ε : ℝ) : Continuous (cutoffEps n ε) :=
  Complex.continuous_ofReal.comp (contDiff_companionCutoff.continuous.comp
    (continuous_const_smul _))

lemma continuous_phiEps (ε : ℝ) : Continuous (phiEps n ε) :=
  (companionPhi n).continuous.comp (continuous_const_smul _)

lemma integrable_cutoffEps {ε : ℝ} (hε : 0 < ε) : Integrable (cutoffEps n ε) :=
  (continuous_cutoffEps ε).integrable_of_hasCompactSupport
    (HasCompactSupport.intro (isCompact_box (2 * ε)) fun _ h => cutoffEps_eq_zero hε h)

lemma integrable_phiEps {ε : ℝ} (hε : 0 < ε) : Integrable (phiEps n ε) :=
  (continuous_phiEps ε).integrable_of_hasCompactSupport
    (HasCompactSupport.intro (isCompact_box (2 * ε)) fun _ h => phiEps_eq_zero hε h)

lemma fourierInv_cutoffEps {ε : ℝ} (hε : 0 < ε) (y : EuclideanSpace ℝ (Fin n)) :
    𝓕⁻ (cutoffEps n ε) y = (ε ^ n : ℝ) * 𝓕⁻ (cutoffSchwartz n) (ε • y) := by
  have := fourierInv_comp_inv_smul (⇑(cutoffSchwartz n)) hε y
  rw [SchwartzMap.fourierInv_coe]
  exact this

lemma fourierInv_phiEps {ε : ℝ} (hε : 0 < ε) (y : EuclideanSpace ℝ (Fin n)) :
    𝓕⁻ (phiEps n ε) y = ((1 + ε ^ 2 * ‖y‖ ^ 2) ^ (n + 1) : ℝ) * 𝓕⁻ (cutoffEps n ε) y := by
  have := fourierInv_comp_inv_smul (⇑(companionPhi n)) hε y
  change 𝓕⁻ (fun ξ => companionPhi n (ε⁻¹ • ξ)) y = _
  rw [this, fourierInv_cutoffEps hε, ← SchwartzMap.fourierInv_coe,
    fourierInv_companionPhi, norm_smul, Real.norm_of_nonneg hε.le]
  push_cast; ring

/-- The constant `∫ |Φ|²`. -/
noncomputable def companionPhiL2 (n : ℕ) : ℝ := ∫ ξ, ‖companionPhi n ξ‖ ^ 2

lemma integral_norm_sq_phiEps {ε : ℝ} (hε : 0 < ε) :
    ∫ ξ, ‖phiEps n ε ξ‖ ^ 2 = ε ^ n * companionPhiL2 n := by
  have := Measure.integral_comp_inv_smul_of_nonneg (μ := volume)
    (fun ξ : EuclideanSpace ℝ (Fin n) => ‖companionPhi n ξ‖ ^ 2) hε.le
  rw [finrank_euclideanSpace_fin, smul_eq_mul] at this
  exact this

/-! ### Bessel's inequality with the symbol in `L²` -/

/-- Bessel's inequality for lattice multipliers with the exact `L²` bound: for `m` bounded and
a.e. strongly measurable on `[0,1)ⁿ` and `f ∈ ℓ¹`,
`∑_x |m(D) f(x)|² ≤ ∫_{[0,1)ⁿ} |m|² |f̂|²`. -/
theorem summable_and_tsum_norm_sq_latMult_le_integral {m : EuclideanSpace ℝ (Fin n) → ℂ} {A : ℝ}
    (hm : AEStronglyMeasurable m (volume.restrict (torusCube n)))
    (hA : ∀ ξ ∈ torusCube n, ‖m ξ‖ ≤ A) {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) :
    Summable (fun x => ‖latMult m f x‖ ^ 2) ∧
      ∑' x, ‖latMult m f x‖ ^ 2 ≤ ∫ ξ in torusCube n, ‖m ξ‖ ^ 2 * ‖latFT f ξ‖ ^ 2 := by
  set μ := volume.restrict (torusCube n)
  set B := ∑' z, ‖f z‖
  have hg_meas : AEStronglyMeasurable (fun ξ => m ξ * latFT f ξ) μ :=
    hm.mul (continuous_latFT hf).aestronglyMeasurable
  have hbound : ∀ ξ ∈ torusCube n, ‖m ξ * latFT f ξ‖ ≤ A * ‖latFT f ξ‖ := fun ξ hξ => by
    rw [norm_mul]; exact mul_le_mul_of_nonneg_right (hA ξ hξ) (norm_nonneg _)
  have hgL : MemLp (fun ξ => m ξ * latFT f ξ) 2 μ :=
    MemLp.of_bound hg_meas (|A| * B) (ae_restrict_of_forall_mem measurableSet_torusCube
      fun ξ hξ => (hbound ξ hξ).trans (mul_le_mul (le_abs_self A) (norm_latFT_le hf ξ)
        (norm_nonneg _) (abs_nonneg A)))
  set g := hgL.toLp
  have hcoe := hgL.coeFn_toLp
  have hinner : ∀ y, inner ℂ (torusChar n y) g = latMult m f (-y) := by
    intro y
    rw [L2.inner_def, latMult]
    refine integral_congr_ae ?_
    filter_upwards [hcoe, MemLp.coeFn_toLp (μ := μ) (p := 2)
      (f := fun ξ => eC (inner ℝ (latEmbed y) ξ)) (MemLp.of_bound (by fun_prop) 1
        (Filter.Eventually.of_forall fun ξ => le_of_eq (norm_eC _)))] with ξ hg hy
    simp only [torusChar] at *
    rw [hg, hy, RCLike.inner_apply', conj_eC, latEmbed_neg, inner_neg_left]
    ring
  have hnorm : ‖g‖ ^ 2 = ∫ ξ in torusCube n, ‖m ξ * latFT f ξ‖ ^ 2 := by
    rw [@norm_sq_eq_re_inner ℂ, L2.inner_def]
    have : ∫ ξ, (inner ℂ (g ξ) (g ξ) : ℂ) ∂μ =
        ((∫ ξ in torusCube n, ‖m ξ * latFT f ξ‖ ^ 2 : ℝ) : ℂ) := by
      rw [← integral_complex_ofReal]
      refine integral_congr_ae ?_
      filter_upwards [hcoe] with ξ hξ
      rw [hξ, inner_self_eq_norm_sq_to_K]; push_cast; rfl
    rw [this]; exact Complex.ofReal_re _
  have hsum := (orthonormal_torusChar (n := n)).inner_products_summable g
  have htsum := (orthonormal_torusChar (n := n)).tsum_inner_products_le g
  simp_rw [hinner] at hsum htsum
  refine ⟨(Equiv.neg _).summable_iff.1 hsum, ?_⟩
  rw [← (Equiv.neg (Fin n → ℤ)).tsum_eq]
  refine htsum.trans (le_of_eq ?_)
  rw [hnorm]
  congr 1; funext ξ; rw [norm_mul, mul_pow]

/-- The unit impulse `δ₀` on `ℤⁿ`. -/
def latDelta (n : ℕ) (z : Fin n → ℤ) : ℂ := if z = 0 then 1 else 0

lemma summable_latDelta : Summable fun z => ‖latDelta n z‖ :=
  summable_of_ne_finset_zero (s := {0}) fun z hz => by
    simp only [Finset.mem_singleton] at hz; simp [latDelta, hz]

lemma latFT_latDelta (ξ : EuclideanSpace ℝ (Fin n)) : latFT (latDelta n) ξ = 1 := by
  unfold latFT latDelta
  rw [tsum_eq_single 0 fun z hz => by simp [hz]]
  simp [latEmbed_zero, eC_zero]

lemma latMult_latDelta (m : EuclideanSpace ℝ (Fin n) → ℂ) :
    latMult m (latDelta n) = latKernel m := by
  funext y; simp [latMult, latKernel, latFT_latDelta]

/-- Bessel's inequality for inverse Fourier coefficients: for `m` bounded and a.e. strongly
measurable on `[0,1)ⁿ`, `∑_y |m̌(y)|² ≤ ∫_{[0,1)ⁿ} |m|²`. -/
theorem summable_and_tsum_norm_sq_latKernel_le {m : EuclideanSpace ℝ (Fin n) → ℂ} {A : ℝ}
    (hm : AEStronglyMeasurable m (volume.restrict (torusCube n)))
    (hA : ∀ ξ ∈ torusCube n, ‖m ξ‖ ≤ A) :
    Summable (fun y => ‖latKernel m y‖ ^ 2) ∧
      ∑' y, ‖latKernel m y‖ ^ 2 ≤ ∫ ξ in torusCube n, ‖m ξ‖ ^ 2 := by
  have h := summable_and_tsum_norm_sq_latMult_le_integral hm hA (summable_latDelta (n := n))
  simp only [latMult_latDelta, latFT_latDelta, norm_one, one_pow, mul_one] at h
  exact h

/-! ### Disjointness of the bumps at the centers of `Σ_{≤k}` -/

lemma one_le_of_le_eps {r m q : ℕ} {ε : ℝ} (hε : 0 < ε)
    (hεr : ε ≤ (100 * r * (q : ℝ) ^ m)⁻¹) : 1 ≤ r := by
  rcases Nat.eq_zero_or_pos r with rfl | hr
  · simp at hεr; linarith
  · exact hr

lemma four_mul_lt_one_of_le_eps {r m q : ℕ} (hq : 1 ≤ q) {ε : ℝ} (hε : 0 < ε)
    (hεr : ε ≤ (100 * r * (q : ℝ) ^ m)⁻¹) : 4 * ε < 1 := by
  have h1 := four_mul_lt_of_le_eps hq hεr
  have hr : (1 : ℝ) ≤ r := by exact_mod_cast one_le_of_le_eps hε hεr
  have h2 : ((q : ℝ) ^ m)⁻¹ ≤ 1 := inv_le_one_of_one_le₀ (one_le_pow₀ (by exact_mod_cast hq))
  nlinarith

/-- Two lattice points within `2ε < 1/2` of the same point coincide. -/
lemma eq_of_abs_sub_intCast_le {ε : ℝ} (hε4 : 4 * ε < 1) {η : EuclideanSpace ℝ (Fin n)}
    {z z' : Fin n → ℤ} (h : ∀ i, |η i - z i| ≤ 2 * ε) (h' : ∀ i, |η i - z' i| ≤ 2 * ε) :
    z = z' := by
  funext i
  have h1 := h i
  have h2 := h' i
  have h3 : |((z i - z' i : ℤ) : ℝ)| < 1 := by
    push_cast
    calc |(z i : ℝ) - z' i| = |(η i - z' i) - (η i - z i)| := by ring_nf
      _ ≤ |η i - z' i| + |η i - z i| := abs_sub _ _
      _ < 1 := by linarith
  have := Int.abs_lt_one_iff.1 (by exact_mod_cast h3)
  omega

/-- The separation property (7.1) for two centers: if `ξ` is within `2ε` (in each coordinate,
modulo `ℤⁿ`) of two centers `γ, γ' ∈ Σ_{≤k}`, then `γ = γ'`. -/
theorem eq_of_near_ratPt {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} {ε : ℝ}
    (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    {γ γ' : Fin n → ZMod (blockProd S)} (hγ : γ ∈ sigmaLe S k) (hγ' : γ' ∈ sigmaLe S k)
    {ξ : EuclideanSpace ℝ (Fin n)} {z z' : Fin n → ℤ}
    (h : ∀ i, |ξ i - ratPt (blockProd S) γ i - z i| ≤ 2 * ε)
    (h' : ∀ i, |ξ i - ratPt (blockProd S) γ' i - z' i| ≤ 2 * ε) : γ = γ' := by
  by_contra hne
  have hr := one_le_of_le_eps hε hεr
  have hsep := separation hS1 hS hε hεr (Finset.univ : Finset (Fin 2)) (by simp; omega)
    ![γ, γ'] (by intro j _; fin_cases j <;> simpa) ![1, -1]
    (by intro j _; fin_cases j <;> simp)
    (by simp [Fin.sum_univ_two, ← sub_eq_add_neg, sub_eq_zero, hne])
    ![ξ - ratPt (blockProd S) γ - latEmbed z, ξ - ratPt (blockProd S) γ' - latEmbed z']
    (by
      intro j _ i
      fin_cases j
      · simpa [latEmbed_apply] using h i
      · simpa [latEmbed_apply] using h' i)
  apply hsep
  refine ⟨z' - z, ?_⟩
  simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one, one_smul,
    neg_smul, latEmbed_sub]
  abel

/-- Among the members of a family at most one of which is nonzero, the square of the norm of the
sum is the sum of the squares of the norms. -/
lemma norm_sq_tsum_of_atMostOne {ι : Type*} (a : ι → ℂ)
    (h : ∀ i j, a i ≠ 0 → a j ≠ 0 → i = j) : ‖∑' i, a i‖ ^ 2 = ∑' i, ‖a i‖ ^ 2 := by
  by_cases hex : ∃ i, a i ≠ 0
  · obtain ⟨i, hi⟩ := hex
    rw [tsum_eq_single i fun j hj => by by_contra h'; exact hj (h j i h' hi),
      tsum_eq_single i fun j hj => by
        have : a j = 0 := by by_contra h'; exact hj (h j i h' hi)
        simp [this]]
  · push Not at hex
    simp [hex]

lemma norm_sq_sum_of_atMostOne {ι : Type*} (s : Finset ι) (a : ι → ℂ)
    (h : ∀ i ∈ s, ∀ j ∈ s, a i ≠ 0 → a j ≠ 0 → i = j) :
    ‖∑ i ∈ s, a i‖ ^ 2 = ∑ i ∈ s, ‖a i‖ ^ 2 := by
  by_cases hex : ∃ i ∈ s, a i ≠ 0
  · obtain ⟨i, his, hi⟩ := hex
    rw [Finset.sum_eq_single_of_mem i his fun j hjs hj => by
        by_contra h'; exact hj (h j hjs i his h' hi),
      Finset.sum_eq_single_of_mem i his fun j hjs hj => by
        have : a j = 0 := by by_contra h'; exact hj (h j hjs i his h' hi)
        simp [this]]
  · push Not at hex
    rw [Finset.sum_eq_zero hex, Finset.sum_eq_zero fun i hi => by simp [hex i hi]]
    simp

lemma sum_le_of_atMostOne {ι : Type*} (s : Finset ι) (a : ι → ℝ) {B : ℝ} (hB0 : 0 ≤ B)
    (hB : ∀ i ∈ s, a i ≤ B) (h : ∀ i ∈ s, ∀ j ∈ s, a i ≠ 0 → a j ≠ 0 → i = j) :
    ∑ i ∈ s, a i ≤ B := by
  by_cases hex : ∃ i ∈ s, a i ≠ 0
  · obtain ⟨i, his, hi⟩ := hex
    rw [Finset.sum_eq_single_of_mem i his fun j hjs hj => by
        by_contra h'; exact hj (h j hjs i his h' hi)]
    exact hB i his
  · push Not at hex
    rw [Finset.sum_eq_zero hex]; exact hB0

lemma exists_ne_zero_of_periodize_ne_zero {m : EuclideanSpace ℝ (Fin n) → ℂ}
    {η : EuclideanSpace ℝ (Fin n)} (h : periodize m η ≠ 0) :
    ∃ z : Fin n → ℤ, m (η - latEmbed z) ≠ 0 := by
  by_contra h'
  push Not at h'
  exact h (by simp [periodize, h'])

section Bumps

variable {m : EuclideanSpace ℝ (Fin n) → ℂ} {ε : ℝ}
  (hmε : ∀ η, m η ≠ 0 → ∀ i, |η i| ≤ 2 * ε)
include hmε

/-- For a symbol supported in `[-2ε, 2ε]ⁿ` with `4ε < 1`, at most one lattice translate is
nonzero at any point. -/
lemma periodize_atMostOne (hε4 : 4 * ε < 1) (η : EuclideanSpace ℝ (Fin n)) (z z' : Fin n → ℤ)
    (hz : m (η - latEmbed z) ≠ 0) (hz' : m (η - latEmbed z') ≠ 0) : z = z' :=
  eq_of_abs_sub_intCast_le hε4 (fun i => by simpa using hmε _ hz i)
    (fun i => by simpa using hmε _ hz' i)

lemma norm_periodize_le (hε4 : 4 * ε < 1) {M : ℝ} (hM0 : 0 ≤ M) (hM : ∀ η, ‖m η‖ ≤ M)
    (η : EuclideanSpace ℝ (Fin n)) : ‖periodize m η‖ ≤ M := by
  by_cases hex : ∃ z : Fin n → ℤ, m (η - latEmbed z) ≠ 0
  · obtain ⟨z, hz⟩ := hex
    rw [periodize, tsum_eq_single z fun z' hz' => by
      by_contra h; exact hz' (periodize_atMostOne hmε hε4 η z' z h hz)]
    exact hM _
  · push Not at hex
    simp [periodize, hex, hM0]

lemma norm_sq_periodize (hε4 : 4 * ε < 1) (η : EuclideanSpace ℝ (Fin n)) :
    ‖periodize m η‖ ^ 2 = ∑' z : Fin n → ℤ, ‖m (η - latEmbed z)‖ ^ 2 :=
  norm_sq_tsum_of_atMostOne _ fun z z' hz hz' => periodize_atMostOne hmε hε4 η z z' hz hz'

/-- At most one center `γ ∈ Σ_{≤k}` has `m_per(ξ - γ) ≠ 0`. -/
lemma periodize_center_atMostOne {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ}
    (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    {γ γ' : Fin n → ZMod (blockProd S)} (hγ : γ ∈ sigmaLe S k) (hγ' : γ' ∈ sigmaLe S k)
    (ξ : EuclideanSpace ℝ (Fin n))
    (h : periodize m (ξ - ratPt (blockProd S) γ) ≠ 0)
    (h' : periodize m (ξ - ratPt (blockProd S) γ') ≠ 0) : γ = γ' := by
  obtain ⟨z, hz⟩ := exists_ne_zero_of_periodize_ne_zero h
  obtain ⟨z', hz'⟩ := exists_ne_zero_of_periodize_ne_zero h'
  exact eq_of_near_ratPt hS1 hS hε hεr hγ hγ' (z := z) (z' := z')
    (fun i => by simpa [latEmbed_apply] using hmε _ hz i)
    (fun i => by simpa [latEmbed_apply] using hmε _ hz' i)

end Bumps

/-! ### The operators `T_{m;Λ}` and the companion projections -/

/-- The symbol `∑_{β ∈ Λ} m_per(ξ - β)` of `T_{m;Λ}` for a finite set `Λ ⊆ T[Q]` of torus points
(Blueprint Definition 7.1 (`def:blocks`)). -/
noncomputable def cosetSymbol (Q : ℕ) (m : EuclideanSpace ℝ (Fin n) → ℂ)
    (Λ : Finset (Fin n → ZMod Q)) (ξ : EuclideanSpace ℝ (Fin n)) : ℂ :=
  ∑ β ∈ Λ, periodize m (ξ - ratPt Q β)

/-- The lattice multiplier `T_{m;Λ} f` with symbol `∑_{β ∈ Λ} m_per(ξ - β)`. -/
noncomputable def cosetMult (Q : ℕ) (m : EuclideanSpace ℝ (Fin n) → ℂ)
    (Λ : Finset (Fin n → ZMod Q)) (f : (Fin n → ℤ) → ℂ) : (Fin n → ℤ) → ℂ :=
  latMult (cosetSymbol Q m Λ) f

/-- The coset `α + Σ_{A₀}` as a finite set of torus points. -/
def cosetSet (S : Finset ℕ) [NeZero (blockProd S)] (A₀ : Finset ℕ)
    (α : Fin n → ZMod (blockProd S)) : Finset (Fin n → ZMod (blockProd S)) :=
  (sigmaBlock S A₀).map (addLeftEmbedding α)

/-- The companion projection `P_{A₀,α} f = T_{θ_ε; α + Σ_{A₀}} f` of Blueprint Lemma 7.6
(`lem:companion`). -/
noncomputable def companionProj (S : Finset ℕ) [NeZero (blockProd S)] (ε : ℝ) (A₀ : Finset ℕ)
    (α : Fin n → ZMod (blockProd S)) (f : (Fin n → ℤ) → ℂ) : (Fin n → ℤ) → ℂ :=
  cosetMult (blockProd S) (cutoffEps n ε) (cosetSet S A₀ α) f

lemma cosetSymbol_cosetSet (S : Finset ℕ) [NeZero (blockProd S)] (m : EuclideanSpace ℝ (Fin n) → ℂ)
    (A₀ : Finset ℕ) (α : Fin n → ZMod (blockProd S)) (ξ : EuclideanSpace ℝ (Fin n)) :
    cosetSymbol (blockProd S) m (cosetSet S A₀ α) ξ =
      ∑ β ∈ sigmaBlock S A₀, periodize m (ξ - ratPt (blockProd S) (α + β)) := by
  simp [cosetSymbol, cosetSet]

lemma integrableOn_periodize_sub {m : EuclideanSpace ℝ (Fin n) → ℂ} (hm : Integrable m)
    (c : EuclideanSpace ℝ (Fin n)) :
    IntegrableOn (fun ξ => periodize m (ξ - c)) (torusCube n) := by
  simp_rw [periodize_comp_sub]
  exact integrableOn_periodize (hm.comp_sub_right c)

lemma integrableOn_cosetSymbol {Q : ℕ} {m : EuclideanSpace ℝ (Fin n) → ℂ} (hm : Integrable m)
    (Λ : Finset (Fin n → ZMod Q)) : IntegrableOn (cosetSymbol Q m Λ) (torusCube n) := by
  unfold cosetSymbol
  exact integrable_finsetSum _ fun β _ => integrableOn_periodize_sub hm _

lemma ratPt_add_eq (Q : ℕ) [NeZero Q] (α β : Fin n → ZMod Q) :
    ∃ z : Fin n → ℤ, ratPt Q (α + β) = ratPt Q α + ratPt Q β + latEmbed z := by
  obtain ⟨z, hz⟩ := ratPt_sum_zsmul_sub_mem (Finset.univ : Finset (Fin 2)) (fun _ => 1) ![α, β]
  refine ⟨z, ?_⟩
  simpa [Fin.sum_univ_two] using hz

lemma periodize_sub_ratPt_add (m : EuclideanSpace ℝ (Fin n) → ℂ) (Q : ℕ) [NeZero Q]
    (α β : Fin n → ZMod Q) (ξ : EuclideanSpace ℝ (Fin n)) :
    periodize m (ξ - ratPt Q (α + β)) =
      periodize (fun η => m (η - ratPt Q α)) (ξ - ratPt Q β) := by
  obtain ⟨z, hz⟩ := ratPt_add_eq Q α β
  rw [hz, ← periodize_comp_sub]
  have : ξ - (ratPt Q α + ratPt Q β + latEmbed z) = ξ - ratPt Q β - ratPt Q α + latEmbed (-z) := by
    rw [latEmbed_neg]; abel
  rw [this, periodize_add_latEmbed]

/-- The shifted full-grid symbol `∑_{β ∈ T[d]} m_per(ξ - (α + β))` is `Δ_d (m(· - α))`. -/
lemma sum_blockGrid_periodize_add {Q d : ℕ} [NeZero Q] (hd : d ∣ Q)
    (m : EuclideanSpace ℝ (Fin n) → ℂ) (α : Fin n → ZMod Q) (ξ : EuclideanSpace ℝ (Fin n)) :
    ∑ β ∈ blockGrid Q d, periodize m (ξ - ratPt Q (α + β)) =
      gridSym d (fun η => m (η - ratPt Q α)) ξ := by
  simp_rw [periodize_sub_ratPt_add]
  exact sum_blockGrid_periodize_eq_gridSym hd _ ξ

/-- The kernel of `T_{m; α + T[d]}`: `d^n 𝟙_{d ∣ y} e(α · y) 𝓕⁻ m (y)`. -/
lemma latKernel_sum_blockGrid_periodize_add {Q d : ℕ} [NeZero Q] (hd : d ∣ Q)
    {m : EuclideanSpace ℝ (Fin n) → ℂ} (hm : Integrable m) (α : Fin n → ZMod Q)
    (y : Fin n → ℤ) :
    latKernel (fun ξ => ∑ β ∈ blockGrid Q d, periodize m (ξ - ratPt Q (α + β))) y =
      (if ∀ i, (d : ℤ) ∣ y i then (d : ℂ) ^ n else 0) *
        (eC (inner ℝ (ratPt Q α) (latEmbed y)) * 𝓕⁻ m (latEmbed y)) := by
  have hd1 : 1 ≤ d := Nat.pos_of_ne_zero fun h => NeZero.ne Q (Nat.eq_zero_of_zero_dvd (h ▸ hd))
  have e : (fun ξ => ∑ β ∈ blockGrid Q d, periodize m (ξ - ratPt Q (α + β))) =
      gridSym d (fun η => m (η - ratPt Q α)) := funext (sum_blockGrid_periodize_add hd m α)
  rw [e, latKernel_gridSym (hm.comp_sub_right _) hd1, fourierInv_comp_sub]

/-! ### Counting cores -/

lemma add_mem_sigmaLe_of_coset {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {k : ℕ} {A₀ : Finset ℕ} {α β : Fin n → ZMod (blockProd S)}
    (hα : α ∈ sigmaUpper S k A₀) (hβ : β ∈ sigmaBlock S A₀) : α + β ∈ sigmaLe S k := by
  have := (mem_coset_iff hS (α + β) α).1 ⟨hα, by rwa [add_sub_cancel_left]⟩
  exact mem_sigmaLe.2 this.2.1

/-- Reindexing `(α, β) ↦ α + β`, `α ∈ Σ^{A₀}`, `β ∈ Σ_{A₀}`, onto the centers `γ ∈ Σ_{≤k}` with
`A₀ ⊆ supp γ` (via `mem_coset_iff`). -/
lemma sum_sigmaUpper_sum_sigmaBlock_add {M : Type*} [AddCommMonoid M] {S : Finset ℕ}
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] (k : ℕ) (A₀ : Finset ℕ)
    (g : (Fin n → ZMod (blockProd S)) → M) :
    ∑ α ∈ sigmaUpper S k A₀, ∑ β ∈ sigmaBlock S A₀, g (α + β) =
      ∑ γ ∈ (sigmaLe S k).filter (fun γ => A₀ ⊆ blockSupp S γ), g γ := by
  rw [← Finset.sum_product' (f := fun α β => g (α + β))]
  refine Finset.sum_nbij' (fun p => p.1 + p.2)
    (fun γ => (blockProj S (S \ A₀) γ, γ - blockProj S (S \ A₀) γ)) ?_ ?_ ?_ ?_ ?_
  · rintro ⟨α, β⟩ hp
    simp only [Finset.mem_product] at hp
    have := (mem_coset_iff hS (α + β) α).1 ⟨hp.1, by rw [add_sub_cancel_left]; exact hp.2⟩
    simp only [Finset.mem_filter]
    exact ⟨mem_sigmaLe.2 this.2.1, this.1⟩
  · intro γ hγ
    simp only [Finset.mem_filter] at hγ
    have := (mem_coset_iff hS (k := k) (A₀ := A₀) γ (blockProj S (S \ A₀) γ)).2
      ⟨hγ.2, mem_sigmaLe.1 hγ.1, rfl⟩
    simp only [Finset.mem_product]
    exact this
  · rintro ⟨α, β⟩ hp
    simp only [Finset.mem_product] at hp
    have := (mem_coset_iff hS (α + β) α).1 ⟨hp.1, by rw [add_sub_cancel_left]; exact hp.2⟩
    simp only [← this.2.2, add_sub_cancel_left]
  · intro γ _
    simp
  · intro p _; rfl

/-- `∑_{|A₀| ≤ k} ∑_{α ∈ Σ^{A₀}} ∑_{β ∈ Σ_{A₀}} g(α + β) ≤ 2^k ∑_{γ ∈ Σ_{≤k}} g(γ)` for `g ≥ 0`:
a center with support `A` occurs for at most `2^{|A|} ≤ 2^k` cores. -/
lemma sum_cores_sum_sigmaUpper_le {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] (k : ℕ) (g : (Fin n → ZMod (blockProd S)) → ℝ)
    (hg : ∀ γ, 0 ≤ g γ) :
    ∑ A₀ ∈ S.powerset with #A₀ ≤ k, ∑ α ∈ sigmaUpper S k A₀, ∑ β ∈ sigmaBlock S A₀, g (α + β)
      ≤ 2 ^ k * ∑ γ ∈ sigmaLe S k, g γ := by
  simp_rw [sum_sigmaUpper_sum_sigmaBlock_add hS k]
  rw [Finset.sum_comm' (t' := sigmaLe S k)
    (s' := fun γ => (S.powerset.filter fun A₀ => #A₀ ≤ k).filter (· ⊆ blockSupp S γ))
    (h := fun A₀ γ => by simp only [Finset.mem_filter]; tauto)]
  rw [Finset.mul_sum]
  refine Finset.sum_le_sum fun γ hγ => ?_
  rw [Finset.sum_const, nsmul_eq_mul]
  refine mul_le_mul_of_nonneg_right ?_ (hg γ)
  have h1 : ((S.powerset.filter fun A₀ => #A₀ ≤ k).filter (· ⊆ blockSupp S γ)).card ≤
      (blockSupp S γ).powerset.card :=
    Finset.card_le_card fun A₀ hA₀ => Finset.mem_powerset.2 (Finset.mem_filter.1 hA₀).2
  rw [Finset.card_powerset] at h1
  have h2 : 2 ^ (blockSupp S γ).card ≤ 2 ^ k :=
    Nat.pow_le_pow_right (by norm_num) (mem_sigmaLe.1 hγ)
  exact_mod_cast h1.trans h2

/-! ### Blueprint Lemma 7.6 (`lem:companion`), the case `t = 2` -/

lemma cutoffEps_support {ε : ℝ} (hε : 0 < ε) :
    ∀ η, cutoffEps n ε η ≠ 0 → ∀ i, |η i| ≤ 2 * ε :=
  fun _ h => by by_contra h'; exact h (cutoffEps_eq_zero hε h')

lemma phiEps_support {ε : ℝ} (hε : 0 < ε) :
    ∀ η, phiEps n ε η ≠ 0 → ∀ i, |η i| ≤ 2 * ε :=
  fun _ h => by by_contra h'; exact h (phiEps_eq_zero hε h')

lemma four_eps_lt_one (S : Finset ℕ) {k r : ℕ} {ε : ℝ} (hε : 0 < ε)
    (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹) : 4 * ε < 1 :=
  four_mul_lt_one_of_le_eps (le_trans (by norm_num) (two_le_blockStar S)) hε hεr

/-- The pointwise bound behind the case `t = 2`: `∑_{|A₀| ≤ k} ∑_{α ∈ Σ^{A₀}} |M_{A₀,α}(ξ)|² ≤ 2^k`
for the symbols `M_{A₀,α} = ∑_{β ∈ α + Σ_{A₀}} (θ_ε)_per(· - β)`. -/
lemma sum_cores_norm_sq_cosetSymbol_le {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} {ε : ℝ}
    (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    (ξ : EuclideanSpace ℝ (Fin n)) :
    ∑ A₀ ∈ S.powerset with #A₀ ≤ k, ∑ α ∈ sigmaUpper S k A₀,
      ‖cosetSymbol (blockProd S) (cutoffEps n ε) (cosetSet S A₀ α) ξ‖ ^ 2 ≤ 2 ^ k := by
  have hsupp := cutoffEps_support (n := n) hε
  have hε4 := four_eps_lt_one S hε hεr
  have hAMO : ∀ γ ∈ sigmaLe S k, ∀ γ' ∈ sigmaLe S k,
      periodize (cutoffEps n ε) (ξ - ratPt (blockProd S) γ) ≠ 0 →
      periodize (cutoffEps n ε) (ξ - ratPt (blockProd S) γ') ≠ 0 → γ = γ' :=
    fun γ hγ γ' hγ' h h' => periodize_center_atMostOne hsupp hS1 hS hε hεr hγ hγ' ξ h h'
  have e : ∀ A₀, ∀ α ∈ sigmaUpper S k A₀,
      ‖cosetSymbol (blockProd S) (cutoffEps n ε) (cosetSet S A₀ α) ξ‖ ^ 2 =
        ∑ β ∈ sigmaBlock S A₀,
          ‖periodize (cutoffEps n ε) (ξ - ratPt (blockProd S) (α + β))‖ ^ 2 := by
    intro A₀ α hα
    rw [cosetSymbol_cosetSet]
    exact norm_sq_sum_of_atMostOne _ _ fun β hβ β' hβ' h h' => add_left_cancel
      (hAMO _ (add_mem_sigmaLe_of_coset hS hα hβ) _ (add_mem_sigmaLe_of_coset hS hα hβ') h h')
  have hp1 : ∀ γ, ‖periodize (cutoffEps n ε) (ξ - ratPt (blockProd S) γ)‖ ≤ 1 := fun γ =>
    norm_periodize_le hsupp hε4 zero_le_one (norm_cutoffEps_le ε) _
  rw [Finset.sum_congr rfl fun A₀ _ => Finset.sum_congr rfl fun α hα => e A₀ α hα]
  refine (sum_cores_sum_sigmaUpper_le hS k
    (fun γ => ‖periodize (cutoffEps n ε) (ξ - ratPt (blockProd S) γ)‖ ^ 2)
    fun _ => sq_nonneg _).trans ?_
  have h1 : ∑ γ ∈ sigmaLe S k, ‖periodize (cutoffEps n ε) (ξ - ratPt (blockProd S) γ)‖ ^ 2
      ≤ 1 := by
    refine sum_le_of_atMostOne _ _ zero_le_one
      (fun γ _ => pow_le_one₀ (norm_nonneg _) (hp1 γ)) fun γ hγ γ' hγ' h h' => ?_
    exact hAMO γ hγ γ' hγ' (fun h0 => h (by simp [h0])) (fun h0 => h' (by simp [h0]))
  calc (2 : ℝ) ^ k * ∑ γ ∈ sigmaLe S k,
        ‖periodize (cutoffEps n ε) (ξ - ratPt (blockProd S) γ)‖ ^ 2 ≤ 2 ^ k * 1 := by gcongr
    _ = 2 ^ k := mul_one _

lemma norm_cosetSymbol_cutoffEps_le {Q : ℕ} {ε : ℝ} (hε : 0 < ε) (hε4 : 4 * ε < 1)
    (Λ : Finset (Fin n → ZMod Q)) (ξ : EuclideanSpace ℝ (Fin n)) :
    ‖cosetSymbol Q (cutoffEps n ε) Λ ξ‖ ≤ Λ.card := by
  unfold cosetSymbol
  refine (norm_sum_le _ _).trans ?_
  have := Finset.sum_le_sum (s := Λ) fun β _ =>
    norm_periodize_le (cutoffEps_support hε) hε4 zero_le_one (norm_cutoffEps_le ε)
      (ξ - ratPt Q β)
  simpa using this

/-- Blueprint Lemma 7.6 (`lem:companion`), the case `t = 2`: under the separation hypothesis
(7.1) `0 < ε ≤ (100 r q_*^{2rk})⁻¹`, for every `f ∈ ℓ¹(ℤⁿ)` (in particular finitely supported
`f`), each `x ↦ P_{A₀,α} f(x) = T_{θ_ε; α + Σ_{A₀}} f(x)` is square summable and
`∑_{A₀ ⊆ S, |A₀| ≤ k} ∑_x ∑_{α ∈ Σ^{A₀}} |P_{A₀,α} f(x)|² ≤ 2^k ∑_x |f(x)|²`
(the constant is `2^k (sup θ)²` with `sup θ = 1`). -/
theorem companion_two {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} {ε : ℝ}
    (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) :
    (∀ A₀ α, Summable fun x => ‖companionProj S ε A₀ α f x‖ ^ 2) ∧
      ∑ A₀ ∈ S.powerset with #A₀ ≤ k, ∑' x, ∑ α ∈ sigmaUpper S k A₀,
          ‖companionProj S ε A₀ α f x‖ ^ 2 ≤ 2 ^ k * ∑' x, ‖f x‖ ^ 2 := by
  have hε4 := four_eps_lt_one S hε hεr
  set M : Finset ℕ → (Fin n → ZMod (blockProd S)) → EuclideanSpace ℝ (Fin n) → ℂ :=
    fun A₀ α => cosetSymbol (blockProd S) (cutoffEps n ε) (cosetSet S A₀ α) with hM
  have hmeas : ∀ A₀ α, AEStronglyMeasurable (M A₀ α) (volume.restrict (torusCube n)) :=
    fun A₀ α => (integrableOn_cosetSymbol (integrable_cutoffEps hε) _).1
  have hB := fun A₀ α => summable_and_tsum_norm_sq_latMult_le_integral (hmeas A₀ α)
    (fun ξ _ => norm_cosetSymbol_cutoffEps_le hε hε4 (cosetSet S A₀ α) ξ) hf
  refine ⟨fun A₀ α => (hB A₀ α).1, ?_⟩
  set F : EuclideanSpace ℝ (Fin n) → ℝ := fun ξ => ‖latFT f ξ‖ ^ 2 with hF
  have hFc : Continuous F := (continuous_latFT hf).norm.pow 2
  have hint : ∀ A₀ α, IntegrableOn (fun ξ => ‖M A₀ α ξ‖ ^ 2 * F ξ) (torusCube n) := by
    intro A₀ α
    refine integrableOn_torusCube_of_bound (((hmeas A₀ α).norm.pow 2).mul
      hFc.aestronglyMeasurable) (((cosetSet S A₀ α).card : ℝ) ^ 2 * (∑' z, ‖f z‖) ^ 2)
      fun ξ _ => ?_
    rw [Real.norm_of_nonneg (by positivity)]
    exact mul_le_mul (pow_le_pow_left₀ (norm_nonneg _)
      (norm_cosetSymbol_cutoffEps_le hε hε4 _ ξ) 2)
      (pow_le_pow_left₀ (norm_nonneg _) (norm_latFT_le hf ξ) 2) (by positivity) (by positivity)
  have hFint : IntegrableOn F (torusCube n) :=
    integrableOn_torusCube_of_bound hFc.aestronglyMeasurable ((∑' z, ‖f z‖) ^ 2) fun ξ _ => by
      rw [Real.norm_of_nonneg (by positivity)]
      exact pow_le_pow_left₀ (norm_nonneg _) (norm_latFT_le hf ξ) 2
  calc ∑ A₀ ∈ S.powerset with #A₀ ≤ k, ∑' x, ∑ α ∈ sigmaUpper S k A₀,
          ‖companionProj S ε A₀ α f x‖ ^ 2
      = ∑ A₀ ∈ S.powerset with #A₀ ≤ k, ∑ α ∈ sigmaUpper S k A₀,
          ∑' x, ‖companionProj S ε A₀ α f x‖ ^ 2 :=
        Finset.sum_congr rfl fun A₀ _ => Summable.tsum_finsetSum fun α _ => (hB A₀ α).1
    _ ≤ ∑ A₀ ∈ S.powerset with #A₀ ≤ k, ∑ α ∈ sigmaUpper S k A₀,
          ∫ ξ in torusCube n, ‖M A₀ α ξ‖ ^ 2 * F ξ :=
        Finset.sum_le_sum fun A₀ _ => Finset.sum_le_sum fun α _ => (hB A₀ α).2
    _ = ∫ ξ in torusCube n, ∑ A₀ ∈ S.powerset with #A₀ ≤ k, ∑ α ∈ sigmaUpper S k A₀,
          ‖M A₀ α ξ‖ ^ 2 * F ξ := by
        rw [integral_finsetSum _ fun A₀ _ => integrable_finsetSum _ fun α _ => hint A₀ α]
        exact Finset.sum_congr rfl fun A₀ _ =>
          (integral_finsetSum _ fun α _ => hint A₀ α).symm
    _ ≤ ∫ ξ in torusCube n, 2 ^ k * F ξ := by
        refine integral_mono_of_nonneg (Filter.Eventually.of_forall fun ξ => by positivity)
          (hFint.const_mul _) (Filter.Eventually.of_forall fun ξ => ?_)
        simp only
        simp_rw [← Finset.sum_mul]
        exact mul_le_mul_of_nonneg_right (sum_cores_norm_sq_cosetSymbol_le hS1 hS hε hεr ξ)
          (by positivity)
    _ = 2 ^ k * ∑' x, ‖f x‖ ^ 2 := by
        rw [integral_const_mul, integral_norm_sq_latFT hf]

/-! ### Blueprint Lemma 7.6 (`lem:companion`), the case `t = ∞`: auxiliary facts -/

/-- Linearity of `m ↦ m(D) f` for finite combinations of symbols integrable on the torus. -/
lemma latMult_sum_mul {ι : Type*} (s : Finset ι) (c : ι → ℂ)
    {m : ι → EuclideanSpace ℝ (Fin n) → ℂ} (hm : ∀ i ∈ s, IntegrableOn (m i) (torusCube n))
    {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) (x : Fin n → ℤ) :
    latMult (fun ξ => ∑ i ∈ s, c i * m i ξ) f x = ∑ i ∈ s, c i * latMult (m i) f x := by
  have hint : ∀ i ∈ s, IntegrableOn
      (fun ξ => m i ξ * (latFT f ξ * eC (inner ℝ (latEmbed x) ξ))) (torusCube n) := by
    intro i hi
    refine (hm i hi).mul_bdd (c := ∑' z, ‖f z‖)
      (((continuous_latFT hf).mul (by fun_prop [continuous_eC])).aestronglyMeasurable)
      (Filter.Eventually.of_forall fun ξ => ?_)
    rw [norm_mul, norm_eC, mul_one]; exact norm_latFT_le hf ξ
  unfold latMult
  have e : ∀ ξ, (∑ i ∈ s, c i * m i ξ) * latFT f ξ * eC (inner ℝ (latEmbed x) ξ) =
      ∑ i ∈ s, c i * (m i ξ * (latFT f ξ * eC (inner ℝ (latEmbed x) ξ))) := fun ξ => by
    rw [Finset.sum_mul, Finset.sum_mul]
    exact Finset.sum_congr rfl fun i _ => by ring
  simp_rw [e]
  rw [integral_finsetSum _ fun i hi => (hint i hi).const_mul (c i)]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [integral_const_mul]
  congr 1
  exact integral_congr_ae (Filter.Eventually.of_forall fun ξ => by ring)

/-- Linearity of `m ↦ m̌` for finite combinations of symbols integrable on the torus. -/
lemma latKernel_sum_mul {ι : Type*} (s : Finset ι) (c : ι → ℂ)
    {m : ι → EuclideanSpace ℝ (Fin n) → ℂ} (hm : ∀ i ∈ s, IntegrableOn (m i) (torusCube n))
    (y : Fin n → ℤ) :
    latKernel (fun ξ => ∑ i ∈ s, c i * m i ξ) y = ∑ i ∈ s, c i * latKernel (m i) y := by
  simp_rw [← latMult_latDelta]
  exact latMult_sum_mul s c hm summable_latDelta y

/-- For `α ∈ Σ^{A₀}` and `β ∈ T[Q_B]` with `B ⊆ A₀ ⊆ S`, the point `α + β` lies in `Σ_{≤k}`. -/
lemma add_mem_sigmaLe_of_grid {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {k : ℕ} {A₀ B : Finset ℕ} (hB : B ⊆ A₀) (hA₀ : A₀ ⊆ S)
    {α β : Fin n → ZMod (blockProd S)} (hα : α ∈ sigmaUpper S k A₀)
    (hβ : β ∈ blockGrid (blockProd S) (blockProd B)) : α + β ∈ sigmaLe S k := by
  rw [mem_blockGrid_blockProd_iff hS (hB.trans hA₀)] at hβ
  obtain ⟨_, hc⟩ := mem_sigmaUpper.1 hα
  rw [mem_sigmaLe]
  calc #(blockSupp S (α + β)) ≤ #(blockSupp S α ∪ blockSupp S β) :=
        Finset.card_le_card (blockSupp_add_subset S α β)
    _ ≤ #(blockSupp S α) + #(blockSupp S β) := Finset.card_union_le _ _
    _ ≤ #(blockSupp S α) + #A₀ := by gcongr; exact hβ.trans hB
    _ ≤ k := hc

/-- The outside component of `α + β` (`α ∈ Σ^{A₀}`, `β ∈ T[Q_B]`, `B ⊆ A₀ ⊆ S`) is `α`. -/
lemma blockProj_add_of_grid {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {k : ℕ} {A₀ B : Finset ℕ} (hB : B ⊆ A₀) (hA₀ : A₀ ⊆ S)
    {α β : Fin n → ZMod (blockProd S)} (hα : α ∈ sigmaUpper S k A₀)
    (hβ : β ∈ blockGrid (blockProd S) (blockProd B)) :
    blockProj S (S \ A₀) (α + β) = α := by
  rw [mem_blockGrid_blockProd_iff hS (hB.trans hA₀)] at hβ
  obtain ⟨hd, _⟩ := mem_sigmaUpper.1 hα
  rw [blockProj_add, blockProj_eq_self hS (fun q hq => Finset.mem_sdiff.2
      ⟨blockSupp_subset S α hq, Finset.disjoint_left.1 hd hq⟩),
    blockProj_eq_zero hS (Finset.disjoint_of_subset_left (hβ.trans hB) Finset.disjoint_sdiff),
    add_zero]

/-- `∫_{[0,1)ⁿ} |φ_per(ξ - c)|² dξ = ∫_E |φ|²` for `φ` supported in `[-2ε, 2ε]ⁿ`, `4ε < 1`. -/
lemma setIntegral_norm_sq_periodize_sub {φ : EuclideanSpace ℝ (Fin n) → ℂ} {ε : ℝ}
    (hφε : ∀ η, φ η ≠ 0 → ∀ i, |η i| ≤ 2 * ε) (hε4 : 4 * ε < 1)
    (hφ2 : Integrable fun ξ => ‖φ ξ‖ ^ 2) (c : EuclideanSpace ℝ (Fin n)) :
    ∫ ξ in torusCube n, ‖periodize φ (ξ - c)‖ ^ 2 = ∫ ξ, ‖φ ξ‖ ^ 2 := by
  set g : EuclideanSpace ℝ (Fin n) → ℝ := fun η => ‖φ (η - c)‖ ^ 2 with hg
  have hgi : Integrable g := hφ2.comp_sub_right c
  have hpt : ∀ ξ, ‖periodize φ (ξ - c)‖ ^ 2 = ∑' z : Fin n → ℤ, g (ξ - latEmbed z) := by
    intro ξ
    rw [norm_sq_periodize hφε hε4]
    congr 1; funext z; simp only [hg]; congr 3; abel
  have hint : ∀ z : Fin n → ℤ, Integrable (fun ξ => g (ξ - latEmbed z))
      (volume.restrict (torusCube n)) := fun z => (hgi.comp_sub_right (latEmbed z)).integrableOn
  have hsum : Summable fun z : Fin n → ℤ => ∫ ξ in torusCube n, ‖g (ξ - latEmbed z)‖ :=
    (hasSum_setIntegral_torusCube_sub hgi.norm).summable
  simp_rw [hpt]
  rw [← integral_tsum_of_summable_integral_norm hint hsum,
    (hasSum_setIntegral_torusCube_sub hgi).tsum_eq]
  exact integral_sub_right_eq_self (fun η => ‖φ η‖ ^ 2) c

/-- The weight `w(y) = (1 + ε²|y|²)^{n+1}` of the proof of Blueprint Lemma 7.6
(`lem:companion`). -/
noncomputable def companionWeight (n : ℕ) (ε : ℝ) (y : Fin n → ℤ) : ℝ :=
  (1 + ε ^ 2 * ‖latEmbed y‖ ^ 2) ^ (n + 1)

lemma one_le_companionWeight (ε : ℝ) (y : Fin n → ℤ) : 1 ≤ companionWeight n ε y :=
  one_le_pow₀ (le_add_of_nonneg_right (by positivity))

/-- `(1 + u)^{n+1} ≤ 2^{n+1} ((1 + u²)^{n+1})²` for `u ≥ 0`. -/
lemma one_add_pow_le_two_pow_mul {u : ℝ} (hu : 0 ≤ u) :
    (1 + u) ^ (n + 1) ≤ 2 ^ (n + 1) * ((1 + u ^ 2) ^ (n + 1)) ^ 2 := by
  have h1 : 1 + u ≤ 2 * (1 + u ^ 2) := by nlinarith [sq_nonneg (u - 1)]
  have h2 : (1 : ℝ) ≤ (1 + u ^ 2) ^ (n + 1) := one_le_pow₀ (by nlinarith)
  calc (1 + u) ^ (n + 1) ≤ (2 * (1 + u ^ 2)) ^ (n + 1) :=
        pow_le_pow_left₀ (by positivity) h1 _
    _ = 2 ^ (n + 1) * (1 + u ^ 2) ^ (n + 1) := mul_pow _ _ _
    _ ≤ 2 ^ (n + 1) * ((1 + u ^ 2) ^ (n + 1)) ^ 2 := by
        gcongr; nlinarith

/-- The sublattice sum `∑_{y ∈ QG} w(y)^{-2} ≤ 2^{n+1} C_n (εQ)^{-n}` for `0 < εQ ≤ 1`, in the
form of a finite partial sum. -/
lemma sum_weight_inv_sq_le {Q : ℕ} (hQ : 1 ≤ Q) {ε : ℝ} (hε : 0 < ε) (hεQ : ε * Q ≤ 1)
    (T : Finset (Fin n → ℤ)) :
    ∑ y ∈ T, (if ∀ i, (Q : ℤ) ∣ y i then ((companionWeight n ε y)⁻¹) ^ 2 else 0) ≤
      2 ^ (n + 1) * ((ε * Q)⁻¹) ^ n * envelopeConst n := by
  set R : ℝ := (ε * Q)⁻¹ with hR
  have hQr : (0 : ℝ) < Q := by exact_mod_cast hQ
  have haQ : 0 < ε * Q := mul_pos hε hQr
  have hR1 : 1 ≤ R := by rw [hR]; exact (one_le_inv₀ haQ).2 hεQ
  have hR0 : 0 < R := by linarith
  obtain ⟨hsum, htsum⟩ := summable_latEnvelope_and_tsum_le (n := n) hR1
  set h : (Fin n → ℤ) → ℝ := fun z => 2 ^ (n + 1) * R ^ n * latEnvelope n R z with hh
  have hh0 : ∀ z, 0 ≤ h z := fun z => by
    simp only [hh, latEnvelope]; exact mul_nonneg (by positivity) (envelope_nonneg hR0 _)
  set dv : (Fin n → ℤ) → (Fin n → ℤ) := fun y i => y i / Q with hdv
  have key : ∀ y : Fin n → ℤ, (∀ i, (Q : ℤ) ∣ y i) →
      ((companionWeight n ε y)⁻¹) ^ 2 ≤ h (dv y) := by
    intro y hy
    have hyz : latEmbed y = (Q : ℝ) • latEmbed (dv y) := by
      ext i
      simp only [latEmbed_apply, PiLp.smul_apply, smul_eq_mul, hdv]
      rw [← Int.cast_natCast, ← Int.cast_mul, mul_comm, Int.ediv_mul_cancel (hy i)]
    set u := ε * Q * ‖latEmbed (dv y)‖ with hu
    have hu0 : 0 ≤ u := by positivity
    have hw : companionWeight n ε y = (1 + u ^ 2) ^ (n + 1) := by
      rw [companionWeight, hyz, norm_smul, Real.norm_of_nonneg hQr.le, hu]; ring
    have he : R ^ n * latEnvelope n R (dv y) = ((1 + u) ^ (n + 1))⁻¹ := by
      rw [latEnvelope, envelope, ← mul_assoc, mul_inv_cancel₀ (by positivity), one_mul, hu,
        hR, div_inv_eq_mul, mul_comm (ε * Q)]
    simp only [hh]
    rw [mul_assoc, he, hw]
    have hp : 0 < (1 + u) ^ (n + 1) := by positivity
    have hq : 0 < ((1 + u ^ 2) ^ (n + 1)) ^ 2 := by positivity
    rw [inv_pow, ← div_eq_mul_inv, le_div_iff₀ hp, inv_mul_le_iff₀ hq]
    rw [mul_comm]; exact one_add_pow_le_two_pow_mul (n := n) hu0
  have hinj : Set.InjOn dv {y | ∀ i, (Q : ℤ) ∣ y i} := by
    intro y hy y' hy' e
    funext i
    have := congrFun e i
    simp only [hdv] at this
    rw [← Int.ediv_mul_cancel (hy i), ← Int.ediv_mul_cancel (hy' i), this]
  calc ∑ y ∈ T, (if ∀ i, (Q : ℤ) ∣ y i then ((companionWeight n ε y)⁻¹) ^ 2 else 0)
      = ∑ y ∈ T.filter (fun y => ∀ i, (Q : ℤ) ∣ y i), ((companionWeight n ε y)⁻¹) ^ 2 :=
        (Finset.sum_filter _ _).symm
    _ ≤ ∑ y ∈ T.filter (fun y => ∀ i, (Q : ℤ) ∣ y i), h (dv y) :=
        Finset.sum_le_sum fun y hy => key y (Finset.mem_filter.1 hy).2
    _ = ∑ z ∈ (T.filter (fun y => ∀ i, (Q : ℤ) ∣ y i)).image dv, h z :=
        (Finset.sum_image fun y hy y' hy' e =>
          hinj (Finset.mem_filter.1 hy).2 (Finset.mem_filter.1 hy').2 e).symm
    _ ≤ ∑' z, h z := (hsum.mul_left _).sum_le_tsum _ fun z _ => hh0 z
    _ = 2 ^ (n + 1) * R ^ n * ∑' z, latEnvelope n R z := tsum_mul_left
    _ ≤ 2 ^ (n + 1) * R ^ n * envelopeConst n := by gcongr

/-- `εQ_B ≤ 1` for `B ⊆ S`, `|B| ≤ k`, under the separation hypothesis (7.1). -/
lemma eps_mul_blockProd_le {S B : Finset ℕ} (hBS : B ⊆ S) {k r : ℕ} (hBk : #B ≤ k) {ε : ℝ}
    (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹) :
    ε * blockProd B ≤ 1 := by
  have hr := one_le_of_le_eps hε hεr
  have hq1 : 1 ≤ blockStar S := le_trans (by norm_num) (two_le_blockStar S)
  have hQ : (blockProd B : ℝ) ≤ (blockStar S : ℝ) ^ k := by
    exact_mod_cast (blockProd_le_pow hBS).trans (Nat.pow_le_pow_right hq1 hBk)
  have hqk : (0 : ℝ) < (blockStar S : ℝ) ^ k := by positivity
  have h2 : (blockStar S : ℝ) ^ k ≤ 100 * r * (blockStar S : ℝ) ^ (2 * r * k) := by
    have h3 : (blockStar S : ℝ) ^ k ≤ (blockStar S : ℝ) ^ (2 * r * k) :=
      pow_le_pow_right₀ (by exact_mod_cast hq1) (by nlinarith)
    have h4 : (1 : ℝ) ≤ 100 * r := by
      have : (1 : ℝ) ≤ r := by exact_mod_cast hr
      linarith
    nlinarith
  have hε' : ε ≤ ((blockStar S : ℝ) ^ k)⁻¹ := hεr.trans (inv_anti₀ hqk h2)
  calc ε * blockProd B ≤ ((blockStar S : ℝ) ^ k)⁻¹ * (blockStar S : ℝ) ^ k :=
        mul_le_mul hε' hQ (by positivity) (by positivity)
    _ = 1 := inv_mul_cancel₀ hqk.ne'

lemma exists_norm_phiEps_le (ε : ℝ) : ∃ M, 0 ≤ M ∧ ∀ η, ‖phiEps n ε η‖ ≤ M := by
  obtain ⟨C, hC⟩ := (companionPhi n).continuous.bounded_above_of_compact_support
    (HasCompactSupport.intro (isCompact_box 2) fun _ h => companionPhi_eq_zero h)
  exact ⟨max C 0, le_max_right _ _, fun η => (hC _).trans (le_max_left _ _)⟩

lemma integrable_norm_sq_phiEps {ε : ℝ} (hε : 0 < ε) :
    Integrable fun ξ => ‖phiEps n ε ξ‖ ^ 2 :=
  ((continuous_phiEps ε).norm.pow 2).integrable_of_hasCompactSupport
    (HasCompactSupport.intro (isCompact_box (2 * ε)) fun _ h => by
      simp [phiEps_eq_zero hε h])

/-- The shifted full-grid symbol `∑_{β ∈ T[Q_B]} m_per(ξ - (α + β))` of `T_{m; α + T[Q_B]}`. -/
noncomputable def gridSymbol (S : Finset ℕ) [NeZero (blockProd S)] (B : Finset ℕ)
    (m : EuclideanSpace ℝ (Fin n) → ℂ) (α : Fin n → ZMod (blockProd S))
    (ξ : EuclideanSpace ℝ (Fin n)) : ℂ :=
  ∑ β ∈ blockGrid (blockProd S) (blockProd B), periodize m (ξ - ratPt (blockProd S) (α + β))

lemma integrableOn_gridSymbol {S : Finset ℕ} [NeZero (blockProd S)] (B : Finset ℕ)
    {m : EuclideanSpace ℝ (Fin n) → ℂ} (hm : Integrable m) (α : Fin n → ZMod (blockProd S)) :
    IntegrableOn (gridSymbol S B m α) (torusCube n) := by
  unfold gridSymbol
  exact integrable_finsetSum _ fun β _ => integrableOn_periodize_sub hm _

lemma latKernel_gridSymbol {S : Finset ℕ} [NeZero (blockProd S)] {B : Finset ℕ}
    (hd : blockProd B ∣ blockProd S) {m : EuclideanSpace ℝ (Fin n) → ℂ} (hm : Integrable m)
    (α : Fin n → ZMod (blockProd S)) (y : Fin n → ℤ) :
    latKernel (gridSymbol S B m α) y =
      (if ∀ i, ((blockProd B : ℕ) : ℤ) ∣ y i then ((blockProd B : ℕ) : ℂ) ^ n else 0) *
        (eC (inner ℝ (ratPt (blockProd S) α) (latEmbed y)) * 𝓕⁻ m (latEmbed y)) :=
  latKernel_sum_blockGrid_periodize_add hd hm α y

/-- The constant `2^{n+1} C_n ∫|Φ|²` of the `t = ∞` estimate for one full-grid coset family. -/
noncomputable def companionGridConst (n : ℕ) : ℝ :=
  2 ^ (n + 1) * envelopeConst n * companionPhiL2 n

lemma companionPhiL2_nonneg : 0 ≤ companionPhiL2 n :=
  integral_nonneg fun _ => sq_nonneg _

lemma companionGridConst_nonneg : 0 ≤ companionGridConst n :=
  mul_nonneg (mul_nonneg (by positivity) (envelopeConst_nonneg n)) companionPhiL2_nonneg

lemma summable_of_finite_support {f : (Fin n → ℤ) → ℂ} (hf : (Function.support f).Finite) :
    Summable fun z => ‖f z‖ :=
  summable_of_ne_finset_zero (s := hf.toFinset) fun z hz => by
    simp only [Set.Finite.mem_toFinset, Function.mem_support, not_not] at hz; simp [hz]

/-- The core `ℓ^∞ → ℓ^∞(ℓ²)` estimate of Blueprint Lemma 7.6 (`lem:companion`) for one full-grid
family: for `B ⊆ A₀ ⊆ S`, `|A₀| ≤ k`, `Q = Q_B`, finitely supported `f` with `|f| ≤ s` and every
`x`, `∑_{α ∈ Σ^{A₀}} |T_{θ_ε; α + T[Q]} f(x)|² ≤ C s²` with `C = 2^{n+1} C_n ∫|Φ|²`
(kernel `h_α(y) = Qⁿ 𝟙_{Q ∣ y} e(α · y) θ̌_ε(y)`, weight `w(y) = (1 + ε²|y|²)^{n+1}`, orthogonality
of the `w h_α` through Bessel's inequality, Cauchy–Schwarz and duality). -/
theorem sum_norm_sq_latMult_gridSymbol_le {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} {ε : ℝ}
    (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    {A₀ B : Finset ℕ} (hB : B ⊆ A₀) (hA₀ : A₀ ⊆ S) (hA₀k : #A₀ ≤ k)
    {f : (Fin n → ℤ) → ℂ} (hf : (Function.support f).Finite) {s : ℝ}
    (hs : ∀ y, ‖f y‖ ≤ s) (x : Fin n → ℤ) :
    ∑ α ∈ sigmaUpper S k A₀, ‖latMult (gridSymbol S B (cutoffEps n ε) α) f x‖ ^ 2 ≤
      companionGridConst n * s ^ 2 := by
  classical
  have hd : blockProd B ∣ blockProd S := blockProd_dvd_blockProd (hB.trans hA₀)
  have hQ1 : 1 ≤ blockProd B := blockProd_pos fun q hq => hS1 q (hB.trans hA₀ hq)
  have hQr : (0 : ℝ) < blockProd B := by exact_mod_cast hQ1
  have hε4 := four_eps_lt_one S hε hεr
  have hεQ : ε * blockProd B ≤ 1 :=
    eps_mul_blockProd_le (hB.trans hA₀) ((Finset.card_le_card hB).trans hA₀k) hε hεr
  have hfs := summable_of_finite_support hf
  have hs0 : 0 ≤ s := (norm_nonneg _).trans (hs 0)
  set V := sigmaUpper S k A₀ with hV
  set Gr := blockGrid (n := n) (blockProd S) (blockProd B) with hGr
  set u : (Fin n → ZMod (blockProd S)) → ℂ :=
    fun α => latMult (gridSymbol S B (cutoffEps n ε) α) f x with hu
  set K : (Fin n → ZMod (blockProd S)) → (Fin n → ℤ) → ℂ :=
    fun α => latKernel (gridSymbol S B (cutoffEps n ε) α) with hK
  -- the finite set of relevant `y`
  set T : Finset (Fin n → ℤ) := hf.toFinset.image (fun z => x - z) with hT
  have hTz : ∀ y ∉ T, f (x - y) = 0 := by
    intro y hy
    by_contra h
    exact hy (Finset.mem_image.2 ⟨x - y, by simpa using h, by abel⟩)
  have hu' : ∀ α, u α = ∑ y ∈ T, K α y * f (x - y) := by
    intro α
    simp only [hu, hK]
    rw [latMult_eq_latConv (integrableOn_gridSymbol B (integrable_cutoffEps hε) α) hfs, latConv,
      tsum_eq_sum fun y hy => by rw [hTz y hy, mul_zero]]
  set S2 := ∑ α ∈ V, ‖u α‖ ^ 2 with hS2
  have hS2nn : 0 ≤ S2 := Finset.sum_nonneg fun _ _ => sq_nonneg _
  set c : (Fin n → ZMod (blockProd S)) → ℂ := fun α => conj (u α) with hc
  set F : (Fin n → ℤ) → ℂ := fun y => ∑ α ∈ V, c α * K α y with hF
  -- duality
  have hS2c : (S2 : ℂ) = ∑ y ∈ T, F y * f (x - y) := by
    have e1 : (S2 : ℂ) = ∑ α ∈ V, c α * u α := by
      rw [hS2]; push_cast
      exact Finset.sum_congr rfl fun α _ => (Complex.conj_mul' (u α)).symm
    rw [e1]
    simp_rw [hF, Finset.sum_mul]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun α _ => ?_
    rw [hu' α, Finset.mul_sum]
    exact Finset.sum_congr rfl fun y _ => by ring
  have hS2le : S2 ≤ s * ∑ y ∈ T, ‖F y‖ := by
    have h1 : S2 = ‖(S2 : ℂ)‖ := by rw [Complex.norm_real, Real.norm_of_nonneg hS2nn]
    rw [h1, hS2c, Finset.mul_sum]
    refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun y _ => ?_)
    rw [norm_mul, mul_comm]
    exact mul_le_mul_of_nonneg_right (hs _) (norm_nonneg _)
  -- the weighted kernels
  set N : EuclideanSpace ℝ (Fin n) → ℂ :=
    fun ξ => ∑ α ∈ V, c α * gridSymbol S B (phiEps n ε) α ξ with hN
  have hwF : ∀ y, ((companionWeight n ε y : ℝ) : ℂ) * F y = latKernel N y := by
    intro y
    rw [hN, latKernel_sum_mul V c (fun α _ => integrableOn_gridSymbol B (integrable_phiEps hε) α)
      y, hF, Finset.mul_sum]
    refine Finset.sum_congr rfl fun α _ => ?_
    simp only [hK]
    rw [latKernel_gridSymbol hd (integrable_phiEps hε), latKernel_gridSymbol hd
      (integrable_cutoffEps hε), fourierInv_phiEps hε, companionWeight]
    push_cast
    ring
  -- Cauchy–Schwarz on `Q ℤⁿ`
  set a : (Fin n → ℤ) → ℝ :=
    fun y => if ∀ i, ((blockProd B : ℕ) : ℤ) ∣ y i then (companionWeight n ε y)⁻¹ else 0 with ha
  set b : (Fin n → ℤ) → ℝ := fun y => ‖latKernel N y‖ with hb
  have hab : ∀ y, ‖F y‖ = a y * b y := by
    intro y
    have hw0 : 0 < companionWeight n ε y := lt_of_lt_of_le one_pos (one_le_companionWeight ε y)
    by_cases hy : ∀ i, ((blockProd B : ℕ) : ℤ) ∣ y i
    · simp only [ha, hb, ite_eq_left hy]
      rw [← hwF, norm_mul, Complex.norm_real, Real.norm_of_nonneg hw0.le, ← mul_assoc,
        inv_mul_cancel₀ hw0.ne', one_mul]
    · have : F y = 0 := Finset.sum_eq_zero fun α _ => by
        simp only [hK]
        rw [latKernel_gridSymbol hd (integrable_cutoffEps hε), ite_eq_right hy]; simp
      simp [ha, ite_eq_right hy, this]
  have hCS : (∑ y ∈ T, ‖F y‖) ^ 2 ≤ (∑ y ∈ T, a y ^ 2) * (∑ y ∈ T, b y ^ 2) := by
    simp_rw [hab]; exact Finset.sum_mul_sq_le_sq_mul_sq T a b
  have ha2 : ∑ y ∈ T, a y ^ 2 ≤
      2 ^ (n + 1) * ((ε * blockProd B)⁻¹) ^ n * envelopeConst n := by
    refine le_trans (le_of_eq ?_) (sum_weight_inv_sq_le hQ1 hε hεQ T)
    refine Finset.sum_congr rfl fun y _ => ?_
    simp only [ha]; split_ifs <;> simp
  -- Bessel's inequality for the weighted kernels
  obtain ⟨Mφ, hMφ0, hMφ⟩ := exists_norm_phiEps_le (n := n) ε
  have hPb : ∀ η, ‖periodize (phiEps n ε) η‖ ≤ Mφ :=
    norm_periodize_le (phiEps_support hε) hε4 hMφ0 hMφ
  have hNmeas : AEStronglyMeasurable N (volume.restrict (torusCube n)) :=
    (integrable_finsetSum V fun α _ =>
      (integrableOn_gridSymbol B (integrable_phiEps hε) α).const_mul (c α)).1
  have hNb : ∀ ξ, ‖N ξ‖ ≤ ∑ α ∈ V, ‖c α‖ * (Gr.card * Mφ) := by
    intro ξ
    refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun α _ => ?_)
    rw [norm_mul]
    refine mul_le_mul_of_nonneg_left ((norm_sum_le _ _).trans ?_) (norm_nonneg _)
    have := Finset.sum_le_sum (s := Gr) fun β _ => hPb (ξ - ratPt (blockProd S) (α + β))
    simpa using this
  have hBes := summable_and_tsum_norm_sq_latKernel_le hNmeas (fun ξ _ => hNb ξ)
  have hb2 : ∑ y ∈ T, b y ^ 2 ≤ ∫ ξ in torusCube n, ‖N ξ‖ ^ 2 :=
    (hBes.1.sum_le_tsum T fun _ _ => sq_nonneg _).trans hBes.2
  -- `∫ |N|² = S2 · Qⁿ εⁿ ∫|Φ|²` by disjointness of the bumps
  have hptN : ∀ ξ, ‖N ξ‖ ^ 2 = ∑ p ∈ V ×ˢ Gr,
      ‖c p.1‖ ^ 2 * ‖periodize (phiEps n ε) (ξ - ratPt (blockProd S) (p.1 + p.2))‖ ^ 2 := by
    intro ξ
    have e : N ξ = ∑ p ∈ V ×ˢ Gr,
        c p.1 * periodize (phiEps n ε) (ξ - ratPt (blockProd S) (p.1 + p.2)) := by
      rw [hN, Finset.sum_product]
      exact Finset.sum_congr rfl fun α _ => by rw [gridSymbol, Finset.mul_sum]
    rw [e, norm_sq_sum_of_atMostOne]
    · exact Finset.sum_congr rfl fun p _ => by rw [norm_mul, mul_pow]
    · rintro ⟨α, β⟩ hp ⟨α', β'⟩ hp' h h'
      simp only [Finset.mem_product] at hp hp'
      dsimp only at h h' ⊢
      have hγ := periodize_center_atMostOne (phiEps_support hε) hS1 hS hε hεr
        (add_mem_sigmaLe_of_grid hS hB hA₀ hp.1 hp.2)
        (add_mem_sigmaLe_of_grid hS hB hA₀ hp'.1 hp'.2) ξ (right_ne_zero_of_mul h)
        (right_ne_zero_of_mul h')
      have hα : α = α' := by
        rw [← blockProj_add_of_grid hS hB hA₀ hp.1 hp.2, hγ,
          blockProj_add_of_grid hS hB hA₀ hp'.1 hp'.2]
      subst hα
      simp only [Prod.mk.injEq, true_and]
      exact add_left_cancel hγ
  have hintP : ∀ γ : Fin n → ZMod (blockProd S), IntegrableOn
      (fun ξ => ‖periodize (phiEps n ε) (ξ - ratPt (blockProd S) γ)‖ ^ 2) (torusCube n) := by
    intro γ
    refine integrableOn_torusCube_of_bound
      ((integrableOn_periodize_sub (integrable_phiEps hε) _).1.norm.pow 2) (Mφ ^ 2)
      fun ξ _ => ?_
    rw [Real.norm_of_nonneg (sq_nonneg _)]
    exact pow_le_pow_left₀ (norm_nonneg _) (hPb _) 2
  have hNint : ∫ ξ in torusCube n, ‖N ξ‖ ^ 2 =
      S2 * ((blockProd B : ℝ) ^ n * (ε ^ n * companionPhiL2 n)) := by
    simp_rw [hptN]
    rw [integral_finsetSum _ fun p _ => (hintP _).const_mul _]
    simp_rw [integral_const_mul, setIntegral_norm_sq_periodize_sub (phiEps_support hε) hε4
      (integrable_norm_sq_phiEps hε), integral_norm_sq_phiEps hε]
    rw [Finset.sum_product, hS2, Finset.sum_mul]
    refine Finset.sum_congr rfl fun α _ => ?_
    dsimp only
    rw [Finset.sum_const, nsmul_eq_mul, hGr, card_blockGrid hd, hc, Complex.norm_conj]
    push_cast; ring
  -- conclusion
  set X := ∑ y ∈ T, ‖F y‖ with hX
  have hX0 : 0 ≤ X := Finset.sum_nonneg fun _ _ => norm_nonneg _
  have hX2 : X ^ 2 ≤ companionGridConst n * S2 := by
    refine hCS.trans ((mul_le_mul ha2 (hb2.trans (le_of_eq hNint))
      (Finset.sum_nonneg fun _ _ => sq_nonneg _) (by
        have := envelopeConst_nonneg n; positivity)).trans (le_of_eq ?_))
    have hεQ0 : ε * blockProd B ≠ 0 := (mul_pos hε hQr).ne'
    rw [companionGridConst]
    have key : ((ε * (blockProd B : ℝ))⁻¹) ^ n * ((blockProd B : ℝ) ^ n * ε ^ n) = 1 := by
      rw [← mul_pow, ← mul_pow, mul_comm (blockProd B : ℝ) ε, inv_mul_cancel₀ hεQ0, one_pow]
    calc _ = 2 ^ (n + 1) * envelopeConst n * companionPhiL2 n * S2 *
          (((ε * (blockProd B : ℝ))⁻¹) ^ n * ((blockProd B : ℝ) ^ n * ε ^ n)) := by ring
      _ = _ := by rw [key, mul_one]
  have h1 : S2 ^ 2 ≤ s ^ 2 * (companionGridConst n * S2) := by
    calc S2 ^ 2 ≤ (s * X) ^ 2 := pow_le_pow_left₀ hS2nn hS2le 2
      _ = s ^ 2 * X ^ 2 := by ring
      _ ≤ s ^ 2 * (companionGridConst n * S2) := by gcongr
  rcases hS2nn.eq_or_lt with h0 | hpos
  · rw [← h0]; exact mul_nonneg companionGridConst_nonneg (sq_nonneg _)
  · have : S2 * S2 ≤ (companionGridConst n * s ^ 2) * S2 := by nlinarith
    exact le_of_mul_le_mul_right this hpos

/-! ### Blueprint Lemma 7.6 (`lem:companion`), the case `t = ∞` -/

/-- Inclusion–exclusion (eq. `inclusionexclusion`) for the symbols:
`T_{m; α + Σ_{A₀}} = ∑_{B ⊆ A₀} (-1)^{|A₀| - |B|} T_{m; α + T[Q_B]}`. -/
lemma cosetSymbol_cosetSet_eq_sum_gridSymbol {S : Finset ℕ}
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {A₀ : Finset ℕ}
    (hA₀ : A₀ ⊆ S) (m : EuclideanSpace ℝ (Fin n) → ℂ) (α : Fin n → ZMod (blockProd S))
    (ξ : EuclideanSpace ℝ (Fin n)) :
    cosetSymbol (blockProd S) m (cosetSet S A₀ α) ξ =
      ∑ B ∈ A₀.powerset, (-1 : ℂ) ^ (#A₀ - #B) * gridSymbol S B m α ξ := by
  rw [cosetSymbol_cosetSet, sum_sigmaBlock_inclusion_exclusion hS hA₀]
  refine Finset.sum_congr rfl fun B _ => ?_
  rw [zsmul_eq_mul, gridSymbol]
  push_cast; rfl

/-- `P_{A₀,α} f = ∑_{B ⊆ A₀} (-1)^{|A₀| - |B|} T_{θ_ε; α + T[Q_B]} f`. -/
lemma companionProj_eq_sum {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {A₀ : Finset ℕ} (hA₀ : A₀ ⊆ S) {ε : ℝ} (hε : 0 < ε)
    {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) (α : Fin n → ZMod (blockProd S))
    (x : Fin n → ℤ) :
    companionProj S ε A₀ α f x = ∑ B ∈ A₀.powerset,
      (-1 : ℂ) ^ (#A₀ - #B) * latMult (gridSymbol S B (cutoffEps n ε) α) f x := by
  unfold companionProj cosetMult
  rw [show cosetSymbol (blockProd S) (cutoffEps n ε) (cosetSet S A₀ α) = fun ξ =>
      ∑ B ∈ A₀.powerset, (-1 : ℂ) ^ (#A₀ - #B) * gridSymbol S B (cutoffEps n ε) α ξ from
    funext (cosetSymbol_cosetSet_eq_sum_gridSymbol hS hA₀ _ α)]
  exact latMult_sum_mul _ _ (fun B _ => integrableOn_gridSymbol B (integrable_cutoffEps hε) α)
    hf x

/-- The vector `(P_{A₀,α} f(x))_{α ∈ Σ^{A₀}}` in the finite-dimensional Hilbert space `ℓ²_α`
(coordinates outside `Σ^{A₀}` are zero). -/
noncomputable def companionVec (S : Finset ℕ) [NeZero (blockProd S)] (k : ℕ) (ε : ℝ)
    (f : (Fin n → ℤ) → ℂ) (A₀ : Finset ℕ) (x : Fin n → ℤ) :
    EuclideanSpace ℂ (Fin n → ZMod (blockProd S)) :=
  WithLp.toLp 2 fun α => if α ∈ sigmaUpper S k A₀ then companionProj S ε A₀ α f x else 0

lemma norm_sq_toLp_ite {ι : Type*} [Fintype ι] [DecidableEq ι] (V : Finset ι) (g : ι → ℂ) :
    ‖(WithLp.toLp 2 fun α => if α ∈ V then g α else 0 : EuclideanSpace ℂ ι)‖ ^ 2 =
      ∑ α ∈ V, ‖g α‖ ^ 2 := by
  rw [EuclideanSpace.norm_sq_eq]
  have h : ∀ α, ‖(if α ∈ V then g α else 0)‖ ^ 2 = if α ∈ V then ‖g α‖ ^ 2 else 0 :=
    fun α => by split_ifs <;> simp
  rw [Finset.sum_congr rfl fun α _ => h α, Finset.sum_ite_mem, Finset.univ_inter]

/-- `‖(P_{A₀,α} f(x))_α‖_{ℓ²_α}² = ∑_{α ∈ Σ^{A₀}} |P_{A₀,α} f(x)|²`. -/
lemma norm_sq_companionVec (S : Finset ℕ) [NeZero (blockProd S)] (k : ℕ) (ε : ℝ)
    (f : (Fin n → ℤ) → ℂ) (A₀ : Finset ℕ) (x : Fin n → ℤ) :
    ‖companionVec S k ε f A₀ x‖ ^ 2 =
      ∑ α ∈ sigmaUpper S k A₀, ‖companionProj S ε A₀ α f x‖ ^ 2 := by
  classical
  unfold companionVec
  convert norm_sq_toLp_ite (sigmaUpper S k A₀) (fun α => companionProj S ε A₀ α f x)

/-- The constant `C_{n,k} = 2^k (2^{n+1} C_n ∫|Φ|²)^{1/2}` of the case `t = ∞`. -/
noncomputable def companionInftyConst (n k : ℕ) : ℝ :=
  2 ^ k * Real.sqrt (companionGridConst n)

lemma companionInftyConst_nonneg (n k : ℕ) : 0 ≤ companionInftyConst n k := by
  unfold companionInftyConst; positivity

/-- Blueprint Lemma 7.6 (`lem:companion`), the case `t = ∞`: under the separation hypothesis
(7.1), for every core `A₀ ⊆ S` with `|A₀| ≤ k`, every finitely supported `f` with `|f| ≤ s` and
every `x ∈ ℤⁿ`, `‖(P_{A₀,α} f(x))_{α ∈ Σ^{A₀}}‖_{ℓ²_α} ≤ C_{n,k} s`, i.e.
`(∑_{α ∈ Σ^{A₀}} |P_{A₀,α} f(x)|²)^{1/2} ≤ C_{n,k} sup |f|`, uniformly in the core, with
`C_{n,k} = companionInftyConst n k` depending only on `n` and `k`. -/
theorem companion_infty {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} {ε : ℝ}
    (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    {A₀ : Finset ℕ} (hA₀ : A₀ ⊆ S) (hA₀k : #A₀ ≤ k)
    {f : (Fin n → ℤ) → ℂ} (hf : (Function.support f).Finite) {s : ℝ}
    (hs : ∀ y, ‖f y‖ ≤ s) (x : Fin n → ℤ) :
    ‖companionVec S k ε f A₀ x‖ ≤ companionInftyConst n k * s := by
  classical
  have hfs := summable_of_finite_support hf
  have hs0 : 0 ≤ s := (norm_nonneg _).trans (hs 0)
  set gv : Finset ℕ → EuclideanSpace ℂ (Fin n → ZMod (blockProd S)) := fun B =>
    WithLp.toLp 2 fun α => if α ∈ sigmaUpper S k A₀ then
      latMult (gridSymbol S B (cutoffEps n ε) α) f x else 0 with hgv
  have hv : companionVec S k ε f A₀ x =
      ∑ B ∈ A₀.powerset, ((-1 : ℂ) ^ (#A₀ - #B)) • gv B := by
    ext α
    simp only [companionVec, hgv, WithLp.ofLp_sum, WithLp.ofLp_smul, Finset.sum_apply,
      Pi.smul_apply, smul_eq_mul]
    split_ifs
    · exact companionProj_eq_sum hS hA₀ hε hfs α x
    · simp
  have hgvb : ∀ B ∈ A₀.powerset, ‖gv B‖ ≤ Real.sqrt (companionGridConst n) * s := by
    intro B hB
    have h2 : ‖gv B‖ ^ 2 ≤ companionGridConst n * s ^ 2 := by
      rw [hgv, norm_sq_toLp_ite]
      exact sum_norm_sq_latMult_gridSymbol_le hS1 hS hε hεr (Finset.mem_powerset.1 hB) hA₀
        hA₀k hf hs x
    rw [← Real.sqrt_sq hs0, ← Real.sqrt_mul companionGridConst_nonneg]
    exact Real.le_sqrt_of_sq_le h2
  rw [hv]
  refine (norm_sum_le _ _).trans ?_
  calc ∑ B ∈ A₀.powerset, ‖((-1 : ℂ) ^ (#A₀ - #B)) • gv B‖
      ≤ ∑ _B ∈ A₀.powerset, Real.sqrt (companionGridConst n) * s := by
        refine Finset.sum_le_sum fun B hB => ?_
        rw [norm_smul, norm_pow, norm_neg, norm_one, one_pow, one_mul]
        exact hgvb B hB
    _ = 2 ^ #A₀ * (Real.sqrt (companionGridConst n) * s) := by
        rw [Finset.sum_const, Finset.card_powerset, nsmul_eq_mul]; push_cast; ring
    _ ≤ 2 ^ k * (Real.sqrt (companionGridConst n) * s) := by
        gcongr
        · norm_num
    _ = companionInftyConst n k * s := by rw [companionInftyConst]; ring

/-- Blueprint Lemma 7.6 (`lem:companion`), the case `t = ∞`, in square-sum form:
`∑_{α ∈ Σ^{A₀}} |P_{A₀,α} f(x)|² ≤ (C_{n,k} s)²` whenever `|f| ≤ s`. -/
theorem companion_infty_sq {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} {ε : ℝ}
    (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    {A₀ : Finset ℕ} (hA₀ : A₀ ⊆ S) (hA₀k : #A₀ ≤ k)
    {f : (Fin n → ℤ) → ℂ} (hf : (Function.support f).Finite) {s : ℝ}
    (hs : ∀ y, ‖f y‖ ≤ s) (x : Fin n → ℤ) :
    ∑ α ∈ sigmaUpper S k A₀, ‖companionProj S ε A₀ α f x‖ ^ 2 ≤
      (companionInftyConst n k * s) ^ 2 := by
  rw [← norm_sq_companionVec]
  exact pow_le_pow_left₀ (norm_nonneg _) (companion_infty hS1 hS hε hεr hA₀ hA₀k hf hs x) 2

/-! ### Blueprint Lemma 7.6 (`lem:companion`), `2 ≤ t < ∞`: interpolation -/

section CompanionInterpolation

open scoped ENNReal NNReal

lemma latFT_add {f g : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖)
    (hg : Summable fun z => ‖g z‖) : latFT (f + g) = latFT f + latFT g := by
  funext ξ
  simp only [latFT, Pi.add_apply, add_mul]
  exact (summable_latFT_term hf ξ).tsum_add (summable_latFT_term hg ξ)

/-- `m(D)` is additive on `ℓ¹` for symbols integrable on the torus. -/
lemma latMult_add {m : EuclideanSpace ℝ (Fin n) → ℂ} (hm : IntegrableOn m (torusCube n))
    {f g : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) (hg : Summable fun z => ‖g z‖) :
    latMult m (f + g) = latMult m f + latMult m g := by
  have hint : ∀ {h : (Fin n → ℤ) → ℂ}, (Summable fun z => ‖h z‖) → ∀ x : Fin n → ℤ,
      IntegrableOn (fun ξ => m ξ * latFT h ξ * eC (inner ℝ (latEmbed x) ξ)) (torusCube n) := by
    intro h hh x
    have : IntegrableOn (fun ξ => m ξ * (latFT h ξ * eC (inner ℝ (latEmbed x) ξ)))
        (torusCube n) := hm.mul_bdd (c := ∑' z, ‖h z‖)
      (((continuous_latFT hh).mul (by fun_prop [continuous_eC])).aestronglyMeasurable)
      (Filter.Eventually.of_forall fun ξ => by
        rw [norm_mul, norm_eC, mul_one]; exact norm_latFT_le hh ξ)
    refine this.congr (Filter.Eventually.of_forall fun ξ => ?_)
    simp only; ring
  funext x
  simp only [latMult, Pi.add_apply, latFT_add hf hg, mul_add, add_mul]
  exact integral_add (hint hf x) (hint hg x)

lemma companionProj_add {S : Finset ℕ} [NeZero (blockProd S)] {ε : ℝ} (hε : 0 < ε)
    (A₀ : Finset ℕ) (α : Fin n → ZMod (blockProd S)) {f g : (Fin n → ℤ) → ℂ}
    (hf : Summable fun z => ‖f z‖) (hg : Summable fun z => ‖g z‖) :
    companionProj S ε A₀ α (f + g) = companionProj S ε A₀ α f + companionProj S ε A₀ α g :=
  latMult_add (integrableOn_cosetSymbol (integrable_cutoffEps hε) _) hf hg

/-- The companion operator `f ↦ ((P_{A₀,α} f(x))_{α})_{(x, A₀)}` from `ℓ^t(G)` to
`ℓ^t(G × {A₀ : |A₀| ≤ k}; ℓ²_α)` (zero off the cores). -/
noncomputable def companionOp (S : Finset ℕ) [NeZero (blockProd S)] (k : ℕ) (ε : ℝ)
    (f : (Fin n → ℤ) → ℂ) (p : (Fin n → ℤ) × Finset ℕ) :
    EuclideanSpace ℂ (Fin n → ZMod (blockProd S)) :=
  if p.2 ∈ S.powerset.filter (fun A₀ => #A₀ ≤ k) then companionVec S k ε f p.2 p.1 else 0

lemma companionOp_add {S : Finset ℕ} [NeZero (blockProd S)] (k : ℕ) {ε : ℝ} (hε : 0 < ε)
    {f g : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) (hg : Summable fun z => ‖g z‖)
    (p : (Fin n → ℤ) × Finset ℕ) :
    companionOp S k ε (f + g) p = companionOp S k ε f p + companionOp S k ε g p := by
  unfold companionOp
  split_ifs
  · ext α
    simp only [companionVec, WithLp.ofLp_add, Pi.add_apply]
    split_ifs
    · rw [companionProj_add hε _ _ hf hg, Pi.add_apply]
    · simp
  · simp

/-- Sums over `G × {cores}` of a function vanishing at `0` split over the cores. -/
lemma tsum_companionOp (S : Finset ℕ) [NeZero (blockProd S)] (k : ℕ) (ε : ℝ)
    (f : (Fin n → ℤ) → ℂ) (g : EuclideanSpace ℂ (Fin n → ZMod (blockProd S)) → ℝ≥0∞)
    (hg : g 0 = 0) :
    ∑' p, g (companionOp S k ε f p) =
      ∑ A₀ ∈ S.powerset with #A₀ ≤ k, ∑' x, g (companionVec S k ε f A₀ x) := by
  have e := ENNReal.tsum_prod (f := fun x A₀ => g (companionOp S k ε f (x, A₀)))
  simp only [Prod.mk.eta] at e
  rw [e, ← Summable.tsum_finsetSum (fun _ _ => ENNReal.summable)]
  refine tsum_congr fun x => ?_
  rw [tsum_eq_sum (s := S.powerset.filter fun A₀ => #A₀ ≤ k) fun A₀ hA₀ => by
    simp only [companionOp]; rw [ite_eq_right hA₀, hg]]
  exact Finset.sum_congr rfl fun A₀ hA₀ => by simp only [companionOp]; rw [ite_eq_left hA₀]

lemma enorm_sq_companionVec (S : Finset ℕ) [NeZero (blockProd S)] (k : ℕ) (ε : ℝ)
    (f : (Fin n → ℤ) → ℂ) (A₀ : Finset ℕ) (x : Fin n → ℤ) :
    ‖companionVec S k ε f A₀ x‖ₑ ^ 2 =
      ∑ α ∈ sigmaUpper S k A₀, ‖companionProj S ε A₀ α f x‖ₑ ^ 2 := by
  rw [enorm_pow_eq_ofReal, norm_sq_companionVec,
    ENNReal.ofReal_sum_of_nonneg fun _ _ => sq_nonneg _]
  simp_rw [enorm_pow_eq_ofReal]

lemma enorm_rpow_companionVec (S : Finset ℕ) [NeZero (blockProd S)] (k : ℕ) (ε : ℝ)
    (f : (Fin n → ℤ) → ℂ) (A₀ : Finset ℕ) (x : Fin n → ℤ) {t : ℝ} :
    ‖companionVec S k ε f A₀ x‖ₑ ^ t =
      (∑ α ∈ sigmaUpper S k A₀, ‖companionProj S ε A₀ α f x‖ₑ ^ 2) ^ (t / 2) := by
  rw [← enorm_sq_companionVec, ← ENNReal.rpow_natCast, ← ENNReal.rpow_mul]
  congr 1; push_cast; ring

/-- Blueprint Lemma 7.6 (`lem:companion`), the case `t = 2`, in `ℝ≥0∞` form:
`∑_{|A₀| ≤ k} ∑_x ∑_{α ∈ Σ^{A₀}} |P_{A₀,α} f(x)|² ≤ 2^k ∑_x |f(x)|²` for `f ∈ ℓ¹`. -/
theorem companion_two_enorm {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} {ε : ℝ}
    (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) :
    ∑ A₀ ∈ S.powerset with #A₀ ≤ k, ∑' x,
        ∑ α ∈ sigmaUpper S k A₀, ‖companionProj S ε A₀ α f x‖ₑ ^ 2 ≤
      ENNReal.ofReal (2 ^ k) * ∑' x, ‖f x‖ₑ ^ 2 := by
  obtain ⟨hsum, hle⟩ := companion_two hS1 hS hε hεr hf
  have hs : ∀ A₀, Summable fun x => ∑ α ∈ sigmaUpper S k A₀, ‖companionProj S ε A₀ α f x‖ ^ 2 :=
    fun A₀ => summable_sum fun α _ => hsum A₀ α
  have hf2 : Summable fun x => ‖f x‖ ^ 2 :=
    summable_pow_of_summable_nonneg (fun _ => norm_nonneg _) hf (by norm_num)
  have e : ∀ A₀ x, ∑ α ∈ sigmaUpper S k A₀, ‖companionProj S ε A₀ α f x‖ₑ ^ 2 =
      ENNReal.ofReal (∑ α ∈ sigmaUpper S k A₀, ‖companionProj S ε A₀ α f x‖ ^ 2) := by
    intro A₀ x
    rw [ENNReal.ofReal_sum_of_nonneg fun _ _ => sq_nonneg _]
    simp_rw [enorm_pow_eq_ofReal]
  simp_rw [e]
  rw [tsum_enorm_pow_eq_ofReal hf2, ← ENNReal.ofReal_mul (by positivity)]
  rw [Finset.sum_congr rfl fun A₀ _ => (ENNReal.ofReal_tsum_of_nonneg
    (fun x => Finset.sum_nonneg fun _ _ => sq_nonneg _) (hs A₀)).symm,
    ← ENNReal.ofReal_sum_of_nonneg fun A₀ _ => tsum_nonneg fun x =>
      Finset.sum_nonneg fun _ _ => sq_nonneg _]
  exact ENNReal.ofReal_le_ofReal hle

/-- The constant of Blueprint Lemma 7.6 (`lem:companion`) for `2 ≤ t < ∞`: `2^k` for `t = 2`,
and `t 2² (2^k)² c^{2-t}/(t-2)` with `c = (2 (C_{n,k} + 1))⁻¹` (Marcinkiewicz with the
`L^∞` endpoint) for `t > 2`; it depends only on `n`, `k` and `t`. -/
noncomputable def companionConst (n k : ℕ) (t : ℝ) : ℝ :=
  if t = 2 then 2 ^ k else
    t * (2 ^ (2 : ℝ) * ((2 : ℝ) ^ k) ^ (2 : ℝ) *
      ((2 * (companionInftyConst n k + 1))⁻¹) ^ (2 - t) / (t - 2))

lemma companionConst_nonneg (n k : ℕ) {t : ℝ} (ht : 2 ≤ t) : 0 ≤ companionConst n k t := by
  unfold companionConst
  split_ifs with h
  · positivity
  · have ht' : 0 < t - 2 := by
      rcases ht.lt_or_eq with h' | h'
      · linarith
      · exact absurd h'.symm h
    have := companionInftyConst_nonneg n k
    positivity

/-- Blueprint Lemma 7.6 (`lem:companion`), eq. (`eq:companion`) for `2 ≤ t < ∞`: under the
separation hypothesis (7.1), for every finitely supported `f` on `G = ℤⁿ`,
`‖(P_{A₀,α} f)_{A₀,α ∈ Σ^{A₀}}‖_{ℓ^t(G × {A₀ : |A₀| ≤ k}; ℓ²_α)}^t ≤ C_{n,k,t} ‖f‖_{ℓ^t(G)}^t`,
written out as
`∑_{A₀ ⊆ S, |A₀| ≤ k} ∑_x (∑_{α ∈ Σ^{A₀}} |P_{A₀,α} f(x)|²)^{t/2} ≤ C_{n,k,t} ∑_x |f(x)|^t`
(in `ℝ≥0∞`), with `C_{n,k,t} = companionConst n k t` depending only on `n`, `k`, `t`. The proof
interpolates (Marcinkiewicz, Blueprint Lemma 2.3, with input space `(G, count)` and output space
`(G × {cores}, count)` valued in `ℓ²_α`) between `companion_two` and `companion_infty`. -/
theorem companion_estimate {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} {ε : ℝ}
    (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    {t : ℝ} (ht : 2 ≤ t) {f : (Fin n → ℤ) → ℂ} (hf : (Function.support f).Finite) :
    ∑ A₀ ∈ S.powerset with #A₀ ≤ k, ∑' x,
        (∑ α ∈ sigmaUpper S k A₀, ‖companionProj S ε A₀ α f x‖ₑ ^ 2) ^ (t / 2) ≤
      ENNReal.ofReal (companionConst n k t) * ∑' x, ‖f x‖ₑ ^ t := by
  classical
  rcases ht.lt_or_eq with ht2 | rfl
  swap
  · -- `t = 2`
    simp only [div_self (two_ne_zero' ℝ), ENNReal.rpow_one, companionConst, ite_true]
    rw [show (2 : ℝ) = ((2 : ℕ) : ℝ) by norm_num]
    simp only [ENNReal.rpow_natCast]
    exact companion_two_enorm hS1 hS hε hεr (summable_of_finite_support hf)
  -- `t > 2`: Marcinkiewicz interpolation
  set D : Set ((Fin n → ℤ) → ℂ) := {g | (Function.support g).Finite} with hD
  set T := companionOp (n := n) S k ε with hT
  set A : ℝ≥0 := 2 ^ k with hA
  set B : ℝ≥0 := ⟨companionInftyConst n k + 1, by
    have := companionInftyConst_nonneg n k; positivity⟩ with hB
  have hB0 : (0 : ℝ) < B := by
    change (0 : ℝ) < companionInftyConst n k + 1; linarith [companionInftyConst_nonneg n k]
  set c : ℝ := (2 * (companionInftyConst n k + 1))⁻¹ with hc
  have hc0 : 0 < c := by rw [hc]; have := companionInftyConst_nonneg n k; positivity
  have hBc : (B : ℝ) * c ≤ 1 / 2 := by
    change (companionInftyConst n k + 1) * c ≤ 1 / 2
    rw [hc]
    have : companionInftyConst n k + 1 ≠ 0 := by
      have := companionInftyConst_nonneg n k; positivity
    field_simp; norm_num
  -- strong type `(2,2)`
  have hstrong : HasStrongTypeOn T D 2 A Measure.count Measure.count := by
    intro g hg
    have hgs := summable_of_finite_support hg
    have h2 : ∫⁻ p, ‖T g p‖ₑ ^ (2 : ℝ) ∂Measure.count ≤
        ENNReal.ofReal (2 ^ k) * ∫⁻ x, ‖g x‖ₑ ^ (2 : ℝ) ∂Measure.count := by
      rw [lintegral_count, lintegral_count, hT,
        tsum_companionOp S k ε g (fun v => ‖v‖ₑ ^ (2 : ℝ)) (by simp)]
      simp_rw [show (2 : ℝ) = ((2 : ℕ) : ℝ) by norm_num, ENNReal.rpow_natCast,
        enorm_sq_companionVec]
      exact companion_two_enorm hS1 hS hε hεr hgs
    refine (eLpNorm_le_of_lintegral_rpow_le AEStronglyMeasurable.of_discrete
      AEStronglyMeasurable.of_discrete (by norm_num) h2).trans ?_
    gcongr
    have h1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal (2 ^ k) := by
      rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal (one_le_pow₀ (by norm_num))
    calc ENNReal.ofReal (2 ^ k) ^ (1 / 2 : ℝ) ≤ ENNReal.ofReal (2 ^ k) ^ (1 : ℝ) :=
          ENNReal.rpow_le_rpow_of_exponent_le h1 (by norm_num)
      _ = (A : ℝ≥0∞) := by
          rw [ENNReal.rpow_one, hA, ENNReal.ofReal_pow (by norm_num)]; simp
  have hweak := hstrong.hasWeakTypeOn (by norm_num : (0 : ℝ) < 2)
  -- the `L^∞` endpoint
  have hlinf : HasLinftyBoundOn T D B Measure.count := by
    intro g hg s hs
    refine Filter.Eventually.of_forall fun p => ?_
    have hs0 : 0 ≤ s := (norm_nonneg _).trans (hs 0)
    simp only [hT, companionOp]
    split_ifs with hp
    · obtain ⟨hp1, hp2⟩ := Finset.mem_filter.1 hp
      refine (companion_infty hS1 hS hε hεr (Finset.mem_powerset.1 hp1) hp2 hg hs p.1).trans ?_
      change _ ≤ (companionInftyConst n k + 1) * s
      have := companionInftyConst_nonneg n k
      nlinarith
    · simp only [norm_zero]; exact mul_nonneg B.2 hs0
  -- sublinearity and truncations
  have hsub : IsSublinearOn T D Measure.count := by
    intro g hg h hh
    refine Filter.Eventually.of_forall fun p => ?_
    rw [hT, companionOp_add k hε (summable_of_finite_support hg) (summable_of_finite_support hh)]
    exact norm_add_le _ _
  have htr : IsTruncationClosed D := by
    intro g hg s _
    have hsub' : ∀ s' : Set (Fin n → ℤ), Function.support (s'.indicator g) ⊆ Function.support g :=
      fun s' x hx => by
        rw [Function.mem_support] at hx ⊢; intro h0; exact hx (by simp [Set.indicator_apply, h0])
    exact ⟨hg.subset (hsub' _), hg.subset (hsub' _)⟩
  have key := lintegral_rpow_le_of_hasWeakTypeOn_of_linfty (μ := Measure.count)
    (ν := Measure.count) (by norm_num : (0 : ℝ) < 2) ht2 hc0 hBc hweak hlinf hsub htr
    (show f ∈ D from hf) AEStronglyMeasurable.of_discrete AEStronglyMeasurable.of_discrete
  rw [lintegral_count, lintegral_count, hT, tsum_companionOp S k ε f (fun v => ‖v‖ₑ ^ t)
    (by simp [ENNReal.zero_rpow_of_pos (by linarith : (0 : ℝ) < t)])] at key
  simp_rw [enorm_rpow_companionVec] at key
  refine key.trans (le_of_eq ?_)
  congr 1
  rw [marcinkiewiczBoundTop, companionConst, ite_eq_right ht2.ne']
  simp only [hA, hc]
  push_cast
  ring_nf

/-- Blueprint Lemma 7.6 (`lem:companion`) for the even exponents `t = 2p` used in Theorem 7.7:
`∑_{A₀ ⊆ S, |A₀| ≤ k} ∑_x (∑_{α ∈ Σ^{A₀}} |P_{A₀,α} f(x)|²)^p ≤ C_{n,k,2p} ∑_x |f(x)|^{2p}` for
`p ≥ 1` and finitely supported `f`. -/
theorem companion_estimate_nat {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} {ε : ℝ}
    (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    {p : ℕ} (hp : 1 ≤ p) {f : (Fin n → ℤ) → ℂ} (hf : (Function.support f).Finite) :
    ∑ A₀ ∈ S.powerset with #A₀ ≤ k, ∑' x,
        (∑ α ∈ sigmaUpper S k A₀, ‖companionProj S ε A₀ α f x‖ₑ ^ 2) ^ p ≤
      ENNReal.ofReal (companionConst n k (2 * p)) * ∑' x, ‖f x‖ₑ ^ (2 * p) := by
  have h := companion_estimate hS1 hS hε hεr (t := 2 * p)
    (by have : (1 : ℝ) ≤ p := by exact_mod_cast hp
        linarith) hf
  have e1 : ((2 * p : ℝ) / 2) = (p : ℝ) := by ring
  rw [e1] at h
  simp_rw [ENNReal.rpow_natCast] at h
  convert h using 3
  rw [show (2 * p : ℝ) = ((2 * p : ℕ) : ℝ) by push_cast; ring]
  funext x
  rw [ENNReal.rpow_natCast]

end CompanionInterpolation

end Companion

/-! ## Blueprint Theorem 7.7 (`thm:IW`): rational-frequency transference -/

section RationalTransference

open MeasureTheory Set Real
open scoped ComplexConjugate FourierTransform ContDiff ENNReal NNReal SchwartzMap

/-! ### Fourier inversion on the torus -/


/-- The quotient map `ℝⁿ → (ℝ/ℤ)ⁿ`. -/
noncomputable def torusQuot (n : ℕ) (x : Fin n → ℝ) : UnitAddTorus (Fin n) :=
  fun i => (x i : UnitAddCircle)

/-- The quotient map `ℝⁿ → (ℝ/ℤ)ⁿ` is an open quotient map. -/
lemma isOpenQuotientMap_torusQuot : IsOpenQuotientMap (torusQuot n) :=
  IsOpenQuotientMap.piMap fun _ => QuotientAddGroup.isOpenQuotientMap_mk

/-- Two points of `ℝⁿ` have the same image in `(ℝ/ℤ)ⁿ` iff they differ by a lattice point. -/
lemma torusQuot_eq_iff {x y : Fin n → ℝ} :
    torusQuot n x = torusQuot n y ↔
      ∃ k : Fin n → ℤ, WithLp.toLp 2 y = WithLp.toLp 2 x + latEmbed k := by
  constructor
  · intro h
    have : ∀ i, ∃ k : ℤ, y i = x i + k := by
      intro i
      have hi := congrFun h i
      simp only [torusQuot] at hi
      obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.1 (QuotientAddGroup.eq.1 hi)
      exact ⟨k, by simp at hk; linarith⟩
    choose k hk using this
    exact ⟨k, by ext i; simp [hk i]⟩
  · rintro ⟨k, hk⟩
    funext i
    have hi := congrArg (fun v : EuclideanSpace ℝ (Fin n) => v i) hk
    simp only [PiLp.add_apply, latEmbed_apply] at hi
    simp only [torusQuot]
    rw [show (y i : ℝ) = x i + (k i : ℤ) by simpa using hi]
    simp

/-- The multivariate characters pulled back to `ℝⁿ`: `mFourier j (x mod ℤⁿ) = e(j · x)`. -/
lemma mFourier_torusQuot (j : Fin n → ℤ) (x : Fin n → ℝ) :
    UnitAddTorus.mFourier j (torusQuot n x) = eC (inner ℝ (latEmbed j) (WithLp.toLp 2 x)) := by
  simp only [UnitAddTorus.mFourier, ContinuousMap.coe_mk, torusQuot, fourier_coe_apply]
  rw [PiLp.inner_apply, eC, ← Complex.exp_sum]
  congr 1
  simp only [latEmbed_apply, RCLike.inner_apply, conj_trivial]
  push_cast
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  ring

/-- Torus integrals over `[0,1)ⁿ ⊂ E` as integrals over the box `(0,1]ⁿ ⊂ ℝⁿ`. -/
lemma setIntegral_torusCube_eq_pi_Ioc (h : EuclideanSpace ℝ (Fin n) → ℂ) :
    ∫ ξ in torusCube n, h ξ =
      ∫ x in {x : Fin n → ℝ | ∀ i, x i ∈ Ioc (0 : ℝ) (0 + 1)}, h (WithLp.toLp 2 x) := by
  have hpre : (WithLp.toLp 2 : (Fin n → ℝ) → EuclideanSpace ℝ (Fin n)) ⁻¹' torusCube n =
      Set.pi univ fun _ => Ico (0 : ℝ) 1 := by
    ext x; simp [torusCube]
  have e1 := (PiLp.volume_preserving_toLp (Fin n)).setIntegral_preimage_emb
    (MeasurableEquiv.toLp 2 (Fin n → ℝ)).measurableEmbedding h (torusCube n)
  rw [← e1, hpre]
  have hset : {x : Fin n → ℝ | ∀ i, x i ∈ Ioc (0 : ℝ) (0 + 1)} = Set.pi univ fun _ => Ioc 0 1 := by
    ext x; simp
  rw [hset]
  refine setIntegral_congr_set ?_
  exact Measure.univ_pi_Ico_ae_eq_Icc.trans Measure.univ_pi_Ioc_ae_eq_Icc.symm

/-- Fourier inversion on the torus: a continuous `ℤⁿ`-periodic `g : E → ℂ` whose inverse Fourier
coefficients `ǧ` are absolutely summable is the sum of its Fourier series, `(ǧ)^ = g`
(via Mathlib's multivariate Fourier series on `UnitAddTorus`). -/
theorem latFT_latKernel_of_continuous {g : EuclideanSpace ℝ (Fin n) → ℂ} (hg : Continuous g)
    (hper : ∀ ξ (k : Fin n → ℤ), g (ξ + latEmbed k) = g ξ)
    (hs : Summable fun y => ‖latKernel g y‖) (ξ : EuclideanSpace ℝ (Fin n)) :
    latFT (latKernel g) ξ = g ξ := by
  set q := torusQuot n
  have hq := isOpenQuotientMap_torusQuot (n := n)
  set g₀ : (Fin n → ℝ) → ℂ := fun x => g (WithLp.toLp 2 x) with hg₀
  have hfib : ∀ x y, q x = q y → g₀ x = g₀ y := by
    intro x y hxy
    obtain ⟨k, hk⟩ := torusQuot_eq_iff.1 hxy
    simp only [hg₀, hk, hper]
  set G : UnitAddTorus (Fin n) → ℂ := fun t => g₀ (Function.surjInv hq.surjective t) with hG
  have hGq : G ∘ q = g₀ := by
    funext x
    exact hfib _ _ (Function.surjInv_eq hq.surjective (q x))
  have hGc : Continuous G := by
    rw [← hq.continuous_comp_iff, hGq]
    exact hg.comp (PiLp.continuous_toLp 2 _)
  set Gc : C(UnitAddTorus (Fin n), ℂ) := ⟨G, hGc⟩
  have hcoef : ∀ j, UnitAddTorus.mFourierCoeff (⇑Gc) j = latKernel g (-j) := by
    intro j
    rw [UnitAddTorus.mFourierCoeff_eq_integral _ j 0, latKernel, setIntegral_torusCube_eq_pi_Ioc]
    refine setIntegral_congr_fun ?_ fun x _ => ?_
    · exact MeasurableSet.univ_pi' fun _ => measurableSet_Ioc
    · change UnitAddTorus.mFourier (-j) (q x) • G (q x) = _
      have : G (q x) = g₀ x := congrFun hGq x
      rw [this, mFourier_torusQuot, smul_eq_mul, mul_comm]
  have hsum : Summable (UnitAddTorus.mFourierCoeff (⇑Gc)) := by
    refine Summable.of_norm ?_
    simp_rw [hcoef]
    exact (Equiv.neg (Fin n → ℤ)).summable_iff.2 hs
  have h := UnitAddTorus.hasSum_mFourier_series_apply_of_summable hsum (q (WithLp.ofLp ξ))
  have hval : Gc (q (WithLp.ofLp ξ)) = g ξ := by
    change G (q (WithLp.ofLp ξ)) = g ξ
    rw [show G (q (WithLp.ofLp ξ)) = g₀ (WithLp.ofLp ξ) from congrFun hGq _]
  rw [hval] at h
  rw [← h.tsum_eq, latFT, ← (Equiv.neg (Fin n → ℤ)).tsum_eq]
  refine tsum_congr fun j => ?_
  rw [hcoef, mFourier_torusQuot, smul_eq_mul]
  simp [latEmbed_neg, inner_neg_left]

/-- The periodization of a continuous function supported in `[-c, c]ⁿ`, `c < 1/2`, is continuous
(locally it is a finite sum of translates). -/
lemma continuous_periodize_of_support {φ : EuclideanSpace ℝ (Fin n) → ℂ} (hφ : Continuous φ)
    {c : ℝ} (hc : c < 1 / 2) (hsupp : ∀ η, φ η ≠ 0 → ∀ i, |η i| ≤ c) :
    Continuous (periodize φ) := by
  rw [continuous_iff_continuousAt]
  intro ξ₀
  set F : Finset (Fin n → ℤ) :=
    Fintype.piFinset fun i => Finset.Icc (⌊ξ₀ i⌋ - 1) (⌊ξ₀ i⌋ + 1) with hF
  have hloc : ∀ ξ ∈ Metric.ball ξ₀ (1 / 2), periodize φ ξ = ∑ k ∈ F, φ (ξ - latEmbed k) := by
    intro ξ hξ
    rw [periodize]
    refine tsum_eq_sum fun k hk => ?_
    by_contra hne
    apply hk
    rw [hF, Fintype.mem_piFinset]
    intro i
    have h1 := hsupp _ hne i
    simp only [PiLp.sub_apply, latEmbed_apply] at h1
    have h2 : |ξ i - ξ₀ i| < 1 / 2 := by
      have := PiLp.norm_apply_le (ξ - ξ₀) i
      rw [Metric.mem_ball, dist_eq_norm] at hξ
      simp only [PiLp.sub_apply, Real.norm_eq_abs] at this
      linarith
    have hl := Int.floor_le (ξ₀ i)
    have hu := Int.lt_floor_add_one (ξ₀ i)
    rw [abs_le] at h1
    rw [abs_lt] at h2
    rw [Finset.mem_Icc]
    constructor
    · have : ((⌊ξ₀ i⌋ - 1 : ℤ) : ℝ) < k i + 1 := by push_cast; linarith
      exact_mod_cast (Int.lt_add_one_iff.1 (by exact_mod_cast this))
    · have : (k i : ℝ) < ((⌊ξ₀ i⌋ + 1 : ℤ) : ℝ) + 1 := by push_cast; linarith
      exact Int.lt_add_one_iff.1 (by exact_mod_cast this)
  have hcont : ContinuousAt (fun ξ => ∑ k ∈ F, φ (ξ - latEmbed k)) ξ₀ :=
    (continuous_finsetSum _ fun k _ => hφ.comp (continuous_sub_right _)).continuousAt
  refine hcont.congr ?_
  filter_upwards [Metric.ball_mem_nhds ξ₀ (by norm_num : (0 : ℝ) < 1 / 2)] with ξ hξ
  exact (hloc ξ hξ).symm

/-- Continuous functions are integrable on the torus `[0,1)ⁿ`. -/
lemma integrableOn_torusCube_of_continuous {g : EuclideanSpace ℝ (Fin n) → ℂ}
    (hg : Continuous g) : IntegrableOn g (torusCube n) :=
  (hg.continuousOn.integrableOn_compact (isCompact_box 1)).mono_set fun ξ hξ i => by
    obtain ⟨h0, h1⟩ := hξ i; rw [abs_le]; constructor <;> linarith

/-- Convolutions of `ℓ¹` sequences on `ℤⁿ` are in `ℓ¹`. -/
lemma summable_norm_latConv {K f : (Fin n → ℤ) → ℂ} (hK : Summable fun z => ‖K z‖)
    (hf : Summable fun z => ‖f z‖) : Summable fun x => ‖latConv K f x‖ := by
  have h := (young_latConv (p := 1) le_rfl
    (memLp_one_iff_integrable.2 (integrable_count_iff.2 hK))
    (memLp_one_iff_integrable.2 (integrable_count_iff.2 hf))).2.2
  exact integrable_count_iff.1 (memLp_one_iff_integrable.1 h)

/-- For a continuous `ℤⁿ`-periodic symbol `M` with `ℓ¹` kernel and `f ∈ ℓ¹`, `M(D) f ∈ ℓ¹` and
`(M(D) f)^ = M f̂` (Fourier inversion on the torus). -/
theorem latFT_latMult_of_continuous {M : EuclideanSpace ℝ (Fin n) → ℂ} (hM : Continuous M)
    (hper : ∀ ξ (k : Fin n → ℤ), M (ξ + latEmbed k) = M ξ)
    (hK : Summable fun y => ‖latKernel M y‖) {f : (Fin n → ℤ) → ℂ}
    (hf : Summable fun z => ‖f z‖) :
    (Summable fun x => ‖latMult M f x‖) ∧ ∀ ξ, latFT (latMult M f) ξ = M ξ * latFT f ξ := by
  have hs : Summable fun x => ‖latMult M f x‖ := by
    rw [latMult_eq_latConv (integrableOn_torusCube_of_continuous hM) hf]
    exact summable_norm_latConv hK hf
  refine ⟨hs, fun ξ => ?_⟩
  have e : latMult M f = latKernel (fun ξ => M ξ * latFT f ξ) := rfl
  rw [e]
  refine latFT_latKernel_of_continuous (g := fun ξ => M ξ * latFT f ξ)
    (hM.mul (continuous_latFT hf)) (fun η k => ?_) ?_ ξ
  · simp only [hper, latFT_add_latEmbed]
  · rw [← e]; exact hs

/-- Composition of lattice multipliers: `M₂(D) (M₃(D) f) = (M₂ M₃)(D) f` for `M₃` continuous,
periodic, with `ℓ¹` kernel, and `f ∈ ℓ¹`. -/
theorem latMult_latMult_of_continuous {M₂ M₃ : EuclideanSpace ℝ (Fin n) → ℂ}
    (hM₃ : Continuous M₃) (hper : ∀ ξ (k : Fin n → ℤ), M₃ (ξ + latEmbed k) = M₃ ξ)
    (hK : Summable fun y => ‖latKernel M₃ y‖) {f : (Fin n → ℤ) → ℂ}
    (hf : Summable fun z => ‖f z‖) :
    latMult M₂ (latMult M₃ f) = latMult (fun ξ => M₂ ξ * M₃ ξ) f := by
  funext x
  have h := (latFT_latMult_of_continuous hM₃ hper hK hf).2
  simp only [latMult, h]
  congr 1; funext ξ; ring

/-! ### Spatial windows with small Fourier support -/

/-- The bump `b_N` of radius `1/(N+3)` around `0` used for the spatial windows. -/
noncomputable def windowBump (n N : ℕ) : ContDiffBump (0 : EuclideanSpace ℝ (Fin n)) :=
  ⟨1 / (2 * (N + 3)), 1 / (N + 3), by positivity,
    one_div_lt_one_div_of_lt (by positivity) (by linarith)⟩

/-- The normalized bump `φ_N = b_N / ∫ b_N` (nonnegative, mass one, supported in the ball of
radius `1/(N+3)`), as a complex-valued function. -/
noncomputable def windowPhi (n N : ℕ) (ξ : EuclideanSpace ℝ (Fin n)) : ℂ :=
  ((windowBump n N).normed volume ξ : ℂ)

/-- The window `w_N(x) = 𝓕⁻ φ_N (x)` on `ℤⁿ`: `|w_N| ≤ 1`, `w_N → 1` pointwise, `w_N ∈ ℓ¹`, and
`ŵ_N = (φ_N)_per` is supported in `[-1/(N+3), 1/(N+3)]ⁿ + ℤⁿ`. -/
noncomputable def windowFun (n N : ℕ) (x : Fin n → ℤ) : ℂ :=
  𝓕⁻ (windowPhi n N) (latEmbed x)

/-- `φ_N` is supported in the cube `[-1/(N+3), 1/(N+3)]ⁿ`. -/
lemma windowPhi_support {N : ℕ} {ξ : EuclideanSpace ℝ (Fin n)} (h : windowPhi n N ξ ≠ 0)
    (i : Fin n) : |ξ i| ≤ 1 / (N + 3) := by
  have h1 : (windowBump n N).normed volume ξ ≠ 0 := fun h0 => h (by simp [windowPhi, h0])
  have h2 : ξ ∈ Function.support ((windowBump n N).normed volume) := h1
  rw [ContDiffBump.support_normed_eq, Metric.mem_ball, dist_zero_right] at h2
  have := PiLp.norm_apply_le ξ i
  rw [Real.norm_eq_abs] at this
  exact this.trans (le_of_lt (by simpa [windowBump] using h2))

/-- `φ_N` is smooth. -/
lemma contDiff_windowPhi (N : ℕ) : ContDiff ℝ ∞ (windowPhi n N) :=
  Complex.ofRealCLM.contDiff.comp (windowBump n N).contDiff_normed

/-- `φ_N` has compact support. -/
lemma hasCompactSupport_windowPhi (N : ℕ) : HasCompactSupport (windowPhi n N) :=
  (windowBump n N).hasCompactSupport_normed.comp_left Complex.ofReal_zero

/-- `φ_N` is integrable. -/
lemma integrable_windowPhi (N : ℕ) : Integrable (windowPhi n N) :=
  (contDiff_windowPhi N).continuous.integrable_of_hasCompactSupport (hasCompactSupport_windowPhi N)

/-- The window `w_N` is in `ℓ¹` (rapid decay of `𝓕⁻ φ_N` on the lattice). -/
lemma summable_windowFun (N : ℕ) : Summable fun x => ‖windowFun n N x‖ :=
  (fourierInv_latEmbed_rapidDecay_of_hasCompactSupport (contDiff_windowPhi N)
    (hasCompactSupport_windowPhi N)).2

/-- `∫ φ_N = 1`. -/
lemma integral_windowPhi (N : ℕ) : ∫ ξ, windowPhi n N ξ = 1 := by
  simp only [windowPhi]
  rw [integral_complex_ofReal, ContDiffBump.integral_normed, Complex.ofReal_one]

/-- `|w_N| ≤ ∫ φ_N = 1`. -/
lemma norm_windowFun_le (N : ℕ) (x : Fin n → ℤ) : ‖windowFun n N x‖ ≤ 1 := by
  rw [windowFun, fourierInv_eq_integral_eC]
  refine (norm_integral_le_integral_norm _).trans (le_of_eq ?_)
  have : ∀ ξ, ‖eC (inner ℝ ξ (latEmbed x)) * windowPhi n N ξ‖ =
      (windowBump n N).normed volume ξ := fun ξ => by
    rw [norm_mul, norm_eC, one_mul, windowPhi, Complex.norm_real, Real.norm_of_nonneg
      ((windowBump n N).nonneg_normed ξ)]
  simp_rw [this]
  exact ContDiffBump.integral_normed _

/-- `w_N(x) → 1` as `N → ∞`, since `|w_N(x) - 1| ≤ 2π |x|/(N+3)`. -/
lemma tendsto_windowFun (x : Fin n → ℤ) :
    Filter.Tendsto (fun N => windowFun n N x) Filter.atTop (nhds 1) := by
  set y := latEmbed x
  have hbound : ∀ N : ℕ, ‖windowFun n N x - 1‖ ≤ 2 * π * ‖y‖ * (1 / (N + 3)) := by
    intro N
    have e : windowFun n N x - 1 = ∫ ξ, (eC (inner ℝ ξ y) - 1) * windowPhi n N ξ := by
      have hsub : ∫ ξ, (eC (inner ℝ ξ y) - 1) * windowPhi n N ξ =
          (∫ ξ, eC (inner ℝ ξ y) * windowPhi n N ξ) - ∫ ξ, windowPhi n N ξ := by
        rw [← integral_sub]
        · congr 1; funext ξ; ring
        · exact (integrable_windowPhi N).bdd_mul (c := 1) (by fun_prop)
            (Filter.Eventually.of_forall fun ξ => le_of_eq (norm_eC _))
        · exact integrable_windowPhi N
      rw [hsub, integral_windowPhi, windowFun, fourierInv_eq_integral_eC]
    rw [e]
    refine (norm_integral_le_integral_norm _).trans ?_
    have hpt : ∀ ξ, ‖(eC (inner ℝ ξ y) - 1) * windowPhi n N ξ‖ ≤
        (2 * π * ‖y‖ * (1 / (N + 3))) * (windowBump n N).normed volume ξ := by
      intro ξ
      have hφ : ‖windowPhi n N ξ‖ = (windowBump n N).normed volume ξ := by
        rw [windowPhi, Complex.norm_real, Real.norm_of_nonneg ((windowBump n N).nonneg_normed ξ)]
      rw [norm_mul, hφ]
      by_cases h0 : (windowBump n N).normed volume ξ = 0
      · simp [h0]
      refine mul_le_mul_of_nonneg_right ?_ ((windowBump n N).nonneg_normed ξ)
      have h2 : ξ ∈ Function.support ((windowBump n N).normed volume) := h0
      rw [ContDiffBump.support_normed_eq, Metric.mem_ball, dist_zero_right] at h2
      have h3 : ‖ξ‖ ≤ 1 / (N + 3) := le_of_lt (by simpa [windowBump] using h2)
      have h4 := norm_eC_sub_eC_le (inner ℝ ξ y) 0
      rw [eC_zero, sub_zero] at h4
      refine h4.trans ?_
      have h5 : |inner ℝ ξ y| ≤ ‖ξ‖ * ‖y‖ := abs_real_inner_le_norm ξ y
      have : ‖ξ‖ * ‖y‖ ≤ 1 / (N + 3) * ‖y‖ := mul_le_mul_of_nonneg_right h3 (norm_nonneg _)
      nlinarith [Real.pi_pos]
    refine (integral_mono_of_nonneg (Filter.Eventually.of_forall fun _ => norm_nonneg _)
      (((windowBump n N).integrable_normed).const_mul _)
      (Filter.Eventually.of_forall hpt)).trans (le_of_eq ?_)
    rw [integral_const_mul, ContDiffBump.integral_normed, mul_one]
  rw [tendsto_iff_norm_sub_tendsto_zero]
  refine squeeze_zero (fun _ => norm_nonneg _) hbound ?_
  have : Filter.Tendsto (fun N : ℕ => (1 : ℝ) / ((N : ℝ) + 3)) Filter.atTop (nhds 0) := by
    have := tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ)
    refine squeeze_zero (fun _ => by positivity) (fun N => ?_) this
    exact one_div_le_one_div_of_le (by positivity) (by linarith)
  simpa using this.const_mul (2 * π * ‖y‖)

/-- `(φ_N)_perˇ = w_N`. -/
lemma latKernel_periodize_windowPhi (N : ℕ) :
    latKernel (periodize (windowPhi n N)) = windowFun n N :=
  funext fun y => latKernel_periodize (integrable_windowPhi N) y

/-- `ŵ_N = (φ_N)_per` (Fourier inversion on the torus). -/
lemma latFT_windowFun (N : ℕ) (ξ : EuclideanSpace ℝ (Fin n)) :
    latFT (windowFun n N) ξ = periodize (windowPhi n N) ξ := by
  rw [← latKernel_periodize_windowPhi]
  refine latFT_latKernel_of_continuous ?_ (fun η k => periodize_add_latEmbed _ η k) ?_ ξ
  · refine continuous_periodize_of_support (contDiff_windowPhi N).continuous (c := 1 / 3) ?_
      fun η h i => (windowPhi_support h i).trans ?_
    · norm_num
    · exact one_div_le_one_div_of_le (by norm_num) (by linarith [N.cast_nonneg (α := ℝ)])
  · rw [latKernel_periodize_windowPhi]; exact summable_windowFun N

/-- The Fourier transform of a product `m̌ · w` with `w ∈ ℓ¹` is the torus convolution
`∫ ŵ(ξ - η) m(η) dη`. -/
lemma latFT_latKernel_mul {M : EuclideanSpace ℝ (Fin n) → ℂ} (hM : IntegrableOn M (torusCube n))
    {w : (Fin n → ℤ) → ℂ} (hw : Summable fun z => ‖w z‖) (ξ : EuclideanSpace ℝ (Fin n)) :
    latFT (fun x => latKernel M x * w x) ξ = ∫ η in torusCube n, latFT w (ξ - η) * M η := by
  set u : (Fin n → ℤ) → ℂ := fun z => w (-z) * eC (inner ℝ (latEmbed z) ξ) with hu_def
  have hu : Summable fun z => ‖u z‖ := by
    simp only [hu_def, norm_mul, norm_eC, mul_one]
    exact (Equiv.neg (Fin n → ℤ)).summable_iff.2 hw
  have hlat : ∀ η, latFT u η = latFT w (ξ - η) := by
    intro η
    unfold latFT
    rw [← (Equiv.neg (Fin n → ℤ)).tsum_eq]
    refine tsum_congr fun z => ?_
    simp only [hu_def, Equiv.neg_apply, neg_neg, latEmbed_neg, inner_neg_left, inner_sub_right]
    rw [mul_assoc, ← eC_add]
    congr 2; ring
  have e1 : ∫ η in torusCube n, latFT w (ξ - η) * M η = ∫ η in torusCube n, latFT u η * M η := by
    congr 1; funext η; rw [hlat]
  rw [e1, integral_latFT_mul hu hM, latFT, ← (Equiv.neg (Fin n → ℤ)).tsum_eq]
  refine tsum_congr fun z => ?_
  simp only [hu_def, Equiv.neg_apply, neg_neg, latKernel, latEmbed_neg, inner_neg_left]
  have : ∫ ξ in torusCube n, M ξ * eC (-inner ℝ (latEmbed z) ξ) =
      ∫ ξ in torusCube n, eC (-inner ℝ (latEmbed z) ξ) * M ξ := by
    congr 1; funext η; ring
  rw [this]
  ring

/-- The windowed pieces `(m_per(· - α))(D) f · w_N` have Fourier support in `α + [-ε,ε]ⁿ + ℤⁿ`
when `m` is supported in `[-ε/2, ε/2]ⁿ` and `1/(N+3) ≤ ε/2`. -/
lemma latFT_latMult_mul_windowFun_eq_zero {m : EuclideanSpace ℝ (Fin n) → ℂ} (hm : Integrable m)
    {ε : ℝ} (hmε : ∀ η, m η ≠ 0 → ∀ i, |η i| ≤ ε / 2) {N : ℕ} (hN : 1 / ((N : ℝ) + 3) ≤ ε / 2)
    {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) {Q : ℕ} (α : Fin n → ZMod Q)
    {ξ : EuclideanSpace ℝ (Fin n)} (hξ : ξ ∉ ratNbhd Q ε α) :
    latFT (fun x => latMult (fun η => periodize m (η - ratPt Q α)) f x * windowFun n N x) ξ =
      0 := by
  have hint : IntegrableOn (fun η => periodize m (η - ratPt Q α) * latFT f η) (torusCube n) :=
    (integrableOn_periodize_sub hm (ratPt Q α)).mul_bdd (c := ∑' z, ‖f z‖)
      (continuous_latFT hf).aestronglyMeasurable
      (Filter.Eventually.of_forall fun η => norm_latFT_le hf η)
  have e : (fun x => latMult (fun η => periodize m (η - ratPt Q α)) f x * windowFun n N x) =
      fun x => latKernel (fun η => periodize m (η - ratPt Q α) * latFT f η) x *
        windowFun n N x := rfl
  rw [e, latFT_latKernel_mul hint (summable_windowFun N)]
  have hz : ∀ η, latFT (windowFun n N) (ξ - η) * (periodize m (η - ratPt Q α) * latFT f η) = 0 := by
    intro η
    by_contra h
    obtain ⟨h1, h2⟩ := mul_ne_zero_iff.1 h
    have h2' := left_ne_zero_of_mul h2
    rw [latFT_windowFun] at h1
    obtain ⟨z', hz'⟩ := exists_ne_zero_of_periodize_ne_zero h1
    obtain ⟨z, hz⟩ := exists_ne_zero_of_periodize_ne_zero h2'
    apply hξ
    refine ⟨z + z', fun i => ?_⟩
    have a1 := windowPhi_support hz' i
    have a2 := hmε _ hz i
    simp only [PiLp.sub_apply, latEmbed_apply] at a1 a2
    rw [abs_le] at a1 a2 ⊢
    simp only [Pi.add_apply, Int.cast_add]
    obtain ⟨a1l, a1r⟩ := a1
    obtain ⟨a2l, a2r⟩ := a2
    constructor <;> linarith
  refine (setIntegral_congr_fun measurableSet_torusCube fun η _ => hz η).trans ?_
  simp

/-- `|M(D) f(x)| ≤ ‖M‖_{L¹(𝕋ⁿ)} ‖f‖_{ℓ¹}`. -/
lemma norm_latMult_le {M : EuclideanSpace ℝ (Fin n) → ℂ} (hM : IntegrableOn M (torusCube n))
    {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) (x : Fin n → ℤ) :
    ‖latMult M f x‖ ≤ (∫ η in torusCube n, ‖M η‖) * ∑' z, ‖f z‖ := by
  refine (norm_integral_le_integral_norm _).trans ?_
  rw [← integral_mul_const]
  refine integral_mono_of_nonneg (Filter.Eventually.of_forall fun _ => norm_nonneg _)
    (hM.norm.mul_const _) (Filter.Eventually.of_forall fun η => ?_)
  simp only [norm_mul, norm_eC, mul_one]
  exact mul_le_mul_of_nonneg_left (norm_latFT_le hf η) (norm_nonneg _)

/-- `T_{m;Λ} f = ∑_{α ∈ Λ} (m_per(· - α))(D) f` for `m` integrable and `f ∈ ℓ¹`. -/
lemma cosetMult_eq_sum {Q : ℕ} {m : EuclideanSpace ℝ (Fin n) → ℂ} (hm : Integrable m)
    (Λ : Finset (Fin n → ZMod Q)) {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖)
    (x : Fin n → ℤ) :
    cosetMult Q m Λ f x = ∑ α ∈ Λ, latMult (fun η => periodize m (η - ratPt Q α)) f x := by
  have h := latMult_sum_mul Λ (fun _ => 1) (m := fun α η => periodize m (η - ratPt Q α))
    (fun α _ => integrableOn_periodize_sub hm _) hf x
  simp only [one_mul] at h
  exact h

/-- Blueprint Lemma 7.5 (`lem:normdescription`) for the pieces `f_α = T_{m;{α}} f` of a bounded
symbol `m` (integrable and supported in `[-ε/2, ε/2]ⁿ`) and `f ∈ ℓ¹`, which need not be in `ℓ¹`
themselves: `∑_x |T_{m;Σ_{≤k}} f(x)|^{2r} ≤ C_{k,r} ∑_{|A₀| ≤ k} ∑_x
(∑_{α ∈ Σ^{A₀}} |T_{m; α + Σ_{A₀}} f(x)|²)^r`. Proof: apply `normdescription_enorm` to the
windowed pieces `f_α w_N` (in `ℓ¹`, with Fourier support in `α + [-ε,ε]ⁿ + ℤⁿ`), use `|w_N| ≤ 1`,
and let `N → ∞` (`w_N → 1` pointwise). -/
theorem normdescription_cosetMult {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} (hr : 0 < r)
    {ε : ℝ} (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    {m : EuclideanSpace ℝ (Fin n) → ℂ} (hm : Integrable m)
    (hmε : ∀ η, m η ≠ 0 → ∀ i, |η i| ≤ ε / 2)
    {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) :
    ∑' x, ‖cosetMult (blockProd S) m (sigmaLe S k) f x‖ₑ ^ (2 * r) ≤
      ENNReal.ofReal (normDescConst k r) *
        ∑ A₀ ∈ S.powerset with #A₀ ≤ k, ∑' x, (∑ α ∈ sigmaUpper S k A₀,
          ‖cosetMult (blockProd S) m (cosetSet S A₀ α) f x‖ₑ ^ 2) ^ r := by
  set Q := blockProd S
  set F : (Fin n → ZMod Q) → (Fin n → ℤ) → ℂ :=
    fun α => latMult (fun η => periodize m (η - ratPt Q α)) f with hF
  set R := ENNReal.ofReal (normDescConst k r) *
        ∑ A₀ ∈ S.powerset with #A₀ ≤ k, ∑' x, (∑ α ∈ sigmaUpper S k A₀,
          ‖cosetMult (blockProd S) m (cosetSet S A₀ α) f x‖ₑ ^ 2) ^ r with hR
  set T := cosetMult Q m (sigmaLe S k) f with hT
  have hTsum : ∀ x, T x = ∑ α ∈ sigmaLe S k, F α x := fun x => cosetMult_eq_sum hm _ hf x
  have hcoset : ∀ A₀ α x, cosetFun S F A₀ α x = cosetMult Q m (cosetSet S A₀ α) f x := by
    intro A₀ α x
    rw [cosetMult_eq_sum hm _ hf x, cosetSet, Finset.sum_map]
    rfl
  -- boundedness of the pieces
  have hFb : ∀ α x, ‖F α x‖ ≤ (∫ η in torusCube n, ‖periodize m (η - ratPt Q α)‖) * ∑' z, ‖f z‖ :=
    fun α x => norm_latMult_le (integrableOn_periodize_sub hm _) hf x
  -- the windowed estimate
  have hwin : ∀ N : ℕ, 1 / ((N : ℝ) + 3) ≤ ε / 2 →
      ∑' x, ‖T x * windowFun n N x‖ₑ ^ (2 * r) ≤ R := by
    intro N hN
    set G : (Fin n → ZMod Q) → (Fin n → ℤ) → ℂ := fun α x => F α x * windowFun n N x with hG
    have hGs : ∀ α ∈ sigmaLe S k, Summable fun z => ‖G α z‖ := by
      intro α _
      refine Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun z => ?_)
        ((summable_windowFun N).mul_left
          ((∫ η in torusCube n, ‖periodize m (η - ratPt Q α)‖) * ∑' z, ‖f z‖))
      rw [hG, norm_mul]
      exact mul_le_mul_of_nonneg_right (hFb α z) (norm_nonneg _)
    have hGsupp : ∀ α ∈ sigmaLe S k, ∀ ξ ∉ ratNbhd Q ε α, latFT (G α) ξ = 0 :=
      fun α _ ξ hξ => latFT_latMult_mul_windowFun_eq_zero hm hmε hN hf α hξ
    have h := normdescription_enorm hS1 hS hr hε hεr G hGs hGsupp
    have hL : ∀ x, ∑ α ∈ sigmaLe S k, G α x = T x * windowFun n N x := by
      intro x; rw [hTsum, Finset.sum_mul]
    simp_rw [hL] at h
    refine h.trans ?_
    rw [hR]
    gcongr with A₀ _ x α _
    have : cosetFun S G A₀ α x = cosetFun S F A₀ α x * windowFun n N x := by
      simp only [cosetFun, hG, Finset.sum_mul]
    rw [this, hcoset, enorm_mul]
    have hw : ‖windowFun n N x‖ₑ ≤ 1 := by
      rw [← ofReal_norm, ← ENNReal.ofReal_one]
      exact ENNReal.ofReal_le_ofReal (norm_windowFun_le N x)
    calc ‖cosetMult Q m (cosetSet S A₀ α) f x‖ₑ * ‖windowFun n N x‖ₑ
        ≤ ‖cosetMult Q m (cosetSet S A₀ α) f x‖ₑ * 1 := by gcongr
      _ = _ := mul_one _
  -- the limit `N → ∞`
  obtain ⟨N₀, hN₀⟩ : ∃ N₀ : ℕ, ∀ N ≥ N₀, 1 / ((N : ℝ) + 3) ≤ ε / 2 := by
    refine ⟨⌈2 / ε⌉₊, fun N hN => ?_⟩
    have h1 : 2 / ε ≤ N := (Nat.le_ceil _).trans (by exact_mod_cast hN)
    rw [div_le_div_iff₀ (by positivity) (by norm_num), one_mul]
    rw [div_le_iff₀ hε] at h1
    nlinarith
  rw [ENNReal.tsum_eq_iSup_sum]
  refine iSup_le fun s => ?_
  have hlim : Filter.Tendsto (fun N => ∑ x ∈ s, ‖T x * windowFun n N x‖ₑ ^ (2 * r))
      Filter.atTop (nhds (∑ x ∈ s, ‖T x‖ₑ ^ (2 * r))) := by
    refine tendsto_finsetSum _ fun x _ => ?_
    have h1 : Filter.Tendsto (fun N => T x * windowFun n N x) Filter.atTop (nhds (T x * 1)) :=
      tendsto_const_nhds.mul (tendsto_windowFun x)
    rw [mul_one] at h1
    exact ENNReal.Tendsto.pow ((continuous_enorm.tendsto _).comp h1)
  refine le_of_tendsto hlim (Filter.eventually_atTop.2 ⟨N₀, fun N hN => ?_⟩)
  exact (ENNReal.sum_le_tsum s).trans (hwin N (hN₀ N hN))

/-! ### The factorization `f_{A₀,α} = M_α T_{m;Σ_{A₀}} M_{-α} P_{A₀,α} f` -/

/-- `θ_ε` is smooth. -/
lemma contDiff_cutoffEps (ε : ℝ) : ContDiff ℝ ∞ (cutoffEps n ε) :=
  Complex.ofRealCLM.contDiff.comp (contDiff_companionCutoff.comp (contDiff_const_smul _))

/-- `θ_ε` has compact support. -/
lemma hasCompactSupport_cutoffEps {ε : ℝ} (hε : 0 < ε) : HasCompactSupport (cutoffEps n ε) :=
  HasCompactSupport.intro (isCompact_box (2 * ε)) fun _ h => cutoffEps_eq_zero hε h

/-- The kernel of `T_{φ;Λ}` is in `ℓ¹` for smooth compactly supported `φ`. -/
lemma summable_latKernel_cosetSymbol {Q : ℕ} {φ : EuclideanSpace ℝ (Fin n) → ℂ}
    (hφs : ContDiff ℝ ∞ φ) (hφc : HasCompactSupport φ) (Λ : Finset (Fin n → ZMod Q)) :
    Summable fun y => ‖latKernel (cosetSymbol Q φ Λ) y‖ := by
  have hφi : Integrable φ := hφs.continuous.integrable_of_hasCompactSupport hφc
  have hs := (fourierInv_latEmbed_rapidDecay_of_hasCompactSupport hφs hφc).2
  have e : ∀ y, latKernel (cosetSymbol Q φ Λ) y =
      ∑ β ∈ Λ, eC (inner ℝ (ratPt Q β) (latEmbed y)) * 𝓕⁻ φ (latEmbed y) := by
    intro y
    have h := latKernel_sum_mul Λ (fun _ => 1) (m := fun β ξ => periodize φ (ξ - ratPt Q β))
      (fun β _ => integrableOn_periodize_sub hφi _) y
    simp only [one_mul] at h
    rw [show cosetSymbol Q φ Λ = fun ξ => ∑ β ∈ Λ, periodize φ (ξ - ratPt Q β) from rfl, h]
    refine Finset.sum_congr rfl fun β _ => ?_
    simp_rw [periodize_comp_sub]
    rw [latKernel_periodize (hφi.comp_sub_right _), fourierInv_comp_sub]
  simp_rw [e]
  refine Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun y => norm_sum_le _ _) ?_
  refine summable_sum fun β _ => ?_
  simp only [norm_mul, norm_eC, one_mul]
  exact hs

/-- `T_{φ;Λ}` has a continuous periodic symbol for continuous `φ` supported in `[-c,c]ⁿ`,
`c < 1/2`. -/
lemma continuous_cosetSymbol {Q : ℕ} {φ : EuclideanSpace ℝ (Fin n) → ℂ} (hφ : Continuous φ)
    {c : ℝ} (hc : c < 1 / 2) (hsupp : ∀ η, φ η ≠ 0 → ∀ i, |η i| ≤ c)
    (Λ : Finset (Fin n → ZMod Q)) : Continuous (cosetSymbol Q φ Λ) :=
  continuous_finsetSum _ fun _ _ =>
    (continuous_periodize_of_support hφ hc hsupp).comp (continuous_sub_right _)

/-- The symbols `∑_{β ∈ Λ} φ_per(· - β)` are `ℤⁿ`-periodic. -/
lemma cosetSymbol_add_latEmbed {Q : ℕ} (φ : EuclideanSpace ℝ (Fin n) → ℂ)
    (Λ : Finset (Fin n → ZMod Q)) (ξ : EuclideanSpace ℝ (Fin n)) (k : Fin n → ℤ) :
    cosetSymbol Q φ Λ (ξ + latEmbed k) = cosetSymbol Q φ Λ ξ := by
  unfold cosetSymbol
  refine Finset.sum_congr rfl fun β _ => ?_
  rw [add_sub_right_comm, periodize_add_latEmbed]

/-- `m_per · (θ_ε)_per = m_per` for `m` supported in `[-ε/2, ε/2]ⁿ`, `4ε < 1`. -/
lemma periodize_mul_periodize_cutoffEps {m : EuclideanSpace ℝ (Fin n) → ℂ} {ε : ℝ}
    (hε : 0 < ε) (hε4 : 4 * ε < 1) (hmε : ∀ η, m η ≠ 0 → ∀ i, |η i| ≤ ε / 2)
    (ζ : EuclideanSpace ℝ (Fin n)) :
    periodize m ζ * periodize (cutoffEps n ε) ζ = periodize m ζ := by
  by_cases h : periodize m ζ = 0
  · rw [h, zero_mul]
  obtain ⟨z, hz⟩ := exists_ne_zero_of_periodize_ne_zero h
  have hz1 : ∀ i, |ζ i - z i| ≤ ε / 2 := fun i => by simpa using hmε _ hz i
  have hθ : periodize (cutoffEps n ε) ζ = 1 := by
    rw [periodize, tsum_eq_single z]
    · refine cutoffEps_eq_one hε fun i => ?_
      simpa using (hz1 i).trans (by linarith)
    · intro z' hz'
      by_contra h'
      apply hz'
      refine eq_of_abs_sub_intCast_le hε4 (η := ζ) (fun i => ?_) (fun i => ?_)
      · simpa using cutoffEps_support hε _ h' i
      · exact (hz1 i).trans (by linarith)
  rw [hθ, mul_one]

/-- `T_{m;Λ}` and `T_{θ_ε;Λ}` multiply to `T_{m;Λ}` for `Λ ⊆ Σ_{≤k}` and `m` supported in
`[-ε/2, ε/2]ⁿ` (different center bumps are disjoint and `θ_ε = 1` on the support of `m`). -/
lemma cosetSymbol_mul_cosetSymbol_cutoffEps {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} {ε : ℝ}
    (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    {m : EuclideanSpace ℝ (Fin n) → ℂ} (hmε : ∀ η, m η ≠ 0 → ∀ i, |η i| ≤ ε / 2)
    {Λ : Finset (Fin n → ZMod (blockProd S))} (hΛ : Λ ⊆ sigmaLe S k)
    (ξ : EuclideanSpace ℝ (Fin n)) :
    cosetSymbol (blockProd S) m Λ ξ * cosetSymbol (blockProd S) (cutoffEps n ε) Λ ξ =
      cosetSymbol (blockProd S) m Λ ξ := by
  have hε4 := four_eps_lt_one S hε hεr
  unfold cosetSymbol
  rw [Finset.sum_mul_sum]
  refine Finset.sum_congr rfl fun γ hγ => ?_
  rw [Finset.sum_eq_single γ]
  · exact periodize_mul_periodize_cutoffEps hε hε4 hmε _
  · intro γ' hγ' hne
    by_contra h
    obtain ⟨h1, h2⟩ := mul_ne_zero_iff.1 h
    obtain ⟨z, hz⟩ := exists_ne_zero_of_periodize_ne_zero h1
    obtain ⟨z', hz'⟩ := exists_ne_zero_of_periodize_ne_zero h2
    apply hne
    refine (eq_of_near_ratPt hS1 hS hε hεr (hΛ hγ) (hΛ hγ') (z := z) (z' := z') (ξ := ξ)
      (fun i => ?_) (fun i => ?_)).symm
    · have := hmε _ hz i
      simp only [PiLp.sub_apply, latEmbed_apply] at this
      exact this.trans (by linarith)
    · have := cutoffEps_support hε _ hz' i
      simpa using this
  · intro h; exact absurd hγ h

/-- The coset `α + Σ_{A₀}`, `α ∈ Σ^{A₀}`, lies in `Σ_{≤k}`. -/
lemma cosetSet_subset_sigmaLe {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {k : ℕ} {A₀ : Finset ℕ} {α : Fin n → ZMod (blockProd S)}
    (hα : α ∈ sigmaUpper S k A₀) : cosetSet S A₀ α ⊆ sigmaLe S k := by
  intro γ hγ
  simp only [cosetSet, Finset.mem_map, addLeftEmbedding_apply] at hγ
  obtain ⟨β, hβ, rfl⟩ := hγ
  exact add_mem_sigmaLe_of_coset hS hα hβ

/-- Modulation: the symbol of `T_{m; α + Σ_{A₀}}` is that of `T_{m;Σ_{A₀}}` translated by `α`. -/
lemma cosetSymbol_cosetSet_eq_sub {S : Finset ℕ} [NeZero (blockProd S)]
    (m : EuclideanSpace ℝ (Fin n) → ℂ) (A₀ : Finset ℕ) (α : Fin n → ZMod (blockProd S))
    (ξ : EuclideanSpace ℝ (Fin n)) :
    cosetSymbol (blockProd S) m (cosetSet S A₀ α) ξ =
      cosetSymbol (blockProd S) m (sigmaBlock S A₀) (ξ - ratPt (blockProd S) α) := by
  rw [cosetSymbol_cosetSet, cosetSymbol]
  refine Finset.sum_congr rfl fun β _ => ?_
  rw [periodize_sub_ratPt_add, sub_right_comm,
    periodize_comp_sub m (ratPt (blockProd S) α) (ξ - ratPt (blockProd S) β)]
/-- The factorization of Theorem 7.7:
`T_{m; α + Σ_{A₀}} f = M_α T_{m; Σ_{A₀}} M_{-α} T_{θ_ε; α + Σ_{A₀}} f` for `α ∈ Σ^{A₀}`, `m`
integrable and supported in `[-ε/2, ε/2]ⁿ`, and `f ∈ ℓ¹` (`M_β = latModulate β`). -/
theorem cosetMult_cosetSet_eq_modulate {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} {ε : ℝ}
    (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    {m : EuclideanSpace ℝ (Fin n) → ℂ} (hmε : ∀ η, m η ≠ 0 → ∀ i, |η i| ≤ ε / 2)
    {A₀ : Finset ℕ} {α : Fin n → ZMod (blockProd S)} (hα : α ∈ sigmaUpper S k A₀)
    {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) :
    cosetMult (blockProd S) m (cosetSet S A₀ α) f =
      latModulate (ratPt (blockProd S) α) (cosetMult (blockProd S) m (sigmaBlock S A₀)
        (latModulate (-ratPt (blockProd S) α) (companionProj S ε A₀ α f))) := by
  have hε4 := four_eps_lt_one S hε hεr
  set M₃ := cosetSymbol (blockProd S) (cutoffEps n ε) (cosetSet S A₀ α) with hM₃
  have hM₃c : Continuous M₃ := continuous_cosetSymbol (continuous_cutoffEps ε) (c := 2 * ε)
    (by linarith) (cutoffEps_support hε) _
  have hM₃k := summable_latKernel_cosetSymbol (Q := blockProd S) (contDiff_cutoffEps (n := n) ε)
    (hasCompactSupport_cutoffEps hε) (cosetSet S A₀ α)
  calc cosetMult (blockProd S) m (cosetSet S A₀ α) f
      = latMult (fun ξ => cosetSymbol (blockProd S) m (cosetSet S A₀ α) ξ * M₃ ξ) f := by
        unfold cosetMult; congr 1; funext ξ
        exact (cosetSymbol_mul_cosetSymbol_cutoffEps hS1 hS hε hεr hmε
          (cosetSet_subset_sigmaLe hS hα) ξ).symm
    _ = latMult (cosetSymbol (blockProd S) m (cosetSet S A₀ α)) (latMult M₃ f) :=
        (latMult_latMult_of_continuous hM₃c (cosetSymbol_add_latEmbed _ _) hM₃k hf).symm
    _ = latMult (fun ξ => cosetSymbol (blockProd S) m (sigmaBlock S A₀)
          (ξ - ratPt (blockProd S) α)) (companionProj S ε A₀ α f) := by
        congr 1; funext ξ; exact cosetSymbol_cosetSet_eq_sub m A₀ α ξ
    _ = _ := latMult_comp_sub (cosetSymbol_add_latEmbed _ _) _ _
/-! ### `ℓ^p` bounds for `T_{m;Σ_{A₀}}` -/


/-- Extension of an `ℓ^P` bound for a lattice multiplier from finitely supported inputs to `ℓ¹`
inputs (truncation, pointwise convergence and Fatou). -/
lemma eLpNorm_latMult_le_of_finite {M : EuclideanSpace ℝ (Fin n) → ℂ}
    (hM : IntegrableOn M (torusCube n)) {P K : ℝ≥0∞}
    (h : ∀ g : (Fin n → ℤ) → ℂ, (Function.support g).Finite →
      eLpNorm (latMult M g) P Measure.count ≤ K * eLpNorm g P Measure.count)
    {g : (Fin n → ℤ) → ℂ} (hg : Summable fun z => ‖g z‖) :
    eLpNorm (latMult M g) P Measure.count ≤ K * eLpNorm g P Measure.count := by
  set gR : ℕ → (Fin n → ℤ) → ℂ := fun R => (latBox n R).indicator g with hgR
  have hgRfin : ∀ R, (Function.support (gR R)).Finite := fun R =>
    support_indicator_latBox_finite n R g
  have hgRs : ∀ R, Summable fun z => ‖gR R z‖ := fun R => summable_of_finite_support (hgRfin R)
  have hcompl : ∀ R, g - gR R = (latBox n R)ᶜ.indicator g := fun R =>
    (Set.indicator_compl _ _).symm
  have hdiff : ∀ R, Summable fun z => ‖(g - gR R) z‖ := by
    intro R
    rw [hcompl]
    exact Summable.of_nonneg_of_le (fun _ => norm_nonneg _)
      (fun z => norm_indicator_le_norm_self _ _) hg
  set dR : ℕ → ℝ := fun R => ∑' z, ‖(g - gR R) z‖ with hdR
  have hdR : Filter.Tendsto dR Filter.atTop (nhds 0) := by
    have h1 := eLpNorm_sub_indicator_latBox_tendsto (p := 1) ENNReal.one_ne_top
      (memLp_one_iff_integrable.2 (integrable_count_iff.2 hg))
    have e : ∀ R, eLpNorm (g - (latBox n R).indicator g) 1 Measure.count =
        ENNReal.ofReal (dR R) := by
      intro R
      rw [eLpNorm_one_eq_lintegral_enorm AEStronglyMeasurable.of_discrete, lintegral_count,
        hdR, ENNReal.ofReal_tsum_of_nonneg (fun _ => norm_nonneg _) (hdiff R)]
      simp only [ofReal_norm]
      rfl
    simp_rw [e] at h1
    have h2 := (ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp h1
    simp only [Function.comp_def, ENNReal.toReal_zero] at h2
    refine h2.congr fun R => ?_
    exact ENNReal.toReal_ofReal (tsum_nonneg fun _ => norm_nonneg _)
  have hlim : ∀ x, Filter.Tendsto (fun R => latMult M (gR R) x) Filter.atTop
      (nhds (latMult M g x)) := by
    intro x
    rw [tendsto_iff_norm_sub_tendsto_zero]
    refine squeeze_zero (fun _ => norm_nonneg _) (fun R => ?_)
      (by simpa using hdR.const_mul (∫ η in torusCube n, ‖M η‖))
    have e : latMult M g = latMult M (gR R) + latMult M (g - gR R) := by
      rw [← latMult_add hM (hgRs R) (hdiff R), add_sub_cancel]
    rw [e, Pi.add_apply, sub_add_cancel_left, norm_neg]
    exact norm_latMult_le hM (hdiff R) x
  refine eLpNorm_le_of_tendsto_of_eLpNorm_le (u := fun R => latMult M (gR R))
    (fun _ => AEStronglyMeasurable.of_discrete) (Filter.Eventually.of_forall hlim) fun R => ?_
  refine (h _ (hgRfin R)).trans ?_
  gcongr
  exact eLpNorm_indicator_le _ (MeasurableSet.of_discrete)
/-- The coset `0 + Σ_{A₀}` is `Σ_{A₀}`. -/
lemma cosetSet_zero (S : Finset ℕ) [NeZero (blockProd S)] (A₀ : Finset ℕ) :
    cosetSet (n := n) S A₀ 0 = sigmaBlock S A₀ := by
  ext x; simp [cosetSet]

/-- The shifted full-grid symbol with shift `0` is `Δ_{Q_B} m`. -/
lemma gridSymbol_zero {S : Finset ℕ} [NeZero (blockProd S)] {B : Finset ℕ}
    (hBS : B ⊆ S) (m : EuclideanSpace ℝ (Fin n) → ℂ) (ξ : EuclideanSpace ℝ (Fin n)) :
    gridSymbol S B m 0 ξ = gridSym (blockProd B) m ξ := by
  rw [gridSymbol]
  simp_rw [zero_add]
  exact sum_blockGrid_periodize_eq_gridSym (blockProd_dvd_blockProd hBS) m ξ

/-- `T_{m;Σ_{A₀}}` is a signed sum of the `2^{|A₀|}` full-grid operators `Δ_{Q_B}`, `B ⊆ A₀`
(eq. (7.4)); hence an `ℓ^P` bound `K` for each of them gives the bound `2^{|A₀|} K`. -/
lemma eLpNorm_cosetMult_sigmaBlock_le {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {A₀ : Finset ℕ} (hA₀ : A₀ ⊆ S) {m : EuclideanSpace ℝ (Fin n) → ℂ}
    (hm : Integrable m) {P K : ℝ≥0∞} (hP : 1 ≤ P)
    (hgrid : ∀ B ⊆ A₀, ∀ g : (Fin n → ℤ) → ℂ, (Function.support g).Finite →
      eLpNorm (latMult (gridSym (blockProd B) m) g) P Measure.count ≤
        K * eLpNorm g P Measure.count)
    {g : (Fin n → ℤ) → ℂ} (hg : (Function.support g).Finite) :
    eLpNorm (cosetMult (blockProd S) m (sigmaBlock S A₀) g) P Measure.count ≤
      2 ^ #A₀ * K * eLpNorm g P Measure.count := by
  have hsym : cosetSymbol (blockProd S) m (sigmaBlock S A₀) = fun ξ =>
      ∑ B ∈ A₀.powerset, (-1 : ℂ) ^ (#A₀ - #B) * gridSym (blockProd B) m ξ := by
    funext ξ
    rw [← cosetSet_zero, cosetSymbol_cosetSet_eq_sum_gridSymbol hS hA₀ m 0 ξ]
    refine Finset.sum_congr rfl fun B hB => ?_
    rw [gridSymbol_zero ((Finset.mem_powerset.1 hB).trans hA₀)]
  have hfun : cosetMult (blockProd S) m (sigmaBlock S A₀) g = ∑ B ∈ A₀.powerset,
      ((-1 : ℂ) ^ (#A₀ - #B)) • latMult (gridSym (blockProd B) m) g := by
    funext x
    rw [cosetMult, hsym, latMult_sum_mul _ _ (fun B _ => integrableOn_gridSym hm _)
      (summable_of_finite_support hg), Finset.sum_apply]
    rfl
  rw [hfun]
  refine (eLpNorm_sum_le hP).trans ?_
  calc ∑ B ∈ A₀.powerset, eLpNorm (((-1 : ℂ) ^ (#A₀ - #B)) •
          latMult (gridSym (blockProd B) m) g) P Measure.count
      ≤ ∑ B ∈ A₀.powerset, K * eLpNorm g P Measure.count := by
        refine Finset.sum_le_sum fun B hB => ?_
        rw [eLpNorm_const_smul]
        simp only [enorm_pow, enorm_neg, enorm_one, one_pow, one_mul]
        exact hgrid B (Finset.mem_powerset.1 hB) g hg
    _ = 2 ^ #A₀ * K * eLpNorm g P Measure.count := by
        rw [Finset.sum_const, Finset.card_powerset, nsmul_eq_mul, mul_assoc]
        push_cast; rfl
/-- `100 ε Q_B ≤ 1` for `B ⊆ S`, `|B| ≤ k`, under the separation hypothesis (7.1); in particular
`ε/2 ≤ 1/(8 Q_B)`. -/
lemma hundred_eps_mul_blockProd_le {S B : Finset ℕ} (hBS : B ⊆ S) {k r : ℕ} (hBk : #B ≤ k)
    {ε : ℝ} (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹) :
    100 * ε * blockProd B ≤ 1 := by
  have hr := one_le_of_le_eps hε hεr
  have hq1 : 1 ≤ blockStar S := le_trans (by norm_num) (two_le_blockStar S)
  have hQ : (blockProd B : ℝ) ≤ (blockStar S : ℝ) ^ k := by
    exact_mod_cast (blockProd_le_pow hBS).trans (Nat.pow_le_pow_right hq1 hBk)
  have hqk : (0 : ℝ) < (blockStar S : ℝ) ^ k := by positivity
  have h3 : (blockStar S : ℝ) ^ k ≤ (blockStar S : ℝ) ^ (2 * r * k) :=
    pow_le_pow_right₀ (by exact_mod_cast hq1) (by nlinarith)
  have hr1 : (1 : ℝ) ≤ r := by exact_mod_cast hr
  have h2 : 100 * (blockStar S : ℝ) ^ k ≤ 100 * r * (blockStar S : ℝ) ^ (2 * r * k) := by
    nlinarith
  have hε' : ε ≤ (100 * (blockStar S : ℝ) ^ k)⁻¹ := hεr.trans (inv_anti₀ (by positivity) h2)
  calc 100 * ε * blockProd B ≤ 100 * (100 * (blockStar S : ℝ) ^ k)⁻¹ * (blockStar S : ℝ) ^ k := by
        gcongr
    _ = 1 := by field_simp

/-- A symbol supported in `[-ε/2, ε/2]ⁿ` is supported in `[-1/(8Q_B), 1/(8Q_B)]ⁿ` under (7.1),
as required by Blueprint Lemma 6.2 (`sampling_gridSym`). -/
lemma support_subset_gridBox {S B : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q) (hBS : B ⊆ S) {k r : ℕ}
    (hBk : #B ≤ k)
    {ε : ℝ} (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    {m : EuclideanSpace ℝ (Fin n) → ℂ} (hsupp : Function.support m ⊆ {ξ | ∀ i, |ξ i| ≤ ε / 2}) :
    Function.support m ⊆ {ξ | ∀ i, |ξ i| ≤ 1 / (8 * (blockProd B : ℕ))} := by
  intro ξ hξ i
  have h := hundred_eps_mul_blockProd_le hBS hBk hε hεr
  have hQ : (0 : ℝ) < blockProd B := by
    have : 0 < blockProd B := blockProd_pos fun q hq => hS1 q (hBS hq)
    exact_mod_cast this
  refine (hsupp hξ i).trans ?_
  rw [le_div_iff₀ (by positivity)]
  nlinarith
/-! ### Vector-valued extension -/

/-- The additive subgroup `ℓ¹(ℤⁿ)` of `ℤⁿ → ℂ`. -/
def l1Subgroup (n : ℕ) : AddSubgroup ((Fin n → ℤ) → ℂ) where
  carrier := {g | Summable fun z => ‖g z‖}
  add_mem' {g h} hg hh := Summable.of_nonneg_of_le (fun _ => norm_nonneg _)
    (fun z => norm_add_le _ _) (Summable.add hg hh)
  zero_mem' := by simp only [Set.mem_ofPred_eq, Pi.zero_apply, norm_zero]; exact summable_zero
  neg_mem' {g} hg := by simpa only [Set.mem_ofPred_eq, Pi.neg_apply, norm_neg] using hg

/-- `M(D) 0 = 0`. -/
lemma latMult_zero (M : EuclideanSpace ℝ (Fin n) → ℂ) : latMult M 0 = 0 := by
  funext x; simp [latMult, latFT]

/-- A lattice multiplier with symbol integrable on the torus as an additive map on `ℓ¹`. -/
noncomputable def latMultHom {M : EuclideanSpace ℝ (Fin n) → ℂ}
    (hM : IntegrableOn M (torusCube n)) : l1Subgroup n →+ ((Fin n → ℤ) → ℂ) where
  toFun g := latMult M g
  map_zero' := latMult_zero M
  map_add' g h := latMult_add hM g.2 h.2

/-- Modulations preserve absolute values. -/
lemma norm_latModulate (β : EuclideanSpace ℝ (Fin n)) (g : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) :
    ‖latModulate β g x‖ = ‖g x‖ := by
  rw [latModulate, norm_mul, norm_eC, one_mul]

/-- The companion projections `P_{A₀,α} f` of `f ∈ ℓ¹` are in `ℓ¹`. -/
lemma summable_companionProj {S : Finset ℕ} [NeZero (blockProd S)] {ε : ℝ} (hε : 0 < ε)
    (hε4 : 4 * ε < 1) (A₀ : Finset ℕ) (α : Fin n → ZMod (blockProd S))
    {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) :
    Summable fun x => ‖companionProj S ε A₀ α f x‖ :=
  (latFT_latMult_of_continuous
    (continuous_cosetSymbol (continuous_cutoffEps ε) (c := 2 * ε) (by linarith)
      (cutoffEps_support hε) _)
    (cosetSymbol_add_latEmbed _ _)
    (summable_latKernel_cosetSymbol (contDiff_cutoffEps ε) (hasCompactSupport_cutoffEps hε) _)
    hf).1

/-- `‖(∑_{i ∈ s} |u_i|²)^{1/2}‖_{ℓ^{2r}}^{2r} = ∑_x (∑_{i ∈ s} |u_i(x)|²)^r`. -/
lemma eLpNorm_sqrt_sum_pow {ι : Type*} {r : ℕ} (hr : 0 < r) (s : Finset ι)
    (u : ι → (Fin n → ℤ) → ℂ) :
    eLpNorm (fun y => Real.sqrt (∑ i ∈ s, ‖u i y‖ ^ 2)) (ENNReal.ofReal (2 * r))
        Measure.count ^ (2 * r) = ∑' y, (∑ i ∈ s, ‖u i y‖ₑ ^ 2) ^ r := by
  rw [eLpNorm_count_pow_eq_tsum hr]
  refine tsum_congr fun y => ?_
  rw [enorm_sqrt_pow_two_mul (Finset.sum_nonneg fun _ _ => sq_nonneg _),
    ENNReal.ofReal_sum_of_nonneg fun _ _ => sq_nonneg _]
  simp_rw [enorm_pow_eq_ofReal]

/-- Blueprint Theorem 7.7 (`thm:IW`) at the endpoint `p = 2r`, with the constant written as
`ofReal C * ofReal A`. -/
theorem cosetMult_sigmaLe_bound_two_mul (n k : ℕ) {r : ℕ} (hr : 0 < r) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (S : Finset ℕ), (∀ q ∈ S, 1 < q) → (S : Set ℕ).Pairwise Nat.Coprime →
      ∀ [NeZero (blockProd S)] (ε : ℝ), 0 < ε →
      ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹ →
      ∀ (m : EuclideanSpace ℝ (Fin n) → ℂ) (B A : ℝ), AEStronglyMeasurable m volume →
      (∀ ξ, ‖m ξ‖ ≤ B) → Function.support m ⊆ {ξ | ∀ i, |ξ i| ≤ ε / 2} →
      (∀ F : 𝓢(EuclideanSpace ℝ (Fin n), ℂ),
        eLpNorm (𝓕⁻ (fun ξ => m ξ * 𝓕 (F : EuclideanSpace ℝ (Fin n) → ℂ) ξ))
          (ENNReal.ofReal (2 * r)) volume ≤
            ENNReal.ofReal A * eLpNorm F (ENNReal.ofReal (2 * r)) volume) →
      ∀ f : (Fin n → ℤ) → ℂ, (Function.support f).Finite →
        eLpNorm (cosetMult (blockProd S) m (sigmaLe S k) f) (ENNReal.ofReal (2 * r))
            Measure.count ≤
          ENNReal.ofReal C * ENNReal.ofReal A *
            eLpNorm f (ENNReal.ofReal (2 * r)) Measure.count := by
  obtain ⟨Cs, hCs, hsamp⟩ := sampling_gridSym n
  set KMZ := khintchineUpperConst (2 * r) / khintchineLowerConst (2 * r) with hKMZ_def
  have hKMZ : 0 ≤ KMZ := div_nonneg (khintchineUpperConst_pos (by positivity)).le
    (khintchineLowerConst_pos _).le
  set L : ℝ := KMZ * 2 ^ k * Cs with hL_def
  have hL : 0 ≤ L := by positivity
  set Cenn : ℝ≥0∞ := ENNReal.ofReal (normDescConst k r) ^ (1 / (2 * r : ℝ)) * ENNReal.ofReal L *
      ENNReal.ofReal (companionConst n k (2 * r)) ^ (1 / (2 * r : ℝ)) with hCenn_def
  have hCenn : Cenn ≠ ⊤ := by
    refine ENNReal.mul_ne_top (ENNReal.mul_ne_top ?_ ENNReal.ofReal_ne_top) ?_ <;>
      exact ENNReal.rpow_ne_top_of_nonneg (by positivity) ENNReal.ofReal_ne_top
  refine ⟨Cenn.toReal, ENNReal.toReal_nonneg, ?_⟩
  intro S hS1 hS _ ε hε hεr m Bm A hm hBm hsupp hA f hf
  rw [ENNReal.ofReal_toReal hCenn]
  have hr2 : (1 : ℝ) ≤ 2 * r := by
    have : (1 : ℝ) ≤ r := by exact_mod_cast hr
    linarith
  have hmi : Integrable m := integrable_of_bound_of_support_subset hm hBm (by positivity) hsupp
  have hmε : ∀ η, m η ≠ 0 → ∀ i, |η i| ≤ ε / 2 := fun η h => hsupp h
  have hε4 := four_eps_lt_one S hε hεr
  have hfs := summable_of_finite_support hf
  have hP1 : 1 ≤ ENNReal.ofReal (2 * r) := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hr2
  -- the full-grid operators (Lemma 6.2)
  have hgrid : ∀ A₀ ∈ S.powerset.filter (fun A₀ => #A₀ ≤ k), ∀ B ⊆ A₀,
      ∀ g : (Fin n → ℤ) → ℂ, (Function.support g).Finite →
        eLpNorm (latMult (gridSym (blockProd B) m) g) (ENNReal.ofReal (2 * r)) Measure.count ≤
          ENNReal.ofReal (Cs * A) * eLpNorm g (ENNReal.ofReal (2 * r)) Measure.count := by
    intro A₀ hA₀ B hB g hg
    obtain ⟨h1, h2⟩ := Finset.mem_filter.1 hA₀
    have hBS := hB.trans (Finset.mem_powerset.1 h1)
    exact hsamp (2 * r) hr2 (blockProd B) (blockProd_pos fun q hq => hS1 q (hBS hq)) m Bm A hm
      hBm (support_subset_gridBox hS1 hBS ((Finset.card_le_card hB).trans h2) hε hεr hsupp) hA g hg
  -- `T_{m;Σ_{A₀}}` on `ℓ¹` inputs
  have hTA : ∀ A₀ ∈ S.powerset.filter (fun A₀ => #A₀ ≤ k), ∀ g : l1Subgroup n,
      eLpNorm (cosetMult (blockProd S) m (sigmaBlock S A₀) g) (ENNReal.ofReal (2 * r))
          Measure.count ≤
        (2 ^ k * ENNReal.ofReal (Cs * A)) *
          eLpNorm (g : (Fin n → ℤ) → ℂ) (ENNReal.ofReal (2 * r)) Measure.count := by
    intro A₀ hA₀ g
    obtain ⟨h1, h2⟩ := Finset.mem_filter.1 hA₀
    refine eLpNorm_latMult_le_of_finite (integrableOn_cosetSymbol hmi _) (fun g' hg' => ?_) g.2
    refine (eLpNorm_cosetMult_sigmaBlock_le hS (Finset.mem_powerset.1 h1) hmi hP1
      (hgrid A₀ hA₀) hg').trans ?_
    gcongr
    norm_num
  -- the vector-valued extension (Lemma 2.6) for each core
  have hconst : ∀ A' : ℝ≥0, (A' : ℝ≥0∞) = 2 ^ k * ENNReal.ofReal (Cs * A) →
      ENNReal.ofReal KMZ * A' = ENNReal.ofReal L * ENNReal.ofReal A := by
    intro A' hA'
    rw [hA', hL_def, ENNReal.ofReal_mul (p := Cs) (q := A) hCs.le,
      ENNReal.ofReal_mul (p := KMZ * 2 ^ k) (q := Cs) (by positivity),
      ENNReal.ofReal_mul (p := KMZ) (q := 2 ^ k) hKMZ, ENNReal.ofReal_pow (by norm_num),
      ENNReal.ofReal_ofNat]
    ring
  have hcore : ∀ A₀ ∈ S.powerset.filter (fun A₀ => #A₀ ≤ k),
      ∑' x, (∑ α ∈ sigmaUpper S k A₀, ‖cosetMult (blockProd S) m (cosetSet S A₀ α) f x‖ₑ ^ 2) ^ r
        ≤ (ENNReal.ofReal L * ENNReal.ofReal A) ^ (2 * r) *
          ∑' x, (∑ α ∈ sigmaUpper S k A₀, ‖companionProj S ε A₀ α f x‖ₑ ^ 2) ^ r := by
    intro A₀ hA₀
    set A' : ℝ≥0 := Real.toNNReal (2 ^ k * (Cs * A)) with hA'_def
    have hA' : (A' : ℝ≥0∞) = 2 ^ k * ENNReal.ofReal (Cs * A) := by
      rw [show (A' : ℝ≥0∞) = ENNReal.ofReal (2 ^ k * (Cs * A)) from rfl,
        ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_pow (by norm_num), ENNReal.ofReal_ofNat]
    set T := latMultHom (integrableOn_cosetSymbol hmi (sigmaBlock S A₀) (Q := blockProd S))
      with hT
    set u : (Fin n → ZMod (blockProd S)) → l1Subgroup n := fun α =>
      ⟨latModulate (-ratPt (blockProd S) α) (companionProj S ε A₀ α f), by
        change Summable _
        simpa only [norm_latModulate] using summable_companionProj hε hε4 A₀ α hfs⟩ with hu_def
    have hmz := marcinkiewicz_zygmund_square_function ℂ ℂ (l1Subgroup n) T (p := 2 * r)
      (by positivity) A' (fun g => by rw [hA']; exact hTA A₀ hA₀ g) (sigmaUpper S k A₀) u
      (fun _ _ => AEStronglyMeasurable.of_discrete) (fun _ _ => AEStronglyMeasurable.of_discrete)
    have hTu : ∀ α ∈ sigmaUpper S k A₀, ∀ y,
        ‖T (u α) y‖ = ‖cosetMult (blockProd S) m (cosetSet S A₀ α) f y‖ := by
      intro α hα y
      rw [cosetMult_cosetSet_eq_modulate hS1 hS hε hεr hmε hα hfs, norm_latModulate]
      rfl
    have hu : ∀ α x, ‖(u α : (Fin n → ℤ) → ℂ) x‖ = ‖companionProj S ε A₀ α f x‖ :=
      fun α x => norm_latModulate _ _ _
    have e1 : (fun y => Real.sqrt (∑ α ∈ sigmaUpper S k A₀, ‖T (u α) y‖ ^ 2)) =
        fun y => Real.sqrt (∑ α ∈ sigmaUpper S k A₀,
          ‖cosetMult (blockProd S) m (cosetSet S A₀ α) f y‖ ^ 2) :=
      funext fun y => by
        congr 1; exact Finset.sum_congr rfl fun α hα => by rw [hTu α hα y]
    have e2 : (fun x => Real.sqrt (∑ α ∈ sigmaUpper S k A₀,
          ‖(u α : (Fin n → ℤ) → ℂ) x‖ ^ 2)) =
        fun x => Real.sqrt (∑ α ∈ sigmaUpper S k A₀, ‖companionProj S ε A₀ α f x‖ ^ 2) :=
      funext fun x => by
        congr 1; exact Finset.sum_congr rfl fun α _ => by rw [hu α x]
    rw [e1, e2, <- hKMZ_def, hconst A' hA'] at hmz
    have h2 := pow_le_pow_left₀ zero_le hmz (2 * r)
    rw [mul_pow, eLpNorm_sqrt_sum_pow hr (sigmaUpper S k A₀)
        (fun α => cosetMult (blockProd S) m (cosetSet S A₀ α) f),
      eLpNorm_sqrt_sum_pow hr (sigmaUpper S k A₀) (fun α => companionProj S ε A₀ α f)] at h2
    exact h2
  -- combine: Lemma 7.5, the vector-valued bound, and Lemma 7.6
  have hmain : ∑' x, ‖cosetMult (blockProd S) m (sigmaLe S k) f x‖ₑ ^ (2 * r) ≤
      ENNReal.ofReal (normDescConst k r) * ((ENNReal.ofReal L * ENNReal.ofReal A) ^ (2 * r) *
        (ENNReal.ofReal (companionConst n k (2 * r)) * ∑' x, ‖f x‖ₑ ^ (2 * r))) := by
    refine (normdescription_cosetMult hS1 hS hr hε hεr hmi hmε hfs).trans ?_
    gcongr
    calc ∑ A₀ ∈ S.powerset with #A₀ ≤ k, ∑' x, (∑ α ∈ sigmaUpper S k A₀,
            ‖cosetMult (blockProd S) m (cosetSet S A₀ α) f x‖ₑ ^ 2) ^ r
        ≤ ∑ A₀ ∈ S.powerset with #A₀ ≤ k, (ENNReal.ofReal L * ENNReal.ofReal A) ^ (2 * r) *
            ∑' x, (∑ α ∈ sigmaUpper S k A₀, ‖companionProj S ε A₀ α f x‖ₑ ^ 2) ^ r :=
          Finset.sum_le_sum hcore
      _ = (ENNReal.ofReal L * ENNReal.ofReal A) ^ (2 * r) * ∑ A₀ ∈ S.powerset with #A₀ ≤ k,
            ∑' x, (∑ α ∈ sigmaUpper S k A₀, ‖companionProj S ε A₀ α f x‖ₑ ^ 2) ^ r :=
          (Finset.mul_sum _ _ _).symm
      _ ≤ _ := by
          gcongr
          exact companion_estimate_nat hS1 hS hε hεr hr hf
  have hroot : ∀ x : ℝ≥0∞, (x ^ (1 / (2 * r : ℝ))) ^ (2 * r) = x := fun x => by
    rw [← ENNReal.rpow_natCast, ← ENNReal.rpow_mul]
    push_cast
    rw [one_div_mul_cancel (by positivity), ENNReal.rpow_one]
  rw [← ENNReal.pow_le_pow_left_iff (n := 2 * r) (by omega), eLpNorm_count_pow_eq_tsum hr,
    mul_pow, mul_pow, eLpNorm_count_pow_eq_tsum hr]
  refine hmain.trans (le_of_eq ?_)
  simp only [hCenn_def, mul_pow, hroot]
  ring
/-! ### Duality -/

/-- The reflection-conjugation `g ↦ ḡ(-·)` on `ℤⁿ`. -/
noncomputable def latReflect (g : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) : ℂ := conj (g (-x))

/-- `(R g)^ = conj ĝ` for `R g = ḡ(-·)`. -/
lemma latFT_latReflect (g : (Fin n → ℤ) → ℂ) (ξ : EuclideanSpace ℝ (Fin n)) :
    latFT (latReflect g) ξ = conj (latFT g ξ) := by
  unfold latFT latReflect
  rw [Complex.conj_tsum, ← (Equiv.neg (Fin n → ℤ)).tsum_eq]
  refine tsum_congr fun z => ?_
  simp only [Equiv.neg_apply, neg_neg, map_mul, conj_eC, latEmbed_neg, inner_neg_left]

/-- `R` preserves finite support. -/
lemma support_latReflect_finite {g : (Fin n → ℤ) → ℂ} (hg : (Function.support g).Finite) :
    (Function.support (latReflect g)).Finite := by
  refine (hg.preimage (f := fun x : Fin n → ℤ => -x) neg_injective.injOn).subset fun x hx => ?_
  simp only [Function.mem_support, latReflect, ne_eq, map_eq_zero] at hx
  exact hx

/-- `(M̄)(D) g = R (M(D) (R g))` with `R g = ḡ(-·)`. -/
lemma latMult_conj_eq_latReflect (M : EuclideanSpace ℝ (Fin n) → ℂ) (g : (Fin n → ℤ) → ℂ) :
    latMult (fun ξ => conj (M ξ)) g = latReflect (latMult M (latReflect g)) := by
  funext x
  simp only [latReflect, latMult, latFT_latReflect]
  rw [← integral_conj]
  congr 1; funext ξ
  simp only [map_mul, Complex.conj_conj, conj_eC, latEmbed_neg, inner_neg_left, neg_neg]

/-- `R` is an isometry of `ℓ^p(ℤⁿ)`. -/
lemma eLpNorm_latReflect (g : (Fin n → ℤ) → ℂ) {p : ℝ} (hp : 0 < p) :
    eLpNorm (latReflect g) (ENNReal.ofReal p) Measure.count =
      eLpNorm g (ENNReal.ofReal p) Measure.count := by
  rw [eLpNorm_ofReal_eq_lintegral AEStronglyMeasurable.of_discrete hp,
    eLpNorm_ofReal_eq_lintegral AEStronglyMeasurable.of_discrete hp, lintegral_count,
    lintegral_count, ← (Equiv.neg (Fin n → ℤ)).tsum_eq]
  congr 1
  refine tsum_congr fun x => ?_
  simp [latReflect]

/-- The pairing `∑_x M(D) f(x) ḡ(x) = ∫_{𝕋ⁿ} M f̂ ĝ̄` for `f ∈ ℓ¹` and finitely supported `g`. -/
lemma tsum_latMult_mul_conj {M : EuclideanSpace ℝ (Fin n) → ℂ}
    (hM : IntegrableOn M (torusCube n)) {f g : (Fin n → ℤ) → ℂ}
    (hf : Summable fun z => ‖f z‖) (hg : (Function.support g).Finite) :
    ∑' x, latMult M f x * conj (g x) =
      ∫ ξ in torusCube n, M ξ * latFT f ξ * conj (latFT g ξ) := by
  set T := hg.toFinset
  have hT : ∀ z ∉ T, g z = 0 := fun z hz => by
    simpa [T] using hz
  rw [tsum_eq_sum (s := T) fun x hx => by rw [hT x hx, map_zero, mul_zero]]
  have hint : ∀ x ∈ T, IntegrableOn
      (fun ξ => M ξ * latFT f ξ * eC (inner ℝ (latEmbed x) ξ) * conj (g x)) (torusCube n) := by
    intro x _
    have : IntegrableOn (fun ξ => M ξ * (latFT f ξ * eC (inner ℝ (latEmbed x) ξ) * conj (g x)))
        (torusCube n) := hM.mul_bdd (c := (∑' z, ‖f z‖) * ‖g x‖)
      ((((continuous_latFT hf).mul (by fun_prop [continuous_eC])).mul
        continuous_const).aestronglyMeasurable)
      (Filter.Eventually.of_forall fun ξ => by
        rw [norm_mul, norm_mul, norm_eC, mul_one, Complex.norm_conj]
        exact mul_le_mul_of_nonneg_right (norm_latFT_le hf ξ) (norm_nonneg _))
    refine this.congr (Filter.Eventually.of_forall fun ξ => ?_)
    simp only; ring
  have e1 : ∀ x ∈ T, latMult M f x * conj (g x) =
      ∫ ξ in torusCube n, M ξ * latFT f ξ * eC (inner ℝ (latEmbed x) ξ) * conj (g x) := by
    intro x _
    rw [latMult, integral_mul_const]
  rw [Finset.sum_congr rfl e1, ← integral_finsetSum _ hint]
  congr 1; funext ξ
  rw [latFT_eq_sum hT, map_sum, Finset.mul_sum]
  refine Finset.sum_congr rfl fun x _ => ?_
  rw [map_mul, conj_eC]
  simp only [neg_neg]
  ring
/-- The adjoint of `M(D)` on finitely supported sequences is `M̄(D)`. -/
lemma tsum_latMult_mul_conj_eq {M : EuclideanSpace ℝ (Fin n) → ℂ}
    (hM : IntegrableOn M (torusCube n)) {f g : (Fin n → ℤ) → ℂ}
    (hf : (Function.support f).Finite) (hg : (Function.support g).Finite) :
    ∑' x, latMult M f x * conj (g x) =
      ∑' x, f x * conj (latMult (fun ξ => conj (M ξ)) g x) := by
  have hMc : IntegrableOn (fun ξ => conj (M ξ)) (torusCube n) :=
    Complex.conjCLE.toContinuousLinearMap.integrable_comp hM
  have h1 := tsum_latMult_mul_conj hMc (summable_of_finite_support hg) hf
  have h2 : ∑' x, f x * conj (latMult (fun ξ => conj (M ξ)) g x) =
      conj (∑' x, latMult (fun ξ => conj (M ξ)) g x * conj (f x)) := by
    rw [Complex.conj_tsum]
    refine tsum_congr fun x => ?_
    rw [map_mul, Complex.conj_conj, mul_comm]
  rw [h2, h1, ← integral_conj, tsum_latMult_mul_conj hM (summable_of_finite_support hf) hg]
  congr 1; funext ξ
  simp only [map_mul, Complex.conj_conj]
  ring

/-- `∫ h dcount = ∑' h` on `ℤⁿ` for integrable `h`. -/
lemma integral_count_eq_tsum {h : (Fin n → ℤ) → ℂ} (hh : Integrable h Measure.count) :
    ∫ x, h x ∂Measure.count = ∑' x, h x := by
  rw [integral_countable hh]
  simp

/-- Duality: an `ℓ^q` bound `K` for `M(D)` on finitely supported inputs gives the same bound for
`M(D)` on `ℓ^p`, `1/p + 1/q = 1`, on finitely supported inputs (the adjoint is
`M̄(D) = R M(D) R` with the isometry `R g = ḡ(-·)`). -/
lemma eLpNorm_latMult_le_of_dual {M : EuclideanSpace ℝ (Fin n) → ℂ}
    (hM : IntegrableOn M (torusCube n)) {p q : ℝ} (hpq : p.HolderConjugate q) {K : ℝ≥0∞}
    (hK : ∀ g : (Fin n → ℤ) → ℂ, (Function.support g).Finite →
      eLpNorm (latMult M g) (ENNReal.ofReal q) Measure.count ≤
        K * eLpNorm g (ENNReal.ofReal q) Measure.count)
    {f : (Fin n → ℤ) → ℂ} (hf : (Function.support f).Finite) :
    eLpNorm (latMult M f) (ENNReal.ofReal p) Measure.count ≤
      K * eLpNorm f (ENNReal.ofReal p) Measure.count := by
  refine eLpNorm_le_of_dual_test hpq AEStronglyMeasurable.of_discrete
    fun g _ _ hgs hgq hgi => ?_
  have hg : (Function.support g).Finite := Measure.count_apply_lt_top.1 hgs
  have hfi : Integrable (fun x => f x * conj (latMult (fun ξ => conj (M ξ)) g x))
      Measure.count := by
    refine integrable_count_iff.2 (summable_of_finite_support (hf.subset fun x hx => ?_))
    simp only [Function.mem_support, ne_eq] at hx ⊢
    exact left_ne_zero_of_mul hx
  rw [integral_count_eq_tsum hgi, tsum_latMult_mul_conj_eq hM hf hg,
    ← integral_count_eq_tsum hfi]
  refine (enorm_integral_mul_conj_le hpq AEStronglyMeasurable.of_discrete
    AEStronglyMeasurable.of_discrete).trans ?_
  rw [latMult_conj_eq_latReflect, eLpNorm_latReflect _ hpq.symm.pos, mul_comm]
  gcongr
  refine (hK _ (support_latReflect_finite hg)).trans ?_
  rw [eLpNorm_latReflect _ hpq.symm.pos]
  calc K * eLpNorm g (ENNReal.ofReal q) Measure.count ≤ K * 1 := by gcongr
    _ = K := mul_one K
/-- Blueprint Theorem 7.7 (`thm:IW`, "Rational-frequency transference"). Let `n, k ∈ ℕ`,
`r ≥ 1` and `(2r)' = 2r/(2r-1) ≤ p ≤ 2r`. There is a constant `C = C(n,k,r,p) ≥ 0` such that the
following holds. Let `S` be a finite set of pairwise coprime integers `> 1`, let
`0 < ε ≤ (100 r q_*^{2rk})⁻¹` (eq. (7.1)), and let `m : E → ℂ` be a bounded (`|m| ≤ B`)
measurable symbol supported in `[-ε/2, ε/2]ⁿ` whose Euclidean `L^{2r}` multiplier norm is at
most `A` (tested on Schwartz functions). Then for every finitely supported `f : ℤⁿ → ℂ`,
`‖T_{m;Σ_{≤k}} f‖_{ℓ^p} ≤ C A ‖f‖_{ℓ^p}`, where `T_{m;Σ_{≤k}} = cosetMult Q_S m Σ_{≤k}` is the
lattice multiplier with symbol `∑_{β ∈ Σ_{≤k}} m_per(ξ - β)`. The constant does not depend on
`S`, `ε`, `m`, `B`, `A` or `f`. -/
theorem coprime_block_multiplier_transference (n k r : ℕ) (hr : 1 ≤ r) {p : ℝ}
    (hp1 : (2 * r : ℝ) / (2 * r - 1) ≤ p) (hp2 : p ≤ 2 * r) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (S : Finset ℕ), (∀ q ∈ S, 1 < q) → (S : Set ℕ).Pairwise Nat.Coprime →
      ∀ [NeZero (blockProd S)] (ε : ℝ), 0 < ε →
      ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹ →
      ∀ (m : EuclideanSpace ℝ (Fin n) → ℂ) (B A : ℝ), AEStronglyMeasurable m volume →
      (∀ ξ, ‖m ξ‖ ≤ B) → Function.support m ⊆ {ξ | ∀ i, |ξ i| ≤ ε / 2} →
      (∀ F : 𝓢(EuclideanSpace ℝ (Fin n), ℂ),
        eLpNorm (𝓕⁻ (fun ξ => m ξ * 𝓕 (F : EuclideanSpace ℝ (Fin n) → ℂ) ξ))
          (ENNReal.ofReal (2 * r)) volume ≤
            ENNReal.ofReal A * eLpNorm F (ENNReal.ofReal (2 * r)) volume) →
      ∀ f : (Fin n → ℤ) → ℂ, (Function.support f).Finite →
        eLpNorm (cosetMult (blockProd S) m (sigmaLe S k) f) (ENNReal.ofReal p) Measure.count ≤
          ENNReal.ofReal (C * A) * eLpNorm f (ENNReal.ofReal p) Measure.count := by
  obtain ⟨C₁, hC₁, h2r⟩ := cosetMult_sigmaLe_bound_two_mul n k (r := r) hr
  have hb1 : (1 : ℝ) < 2 * r := by
    have : (1 : ℝ) ≤ r := by exact_mod_cast hr
    linarith
  set a : ℝ := (2 * r : ℝ) / (2 * r - 1) with ha_def
  have hconj : a.HolderConjugate (2 * r) := (Real.HolderConjugate.conjExponent hb1).symm
  have ha0 : 0 < a := hconj.pos
  -- the two endpoint bounds, for fixed data
  have hend : ∀ (S : Finset ℕ), (∀ q ∈ S, 1 < q) → (S : Set ℕ).Pairwise Nat.Coprime →
      ∀ [NeZero (blockProd S)] (ε : ℝ), 0 < ε →
      ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹ →
      ∀ (m : EuclideanSpace ℝ (Fin n) → ℂ) (B A : ℝ), AEStronglyMeasurable m volume →
      (∀ ξ, ‖m ξ‖ ≤ B) → Function.support m ⊆ {ξ | ∀ i, |ξ i| ≤ ε / 2} →
      (∀ F : 𝓢(EuclideanSpace ℝ (Fin n), ℂ),
        eLpNorm (𝓕⁻ (fun ξ => m ξ * 𝓕 (F : EuclideanSpace ℝ (Fin n) → ℂ) ξ))
          (ENNReal.ofReal (2 * r)) volume ≤
            ENNReal.ofReal A * eLpNorm F (ENNReal.ofReal (2 * r)) volume) →
      ∀ t ∈ ({a, (2 * r : ℝ)} : Set ℝ), ∀ f : (Fin n → ℤ) → ℂ, (Function.support f).Finite →
        eLpNorm (cosetMult (blockProd S) m (sigmaLe S k) f) (ENNReal.ofReal t) Measure.count ≤
          ENNReal.ofReal C₁ * ENNReal.ofReal A * eLpNorm f (ENNReal.ofReal t) Measure.count := by
    intro S hS1 hS _ ε hε hεr m B A hm hB hsupp hA t ht f hf
    rcases ht with rfl | rfl
    · have hmi : Integrable m := integrable_of_bound_of_support_subset hm hB (by positivity) hsupp
      exact eLpNorm_latMult_le_of_dual (integrableOn_cosetSymbol hmi _) hconj
        (fun g hg => h2r S hS1 hS ε hε hεr m B A hm hB hsupp hA g hg) hf
    · exact h2r S hS1 hS ε hε hεr m B A hm hB hsupp hA f hf
  rcases eq_or_lt_of_le hp2 with rfl | hpb
  · refine ⟨C₁, hC₁, fun S hS1 hS _ ε hε hεr m B A hm hB hsupp hA f hf => ?_⟩
    rw [ENNReal.ofReal_mul hC₁]
    exact hend S hS1 hS ε hε hεr m B A hm hB hsupp hA _ (by simp) f hf
  rcases eq_or_lt_of_le hp1 with rfl | hap
  · refine ⟨C₁, hC₁, fun S hS1 hS _ ε hε hεr m B A hm hB hsupp hA f hf => ?_⟩
    rw [ENNReal.ofReal_mul hC₁]
    exact hend S hS1 hS ε hε hεr m B A hm hB hsupp hA _ (by simp) f hf
  -- interior exponents: Marcinkiewicz interpolation
  set θ : ℝ := (1 / a - 1 / p) / (1 / a - 1 / (2 * r)) with hθ_def
  have hp0 : 0 < p := ha0.trans hap
  have hab : 1 / (2 * r : ℝ) < 1 / a := one_div_lt_one_div_of_lt ha0 (hap.trans hpb)
  have hθ0 : 0 ≤ θ := by
    refine div_nonneg (sub_nonneg.2 (one_div_le_one_div_of_le ha0 hap.le)) (by linarith)
  have hθ1 : θ ≤ 1 := by
    rw [hθ_def, div_le_one (by linarith)]
    have : 1 / (2 * r : ℝ) ≤ 1 / p := one_div_le_one_div_of_le hp0 hpb.le
    linarith
  have hθ : 1 / p = (1 - θ) / a + θ / (2 * r) := by
    have h1 : 1 / a - 1 / (2 * r : ℝ) ≠ 0 := by linarith
    have e : (1 - θ) / a + θ / (2 * r) = 1 / a - θ * (1 / a - 1 / (2 * r : ℝ)) := by ring
    rw [e, hθ_def, div_mul_cancel₀ _ h1]
    ring
  set Cm : ℝ := (marcinkiewiczConst a (2 * r) p : ℝ) with hCm
  refine ⟨Cm * C₁, mul_nonneg (NNReal.coe_nonneg _) hC₁,
    fun S hS1 hS _ ε hε hεr m B A hm hB hsupp hA f hf => ?_⟩
  have hmi : Integrable m := integrable_of_bound_of_support_subset hm hB (by positivity) hsupp
  have hMi := integrableOn_cosetSymbol hmi (sigmaLe S k) (Q := blockProd S)
  set D : Set ((Fin n → ℤ) → ℂ) := {g | (Function.support g).Finite} with hD
  set T := cosetMult (n := n) (blockProd S) m (sigmaLe S k) with hT
  set A' : ℝ≥0 := Real.toNNReal (C₁ * A) with hA'
  have hA'e : (A' : ℝ≥0∞) = ENNReal.ofReal C₁ * ENNReal.ofReal A := by
    rw [show (A' : ℝ≥0∞) = ENNReal.ofReal (C₁ * A) from rfl, ENNReal.ofReal_mul hC₁]
  have hstrong : ∀ t ∈ ({a, (2 * r : ℝ)} : Set ℝ), HasStrongTypeOn T D t A' Measure.count
      Measure.count := by
    intro t ht g hg
    rw [hA'e]
    exact hend S hS1 hS ε hε hεr m B A hm hB hsupp hA t ht g hg
  have hsub : IsSublinearOn T D Measure.count := by
    intro g hg h hh
    refine Filter.Eventually.of_forall fun x => ?_
    rw [hT, cosetMult, latMult_add hMi (summable_of_finite_support hg)
      (summable_of_finite_support hh)]
    exact norm_add_le _ _
  have htr : IsTruncationClosed D := by
    intro g hg s _
    have hsub' : ∀ s' : Set (Fin n → ℤ), Function.support (s'.indicator g) ⊆ Function.support g :=
      fun s' x hx => by
        rw [Function.mem_support] at hx ⊢; intro h0; exact hx (by simp [h0])
    exact ⟨hg.subset (hsub' _), hg.subset (hsub' _)⟩
  have key := eLpNorm_le_of_hasWeakTypeOn (μ := Measure.count) (ν := Measure.count) ha0 hap hpb
    hθ ((hstrong a (by simp)).hasWeakTypeOn ha0)
    ((hstrong (2 * r : ℝ) (by simp)).hasWeakTypeOn (by linarith)) hsub htr (show f ∈ D from hf)
    AEStronglyMeasurable.of_discrete AEStronglyMeasurable.of_discrete
  refine key.trans (le_of_eq ?_)
  rw [mul_assoc (marcinkiewiczConst a (2 * r) p : ℝ≥0∞), ← ENNReal.rpow_add_of_nonneg _ _
    (by linarith) hθ0, sub_add_cancel, ENNReal.rpow_one, hA'e, hCm,
    ENNReal.ofReal_mul (mul_nonneg (NNReal.coe_nonneg _) hC₁),
    ENNReal.ofReal_mul (NNReal.coe_nonneg _), ENNReal.ofReal_coe_nnreal]
  ring


end RationalTransference

section GoodSet

/-! ### Blueprint Construction 7.8 (`con:goodset`) -/

/-- `N₀ = ⌈N^{ρ/4}⌉` of Blueprint Construction 7.8 (`con:goodset`). -/
noncomputable def goodN0 (ρ : ℝ) (N : ℕ) : ℕ := ⌈(N : ℝ) ^ (ρ / 4)⌉₊

/-- `Q₀ = ∏_{p ≤ N₀ prime} p^{⌊log_p N⌋}` of Blueprint Construction 7.8 (`con:goodset`). -/
noncomputable def goodQ0 (ρ : ℝ) (N : ℕ) : ℕ :=
  ∏ p ∈ (range (goodN0 ρ N + 1)).filter Nat.Prime, p ^ Nat.log p N

/-- The large primes `N₀ < p ≤ N` of Blueprint Construction 7.8 (`con:goodset`). -/
noncomputable def goodLargePrimes (ρ : ℝ) (N : ℕ) : Finset ℕ :=
  (Ioc (goodN0 ρ N) N).filter Nat.Prime

/-- The blocks of Blueprint Construction 7.8 (`con:goodset`): `Q₀` (when `Q₀ > 1`) and
`p^{⌊log_p N⌋}` for every prime `N₀ < p ≤ N`. -/
noncomputable def goodBlocks (ρ : ℝ) (N : ℕ) : Finset ℕ :=
  (if 1 < goodQ0 ρ N then {goodQ0 ρ N} else ∅) ∪
    (goodLargePrimes ρ N).image fun p => p ^ Nat.log p N

/-- `k = ⌈4/ρ⌉ + 1` of Blueprint Construction 7.8 (`con:goodset`). -/
noncomputable def goodK (ρ : ℝ) : ℕ := ⌈4 / ρ⌉₊ + 1

lemma mem_goodLargePrimes {ρ : ℝ} {N p : ℕ} :
    p ∈ goodLargePrimes ρ N ↔ (goodN0 ρ N < p ∧ p ≤ N) ∧ p.Prime := by
  simp [goodLargePrimes]

lemma mem_goodBlocks {ρ : ℝ} {N b : ℕ} :
    b ∈ goodBlocks ρ N ↔ (b = goodQ0 ρ N ∧ 1 < goodQ0 ρ N) ∨
      ∃ p ∈ goodLargePrimes ρ N, p ^ Nat.log p N = b := by
  unfold goodBlocks
  split_ifs with h <;> simp [h]

/-- For a prime `p ≤ N`, the block `p^{⌊log_p N⌋}` is `> 1`. -/
lemma one_lt_pow_log_of_prime {p N : ℕ} (hp : p.Prime) (hpN : p ≤ N) :
    1 < p ^ Nat.log p N := by
  have h1 : 1 ≤ Nat.log p N := Nat.le_log_of_pow_le hp.one_lt (by simpa using hpN)
  exact Nat.one_lt_pow (by omega) hp.one_lt

lemma goodQ0_pos (ρ : ℝ) (N : ℕ) : 0 < goodQ0 ρ N :=
  Finset.prod_pos fun _ hp => pow_pos (Finset.mem_filter.1 hp).2.pos _

/-- Blueprint Construction 7.8 (`con:goodset`): the blocks are integers `> 1`. -/
theorem goodBlocks_one_lt {ρ : ℝ} {N : ℕ} : ∀ b ∈ goodBlocks ρ N, 1 < b := by
  intro b hb
  rcases mem_goodBlocks.1 hb with ⟨rfl, h⟩ | ⟨p, hp, rfl⟩
  · exact h
  · obtain ⟨⟨_, hpN⟩, hpp⟩ := mem_goodLargePrimes.1 hp
    exact one_lt_pow_log_of_prime hpp hpN

/-- A prime `p > N₀` gives a block coprime to `Q₀`. -/
lemma coprime_pow_goodQ0 {ρ : ℝ} {N p e : ℕ} (hp : p.Prime) (hpN0 : goodN0 ρ N < p) :
    Nat.Coprime (p ^ e) (goodQ0 ρ N) := by
  refine Nat.Coprime.prod_right fun p' hp' => ?_
  obtain ⟨hp'r, hp'p⟩ := Finset.mem_filter.1 hp'
  have hne : p ≠ p' := by
    have := Finset.mem_range.1 hp'r
    omega
  exact Nat.Coprime.pow _ _ ((Nat.coprime_primes hp hp'p).2 hne)

/-- Blueprint Construction 7.8 (`con:goodset`): the blocks are pairwise coprime. -/
theorem goodBlocks_pairwise_coprime {ρ : ℝ} {N : ℕ} :
    ((goodBlocks ρ N : Finset ℕ) : Set ℕ).Pairwise Nat.Coprime := by
  intro x hx y hy hxy
  rcases mem_goodBlocks.1 hx with ⟨rfl, _⟩ | ⟨p, hp, rfl⟩ <;>
    rcases mem_goodBlocks.1 hy with ⟨rfl, _⟩ | ⟨p', hp', rfl⟩
  · exact absurd rfl hxy
  · obtain ⟨⟨h1, _⟩, hpp⟩ := mem_goodLargePrimes.1 hp'
    exact (coprime_pow_goodQ0 hpp h1).symm
  · obtain ⟨⟨h1, _⟩, hpp⟩ := mem_goodLargePrimes.1 hp
    exact coprime_pow_goodQ0 hpp h1
  · obtain ⟨_, hpp⟩ := mem_goodLargePrimes.1 hp
    obtain ⟨_, hpp'⟩ := mem_goodLargePrimes.1 hp'
    have hne : p ≠ p' := fun h => hxy (h ▸ rfl)
    exact Nat.Coprime.pow _ _ ((Nat.coprime_primes hpp hpp').2 hne)

instance neZero_blockProd_goodBlocks (ρ : ℝ) (N : ℕ) : NeZero (blockProd (goodBlocks ρ N)) :=
  neZero_blockProd goodBlocks_one_lt

/-- `𝒰_N = Σ_{≤k}` for the blocks of Blueprint Construction 7.8 (`con:goodset`). -/
noncomputable def goodSet (ρ : ℝ) (N : ℕ) : Finset (Fin n → ZMod (blockProd (goodBlocks ρ N))) :=
  sigmaLe (goodBlocks ρ N) (goodK ρ)

/-- Blueprint Construction 7.8 (`con:goodset`): every `1 ≤ q ≤ N` divides `Q_S`, the product of
all blocks (so `T[q] ⊆ T[Q_S]`). -/
theorem dvd_blockProd_goodBlocks (ρ : ℝ) {N q : ℕ} (hq1 : 1 ≤ q) (hqN : q ≤ N) :
    q ∣ blockProd (goodBlocks ρ N) := by
  rw [Nat.dvd_iff_prime_pow_dvd_dvd]
  intro p a hp hpa
  rcases Nat.eq_zero_or_pos a with rfl | ha
  · simp
  have hle : p ^ a ≤ N := (Nat.le_of_dvd hq1 hpa).trans hqN
  have hal : a ≤ Nat.log p N := Nat.le_log_of_pow_le hp.one_lt hle
  have hpN : p ≤ N := (Nat.le_self_pow ha.ne' p).trans hle
  refine (pow_dvd_pow p hal).trans ?_
  by_cases hp0 : p ≤ goodN0 ρ N
  · have hdQ : p ^ Nat.log p N ∣ goodQ0 ρ N :=
      Finset.dvd_prod_of_mem (fun p => p ^ Nat.log p N)
        (Finset.mem_filter.2 ⟨Finset.mem_range.2 (by omega), hp⟩)
    have hQ1 : 1 < goodQ0 ρ N :=
      lt_of_lt_of_le (one_lt_pow_log_of_prime hp hpN) (Nat.le_of_dvd (goodQ0_pos ρ N) hdQ)
    exact hdQ.trans (dvd_blockProd (mem_goodBlocks.2 (Or.inl ⟨rfl, hQ1⟩)))
  · exact dvd_blockProd (mem_goodBlocks.2 (Or.inr ⟨p,
      mem_goodLargePrimes.2 ⟨⟨by omega, hpN⟩, hp⟩, rfl⟩))

/-- The counting step of Blueprint Construction 7.8 (`con:goodset`): at most `4/ρ` distinct
primes `p > N₀ ≥ N^{ρ/4}` divide `q ≤ N`. -/
lemma card_largePrimes_dvd_le {ρ : ℝ} (hρ : 0 < ρ) {N q : ℕ} (hN : 2 ≤ N) (hq1 : 1 ≤ q)
    (hqN : q ≤ N) : ((goodLargePrimes ρ N).filter (· ∣ q)).card ≤ ⌈4 / ρ⌉₊ := by
  set P := (goodLargePrimes ρ N).filter (· ∣ q) with hP
  have hPmem : ∀ p ∈ P, (goodN0 ρ N < p ∧ p ≤ N) ∧ p.Prime ∧ p ∣ q := fun p hp => by
    obtain ⟨h1, h2⟩ := Finset.mem_filter.1 hp
    exact ⟨(mem_goodLargePrimes.1 h1).1, (mem_goodLargePrimes.1 h1).2, h2⟩
  have hdvd : ∏ p ∈ P, p ∣ q :=
    Finset.prod_primes_dvd q (fun p hp => Nat.prime_iff.1 (hPmem p hp).2.1)
      fun p hp => (hPmem p hp).2.2
  have hprod : (∏ p ∈ P, p : ℕ) ≤ N := (Nat.le_of_dvd hq1 hdvd).trans hqN
  have hNr : (1 : ℝ) < N := by exact_mod_cast hN
  have hN0 : (0 : ℝ) ≤ (N : ℝ) ^ (ρ / 4) := Real.rpow_nonneg (by positivity) _
  have hlow : ((N : ℝ) ^ (ρ / 4)) ^ P.card ≤ (N : ℝ) := by
    calc ((N : ℝ) ^ (ρ / 4)) ^ P.card = ∏ _p ∈ P, (N : ℝ) ^ (ρ / 4) := by
          rw [Finset.prod_const]
      _ ≤ ∏ p ∈ P, (p : ℝ) := by
          refine Finset.prod_le_prod₀ (fun _ _ => hN0) fun p hp => ?_
          have h1 : (N : ℝ) ^ (ρ / 4) ≤ goodN0 ρ N := Nat.le_ceil _
          have h2 : (goodN0 ρ N : ℝ) ≤ p := by exact_mod_cast (hPmem p hp).1.1.le
          linarith
      _ = ((∏ p ∈ P, p : ℕ) : ℝ) := by push_cast; rfl
      _ ≤ N := by exact_mod_cast hprod
  rw [← Real.rpow_natCast, ← Real.rpow_mul (by positivity)] at hlow
  have hexp : ρ / 4 * P.card ≤ 1 := by
    have := (Real.rpow_le_rpow_left_iff hNr).1 (hlow.trans (Real.rpow_one _).symm.le)
    exact this
  have hc : (P.card : ℝ) ≤ 4 / ρ := by
    rw [le_div_iff₀ hρ]; linarith
  exact_mod_cast hc.trans (Nat.le_ceil _)

/-- The blocks not coprime to `q ≤ N` are at most `k` in number. -/
lemma card_goodBlocks_not_coprime_le {ρ : ℝ} (hρ : 0 < ρ) {N q : ℕ} (hN : 2 ≤ N)
    (hq1 : 1 ≤ q) (hqN : q ≤ N) :
    ((goodBlocks ρ N).filter fun b => ¬ Nat.Coprime b q).card ≤ goodK ρ := by
  have hsub : (goodBlocks ρ N).filter (fun b => ¬ Nat.Coprime b q) ⊆
      {goodQ0 ρ N} ∪ ((goodLargePrimes ρ N).filter (· ∣ q)).image fun p => p ^ Nat.log p N := by
    intro b hb
    obtain ⟨hbS, hnc⟩ := Finset.mem_filter.1 hb
    rcases mem_goodBlocks.1 hbS with ⟨rfl, _⟩ | ⟨p, hp, rfl⟩
    · exact Finset.mem_union_left _ (Finset.mem_singleton_self _)
    · refine Finset.mem_union_right _ (Finset.mem_image.2 ⟨p, Finset.mem_filter.2 ⟨hp, ?_⟩, rfl⟩)
      by_contra h
      exact hnc (Nat.Coprime.pow_left _
        ((Nat.Prime.coprime_iff_not_dvd (mem_goodLargePrimes.1 hp).2).2 h))
  have h1 := Finset.card_le_card hsub
  have h2 := Finset.card_union_le ({goodQ0 ρ N} : Finset ℕ)
    (((goodLargePrimes ρ N).filter (· ∣ q)).image fun p => p ^ Nat.log p N)
  have h3 : (((goodLargePrimes ρ N).filter (· ∣ q)).image fun p => p ^ Nat.log p N).card ≤
      ((goodLargePrimes ρ N).filter (· ∣ q)).card := Finset.card_image_le
  have h4 := card_largePrimes_dvd_le hρ hN hq1 hqN
  rw [Finset.card_singleton] at h2
  unfold goodK; omega

/-- Blueprint Construction 7.8 (`con:goodset`): every rational point of denominator `q ≤ N`
belongs to `𝒰_N`, i.e. `T[q] ⊆ Σ_{≤k}` inside `T[Q_S]` for all `1 ≤ q ≤ N` (its block support
consists of blocks not coprime to `q`: the block `Q₀` and at most `4/ρ` large prime powers). -/
theorem blockGrid_subset_goodSet {ρ : ℝ} (hρ : 0 < ρ) {N q : ℕ} (hN : 2 ≤ N) (hq1 : 1 ≤ q)
    (hqN : q ≤ N) :
    (blockGrid (blockProd (goodBlocks ρ N)) q : Finset (Fin n → ZMod _)) ⊆
      goodSet ρ N := by
  intro x hx
  rw [mem_blockGrid] at hx
  rw [goodSet, mem_sigmaLe]
  have hsub : blockSupp (goodBlocks ρ N) x ⊆
      (goodBlocks ρ N).filter fun b => ¬ Nat.Coprime b q := by
    intro b hb
    obtain ⟨hbS, hne⟩ := mem_blockSupp.1 hb
    refine Finset.mem_filter.2 ⟨hbS, fun hc => hne ?_⟩
    have h := congrArg (blockRed b) hx
    rw [blockRed_nsmul (dvd_blockProd hbS), blockRed_zero (dvd_blockProd hbS)] at h
    exact eq_zero_of_nsmul_eq_zero_of_coprime hc.symm h
  exact (Finset.card_le_card hsub).trans (card_goodBlocks_not_coprime_le hρ hN hq1 hqN)

/-- Blueprint Construction 7.8 (`con:goodset`), in terms of points of `E`: for `1 ≤ q ≤ N`, every
rational point `b/q` (`b ∈ {0,…,q-1}ⁿ`) is the point `ratPt Q_S x` of a center `x ∈ 𝒰_N`. -/
theorem gridEmb_mem_goodSet {ρ : ℝ} (hρ : 0 < ρ) {N q : ℕ} (hN : 2 ≤ N) (hq1 : 1 ≤ q)
    (hqN : q ≤ N) (b : Fin n → Fin q) :
    gridEmb (blockProd (goodBlocks ρ N)) q b ∈ goodSet ρ N ∧
      ratPt (blockProd (goodBlocks ρ N)) (gridEmb (blockProd (goodBlocks ρ N)) q b) =
        gridPt q b :=
  ⟨blockGrid_subset_goodSet hρ hN hq1 hqN
      (gridEmb_mem_blockGrid (dvd_blockProd_goodBlocks ρ hq1 hqN) b),
    ratPt_gridEmb (dvd_blockProd_goodBlocks ρ hq1 hqN) b⟩

/-- Blueprint Construction 7.8 (`con:goodset`), the case `N₀ ≥ N`: then the only block is
`Q₀`, and every `1 ≤ q ≤ N` divides `Q₀`. -/
theorem goodBlocks_of_le_goodN0 (ρ : ℝ) {N : ℕ} (hN : 2 ≤ N) (h : N ≤ goodN0 ρ N) :
    goodBlocks ρ N = {goodQ0 ρ N} ∧ 1 < goodQ0 ρ N ∧
      ∀ q, 1 ≤ q → q ≤ N → q ∣ goodQ0 ρ N := by
  have hL : goodLargePrimes ρ N = ∅ := by
    ext p; simp only [mem_goodLargePrimes, Finset.notMem_empty, iff_false]; omega
  have h2 : 2 ^ Nat.log 2 N ∣ goodQ0 ρ N :=
    Finset.dvd_prod_of_mem (fun p => p ^ Nat.log p N)
      (Finset.mem_filter.2 ⟨Finset.mem_range.2 (by omega), Nat.prime_two⟩)
  have hQ1 : 1 < goodQ0 ρ N :=
    lt_of_lt_of_le (one_lt_pow_log_of_prime Nat.prime_two hN)
      (Nat.le_of_dvd (goodQ0_pos ρ N) h2)
  have hB : goodBlocks ρ N = {goodQ0 ρ N} := by
    simp [goodBlocks, hL, hQ1]
  refine ⟨hB, hQ1, fun q hq1 hqN => ?_⟩
  have := dvd_blockProd_goodBlocks ρ hq1 hqN
  rwa [hB, blockProd, Finset.prod_singleton] at this

/-! ### Size bounds -/

lemma card_smallPrimes_le (N₀ : ℕ) : ((range (N₀ + 1)).filter Nat.Prime).card ≤ N₀ := by
  have hsub : (range (N₀ + 1)).filter Nat.Prime ⊆ Icc 1 N₀ := by
    intro p hp
    obtain ⟨h1, h2⟩ := Finset.mem_filter.1 hp
    have := Finset.mem_range.1 h1
    have := h2.pos
    exact Finset.mem_Icc.2 ⟨by omega, by omega⟩
  simpa using Finset.card_le_card hsub

/-- Blueprint Construction 7.8 (`con:goodset`): `Q₀ ≤ N^{N₀}` (at most `N₀` small primes, each
factor `≤ N`). -/
theorem goodQ0_le_pow (ρ : ℝ) {N : ℕ} (hN : 1 ≤ N) : goodQ0 ρ N ≤ N ^ goodN0 ρ N :=
  (Finset.prod_le_pow_card _ _ _ fun p _ => Nat.pow_log_le_self p (by omega)).trans
    (Nat.pow_le_pow_right hN (card_smallPrimes_le _))

lemma one_le_goodN0 (ρ : ℝ) {N : ℕ} (hN : 1 ≤ N) : 1 ≤ goodN0 ρ N :=
  Nat.one_le_iff_ne_zero.2 (Nat.ceil_pos.2 (Real.rpow_pos_of_pos (by exact_mod_cast hN) _)).ne'

/-- Blueprint Construction 7.8 (`con:goodset`): `log Q₀ ≤ N₀ log N`. -/
theorem log_goodQ0_le (ρ : ℝ) {N : ℕ} (hN : 1 ≤ N) :
    Real.log (goodQ0 ρ N) ≤ goodN0 ρ N * Real.log N := by
  rw [← Real.log_pow]
  refine Real.log_le_log (by exact_mod_cast goodQ0_pos ρ N) ?_
  exact_mod_cast goodQ0_le_pow ρ hN

/-- Blueprint Construction 7.8 (`con:goodset`): `N₀ log N ≤ C_ρ N^{ρ/2}` with `C_ρ = 8/ρ`. -/
theorem goodN0_mul_log_le {ρ : ℝ} (hρ : 0 < ρ) {N : ℕ} (hN : 1 ≤ N) :
    (goodN0 ρ N : ℝ) * Real.log N ≤ 8 / ρ * (N : ℝ) ^ (ρ / 2) := by
  have hN' : (1 : ℝ) ≤ N := by exact_mod_cast hN
  set t := (N : ℝ) ^ (ρ / 4) with ht
  have ht1 : 1 ≤ t := Real.one_le_rpow hN' (by positivity)
  have hN0 : (goodN0 ρ N : ℝ) ≤ 2 * t := by
    have := Nat.ceil_lt_add_one (show 0 ≤ t by linarith)
    rw [goodN0]; linarith
  have hlog : Real.log N ≤ t / (ρ / 4) := Real.log_le_rpow_div (by positivity) (by positivity)
  have hlog0 : 0 ≤ Real.log N := Real.log_nonneg hN'
  have htt : (N : ℝ) ^ (ρ / 2) = t * t := by
    rw [ht, ← Real.rpow_add (by linarith)]; ring_nf
  calc (goodN0 ρ N : ℝ) * Real.log N ≤ (2 * t) * (t / (ρ / 4)) :=
        mul_le_mul hN0 hlog hlog0 (by linarith)
    _ = 8 / ρ * (N : ℝ) ^ (ρ / 2) := by rw [htt]; field_simp; ring

/-- Blueprint Construction 7.8 (`con:goodset`): every block is at most `max(Q₀, N)`. -/
theorem le_max_of_mem_goodBlocks {ρ : ℝ} {N b : ℕ} (hN : 1 ≤ N) (hb : b ∈ goodBlocks ρ N) :
    b ≤ max (goodQ0 ρ N) N := by
  rcases mem_goodBlocks.1 hb with ⟨rfl, _⟩ | ⟨p, _, rfl⟩
  · exact le_max_left _ _
  · exact (Nat.pow_log_le_self p (by omega)).trans (le_max_right _ _)

/-- Blueprint Construction 7.8 (`con:goodset`): `q_* ≤ max(Q₀, N)`. -/
theorem blockStar_goodBlocks_le {ρ : ℝ} {N : ℕ} (hN : 2 ≤ N) :
    blockStar (goodBlocks ρ N) ≤ max (goodQ0 ρ N) N :=
  max_le (hN.trans (le_max_right _ _))
    (Finset.sup_le fun b hb => le_max_of_mem_goodBlocks (by omega) hb)

/-- Blueprint Construction 7.8 (`con:goodset`): `q_* ≤ exp(N₀ log N) ≤ exp(C_ρ N^{ρ/2})` with
`C_ρ = 8/ρ`. -/
theorem blockStar_goodBlocks_le_exp {ρ : ℝ} (hρ : 0 < ρ) {N : ℕ} (hN : 2 ≤ N) :
    (blockStar (goodBlocks ρ N) : ℝ) ≤ Real.exp (goodN0 ρ N * Real.log N) ∧
      (blockStar (goodBlocks ρ N) : ℝ) ≤ Real.exp (8 / ρ * (N : ℝ) ^ (ρ / 2)) := by
  have hN1 : 1 ≤ N := by omega
  have h1 : (blockStar (goodBlocks ρ N) : ℝ) ≤ Real.exp (goodN0 ρ N * Real.log N) := by
    have hle : (blockStar (goodBlocks ρ N) : ℝ) ≤ max (goodQ0 ρ N : ℝ) (N : ℝ) := by
      exact_mod_cast blockStar_goodBlocks_le hN
    refine hle.trans (max_le ?_ ?_)
    · rw [← Real.exp_log (by exact_mod_cast goodQ0_pos ρ N : (0 : ℝ) < goodQ0 ρ N)]
      exact Real.exp_le_exp.2 (log_goodQ0_le ρ hN1)
    · refine (Real.exp_log (by positivity : (0 : ℝ) < N)).symm.le.trans (Real.exp_le_exp.2 ?_)
      have : (1 : ℝ) ≤ goodN0 ρ N := by exact_mod_cast one_le_goodN0 ρ hN1
      have h0 : 0 ≤ Real.log N := Real.log_nonneg (by exact_mod_cast hN1)
      nlinarith
  exact ⟨h1, h1.trans (Real.exp_le_exp.2 (goodN0_mul_log_le hρ hN1))⟩

/-- Blueprint Construction 7.8 (`con:goodset`), the threshold: for every `r ≥ 1` there is
`C_{ρ,r} > 0` such that for all `N ≥ 2` and `0 < ε ≤ exp(-C_{ρ,r} N^{2ρ})`, hypothesis (7.1) of
Theorem 7.7 holds for the blocks of `𝒰_N`: `ε ≤ (100 r q_*^{2rk})⁻¹`. -/
theorem goodBlocks_eps_threshold {ρ : ℝ} (hρ : 0 < ρ) (r : ℕ) (hr : 1 ≤ r) :
    ∃ C : ℝ, 0 < C ∧ ∀ N : ℕ, 2 ≤ N → ∀ ε : ℝ, 0 < ε →
      ε ≤ Real.exp (-(C * (N : ℝ) ^ (2 * ρ))) →
      ε ≤ (100 * r * (blockStar (goodBlocks ρ N) : ℝ) ^ (2 * r * goodK ρ))⁻¹ := by
  set K : ℕ := 2 * r * goodK ρ
  have hr' : (1 : ℝ) ≤ r := by exact_mod_cast hr
  have hL0 : 0 ≤ Real.log (100 * r) := Real.log_nonneg (by linarith)
  refine ⟨Real.log (100 * r) + K * (8 / ρ) + 1, by positivity, fun N hN ε _ hε => ?_⟩
  refine hε.trans ?_
  have hN' : (1 : ℝ) ≤ N := by exact_mod_cast (show 1 ≤ N by omega)
  have hq := (blockStar_goodBlocks_le_exp (ρ := ρ) hρ hN).2
  have hq0 : (0 : ℝ) ≤ blockStar (goodBlocks ρ N) := by positivity
  set u := (N : ℝ) ^ (ρ / 2)
  set T := (N : ℝ) ^ (2 * ρ)
  have hT1 : 1 ≤ T := Real.one_le_rpow hN' (by positivity)
  have huT : u ≤ T := Real.rpow_le_rpow_of_exponent_le hN' (by linarith)
  have hu0 : 0 ≤ u := by positivity
  have hX : 100 * r * (blockStar (goodBlocks ρ N) : ℝ) ^ K ≤
      Real.exp ((Real.log (100 * r) + K * (8 / ρ) + 1) * T) := by
    calc 100 * r * (blockStar (goodBlocks ρ N) : ℝ) ^ K
        ≤ Real.exp (Real.log (100 * r)) * Real.exp (8 / ρ * u) ^ K := by
          rw [Real.exp_log (by positivity)]
          gcongr
      _ = Real.exp (Real.log (100 * r) + K * (8 / ρ * u)) := by
          rw [← Real.exp_nat_mul, ← Real.exp_add]
      _ ≤ _ := by
          refine Real.exp_le_exp.2 ?_
          have hK0 : (0 : ℝ) ≤ K * (8 / ρ) := by positivity
          nlinarith [mul_le_mul_of_nonneg_left huT hK0]
  have hXpos : 0 < 100 * r * (blockStar (goodBlocks ρ N) : ℝ) ^ K := by
    have : (0 : ℝ) < blockStar (goodBlocks ρ N) := by
      exact_mod_cast (lt_of_lt_of_le two_pos (two_le_blockStar _))
    positivity
  rw [Real.exp_neg]
  exact inv_anti₀ hXpos hX

end GoodSet

section GoodSetTransference

open MeasureTheory
open scoped FourierTransform SchwartzMap

/-- Blueprint Construction 7.8 (`con:goodset`), consequence: the conclusion of Theorem 7.7
(`thm:IW`) for `𝒰_N`, with constants independent of `N`. For `r ≥ 1` and `(2r)' ≤ p ≤ 2r` there
are `C ≥ 0` and `C_{ρ,r} > 0` such that for every `N ≥ 2`, every `0 < ε ≤ exp(-C_{ρ,r} N^{2ρ})`,
every bounded measurable `m` supported in `[-ε/2, ε/2]ⁿ` with Euclidean `L^{2r}` multiplier norm
`≤ A`, and every finitely supported `f`, `‖T_{m;𝒰_N} f‖_{ℓ^p} ≤ C A ‖f‖_{ℓ^p}`. -/
theorem goodSet_transference (n : ℕ) {ρ : ℝ} (hρ : 0 < ρ) (r : ℕ) (hr : 1 ≤ r) {p : ℝ}
    (hp1 : (2 * r : ℝ) / (2 * r - 1) ≤ p) (hp2 : p ≤ 2 * r) :
    ∃ C : ℝ, 0 ≤ C ∧ ∃ Cρr : ℝ, 0 < Cρr ∧ ∀ N : ℕ, 2 ≤ N → ∀ ε : ℝ, 0 < ε →
      ε ≤ Real.exp (-(Cρr * (N : ℝ) ^ (2 * ρ))) →
      ∀ (m : EuclideanSpace ℝ (Fin n) → ℂ) (B A : ℝ), AEStronglyMeasurable m volume →
      (∀ ξ, ‖m ξ‖ ≤ B) → Function.support m ⊆ {ξ | ∀ i, |ξ i| ≤ ε / 2} →
      (∀ F : 𝓢(EuclideanSpace ℝ (Fin n), ℂ),
        eLpNorm (𝓕⁻ (fun ξ => m ξ * 𝓕 (F : EuclideanSpace ℝ (Fin n) → ℂ) ξ))
          (ENNReal.ofReal (2 * r)) volume ≤
            ENNReal.ofReal A * eLpNorm F (ENNReal.ofReal (2 * r)) volume) →
      ∀ f : (Fin n → ℤ) → ℂ, (Function.support f).Finite →
        eLpNorm (cosetMult (blockProd (goodBlocks ρ N)) m (goodSet ρ N) f) (ENNReal.ofReal p)
            Measure.count ≤
          ENNReal.ofReal (C * A) * eLpNorm f (ENNReal.ofReal p) Measure.count := by
  obtain ⟨C, hC, hT⟩ := coprime_block_multiplier_transference n (goodK ρ) r hr hp1 hp2
  obtain ⟨Cρr, hCρr, hth⟩ := goodBlocks_eps_threshold hρ r hr
  exact ⟨C, hC, Cρr, hCρr, fun N hN ε hε hεN m B A hm hB hsupp hA f hf =>
    hT (goodBlocks ρ N) goodBlocks_one_lt goodBlocks_pairwise_coprime ε hε
      (hth N hN ε hε hεN) m B A hm hB hsupp hA f hf⟩

end GoodSetTransference

end RationalFrequency

section MinorArcs

/-!
## Minor parameter arcs and the choice of the exponent

Results from §8 ("Minor parameter arcs and the choice of the exponent") of
`blueprints/discrete-sw.tex`.

### Definitions

* `minorOp Ω d j λ f x = T_{j,λ} f(x) = ∑_y e(λ P(y)) K_j(y) f(x - y)` (`P = radialPolyZ n d`,
  `K_j = dyadicKernel Ω j`, `j ∈ ℕ`);
* `minorH M j = H_j = 2^{⌊M log₂(j+1)⌋}`, `minorW d M j = w_j = (j+1)^M 2^{-Dj}` (`D = 2d`);
* `minorArcs d M j = X_j`, the set of real `λ` with `‖λ - a/q‖_𝕋 ≤ w_j` for some reduced
  `0 ≤ a < q`, `1 ≤ q < H_j`.

### Main results

* `minor_arc_decay`: Blueprint Lemma 8.1 (`lem:minorL2`);
* `minor_arc_decay_uniform`: the same with `j₁, C` independent of `M ≥ M₀`;
* Blueprint Construction 8.2 (`con:parameters`): the parameters `p' = paramDual p`,
  `r = paramR p`, `a_p = paramA p`, `κ = paramKappa p`, `M = paramM n d Ω p`,
  `j₁ = paramJ1 n d Ω p`, `ρ = paramRho n d Ω p = 1/(16M)`, `𝒰_N = paramGoodSet n d Ω p N`, their
  properties (`two_le_paramR`, `lt_two_mul_paramR`, `paramDual_lt_two_mul_paramR`,
  `paramR_exponent_range`, `three_lt_paramKappa_mul_paramA`, `two_le_paramM`, `paramRho_pos`,
  `two_mul_paramRho_lt`, `param_minor_arc_decay`), and eq. (8.2) `minor_arc_decay_lp`, proved by
  Marcinkiewicz interpolation (`minorSup_lp_of_l2`) of the `ℓ²` decay with the uniform strong
  `(1,1)` and `(∞,∞)` bounds of `sup_λ |T_{j,λ} f| ≤ |K_j| * |f|`.

### Proof outline (deviations from the blueprint)

The proof follows the blueprint's `TT*` argument, with two simplifications:
* no localization to cubes: the `TT*` kernel `H(x, y)` of a linearization `x ↦ λ_x` is
  bounded by Schur's test (`minor_bilinear_schur`, fed into `band_eLpNorm_kernel_le_of_ttstar`),
  using row/column sums `∑_x |H(x, y)| ≤ C (ε + η)` instead of the Hilbert–Schmidt norm of a
  localized kernel (`minor_column_bound`);
* the slice of the phase is taken with `z = x + w`, so the degree-`(D-1)` coefficient in the first
  coordinate is directly `D (y₁ - x₁) λ_y` (`minorPhasePoly_coeff`), and the subtraction step
  giving (8.1) is unnecessary (`minor_bad_pair`, via Corollary 3.5
  `exists_slice_inverse_poly_sum_weighted`).
The counting step (`minor_card_lt_core`, `minor_card_lt`) is pigeonhole in `q`, Lemma 3.3
(`norm_mul_le_of_many_multiples_int`) and reduction of the resulting fraction
(`minor_mem_arcs_of_approx`). The maximal function is reduced to linearizations by Lemma 2.1
(`eLpNorm_iSup_le_of_finset_count`) and `eLpNorm_finset_sup_le_of_linearization_op`.
-/

open MeasureTheory Finset Polynomial
open scoped ENNReal NNReal ComplexConjugate

/-! ### Definitions -/

/-- The finite-kernel operator `T_{j,λ} f(x) = ∑_{y ∈ G} e(λ P(y)) K_j(y) f(x - y)` of blueprint
§8 (`P = radialPolyZ n d`, `K_j = dyadicKernel Ω j`; the sum has finitely many nonzero terms). -/
noncomputable def minorOp {n : ℕ} (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (d j : ℕ) (lam : ℝ)
    (f : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) : ℂ :=
  ∑' y : Fin n → ℤ, eC (lam * (radialPolyZ n d y : ℝ)) * dyadicKernel Ω j (latEmbed y) * f (x - y)

/-- The denominator bound `H_j = 2^{⌊M log₂(j+1)⌋}` of blueprint §8. -/
noncomputable def minorH (M j : ℕ) : ℕ := 2 ^ ⌊(M : ℝ) * Real.logb 2 ((j : ℝ) + 1)⌋₊

/-- The arc width `w_j = (j+1)^M 2^{-Dj}`, `D = 2d`, of blueprint §8. -/
noncomputable def minorW (d M j : ℕ) : ℝ := ((j : ℝ) + 1) ^ M / (2 : ℝ) ^ (2 * d * j)

/-- The major parameter arcs `X_j = ⋃_{1 ≤ q < H_j, 0 ≤ a < q, (a,q) = 1} {λ : ‖λ - a/q‖_𝕋 ≤ w_j}`
of blueprint §8, as a (`1`-periodic) set of real parameters. -/
def minorArcs (d M j : ℕ) : Set ℝ :=
  {lam | ∃ q a : ℕ, 1 ≤ q ∧ q < minorH M j ∧ a < q ∧ Nat.Coprime a q ∧
    ‖((lam - a / q : ℝ) : UnitAddCircle)‖ ≤ minorW d M j}

/-! ### Arithmetic of the major arcs -/

/-- `H_j ≥ (j+1)^M / 2`. -/
lemma minorH_ge (M j : ℕ) : ((j : ℝ) + 1) ^ M / 2 ≤ minorH M j := by
  set x : ℝ := (M : ℝ) * Real.logb 2 ((j : ℝ) + 1) with hx
  have hj : (0 : ℝ) < (j : ℝ) + 1 := by positivity
  have hx0 : 0 ≤ x := mul_nonneg (Nat.cast_nonneg _)
    (Real.logb_nonneg (by norm_num) (by linarith [(Nat.cast_nonneg j : (0 : ℝ) ≤ j)]))
  have h2x : (2 : ℝ) ^ x = ((j : ℝ) + 1) ^ M := by
    rw [hx, mul_comm, Real.rpow_mul (by norm_num), Real.rpow_logb (by norm_num) (by norm_num) hj,
      Real.rpow_natCast]
  have hfl : x - 1 < (⌊x⌋₊ : ℝ) := Nat.sub_one_lt_floor x
  rw [minorH, Nat.cast_pow, Nat.cast_ofNat, ← h2x, ← Real.rpow_natCast]
  calc (2 : ℝ) ^ x / 2 = (2 : ℝ) ^ (x - 1) := by
        rw [Real.rpow_sub (by norm_num), Real.rpow_one]
    _ ≤ (2 : ℝ) ^ (⌊x⌋₊ : ℝ) := Real.rpow_le_rpow_of_exponent_le (by norm_num) hfl.le

/-- A rational approximation `‖q' λ‖_𝕋 ≤ w_j` with `1 ≤ q' < H_j` puts `λ` into `X_j`
(reduce the fraction `round(q'λ)/q'` to lowest terms). -/
lemma minor_mem_arcs_of_approx {d M j q' : ℕ} {lam : ℝ} (hq' : 1 ≤ q') (hqH : q' < minorH M j)
    (happ : ‖((q' * lam : ℝ) : UnitAddCircle)‖ ≤ minorW d M j) : lam ∈ minorArcs d M j := by
  set a' : ℤ := round ((q' : ℝ) * lam) with ha'
  have hq'0 : (0 : ℤ) < q' := by exact_mod_cast hq'
  set g : ℕ := Int.gcd a' q' with hg
  have hg0 : 0 < g := Int.gcd_pos_of_ne_zero_right _ hq'0.ne'
  set q : ℤ := (q' : ℤ) / g
  set a₀ : ℤ := a' / g
  have hgq : (g : ℤ) ∣ q' := Int.gcd_dvd_right _ _
  have hga : (g : ℤ) ∣ a' := Int.gcd_dvd_left _ _
  have hq'eq : (q' : ℤ) = q * g := (Int.ediv_mul_cancel hgq).symm
  have ha'eq : a' = a₀ * g := (Int.ediv_mul_cancel hga).symm
  have hq0 : 0 < q := by
    rcases lt_trichotomy q 0 with h | h | h
    · nlinarith
    · rw [h, zero_mul] at hq'eq; omega
    · exact h
  have hcop : Int.gcd a₀ q = 1 := Int.gcd_div_gcd_div_gcd hg0
  set a : ℤ := a₀ % q with ha
  have ha0 : 0 ≤ a := Int.emod_nonneg _ hq0.ne'
  have haq : a < q := Int.emod_lt_of_pos _ hq0
  have hqq' : q ≤ q' := by
    rw [hq'eq]; exact le_mul_of_one_le_right hq0.le (by exact_mod_cast hg0)
  refine ⟨q.toNat, a.toNat, by omega, ?_, by omega, ?_, ?_⟩
  · have : (q.toNat : ℤ) ≤ q' := by omega
    exact lt_of_le_of_lt (by exact_mod_cast this) hqH
  · have h1 : Int.gcd a q = 1 := by rw [ha, Int.gcd_emod, hcop]
    rw [Nat.Coprime, ← h1, ← Int.gcd_natCast_natCast, Int.toNat_of_nonneg ha0,
      Int.toNat_of_nonneg hq0.le]
  · have hqR : (0 : ℝ) < q := by exact_mod_cast hq0
    have hcastq : ((q.toNat : ℕ) : ℝ) = (q : ℝ) := by exact_mod_cast Int.toNat_of_nonneg hq0.le
    have hcasta : ((a.toNat : ℕ) : ℝ) = (a : ℝ) := by exact_mod_cast Int.toNat_of_nonneg ha0
    rw [hcastq, hcasta]
    -- `a/q = a₀/q - ⌊a₀/q⌋` as integers
    have hdiv : (a₀ : ℝ) = q * ((a₀ / q : ℤ) : ℝ) + a := by
      have := Int.emod_add_mul_ediv a₀ q
      rw [← ha] at this
      have h' : (a₀ : ℝ) = ((a + q * (a₀ / q) : ℤ) : ℝ) := by rw [this]
      rw [h']; push_cast; ring
    have hshift : lam - (a : ℝ) / q = (lam - (a₀ : ℝ) / q) + ((a₀ / q : ℤ) : ℝ) := by
      rw [hdiv]; field_simp; ring
    rw [hshift, tnorm_add_intCast]
    refine le_trans ?_ happ
    rw [UnitAddCircle.norm_eq (x := (q' : ℝ) * lam), ← ha']
    have hq'R : (1 : ℝ) ≤ q' := by exact_mod_cast hq'
    have hkey : lam - (a₀ : ℝ) / q = ((q' : ℝ) * lam - a') / q' := by
      have hq'R' : (q' : ℝ) = q * g := by exact_mod_cast hq'eq
      have ha'R : (a' : ℝ) = a₀ * g := by exact_mod_cast ha'eq
      have hgR : (0 : ℝ) < g := by exact_mod_cast hg0
      rw [ha'R, hq'R']; field_simp
    refine (show ‖((lam - (a₀ : ℝ) / q : ℝ) : UnitAddCircle)‖ ≤ |lam - (a₀ : ℝ) / q| by
      rw [UnitAddCircle.norm_eq]; simpa using round_le (lam - (a₀ : ℝ) / q) 0).trans ?_
    rw [hkey, abs_div, abs_of_pos (by linarith : (0 : ℝ) < q')]
    exact div_le_self (abs_nonneg _) hq'R

/-- The counting step of Blueprint Lemma 8.1 (`lem:minorL2`), with explicit size conditions: let
`λ ∉ X_j`, `Q ≥ 1`, `0 < η ≤ 1`, and let `T` be a set of integers `h` with `|h| ≤ 4 · 2^j`, each
admitting some `1 ≤ q ≤ Q` with `‖q D h λ‖_𝕋 ≤ Q 2^{-j(D-1)}` (`D = 2d`). If
`640 Q² ≤ η 2^j`, `2400 Q² ≤ η² 2^j`, `160 d Q² < η (j+1)^M` and `2400 Q³ ≤ η² (j+1)^M`, then
`#T < η 2^j` (pigeonhole in `q`, then Lemma 3.3, then reduction of the fraction). -/
lemma minor_card_lt_core {d M j : ℕ} (hd : 1 ≤ d) {lam Q η : ℝ} (hlam : lam ∉ minorArcs d M j)
    (hQ : 1 ≤ Q) (hη : 0 < η) (hη1 : η ≤ 1)
    (hA : 640 * Q ^ 2 ≤ η * 2 ^ j) (hB : 2400 * Q ^ 2 ≤ η ^ 2 * 2 ^ j)
    (hC : 160 * d * Q ^ 2 < η * ((j : ℝ) + 1) ^ M)
    (hD : 2400 * Q ^ 3 ≤ η ^ 2 * ((j : ℝ) + 1) ^ M) (T : Finset ℤ)
    (hT : ∀ h ∈ T, |(h : ℝ)| ≤ 4 * 2 ^ j ∧ ∃ q : ℕ, 1 ≤ q ∧ (q : ℝ) ≤ Q ∧
      ‖((q * (2 * d) * h * lam : ℝ) : UnitAddCircle)‖ ≤ Q / ((2 : ℝ) ^ j) ^ (2 * d - 1)) :
    (#T : ℝ) < η * 2 ^ j := by
  by_contra hcon
  push Not at hcon
  have hQ0 : 0 < Q := by linarith
  have hR1 : (1 : ℝ) ≤ 2 ^ j := one_le_pow₀ (by norm_num)
  have hR0 : (0 : ℝ) < 2 ^ j := by positivity
  have hex : ∀ h, ∃ q : ℕ, h ∈ T → 1 ≤ q ∧ (q : ℝ) ≤ Q ∧
      ‖((q * (2 * d) * h * lam : ℝ) : UnitAddCircle)‖ ≤ Q / ((2 : ℝ) ^ j) ^ (2 * d - 1) := by
    intro h
    by_cases hh : h ∈ T
    · obtain ⟨q, hq⟩ := (hT h hh).2
      exact ⟨q, fun _ => hq⟩
    · exact ⟨0, fun h' => absurd h' hh⟩
  choose qf hqf using hex
  set t : Finset ℕ := Icc 1 ⌊Q⌋₊
  have hmaps : ∀ h ∈ T, qf h ∈ t := fun h hh => by
    obtain ⟨h1, h2, -⟩ := hqf h hh
    exact mem_Icc.2 ⟨h1, Nat.le_floor h2⟩
  have hfl1 : 1 ≤ ⌊Q⌋₊ := Nat.one_le_floor_iff _ |>.2 hQ
  have ht : t.Nonempty := ⟨1, mem_Icc.2 ⟨le_rfl, hfl1⟩⟩
  have hb : #t • (η * 2 ^ j / Q) ≤ (#T : ℝ) := by
    rw [nsmul_eq_mul, Nat.card_Icc, Nat.add_sub_cancel]
    calc (⌊Q⌋₊ : ℝ) * (η * 2 ^ j / Q) ≤ Q * (η * 2 ^ j / Q) :=
          mul_le_mul_of_nonneg_right (Nat.floor_le hQ0.le) (by positivity)
      _ = η * 2 ^ j := by field_simp
      _ ≤ #T := hcon
  obtain ⟨q, hqt, hfib⟩ := exists_le_card_fiber_of_nsmul_le_card_of_maps_to hmaps ht hb
  set H' : Finset ℤ := {h ∈ T | qf h = q}
  have hq1 : 1 ≤ q := (mem_Icc.1 hqt).1
  have hqQ : (q : ℝ) ≤ Q := by
    have := (mem_Icc.1 hqt).2
    exact (Nat.cast_le.2 this).trans (Nat.floor_le hQ0.le)
  set α : ℝ := q * (2 * d) * lam
  set E : ℝ := Q / ((2 : ℝ) ^ j) ^ (2 * d - 1)
  have hpowle : (2 : ℝ) ^ j ≤ ((2 : ℝ) ^ j) ^ (2 * d - 1) := le_self_pow₀ hR1 (by omega)
  have hE : E ≤ η / Q / (128 * (4 + 1)) := by
    calc E ≤ Q / 2 ^ j := div_le_div_of_nonneg_left hQ0.le hR0 hpowle
      _ ≤ η / Q / (128 * (4 + 1)) := by
        rw [div_div, div_le_div_iff₀ hR0 (by positivity)]; nlinarith
  have hN : 384 * (4 + 1) ^ 2 / (4 * (η / Q) ^ 2) ≤ ((2 ^ j : ℕ) : ℝ) := by
    rw [Nat.cast_pow, Nat.cast_ofNat, div_le_iff₀ (by positivity)]
    have : 2 ^ j * (4 * (η / Q) ^ 2) = 4 * (η ^ 2 * 2 ^ j) / Q ^ 2 := by field_simp
    rw [this, le_div_iff₀ (by positivity)]; nlinarith
  have hH : ∀ h ∈ H', |(h : ℝ)| ≤ 4 * ((2 ^ j : ℕ) : ℝ) := fun h hh => by
    rw [Nat.cast_pow, Nat.cast_ofNat]; exact (hT h (mem_filter.1 hh).1).1
  have hcard : η / Q * ((2 ^ j : ℕ) : ℝ) ≤ #H' := by
    rw [Nat.cast_pow, Nat.cast_ofNat]
    refine le_trans (le_of_eq ?_) hfib
    ring
  have hHE : ∀ h ∈ H', ‖((h * α : ℝ) : UnitAddCircle)‖ ≤ E := fun h hh => by
    obtain ⟨hhT, hhq⟩ := mem_filter.1 hh
    have := (hqf h hhT).2.2
    rw [hhq] at this
    convert this using 3
    simp only [α]; ring
  obtain ⟨r, hr1, hr2, hr3⟩ := norm_mul_le_of_many_multiples_int (by norm_num : (0 : ℝ) < 4)
    (div_pos hη hQ0) (div_le_one_of_le₀ (hη1.trans hQ) hQ0.le) (by positivity) hE hN hH hcard hHE
  set q' : ℕ := r * q * (2 * d)
  have hq'1 : 1 ≤ q' := by
    have : 1 ≤ r * q := Nat.one_le_iff_ne_zero.2 (by positivity)
    exact le_trans this (Nat.le_mul_of_pos_right _ (by omega))
  apply hlam
  refine minor_mem_arcs_of_approx (q' := q') hq'1 ?_ ?_
  · -- `q' < H_j`
    have hr2' : (r : ℝ) ≤ 40 * Q / η := by
      refine hr2.trans (le_of_eq ?_); field_simp; ring
    have hq'R : (q' : ℝ) ≤ 80 * d * Q ^ 2 / η := by
      simp only [q']; push_cast
      calc (r : ℝ) * q * (2 * d) ≤ (40 * Q / η) * Q * (2 * d) := by gcongr
        _ = 80 * d * Q ^ 2 / η := by ring
    have hlt : 80 * d * Q ^ 2 / η < ((j : ℝ) + 1) ^ M / 2 := by
      rw [div_lt_div_iff₀ hη (by norm_num)]; linarith
    exact_mod_cast (lt_of_le_of_lt hq'R (lt_of_lt_of_le hlt (minorH_ge M j)))
  · -- `‖q' λ‖ ≤ w_j`
    have heq : ((q' : ℕ) : ℝ) * lam = r * α := by simp only [q', α]; push_cast; ring
    rw [heq]
    refine hr3.trans ?_
    have hpow : ((2 : ℝ) ^ j) ^ (2 * d - 1) * 2 ^ j = (2 : ℝ) ^ (2 * d * j) := by
      rw [← pow_succ, Nat.sub_add_cancel (by omega), ← pow_mul, mul_comm]
    rw [minorW, Nat.cast_pow, Nat.cast_ofNat]
    have hR' : (0 : ℝ) < (2 : ℝ) ^ (2 * d * j) := by positivity
    have : 384 * (4 + 1) ^ 2 / 4 * E / ((η / Q) ^ 2 * 2 ^ j) =
        2400 * Q ^ 3 / (η ^ 2 * (2 : ℝ) ^ (2 * d * j)) := by
      simp only [E]; rw [← hpow]; field_simp; ring
    rw [this, div_le_div_iff₀ (by positivity) hR']
    nlinarith

/-- `c j^K ≤ 2^j` for all large `j`. -/
lemma minor_eventually_pow_le_two_pow (c : ℝ) (K : ℕ) :
    ∃ j₀ : ℕ, ∀ j ≥ j₀, c * (j : ℝ) ^ K ≤ 2 ^ j := by
  have ht := tendsto_pow_const_div_const_pow_of_one_lt K (r := 2) one_lt_two
  have hc : (0 : ℝ) < 1 / (|c| + 1) := by positivity
  obtain ⟨j₀, hj₀⟩ := Filter.eventually_atTop.1 (ht.eventually (gt_mem_nhds hc))
  refine ⟨j₀, fun j hj => ?_⟩
  have h := hj₀ j hj
  have h2 : (0 : ℝ) < 2 ^ j := by positivity
  rw [div_lt_div_iff₀ h2 (by positivity), one_mul] at h
  have h3 : c * (j : ℝ) ^ K ≤ |c| * (j : ℝ) ^ K :=
    mul_le_mul_of_nonneg_right (le_abs_self c) (by positivity)
  nlinarith [pow_nonneg (Nat.cast_nonneg j : (0 : ℝ) ≤ j) K, abs_nonneg c]

/-- The counting step of Blueprint Lemma 8.1 (`lem:minorL2`) with `Q = C_W j^B` and
`η = j^{-V}`: there are `M₀, j₁` such that for all `M ≥ M₀`, `j ≥ j₁` and `λ ∉ X_j`, a set `T`
of integers `|h| ≤ 4 · 2^j`, each with some `1 ≤ q ≤ C_W j^B` and
`‖q D h λ‖_𝕋 ≤ C_W j^B 2^{-j(D-1)}`, has fewer than `j^{-V} 2^j` elements. -/
lemma minor_card_lt {d : ℕ} (hd : 1 ≤ d) {Cw : ℝ} (hCw : 1 ≤ Cw) (B V : ℕ) :
    ∃ M₀ j₁ : ℕ, 1 ≤ M₀ ∧ 1 ≤ j₁ ∧ ∀ M ≥ M₀, ∀ j ≥ j₁, ∀ lam ∉ minorArcs d M j,
      ∀ T : Finset ℤ, (∀ h ∈ T, |(h : ℝ)| ≤ 4 * 2 ^ j ∧ ∃ q : ℕ, 1 ≤ q ∧
        (q : ℝ) ≤ Cw * (j : ℝ) ^ B ∧
        ‖((q * (2 * d) * h * lam : ℝ) : UnitAddCircle)‖ ≤
          Cw * (j : ℝ) ^ B / ((2 : ℝ) ^ j) ^ (2 * d - 1)) →
      (#T : ℝ) < 1 / (j : ℝ) ^ V * 2 ^ j := by
  set K := 3 * B + 2 * V
  set c : ℝ := 2400 * d * Cw ^ 3
  have hd' : (1 : ℝ) ≤ d := by exact_mod_cast hd
  have hc1 : 1 ≤ c := by
    have : 1 ≤ Cw ^ 3 := one_le_pow₀ hCw
    simp only [c]; nlinarith
  obtain ⟨j₀, hj₀⟩ := minor_eventually_pow_le_two_pow c K
  refine ⟨K + 1, max (max j₀ 1) ⌈c⌉₊, by omega, by omega, fun M hM j hj lam hlam T hT => ?_⟩
  have hj1 : 1 ≤ j := le_trans (le_max_right _ _) (le_trans (le_max_left _ _) hj)
  have hjc : c ≤ j := (Nat.le_ceil c).trans (by exact_mod_cast le_trans (le_max_right _ _) hj)
  have hJ : (1 : ℝ) ≤ j := by exact_mod_cast hj1
  have hJ0 : (0 : ℝ) < j := by linarith
  have h2j := hj₀ j (le_trans (le_max_left _ _) (le_trans (le_max_left _ _) hj))
  have hJV : (0 : ℝ) < (j : ℝ) ^ V := by positivity
  have hpowK : ∀ e ≤ K, (j : ℝ) ^ e ≤ (j : ℝ) ^ K := fun e he => pow_le_pow_right₀ hJ he
  have hMpow : c * (j : ℝ) ^ K < ((j : ℝ) + 1) ^ M := by
    calc c * (j : ℝ) ^ K ≤ (j : ℝ) * (j : ℝ) ^ K := by gcongr
      _ = (j : ℝ) ^ (K + 1) := by ring
      _ < ((j : ℝ) + 1) ^ (K + 1) := by gcongr; linarith
      _ ≤ ((j : ℝ) + 1) ^ M := pow_le_pow_right₀ (by linarith) hM
  have hCw3 : Cw ^ 2 ≤ Cw ^ 3 := pow_le_pow_right₀ hCw (by norm_num)
  have hCw2 : 1 ≤ Cw ^ 2 := one_le_pow₀ hCw
  have hQ : 1 ≤ Cw * (j : ℝ) ^ B := one_le_mul_of_one_le_of_one_le hCw (one_le_pow₀ hJ)
  refine minor_card_lt_core hd hlam hQ (by positivity) ?_ ?_ ?_ ?_ ?_ T hT
  · rw [div_le_one hJV]; exact one_le_pow₀ hJ
  · rw [one_div_mul_eq_div, le_div_iff₀ hJV]
    calc 640 * (Cw * (j : ℝ) ^ B) ^ 2 * (j : ℝ) ^ V = 640 * Cw ^ 2 * (j : ℝ) ^ (2 * B + V) := by
          ring
      _ ≤ c * (j : ℝ) ^ K := by
          gcongr
          · simp only [c]; nlinarith
          · omega
      _ ≤ 2 ^ j := h2j
  · rw [div_pow, one_pow, one_div_mul_eq_div, le_div_iff₀ (by positivity)]
    calc 2400 * (Cw * (j : ℝ) ^ B) ^ 2 * ((j : ℝ) ^ V) ^ 2 =
          2400 * Cw ^ 2 * (j : ℝ) ^ (2 * B + 2 * V) := by ring
      _ ≤ c * (j : ℝ) ^ K := by
          gcongr
          · simp only [c]; nlinarith
          · omega
      _ ≤ 2 ^ j := h2j
  · rw [one_div_mul_eq_div, lt_div_iff₀ hJV]
    calc 160 * d * (Cw * (j : ℝ) ^ B) ^ 2 * (j : ℝ) ^ V =
        160 * d * Cw ^ 2 * (j : ℝ) ^ (2 * B + V) := by
          ring
      _ ≤ c * (j : ℝ) ^ K := by
          gcongr
          · simp only [c]; nlinarith
          · omega
      _ < _ := hMpow
  · rw [div_pow, one_pow, one_div_mul_eq_div, le_div_iff₀ (by positivity)]
    calc 2400 * (Cw * (j : ℝ) ^ B) ^ 3 * ((j : ℝ) ^ V) ^ 2 =
          2400 * Cw ^ 3 * (j : ℝ) ^ (3 * B + 2 * V) := by ring
      _ ≤ c * (j : ℝ) ^ K := by
          gcongr
          simp only [c]; nlinarith
      _ ≤ _ := hMpow.le

/-! ### Kernel facts -/

variable {n : ℕ} {Ω : EuclideanSpace ℝ (Fin n) → ℂ}

/-- The integer box `[-r, r]ⁿ`. -/
def minorBox (n : ℕ) (r : ℤ) : Finset (Fin n → ℤ) := Fintype.piFinset fun _ => Icc (-r) r

lemma mem_minorBox {r : ℤ} {z : Fin n → ℤ} : z ∈ minorBox n r ↔ ∀ i, |z i| ≤ r := by
  simp [minorBox, abs_le]

lemma card_minorBox {r : ℤ} (hr : 0 ≤ r) : (#(minorBox n r) : ℝ) = (2 * r + 1 : ℝ) ^ n := by
  simp only [minorBox, Fintype.card_piFinset, Int.card_Icc, prod_const, card_univ,
    Fintype.card_fin]
  have : (r + 1 - -r).toNat = ((2 * r + 1 : ℤ)).toNat := by congr 1; ring
  rw [this]
  have h2 : (((2 * r + 1 : ℤ)).toNat : ℝ) = ((2 * r + 1 : ℤ) : ℝ) := by
    exact_mod_cast Int.toNat_of_nonneg (by omega)
  rw [Nat.cast_pow, h2]; push_cast; ring

/-- `2^{-j(n+k)}` as `1 / (2^j)^{n+k}`. -/
lemma minor_two_zpow (j n : ℕ) :
    (2 : ℝ) ^ (-(j : ℤ) * (n : ℤ)) = 1 / ((2 : ℝ) ^ j) ^ n := by
  rw [← pow_mul, one_div, ← zpow_natCast, ← zpow_neg]; congr 1; push_cast; ring

/-- Size and Lipschitz bounds for `K_j`, `j ∈ ℕ`: `|K_j| ≤ C₀ 2^{-jn}` and
`|K_j(a) - K_j(b)| ≤ C₁ 2^{-j(n+1)} |a - b|`. -/
lemma minor_kernel_bounds (hΩ : IsSWProfile Ω) :
    ∃ C₀ C₁ : ℝ, 0 ≤ C₀ ∧ 0 ≤ C₁ ∧ ∀ j : ℕ,
      (∀ a, ‖dyadicKernel Ω j a‖ ≤ C₀ / ((2 : ℝ) ^ j) ^ n) ∧
      (∀ a b, ‖dyadicKernel Ω j a - dyadicKernel Ω j b‖ ≤
        C₁ / ((2 : ℝ) ^ j) ^ (n + 1) * ‖a - b‖) := by
  obtain ⟨C₀, hC₀, h0⟩ := norm_dyadicKernel_le hΩ
  obtain ⟨C₁, h1⟩ := norm_iteratedFDeriv_dyadicKernel_le hΩ 1
  have hC₁ : 0 ≤ C₁ := by
    have h := (norm_nonneg _).trans (h1 0 0)
    exact nonneg_of_mul_nonneg_left h (by positivity)
  refine ⟨C₀, C₁, hC₀, hC₁, fun j => ⟨fun a => ?_, fun a b => ?_⟩⟩
  · have := h0 j a
    rwa [minor_two_zpow, mul_one_div] at this
  · have hd := (contDiff_dyadicKernel hΩ (j : ℤ)).differentiable (by simp)
    have hb : ∀ x ∈ (Set.univ : Set (EuclideanSpace ℝ (Fin n))),
        ‖fderiv ℝ (dyadicKernel Ω j) x‖ ≤ C₁ / ((2 : ℝ) ^ j) ^ (n + 1) := by
      intro x _
      have := h1 j x
      rw [norm_iteratedFDeriv_one] at this
      rw [show ((n : ℤ) + ((1 : ℕ) : ℤ)) = ((n + 1 : ℕ) : ℤ) by push_cast; ring,
        minor_two_zpow, mul_one_div] at this
      exact this
    exact convex_univ.norm_image_sub_le_of_norm_fderiv_le (fun x _ => hd x) hb trivial trivial

/-- `K_j(y) = 0` on the lattice unless `y ∈ [-2^{j+1}, 2^{j+1}]ⁿ`. -/
lemma minor_kernel_eq_zero (j : ℕ) {y : Fin n → ℤ} (hy : y ∉ minorBox n (2 * 2 ^ j)) :
    dyadicKernel Ω j (latEmbed y) = 0 := by
  rw [mem_minorBox] at hy
  push Not at hy
  obtain ⟨i, hi⟩ := hy
  apply dyadicKernel_eq_zero_of_le
  calc (2 : ℝ) ^ ((j : ℤ) + 1) = ((2 * 2 ^ j : ℤ) : ℝ) := by
        rw [zpow_add_one₀ two_ne_zero, zpow_natCast]; push_cast; ring
    _ ≤ |(y i : ℝ)| := by exact_mod_cast hi.le
    _ = ‖latEmbed y i‖ := by simp
    _ ≤ ‖latEmbed y‖ := PiLp.norm_apply_le _ _

/-! ### The `TT*` kernel -/

/-- The `TT*` kernel of blueprint Lemma 8.1 (`lem:minorL2`), recentred at the first point:
`H(x, y) = ∑_w e(λ_x P(-w) - λ_y P(h - w)) K_j(-w) conj K_j(h - w)` with `h = y - x`, `w = z - x`
running over the box `[-2^{j+1}, 2^{j+1}]ⁿ` which contains all nonzero terms. -/
noncomputable def minorTT (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (d j : ℕ) (lx ly : ℝ)
    (h : Fin n → ℤ) : ℂ :=
  ∑ w ∈ minorBox n (2 * 2 ^ j),
    eC (lx * (radialPolyZ n d (-w) : ℝ) - ly * (radialPolyZ n d (h - w) : ℝ)) *
      dyadicKernel Ω j (latEmbed (-w)) * conj (dyadicKernel Ω j (latEmbed (h - w)))

/-- `e(a) conj(e(b)) = e(a - b)`. -/
lemma minor_eC_mul_conj (a b : ℝ) : eC a * conj (eC b) = eC (a - b) := by
  rw [conj_eC, ← eC_add, sub_eq_add_neg]

/-- Splitting a box sum over `Fin (m+1) → ℤ` into the first coordinate and the others. -/
lemma minorBox_sum_succ {m : ℕ} (r : ℤ) (F : (Fin (m + 1) → ℤ) → ℂ) :
    ∑ w ∈ minorBox (m + 1) r, F w = ∑ s ∈ minorBox m r, ∑ t ∈ Icc (-r) r, F (Fin.cons t s) := by
  rw [← Finset.sum_product_right' (s := Icc (-r) r) (t := minorBox m r)
    (f := fun t s => F (Fin.cons t s))]
  refine Finset.sum_nbij' (fun w => (w 0, Fin.tail w)) (fun p => Fin.cons p.1 p.2) ?_ ?_ ?_ ?_ ?_
  · intro w hw
    rw [mem_minorBox] at hw
    simp only [mem_product, mem_Icc, mem_minorBox, Fin.tail]
    exact ⟨abs_le.1 (hw 0), fun i => hw _⟩
  · intro p hp
    simp only [mem_product, mem_Icc, mem_minorBox] at hp ⊢
    intro i
    refine Fin.cases ?_ (fun k => ?_) i
    · simpa using abs_le.2 hp.1
    · simpa using hp.2 k
  · intro w _; simp
  · intro p _; simp
  · intro w _; simp

variable {d : ℕ}

/-- The elementary bound `|H| ≤ 5ⁿ C₀² 2^{-jn}`. -/
lemma norm_minorTT_le {C₀ : ℝ} (hC₀ : 0 ≤ C₀) {j : ℕ}
    (hK : ∀ a, ‖dyadicKernel Ω j a‖ ≤ C₀ / ((2 : ℝ) ^ j) ^ n) (lx ly : ℝ) (h : Fin n → ℤ) :
    ‖minorTT Ω d j lx ly h‖ ≤ 5 ^ n * C₀ ^ 2 / ((2 : ℝ) ^ j) ^ n := by
  have hR : (0 : ℝ) < (2 : ℝ) ^ j := by positivity
  have hR1 : (1 : ℝ) ≤ (2 : ℝ) ^ j := one_le_pow₀ (by norm_num)
  refine (norm_sum_le _ _).trans ?_
  have hterm : ∀ w ∈ minorBox n (2 * 2 ^ j),
      ‖eC (lx * (radialPolyZ n d (-w) : ℝ) - ly * (radialPolyZ n d (h - w) : ℝ)) *
        dyadicKernel Ω j (latEmbed (-w)) * conj (dyadicKernel Ω j (latEmbed (h - w)))‖ ≤
        (C₀ / ((2 : ℝ) ^ j) ^ n) ^ 2 := by
    intro w _
    rw [norm_mul, norm_mul, norm_eC, one_mul, RCLike.norm_conj, sq]
    exact mul_le_mul (hK _) (hK _) (norm_nonneg _) (by positivity)
  refine (sum_le_sum hterm).trans ?_
  rw [sum_const, nsmul_eq_mul, card_minorBox (by positivity)]
  push_cast
  have h5 : (2 * (2 * (2 : ℝ) ^ j) + 1) ^ n ≤ (5 * (2 : ℝ) ^ j) ^ n := by
    gcongr; linarith
  calc (2 * (2 * (2 : ℝ) ^ j) + 1) ^ n * (C₀ / ((2 : ℝ) ^ j) ^ n) ^ 2
      ≤ (5 * (2 : ℝ) ^ j) ^ n * (C₀ / ((2 : ℝ) ^ j) ^ n) ^ 2 := by gcongr
    _ = 5 ^ n * C₀ ^ 2 / ((2 : ℝ) ^ j) ^ n := by
        rw [mul_pow]; field_simp

/-- `H(x, y) = 0` unless `y - x ∈ [-2^{j+2}, 2^{j+2}]ⁿ`. -/
lemma minorTT_eq_zero {j : ℕ} (lx ly : ℝ) {h : Fin n → ℤ} (hh : h ∉ minorBox n (4 * 2 ^ j)) :
    minorTT Ω d j lx ly h = 0 := by
  refine sum_eq_zero fun w hw => ?_
  rw [mem_minorBox] at hw hh
  push Not at hh
  obtain ⟨i, hi⟩ := hh
  have : h - w ∉ minorBox n (2 * 2 ^ j) := by
    rw [mem_minorBox]; push Not
    refine ⟨i, ?_⟩
    have := hw i
    simp only [Pi.sub_apply]
    rw [abs_le] at this
    rcases le_or_gt 0 (h i) with h0 | h0
    · rw [abs_of_nonneg h0] at hi
      rw [lt_abs]; left; linarith
    · rw [abs_of_neg h0] at hi
      rw [lt_abs]; right; linarith
  rw [minor_kernel_eq_zero j this, map_zero, mul_zero]

/-! ### Bad pairs: the inverse theorem -/

/-- A unit step in the first coordinate has Euclidean length one. -/
lemma norm_latEmbed_sub_cons_succ {m : ℕ} (c : Fin (m + 1) → ℤ) (t : ℤ) (s : Fin m → ℤ) :
    ‖latEmbed (c - Fin.cons (t + 1) s) - latEmbed (c - Fin.cons t s)‖ = 1 := by
  rw [EuclideanSpace.norm_eq, Fin.sum_univ_succ]
  simp only [PiLp.sub_apply, latEmbed_apply, Pi.sub_apply, Fin.cons_zero, Fin.cons_succ,
    Real.norm_eq_abs, sq_abs]
  push_cast
  simp

/-- Variation of a product of two kernel values under unit steps. -/
lemma minor_prod_step {E : Type*} [NormedAddCommGroup E] {k : E → ℂ} {C₀ C₁ : ℝ}
    (hk : ∀ a, ‖k a‖ ≤ C₀) (hkl : ∀ a b, ‖k a - k b‖ ≤ C₁ * ‖a - b‖) {a₀ a₁ b₀ b₁ : E}
    (ha : ‖a₁ - a₀‖ = 1) (hb : ‖b₁ - b₀‖ = 1) :
    ‖k a₁ * conj (k b₁) - k a₀ * conj (k b₀)‖ ≤ 2 * C₀ * C₁ := by
  have hC₀ : 0 ≤ C₀ := (norm_nonneg _).trans (hk a₀)
  have e : k a₁ * conj (k b₁) - k a₀ * conj (k b₀) =
      (k a₁ - k a₀) * conj (k b₁) + k a₀ * conj (k b₁ - k b₀) := by
    rw [map_sub]; ring
  rw [e]
  refine (norm_add_le _ _).trans ?_
  rw [norm_mul, norm_mul, RCLike.norm_conj, RCLike.norm_conj]
  have h1 := hkl a₁ a₀
  have h2 := hkl b₁ b₀
  rw [ha, mul_one] at h1
  rw [hb, mul_one] at h2
  have := mul_le_mul h1 (hk b₁) (norm_nonneg _) ((norm_nonneg _).trans h1)
  have := mul_le_mul (hk a₀) h2 (norm_nonneg _) hC₀
  linarith

/-- The phase of the `TT*` kernel as a polynomial in the first coordinate `t` (Blueprint Lemma 3.1):
`λ_x P(-w) - λ_y P(h - w)` for `w = (t, s)`. -/
noncomputable def minorPhasePoly {m : ℕ} (d : ℕ) (lx ly : ℝ) (h : Fin (m + 1) → ℤ)
    (s : Fin m → ℤ) : ℝ[X] :=
  C lx * sliceRadialPoly (m + 1) d 0 (fun l => ((Fin.cons 0 s : Fin (m + 1) → ℤ) l : ℝ))
      (-(0 : Fin (m + 1) → ℝ)) -
    C ly * sliceRadialPoly (m + 1) d 0 (fun l => ((Fin.cons 0 s : Fin (m + 1) → ℤ) l : ℝ))
      (-(fun l => (h l : ℝ)))

lemma minorPhasePoly_natDegree_le {m : ℕ} (d : ℕ) (lx ly : ℝ) (h : Fin (m + 1) → ℤ)
    (s : Fin m → ℤ) : (minorPhasePoly d lx ly h s).natDegree ≤ 2 * d := by
  refine (natDegree_sub_le _ _).trans (max_le ?_ ?_) <;>
    exact (natDegree_C_mul_le _ _).trans (sliceRadialPoly_natDegree_le _ _ _ _ _)

lemma minorPhasePoly_eval {m : ℕ} (d : ℕ) (lx ly : ℝ) (h : Fin (m + 1) → ℤ)
    (s : Fin m → ℤ) (t : ℤ) :
    ∑ k ∈ range (2 * d + 1), (minorPhasePoly d lx ly h s).coeff k * (t : ℝ) ^ k =
      lx * (radialPolyZ (m + 1) d (-Fin.cons t s) : ℝ) -
        ly * (radialPolyZ (m + 1) d (h - Fin.cons t s) : ℝ) := by
  rw [← eval_eq_sum_range' (Nat.lt_succ_of_le (minorPhasePoly_natDegree_le d lx ly h s)),
    minorPhasePoly, sliceRadialPoly_sub_eval]
  have hu : Function.update (fun l => ((Fin.cons 0 s : Fin (m + 1) → ℤ) l : ℝ)) 0 (t : ℝ) =
      fun l => ((Fin.cons t s : Fin (m + 1) → ℤ) l : ℝ) := by
    funext l
    refine Fin.cases ?_ (fun k => ?_) l
    · simp
    · rw [Function.update_of_ne (Fin.succ_ne_zero k)]; simp
  rw [hu]
  simp only [radialPolyZ, Pi.sub_apply, Pi.neg_apply, Pi.zero_apply, sub_zero]
  push_cast
  congr 3
  · refine sum_congr rfl fun l _ => by ring
  · refine sum_congr rfl fun l _ => by ring

lemma minorPhasePoly_coeff {m : ℕ} {d : ℕ} (hd : 1 ≤ d) (lx ly : ℝ) (h : Fin (m + 1) → ℤ)
    (s : Fin m → ℤ) : (minorPhasePoly d lx ly h s).coeff (2 * d - 1) = 2 * d * ly * h 0 := by
  rw [minorPhasePoly, sliceRadialPoly_sub_coeff_top_sub_one (m + 1) (by omega)]
  simp only [Pi.zero_apply]
  ring

/-- **Bad pairs** (the inverse step of Blueprint Lemma 8.1 (`lem:minorL2`), via Corollary 3.5 and
Lemma 3.1): there are `C_W ≥ 1` and `e > 0` such that if `0 < ε ≤ 1` and
`|H(x, y)| > ε 2^{-jn}` (with `h = y - x`), then some integer `1 ≤ q ≤ C_W ε^{-e}` satisfies
`‖q D h₁ λ_y‖_𝕋 ≤ C_W ε^{-e} 2^{-j(D-1)}`, `D = 2d` (the degree-`(D-1)` coefficient of the
phase in the first coordinate is `D h₁ λ_y`). -/
lemma minor_bad_pair {m d : ℕ} {Ω : EuclideanSpace ℝ (Fin (m + 1)) → ℂ} (hΩ : IsSWProfile Ω)
    (hd : 1 ≤ d) :
    ∃ Cw e : ℝ, 1 ≤ Cw ∧ 0 < e ∧ ∀ (j : ℕ) (lx ly : ℝ) (h : Fin (m + 1) → ℤ) (ε : ℝ),
      0 < ε → ε ≤ 1 → ε / ((2 : ℝ) ^ j) ^ (m + 1) < ‖minorTT Ω d j lx ly h‖ →
      ∃ q : ℕ, 1 ≤ q ∧ (q : ℝ) ≤ Cw * ε ^ (-e) ∧
        ‖((q * (2 * d) * (h 0 : ℝ) * ly : ℝ) : UnitAddCircle)‖ ≤
          Cw * ε ^ (-e) / ((2 : ℝ) ^ j) ^ (2 * d - 1) := by
  obtain ⟨C₀, C₁, hC₀, hC₁, hK⟩ := minor_kernel_bounds (n := m + 1) hΩ
  set A : ℝ := max (max (C₀ ^ 2) (8 * C₀ * C₁)) 2 with hA
  have hA2 : 2 ≤ A := le_max_right _ _
  have hA0 : 0 < A := by linarith
  have h5 : (1 : ℝ) ≤ 5 ^ m := one_le_pow₀ (by norm_num)
  obtain ⟨C, hC1, hCor⟩ := exists_slice_inverse_poly_sum_weighted (2 * d) 2
  refine ⟨C * (A * 5 ^ m) ^ C, C, one_le_mul_of_one_le_of_one_le hC1
    (Real.one_le_rpow (by nlinarith) (by linarith)), by linarith,
    fun j lx ly h ε hε hε1 hbad => ?_⟩
  set R : ℝ := (2 : ℝ) ^ j with hR
  have hR0 : 0 < R := by positivity
  have hR1 : 1 ≤ R := one_le_pow₀ (by norm_num)
  set r : ℤ := 2 * 2 ^ j with hr
  have hrR : (r : ℝ) = 2 * R := by simp [r, hR]
  have hr0 : 0 ≤ r := by positivity
  have hNR : (((2 ^ j : ℕ) : ℝ)) = R := by simp [hR]
  set S := minorBox m r
  set a : (Fin m → ℤ) → ℕ → ℝ := fun s k => (minorPhasePoly d lx ly h s).coeff k
  set w : (Fin m → ℤ) → ℤ → ℂ := fun s t => ((R ^ (2 * (m + 1)) : ℝ) : ℂ) *
    (dyadicKernel Ω j (latEmbed (-Fin.cons t s)) *
      conj (dyadicKernel Ω j (latEmbed (h - Fin.cons t s))))
  set δ : ℝ := ε / (A * 5 ^ m)
  have hδ : 0 < δ := by positivity
  have hδ2 : δ ≤ 1 / 2 := by
    rw [div_le_div_iff₀ (by positivity) (by norm_num)]; nlinarith
  -- the sum identity
  have hid : ∑ s ∈ S, ∑ t ∈ Icc (-r) r,
      w s t * eC (∑ k ∈ range (2 * d + 1), a s k * (t : ℝ) ^ k) =
      ((R ^ (2 * (m + 1)) : ℝ) : ℂ) * minorTT Ω d j lx ly h := by
    rw [minorTT, minorBox_sum_succ, mul_sum]
    refine sum_congr rfl fun s _ => ?_
    rw [mul_sum]
    refine sum_congr rfl fun t _ => ?_
    simp only [w, a, minorPhasePoly_eval]
    ring
  have hKb := (hK j).1
  have hKl := (hK j).2
  have hRn : R ^ (2 * (m + 1)) * (C₀ / R ^ (m + 1)) ^ 2 = C₀ ^ 2 := by
    field_simp; ring
  have hS0 : (0 : Fin m → ℤ) ∈ S := by rw [mem_minorBox]; intro i; simpa using hr0
  have hT0 : -(2 * ((2 ^ j : ℕ) : ℝ)) ≤ ((-r : ℤ) : ℝ) := by rw [hNR]; push_cast; rw [hrR]
  have hT1 : ((r : ℤ) : ℝ) ≤ 2 * ((2 ^ j : ℕ) : ℝ) := by rw [hNR, hrR]
  have hw : ∀ s ∈ S, ∀ t ∈ Icc (-r) r, ‖w s t‖ ≤ A := by
    intro s _ t _
    simp only [w]
    rw [norm_mul, norm_mul, RCLike.norm_conj, Complex.norm_real,
      Real.norm_of_nonneg (by positivity)]
    calc R ^ (2 * (m + 1)) * (‖dyadicKernel Ω j (latEmbed (-Fin.cons t s))‖ *
          ‖dyadicKernel Ω j (latEmbed (h - Fin.cons t s))‖)
        ≤ R ^ (2 * (m + 1)) * ((C₀ / R ^ (m + 1)) * (C₀ / R ^ (m + 1))) := by
          gcongr
          · exact hKb _
          · exact hKb _
      _ = C₀ ^ 2 := by rw [← sq, hRn]
      _ ≤ A := (le_max_left _ _).trans (le_max_left _ _)
  have hwv : ∀ s ∈ S, ∑ t ∈ Ico (-r) r, ‖w s (t + 1) - w s t‖ ≤ A := by
    intro s _
    have hstep : ∀ t : ℤ, ‖w s (t + 1) - w s t‖ ≤ 2 * C₀ * C₁ / R := by
      intro t
      simp only [w]
      rw [← mul_sub, norm_mul, Complex.norm_real, Real.norm_of_nonneg (by positivity)]
      have ha : ‖latEmbed (-Fin.cons (t + 1) s) - latEmbed (-Fin.cons t s)‖ = 1 := by
        simpa using norm_latEmbed_sub_cons_succ 0 t s
      have hb := norm_latEmbed_sub_cons_succ h t s
      have := minor_prod_step (k := dyadicKernel Ω j) hKb hKl ha hb
      calc R ^ (2 * (m + 1)) * ‖_‖ ≤ R ^ (2 * (m + 1)) *
            (2 * (C₀ / R ^ (m + 1)) * (C₁ / R ^ (m + 1 + 1))) := by gcongr
        _ = 2 * C₀ * C₁ / R := by field_simp; ring
    calc ∑ t ∈ Ico (-r) r, ‖w s (t + 1) - w s t‖ ≤ ∑ _t ∈ Ico (-r) r, 2 * C₀ * C₁ / R :=
          sum_le_sum fun t _ => hstep t
      _ = 4 * R * (2 * C₀ * C₁ / R) := by
          rw [sum_const, Int.card_Ico, nsmul_eq_mul]
          have : ((r - -r).toNat : ℝ) = 4 * R := by
            have h' : ((r - -r).toNat : ℤ) = 2 * r := by omega
            have : (((r - -r).toNat : ℤ) : ℝ) = ((2 * r : ℤ) : ℝ) := by rw [h']
            push_cast at this; rw [this, hrR]; ring
          rw [this]
      _ = 8 * C₀ * C₁ := by field_simp; ring
      _ ≤ A := (le_max_right _ _).trans (le_max_left _ _)
  have hsum : δ * A * ((2 ^ j : ℕ) : ℝ) * #S ≤ ‖∑ s ∈ S, ∑ t ∈ Icc (-r) r,
      w s t * eC (∑ k ∈ range (2 * d + 1), a s k * (t : ℝ) ^ k)‖ := by
    rw [hid, norm_mul, Complex.norm_real, Real.norm_of_nonneg (by positivity), hNR]
    have hcard : (#S : ℝ) ≤ (5 * R) ^ m := by
      rw [card_minorBox hr0, hrR]; gcongr; linarith
    have hlt := hbad
    rw [div_lt_iff₀ (by positivity)] at hlt
    calc δ * A * R * #S ≤ δ * A * R * (5 * R) ^ m := by gcongr
      _ = ε * R ^ (m + 1) := by simp only [δ]; field_simp; ring
      _ ≤ ‖minorTT Ω d j lx ly h‖ * R ^ (m + 1) * R ^ (m + 1) := by
          have : ε ≤ ‖minorTT Ω d j lx ly h‖ * R ^ (m + 1) := hlt.le
          have h1 : (1 : ℝ) ≤ R ^ (m + 1) := one_le_pow₀ hR1
          nlinarith [pow_pos hR0 (m + 1)]
      _ = R ^ (2 * (m + 1)) * ‖minorTT Ω d j lx ly h‖ := by ring
  obtain ⟨s, -, q, hq1, hq2, hq3⟩ := hCor S a w (2 ^ j) (-r) r A δ ⟨0, hS0⟩ Nat.one_le_two_pow
    hA0 hδ hδ2 hT0 hT1 hw hwv hsum
  -- conclusion
  have hδC : δ ^ (-C) = (A * 5 ^ m) ^ C * ε ^ (-C) := by
    simp only [δ]
    rw [div_eq_mul_inv, Real.mul_rpow hε.le (by positivity), Real.inv_rpow (by positivity),
      Real.rpow_neg (by positivity : (0 : ℝ) ≤ A * 5 ^ m), inv_inv]
    ring
  refine ⟨q, hq1, ?_, ?_⟩
  · rw [hδC] at hq2; linarith
  · have := hq3 (2 * d - 1) (mem_Icc.2 ⟨by omega, by omega⟩)
    simp only [a] at this
    rw [minorPhasePoly_coeff hd, hδC, hNR] at this
    calc ‖((q * (2 * d) * (h 0 : ℝ) * ly : ℝ) : UnitAddCircle)‖ =
        ‖((q * (2 * d * ly * (h 0 : ℝ)) : ℝ) : UnitAddCircle)‖ := by ring_nf
      _ ≤ _ := this
      _ = _ := by ring

/-! ### Counting bad pairs: the column bound -/

/-- **Column bound for the `TT*` kernel** (Blueprint Lemma 8.1 (`lem:minorL2`), counting step):
fix the second point `y` (parameter `λ_y`). Suppose every bad pair (`|H| > ε 2^{-jn}`) yields an
approximation `1 ≤ q ≤ Q`, `‖q D h₁ λ_y‖_𝕋 ≤ Q 2^{-j(D-1)}`, and that every set of such
`|h₁| ≤ 4 · 2^j` has fewer than `η 2^j` elements. Then, whatever the parameters `g h = λ_x` of
the first points,
`∑_h |H| ≤ 9ⁿ ε + 9^{n-1} 5ⁿ C₀² η` (for each fixed `h' = (h₂, …, hₙ)` fewer than `η 2^j` values
of `h₁` are bad). -/
lemma minor_column_bound {m d j : ℕ} {Ω : EuclideanSpace ℝ (Fin (m + 1)) → ℂ} {C₀ : ℝ}
    (hC₀ : 0 ≤ C₀) (hK : ∀ a, ‖dyadicKernel Ω j a‖ ≤ C₀ / ((2 : ℝ) ^ j) ^ (m + 1))
    {ε η Q ly : ℝ} (hε : 0 < ε) (hη : 0 < η)
    (hbad : ∀ lx h, ε / ((2 : ℝ) ^ j) ^ (m + 1) < ‖minorTT Ω d j lx ly h‖ →
      ∃ q : ℕ, 1 ≤ q ∧ (q : ℝ) ≤ Q ∧
        ‖((q * (2 * d) * (h 0 : ℝ) * ly : ℝ) : UnitAddCircle)‖ ≤ Q / ((2 : ℝ) ^ j) ^ (2 * d - 1))
    (hcount : ∀ T : Finset ℤ, (∀ h ∈ T, |(h : ℝ)| ≤ 4 * 2 ^ j ∧ ∃ q : ℕ, 1 ≤ q ∧ (q : ℝ) ≤ Q ∧
        ‖((q * (2 * d) * h * ly : ℝ) : UnitAddCircle)‖ ≤ Q / ((2 : ℝ) ^ j) ^ (2 * d - 1)) →
      (#T : ℝ) < η * 2 ^ j)
    (g : (Fin (m + 1) → ℤ) → ℝ) :
    ∑' h, ‖minorTT Ω d j (g h) ly h‖ₑ ≤
      ENNReal.ofReal (9 ^ (m + 1) * ε + 9 ^ m * (5 ^ (m + 1) * C₀ ^ 2) * η) := by
  set R : ℝ := (2 : ℝ) ^ j with hR
  have hR0 : 0 < R := by positivity
  have hR1 : 1 ≤ R := one_le_pow₀ (by norm_num)
  set r : ℤ := 4 * 2 ^ j with hr
  have hr0 : 0 ≤ r := by positivity
  have hrR : (r : ℝ) = 4 * R := by simp [r, hR]
  set box := minorBox (m + 1) r
  set F : (Fin (m + 1) → ℤ) → ℝ := fun h => ‖minorTT Ω d j (g h) ly h‖
  have hzero : ∀ h ∉ box, ‖minorTT Ω d j (g h) ly h‖ₑ = 0 := fun h hh => by
    rw [minorTT_eq_zero _ _ hh, enorm_zero]
  rw [tsum_eq_sum hzero]
  have hsum : ∑ h ∈ box, ‖minorTT Ω d j (g h) ly h‖ₑ = ENNReal.ofReal (∑ h ∈ box, F h) := by
    rw [ENNReal.ofReal_sum_of_nonneg fun _ _ => norm_nonneg _]
    exact sum_congr rfl fun h _ => (ofReal_norm _).symm
  rw [hsum]
  refine ENNReal.ofReal_le_ofReal ?_
  set CH : ℝ := 5 ^ (m + 1) * C₀ ^ 2
  set Bad := {h ∈ box | ε / R ^ (m + 1) < F h}
  have hsplit := sum_filter_add_sum_filter_not box (fun h => ε / R ^ (m + 1) < F h) F
  have h1 : ∑ h ∈ Bad, F h ≤ #Bad * (CH / R ^ (m + 1)) := by
    rw [← nsmul_eq_mul, ← sum_const]
    exact sum_le_sum fun h _ => norm_minorTT_le hC₀ hK _ _ _
  have h2 : ∑ h ∈ box with ¬(ε / R ^ (m + 1) < F h), F h ≤ #box * (ε / R ^ (m + 1)) := by
    calc _ ≤ ∑ h ∈ box with ¬(ε / R ^ (m + 1) < F h), ε / R ^ (m + 1) :=
          sum_le_sum fun h hh => not_lt.1 (mem_filter.1 hh).2
      _ = #(box.filter fun h => ¬(ε / R ^ (m + 1) < F h)) * (ε / R ^ (m + 1)) := by
          rw [sum_const, nsmul_eq_mul]
      _ ≤ #box * (ε / R ^ (m + 1)) := by
          gcongr; exact filter_subset _ _
  have hbox : (#box : ℝ) ≤ (9 * R) ^ (m + 1) := by
    rw [card_minorBox hr0, hrR]; gcongr; linarith
  -- counting the bad set fibrewise over the last `m` coordinates
  set boxm := minorBox m r
  have hBad : (#Bad : ℝ) ≤ (9 * R) ^ m * (η * R) := by
    have hmaps : ∀ h ∈ Bad, Fin.tail h ∈ boxm := by
      intro h hh
      have := (mem_filter.1 hh).1
      rw [mem_minorBox] at this ⊢
      exact fun i => this _
    rw [card_eq_sum_card_fiberwise hmaps]
    push_cast
    have hfib : ∀ s ∈ boxm, (#{h ∈ Bad | Fin.tail h = s} : ℝ) ≤ η * R := by
      intro s _
      set Fb := {h ∈ Bad | Fin.tail h = s}
      have hinj : Set.InjOn (fun h : Fin (m + 1) → ℤ => h 0) (Fb : Set _) := by
        intro a ha b hb hab
        have ha' := (mem_filter.1 ha).2
        have hb' := (mem_filter.1 hb).2
        rw [← Fin.cons_self_tail a, ← Fin.cons_self_tail b, ha', hb']
        simp only at hab
        rw [hab]
      rw [← card_image_of_injOn hinj]
      refine (hcount _ fun x hx => ?_).le
      obtain ⟨h, hh, rfl⟩ := mem_image.1 hx
      have hhB := (mem_filter.1 hh).1
      obtain ⟨hbox', hbad'⟩ := mem_filter.1 hhB
      refine ⟨?_, hbad (g h) h hbad'⟩
      have := (mem_minorBox.1 hbox') 0
      have : |((h 0 : ℤ) : ℝ)| ≤ (r : ℝ) := by exact_mod_cast this
      rw [hrR] at this; exact this
    calc ∑ s ∈ boxm, (#{h ∈ Bad | Fin.tail h = s} : ℝ) ≤ ∑ _s ∈ boxm, η * R :=
          sum_le_sum hfib
      _ = #boxm * (η * R) := by rw [sum_const, nsmul_eq_mul]
      _ ≤ (9 * R) ^ m * (η * R) := by
          gcongr
          rw [card_minorBox hr0, hrR]; gcongr; linarith
  have hRm : (0 : ℝ) < R ^ (m + 1) := by positivity
  have hCH : 0 ≤ CH := by positivity
  rw [← hsplit]
  calc ∑ h ∈ Bad, F h + ∑ h ∈ box with ¬(ε / R ^ (m + 1) < F h), F h
      ≤ (9 * R) ^ m * (η * R) * (CH / R ^ (m + 1)) + (9 * R) ^ (m + 1) * (ε / R ^ (m + 1)) := by
        gcongr
        · exact h1.trans (by gcongr)
        · exact h2.trans (by gcongr)
    _ = 9 ^ (m + 1) * ε + 9 ^ m * CH * η := by
        field_simp; ring

/-! ### The `TT*` argument for a linearization -/

/-- `2ab ≤ a² + b²` in `[0, ∞]`. -/
lemma minor_two_mul_le_add_sq (a b : ℝ≥0∞) : 2 * a * b ≤ a ^ 2 + b ^ 2 := by
  rcases eq_or_ne a ∞ with rfl | ha
  · rcases eq_or_ne b 0 with rfl | hb
    · simp
    · simp [ENNReal.top_pow two_ne_zero]
  rcases eq_or_ne b ∞ with rfl | hb
  · rcases eq_or_ne a 0 with rfl | ha'
    · simp
    · simp [ENNReal.top_pow two_ne_zero]
  lift a to ℝ≥0 using ha
  lift b to ℝ≥0 using hb
  exact_mod_cast two_mul_le_add_sq a b

/-- Schur's test for a bilinear form on a countable space with counting measure: if all row and
column sums of `|H|` are at most `A`, then `∑_x |v x| ∑_{x'} |H x x'| |v x'| ≤ A ∑ |v|²`. -/
lemma minor_bilinear_schur {α : Type*} (b : α → α → ℝ≥0∞) (a : α → ℝ≥0∞) {A : ℝ≥0∞}
    (hrow : ∀ x, ∑' x', b x x' ≤ A) (hcol : ∀ x', ∑' x, b x x' ≤ A) :
    ∑' x, a x * ∑' x', b x x' * a x' ≤ A * ∑' x, a x ^ 2 := by
  have h2 : (2 : ℝ≥0∞) ≠ 0 := two_ne_zero
  have h2' : (2 : ℝ≥0∞) ≠ ∞ := ENNReal.ofNat_ne_top
  have hpt : ∀ x x', 2 * (a x * (b x x' * a x')) ≤ b x x' * a x ^ 2 + b x x' * a x' ^ 2 := by
    intro x x'
    calc 2 * (a x * (b x x' * a x')) = b x x' * (2 * a x * a x') := by ring
      _ ≤ b x x' * (a x ^ 2 + a x' ^ 2) := by gcongr; exact minor_two_mul_le_add_sq _ _
      _ = _ := by ring
  have key : 2 * ∑' x, a x * ∑' x', b x x' * a x' ≤ 2 * (A * ∑' x, a x ^ 2) := by
    calc 2 * ∑' x, a x * ∑' x', b x x' * a x'
        = ∑' x, ∑' x', 2 * (a x * (b x x' * a x')) := by
          rw [← ENNReal.tsum_mul_left]
          refine tsum_congr fun x => ?_
          rw [← ENNReal.tsum_mul_left, ← ENNReal.tsum_mul_left]
      _ ≤ ∑' x, ∑' x', (b x x' * a x ^ 2 + b x x' * a x' ^ 2) :=
          ENNReal.tsum_le_tsum fun x => ENNReal.tsum_le_tsum fun x' => hpt x x'
      _ = ∑' x, (∑' x', b x x') * a x ^ 2 + ∑' x', (∑' x, b x x') * a x' ^ 2 := by
          simp_rw [ENNReal.tsum_add]
          rw [ENNReal.tsum_comm (f := fun x x' => b x x' * a x' ^ 2)]
          simp_rw [ENNReal.tsum_mul_right]
      _ ≤ ∑' x, A * a x ^ 2 + ∑' x', A * a x' ^ 2 := by
          gcongr with x x'
          · exact hrow x
          · exact hcol x'
      _ = 2 * (A * ∑' x, a x ^ 2) := by
          rw [ENNReal.tsum_mul_left, two_mul]
  exact (ENNReal.mul_le_mul_iff_right h2 h2').1 key

/-- `‖v‖₂² = ∑_x |v x|²` for counting measure. -/
lemma minor_eLpNorm_two_sq {α : Type*} [MeasurableSpace α] [MeasurableSingletonClass α]
    [Countable α] (v : α → ℂ) :
    eLpNorm v 2 Measure.count ^ 2 = ∑' x, ‖v x‖ₑ ^ 2 := by
  have := eLpNorm_two_rpow_two (ν := Measure.count) (AEStronglyMeasurable.of_discrete (f := v))
  rw [lintegral_count] at this
  rw [← ENNReal.rpow_natCast, Nat.cast_ofNat, this]
  simp_rw [← ENNReal.rpow_natCast, Nat.cast_ofNat]

/-- A Bochner integral against counting measure of a finitely supported function is its sum. -/
lemma minor_integral_count_eq_tsum {α : Type*} [MeasurableSpace α] [MeasurableSingletonClass α]
    [Countable α] {g : α → ℂ} (S : Finset α) (hg : ∀ z ∉ S, g z = 0) :
    ∫ z, g z ∂Measure.count = ∑' z, g z := by
  have hint : Integrable g Measure.count :=
    integrable_count_iff.2 (summable_of_ne_finset_zero (s := S) fun z hz => by simp [hg z hz])
  rw [integral_countable hint]
  simp

/-- The kernel `κ(x, z) = e(λ_x P(x - z)) K_j(x - z)` of the linearized operator. -/
noncomputable def minorKer (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (d j : ℕ) (lam : (Fin n → ℤ) → ℝ)
    (x z : Fin n → ℤ) : ℂ :=
  eC (lam x * (radialPolyZ n d (x - z) : ℝ)) * dyadicKernel Ω j (latEmbed (x - z))

/-- The box is symmetric. -/
lemma neg_mem_minorBox {r : ℤ} {w : Fin n → ℤ} (hw : w ∈ minorBox n r) : -w ∈ minorBox n r := by
  rw [mem_minorBox] at hw ⊢; intro i; simpa using hw i

lemma minorKer_eq_zero {j : ℕ} (lam : (Fin n → ℤ) → ℝ) (x z : Fin n → ℤ)
    (hz : z ∉ (minorBox n (2 * 2 ^ j)).image (fun w => x + w)) : minorKer Ω d j lam x z = 0 := by
  rw [minorKer, minor_kernel_eq_zero j, mul_zero]
  intro hmem
  apply hz
  refine mem_image.2 ⟨z - x, ?_, by abel⟩
  have := neg_mem_minorBox hmem
  rwa [neg_sub] at this

/-- The linearized operator is the integral operator with kernel `minorKer`. -/
lemma minorOp_eq_integral {j : ℕ} (lam : (Fin n → ℤ) → ℝ) (f : (Fin n → ℤ) → ℂ)
    (x : Fin n → ℤ) :
    minorOp Ω d j (lam x) f x = ∫ z, minorKer Ω d j lam x z * f z ∂Measure.count := by
  rw [minor_integral_count_eq_tsum ((minorBox n (2 * 2 ^ j)).image (fun w => x + w))
    (fun z hz => by rw [minorKer_eq_zero lam x z hz, zero_mul]), minorOp]
  rw [← (Equiv.subLeft x).tsum_eq]
  refine tsum_congr fun z => ?_
  simp only [Equiv.subLeft_apply, minorKer, sub_sub_cancel]

/-- The `TT*` kernel of the linearized operator is `minorTT`. -/
lemma integral_minorKer_mul_conj {j : ℕ} (lam : (Fin n → ℤ) → ℝ) (x x' : Fin n → ℤ) :
    ∫ z, minorKer Ω d j lam x z * conj (minorKer Ω d j lam x' z) ∂Measure.count =
      minorTT Ω d j (lam x) (lam x') (x' - x) := by
  rw [minor_integral_count_eq_tsum ((minorBox n (2 * 2 ^ j)).image (fun w => x + w))
    (fun z hz => by rw [minorKer_eq_zero lam x z hz, zero_mul])]
  rw [← (Equiv.addLeft x).tsum_eq, tsum_eq_sum (s := minorBox n (2 * 2 ^ j))]
  · refine sum_congr rfl fun w _ => ?_
    simp only [Equiv.coe_addLeft, minorKer, map_mul]
    have e1 : x - (x + w) = -w := by abel
    have e2 : x' - (x + w) = x' - x - w := by abel
    rw [e1, e2]
    rw [show ∀ a b c e : ℂ, a * b * (c * e) = (a * c) * b * e by intros; ring, minor_eC_mul_conj]
  · intro w hw
    simp only [Equiv.coe_addLeft, minorKer]
    have e1 : x - (x + w) = -w := by abel
    rw [e1, minor_kernel_eq_zero j (fun h => hw (by simpa using neg_mem_minorBox h))]
    simp

/-- `|H(x, x')| = |H(x', x)|`. -/
lemma norm_integral_minorKer_symm {j : ℕ} (lam : (Fin n → ℤ) → ℝ) (x x' : Fin n → ℤ) :
    ‖∫ z, minorKer Ω d j lam x z * conj (minorKer Ω d j lam x' z) ∂Measure.count‖ₑ =
      ‖∫ z, minorKer Ω d j lam x' z * conj (minorKer Ω d j lam x z) ∂Measure.count‖ₑ := by
  rw [← RCLike.enorm_conj, ← integral_conj]
  congr 2; funext z
  rw [map_mul, RCLike.conj_conj, mul_comm]

/-- `∑_y |K_j(y)| ≤ 5ⁿ C₀`. -/
lemma minor_tsum_enorm_kernel_le {C₀ : ℝ} (hC₀ : 0 ≤ C₀) {j : ℕ}
    (hK : ∀ a, ‖dyadicKernel Ω j a‖ ≤ C₀ / ((2 : ℝ) ^ j) ^ n) :
    ∑' y : Fin n → ℤ, ‖dyadicKernel Ω j (latEmbed y)‖ₑ ≤ ENNReal.ofReal (5 ^ n * C₀) := by
  rw [tsum_eq_sum (s := minorBox n (2 * 2 ^ j)) fun y hy => by
    rw [minor_kernel_eq_zero j hy, enorm_zero]]
  have hR : (0 : ℝ) < (2 : ℝ) ^ j := by positivity
  have hR1 : (1 : ℝ) ≤ (2 : ℝ) ^ j := one_le_pow₀ (by norm_num)
  calc ∑ y ∈ minorBox n (2 * 2 ^ j), ‖dyadicKernel Ω j (latEmbed y)‖ₑ
      ≤ ∑ _y ∈ minorBox n (2 * 2 ^ j), ENNReal.ofReal (C₀ / ((2 : ℝ) ^ j) ^ n) :=
        sum_le_sum fun y _ => by rw [← ofReal_norm]; exact ENNReal.ofReal_le_ofReal (hK _)
    _ = ENNReal.ofReal (#(minorBox n (2 * 2 ^ j)) * (C₀ / ((2 : ℝ) ^ j) ^ n)) := by
        rw [sum_const, nsmul_eq_mul, ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_natCast]
    _ ≤ ENNReal.ofReal (5 ^ n * C₀) := by
        refine ENNReal.ofReal_le_ofReal ?_
        rw [card_minorBox (by positivity)]
        push_cast
        calc (2 * (2 * (2 : ℝ) ^ j) + 1) ^ n * (C₀ / ((2 : ℝ) ^ j) ^ n)
            ≤ (5 * (2 : ℝ) ^ j) ^ n * (C₀ / ((2 : ℝ) ^ j) ^ n) := by gcongr; linarith
          _ = 5 ^ n * C₀ := by rw [mul_pow]; field_simp

/-- **Linearized bound via `TT*`** (Blueprint Lemma 8.1 (`lem:minorL2`), with Blueprint Lemma 2.5
(`lem:ttstar`)): for any selection of parameters `λ : G → ℝ`, if every column sum of the `TT*`
kernel satisfies `∑_x |H(x, y)| ≤ A`, then `‖x ↦ T_{j,λ_x} f(x)‖₂ ≤ A^{1/2} ‖f‖₂`. (Row sums
equal column sums since `|H(x, y)| = |H(y, x)|`.) -/
lemma minor_linearized_bound {j : ℕ} {C₀ : ℝ} (hC₀ : 0 ≤ C₀)
    (hK : ∀ a, ‖dyadicKernel Ω j a‖ ≤ C₀ / ((2 : ℝ) ^ j) ^ n) {A : ℝ} (lam : (Fin n → ℤ) → ℝ)
    (hcol : ∀ y, ∑' x, ‖minorTT Ω d j (lam x) (lam y) (y - x)‖ₑ ≤ ENNReal.ofReal A)
    {f : (Fin n → ℤ) → ℂ} (hf : MemLp f 2 Measure.count) :
    eLpNorm (fun x => minorOp Ω d j (lam x) f x) 2 Measure.count ≤
      ENNReal.ofReal A ^ (1 / 2 : ℝ) * eLpNorm f 2 Measure.count := by
  have hfun : (fun x => minorOp Ω d j (lam x) f x) =
      fun x => ∫ z, minorKer Ω d j lam x z * f z ∂Measure.count :=
    funext fun x => minorOp_eq_integral lam f x
  rw [hfun]
  have hκ : StronglyMeasurable (Function.uncurry (minorKer Ω d j lam)) :=
    (Measurable.of_discrete).stronglyMeasurable
  have hnorm : ∀ x z, ‖minorKer Ω d j lam x z‖ₑ = ‖dyadicKernel Ω j (latEmbed (x - z))‖ₑ := by
    intro x z
    rw [minorKer, enorm_mul, ← ofReal_norm (eC _), norm_eC, ENNReal.ofReal_one, one_mul]
  have hrow : ∀ x, ∫⁻ z, ‖minorKer Ω d j lam x z‖ₑ ∂Measure.count ≤
      ENNReal.ofReal (5 ^ n * C₀) := by
    intro x
    rw [lintegral_count]
    simp_rw [hnorm]
    refine ((Equiv.subLeft x).tsum_eq (fun y => ‖dyadicKernel Ω j (latEmbed y)‖ₑ)).trans_le ?_
    exact minor_tsum_enorm_kernel_le hC₀ hK
  have hcol' : ∀ z, ∫⁻ x, ‖minorKer Ω d j lam x z‖ₑ ∂Measure.count ≤
      ENNReal.ofReal (5 ^ n * C₀) := by
    intro z
    rw [lintegral_count]
    simp_rw [hnorm]
    refine ((Equiv.subRight z).tsum_eq (fun y => ‖dyadicKernel Ω j (latEmbed y)‖ₑ)).trans_le ?_
    exact minor_tsum_enorm_kernel_le hC₀ hK
  have hM : ∀ x z, ‖minorKer Ω d j lam x z‖ ≤ C₀ / ((2 : ℝ) ^ j) ^ n := by
    intro x z
    rw [minorKer, norm_mul, norm_eC, one_mul]; exact hK _
  refine band_eLpNorm_kernel_le_of_ttstar hκ ENNReal.ofReal_ne_top hrow hcol' hM ?_ hf
  intro v _
  rw [lintegral_count, minor_eLpNorm_two_sq]
  simp_rw [lintegral_count]
  refine minor_bilinear_schur _ _ (fun x => ?_) (fun x' => ?_)
  · simp_rw [norm_integral_minorKer_symm lam x, integral_minorKer_mul_conj]
    exact hcol x
  · simp_rw [integral_minorKer_mul_conj]
    exact hcol x'

/-! ### Lemma 8.1 -/

/-- `(1/j^U)^{-e} ≤ j^B` for `B ≥ U e`, `j ≥ 1`. -/
lemma minor_rpow_le {j U B : ℕ} {e : ℝ} (hj : 1 ≤ j) (hB : (U : ℝ) * e ≤ B) :
    (1 / (j : ℝ) ^ U) ^ (-e) ≤ (j : ℝ) ^ B := by
  have hJ : (1 : ℝ) ≤ j := by exact_mod_cast hj
  have hJ0 : (0 : ℝ) < j := by linarith
  rw [one_div, Real.inv_rpow (by positivity), Real.rpow_neg (by positivity), inv_inv,
    ← Real.rpow_natCast (j : ℝ) U, ← Real.rpow_mul hJ0.le, ← Real.rpow_natCast (j : ℝ) B]
  exact Real.rpow_le_rpow_of_exponent_le hJ hB

/-- `(c² / j^U)^{1/2} ≤ c j^{-κ}` for `U ≥ 2κ`, `j ≥ 1`, `c ≥ 0`. -/
lemma minor_sqrt_le {j U : ℕ} {c κ : ℝ} (hj : 1 ≤ j) (hc : 0 ≤ c) (hU : 2 * κ ≤ U) :
    ENNReal.ofReal (c ^ 2 / (j : ℝ) ^ U) ^ (1 / 2 : ℝ) ≤ ENNReal.ofReal (c * (j : ℝ) ^ (-κ)) := by
  have hJ : (1 : ℝ) ≤ j := by exact_mod_cast hj
  have hJ0 : (0 : ℝ) < j := by linarith
  rw [ENNReal.ofReal_rpow_of_nonneg (by positivity) (by norm_num)]
  refine ENNReal.ofReal_le_ofReal ?_
  rw [← Real.sqrt_eq_rpow]
  have hx : 0 ≤ c * (j : ℝ) ^ (-κ) := by positivity
  rw [← Real.sqrt_sq hx]
  refine Real.sqrt_le_sqrt ?_
  rw [mul_pow, ← Real.rpow_natCast ((j : ℝ) ^ (-κ)) 2, ← Real.rpow_mul hJ0.le, div_eq_mul_inv,
    ← Real.rpow_natCast (j : ℝ) U, ← Real.rpow_neg hJ0.le]
  gcongr
  push_cast; linarith

/-- Blueprint Lemma 8.1 (`lem:minorL2`), uniform form: let `n ≥ 1`, `d ≥ 1` and `Ω` an admissible
profile. For every real `κ` (the substance is `κ > 0`) there are integers `M₀, j₁ ≥ 1` and
`C ≥ 0` such that for
every `M ≥ M₀` (the arcs `X_j` depend on `M`), every `j ≥ j₁` and every `f ∈ ℓ²(ℤⁿ)`,
`‖sup_{λ ∉ X_j} |T_{j,λ} f|‖₂ ≤ C j^{-κ} ‖f‖₂` (the supremum of the empty family being `0`). -/
theorem minor_arc_decay_uniform {n d : ℕ} (hn : 1 ≤ n) (hd : 1 ≤ d)
    {Ω : EuclideanSpace ℝ (Fin n) → ℂ} (hΩ : IsSWProfile Ω) (κ : ℝ) :
    ∃ M₀ j₁ : ℕ, 1 ≤ M₀ ∧ 1 ≤ j₁ ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ M ≥ M₀, ∀ j ≥ j₁,
      ∀ f : (Fin n → ℤ) → ℂ, MemLp f 2 Measure.count →
        eLpNorm (fun x => ⨆ (lam : ℝ) (_ : lam ∉ minorArcs d M j), ‖minorOp Ω d j lam f x‖ₑ)
            2 Measure.count ≤
          ENNReal.ofReal (C * (j : ℝ) ^ (-κ)) * eLpNorm f 2 Measure.count := by
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  obtain ⟨C₀, C₁, hC₀, hC₁, hK⟩ := minor_kernel_bounds hΩ
  obtain ⟨Cw, e, hCw, he, hbadp⟩ := minor_bad_pair hΩ hd
  set U : ℕ := ⌈2 * κ⌉₊
  have hU : 2 * κ ≤ U := Nat.le_ceil _
  set B : ℕ := ⌈(U : ℝ) * e⌉₊
  have hB : (U : ℝ) * e ≤ B := Nat.le_ceil _
  obtain ⟨M₀, j₁, hM₀, hj₁, hcnt⟩ := minor_card_lt hd hCw B U
  set CH : ℝ := 5 ^ (m + 1) * C₀ ^ 2
  set c : ℝ := Real.sqrt (9 ^ (m + 1) + 9 ^ m * CH)
  have hc2 : c ^ 2 = 9 ^ (m + 1) + 9 ^ m * CH := Real.sq_sqrt (by positivity)
  refine ⟨M₀, j₁, hM₀, hj₁, c, Real.sqrt_nonneg _, fun M hM j hj f hf => ?_⟩
  have hj1 : 1 ≤ j := hj₁.trans hj
  have hJ0 : (0 : ℝ) < j := by exact_mod_cast hj1
  set ε : ℝ := 1 / (j : ℝ) ^ U
  have hε : 0 < ε := by positivity
  have hε1 : ε ≤ 1 := by
    rw [div_le_one (by positivity)]; exact one_le_pow₀ (by exact_mod_cast hj1)
  have hA : 9 ^ (m + 1) * ε + 9 ^ m * CH * ε = c ^ 2 / (j : ℝ) ^ U := by
    rw [hc2]; simp only [ε]; ring
  -- Lemma 2.1 and linearization reduce to a selection `λ : G → ℝ ∖ X_j`
  have hsup : (fun x => ⨆ (lam : ℝ) (_ : lam ∉ minorArcs d M j), ‖minorOp Ω d j lam f x‖ₑ) =
      fun x => ⨆ a : {lam : ℝ // lam ∉ minorArcs d M j}, ‖minorOp Ω d j a.1 f x‖ₑ := by
    funext x; rw [iSup_subtype']
  rw [hsup]
  refine eLpNorm_iSup_le_of_finset_count (by norm_num) _ _ fun F => ?_
  refine eLpNorm_finset_sup_le_of_linearization_op
    (fun (a : {lam : ℝ // lam ∉ minorArcs d M j}) f x => minorOp Ω d j a.1 f x) f F
    (fun _ _ => AEStronglyMeasurable.of_discrete) _ fun σ _ _ => ?_
  set lam : (Fin (m + 1) → ℤ) → ℝ := fun x => (σ x).1
  have hlam : ∀ x, lam x ∉ minorArcs d M j := fun x => (σ x).2
  refine (minor_linearized_bound hC₀ (hK j).1 lam (A := c ^ 2 / (j : ℝ) ^ U) (fun y => ?_) hf).trans
    (mul_le_mul_left (minor_sqrt_le hj1 (Real.sqrt_nonneg _) hU) _)
  -- the column bound
  rw [← (Equiv.subLeft y).tsum_eq]
  simp only [Equiv.subLeft_apply, sub_sub_cancel]
  rw [← hA]
  refine minor_column_bound (Q := Cw * (j : ℝ) ^ B) hC₀ (hK j).1 hε hε (fun lx h hbad => ?_)
    (fun T hT => hcnt M hM j hj (lam y) (hlam y) T hT) (fun h => lam (y - h))
  obtain ⟨q, hq1, hq2, hq3⟩ := hbadp j lx (lam y) h ε hε hε1 hbad
  have hle : Cw * ε ^ (-e) ≤ Cw * (j : ℝ) ^ B :=
    mul_le_mul_of_nonneg_left (minor_rpow_le hj1 hB) (by linarith)
  exact ⟨q, hq1, hq2.trans hle, hq3.trans (div_le_div_of_nonneg_right hle (by positivity))⟩

/-- Blueprint Lemma 8.1 (`lem:minorL2`, "Minor-arc decay with an arbitrarily large logarithmic
power"): let `n ≥ 1`, `d ≥ 1` and `Ω` an admissible profile (`IsSWProfile Ω`). For every
`κ > 0` (indeed every real `κ`) there is `M₀ ≥ 1` such that for every integer `M ≥ M₀` there
are `j₁ ≥ 1` and `C` with
`‖sup_{λ ∉ X_j} |T_{j,λ} f|‖_{ℓ²} ≤ C j^{-κ} ‖f‖_{ℓ²}` for all `j ≥ j₁` and all `f ∈ ℓ²(ℤⁿ)`,
where `T_{j,λ} f(x) = ∑_y e(λ P(y)) K_j(y) f(x - y)` (`minorOp`) and `X_j` (`minorArcs d M j`) is
the union of the arcs `‖λ - a/q‖_𝕋 ≤ w_j = (j+1)^M 2^{-Dj}` over reduced `a/q`,
`1 ≤ q < H_j = 2^{⌊M log₂(j+1)⌋}`. (The blueprint asserts this for some `M`; the version for all
`M ≥ M₀`, with `j₁` and `C` even independent of `M`, is `minor_arc_decay_uniform`.) -/
theorem minor_arc_decay {n d : ℕ} (hn : 1 ≤ n) (hd : 1 ≤ d)
    {Ω : EuclideanSpace ℝ (Fin n) → ℂ} (hΩ : IsSWProfile Ω) (κ : ℝ) :
    ∃ M₀ : ℕ, 1 ≤ M₀ ∧ ∀ M ≥ M₀, ∃ j₁ : ℕ, 1 ≤ j₁ ∧ ∃ C : ℝ, ∀ j ≥ j₁,
      ∀ f : (Fin n → ℤ) → ℂ, MemLp f 2 Measure.count →
        eLpNorm (fun x => ⨆ (lam : ℝ) (_ : lam ∉ minorArcs d M j), ‖minorOp Ω d j lam f x‖ₑ)
            2 Measure.count ≤
          ENNReal.ofReal (C * (j : ℝ) ^ (-κ)) * eLpNorm f 2 Measure.count := by
  obtain ⟨M₀, j₁, hM₀, hj₁, C, -, h⟩ := minor_arc_decay_uniform hn hd hΩ κ
  exact ⟨M₀, hM₀, fun M hM => ⟨j₁, hj₁, C, fun j hj f hf => h M hM j hj f hf⟩⟩

/-! ### Construction 8.2: the final exponent and the major-arc parameters -/

/-- The dual exponent `p' = p/(p-1)` of Blueprint Construction 8.2 (`con:parameters`). -/
noncomputable def paramDual (p : ℝ) : ℝ := p / (p - 1)

/-- The integer `r = ⌊max(p, p')⌋ + 1` of Blueprint Construction 8.2 (`con:parameters`)
(so `r ≥ 2` and `2r > max(p, p')` for `1 < p`). -/
noncomputable def paramR (p : ℝ) : ℕ := ⌊max p (paramDual p)⌋₊ + 1

/-- The exponent `a_p = min(2/p, 2/p')` of Blueprint Construction 8.2 (`con:parameters`). -/
noncomputable def paramA (p : ℝ) : ℝ := min (2 / p) (2 / paramDual p)

/-- The exponent `κ = 4 / a_p` (so `κ a_p = 4 > 3`) of Blueprint Construction 8.2
(`con:parameters`). -/
noncomputable def paramKappa (p : ℝ) : ℝ := 4 / paramA p

/-- The conclusion of `minor_arc_decay_uniform` for given `κ, M₀, j₁`. -/
def MinorDecaySpec (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (κ : ℝ) (M₀ j₁ : ℕ) : Prop :=
  1 ≤ M₀ ∧ 1 ≤ j₁ ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ M ≥ M₀, ∀ j ≥ j₁,
    ∀ f : (Fin n → ℤ) → ℂ, MemLp f 2 Measure.count →
      eLpNorm (fun x => ⨆ (lam : ℝ) (_ : lam ∉ minorArcs d M j), ‖minorOp Ω d j lam f x‖ₑ)
          2 Measure.count ≤
        ENNReal.ofReal (C * (j : ℝ) ^ (-κ)) * eLpNorm f 2 Measure.count

/-- A choice of `(M₀, j₁)` from `minor_arc_decay_uniform` for `κ = paramKappa p`. -/
noncomputable def paramMJ (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) : ℕ × ℕ :=
  Classical.epsilon fun q : ℕ × ℕ => MinorDecaySpec n d Ω (paramKappa p) q.1 q.2

/-- The integer `M ≥ 2` of Blueprint Construction 8.2 (`con:parameters`). -/
noncomputable def paramM (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) : ℕ :=
  max (paramMJ n d Ω p).1 2

/-- The lower scale `j₁` of Blueprint Construction 8.2 (`con:parameters`). -/
noncomputable def paramJ1 (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) : ℕ :=
  (paramMJ n d Ω p).2

/-- `ρ = 1/(16 M)` of Blueprint Construction 8.2 (`con:parameters`). -/
noncomputable def paramRho (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) : ℝ :=
  1 / (16 * (paramM n d Ω p : ℝ))

/-- The good rational sets `𝒰_N` (Construction 7.8 with `ρ = paramRho`) of Blueprint
Construction 8.2 (`con:parameters`). -/
noncomputable def paramGoodSet (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (N : ℕ) :
    Finset (Fin n → ZMod (blockProd (goodBlocks (paramRho n d Ω p) N))) :=
  goodSet (paramRho n d Ω p) N

/-- `p' > 1` for `p > 1`. -/
theorem one_lt_paramDual {p : ℝ} (hp : 1 < p) : 1 < paramDual p := by
  rw [paramDual, one_lt_div (by linarith)]; linarith

/-- `1/p + 1/p' = 1`. -/
theorem inv_add_inv_paramDual {p : ℝ} (hp : 1 < p) : 1 / p + 1 / paramDual p = 1 := by
  have : p - 1 ≠ 0 := by linarith
  rw [paramDual]; field_simp; ring

/-- `max(p, p') < r`. -/
theorem max_lt_paramR (p : ℝ) : max p (paramDual p) < paramR p := by
  rw [paramR]; push_cast; exact Nat.lt_floor_add_one _

/-- Blueprint Construction 8.2 (`con:parameters`): `r ≥ 2`. -/
theorem two_le_paramR {p : ℝ} (hp : 1 < p) : 2 ≤ paramR p := by
  have : 1 ≤ ⌊max p (paramDual p)⌋₊ :=
    Nat.le_floor (by push_cast; exact (le_max_left _ _).trans' hp.le)
  rw [paramR]; omega

/-- Blueprint Construction 8.2 (`con:parameters`): `2r > p`. -/
theorem lt_two_mul_paramR {p : ℝ} (hp : 1 < p) : p < 2 * (paramR p : ℝ) := by
  have := max_lt_paramR p
  have := le_max_left p (paramDual p)
  linarith

/-- Blueprint Construction 8.2 (`con:parameters`): `2r > p'`. -/
theorem paramDual_lt_two_mul_paramR {p : ℝ} (hp : 1 < p) : paramDual p < 2 * (paramR p : ℝ) := by
  have := max_lt_paramR p
  have := le_max_right p (paramDual p)
  have := one_lt_paramDual hp
  linarith

/-- Blueprint Construction 8.2 (`con:parameters`): `(2r)' ≤ p ≤ 2r`, the exponent range of
Theorem 7.7 (`thm:IW`). -/
theorem paramR_exponent_range {p : ℝ} (hp : 1 < p) :
    (2 * (paramR p : ℝ)) / (2 * (paramR p : ℝ) - 1) ≤ p ∧ p ≤ 2 * (paramR p : ℝ) := by
  refine ⟨?_, (lt_two_mul_paramR hp).le⟩
  have h := paramDual_lt_two_mul_paramR hp
  have hR : (4 : ℝ) ≤ 2 * (paramR p : ℝ) := by
    have := two_le_paramR hp; have : (2 : ℝ) ≤ paramR p := by exact_mod_cast this
    linarith
  set R := 2 * (paramR p : ℝ)
  rw [paramDual, div_lt_iff₀ (by linarith)] at h
  rw [div_le_iff₀ (by linarith)]
  nlinarith

/-- Blueprint Construction 8.2 (`con:parameters`): `a_p > 0`. -/
theorem paramA_pos {p : ℝ} (hp : 1 < p) : 0 < paramA p := by
  have := one_lt_paramDual hp
  rw [paramA]; exact lt_min (by positivity) (by positivity)

/-- `a_p = 2 - 2/p` for `p ≤ 2`. -/
theorem paramA_eq_of_le_two {p : ℝ} (hp : 1 < p) (hp2 : p ≤ 2) : paramA p = 2 - 2 / p := by
  have h2 : 2 / paramDual p = 2 - 2 / p := by
    rw [paramDual]; field_simp
  rw [paramA, h2, min_eq_right]
  rw [sub_le_iff_le_add, ← add_div, le_div_iff₀ (by linarith)]; nlinarith

/-- `a_p = 2/p` for `p ≥ 2`. -/
theorem paramA_eq_of_two_le {p : ℝ} (hp : 1 < p) (hp2 : 2 ≤ p) : paramA p = 2 / p := by
  have h2 : 2 / paramDual p = 2 - 2 / p := by
    rw [paramDual]; field_simp
  rw [paramA, h2, min_eq_left]
  rw [le_sub_iff_add_le, ← add_div, div_le_iff₀ (by linarith)]; nlinarith

/-- Blueprint Construction 8.2 (`con:parameters`): `κ a_p = 4 > 3`. -/
theorem paramKappa_mul_paramA {p : ℝ} (hp : 1 < p) : paramKappa p * paramA p = 4 := by
  rw [paramKappa]; field_simp [(paramA_pos hp).ne']

/-- Blueprint Construction 8.2 (`con:parameters`): `κ a_p > 3`. -/
theorem three_lt_paramKappa_mul_paramA {p : ℝ} (hp : 1 < p) : 3 < paramKappa p * paramA p := by
  rw [paramKappa_mul_paramA hp]; norm_num

/-- Blueprint Construction 8.2 (`con:parameters`): `M ≥ 2`. -/
theorem two_le_paramM (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) :
    2 ≤ paramM n d Ω p := le_max_right _ _

/-- Blueprint Construction 8.2 (`con:parameters`): `ρ = 1/(16M) > 0`. -/
theorem paramRho_pos (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) :
    0 < paramRho n d Ω p := by
  have : (2 : ℝ) ≤ paramM n d Ω p := by exact_mod_cast two_le_paramM n d Ω p
  rw [paramRho]; positivity

/-- Blueprint Construction 8.2 (`con:parameters`), used in (9.1): `2ρ < 1/(2M)`. -/
theorem two_mul_paramRho_lt (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) :
    2 * paramRho n d Ω p < 1 / (2 * (paramM n d Ω p : ℝ)) := by
  have : (2 : ℝ) ≤ paramM n d Ω p := by exact_mod_cast two_le_paramM n d Ω p
  rw [paramRho, mul_one_div, div_lt_div_iff₀ (by positivity) (by positivity)]
  nlinarith

/-- The choice `paramMJ` satisfies the conclusion of `minor_arc_decay_uniform`. -/
theorem paramMJ_spec {n d : ℕ} (hn : 1 ≤ n) (hd : 1 ≤ d) {Ω : EuclideanSpace ℝ (Fin n) → ℂ}
    (hΩ : IsSWProfile Ω) (p : ℝ) :
    MinorDecaySpec n d Ω (paramKappa p) (paramMJ n d Ω p).1 (paramMJ n d Ω p).2 := by
  obtain ⟨M₀, j₁, hM₀, hj₁, C, hC, h⟩ := minor_arc_decay_uniform hn hd hΩ (paramKappa p)
  exact Classical.epsilon_spec (p := fun q : ℕ × ℕ => MinorDecaySpec n d Ω (paramKappa p) q.1 q.2)
    ⟨(M₀, j₁), hM₀, hj₁, C, hC, h⟩

/-- Blueprint Construction 8.2 (`con:parameters`): `j₁ ≥ 1`. -/
theorem one_le_paramJ1 {n d : ℕ} (hn : 1 ≤ n) (hd : 1 ≤ d) {Ω : EuclideanSpace ℝ (Fin n) → ℂ}
    (hΩ : IsSWProfile Ω) (p : ℝ) : 1 ≤ paramJ1 n d Ω p :=
  (paramMJ_spec hn hd hΩ p).2.1

/-- Blueprint Lemma 8.1 (`lem:minorL2`) for the parameters `κ, M, j₁` of Construction 8.2
(`con:parameters`): `‖sup_{λ ∉ X_j} |T_{j,λ} f|‖₂ ≤ C j^{-κ} ‖f‖₂` for `j ≥ j₁`. -/
theorem param_minor_arc_decay {n d : ℕ} (hn : 1 ≤ n) (hd : 1 ≤ d)
    {Ω : EuclideanSpace ℝ (Fin n) → ℂ} (hΩ : IsSWProfile Ω) (p : ℝ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ j ≥ paramJ1 n d Ω p, ∀ f : (Fin n → ℤ) → ℂ, MemLp f 2 Measure.count →
      eLpNorm (fun x => ⨆ (lam : ℝ) (_ : lam ∉ minorArcs d (paramM n d Ω p) j),
          ‖minorOp Ω d j lam f x‖ₑ) 2 Measure.count ≤
        ENNReal.ofReal (C * (j : ℝ) ^ (-paramKappa p)) * eLpNorm f 2 Measure.count := by
  obtain ⟨-, -, C, hC, h⟩ := paramMJ_spec hn hd hΩ p
  exact ⟨C, hC, fun j hj f hf => h _ (le_max_left _ _) j hj f hf⟩

/-! ### The maximal minor-arc operator: pointwise majorant, sublinearity -/

/-- `T_{j,λ} f(x)` as a finite sum over the box `[-2^{j+1}, 2^{j+1}]ⁿ`. -/
lemma minorOp_eq_sum (j : ℕ) (lam : ℝ) (f : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) :
    minorOp Ω d j lam f x = ∑ y ∈ minorBox n (2 * 2 ^ j),
      eC (lam * (radialPolyZ n d y : ℝ)) * dyadicKernel Ω j (latEmbed y) * f (x - y) := by
  rw [minorOp, tsum_eq_sum]
  intro y hy
  rw [minor_kernel_eq_zero j hy, mul_zero, zero_mul]

/-- `|T_{j,λ} f(x)| ≤ (|K_j| * |f|)(x)`. -/
lemma enorm_minorOp_le (j : ℕ) (lam : ℝ) (f : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) :
    ‖minorOp Ω d j lam f x‖ₑ ≤
      ∑ y ∈ minorBox n (2 * 2 ^ j), ‖dyadicKernel Ω j (latEmbed y)‖ₑ * ‖f (x - y)‖ₑ := by
  rw [minorOp_eq_sum]
  refine (enorm_sum_le _ _).trans (sum_le_sum fun y _ => ?_)
  rw [enorm_mul, enorm_mul, ← ofReal_norm (eC _), norm_eC, ENNReal.ofReal_one, one_mul]

/-- `T_{j,λ}` is additive. -/
lemma minorOp_add (j : ℕ) (lam : ℝ) (f g : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) :
    minorOp Ω d j lam (f + g) x = minorOp Ω d j lam f x + minorOp Ω d j lam g x := by
  simp only [minorOp_eq_sum, Pi.add_apply, mul_add, sum_add_distrib]

/-- The maximal function `sup_{λ ∉ X} |T_{j,λ} f(x)|` (for a parameter set `X`). -/
noncomputable def minorSup (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (d j : ℕ) (X : Set ℝ)
    (f : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) : ℝ≥0∞ :=
  ⨆ (lam : ℝ) (_ : lam ∉ X), ‖minorOp Ω d j lam f x‖ₑ

/-- `sup_{λ ∉ X} |T_{j,λ} f| ≤ |K_j| * |f|`. -/
lemma minorSup_le (j : ℕ) (X : Set ℝ) (f : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) :
    minorSup Ω d j X f x ≤
      ∑ y ∈ minorBox n (2 * 2 ^ j), ‖dyadicKernel Ω j (latEmbed y)‖ₑ * ‖f (x - y)‖ₑ :=
  iSup₂_le fun lam _ => enorm_minorOp_le j lam f x

/-- `minorSup` is finite everywhere. -/
lemma minorSup_ne_top (j : ℕ) (X : Set ℝ) (f : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) :
    minorSup Ω d j X f x ≠ ∞ :=
  ne_top_of_le_ne_top
    (ENNReal.sum_ne_top.2 fun _ _ => ENNReal.mul_ne_top enorm_ne_top enorm_ne_top)
    (minorSup_le j X f x)

/-- `minorSup` is subadditive. -/
lemma minorSup_add_le (j : ℕ) (X : Set ℝ) (f g : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) :
    minorSup Ω d j X (f + g) x ≤ minorSup Ω d j X f x + minorSup Ω d j X g x := by
  refine iSup₂_le fun lam hlam => ?_
  rw [minorOp_add]
  exact (enorm_add_le _ _).trans (add_le_add
    (le_iSup₂ (f := fun (l : ℝ) (_ : l ∉ X) => ‖minorOp Ω d j l f x‖ₑ) lam hlam)
    (le_iSup₂ (f := fun (l : ℝ) (_ : l ∉ X) => ‖minorOp Ω d j l g x‖ₑ) lam hlam))

/-- The real-valued version of `minorSup` (finite everywhere), to which Marcinkiewicz
interpolation is applied. -/
noncomputable def minorSupR (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (d j : ℕ) (X : Set ℝ)
    (f : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) : ℝ :=
  (minorSup Ω d j X f x).toReal

/-- `|minorSupR| = minorSup`. -/
lemma enorm_minorSupR (j : ℕ) (X : Set ℝ) (f : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) :
    ‖minorSupR Ω d j X f x‖ₑ = minorSup Ω d j X f x := by
  rw [minorSupR, Real.enorm_eq_ofReal ENNReal.toReal_nonneg,
    ENNReal.ofReal_toReal (minorSup_ne_top j X f x)]

/-- `minorSupR` and `minorSup` have the same `ℓ^q` norms. -/
lemma eLpNorm_minorSupR (j : ℕ) (X : Set ℝ) (f : (Fin n → ℤ) → ℂ) (q : ℝ≥0∞) :
    eLpNorm (minorSupR Ω d j X f) q Measure.count =
      eLpNorm (minorSup Ω d j X f) q Measure.count :=
  eLpNorm_congr_enorm_ae AEStronglyMeasurable.of_discrete AEStronglyMeasurable.of_discrete
    (ae_of_all _ fun x => by rw [enorm_minorSupR, enorm_eq_self])

/-- Uniform `ℓ¹` bound of the kernels `K_j` (on the box containing their support). -/
lemma minor_box_kernel_le (hΩ : IsSWProfile Ω) :
    ∃ C₀ : ℝ, 0 ≤ C₀ ∧ ∀ j : ℕ,
      ∑ y ∈ minorBox n (2 * 2 ^ j), ‖dyadicKernel Ω j (latEmbed y)‖ₑ ≤ ENNReal.ofReal C₀ := by
  obtain ⟨C₀, C₁, hC₀, -, hK⟩ := minor_kernel_bounds hΩ
  exact ⟨5 ^ n * C₀, by positivity, fun j =>
    (ENNReal.sum_le_tsum _).trans (minor_tsum_enorm_kernel_le hC₀ (hK j).1)⟩

/-- Interpolation of the uniform strong `(1,1)` and `(∞,∞)` bounds of
`sup_{λ ∉ X} |T_{j,λ} f| ≤ |K_j| * |f|` with an `ℓ²` bound `B`: for `1 < p < ∞`,
`‖sup_{λ ∉ X} |T_{j,λ} f|‖_p ≤ K B^{a_p} ‖f‖_p`, `a_p = min(2/p, 2/p')`, with `K` independent of
`j`, `X`, `B` and `f` (the interpolation step of Blueprint Construction 8.2
(`con:parameters`)). -/
theorem minorSup_lp_of_l2 (hΩ : IsSWProfile Ω) {p : ℝ} (hp : 1 < p) :
    ∃ K : ℝ≥0∞, K ≠ ∞ ∧ ∀ (j : ℕ) (X : Set ℝ) (B : ℝ≥0), 0 < B →
      (∀ f : (Fin n → ℤ) → ℂ, MemLp f 2 Measure.count →
        eLpNorm (minorSup Ω d j X f) 2 Measure.count ≤ (B : ℝ≥0∞) * eLpNorm f 2 Measure.count) →
      ∀ f : (Fin n → ℤ) → ℂ, MemLp f (ENNReal.ofReal p) Measure.count →
        eLpNorm (minorSup Ω d j X f) (ENNReal.ofReal p) Measure.count ≤
          K * (B : ℝ≥0∞) ^ paramA p * eLpNorm f (ENNReal.ofReal p) Measure.count := by
  obtain ⟨C₀, hC₀, hbox⟩ := minor_box_kernel_le hΩ
  set A : ℝ≥0 := C₀.toNNReal
  have hA : (A : ℝ≥0∞) = ENNReal.ofReal C₀ := rfl
  set D : Set ((Fin n → ℤ) → ℂ) := {f | MemLp f (ENNReal.ofReal p) Measure.count}
  have hD : IsTruncationClosed D := isTruncationClosed_memLp
  -- sublinearity
  have hsub : ∀ j X, IsSublinearOn (minorSupR Ω d j X) D Measure.count := by
    intro j X f _ g _
    refine ae_of_all _ fun x => ?_
    simp only [minorSupR, Real.norm_eq_abs, abs_of_nonneg ENNReal.toReal_nonneg]
    rw [← ENNReal.toReal_add (minorSup_ne_top j X f x) (minorSup_ne_top j X g x)]
    exact ENNReal.toReal_mono (ENNReal.add_ne_top.2 ⟨minorSup_ne_top j X f x,
      minorSup_ne_top j X g x⟩) (minorSup_add_le j X f g x)
  -- the `(∞, ∞)` bound
  have hinf : ∀ j X, HasLinftyBoundOn (minorSupR Ω d j X) D A Measure.count := by
    intro j X f _ s hs
    refine ae_of_all _ fun x => ?_
    have hs0 : 0 ≤ s := (norm_nonneg _).trans (hs 0)
    rw [Real.norm_eq_abs, minorSupR, abs_of_nonneg ENNReal.toReal_nonneg, Real.coe_toNNReal _ hC₀]
    refine ENNReal.toReal_le_of_le_ofReal (by positivity) ?_
    calc minorSup Ω d j X f x
        ≤ ∑ y ∈ minorBox n (2 * 2 ^ j), ‖dyadicKernel Ω j (latEmbed y)‖ₑ * ENNReal.ofReal s := by
          refine (minorSup_le j X f x).trans (sum_le_sum fun y _ => ?_)
          gcongr
          rw [← ofReal_norm]; exact ENNReal.ofReal_le_ofReal (hs _)
      _ ≤ ENNReal.ofReal C₀ * ENNReal.ofReal s := by rw [← sum_mul]; gcongr; exact hbox j
      _ = ENNReal.ofReal (C₀ * s) := (ENNReal.ofReal_mul hC₀).symm
  -- the strong `(1, 1)` bound
  have hone : ∀ j X, HasStrongTypeOn (minorSupR Ω d j X) D 1 A Measure.count Measure.count := by
    intro j X f _
    rw [ENNReal.ofReal_one, eLpNorm_one_eq_lintegral_enorm AEStronglyMeasurable.of_discrete,
      eLpNorm_one_eq_lintegral_enorm AEStronglyMeasurable.of_discrete, lintegral_count,
      lintegral_count]
    simp_rw [enorm_minorSupR]
    calc ∑' x, minorSup Ω d j X f x
        ≤ ∑' x, ∑ y ∈ minorBox n (2 * 2 ^ j),
            ‖dyadicKernel Ω j (latEmbed y)‖ₑ * ‖f (x - y)‖ₑ :=
          ENNReal.tsum_le_tsum fun x => minorSup_le j X f x
      _ = ∑ y ∈ minorBox n (2 * 2 ^ j),
            ‖dyadicKernel Ω j (latEmbed y)‖ₑ * ∑' x, ‖f x‖ₑ := by
          rw [Summable.tsum_finsetSum fun _ _ => ENNReal.summable]
          refine sum_congr rfl fun y _ => ?_
          rw [ENNReal.tsum_mul_left]
          congr 1
          exact (Equiv.subRight y).tsum_eq (fun z => ‖f z‖ₑ)
      _ ≤ (A : ℝ≥0∞) * ∑' x, ‖f x‖ₑ := by rw [← sum_mul, hA]; gcongr; exact hbox j
  -- the `ℓ²` bound, on `D`
  have htwo : ∀ j X (B : ℝ≥0), 0 < B →
      (∀ f : (Fin n → ℤ) → ℂ, MemLp f 2 Measure.count →
        eLpNorm (minorSup Ω d j X f) 2 Measure.count ≤ (B : ℝ≥0∞) * eLpNorm f 2 Measure.count) →
      HasStrongTypeOn (minorSupR Ω d j X) D 2 B Measure.count Measure.count := by
    intro j X B hB h f _
    rw [ENNReal.ofReal_ofNat, eLpNorm_minorSupR]
    by_cases hf2 : MemLp f 2 Measure.count
    · exact h f hf2
    · have : eLpNorm f 2 Measure.count = ∞ := by
        by_contra hne
        exact hf2 (memLp_iff.2 (lt_top_iff_ne_top.2 hne))
      rw [this, ENNReal.mul_top (by exact_mod_cast hB.ne')]
      exact le_top
  have hmeas : ∀ j X (f : (Fin n → ℤ) → ℂ),
      AEStronglyMeasurable (minorSupR Ω d j X f) Measure.count :=
    fun _ _ _ => AEStronglyMeasurable.of_discrete
  rcases lt_trichotomy p 2 with hp2 | rfl | hp2
  · -- `1 < p < 2`: interpolate between `(1,1)` and `(2,2)`, `θ = 2 - 2/p`
    set θ : ℝ := 2 - 2 / p
    have hθ : 1 / p = (1 - θ) / 1 + θ / 2 := by simp only [θ]; field_simp; ring
    have h1θ : 0 ≤ 1 - θ := by
      have : 1 ≤ 2 / p := by rw [le_div_iff₀ (by linarith)]; linarith
      simp only [θ]; linarith
    refine ⟨(marcinkiewiczConst 1 2 p : ℝ≥0∞) * (A : ℝ≥0∞) ^ (1 - θ),
      ENNReal.mul_ne_top ENNReal.coe_ne_top (ENNReal.rpow_ne_top_of_nonneg h1θ ENNReal.coe_ne_top),
      fun j X B hB h f hf => ?_⟩
    rw [paramA_eq_of_le_two hp hp2.le, ← eLpNorm_minorSupR]
    exact eLpNorm_le_of_hasWeakTypeOn one_pos hp hp2 hθ
      ((hone j X).hasWeakTypeOn one_pos) ((htwo j X B hB h).hasWeakTypeOn two_pos) (hsub j X) hD
      hf AEStronglyMeasurable.of_discrete (hmeas j X f)
  · -- `p = 2`
    refine ⟨1, ENNReal.one_ne_top, fun j X B _ h f hf => ?_⟩
    rw [paramA_eq_of_two_le hp le_rfl, div_self two_ne_zero, ENNReal.rpow_one, one_mul,
      ENNReal.ofReal_ofNat]
    exact h f (by simpa using hf)
  · -- `2 < p < ∞`: interpolate between `(2,2)` and `(∞,∞)`
    have h1 : 0 ≤ 1 - 2 / p := by rw [sub_nonneg, div_le_one (by linarith)]; linarith
    refine ⟨(marcinkiewiczConstTop 2 p : ℝ≥0∞) * (A : ℝ≥0∞) ^ (1 - 2 / p),
      ENNReal.mul_ne_top ENNReal.coe_ne_top (ENNReal.rpow_ne_top_of_nonneg h1 ENNReal.coe_ne_top),
      fun j X B hB h f hf => ?_⟩
    rw [paramA_eq_of_two_le hp hp2.le, ← eLpNorm_minorSupR]
    calc eLpNorm (minorSupR Ω d j X f) (ENNReal.ofReal p) Measure.count
        ≤ (marcinkiewiczConstTop 2 p : ℝ≥0∞) * (B : ℝ≥0∞) ^ (2 / p) * (A : ℝ≥0∞) ^ (1 - 2 / p) *
            eLpNorm f (ENNReal.ofReal p) Measure.count :=
          eLpNorm_le_of_hasWeakTypeOn_of_linfty two_pos hp2
            ((htwo j X B hB h).hasWeakTypeOn two_pos) (hinf j X) (hsub j X) hD hf
            AEStronglyMeasurable.of_discrete (hmeas j X f) (Or.inr hf.eLpNorm_ne_top)
      _ = _ := by ring


/-- Blueprint Construction 8.2 (`con:parameters`), eq. (8.2) (`eq:minorp`): let `n ≥ 1`, `d ≥ 1`,
`Ω` an admissible profile and `1 < p < ∞`, and let `r = paramR p`, `κ = paramKappa p`
(`κ a_p = 4 > 3`), `M = paramM n d Ω p ≥ 2` and `j₁ = paramJ1 n d Ω p` be the parameters of
Construction 8.2 (`M, j₁` from Lemma 8.1 (`lem:minorL2`) for this `κ`). There is a constant `C ≥ 0`
such that for every `j ≥ j₁` and every `f ∈ ℓ^p(ℤⁿ)`,
`‖sup_{λ ∉ X_j} |T_{j,λ} f|‖_{ℓ^p} ≤ C j^{-2} ‖f‖_{ℓ^p}`, where `X_j = minorArcs d M j`. -/
theorem minor_arc_decay_lp {n d : ℕ} (hn : 1 ≤ n) (hd : 1 ≤ d)
    {Ω : EuclideanSpace ℝ (Fin n) → ℂ} (hΩ : IsSWProfile Ω) {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ j ≥ paramJ1 n d Ω p, ∀ f : (Fin n → ℤ) → ℂ,
      MemLp f (ENNReal.ofReal p) Measure.count →
        eLpNorm (fun x => ⨆ (lam : ℝ) (_ : lam ∉ minorArcs d (paramM n d Ω p) j),
            ‖minorOp Ω d j lam f x‖ₑ) (ENNReal.ofReal p) Measure.count ≤
          ENNReal.ofReal (C * (j : ℝ) ^ (-2 : ℝ)) * eLpNorm f (ENNReal.ofReal p) Measure.count := by
  obtain ⟨C, hC, hdec⟩ := param_minor_arc_decay hn hd hΩ p
  obtain ⟨K, hK, hint⟩ := minorSup_lp_of_l2 (d := d) hΩ hp
  have ha := paramA_pos hp
  have hκa := paramKappa_mul_paramA hp
  refine ⟨K.toReal * (C + 1) ^ paramA p, by positivity, fun j hj f hf => ?_⟩
  have hj1 : 1 ≤ j := (one_le_paramJ1 hn hd hΩ p).trans hj
  have hJ : (1 : ℝ) ≤ j := by exact_mod_cast hj1
  have hJ0 : (0 : ℝ) < j := by linarith
  set b : ℝ := (C + 1) * (j : ℝ) ^ (-paramKappa p)
  have hb : 0 < b := by positivity
  have hB : ((b.toNNReal : ℝ≥0) : ℝ≥0∞) = ENNReal.ofReal b := rfl
  have h2 : ∀ g : (Fin n → ℤ) → ℂ, MemLp g 2 Measure.count →
      eLpNorm (minorSup Ω d j (minorArcs d (paramM n d Ω p) j) g) 2 Measure.count ≤
        ((b.toNNReal : ℝ≥0) : ℝ≥0∞) * eLpNorm g 2 Measure.count := by
    intro g hg
    refine (hdec j hj g hg).trans ?_
    rw [hB]
    gcongr
    have := Real.rpow_pos_of_pos hJ0 (-paramKappa p)
    simp only [b]; nlinarith
  refine (hint j _ b.toNNReal (Real.toNNReal_pos.2 hb) h2 f hf).trans ?_
  rw [hB, ENNReal.ofReal_rpow_of_nonneg hb.le ha.le]
  gcongr
  rw [mul_assoc, ENNReal.ofReal_mul ENNReal.toReal_nonneg, ENNReal.ofReal_toReal hK]
  gcongr
  simp only [b]
  rw [Real.mul_rpow (by linarith) (by positivity), ← Real.rpow_mul hJ0.le, neg_mul, hκa]
  gcongr
  norm_num

end MinorArcs

section Lifting

/-!
## The rational lifting operators and their arithmetic bound

Results from §9 ("The rational lifting operators and their arithmetic bound") of
`blueprints/discrete-sw.tex`: the setup of §9, Blueprint Lemma 9.1 (`lem:liftkernel`) and
Blueprint Lemma 9.2 (`lem:arithmax`).

### Conventions

Mathlib Fourier sign and the lattice/torus conventions of section `Sampling`
(`latKernel m y = ∫_{[0,1)ⁿ} m(ξ) e(y · ξ) dξ`, `periodize`, `gridPt q b = b/q`). The fixed
parameters `(n, d, Ω, p)` enter through `M = paramM n d Ω p`, `ρ = paramRho n d Ω p`,
`r = paramR p` and `𝒰_N = paramGoodSet n d Ω p N` (Construction 8.2); `D = 2d`.

### Definitions (§9 setup)

* cutoffs: `liftCutoff n = χ` (`χ(ξ) = θ(2ξ)`, `θ = companionCutoff n`), and `χ̃ = θ` itself;
  the scaled cutoffs `liftChi … s = χ_s = χ(L_s ·)` and `liftChiT … s = χ̃_s = χ̃(L_s ·)`;
* scales (eq. (9.1), `eq:vs`): `liftN s = N_s = 2^s`, the constant `liftCStar = C_*`,
  `liftV … s = v_s = ⌈C_*(s+1)(1 + 2^{s/(2M)})⌉`, `liftL … s = L_s = 2^{v_s}`; the constant
  `liftCrho = C_{ρ,r}` is a choice from `goodBlocks_eps_threshold`;
* `liftRat s = 𝓡_s` (pairs `(a, q)` with `N_s/2 ≤ q < N_s`, `0 ≤ a < q`, `(a,q) = 1`);
* `gaussSum n d a q b = S(a/q, b/q) = q^{-n} ∑_{z mod q} e((a/q) P(z) - z · b/q)` (`eq:Gaussdef`,
  in the Mathlib sign: `∑_β S(α,β) e(β · y) = e(α P(y))`, `sum_gaussSum_mul_eC`);
* `liftSym … s a q m = Lift_{s,a/q}[m]` (`eq:Liftdef`), `liftA … s a q = A_{s,a/q}`,
  `liftD … s m = D_s[m] = ∑_{β ∈ 𝒰_{N_s}} (m χ̃_s)_per(· - β)`; `liftPhi … s = φ_s = 𝓕⁻ χ_s`.

### Results

* eq. (9.2) (`eq:scalerequirements`): `exists_liftCStar`, `liftV_ge`, `four_div_liftL_le`;
  consequences `liftEps_threshold` (hypothesis (7.1) with `ε = 4/L_s`), `lift_transference`
  (Theorem 7.7 for `𝒰_{N_s}` with `ε = 4/L_s`) and `liftBump_center_atMostOne` (disjointness of
  the enlarged bumps at the centers of `𝒰_{N_s}`); `liftChi_mul_liftChiT` (`χ_s χ̃_s = χ_s`);
* Blueprint Lemma 9.1 (`lem:liftkernel`): `latKernel_liftSym`, `latKernel_liftSym_of_bdd`,
  `latKernel_liftA`, and the envelope bound `norm_liftPhi_le` (`|φ_s(y)| ≤ C B_{L_s}(y)`).
* Blueprint Lemma 9.2 (`lem:arithmax`): eq. (9.5) `arith_maximal_decay`
  (`‖sup_{α ∈ 𝓡_s} |A_{s,α} f|‖₂ ≤ C 2^{-γ s} ‖f‖₂`) and eq. (9.6)
  `arith_maximal_decay_vector` (the `ℓ^t(ℓ²)` bound, `1 < t < ∞`, with `δ_t = γ min(2/t, 2/t')`).
* Blueprint Lemma 9.3 (`lem:liftsquare`): eq. (9.8) `liftSym_eq_liftA_mul_liftD` (symbols), with
  the operator forms `latMult_liftSym_eq_tsum` (`Lift[m](D) f = Ǎ * (D_s[m](D) f)`) and
  `latMult_liftSym_eq_latMult` (when `D_s[m](D) f ∈ ℓ¹`); eq. (9.9) `lift_square_two`; eq. (9.10)
  `lift_square_p`. Since `D_s[m](D) f` need not be in `ℓ¹` for merely bounded `m`, eq. (9.6) is
  first extended to bounded inputs (`arith_maximal_decay_vector_bdd`: windows `w_N` and Fatou).
  Ingredients: disjointness of the good-set bumps (`liftChiT_center_unique`,
  `cosetSymbol_eq_of_liftChiT`), Bessel (`eLpNorm_sqrt_sum_liftD_two_le`), Young for the cutoff
  (`eLpNorm_fourierInv_mul_liftChiT_le`, uniform `‖𝓕⁻ χ̃_s‖₁`), lower Khintchine
  (`eLpNorm_sqrt_sum_le_of_rademacher`) and `lift_transference`.
* Blueprint Lemma 9.4 (`lem:liftenvelope`): `lift_envelope` (pointwise, uniform in `j, μ, α`) and
  `lift_envelope_sup` (the supremum at fixed `s`), from the general kernel bound
  `norm_latMult_liftSym_fourier_le` (`|H| ≤ K B_R` gives
  `|Lift[𝓕 H](D) f| ≤ C K B_{max(R,L_s)} * |f|`).
-/

open MeasureTheory Set Real Finset
open scoped FourierTransform ContDiff SchwartzMap

variable {n : ℕ}

/-! ### The cutoffs `χ` and `χ̃` -/

/-- `χ̃ = θ = companionCutoff n` is even. -/
lemma companionCutoff_neg (ξ : EuclideanSpace ℝ (Fin n)) :
    companionCutoff n (-ξ) = companionCutoff n ξ := by
  unfold companionCutoff
  refine Finset.prod_congr rfl fun i _ => ?_
  rw [PiLp.neg_apply]
  exact companionBump.neg _

/-- The smooth real even product cutoff `χ(ξ) = θ(2ξ) = ∏ᵢ ψ(2ξᵢ)` of the §9 setup: `0 ≤ χ ≤ 1`,
`χ = 1` on `[-1/2,1/2]ⁿ`, `supp χ ⊆ [-1,1]ⁿ`. -/
noncomputable def liftCutoff (n : ℕ) (ξ : EuclideanSpace ℝ (Fin n)) : ℝ :=
  companionCutoff n ((2 : ℝ) • ξ)

/-- `χ` is a product cutoff: `χ(ξ) = ∏ᵢ ψ(2ξᵢ)`. -/
lemma liftCutoff_eq_prod (ξ : EuclideanSpace ℝ (Fin n)) :
    liftCutoff n ξ = ∏ i, companionBump (2 * ξ i) := by
  simp [liftCutoff, companionCutoff, PiLp.smul_apply, smul_eq_mul]

lemma liftCutoff_nonneg (ξ : EuclideanSpace ℝ (Fin n)) : 0 ≤ liftCutoff n ξ :=
  companionCutoff_nonneg _

lemma liftCutoff_le_one (ξ : EuclideanSpace ℝ (Fin n)) : liftCutoff n ξ ≤ 1 :=
  companionCutoff_le_one _

lemma liftCutoff_neg (ξ : EuclideanSpace ℝ (Fin n)) : liftCutoff n (-ξ) = liftCutoff n ξ := by
  rw [liftCutoff, smul_neg, companionCutoff_neg, liftCutoff]

lemma liftCutoff_eq_one {ξ : EuclideanSpace ℝ (Fin n)} (h : ∀ i, |ξ i| ≤ 1 / 2) :
    liftCutoff n ξ = 1 :=
  companionCutoff_eq_one fun i => by
    rw [PiLp.smul_apply, smul_eq_mul, abs_mul, abs_two]
    linarith [h i]

lemma liftCutoff_eq_zero {ξ : EuclideanSpace ℝ (Fin n)} (h : ¬ ∀ i, |ξ i| < 1) :
    liftCutoff n ξ = 0 := by
  refine companionCutoff_eq_zero fun h' => h fun i => ?_
  have := h' i
  rw [PiLp.smul_apply, smul_eq_mul, abs_mul, abs_two] at this
  linarith

/-- `supp χ ⊆ [-1,1]ⁿ`. -/
lemma support_liftCutoff :
    Function.support (liftCutoff n) ⊆ {ξ | ∀ i, |ξ i| ≤ 1} := fun ξ hξ i => by
  by_contra h
  exact hξ (liftCutoff_eq_zero fun h' => h (h' i).le)

/-- `supp χ̃ ⊆ [-2,2]ⁿ`. -/
lemma support_companionCutoff :
    Function.support (companionCutoff n) ⊆ {ξ | ∀ i, |ξ i| ≤ 2} := fun _ hξ i => by
  by_contra h
  exact hξ (companionCutoff_eq_zero fun h' => h (h' i).le)

lemma contDiff_liftCutoff : ContDiff ℝ ∞ (liftCutoff n) :=
  contDiff_companionCutoff.comp (contDiff_const_smul (2 : ℝ))

lemma hasCompactSupport_liftCutoff : HasCompactSupport (liftCutoff n) :=
  HasCompactSupport.intro (isCompact_box 1) fun _ hξ =>
    liftCutoff_eq_zero fun h => hξ fun i => (h i).le

/-- The cutoff `χ` as a (complex-valued) Schwartz function. -/
noncomputable def liftCutoffSchwartz (n : ℕ) : 𝓢(EuclideanSpace ℝ (Fin n), ℂ) :=
  (hasCompactSupport_liftCutoff (n := n)).comp_left (g := Complex.ofReal) Complex.ofReal_zero
    |>.toSchwartzMap (Complex.ofRealCLM.contDiff.comp contDiff_liftCutoff)

@[simp] lemma liftCutoffSchwartz_apply (ξ : EuclideanSpace ℝ (Fin n)) :
    liftCutoffSchwartz n ξ = (liftCutoff n ξ : ℂ) := rfl

/-- `χ θ = χ` (`θ = χ̃ = 1` on `supp χ`). -/
lemma liftCutoff_mul_companionCutoff (ξ : EuclideanSpace ℝ (Fin n)) :
    liftCutoff n ξ * companionCutoff n ξ = liftCutoff n ξ := by
  by_cases h : liftCutoff n ξ = 0
  · rw [h, zero_mul]
  · rw [companionCutoff_eq_one fun i => support_liftCutoff h i, mul_one]

/-! ### Scales (eq. (9.1), `eq:vs`) -/

/-- `r = paramR p ≥ 1` (for every real `p`). -/
lemma one_le_paramR (p : ℝ) : 1 ≤ paramR p := by unfold paramR; omega

/-- The constant `C_{ρ,r}` of `goodBlocks_eps_threshold` for `ρ = paramRho`, `r = paramR p`
(a fixed choice). -/
noncomputable def liftCrho (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) : ℝ :=
  Classical.choose (goodBlocks_eps_threshold (paramRho_pos n d Ω p) (paramR p) (one_le_paramR p))

lemma liftCrho_spec (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) :
    0 < liftCrho n d Ω p ∧ ∀ N : ℕ, 2 ≤ N → ∀ ε : ℝ, 0 < ε →
      ε ≤ Real.exp (-(liftCrho n d Ω p * (N : ℝ) ^ (2 * paramRho n d Ω p))) →
      ε ≤ (100 * paramR p * (blockStar (goodBlocks (paramRho n d Ω p) N) : ℝ) ^
        (2 * paramR p * goodK (paramRho n d Ω p)))⁻¹ :=
  Classical.choose_spec
    (goodBlocks_eps_threshold (paramRho_pos n d Ω p) (paramR p) (one_le_paramR p))

/-- `N_s = 2^s` of eq. (9.1) (`eq:vs`). -/
def liftN (s : ℕ) : ℕ := 2 ^ s

/-- The constant `C_* = 100 (n + D + 1) + 2 C_{ρ,r} + 2` (`D = 2d`) of eq. (9.1) (`eq:vs`),
chosen so that eq. (9.2) (`eq:scalerequirements`) holds (`exists_liftCStar`). -/
noncomputable def liftCStar (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) : ℝ :=
  100 * ((n : ℝ) + 2 * d + 1) + 2 * liftCrho n d Ω p + 2

/-- `v_s = ⌈C_* (s+1)(1 + 2^{s/(2M)})⌉` of eq. (9.1) (`eq:vs`). -/
noncomputable def liftV (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ) : ℕ :=
  ⌈liftCStar n d Ω p * ((s : ℝ) + 1) *
    (1 + (2 : ℝ) ^ ((s : ℝ) / (2 * (paramM n d Ω p : ℝ))))⌉₊

/-- `L_s = 2^{v_s}` of eq. (9.1) (`eq:vs`). -/
noncomputable def liftL (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ) : ℕ :=
  2 ^ liftV n d Ω p s

/-- `χ_s(ξ) = χ(L_s ξ)` of eq. (9.1) (`eq:vs`). -/
noncomputable def liftChi (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ)
    (ξ : EuclideanSpace ℝ (Fin n)) : ℝ :=
  liftCutoff n ((liftL n d Ω p s : ℝ) • ξ)

/-- `χ̃_s(ξ) = χ̃(L_s ξ)` of eq. (9.1) (`eq:vs`), with `χ̃ = θ = companionCutoff n`. -/
noncomputable def liftChiT (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ)
    (ξ : EuclideanSpace ℝ (Fin n)) : ℝ :=
  companionCutoff n ((liftL n d Ω p s : ℝ) • ξ)

variable {d : ℕ} {Ω : EuclideanSpace ℝ (Fin n) → ℂ} {p : ℝ}

lemma liftCrho_pos : 0 < liftCrho n d Ω p := (liftCrho_spec n d Ω p).1

lemma liftCStar_pos : 0 < liftCStar n d Ω p := by
  have := liftCrho_pos (n := n) (d := d) (Ω := Ω) (p := p)
  unfold liftCStar; positivity

lemma liftL_pos (s : ℕ) : (0 : ℝ) < liftL n d Ω p s := by unfold liftL; positivity

lemma two_le_liftN {s : ℕ} (hs : 1 ≤ s) : 2 ≤ liftN s := by
  unfold liftN
  calc 2 = 2 ^ 1 := rfl
    _ ≤ 2 ^ s := Nat.pow_le_pow_right (by norm_num) hs

/-- The core of eq. (9.2): for every `C ≥ 100 (n + D + 1) + 2 C_{ρ,r} + 2` and every `s`, the
integer `v = ⌈C(s+1)(1 + 2^{s/(2M)})⌉` satisfies `v ≥ 100(n+D+1)(s+1)` and
`4/2^v ≤ exp(-C_{ρ,r} N_s^{2ρ})`. -/
lemma scale_requirements_of_le {C : ℝ}
    (hC : 100 * ((n : ℝ) + 2 * d + 1) + 2 * liftCrho n d Ω p + 2 ≤ C) (s : ℕ) :
    100 * (n + 2 * d + 1) * (s + 1) ≤
        ⌈C * ((s : ℝ) + 1) * (1 + (2 : ℝ) ^ ((s : ℝ) / (2 * (paramM n d Ω p : ℝ))))⌉₊ ∧
      4 / (2 : ℝ) ^ ⌈C * ((s : ℝ) + 1) *
          (1 + (2 : ℝ) ^ ((s : ℝ) / (2 * (paramM n d Ω p : ℝ))))⌉₊ ≤
        Real.exp (-(liftCrho n d Ω p * ((liftN s : ℕ) : ℝ) ^ (2 * paramRho n d Ω p))) := by
  set M : ℝ := (paramM n d Ω p : ℝ)
  set ρ := paramRho n d Ω p
  set K := liftCrho n d Ω p
  have hK : 0 < K := liftCrho_pos
  set t : ℝ := (2 : ℝ) ^ ((s : ℝ) / (2 * M))
  have hM : (2 : ℝ) ≤ M := by simp only [M]; exact_mod_cast two_le_paramM n d Ω p
  have ht1 : 1 ≤ t := Real.one_le_rpow (by norm_num) (by positivity)
  have hs0 : (0 : ℝ) ≤ s := Nat.cast_nonneg s
  have hC0 : 100 * ((n : ℝ) + 2 * d + 1) ≤ C := by linarith
  set v := ⌈C * ((s : ℝ) + 1) * (1 + t)⌉₊
  have hv : C * ((s : ℝ) + 1) * (1 + t) ≤ v := Nat.le_ceil _
  have hCpos : 0 ≤ C := by
    have : (0 : ℝ) ≤ 100 * ((n : ℝ) + 2 * d + 1) := by positivity
    linarith
  have hCs : C * ((s : ℝ) + 1) ≤ C * ((s : ℝ) + 1) * (1 + t) := by
    have : 0 ≤ C * ((s : ℝ) + 1) := by positivity
    nlinarith
  have hCt : C * (1 + t) ≤ C * ((s : ℝ) + 1) * (1 + t) := by
    have : 0 ≤ C * (1 + t) := by positivity
    nlinarith
  refine ⟨?_, ?_⟩
  · have h1 : ((100 * (n + 2 * d + 1) * (s + 1) : ℕ) : ℝ) ≤ v := by
      push_cast
      have : 100 * ((n : ℝ) + 2 * d + 1) * ((s : ℝ) + 1) ≤ C * ((s : ℝ) + 1) :=
        mul_le_mul_of_nonneg_right hC0 (by positivity)
      linarith
    exact_mod_cast h1
  · -- `N_s^{2ρ} ≤ t`
    have hNt : ((liftN s : ℕ) : ℝ) ^ (2 * ρ) ≤ t := by
      have h2ρ : 2 * ρ < 1 / (2 * M) := two_mul_paramRho_lt n d Ω p
      rw [liftN, Nat.cast_pow, Nat.cast_ofNat, ← Real.rpow_natCast, ← Real.rpow_mul (by norm_num)]
      refine Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_
      rw [div_eq_mul_one_div (s : ℝ)]
      exact mul_le_mul_of_nonneg_left h2ρ.le hs0
    have hl2 : (1 / 2 : ℝ) < Real.log 2 := by
      have := Real.log_two_gt_d9; linarith
    have hl2' : Real.log 2 < 1 := by
      have := Real.log_two_lt_d9; linarith
    have hl0 : 0 < Real.log 2 := by linarith
    -- `v log 2 ≥ K N^{2ρ} + 2 log 2`
    have hkey : K * ((liftN s : ℕ) : ℝ) ^ (2 * ρ) + 2 * Real.log 2 ≤ v * Real.log 2 := by
      have h1 : (2 * K + 2) * (1 + t) ≤ v := by
        have : (2 * K + 2) * (1 + t) ≤ C * (1 + t) :=
          mul_le_mul_of_nonneg_right (by linarith) (by linarith)
        linarith
      have h2 : (2 * K + 2) * (1 + t) * Real.log 2 ≤ v * Real.log 2 :=
        mul_le_mul_of_nonneg_right h1 hl0.le
      have h3 : (K + 1) * (1 + t) ≤ (2 * K + 2) * (1 + t) * Real.log 2 := by
        have : 0 ≤ (K + 1) * (1 + t) := by positivity
        nlinarith
      have h4 : K * ((liftN s : ℕ) : ℝ) ^ (2 * ρ) ≤ K * t := mul_le_mul_of_nonneg_left hNt hK.le
      nlinarith
    have h2v : (2 : ℝ) ^ v = Real.exp (v * Real.log 2) := by
      rw [Real.exp_nat_mul, Real.exp_log (by norm_num)]
    have h4 : (4 : ℝ) = Real.exp (2 * Real.log 2) := by
      rw [show (2 : ℝ) * Real.log 2 = ((2 : ℕ) : ℝ) * Real.log 2 by norm_num, Real.exp_nat_mul,
        Real.exp_log (by norm_num)]
      norm_num
    rw [h2v, h4, ← Real.exp_sub]
    exact Real.exp_le_exp.2 (by linarith)

/-- Eq. (9.2) (`eq:scalerequirements`) of the §9 setup, existence of `C_*`: there is `C_* > 0`
such that for every `s ≥ 1`, `v_s = ⌈C_*(s+1)(1 + 2^{s/(2M)})⌉` satisfies
`v_s ≥ 100(n+D+1)(s+1)` (`D = 2d`) and `4/2^{v_s} ≤ exp(-C_{ρ,r} N_s^{2ρ})`; the choice
`C_* = liftCStar` used in `liftV` is such a constant. -/
theorem exists_liftCStar (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) :
    ∃ C : ℝ, 0 < C ∧ C = liftCStar n d Ω p ∧ ∀ s : ℕ, 1 ≤ s →
      100 * (n + 2 * d + 1) * (s + 1) ≤
          ⌈C * ((s : ℝ) + 1) * (1 + (2 : ℝ) ^ ((s : ℝ) / (2 * (paramM n d Ω p : ℝ))))⌉₊ ∧
        4 / (2 : ℝ) ^ ⌈C * ((s : ℝ) + 1) *
            (1 + (2 : ℝ) ^ ((s : ℝ) / (2 * (paramM n d Ω p : ℝ))))⌉₊ ≤
          Real.exp (-(liftCrho n d Ω p * ((liftN s : ℕ) : ℝ) ^ (2 * paramRho n d Ω p))) :=
  ⟨liftCStar n d Ω p, liftCStar_pos, rfl, fun s _ => scale_requirements_of_le le_rfl s⟩

/-- Eq. (9.2) (`eq:scalerequirements`), first requirement: `v_s ≥ 100(n+D+1)(s+1)` (`D = 2d`;
it holds for every `s`, in particular for `s ≥ 1`). -/
theorem liftV_ge (s : ℕ) : 100 * (n + 2 * d + 1) * (s + 1) ≤ liftV n d Ω p s :=
  (scale_requirements_of_le le_rfl s).1

/-- Eq. (9.2) (`eq:scalerequirements`), second requirement: `4/L_s ≤ exp(-C_{ρ,r} N_s^{2ρ})`
(for every `s`, in particular for `s ≥ 1`). -/
theorem four_div_liftL_le (s : ℕ) :
    4 / (liftL n d Ω p s : ℝ) ≤
      Real.exp (-(liftCrho n d Ω p * ((liftN s : ℕ) : ℝ) ^ (2 * paramRho n d Ω p))) := by
  have := (scale_requirements_of_le (n := n) (d := d) (Ω := Ω) (p := p) le_rfl s).2
  rw [liftL, Nat.cast_pow, Nat.cast_ofNat]
  exact this

/-- `L_s ≥ 2^{100(n+D+1)(s+1)}`, a consequence of eq. (9.2) (`eq:scalerequirements`). -/
theorem pow_le_liftL (s : ℕ) : 2 ^ (100 * (n + 2 * d + 1) * (s + 1)) ≤ liftL n d Ω p s :=
  Nat.pow_le_pow_right (by norm_num) (liftV_ge s)

/-- Consequence of eq. (9.2) (`eq:scalerequirements`): for `s ≥ 1`, `ε = 4/L_s` satisfies
hypothesis (7.1) of Theorem 7.7 (`thm:IW`) for the blocks of `𝒰_{N_s}`:
`4/L_s ≤ (100 r q_*^{2rk})⁻¹`. -/
theorem liftEps_threshold {s : ℕ} (hs : 1 ≤ s) :
    4 / (liftL n d Ω p s : ℝ) ≤
      (100 * paramR p * (blockStar (goodBlocks (paramRho n d Ω p) (liftN s)) : ℝ) ^
        (2 * paramR p * goodK (paramRho n d Ω p)))⁻¹ :=
  (liftCrho_spec n d Ω p).2 (liftN s) (two_le_liftN hs) _
    (div_pos (by norm_num) (liftL_pos s)) (four_div_liftL_le s)

/-- Consequence of eq. (9.2) (`eq:scalerequirements`): Theorem 7.7 (`thm:IW`) applies to
`𝒰_{N_s}` with `ε = 4/L_s`. For `1 < p`, `r = paramR p`, there is `C ≥ 0` such that for every
`s ≥ 1`, every bounded measurable `m` supported in `[-2/L_s, 2/L_s]ⁿ` with Euclidean `L^{2r}`
multiplier norm `≤ A`, and every finitely supported `f`,
`‖T_{m;𝒰_{N_s}} f‖_{ℓ^p} ≤ C A ‖f‖_{ℓ^p}`. -/
theorem lift_transference (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ s : ℕ, 1 ≤ s →
      ∀ (m : EuclideanSpace ℝ (Fin n) → ℂ) (B A : ℝ), AEStronglyMeasurable m volume →
      (∀ ξ, ‖m ξ‖ ≤ B) →
      Function.support m ⊆ {ξ | ∀ i, |ξ i| ≤ 2 / (liftL n d Ω p s : ℝ)} →
      (∀ F : 𝓢(EuclideanSpace ℝ (Fin n), ℂ),
        eLpNorm (𝓕⁻ (fun ξ => m ξ * 𝓕 (F : EuclideanSpace ℝ (Fin n) → ℂ) ξ))
          (ENNReal.ofReal (2 * paramR p)) volume ≤
            ENNReal.ofReal A * eLpNorm F (ENNReal.ofReal (2 * paramR p)) volume) →
      ∀ f : (Fin n → ℤ) → ℂ, (Function.support f).Finite →
        eLpNorm (cosetMult (blockProd (goodBlocks (paramRho n d Ω p) (liftN s))) m
            (paramGoodSet n d Ω p (liftN s)) f) (ENNReal.ofReal p) Measure.count ≤
          ENNReal.ofReal (C * A) * eLpNorm f (ENNReal.ofReal p) Measure.count := by
  obtain ⟨C, hC, hT⟩ := coprime_block_multiplier_transference n (goodK (paramRho n d Ω p))
    (paramR p) (one_le_paramR p) (paramR_exponent_range hp).1 (paramR_exponent_range hp).2
  refine ⟨C, hC, fun s hs m B A hm hB hsupp hA f hf => ?_⟩
  have hL := liftL_pos (n := n) (d := d) (Ω := Ω) (p := p) s
  refine hT (goodBlocks (paramRho n d Ω p) (liftN s)) goodBlocks_one_lt
    goodBlocks_pairwise_coprime (4 / (liftL n d Ω p s : ℝ)) (by positivity)
    (liftEps_threshold hs) m B A hm hB ?_ hA f hf
  refine hsupp.trans fun ξ hξ i => ?_
  have := hξ i
  rw [div_div, show (4 : ℝ) / (liftL n d Ω p s * 2) = 2 / liftL n d Ω p s by field_simp; ring]
  exact this

/-! ### Properties of the scaled cutoffs -/

lemma liftChi_nonneg (s : ℕ) (ξ : EuclideanSpace ℝ (Fin n)) : 0 ≤ liftChi n d Ω p s ξ :=
  liftCutoff_nonneg _

lemma liftChi_le_one (s : ℕ) (ξ : EuclideanSpace ℝ (Fin n)) : liftChi n d Ω p s ξ ≤ 1 :=
  liftCutoff_le_one _

lemma liftChiT_nonneg (s : ℕ) (ξ : EuclideanSpace ℝ (Fin n)) : 0 ≤ liftChiT n d Ω p s ξ :=
  companionCutoff_nonneg _

lemma liftChiT_le_one (s : ℕ) (ξ : EuclideanSpace ℝ (Fin n)) : liftChiT n d Ω p s ξ ≤ 1 :=
  companionCutoff_le_one _

/-- `supp χ_s ⊆ [-1/L_s, 1/L_s]ⁿ`. -/
lemma support_liftChi (s : ℕ) :
    Function.support (liftChi n d Ω p s) ⊆
      {ξ | ∀ i, |ξ i| ≤ 1 / (liftL n d Ω p s : ℝ)} := fun ξ hξ i => by
  have hL := liftL_pos (n := n) (d := d) (Ω := Ω) (p := p) s
  have := support_liftCutoff hξ i
  rw [PiLp.smul_apply, smul_eq_mul, abs_mul, abs_of_pos hL] at this
  rw [le_div_iff₀ hL]; linarith

/-- `supp χ̃_s ⊆ [-2/L_s, 2/L_s]ⁿ`. -/
lemma support_liftChiT (s : ℕ) :
    Function.support (liftChiT n d Ω p s) ⊆
      {ξ | ∀ i, |ξ i| ≤ 2 / (liftL n d Ω p s : ℝ)} := fun ξ hξ i => by
  have hL := liftL_pos (n := n) (d := d) (Ω := Ω) (p := p) s
  have := support_companionCutoff hξ i
  rw [PiLp.smul_apply, smul_eq_mul, abs_mul, abs_of_pos hL] at this
  rw [le_div_iff₀ hL]; linarith

/-- `χ_s χ̃_s = χ_s`. -/
lemma liftChi_mul_liftChiT (s : ℕ) (ξ : EuclideanSpace ℝ (Fin n)) :
    liftChi n d Ω p s ξ * liftChiT n d Ω p s ξ = liftChi n d Ω p s ξ :=
  liftCutoff_mul_companionCutoff _

/-- Consequence of eq. (9.2) (`eq:scalerequirements`) (§9 setup, "all bumps centered at
`𝒰_{N_s}` used below are disjoint"): for `s ≥ 1` and any symbol `m`, at most one center
`γ ∈ 𝒰_{N_s}` has `(m χ̃_s)_per(ξ - γ) ≠ 0`. -/
theorem liftBump_center_atMostOne {s : ℕ} (hs : 1 ≤ s) (m : EuclideanSpace ℝ (Fin n) → ℂ)
    {γ γ' : Fin n → ZMod (blockProd (goodBlocks (paramRho n d Ω p) (liftN s)))}
    (hγ : γ ∈ paramGoodSet n d Ω p (liftN s)) (hγ' : γ' ∈ paramGoodSet n d Ω p (liftN s))
    (ξ : EuclideanSpace ℝ (Fin n))
    (h : periodize (fun η => m η * (liftChiT n d Ω p s η : ℂ))
      (ξ - ratPt (blockProd (goodBlocks (paramRho n d Ω p) (liftN s))) γ) ≠ 0)
    (h' : periodize (fun η => m η * (liftChiT n d Ω p s η : ℂ))
      (ξ - ratPt (blockProd (goodBlocks (paramRho n d Ω p) (liftN s))) γ') ≠ 0) :
    γ = γ' := by
  have hL := liftL_pos (n := n) (d := d) (Ω := Ω) (p := p) s
  refine periodize_center_atMostOne (ε := 4 / (liftL n d Ω p s : ℝ)) ?_ goodBlocks_one_lt
    goodBlocks_pairwise_coprime (by positivity) (liftEps_threshold hs) hγ hγ' ξ h h'
  intro η hη i
  have hχ : liftChiT n d Ω p s η ≠ 0 := by
    intro h0; apply hη; rw [h0, Complex.ofReal_zero, mul_zero]
  have := support_liftChiT s hχ i
  refine this.trans ?_
  rw [div_le_iff₀ hL, mul_assoc, div_mul_cancel₀ _ hL.ne']
  norm_num

/-! ### The rational frequencies `𝓡_s`, Gauss sums and the lifted symbols -/

/-- `𝓡_s = {a/q : (a,q) = 1, 0 ≤ a < q, N_s/2 ≤ q < N_s}` of the §9 setup, as the finite set of
pairs `(a, q)` (the condition `N_s/2 ≤ q` is written `N_s ≤ 2q`). -/
def liftRat (s : ℕ) : Finset (ℕ × ℕ) :=
  ((range (liftN s)) ×ˢ (range (liftN s))).filter fun aq =>
    liftN s ≤ 2 * aq.2 ∧ aq.1 < aq.2 ∧ Nat.Coprime aq.1 aq.2

lemma mem_liftRat {s a q : ℕ} :
    (a, q) ∈ liftRat s ↔ liftN s ≤ 2 * q ∧ q < liftN s ∧ a < q ∧ Nat.Coprime a q := by
  simp only [liftRat, mem_filter, mem_product, Finset.mem_range]
  constructor
  · rintro ⟨⟨_, h2⟩, h3, h4, h5⟩; exact ⟨h3, h2, h4, h5⟩
  · rintro ⟨h3, h2, h4, h5⟩; exact ⟨⟨by omega, h2⟩, h3, h4, h5⟩

/-- The §9 setup: `𝓡_s` has at most `N_s²` elements. -/
theorem card_liftRat_le (s : ℕ) : (liftRat s).card ≤ liftN s ^ 2 := by
  refine (card_filter_le _ _).trans ?_
  rw [card_product, card_range, sq]

lemma one_le_of_mem_liftRat {s a q : ℕ} (h : (a, q) ∈ liftRat s) : 1 ≤ q := by
  have := (mem_liftRat.1 h).2.2.1; omega

/-- The integer vector `(zᵢ)ᵢ ∈ ℤⁿ` of a residue vector `z ∈ {0, …, q-1}ⁿ`. -/
def finIntVec {q : ℕ} (z : Fin n → Fin q) : Fin n → ℤ := fun i => ((z i : ℕ) : ℤ)

/-- The Gauss sum `S(α, β) = q^{-n} ∑_{z mod q} e(α P(z) - z · β)`, `α = a/q`, `β = b/q`, of
eq. (`eq:Gaussdef`), in the Mathlib sign convention (the blueprint's `+β · z` becomes `-z · β`),
so that `∑_β S(α, β) e(β · y) = e(α P(y))` (`sum_gaussSum_mul_eC`). -/
noncomputable def gaussSum (n d a q : ℕ) (b : Fin n → Fin q) : ℂ :=
  ((q : ℂ) ^ n)⁻¹ * ∑ z : Fin n → Fin q,
    eC ((a : ℝ) / q * (radialPolyZ n d (finIntVec z) : ℝ) -
      inner ℝ (latEmbed (finIntVec z)) (gridPt q b))

/-- The lifted symbol `Lift_{s,α}[m](ξ) = ∑_{β ∈ T[q]} S(α, β) (m χ_s)_per(ξ - β)`, `α = a/q`,
of eq. (`eq:Liftdef`). -/
noncomputable def liftSym (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s a q : ℕ)
    (m : EuclideanSpace ℝ (Fin n) → ℂ) (ξ : EuclideanSpace ℝ (Fin n)) : ℂ :=
  ∑ b : Fin n → Fin q, gaussSum n d a q b *
    periodize (fun η => m η * (liftChi n d Ω p s η : ℂ)) (ξ - gridPt q b)

/-- `A_{s,α} = Lift_{s,α}[1]` of the §9 setup, `α = a/q`. -/
noncomputable def liftA (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s a q : ℕ) :
    EuclideanSpace ℝ (Fin n) → ℂ :=
  liftSym n d Ω p s a q fun _ => 1

/-- `D_s[m](ξ) = ∑_{β ∈ 𝒰_{N_s}} (m χ̃_s)_per(ξ - β)` of the §9 setup. -/
noncomputable def liftD (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ)
    (m : EuclideanSpace ℝ (Fin n) → ℂ) : EuclideanSpace ℝ (Fin n) → ℂ :=
  cosetSymbol (blockProd (goodBlocks (paramRho n d Ω p) (liftN s)))
    (fun η => m η * (liftChiT n d Ω p s η : ℂ)) (paramGoodSet n d Ω p (liftN s))

/-- `φ_s = 𝓕⁻ χ_s` of Blueprint Lemma 9.1 (`lem:liftkernel`). -/
noncomputable def liftPhi (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ) :
    EuclideanSpace ℝ (Fin n) → ℂ :=
  𝓕⁻ fun ξ => (liftChi n d Ω p s ξ : ℂ)

/-! ### Blueprint Lemma 9.1 (`lem:liftkernel`) -/

/-- The residue vector `y mod q ∈ {0, …, q-1}ⁿ`. -/
def resVec {q : ℕ} (hq : 1 ≤ q) (y : Fin n → ℤ) : Fin n → Fin q := fun i =>
  ⟨(y i % q).toNat, by
    have h0 : (0 : ℤ) < q := by exact_mod_cast hq
    have h1 := Int.emod_nonneg (y i) h0.ne'
    have h2 := Int.emod_lt_of_pos (y i) h0
    omega⟩

lemma finIntVec_resVec {q : ℕ} (hq : 1 ≤ q) (y : Fin n → ℤ) (i : Fin n) :
    finIntVec (resVec hq y) i = y i % q := by
  have h0 : (0 : ℤ) < q := by exact_mod_cast hq
  have h1 := Int.emod_nonneg (y i) h0.ne'
  simp only [finIntVec, resVec]
  omega

/-- `q ∣ yᵢ - zᵢ` for all `i` iff `z = y mod q`. -/
lemma dvd_sub_finIntVec_iff {q : ℕ} (hq : 1 ≤ q) (y : Fin n → ℤ) (z : Fin n → Fin q) :
    (∀ i, (q : ℤ) ∣ (y - finIntVec z) i) ↔ z = resVec hq y := by
  have h0 : (0 : ℤ) < q := by exact_mod_cast hq
  constructor
  · intro h
    funext i
    have hi : finIntVec z i ≡ y i [ZMOD q] := (Int.modEq_iff_dvd.2 (h i))
    have hz0 : 0 ≤ finIntVec z i := by simp [finIntVec]
    have hzq : finIntVec z i < q := by simp only [finIntVec]; exact_mod_cast (z i).2
    have he : finIntVec z i % q = finIntVec z i := Int.emod_eq_of_lt hz0 hzq
    have h2 : finIntVec z i = y i % q := by rw [← he]; exact hi
    have h3 := finIntVec_resVec hq y i
    apply Fin.ext
    have : ((z i : ℕ) : ℤ) = ((resVec hq y i : ℕ) : ℤ) := by
      change finIntVec z i = finIntVec (resVec hq y) i
      rw [h2, h3]
    exact_mod_cast this
  · rintro rfl i
    rw [Pi.sub_apply, finIntVec_resVec, Int.emod_def]
    exact ⟨y i / q, by ring⟩

/-- The finite Gauss-sum identity in the proof of Blueprint Lemma 9.1 (`lem:liftkernel`):
for `q ≥ 1` and `y ∈ ℤⁿ`, `∑_{β ∈ T[q]} S(a/q, β) e(β · y) = e((a/q) P(y))`
(geometric sums and `P(z) ≡ P(y) mod q` for `z ≡ y mod q`). -/
theorem sum_gaussSum_mul_eC (d a : ℕ) {q : ℕ} (hq : 1 ≤ q) (y : Fin n → ℤ) :
    ∑ b : Fin n → Fin q, gaussSum n d a q b * eC (inner ℝ (gridPt q b) (latEmbed y)) =
      eC ((a : ℝ) / q * (radialPolyZ n d y : ℝ)) := by
  set A : (Fin n → ℤ) → ℝ := fun w => (a : ℝ) / q * (radialPolyZ n d w : ℝ)
  have hq0 : (q : ℂ) ≠ 0 := by exact_mod_cast (show q ≠ 0 by omega)
  have hterm : ∀ (b z : Fin n → Fin q),
      eC (A (finIntVec z) - inner ℝ (latEmbed (finIntVec z)) (gridPt q b)) *
        eC (inner ℝ (gridPt q b) (latEmbed y)) =
      eC (A (finIntVec z)) * eC (inner ℝ (gridPt q b) (latEmbed (y - finIntVec z))) := by
    intro b z
    rw [← eC_add, ← eC_add, latEmbed_sub, inner_sub_right, real_inner_comm (gridPt q b)]
    congr 1; ring
  calc ∑ b : Fin n → Fin q, gaussSum n d a q b * eC (inner ℝ (gridPt q b) (latEmbed y))
      = ((q : ℂ) ^ n)⁻¹ * ∑ z : Fin n → Fin q, eC (A (finIntVec z)) *
          ∑ b : Fin n → Fin q, eC (inner ℝ (gridPt q b) (latEmbed (y - finIntVec z))) := by
        simp only [gaussSum, mul_assoc, ← Finset.mul_sum]
        congr 1
        simp only [Finset.sum_mul, Finset.mul_sum]
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl fun z _ => Finset.sum_congr rfl fun b _ => ?_
        exact hterm b z
    _ = ((q : ℂ) ^ n)⁻¹ * ∑ z : Fin n → Fin q,
          if z = resVec hq y then eC (A (finIntVec z)) * (q : ℂ) ^ n else 0 := by
        congr 1
        refine Finset.sum_congr rfl fun z _ => ?_
        rw [sum_eC_gridPt q hq]
        by_cases hz : z = resVec hq y
        · rw [ite_eq_left ((dvd_sub_finIntVec_iff hq y z).2 hz), ite_eq_left hz]
        · rw [ite_eq_right (fun h => hz ((dvd_sub_finIntVec_iff hq y z).1 h)), ite_eq_right hz,
            mul_zero]
    _ = eC (A (finIntVec (resVec hq y))) := by
        rw [Finset.sum_ite_eq' Finset.univ, ite_eq_left (Finset.mem_univ _), mul_comm,
          mul_assoc, mul_inv_cancel₀ (pow_ne_zero _ hq0), mul_one]
    _ = eC (A y) := by
        have hmod : radialPolyZ n d (finIntVec (resVec hq y)) ≡ radialPolyZ n d y [ZMOD q] :=
          radialPolyZ_modEq n d q fun i => by rw [finIntVec_resVec]; exact Int.mod_modEq _ _
        obtain ⟨k, hk⟩ := (Int.modEq_iff_dvd.1 hmod)
        have hqR : (q : ℝ) ≠ 0 := by exact_mod_cast (show q ≠ 0 by omega)
        have hA : A y = A (finIntVec (resVec hq y)) + ((a * k : ℤ) : ℝ) := by
          simp only [A]
          have hk' : (radialPolyZ n d y : ℝ) =
              (radialPolyZ n d (finIntVec (resVec hq y)) : ℝ) + q * k := by
            have := congrArg (fun t : ℤ => (t : ℝ)) hk
            push_cast at this; linarith
          rw [hk']; push_cast; field_simp
        rw [hA, eC_add, eC_intCast, mul_one]

/-- The lifted symbol is integrable on the torus when `m χ_s` is integrable. -/
lemma integrableOn_liftSym {s a q : ℕ} {m : EuclideanSpace ℝ (Fin n) → ℂ}
    (hm : Integrable fun ξ => m ξ * (liftChi n d Ω p s ξ : ℂ)) :
    IntegrableOn (liftSym n d Ω p s a q m) (torusCube n) := by
  rw [show liftSym n d Ω p s a q m = fun ξ => ∑ b : Fin n → Fin q, gaussSum n d a q b *
    periodize (fun η => m η * (liftChi n d Ω p s η : ℂ)) (ξ - gridPt q b) from rfl]
  refine integrable_finsetSum _ fun b _ => ?_
  simp_rw [periodize_comp_sub]
  exact (integrableOn_periodize (hm.comp_sub_right _)).const_mul _

/-- Blueprint Lemma 9.1 (`lem:liftkernel`), eq. (`eq:liftkernel`): for `q ≥ 1`, `α = a/q` and a
symbol `m` with `m χ_s` integrable (e.g. `m` bounded measurable on `supp χ_s`,
`latKernel_liftSym_of_bdd`), the kernel of `Lift_{s,α}[m]` is
`(Lift_{s,α}[m])ˇ(y) = e(α P(y)) (m χ_s)ˇ(y)` for every `y ∈ G` (including `y = 0`). -/
theorem latKernel_liftSym (s a : ℕ) {q : ℕ} (hq : 1 ≤ q) {m : EuclideanSpace ℝ (Fin n) → ℂ}
    (hm : Integrable fun ξ => m ξ * (liftChi n d Ω p s ξ : ℂ)) (y : Fin n → ℤ) :
    latKernel (liftSym n d Ω p s a q m) y =
      eC ((a : ℝ) / q * (radialPolyZ n d y : ℝ)) *
        𝓕⁻ (fun ξ => m ξ * (liftChi n d Ω p s ξ : ℂ)) (latEmbed y) := by
  rw [← sum_gaussSum_mul_eC d a hq y, Finset.sum_mul, latKernel]
  simp only [liftSym, Finset.sum_mul]
  rw [integral_finsetSum _ fun b _ => ?_]
  · refine Finset.sum_congr rfl fun b _ => ?_
    simp_rw [mul_assoc]
    rw [integral_const_mul]
    simp_rw [periodize_comp_sub]
    rw [← latKernel, latKernel_periodize (hm.comp_sub_right _),
      fourierInv_comp_sub (fun η => m η * (liftChi n d Ω p s η : ℂ))]
  · simp_rw [mul_assoc, periodize_comp_sub]
    exact (integrableOn_periodize_mul_eC (hm.comp_sub_right _) y).const_mul _

/-- `χ_s` (as a complex function) is integrable. -/
lemma integrable_liftChi (s : ℕ) :
    Integrable fun ξ : EuclideanSpace ℝ (Fin n) => (liftChi n d Ω p s ξ : ℂ) :=
  (liftCutoffSchwartz n).integrable.comp_smul (liftL_pos s).ne'

/-- `m χ_s` is integrable for `m` a.e.-strongly measurable and bounded on `supp χ_s`. -/
lemma integrable_mul_liftChi {s : ℕ} {m : EuclideanSpace ℝ (Fin n) → ℂ}
    (hm : AEStronglyMeasurable m volume) {B : ℝ}
    (hB : ∀ ξ, liftChi n d Ω p s ξ ≠ 0 → ‖m ξ‖ ≤ B) :
    Integrable fun ξ => m ξ * (liftChi n d Ω p s ξ : ℂ) := by
  have hχ := integrable_liftChi (n := n) (d := d) (Ω := Ω) (p := p) s
  refine Integrable.mono' (hχ.norm.const_mul B) (hm.mul hχ.aestronglyMeasurable)
    (Filter.Eventually.of_forall fun ξ => ?_)
  rw [norm_mul]
  by_cases h : liftChi n d Ω p s ξ = 0
  · simp [h]
  · exact mul_le_mul_of_nonneg_right (hB ξ h) (norm_nonneg _)

/-- Blueprint Lemma 9.1 (`lem:liftkernel`), eq. (`eq:liftkernel`), for bounded measurable `m`
on the support of `χ_s`: for `q ≥ 1`, `α = a/q`, and every `y ∈ G`,
`(Lift_{s,α}[m])ˇ(y) = e(α P(y)) (m χ_s)ˇ(y)`. -/
theorem latKernel_liftSym_of_bdd (s a : ℕ) {q : ℕ} (hq : 1 ≤ q)
    {m : EuclideanSpace ℝ (Fin n) → ℂ} (hm : AEStronglyMeasurable m volume) {B : ℝ}
    (hB : ∀ ξ, liftChi n d Ω p s ξ ≠ 0 → ‖m ξ‖ ≤ B) (y : Fin n → ℤ) :
    latKernel (liftSym n d Ω p s a q m) y =
      eC ((a : ℝ) / q * (radialPolyZ n d y : ℝ)) *
        𝓕⁻ (fun ξ => m ξ * (liftChi n d Ω p s ξ : ℂ)) (latEmbed y) :=
  latKernel_liftSym s a hq (integrable_mul_liftChi hm hB) y

/-- Blueprint Lemma 9.1 (`lem:liftkernel`), "in particular": for `q ≥ 1`, `α = a/q`, the kernel of
`A_{s,α}` is `e(α P(y)) φ_s(y)`, `φ_s = 𝓕⁻ χ_s`, for every `y ∈ G`. -/
theorem latKernel_liftA (s a : ℕ) {q : ℕ} (hq : 1 ≤ q) (y : Fin n → ℤ) :
    latKernel (liftA n d Ω p s a q) y =
      eC ((a : ℝ) / q * (radialPolyZ n d y : ℝ)) * liftPhi n d Ω p s (latEmbed y) := by
  have h := latKernel_liftSym (n := n) (d := d) (Ω := Ω) (p := p) s a hq (m := fun _ => 1)
    (by simpa using integrable_liftChi (n := n) (d := d) (Ω := Ω) (p := p) s) y
  simpa [liftA, liftPhi] using h

/-- Scaling of the envelope bound: there is `C ≥ 0` (depending only on `n`) such that for every
`L > 0`, `|𝓕⁻(χ(L ·))(x)| ≤ C B_L(x)` for all `x ∈ E`. -/
lemma exists_norm_fourierInv_liftCutoff_smul_le (n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ L : ℝ, 0 < L → ∀ x : EuclideanSpace ℝ (Fin n),
      ‖𝓕⁻ (fun ξ => (liftCutoff n (L • ξ) : ℂ)) x‖ ≤ C * envelope n L x := by
  obtain ⟨K, hK, hKb⟩ := exists_norm_le_envelope (𝓕⁻ (liftCutoffSchwartz n))
  refine ⟨K, hK, fun L hL x => ?_⟩
  have hL' : 0 < L⁻¹ := inv_pos.2 hL
  have hfun : (fun ξ : EuclideanSpace ℝ (Fin n) => (liftCutoff n (L • ξ) : ℂ)) =
      fun ξ => liftCutoffSchwartz n ((L⁻¹)⁻¹ • ξ) := by
    funext ξ; rw [inv_inv, liftCutoffSchwartz_apply]
  rw [hfun, fourierInv_comp_inv_smul _ hL', ← SchwartzMap.fourierInv_coe, norm_mul,
    Complex.norm_real, Real.norm_of_nonneg (by positivity)]
  have hb := hKb (L⁻¹ • x)
  have he : envelope n 1 (L⁻¹ • x) = ((1 + ‖x‖ / L) ^ (n + 1))⁻¹ := by
    rw [envelope, norm_smul, Real.norm_of_nonneg hL'.le]
    simp [div_eq_inv_mul]
  rw [he] at hb
  calc (L⁻¹) ^ n * ‖(𝓕⁻ (liftCutoffSchwartz n)) (L⁻¹ • x)‖
      ≤ (L⁻¹) ^ n * (K * ((1 + ‖x‖ / L) ^ (n + 1))⁻¹) :=
        mul_le_mul_of_nonneg_left hb (by positivity)
    _ = K * envelope n L x := by rw [envelope, inv_pow]; ring

/-- Blueprint Lemma 9.1 (`lem:liftkernel`), envelope bound: there is `C ≥ 0` (depending only on
`n`, independent of `s` and of `d, Ω, p`) such that `|φ_s(y)| ≤ C B_{L_s}(y)` for every `s` and
every `y ∈ G`, where `φ_s = 𝓕⁻ χ_s` and `B_R` is the envelope of Lemma 2.4 (`lem:maximal`);
the same bound holds at every point of `E`. -/
theorem norm_liftPhi_le (n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ),
      (∀ x : EuclideanSpace ℝ (Fin n),
        ‖liftPhi n d Ω p s x‖ ≤ C * envelope n (liftL n d Ω p s) x) ∧
      ∀ y : Fin n → ℤ,
        ‖liftPhi n d Ω p s (latEmbed y)‖ ≤ C * latEnvelope n (liftL n d Ω p s) y := by
  obtain ⟨C, hC, h⟩ := exists_norm_fourierInv_liftCutoff_smul_le n
  exact ⟨C, hC, fun d Ω p s =>
    ⟨fun x => h _ (liftL_pos s) x, fun y => h _ (liftL_pos s) (latEmbed y)⟩⟩

/-! ### Blueprint Lemma 9.2 (`lem:arithmax`): arithmetic maximal decay

Proof structure (following the blueprint):
* the complete phase sums `arithG` (`G_Q`, `Q = q r`) and their bounds in both degree cases:
  `norm_arithG_one_le` (`D = 2`, Lemma 3.6), `norm_arithG_slice_le` (`D ≥ 4`, Lemma 3.1 and
  Corollary 3.5), the exceptional densities `card_exc_quad_le`, `card_exc_slice_le` (Lemma 3.2),
  combined in `exists_arithG_bound`;
* the lattice sum of `B_L` over the exceptional set by dyadic shells
  (`arith_tsum_latEnvelope_indicator_le`);
* the `TT*` kernel of a linearization (`integral_arithKer_mul_conj`, via Lemma 9.1) and its bound
  `|H| ≤ C (|G_Q| + Q/L) B_L(h)` (`norm_arithTT_le`, Lemma 3.7);
* Schur and `TT*` (`arith_linearized_bound`, via `band_eLpNorm_kernel_le_of_ttstar`), then
  linearization of the maximal function: eq. (9.5), `arith_maximal_decay`;
* eq. (9.6), `arith_maximal_decay_vector`: the `ℓ²` case by squaring and summing (9.5), the
  endpoints by the domination `(∑_ν sup_α |A f_ν|²)^{1/2} ≤ |φ_s| * (∑_ν |f_ν|²)^{1/2}`
  (Minkowski) and Young, and Marcinkiewicz interpolation for `ℓ²_ν`-valued inputs
  (`arithVec_lp_of_l2`).

Deviations: the period is `Q = q_x q_y` (instead of `lcm(q_x, q_y)`; still `N/2 ≤ Q ≤ N²`); for
`D ≥ 4` the exceptional set is `{h : gcd(D b_y h₁, q_y) > N^{1/2}}` (equal to the blueprint's set
since `(b_y, q_y) = 1`); both exceptional sets have density `≤ C N^{-3/8}` in every interval
`[-R, R]`, `R ≥ N`; the error term uses `Q/L ≤ N²/L ≤ N^{-1}` (from `L_s ≥ N_s³`). -/

section ArithMax

open Polynomial
open scoped ComplexConjugate ENNReal NNReal


/-- The phase `α P(v) - β P(v + h)` of the `TT*` kernel in the proof of Blueprint Lemma 9.2. -/
noncomputable def arithPhase (n d : ℕ) (α β : ℝ) (h v : Fin n → ℤ) : ℝ :=
  α * (radialPolyZ n d v : ℝ) - β * (radialPolyZ n d (v + h) : ℝ)

/-- `X ≡ Y (mod q)` gives `(a/q) Y = (a/q) X + k` with `k ∈ ℤ`. -/
lemma exists_div_mul_eq_add_int (a : ℤ) {q : ℕ} (hq : 1 ≤ q) {X Y : ℤ} (h : X ≡ Y [ZMOD q]) :
    ∃ k : ℤ, (a : ℝ) / q * Y = (a : ℝ) / q * X + k := by
  obtain ⟨k, hk⟩ := (Int.modEq_iff_dvd.1 h)
  have hqR : (q : ℝ) ≠ 0 := by have : (0 : ℝ) < q := by exact_mod_cast hq
                               exact this.ne'
  refine ⟨a * k, ?_⟩
  have hk' : (Y : ℝ) = X + q * k := by
    have := congrArg (fun t : ℤ => (t : ℝ)) hk; push_cast at this; linarith
  rw [hk']; push_cast; field_simp

/-- The phase is periodic modulo `Q = q r` (for `α = a/q`, `β = b/r`). -/
lemma eC_arithPhase_periodic (d : ℕ) (a b : ℤ) {q r : ℕ} (hq : 1 ≤ q) (hr : 1 ≤ r)
    (h : Fin n → ℤ) {v v' : Fin n → ℤ} (hv : ∀ i, v i ≡ v' i [ZMOD (q * r : ℕ)]) :
    eC (arithPhase n d ((a : ℝ) / q) ((b : ℝ) / r) h v) =
      eC (arithPhase n d ((a : ℝ) / q) ((b : ℝ) / r) h v') := by
  have h1 : radialPolyZ n d v ≡ radialPolyZ n d v' [ZMOD q] :=
    radialPolyZ_modEq n d q fun i =>
      Int.ModEq.of_mul_right (r : ℤ) (by have := hv i; push_cast at this; exact this)
  have h2 : radialPolyZ n d (v + h) ≡ radialPolyZ n d (v' + h) [ZMOD r] :=
    radialPolyZ_modEq n d r fun i => by
      simp only [Pi.add_apply]
      exact (Int.ModEq.of_mul_left (q : ℤ)
        (by have := hv i; push_cast at this; exact this)).add_right _
  obtain ⟨k₁, hk₁⟩ := exists_div_mul_eq_add_int a hq h1
  obtain ⟨k₂, hk₂⟩ := exists_div_mul_eq_add_int b hr h2
  have : arithPhase n d ((a : ℝ) / q) ((b : ℝ) / r) h v' =
      arithPhase n d ((a : ℝ) / q) ((b : ℝ) / r) h v + ((k₁ - k₂ : ℤ) : ℝ) := by
    unfold arithPhase; rw [hk₁, hk₂]; push_cast; ring
  rw [this, eC_add, eC_intCast, mul_one]

/-- The normalized complete phase sum
`G = Q^{-n} ∑_{u ∈ [0, Q)ⁿ} e((a/q) P(u) - (b/r) P(u + h))`, `Q = q r`. -/
noncomputable def arithG (n d a q b r : ℕ) (h : Fin n → ℤ) : ℂ :=
  (((q * r : ℕ) : ℂ) ^ n)⁻¹ * ∑ u : Fin n → Fin (q * r),
    eC (arithPhase n d ((a : ℝ) / q) ((b : ℝ) / r) h (finIntVec u))

/-- The trivial bound `|G| ≤ 1`. -/
lemma norm_arithG_le_one (d a b : ℕ) {q r : ℕ} (hq : 1 ≤ q) (hr : 1 ≤ r) (h : Fin n → ℤ) :
    ‖arithG n d a q b r h‖ ≤ 1 := by
  have hQ : (0 : ℝ) < ((q * r : ℕ) : ℝ) := by exact_mod_cast Nat.mul_pos hq hr
  unfold arithG
  rw [norm_mul, norm_inv, norm_pow, Complex.norm_natCast]
  refine (mul_le_mul_of_nonneg_left (norm_sum_le _ _) (by positivity)).trans ?_
  simp only [norm_eC, sum_const, card_univ, Fintype.card_pi, Fintype.card_fin, prod_const,
    nsmul_eq_mul, mul_one]
  push_cast
  rw [inv_mul_cancel₀ (by positivity)]

/-- `e` of a finite sum is the product of the `e`'s. -/
lemma arith_eC_finsetSum {ι : Type*} (s : Finset ι) (f : ι → ℝ) :
    eC (∑ i ∈ s, f i) = ∏ i ∈ s, eC (f i) := by
  unfold eC; push_cast; rw [Finset.mul_sum, Complex.exp_sum]

lemma arithPhase_one (α β : ℝ) (h v : Fin n → ℤ) :
    arithPhase n 1 α β h v = ∑ i, (α * (v i : ℝ) ^ 2 - β * ((v i : ℝ) + h i) ^ 2) := by
  simp [arithPhase, radialPolyZ, Finset.mul_sum, Finset.sum_sub_distrib]

/-- For `D = 2` the complete sum factors over the coordinates. -/
lemma arithG_one_eq_prod (a q b r : ℕ) (h : Fin n → ℤ) :
    arithG n 1 a q b r h = ∏ i, (((q * r : ℕ) : ℂ))⁻¹ * ∑ t : Fin (q * r),
      eC ((a : ℝ) / q * ((t : ℕ) : ℝ) ^ 2 - (b : ℝ) / r * (((t : ℕ) : ℝ) + h i) ^ 2) := by
  unfold arithG
  simp_rw [arithPhase_one, arith_eC_finsetSum]
  rw [Finset.prod_mul_distrib, prod_const, card_univ, Fintype.card_fin, inv_pow]
  congr 1
  rw [Finset.prod_univ_sum, Fintype.piFinset_univ]
  simp [finIntVec]

/-- The one-dimensional quadratic factor in the form of Lemma 3.6. -/
lemma arith_quad_factor_eq (a q b r : ℕ) (hq : 1 ≤ q) (hr : 1 ≤ r) (h0 : ℤ) :
    (((q * r : ℕ) : ℂ))⁻¹ * ∑ t : Fin (q * r),
      eC ((a : ℝ) / q * ((t : ℕ) : ℝ) ^ 2 - (b : ℝ) / r * (((t : ℕ) : ℝ) + h0) ^ 2) =
    eC (-((b : ℝ) / r * (h0 : ℝ) ^ 2)) * ((((q * r : ℕ) : ℂ))⁻¹ * ∑ z ∈ range (q * r),
      eC ((((a * r - b * q : ℤ) : ℝ) * (z : ℝ) ^ 2 + ((-2 * b * h0 * q : ℤ) : ℝ) * z) /
        ((q * r : ℕ) : ℝ))) := by
  have hsum : ∑ t : Fin (q * r),
      eC ((a : ℝ) / q * ((t : ℕ) : ℝ) ^ 2 - (b : ℝ) / r * (((t : ℕ) : ℝ) + h0) ^ 2) =
      eC (-((b : ℝ) / r * (h0 : ℝ) ^ 2)) * ∑ z ∈ range (q * r),
      eC ((((a * r - b * q : ℤ) : ℝ) * (z : ℝ) ^ 2 + ((-2 * b * h0 * q : ℤ) : ℝ) * z) /
        ((q * r : ℕ) : ℝ)) := by
    rw [Fin.sum_univ_eq_sum_range (fun t : ℕ =>
      eC ((a : ℝ) / q * (t : ℝ) ^ 2 - (b : ℝ) / r * ((t : ℝ) + h0) ^ 2)) (q * r), Finset.mul_sum]
    refine sum_congr rfl fun z _ => ?_
    rw [← eC_add]
    congr 1
    have hq0 : (q : ℝ) ≠ 0 := by have : (0 : ℝ) < q := by exact_mod_cast hq
                                 exact this.ne'
    have hr0 : (r : ℝ) ≠ 0 := by have : (0 : ℝ) < r := by exact_mod_cast hr
                                 exact this.ne'
    push_cast
    field_simp
    ring
  rw [hsum]; ring

/-- `√(2/v) ≤ √2 N^{-1/8}` for `v ≥ N^{1/4}`. -/
lemma arith_sqrt_two_div_le {N v : ℝ} (hN : 0 < N) (hv : N ^ (1 / 4 : ℝ) ≤ v) :
    Real.sqrt (2 / v) ≤ Real.sqrt 2 * N ^ (-(1 / 8 : ℝ)) := by
  have h4 : 0 < N ^ (1 / 4 : ℝ) := Real.rpow_pos_of_pos hN _
  have hv0 : 0 < v := h4.trans_le hv
  have e : N ^ (-(1 / 8 : ℝ)) = Real.sqrt ((N ^ (1 / 4 : ℝ))⁻¹) := by
    rw [Real.sqrt_eq_rpow, ← Real.rpow_neg hN.le, ← Real.rpow_mul hN.le]; norm_num
  rw [e, ← Real.sqrt_mul (by norm_num)]
  refine Real.sqrt_le_sqrt ?_
  rw [div_eq_mul_inv]
  gcongr

open scoped Classical in
/-- Blueprint Lemma 9.2, the case `D = 2`: with `v` the reduced denominator of `a/q - b/r`,
`|G| ≤ √2 N^{-1/8}` unless `r ∣ 2 v h₁` for some `1 ≤ v ≤ N^{1/4}`. -/
lemma norm_arithG_one_le {m : ℕ} (a q b r N : ℕ) (hq : 1 ≤ q) (hr : 1 ≤ r) (hN : 1 ≤ N)
    (hbr : Nat.Coprime b r) (h : Fin (m + 1) → ℤ) :
    ‖arithG (m + 1) 1 a q b r h‖ ≤ Real.sqrt 2 * (N : ℝ) ^ (-(1 / 8 : ℝ)) +
      if (∃ v : ℕ, 1 ≤ v ∧ (v : ℝ) ≤ (N : ℝ) ^ (1 / 4 : ℝ) ∧ (r : ℤ) ∣ 2 * v * h 0)
        then 1 else 0 := by
  classical
  have hQ : 1 ≤ q * r := Nat.mul_pos hq hr
  have hN0 : (0 : ℝ) < N := by exact_mod_cast hN
  have hs0 : 0 ≤ Real.sqrt 2 * (N : ℝ) ^ (-(1 / 8 : ℝ)) := by positivity
  set A : ℤ := a * r - b * q
  set B : ℤ := -2 * b * h 0 * q
  set Gq : ℂ := (((q * r : ℕ) : ℂ))⁻¹ * ∑ z ∈ range (q * r),
      eC ((A * (z : ℝ) ^ 2 + B * z) / ((q * r : ℕ) : ℝ)) with hGq
  have hfac : ∀ i, ‖(((q * r : ℕ) : ℂ))⁻¹ * ∑ t : Fin (q * r),
      eC ((a : ℝ) / q * ((t : ℕ) : ℝ) ^ 2 - (b : ℝ) / r * (((t : ℕ) : ℝ) + h i) ^ 2)‖ ≤ 1 := by
    intro i
    rw [norm_mul, norm_inv, Complex.norm_natCast]
    refine (mul_le_mul_of_nonneg_left (norm_sum_le _ _) (by positivity)).trans ?_
    simp only [norm_eC, sum_const, card_univ, Fintype.card_fin, nsmul_eq_mul, mul_one]
    push_cast
    rw [inv_mul_cancel₀ (by positivity)]
  have hmain : ‖arithG (m + 1) 1 a q b r h‖ ≤ ‖Gq‖ := by
    rw [arithG_one_eq_prod, Fin.prod_univ_succ, norm_mul, arith_quad_factor_eq a q b r hq hr,
      norm_mul, norm_eC, one_mul]
    refine mul_le_of_le_one_right (norm_nonneg _) ?_
    rw [norm_prod]
    exact Finset.prod_le_one₀ (fun _ _ => norm_nonneg _) fun i _ => hfac _
  have hG1 : ‖arithG (m + 1) 1 a q b r h‖ ≤ 1 := norm_arithG_le_one 1 a b hq hr h
  set v : ℕ := (q * r) / Int.gcd A (q * r : ℕ) with hv
  have hg0 : 0 < Int.gcd A (q * r : ℕ) :=
    Int.gcd_pos_of_ne_zero_right _ (by exact_mod_cast (show q * r ≠ 0 by omega))
  have hgQ : Int.gcd A (q * r : ℕ) ≤ q * r := by
    have := Int.gcd_dvd_right A ((q * r : ℕ) : ℤ)
    exact Nat.le_of_dvd hQ (by exact_mod_cast this)
  have hv1 : 1 ≤ v := Nat.div_pos hgQ hg0
  by_cases hvN : (N : ℝ) ^ (1 / 4 : ℝ) ≤ v
  · refine hmain.trans ((norm_quadratic_complete_sum_le A B hQ).trans ?_)
    refine (arith_sqrt_two_div_le hN0 hvN).trans ?_
    split_ifs <;> linarith
  · push Not at hvN
    by_cases hG : Gq = 0
    · refine hmain.trans ?_
      rw [hG, norm_zero]
      split_ifs <;> linarith
    · have hdvd := dvd_of_quadratic_complete_sum_ne_zero A B b (h 0) hQ (Dvd.intro_left q rfl)
        (by simpa [Int.gcd_natCast_natCast] using hbr)
        (by rw [Nat.mul_div_cancel _ (by omega)]) hG
      have hex : ∃ v : ℕ, 1 ≤ v ∧ (v : ℝ) ≤ (N : ℝ) ^ (1 / 4 : ℝ) ∧ (r : ℤ) ∣ 2 * v * h 0 :=
        ⟨v, hv1, hvN.le, hdvd⟩
      rw [ite_eq_left hex]
      linarith

/-- The phase `α P(v) - β P(v + h)`, `v = (t, s)`, as a polynomial in the first coordinate `t`
(Blueprint Lemma 3.1). -/
noncomputable def arithPoly {m : ℕ} (d : ℕ) (α β : ℝ) (h : Fin (m + 1) → ℤ) (s : Fin m → ℤ) :
    ℝ[X] :=
  C α * sliceRadialPoly (m + 1) d 0 (fun l => ((Fin.cons 0 s : Fin (m + 1) → ℤ) l : ℝ)) 0 -
    C β * sliceRadialPoly (m + 1) d 0 (fun l => ((Fin.cons 0 s : Fin (m + 1) → ℤ) l : ℝ))
      (fun l => (h l : ℝ))

lemma arithPoly_natDegree_le {m : ℕ} (d : ℕ) (α β : ℝ) (h : Fin (m + 1) → ℤ) (s : Fin m → ℤ) :
    (arithPoly d α β h s).natDegree ≤ 2 * d := by
  refine (natDegree_sub_le _ _).trans (max_le ?_ ?_) <;>
    exact (natDegree_C_mul_le _ _).trans (sliceRadialPoly_natDegree_le _ _ _ _ _)

lemma arithPoly_eval {m : ℕ} (d : ℕ) (α β : ℝ) (h : Fin (m + 1) → ℤ) (s : Fin m → ℤ) (t : ℤ) :
    ∑ k ∈ range (2 * d + 1), (arithPoly d α β h s).coeff k * (t : ℝ) ^ k =
      arithPhase (m + 1) d α β h (Fin.cons t s) := by
  rw [← eval_eq_sum_range' (Nat.lt_succ_of_le (arithPoly_natDegree_le d α β h s)),
    arithPoly, eval_sub, eval_mul, eval_mul, eval_C, eval_C, sliceRadialPoly_eval,
    sliceRadialPoly_eval]
  have hu : Function.update (fun l => ((Fin.cons 0 s : Fin (m + 1) → ℤ) l : ℝ)) 0 (t : ℝ) =
      fun l => ((Fin.cons t s : Fin (m + 1) → ℤ) l : ℝ) := by
    funext l
    refine Fin.cases ?_ (fun k => ?_) l
    · simp
    · rw [Function.update_of_ne (Fin.succ_ne_zero k)]; simp
  rw [hu]
  simp only [arithPhase, radialPolyZ, Pi.add_apply, Pi.zero_apply, add_zero]
  push_cast
  rfl

lemma arithPoly_coeff {m : ℕ} {d : ℕ} (hd : 1 ≤ d) (α β : ℝ) (h : Fin (m + 1) → ℤ)
    (s : Fin m → ℤ) : (arithPoly d α β h s).coeff (2 * d - 1) = -(2 * d * β * h 0) := by
  rw [arithPoly, coeff_sub, coeff_C_mul, coeff_C_mul,
    sliceRadialPoly_coeff_top_sub_one _ (by omega),
    sliceRadialPoly_coeff_top_sub_one _ (by omega)]
  simp only [Pi.zero_apply]
  ring

lemma arith_finIntVec_cons {m q : ℕ} (t : Fin q) (s : Fin m → Fin q) :
    finIntVec (Fin.cons t s : Fin (m + 1) → Fin q) = Fin.cons ((t : ℕ) : ℤ) (finIntVec s) := by
  funext l
  refine Fin.cases ?_ (fun k => ?_) l <;> simp [finIntVec]

/-- Slicing the complete sum in the first coordinate, with `t ∈ [1, Q]` (periodicity). -/
lemma sum_eC_arithPhase_slice {m : ℕ} (d a b : ℕ) {q r : ℕ} (hq : 1 ≤ q) (hr : 1 ≤ r)
    (h : Fin (m + 1) → ℤ) :
    ∑ u : Fin (m + 1) → Fin (q * r), eC (arithPhase (m + 1) d ((a : ℝ) / q) ((b : ℝ) / r) h
        (finIntVec u)) =
      ∑ s : Fin m → Fin (q * r), ∑ t ∈ Icc 1 (q * r),
        eC (∑ k ∈ range (2 * d + 1),
          (arithPoly d ((a : ℝ) / q) ((b : ℝ) / r) h (finIntVec s)).coeff k * (t : ℝ) ^ k) := by
  set Q := q * r
  set F : (Fin m → ℤ) → ℕ → ℂ := fun w t =>
    eC (arithPhase (m + 1) d ((a : ℝ) / q) ((b : ℝ) / r) h (Fin.cons (t : ℤ) w)) with hF
  rw [← (Fin.consEquiv fun _ : Fin (m + 1) => Fin Q).sum_comp, Fintype.sum_prod_type_right]
  refine Fintype.sum_congr _ _ fun s => ?_
  have hc : ∀ t : Fin Q, (Fin.consEquiv fun _ : Fin (m + 1) => Fin Q) (t, s) = Fin.cons t s :=
    fun _ => rfl
  simp only [hc, arith_finIntVec_cons]
  have h1 : ∑ t : Fin Q, eC (arithPhase (m + 1) d ((a : ℝ) / q) ((b : ℝ) / r) h
      (Fin.cons ((t : ℕ) : ℤ) (finIntVec s))) = ∑ t ∈ range Q, F (finIntVec s) t :=
    Fin.sum_univ_eq_sum_range (F (finIntVec s)) Q
  have hper : F (finIntVec s) Q = F (finIntVec s) 0 := by
    simp only [hF]
    refine eC_arithPhase_periodic d a b hq hr h fun i => ?_
    refine Fin.cases ?_ (fun k => ?_) i
    · simp only [Fin.cons_zero, Nat.cast_zero]
      exact Int.modEq_zero_iff_dvd.2 (by simp [Q])
    · simp
  have h2 : ∑ t ∈ range Q, F (finIntVec s) t = ∑ t ∈ Icc 1 Q, F (finIntVec s) t := by
    rw [sum_Icc_one_eq_sum_range]
    have e1 := Finset.sum_range_succ (F (finIntVec s)) Q
    have e2 := Finset.sum_range_succ' (F (finIntVec s)) Q
    rw [hper] at e1
    have := e1.symm.trans e2
    exact add_right_cancel this
  rw [h1, h2]
  refine sum_congr rfl fun t _ => ?_
  simp only [hF]
  congr 1
  rw [← arithPoly_eval d _ _ h (finIntVec s) (t : ℤ)]
  simp

/-- Blueprint Lemma 9.2, the case `D = 2d ≥ 4`: there are `C ≥ 1` and `c > 0` such that if
`N/2 ≤ r ≤ N`, `(b, r) = 1` and `gcd(D b h₁, r) ≤ N^{1/2}`, then `|G| ≤ C N^{-c}` (for every
`a/q`, `q ≥ 1`). The coefficient of `t^{D-1}` on every slice is `-D (b/r) h₁` (Lemma 3.1), whose
reduced denominator lies in `[N^{1/2}/2, N]`, and Corollary 3.5 applies. -/
lemma norm_arithG_slice_le {m d : ℕ} (hd : 2 ≤ d) :
    ∃ C c : ℝ, 1 ≤ C ∧ 0 < c ∧ ∀ (a q b r N : ℕ), 1 ≤ q → 1 ≤ r → 1 ≤ N → N ≤ 2 * r → r ≤ N →
      ∀ h : Fin (m + 1) → ℤ, (Int.gcd (2 * d * b * h 0) r : ℝ) ≤ Real.sqrt N →
        ‖arithG (m + 1) d a q b r h‖ ≤ C * (N : ℝ) ^ (-c) := by
  obtain ⟨C, c, hC, hc, hcor⟩ := norm_sum_slices_le_of_rational_coeff (2 * d)
  refine ⟨C, c, hC, hc, fun a q b r N hq hr hN hNr hrN h hgcd => ?_⟩
  have hQ : 1 ≤ q * r := Nat.mul_pos hq hr
  have hQ0 : (0 : ℝ) < ((q * r : ℕ) : ℝ) := by exact_mod_cast hQ
  have hN1 : (1 : ℝ) ≤ N := by exact_mod_cast hN
  have hr0 : (0 : ℝ) < r := by exact_mod_cast hr
  set X : ℤ := -(2 * d * b * h 0) with hX
  set g : ℕ := Int.gcd X r with hg
  have hg' : g = Int.gcd (2 * d * b * h 0) r := by rw [hg, hX, Int.neg_gcd]
  have hg0 : 0 < g := Int.gcd_pos_of_ne_zero_right _ (by exact_mod_cast (show r ≠ 0 by omega))
  have hgr : g ∣ r := by
    have := Int.gcd_dvd_right X (r : ℤ); exact_mod_cast this
  have hgX : (g : ℤ) ∣ X := Int.gcd_dvd_left X r
  set B' : ℤ := X / g
  set r' : ℕ := r / g
  have hg0R : (g : ℝ) ≠ 0 := by exact_mod_cast hg0.ne'
  have hr'R : (r' : ℝ) = r / g := Nat.cast_div hgr hg0R
  have hB'R : (B' : ℝ) = X / g := by
    rw [Int.cast_div hgX (by exact_mod_cast hg0.ne')]; rfl
  have hcop : Int.gcd B' r' = 1 := by
    have := Int.gcd_div_gcd_div_gcd (i := X) (j := r) (by omega)
    rw [← hg] at this
    convert this using 2
    simp [r']
  -- the coefficient
  have hcoeff : ∀ s : Fin m → Fin (q * r),
      (arithPoly d ((a : ℝ) / q) ((b : ℝ) / r) h (finIntVec s)).coeff (2 * d - 1) =
        (B' : ℝ) / r' := by
    intro s
    rw [arithPoly_coeff (by omega), hB'R, hr'R, hX]
    push_cast
    field_simp
  have hgN : (g : ℝ) ≤ Real.sqrt N := by rw [hg']; exact hgcd
  have hsqrt : Real.sqrt N ^ 2 = N := Real.sq_sqrt (by linarith)
  have hsq0 : 0 < Real.sqrt N := Real.sqrt_pos.2 (by linarith)
  have hg1 : (1 : ℝ) ≤ g := by exact_mod_cast hg0
  have hr'lo : Real.sqrt N / 2 ≤ r' := by
    rw [hr'R, le_div_iff₀ (by linarith)]
    have h2r : (N : ℝ) ≤ 2 * r := by exact_mod_cast hNr
    nlinarith
  have hr'hi : (r' : ℝ) ≤ N := by
    have : r' ≤ N := (Nat.div_le_self r g).trans hrN
    exact_mod_cast this
  have hQN : (N : ℝ) / 2 ≤ ((q * r : ℕ) : ℝ) := by
    have h2r : (N : ℝ) ≤ 2 * r := by exact_mod_cast hNr
    have : (r : ℝ) ≤ ((q * r : ℕ) : ℝ) := by
      exact_mod_cast Nat.le_mul_of_pos_left r hq
    linarith
  have hbound := hcor (univ : Finset (Fin m → Fin (q * r)))
    (fun s k => (arithPoly d ((a : ℝ) / q) ((b : ℝ) / r) h (finIntVec s)).coeff k)
    (fun _ => B') (fun _ => r') (N : ℝ) (q * r) (2 * d - 1) hN1 hQN (by omega) (by omega)
    (fun s _ => hcoeff s) (fun _ _ => hcop) (fun _ _ => hr'lo) (fun _ _ => hr'hi)
  unfold arithG
  rw [sum_eC_arithPhase_slice d a b hq hr h, norm_mul, norm_inv, norm_pow, Complex.norm_natCast]
  rw [card_univ, Fintype.card_pi, prod_const, card_univ, Fintype.card_fin, Fintype.card_fin]
    at hbound
  calc (((q * r : ℕ) : ℝ) ^ (m + 1))⁻¹ * ‖_‖
      ≤ (((q * r : ℕ) : ℝ) ^ (m + 1))⁻¹ *
          (C * (N : ℝ) ^ (-c) * ((q * r : ℕ) : ℝ) * (((q * r) ^ m : ℕ) : ℝ)) :=
        mul_le_mul_of_nonneg_left hbound (by positivity)
    _ = C * (N : ℝ) ^ (-c) := by
        push_cast
        field_simp
        ring

/-- Progression count on `[-R, R]` (Lemma 3.2): `#{t ∈ [-R, R] : g ∣ D t} ≤ 2 D R / g + D + 1`. -/
lemma arith_card_Icc_filter_dvd_le {g D : ℕ} (hg : 0 < g) (hD : 0 < D) (R : ℕ) :
    (#{t ∈ Finset.Icc (-(R : ℤ)) R | (g : ℤ) ∣ D * t} : ℝ) ≤ D * (2 * R) / g + D + 1 :=
  card_filter_dvd_mul_le hg hD (by positivity) (-(R : ℝ)) _ fun t ht => by
    rw [Finset.mem_Icc] at ht
    constructor
    · exact_mod_cast ht.1
    · have : (t : ℝ) ≤ R := by exact_mod_cast ht.2
      linarith

/-- Blueprint Lemma 9.2, exceptional density for `D ≥ 4`: for `(b, r) = 1`, `1 ≤ r ≤ N` and
`R ≥ N`, `#{t ∈ [-R, R] : gcd(D b t, r) > N^{1/2}} ≤ C N^{-3/8} (2R + 1)` (divisor bound with
exponent `1/8` and progression counts). -/
lemma card_exc_slice_le (d : ℕ) (hd : 1 ≤ d) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (b r N : ℕ), 1 ≤ r → r ≤ N → Nat.Coprime b r → ∀ R : ℕ, N ≤ R →
      (#{t ∈ Finset.Icc (-(R : ℤ)) R | Real.sqrt N < (Int.gcd (2 * d * b * t) r : ℝ)} : ℝ) ≤
        C * (N : ℝ) ^ (-(3 / 8 : ℝ)) * (2 * R + 1) := by
  obtain ⟨Cτ, hτ⟩ := card_divisors_le_rpow (ε := 1 / 8) (by norm_num)
  have hCτ : 0 ≤ Cτ := by
    have := hτ 1 one_pos
    simp at this; linarith
  refine ⟨Cτ * (6 * d + 1), by positivity, fun b r N hr hrN hbr R hR => ?_⟩
  classical
  have hN1 : (1 : ℝ) ≤ N := by exact_mod_cast hr.trans hrN
  have hN0 : (0 : ℝ) < N := by linarith
  have hRN : (N : ℝ) ≤ R := by exact_mod_cast hR
  set D : ℕ := 2 * d
  have hD : 0 < D := by omega
  set G : Finset ℕ := r.divisors.filter fun g : ℕ => Real.sqrt N < (g : ℝ)
  have hsub : {t ∈ Finset.Icc (-(R : ℤ)) R | Real.sqrt N < (Int.gcd (2 * d * b * t) r : ℝ)} ⊆
      G.biUnion fun g => {t ∈ Finset.Icc (-(R : ℤ)) R | (g : ℤ) ∣ D * t} := by
    intro t ht
    rw [mem_filter] at ht
    rw [Finset.mem_biUnion]
    set g := Int.gcd (2 * d * b * t) r
    have hgr : g ∣ r := by
      have := Int.gcd_dvd_right (2 * d * b * t) (r : ℤ); exact_mod_cast this
    refine ⟨g, ?_, ?_⟩
    · rw [mem_filter, Nat.mem_divisors]; exact ⟨⟨hgr, by omega⟩, ht.2⟩
    · rw [mem_filter]
      refine ⟨ht.1, ?_⟩
      have h1 : (g : ℤ) ∣ (D * t) * b := by
        have := Int.gcd_dvd_left (2 * d * b * t) (r : ℤ)
        have e : (2 * d * b * t : ℤ) = (D * t) * b := by simp only [D]; push_cast; ring
        exact this.trans (dvd_of_eq e)
      have hcop : IsCoprime (g : ℤ) (b : ℤ) := by
        have hc : Nat.Coprime g b := Nat.Coprime.coprime_dvd_left hgr hbr.symm
        exact Nat.isCoprime_iff_coprime.2 hc
      exact hcop.dvd_of_dvd_mul_right h1
  have hsqrt : Real.sqrt N ^ 2 = N := Real.sq_sqrt hN0.le
  have hsq0 : 0 < Real.sqrt N := Real.sqrt_pos.2 hN0
  have hsqR : Real.sqrt N ≤ R := by
    have : Real.sqrt N ≤ N := by nlinarith [Real.sqrt_nonneg (N : ℝ)]
    linarith
  have hterm : ∀ g ∈ G, (#{t ∈ Finset.Icc (-(R : ℤ)) R | (g : ℤ) ∣ D * t} : ℝ) ≤
      D * (2 * R) / Real.sqrt N + D + 1 := by
    intro g hg
    rw [mem_filter, Nat.mem_divisors] at hg
    have hg0 : 0 < g := Nat.pos_of_dvd_of_pos hg.1.1 (by omega)
    refine (arith_card_Icc_filter_dvd_le hg0 hD R).trans ?_
    gcongr; exact hg.2.le
  have hcardG : (#G : ℝ) ≤ Cτ * (N : ℝ) ^ (1 / 8 : ℝ) := by
    have h1 : (#G : ℝ) ≤ (r.divisors.card : ℝ) := by exact_mod_cast Finset.card_filter_le _ _
    refine h1.trans ((hτ r (by omega)).trans ?_)
    gcongr
  calc (#{t ∈ Finset.Icc (-(R : ℤ)) R | Real.sqrt N < (Int.gcd (2 * d * b * t) r : ℝ)} : ℝ)
      ≤ (#(G.biUnion fun g => {t ∈ Finset.Icc (-(R : ℤ)) R | (g : ℤ) ∣ D * t}) : ℝ) := by
        exact_mod_cast Finset.card_le_card hsub
    _ ≤ ∑ g ∈ G, (#{t ∈ Finset.Icc (-(R : ℤ)) R | (g : ℤ) ∣ D * t} : ℝ) := by
        exact_mod_cast Finset.card_biUnion_le
    _ ≤ ∑ g ∈ G, (D * (2 * R) / Real.sqrt N + D + 1) := sum_le_sum hterm
    _ = #G * (D * (2 * R) / Real.sqrt N + D + 1) := by rw [sum_const, nsmul_eq_mul]
    _ ≤ Cτ * (N : ℝ) ^ (1 / 8 : ℝ) * (D * (2 * R) / Real.sqrt N + D + 1) := by
        gcongr
    _ ≤ Cτ * (6 * d + 1) * (N : ℝ) ^ (-(3 / 8 : ℝ)) * (2 * R + 1) := by
        have e1 : (N : ℝ) ^ (1 / 8 : ℝ) / Real.sqrt N = (N : ℝ) ^ (-(3 / 8 : ℝ)) := by
          rw [Real.sqrt_eq_rpow, ← Real.rpow_sub hN0]; norm_num
        have e2 : (N : ℝ) ^ (1 / 8 : ℝ) = (N : ℝ) ^ (-(3 / 8 : ℝ)) * Real.sqrt N := by
          rw [← e1, div_mul_cancel₀ _ hsq0.ne']
        have hp : 0 ≤ (N : ℝ) ^ (-(3 / 8 : ℝ)) := by positivity
        have hDd : (D : ℝ) = 2 * d := by simp only [D]; push_cast; ring
        have key : (N : ℝ) ^ (1 / 8 : ℝ) * (D * (2 * R) / Real.sqrt N + D + 1) ≤
            (6 * d + 1) * (N : ℝ) ^ (-(3 / 8 : ℝ)) * (2 * R + 1) := by
          rw [mul_add, mul_add, mul_div_assoc', mul_comm ((N : ℝ) ^ (1 / 8 : ℝ)) (D * (2 * R)),
            mul_div_assoc, e1, e2, hDd]
          have hd1 : (1 : ℝ) ≤ d := by exact_mod_cast hd
          nlinarith [mul_nonneg hp hsq0.le, mul_le_mul_of_nonneg_left hsqR hp]
        calc Cτ * (N : ℝ) ^ (1 / 8 : ℝ) * (D * (2 * R) / Real.sqrt N + D + 1)
            = Cτ * ((N : ℝ) ^ (1 / 8 : ℝ) * (D * (2 * R) / Real.sqrt N + D + 1)) := by ring
          _ ≤ Cτ * ((6 * d + 1) * (N : ℝ) ^ (-(3 / 8 : ℝ)) * (2 * R + 1)) :=
            mul_le_mul_of_nonneg_left key hCτ
          _ = _ := by ring

open scoped Classical in
/-- Blueprint Lemma 9.2, exceptional density for `D = 2`: for `N/2 ≤ r` and `R ≥ N`,
`#{t ∈ [-R, R] : r ∣ 2 v t for some 1 ≤ v ≤ N^{1/4}} ≤ 11 N^{-3/8} (2R + 1)`. -/
lemma card_exc_quad_le (r N : ℕ) (hN : 1 ≤ N) (hNr : N ≤ 2 * r) (R : ℕ) (hR : N ≤ R) :
    (#{t ∈ Finset.Icc (-(R : ℤ)) R | ∃ v : ℕ, 1 ≤ v ∧ (v : ℝ) ≤ (N : ℝ) ^ (1 / 4 : ℝ) ∧
        (r : ℤ) ∣ 2 * v * t} : ℝ) ≤ 11 * (N : ℝ) ^ (-(3 / 8 : ℝ)) * (2 * R + 1) := by
  classical
  have hN1 : (1 : ℝ) ≤ N := by exact_mod_cast hN
  have hN0 : (0 : ℝ) < N := by linarith
  have hr : 0 < r := by omega
  have hr0 : (0 : ℝ) < r := by exact_mod_cast hr
  have hRN : (N : ℝ) ≤ R := by exact_mod_cast hR
  set V : ℝ := (N : ℝ) ^ (1 / 4 : ℝ) with hV
  have hV1 : 1 ≤ V := Real.one_le_rpow hN1 (by norm_num)
  set w : ℝ := Real.sqrt N with hw
  have hw0 : 0 < w := Real.sqrt_pos.2 hN0
  have hw2 : w ^ 2 = N := Real.sq_sqrt hN0.le
  have hV2 : V ^ 2 = w := by
    rw [hV, hw, Real.sqrt_eq_rpow, ← Real.rpow_natCast, ← Real.rpow_mul hN0.le]; norm_num
  have hsub : {t ∈ Finset.Icc (-(R : ℤ)) R | ∃ v : ℕ, 1 ≤ v ∧ (v : ℝ) ≤ V ∧
        (r : ℤ) ∣ 2 * v * t} ⊆
      (Finset.Icc 1 ⌊V⌋₊).biUnion fun v =>
        {t ∈ Finset.Icc (-(R : ℤ)) R | (r : ℤ) ∣ ((2 * v : ℕ) : ℤ) * t} := by
    intro t ht
    rw [mem_filter] at ht
    obtain ⟨v, hv1, hvV, hdvd⟩ := ht.2
    rw [Finset.mem_biUnion]
    refine ⟨v, Finset.mem_Icc.2 ⟨hv1, Nat.le_floor hvV⟩, mem_filter.2 ⟨ht.1, ?_⟩⟩
    push_cast; exact hdvd
  have hterm : ∀ v ∈ Finset.Icc 1 ⌊V⌋₊,
      (#{t ∈ Finset.Icc (-(R : ℤ)) R | (r : ℤ) ∣ ((2 * v : ℕ) : ℤ) * t} : ℝ) ≤
        2 * V * (2 * R) / r + 2 * V + 1 := by
    intro v hv
    rw [Finset.mem_Icc] at hv
    have hvV : (v : ℝ) ≤ V := (Nat.le_floor_iff (by linarith)).1 hv.2
    refine (arith_card_Icc_filter_dvd_le hr (by omega) R).trans ?_
    push_cast
    gcongr
  have hcard : (#(Finset.Icc 1 ⌊V⌋₊) : ℝ) ≤ V := by
    rw [Nat.card_Icc, Nat.add_sub_cancel]; exact Nat.floor_le (by linarith)
  have h2r : (N : ℝ) ≤ 2 * r := by exact_mod_cast hNr
  calc (#{t ∈ Finset.Icc (-(R : ℤ)) R | ∃ v : ℕ, 1 ≤ v ∧ (v : ℝ) ≤ V ∧
        (r : ℤ) ∣ 2 * v * t} : ℝ)
      ≤ (#((Finset.Icc 1 ⌊V⌋₊).biUnion fun v =>
          {t ∈ Finset.Icc (-(R : ℤ)) R | (r : ℤ) ∣ ((2 * v : ℕ) : ℤ) * t}) : ℝ) := by
        exact_mod_cast Finset.card_le_card hsub
    _ ≤ ∑ v ∈ Finset.Icc 1 ⌊V⌋₊,
          (#{t ∈ Finset.Icc (-(R : ℤ)) R | (r : ℤ) ∣ ((2 * v : ℕ) : ℤ) * t} : ℝ) := by
        exact_mod_cast Finset.card_biUnion_le
    _ ≤ ∑ v ∈ Finset.Icc 1 ⌊V⌋₊, (2 * V * (2 * R) / r + 2 * V + 1) := sum_le_sum hterm
    _ = #(Finset.Icc 1 ⌊V⌋₊) * (2 * V * (2 * R) / r + 2 * V + 1) := by
        rw [sum_const, nsmul_eq_mul]
    _ ≤ V * (2 * V * (2 * R) / r + 2 * V + 1) := by gcongr
    _ ≤ 11 * R / w := by
        have e1 : 2 * V * (2 * R) / r ≤ 8 * V * R / N := by
          have h4 : (0 : ℝ) ≤ 4 * V * R := by positivity
          rw [div_le_div_iff₀ hr0 hN0]; nlinarith [mul_le_mul_of_nonneg_left h2r h4]
        have e2 : V * (8 * V * R / N) = 8 * R / w := by
          rw [← hw2]; field_simp; rw [← hV2]; ring
        have e3 : V * (2 * V + 1) ≤ 3 * w := by nlinarith
        have e4 : 3 * w ≤ 3 * R / w := by
          rw [le_div_iff₀ hw0]; nlinarith
        calc V * (2 * V * (2 * R) / r + 2 * V + 1)
            = V * (2 * V * (2 * R) / r) + V * (2 * V + 1) := by ring
          _ ≤ V * (8 * V * R / N) + 3 * w := by gcongr
          _ ≤ 8 * R / w + 3 * R / w := by rw [e2]; linarith
          _ = 11 * R / w := by ring
    _ ≤ 11 * (N : ℝ) ^ (-(3 / 8 : ℝ)) * (2 * R + 1) := by
        have e5 : 1 / w ≤ (N : ℝ) ^ (-(3 / 8 : ℝ)) := by
          rw [hw, Real.sqrt_eq_rpow, one_div, ← Real.rpow_neg hN0.le]
          exact Real.rpow_le_rpow_of_exponent_le hN1 (by norm_num)
        have hp : 0 ≤ (N : ℝ) ^ (-(3 / 8 : ℝ)) := by positivity
        calc 11 * R / w = 11 * R * (1 / w) := by ring
          _ ≤ 11 * R * (N : ℝ) ^ (-(3 / 8 : ℝ)) := by gcongr
          _ ≤ 11 * (N : ℝ) ^ (-(3 / 8 : ℝ)) * (2 * R + 1) := by nlinarith

open scoped Classical in
/-- Blueprint Lemma 9.2, the complete-sum bound in both degree cases: there are `c, b > 0` (here
`b = 3/8`) with `|G| ≤ C N^{-c} + 𝟙_{E}(h₁)` for an exceptional set `E ⊆ ℤ` depending only on
`(b, r)` (and `N`), of density at most `C' N^{-3/8}` in every interval `[-R, R]`, `R ≥ N`. -/
lemma exists_arithG_bound {m d : ℕ} (hd : 1 ≤ d) :
    ∃ C c C' : ℝ, 0 ≤ C ∧ 0 < c ∧ 0 ≤ C' ∧ ∀ N b r : ℕ, 1 ≤ N → N ≤ 2 * r → r ≤ N →
      Nat.Coprime b r → ∃ E : Set ℤ,
        (∀ R : ℕ, N ≤ R → (#{t ∈ Finset.Icc (-(R : ℤ)) R | t ∈ E} : ℝ) ≤
          C' * (N : ℝ) ^ (-(3 / 8 : ℝ)) * (2 * R + 1)) ∧
        ∀ (a q : ℕ) (h : Fin (m + 1) → ℤ), 1 ≤ q →
          ‖arithG (m + 1) d a q b r h‖ ≤ C * (N : ℝ) ^ (-c) + if h 0 ∈ E then 1 else 0 := by
  rcases Nat.lt_or_ge d 2 with hd1 | hd2
  · obtain rfl : d = 1 := by omega
    refine ⟨Real.sqrt 2, 1 / 8, 11, by positivity, by norm_num, by norm_num,
      fun N b r hN hNr hrN hbr => ?_⟩
    refine ⟨{t | ∃ v : ℕ, 1 ≤ v ∧ (v : ℝ) ≤ (N : ℝ) ^ (1 / 4 : ℝ) ∧ (r : ℤ) ∣ 2 * v * t},
      fun R hR => ?_, fun a q h hq => ?_⟩
    · simpa only [Set.mem_ofPred_eq] using card_exc_quad_le r N hN hNr R hR
    · simpa only [Set.mem_ofPred_eq] using norm_arithG_one_le a q b r N hq (by omega) hN hbr h
  · obtain ⟨C, c, hC, hc, hsl⟩ := norm_arithG_slice_le (m := m) hd2
    obtain ⟨C', hC', hcnt⟩ := card_exc_slice_le d hd
    refine ⟨C, c, C', by linarith, hc, hC', fun N b r hN hNr hrN hbr => ?_⟩
    refine ⟨{t | Real.sqrt N < (Int.gcd (2 * d * b * t) r : ℝ)}, fun R hR => ?_,
      fun a q h hq => ?_⟩
    · simpa only [Set.mem_ofPred_eq] using hcnt b r N (by omega) hrN hbr R hR
    · by_cases hE : h 0 ∈ {t : ℤ | Real.sqrt N < (Int.gcd (2 * d * b * t) r : ℝ)}
      · rw [ite_eq_left hE]
        have h1 := norm_arithG_le_one (n := m + 1) (q := q) (r := r) d a b hq (by omega) h
        have h2 : 0 ≤ C * (N : ℝ) ^ (-c) := by positivity
        linarith
      · rw [ite_eq_right hE, add_zero]
        exact hsl a q b r N hq (by omega) hN hNr hrN h (not_lt.1 hE)


open scoped Classical in
/-- The lattice points of the cube `|hᵢ| ≤ R` whose first coordinate lies in `E`. -/
lemma arith_count_intCube_inter_le {m : ℕ} (E : Set ℤ) (R : ℕ) {δ : ℝ}
    (hE : (#{t ∈ Finset.Icc (-(R : ℤ)) R | t ∈ E} : ℝ) ≤ δ * (2 * R + 1)) :
    Measure.count (intCube (0 : Fin (m + 1) → ℤ) R ∩ {h | h 0 ∈ E}) ≤
      ENNReal.ofReal (δ * (2 * R + 1) ^ (m + 1)) := by
  set t : Fin (m + 1) → Finset ℤ := fun i =>
    if i = 0 then {t ∈ Finset.Icc (-(R : ℤ)) R | t ∈ E} else Finset.Icc (-(R : ℤ)) R
  have hset : intCube (0 : Fin (m + 1) → ℤ) R ∩ {h | h 0 ∈ E} = (Fintype.piFinset t : Set _) := by
    ext h
    simp only [intCube, Set.mem_inter_iff, Set.mem_ofPred_eq, Pi.zero_apply, sub_zero,
      Finset.mem_coe, Fintype.mem_piFinset, t]
    constructor
    · rintro ⟨h1, h2⟩ i
      split_ifs with hi
      · subst hi; exact mem_filter.2 ⟨Finset.mem_Icc.2 (abs_le.1 (h1 0)), h2⟩
      · exact Finset.mem_Icc.2 (abs_le.1 (h1 i))
    · intro h1
      refine ⟨fun i => ?_, ?_⟩
      · have := h1 i
        split_ifs at this with hi
        · exact abs_le.2 (Finset.mem_Icc.1 (mem_filter.1 this).1)
        · exact abs_le.2 (Finset.mem_Icc.1 this)
      · have := h1 0
        simp only [↓reduceIte] at this
        exact (mem_filter.1 this).2
  rw [hset, Measure.count_apply_finset, Fintype.card_piFinset, Fin.prod_univ_succ]
  simp only [t, ↓reduceIte, Fin.succ_ne_zero, prod_const, card_univ, Fintype.card_fin,
    Int.card_Icc]
  have hc : ((R : ℤ) + 1 - -(R : ℤ)).toNat = 2 * R + 1 := by omega
  rw [hc, ← ENNReal.ofReal_natCast]
  refine ENNReal.ofReal_le_ofReal ?_
  push_cast
  rw [pow_succ']
  have : (0 : ℝ) ≤ (2 * R + 1) ^ m := by positivity
  nlinarith

open scoped Classical in
/-- Blueprint Lemma 9.2, the lattice sum of `B_L` over an exceptional set (dyadic shells): if
`E ⊆ ℤ` has density at most `δ` in every interval `[-R, R]` with `R ≥ L` (`L ≥ 1`), then
`∑_{h : h₁ ∈ E} B_L(h) ≤ C_n δ`, `C_n = envelopeConst n`. -/
lemma arith_tsum_latEnvelope_indicator_le {m : ℕ} {E : Set ℤ} {L δ : ℝ} (hL : 1 ≤ L) (hδ : 0 ≤ δ)
    (hE : ∀ R : ℕ, L ≤ R → (#{t ∈ Finset.Icc (-(R : ℤ)) R | t ∈ E} : ℝ) ≤ δ * (2 * R + 1)) :
    ∑' h : Fin (m + 1) → ℤ, ENNReal.ofReal (latEnvelope (m + 1) L h) *
        (if h 0 ∈ E then 1 else 0) ≤
      ENNReal.ofReal (envelopeConst (m + 1) * δ) := by
  have hL0 : 0 < L := by linarith
  set T : Set (Fin (m + 1) → ℤ) := {h | h 0 ∈ E}
  have hg : ∀ h : Fin (m + 1) → ℤ, (if h 0 ∈ E then (1 : ℝ≥0∞) else 0) = T.indicator 1 h := by
    intro h; by_cases hh : h 0 ∈ E <;> simp [T, hh]
  simp_rw [hg]
  rw [← lintegral_count]
  refine (lintegral_mul_le_tsum_setLIntegral Measure.count
    (AEMeasurable.of_discrete (f := T.indicator 1))
    (fun k => MeasurableSet.of_discrete (s := intCube 0 ⌈2 ^ k * L⌉₊)) _
    (envelope_le_tsum_indicator_int hL0)).trans ?_
  rw [ENNReal.ofReal_mul (by unfold envelopeConst; positivity),
    ← tsum_envelopeCoeff_mul (m + 1) hL0]
  refine ENNReal.tsum_le_tsum fun k => ?_
  gcongr
  rw [lintegral_indicator_one MeasurableSet.of_discrete, Measure.restrict_apply
    MeasurableSet.of_discrete, Set.inter_comm]
  set R : ℕ := ⌈2 ^ k * L⌉₊
  have hk1 : (1 : ℝ) ≤ 2 ^ k * L := one_le_mul_of_one_le_of_one_le (one_le_pow₀ one_le_two) hL
  have hLR : L ≤ R := by
    have : L ≤ 2 ^ k * L := le_mul_of_one_le_left hL0.le (one_le_pow₀ one_le_two)
    exact this.trans (Nat.le_ceil _)
  refine (arith_count_intCube_inter_le E R (hE R hLR)).trans ?_
  rw [← ENNReal.ofReal_mul (by positivity), mul_comm]
  refine ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_right ?_ hδ)
  refine pow_le_pow_left₀ (by positivity) ?_ _
  have := Nat.ceil_lt_add_one (show 0 ≤ 2 ^ k * L by positivity)
  linarith


/-- The Schwartz function `𝓕⁻ χ`, of which `φ_s` is the `L_s`-dilate
(`arith_liftPhi_eq_dilateL`). -/
noncomputable def arithPhiS (n : ℕ) : 𝓢(EuclideanSpace ℝ (Fin n), ℂ) := 𝓕⁻ (liftCutoffSchwartz n)

/-- `φ_s = (𝓕⁻ χ)_{L_s}` is the `L_s`-dilate of the Schwartz function `𝓕⁻ χ`. -/
lemma arith_liftPhi_eq_dilateL (s : ℕ) :
    liftPhi n d Ω p s =
      dilateL (arithPhiS n)
        (liftL n d Ω p s : ℝ) := by
  funext x
  have hL := liftL_pos (n := n) (d := d) (Ω := Ω) (p := p) s
  have hL' : 0 < (liftL n d Ω p s : ℝ)⁻¹ := inv_pos.2 hL
  have hfun : (fun ξ : EuclideanSpace ℝ (Fin n) => (liftChi n d Ω p s ξ : ℂ)) =
      fun ξ => liftCutoffSchwartz n (((liftL n d Ω p s : ℝ)⁻¹)⁻¹ • ξ) := by
    funext ξ; rw [inv_inv, liftCutoffSchwartz_apply]; rfl
  rw [liftPhi, hfun, fourierInv_comp_inv_smul _ hL', arithPhiS, ← SchwartzMap.fourierInv_coe,
    dilateL, inv_pow]

/-- Uniform bounds for `φ_s` on `G`: `|φ_s(y)| ≤ C B_{L_s}(y) ≤ C`, with `∑_y |φ_s(y)| ≤ C C_n`. -/
lemma arith_liftPhi_bounds (n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ),
      (∀ y : Fin n → ℤ, ‖liftPhi n d Ω p s (latEmbed y)‖ ≤
        C * latEnvelope n (liftL n d Ω p s) y) ∧
      (∀ y : Fin n → ℤ, ‖liftPhi n d Ω p s (latEmbed y)‖ ≤ C) ∧
      ∑' y : Fin n → ℤ, ‖liftPhi n d Ω p s (latEmbed y)‖ₑ ≤
        ENNReal.ofReal (C * envelopeConst n) := by
  obtain ⟨C, hC, h⟩ := norm_liftPhi_le n
  refine ⟨C, hC, fun d Ω p s => ⟨(h d Ω p s).2, fun y => ?_, ?_⟩⟩
  · have hL1 : (1 : ℝ) ≤ liftL n d Ω p s := by
      unfold liftL; exact_mod_cast Nat.one_le_two_pow
    refine ((h d Ω p s).2 y).trans (mul_le_of_le_one_right hC ?_)
    unfold latEnvelope envelope
    have h1 : ((liftL n d Ω p s : ℝ) ^ n)⁻¹ ≤ 1 := inv_le_one_of_one_le₀ (one_le_pow₀ hL1)
    have h2 : ((1 + ‖latEmbed y‖ / (liftL n d Ω p s : ℝ)) ^ (n + 1))⁻¹ ≤ 1 :=
      inv_le_one_of_one_le₀ (one_le_pow₀ (by
        have : 0 ≤ ‖latEmbed y‖ / (liftL n d Ω p s : ℝ) := by positivity
        linarith))
    have h3 : 0 ≤ ((liftL n d Ω p s : ℝ) ^ n)⁻¹ := by positivity
    have h4 : 0 ≤ ((1 + ‖latEmbed y‖ / (liftL n d Ω p s : ℝ)) ^ (n + 1))⁻¹ := by positivity
    nlinarith
  · have hL1 : (1 : ℝ) ≤ liftL n d Ω p s := by
      unfold liftL; exact_mod_cast Nat.one_le_two_pow
    obtain ⟨hs, hsum⟩ := summable_latEnvelope_and_tsum_le (n := n) hL1
    calc ∑' y : Fin n → ℤ, ‖liftPhi n d Ω p s (latEmbed y)‖ₑ
        ≤ ∑' y : Fin n → ℤ, ENNReal.ofReal (C * latEnvelope n (liftL n d Ω p s) y) :=
          ENNReal.tsum_le_tsum fun y => by
            rw [← ofReal_norm]; exact ENNReal.ofReal_le_ofReal ((h d Ω p s).2 y)
      _ = ENNReal.ofReal (∑' y, C * latEnvelope n (liftL n d Ω p s) y) :=
          (ENNReal.ofReal_tsum_of_nonneg (fun y => mul_nonneg hC
            (envelope_nonneg (by linarith) _)) (hs.mul_left C)).symm
      _ ≤ ENNReal.ofReal (C * envelopeConst n) := by
          rw [tsum_mul_left]; exact ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_left hsum hC)

/-- Blueprint Lemma 9.1 applied to `f ∈ ℓ¹`:
`A_{s,a/q} f(x) = ∑_y e((a/q) P(x - y)) φ_s(x - y) f(y)`. -/
lemma arith_latMult_liftA_eq (s a : ℕ) {q : ℕ} (hq : 1 ≤ q) {f : (Fin n → ℤ) → ℂ}
    (hf : Summable fun z => ‖f z‖) (x : Fin n → ℤ) :
    latMult (liftA n d Ω p s a q) f x = ∑' y, eC ((a : ℝ) / q * (radialPolyZ n d (x - y) : ℝ)) *
      liftPhi n d Ω p s (latEmbed (x - y)) * f y := by
  have hint : IntegrableOn (liftA n d Ω p s a q) (torusCube n) :=
    integrableOn_liftSym (by simpa using integrable_liftChi (n := n) (d := d) (Ω := Ω) (p := p) s)
  rw [latMult_eq_latConv hint hf, latConv, ← (Equiv.subLeft x).tsum_eq]
  refine tsum_congr fun y => ?_
  simp only [Equiv.subLeft_apply, sub_sub_cancel, latKernel_liftA s a hq]

/-- A counting-measure integral of an absolutely summable function is its sum. -/
lemma arith_integral_count_eq_tsum {α : Type*} [MeasurableSpace α] [MeasurableSingletonClass α]
    [Countable α] {g : α → ℂ} (hg : Summable fun z => ‖g z‖) :
    ∫ z, g z ∂Measure.count = ∑' z, g z := by
  rw [integral_countable (integrable_count_iff.2 hg)]
  simp

/-- `y ↦ |φ_s(y)|` is summable on `G`. -/
lemma arith_summable_norm_liftPhi (s : ℕ) :
    Summable fun y : Fin n → ℤ => ‖liftPhi n d Ω p s (latEmbed y)‖ := by
  obtain ⟨C, hC, h⟩ := arith_liftPhi_bounds n
  have hL1 : (1 : ℝ) ≤ liftL n d Ω p s := by
    unfold liftL; exact_mod_cast Nat.one_le_two_pow
  exact Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (h d Ω p s).1
    ((summable_latEnvelope_and_tsum_le hL1).1.mul_left C)

/-- The kernel `κ(x, y) = e(α_x P(x - y)) φ_s(x - y)` of the linearized operator
`x ↦ A_{s, α_x} f(x)`, with `α_x = a_x / q_x` for the selection `σ(x) = (a_x, q_x)`. -/
noncomputable def arithKer (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ)
    (σ : (Fin n → ℤ) → ℕ × ℕ) (x y : Fin n → ℤ) : ℂ :=
  eC (((σ x).1 : ℝ) / (σ x).2 * (radialPolyZ n d (x - y) : ℝ)) *
    liftPhi n d Ω p s (latEmbed (x - y))

lemma norm_arithKer (s : ℕ) (σ : (Fin n → ℤ) → ℕ × ℕ) (x y : Fin n → ℤ) :
    ‖arithKer n d Ω p s σ x y‖ = ‖liftPhi n d Ω p s (latEmbed (x - y))‖ := by
  rw [arithKer, norm_mul, norm_eC, one_mul]

/-- The linearized operator is the kernel operator of `arithKer`. -/
lemma latMult_liftA_sel_eq (s : ℕ) (σ : (Fin n → ℤ) → ℕ × ℕ) (hσ : ∀ x, 1 ≤ (σ x).2)
    {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) (x : Fin n → ℤ) :
    latMult (liftA n d Ω p s (σ x).1 (σ x).2) f x =
      ∫ y, arithKer n d Ω p s σ x y * f y ∂Measure.count := by
  obtain ⟨C, hC, hb⟩ := arith_liftPhi_bounds n
  rw [arith_latMult_liftA_eq s _ (hσ x) hf, arith_integral_count_eq_tsum]
  · rfl
  · refine Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun y => ?_) (hf.mul_left C)
    rw [norm_mul, norm_arithKer]
    exact mul_le_mul_of_nonneg_right ((hb d Ω p s).2.1 _) (norm_nonneg _)

/-- The `TT*` kernel of the linearization (via Blueprint Lemma 9.1):
`H(x, x') = ∑_z e(α_x P(z) - α_{x'} P(z + h)) φ_s(z) conj φ_s(z + h)`, `h = x' - x`. -/
lemma integral_arithKer_mul_conj (s : ℕ) (σ : (Fin n → ℤ) → ℕ × ℕ) (x x' : Fin n → ℤ) :
    ∫ y, arithKer n d Ω p s σ x y * conj (arithKer n d Ω p s σ x' y) ∂Measure.count =
      ∑' z, eC (arithPhase n d (((σ x).1 : ℝ) / (σ x).2) (((σ x').1 : ℝ) / (σ x').2)
          (x' - x) z) * liftPhi n d Ω p s (latEmbed z) *
        conj (liftPhi n d Ω p s (latEmbed z + latEmbed (x' - x))) := by
  obtain ⟨C, hC, hb⟩ := arith_liftPhi_bounds n
  rw [arith_integral_count_eq_tsum]
  · rw [← (Equiv.subLeft x).tsum_eq]
    refine tsum_congr fun z => ?_
    simp only [Equiv.subLeft_apply, arithKer, sub_sub_cancel, map_mul, conj_eC]
    have e : x' - (x - z) = z + (x' - x) := by abel
    rw [e, latEmbed_add, arithPhase, sub_eq_add_neg _ (_ * _), eC_add]
    ring_nf
  · have hs := (arith_summable_norm_liftPhi (n := n) (d := d) (Ω := Ω) (p := p) s).comp_injective
      (Equiv.subLeft x).injective
    refine Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun y => ?_) (hs.mul_left C)
    rw [norm_mul, RCLike.norm_conj, norm_arithKer, norm_arithKer, mul_comm]
    exact mul_le_mul_of_nonneg_right ((hb d Ω p s).2.1 _) (norm_nonneg _)

/-- `|H(x, x')| = |H(x', x)|` for a `TT*` kernel. -/
lemma arith_enorm_integral_mul_conj_symm {α : Type*} [MeasurableSpace α] {μ : Measure α}
    (k : α → α → ℂ) (x x' : α) :
    ‖∫ z, k x z * conj (k x' z) ∂μ‖ₑ = ‖∫ z, k x' z * conj (k x z) ∂μ‖ₑ := by
  rw [← RCLike.enorm_conj, ← integral_conj]
  congr 2; funext z
  rw [map_mul, RCLike.conj_conj, mul_comm]

/-- Blueprint Lemma 9.2, eq. (`eq:arithH`), via Lemma 3.7 (`lem:periodic`): there is `C`
(depending only on `n`) such that for `α = a/q`, `β = b/r` and `Q = q r ≤ L_s`,
`|H| ≤ C (|G_Q| + Q/L_s) B_{L_s}(h)` for the `TT*` sum
`H = ∑_z e(α P(z) - β P(z + h)) φ_s(z) conj φ_s(z + h)`. -/
lemma norm_arithTT_le (n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s a q b r : ℕ),
      1 ≤ q → 1 ≤ r → ((q * r : ℕ) : ℝ) ≤ liftL n d Ω p s → ∀ h : Fin n → ℤ,
        ‖∑' z, eC (arithPhase n d ((a : ℝ) / q) ((b : ℝ) / r) h z) *
            liftPhi n d Ω p s (latEmbed z) * conj (liftPhi n d Ω p s (latEmbed z + latEmbed h))‖ ≤
          C * (‖arithG n d a q b r h‖ + ((q * r : ℕ) : ℝ) / liftL n d Ω p s) *
            latEnvelope n (liftL n d Ω p s) h := by
  obtain ⟨C, hC, hper⟩ := periodic_riemann_sum (arithPhiS n)
  refine ⟨C, hC, fun d Ω p s a q b r hq hr hQL h => ?_⟩
  have hQ : 1 ≤ q * r := Nat.mul_pos hq hr
  set L : ℝ := (liftL n d Ω p s : ℝ)
  have hL0 : 0 < L := liftL_pos s
  obtain ⟨-, h1, h2⟩ := hper L (q * r) hQ hQL
    (fun z => eC (arithPhase n d ((a : ℝ) / q) ((b : ℝ) / r) h z))
    (fun z z' hzz => eC_arithPhase_periodic d a b hq hr h hzz)
    (fun z => (norm_eC _).le) h
  rw [arith_liftPhi_eq_dilateL]
  set T := ∑' z, eC (arithPhase n d ((a : ℝ) / q) ((b : ℝ) / r) h z) *
    dilateL (arithPhiS n) L (latEmbed z) * conj (dilateL (arithPhiS n) L (latEmbed z + latEmbed h))
  set I := ∫ w, dilateL (arithPhiS n) L w * conj (dilateL (arithPhiS n) L (w + latEmbed h))
  have hG : ((((q * r : ℕ) : ℂ) ^ n)⁻¹ * ∑ u : Fin n → Fin (q * r),
      eC (arithPhase n d ((a : ℝ) / q) ((b : ℝ) / r) h fun i => ((u i : ℕ) : ℤ))) =
      arithG n d a q b r h := rfl
  rw [hG] at h1
  have hB : 0 ≤ latEnvelope n L h := envelope_nonneg hL0 _
  calc ‖T‖ ≤ ‖T - arithG n d a q b r h * I‖ + ‖arithG n d a q b r h * I‖ := by
        have := norm_le_insert' T (arithG n d a q b r h * I); linarith
    _ ≤ C * (((q * r : ℕ) : ℝ) / L) * latEnvelope n L h +
          ‖arithG n d a q b r h‖ * (C * latEnvelope n L h) := by
        rw [norm_mul]; gcongr
    _ = C * (‖arithG n d a q b r h‖ + ((q * r : ℕ) : ℝ) / L) * latEnvelope n L h := by ring

open scoped Classical in
/-- Column sums of a kernel with the bound of eq. (`eq:arithH`): if
`|F(h)| ≤ K (ε + 𝟙_E(h₁)) B_L(h)` and `E` has density `≤ δ` in intervals `[-R, R]`, `R ≥ L`, then
`∑_h |F(h)| ≤ K C_n (ε + δ)`. -/
lemma tsum_enorm_le_of_arith_bound {m : ℕ} {E : Set ℤ} {L ε δ K : ℝ} (hL : 1 ≤ L)
    (hε : 0 ≤ ε) (hδ : 0 ≤ δ) (hK : 0 ≤ K)
    (hE : ∀ R : ℕ, L ≤ R → (#{t ∈ Finset.Icc (-(R : ℤ)) R | t ∈ E} : ℝ) ≤ δ * (2 * R + 1))
    (F : (Fin (m + 1) → ℤ) → ℂ)
    (hF : ∀ h, ‖F h‖ ≤ K * (ε + if h 0 ∈ E then 1 else 0) * latEnvelope (m + 1) L h) :
    ∑' h, ‖F h‖ₑ ≤ ENNReal.ofReal (K * envelopeConst (m + 1) * (ε + δ)) := by
  have hL0 : 0 < L := by linarith
  have hCn : 0 ≤ envelopeConst (m + 1) := by unfold envelopeConst; positivity
  have hpt : ∀ h, ‖F h‖ₑ ≤ ENNReal.ofReal (K * ε) * ENNReal.ofReal (latEnvelope (m + 1) L h) +
      ENNReal.ofReal K * (ENNReal.ofReal (latEnvelope (m + 1) L h) *
        (if h 0 ∈ E then 1 else 0)) := by
    intro h
    have hB := envelope_nonneg (n := m + 1) hL0 (latEmbed h)
    rw [← ofReal_norm]
    refine (ENNReal.ofReal_le_ofReal (hF h)).trans ?_
    split_ifs with hh
    · rw [mul_one, ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul hK,
        ← ENNReal.ofReal_add (by positivity) (by positivity)]
      refine ENNReal.ofReal_le_ofReal (le_of_eq ?_)
      unfold latEnvelope; ring
    · rw [mul_zero, mul_zero, add_zero, add_zero, ← ENNReal.ofReal_mul (by positivity)]
  have hall : ∑' h, ENNReal.ofReal (latEnvelope (m + 1) L h) ≤
      ENNReal.ofReal (envelopeConst (m + 1)) := by
    obtain ⟨hs, hsum⟩ := summable_latEnvelope_and_tsum_le (n := m + 1) hL
    rw [← ENNReal.ofReal_tsum_of_nonneg (f := latEnvelope (m + 1) L)
      (fun h => envelope_nonneg hL0 _) hs]
    exact ENNReal.ofReal_le_ofReal hsum
  have hexc := arith_tsum_latEnvelope_indicator_le (m := m) hL hδ hE
  calc ∑' h, ‖F h‖ₑ
      ≤ ∑' h, (ENNReal.ofReal (K * ε) * ENNReal.ofReal (latEnvelope (m + 1) L h) +
          ENNReal.ofReal K * (ENNReal.ofReal (latEnvelope (m + 1) L h) *
            (if h 0 ∈ E then 1 else 0))) := ENNReal.tsum_le_tsum hpt
    _ = ENNReal.ofReal (K * ε) * ∑' h, ENNReal.ofReal (latEnvelope (m + 1) L h) +
          ENNReal.ofReal K * ∑' h, ENNReal.ofReal (latEnvelope (m + 1) L h) *
            (if h 0 ∈ E then 1 else 0) := by
        rw [ENNReal.tsum_add, ENNReal.tsum_mul_left, ENNReal.tsum_mul_left]
    _ ≤ ENNReal.ofReal (K * ε) * ENNReal.ofReal (envelopeConst (m + 1)) +
          ENNReal.ofReal K * ENNReal.ofReal (envelopeConst (m + 1) * δ) := by
        gcongr
    _ = ENNReal.ofReal (K * envelopeConst (m + 1) * (ε + δ)) := by
        rw [← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul hK,
          ← ENNReal.ofReal_add (by positivity) (by positivity)]
        congr 1; ring

/-- `ℓ¹(ℤⁿ) ⊆ ℓ²(ℤⁿ)`. -/
lemma arith_memLp_two_of_summable {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) :
    MemLp f 2 Measure.count := by
  rw [memLp_two_iff_integrable_sq_norm AEStronglyMeasurable.of_discrete, integrable_count_iff]
  refine Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun z => ?_)
    (hf.mul_left (∑' z, ‖f z‖))
  rw [Real.norm_of_nonneg (by positivity), sq]
  exact mul_le_mul_of_nonneg_right (hf.le_tsum z fun _ _ => norm_nonneg _) (norm_nonneg _)

lemma enorm_arithKer (s : ℕ) (σ : (Fin n → ℤ) → ℕ × ℕ) (x y : Fin n → ℤ) :
    ‖arithKer n d Ω p s σ x y‖ₑ = ‖liftPhi n d Ω p s (latEmbed (x - y))‖ₑ := by
  rw [← ofReal_norm, ← ofReal_norm, norm_arithKer]

/-- `N_s^3 ≤ L_s` (from eq. (9.2), `eq:scalerequirements`). -/
lemma arith_liftN_pow_three_le_liftL (s : ℕ) : ((liftN s : ℕ) : ℝ) ^ 3 ≤ liftL n d Ω p s := by
  have h : liftN s ^ 3 ≤ liftL n d Ω p s := by
    refine le_trans ?_ (pow_le_liftL (n := n) (d := d) (Ω := Ω) (p := p) s)
    rw [liftN, ← pow_mul]
    exact Nat.pow_le_pow_right (by norm_num) (by nlinarith)
  exact_mod_cast h

/-- Blueprint Lemma 9.2, the linearized `ℓ²` bound: for every selection `x ↦ σ(x) = (a_x, q_x)`
of `𝓡_s`, the `TT*` kernel has column (and, by symmetry, row) sums at most `K N_s^{-c₀}`, so by
Schur's test and `TT*` (Lemma 2.5), `‖x ↦ A_{s, α_x} f(x)‖₂ ≤ (K N_s^{-c₀})^{1/2} ‖f‖₂`. -/
lemma arith_linearized_bound {m d : ℕ} (hd : 1 ≤ d) :
    ∃ K c₀ : ℝ, 0 ≤ K ∧ 0 < c₀ ∧ ∀ (Ω : EuclideanSpace ℝ (Fin (m + 1)) → ℂ) (p : ℝ) (s : ℕ),
      1 ≤ s → ∀ σ : (Fin (m + 1) → ℤ) → ℕ × ℕ, (∀ x, σ x ∈ liftRat s) →
      ∀ f : (Fin (m + 1) → ℤ) → ℂ, Summable (fun z => ‖f z‖) →
        eLpNorm (fun x => latMult (liftA (m + 1) d Ω p s (σ x).1 (σ x).2) f x) 2
            Measure.count ≤
          ENNReal.ofReal (K * ((liftN s : ℕ) : ℝ) ^ (-c₀)) ^ (1 / 2 : ℝ) *
            eLpNorm f 2 Measure.count := by
  obtain ⟨Cφ, hCφ, hφ⟩ := arith_liftPhi_bounds (m + 1)
  obtain ⟨Cp, hCp, hTT⟩ := norm_arithTT_le (m + 1)
  obtain ⟨C, c, C', hC, hc, hC', hG⟩ := exists_arithG_bound (m := m) hd
  set Cn := envelopeConst (m + 1) with hCn_def
  have hCn : 0 ≤ Cn := by unfold Cn envelopeConst; positivity
  set c₀ := min c (3 / 8) with hc₀_def
  have hc₀ : 0 < c₀ := lt_min hc (by norm_num)
  refine ⟨Cp * Cn * (C + 1 + C'), c₀, by positivity, hc₀, fun Ω p s hs σ hσ f hf => ?_⟩
  set N : ℕ := liftN s
  set L : ℝ := (liftL (m + 1) d Ω p s : ℝ)
  have hN2 : 2 ≤ N := two_le_liftN hs
  have hN1 : (1 : ℝ) ≤ N := by exact_mod_cast (by omega : 1 ≤ N)
  have hN0 : (0 : ℝ) < N := by linarith
  have hNL3 : (N : ℝ) ^ 3 ≤ L := arith_liftN_pow_three_le_liftL s
  have hNL : (N : ℝ) ≤ L := le_trans (le_self_pow₀ hN1 (by norm_num)) hNL3
  have hL1 : 1 ≤ L := hN1.trans hNL
  have hL0 : 0 < L := by linarith
  have hmem : ∀ x, N ≤ 2 * (σ x).2 ∧ (σ x).2 < N ∧ (σ x).1 < (σ x).2 ∧
      Nat.Coprime (σ x).1 (σ x).2 := fun x => mem_liftRat.1 (hσ x)
  have hq1 : ∀ x, 1 ≤ (σ x).2 := fun x => by have := (hmem x).2.2.1; omega
  set κ := arithKer (m + 1) d Ω p s σ
  rw [show (fun x => latMult (liftA (m + 1) d Ω p s (σ x).1 (σ x).2) f x) =
    fun x => ∫ y, κ x y * f y ∂Measure.count from
      funext fun x => latMult_liftA_sel_eq s σ hq1 hf x]
  set ε : ℝ := C * (N : ℝ) ^ (-c) + (N : ℝ) ^ 2 / L
  set δ : ℝ := C' * (N : ℝ) ^ (-(3 / 8 : ℝ))
  have hε : 0 ≤ ε := by positivity
  have hδ : 0 ≤ δ := by positivity
  -- column sums of the `TT*` kernel
  have hcolH : ∀ x', ∑' x, ‖∫ y, κ x y * conj (κ x' y) ∂Measure.count‖ₑ ≤
      ENNReal.ofReal (Cp * Cn * (ε + δ)) := by
    intro x'
    obtain ⟨hbN, hrN, -, hbr⟩ := hmem x'
    obtain ⟨E, hEd, hEb⟩ := hG N (σ x').1 (σ x').2 (by omega) hbN hrN.le hbr
    rw [← (Equiv.subLeft x').tsum_eq]
    refine tsum_enorm_le_of_arith_bound (m := m) (E := E) hL1 hε hδ hCp (fun R hR => ?_)
      (fun h => ∫ y, κ (x' - h) y * conj (κ x' y) ∂Measure.count) (fun h => ?_)
    · have : N ≤ R := by exact_mod_cast hNL.trans hR
      exact hEd R this
    · rw [integral_arithKer_mul_conj, sub_sub_cancel]
      obtain ⟨haN, hqN, -, -⟩ := hmem (x' - h)
      have hQN : (((σ (x' - h)).2 * (σ x').2 : ℕ) : ℝ) ≤ (N : ℝ) ^ 2 := by
        have : (σ (x' - h)).2 * (σ x').2 ≤ N ^ 2 := by
          rw [sq]; exact Nat.mul_le_mul hqN.le hrN.le
        exact_mod_cast this
      have hQL : (((σ (x' - h)).2 * (σ x').2 : ℕ) : ℝ) ≤ L := hQN.trans
        (le_trans (pow_le_pow_right₀ hN1 (by norm_num)) hNL3)
      refine (hTT d Ω p s _ _ _ _ (hq1 _) (hq1 x') hQL h).trans ?_
      have hB : 0 ≤ latEnvelope (m + 1) L h := envelope_nonneg hL0 _
      have hGb := hEb (σ (x' - h)).1 (σ (x' - h)).2 h (hq1 _)
      have hQ' : (((σ (x' - h)).2 * (σ x').2 : ℕ) : ℝ) / L ≤ (N : ℝ) ^ 2 / L :=
        div_le_div_of_nonneg_right hQN hL0.le
      refine mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left ?_ hCp) hB
      simp only [ε]
      linarith
  -- row sums, by symmetry
  have hrowH : ∀ x, ∑' x', ‖∫ y, κ x y * conj (κ x' y) ∂Measure.count‖ₑ ≤
      ENNReal.ofReal (Cp * Cn * (ε + δ)) := by
    intro x
    simp_rw [arith_enorm_integral_mul_conj_symm κ x]
    exact hcolH x
  have hκm : StronglyMeasurable (Function.uncurry κ) := (Measurable.of_discrete).stronglyMeasurable
  have hsumφ := (hφ d Ω p s).2.2
  have hrow : ∀ x, ∫⁻ y, ‖κ x y‖ₑ ∂Measure.count ≤ ENNReal.ofReal (Cφ * Cn) := by
    intro x
    rw [lintegral_count]
    simp_rw [κ, enorm_arithKer]
    exact ((Equiv.subLeft x).tsum_eq (fun w => ‖liftPhi (m + 1) d Ω p s (latEmbed w)‖ₑ)).trans_le
      hsumφ
  have hcol : ∀ y, ∫⁻ x, ‖κ x y‖ₑ ∂Measure.count ≤ ENNReal.ofReal (Cφ * Cn) := by
    intro y
    rw [lintegral_count]
    simp_rw [κ, enorm_arithKer]
    exact ((Equiv.subRight y).tsum_eq (fun w => ‖liftPhi (m + 1) d Ω p s (latEmbed w)‖ₑ)).trans_le
      hsumφ
  have hM : ∀ x y, ‖κ x y‖ ≤ Cφ := fun x y => by
    simp only [κ]; rw [norm_arithKer]; exact (hφ d Ω p s).2.1 _
  refine (band_eLpNorm_kernel_le_of_ttstar (A := ENNReal.ofReal (Cp * Cn * (ε + δ)))
    hκm ENNReal.ofReal_ne_top hrow hcol hM ?_
    (arith_memLp_two_of_summable hf)).trans ?_
  · intro v _
    rw [lintegral_count, minor_eLpNorm_two_sq]
    simp_rw [lintegral_count]
    exact minor_bilinear_schur _ _ hrowH hcolH
  · refine mul_le_mul_of_nonneg_right (ENNReal.rpow_le_rpow (ENNReal.ofReal_le_ofReal ?_)
      (by norm_num)) zero_le
    -- `ε + δ ≤ (C + 1 + C') N^{-c₀}`
    have h1 : (N : ℝ) ^ (-c) ≤ (N : ℝ) ^ (-c₀) :=
      Real.rpow_le_rpow_of_exponent_le hN1 (by simp only [c₀]; linarith [min_le_left c (3 / 8)])
    have h2 : (N : ℝ) ^ (-(3 / 8 : ℝ)) ≤ (N : ℝ) ^ (-c₀) :=
      Real.rpow_le_rpow_of_exponent_le hN1 (by simp only [c₀]; linarith [min_le_right c (3 / 8)])
    have h3 : (N : ℝ) ^ 2 / L ≤ (N : ℝ) ^ (-c₀) := by
      have e1 : (N : ℝ) ^ 2 / L ≤ (N : ℝ) ^ 2 / (N : ℝ) ^ 3 :=
        div_le_div_of_nonneg_left (by positivity) (by positivity) hNL3
      have e2 : (N : ℝ) ^ 2 / (N : ℝ) ^ 3 = (N : ℝ) ^ (-1 : ℝ) := by
        rw [Real.rpow_neg_one]; field_simp
      have e3 : (N : ℝ) ^ (-1 : ℝ) ≤ (N : ℝ) ^ (-c₀) :=
        Real.rpow_le_rpow_of_exponent_le hN1 (by
          have : c₀ ≤ 3 / 8 := min_le_right _ _
          linarith)
      linarith
    have hCpn : 0 ≤ Cp * Cn := by positivity
    calc Cp * Cn * (ε + δ) ≤ Cp * Cn * ((C + 1 + C') * (N : ℝ) ^ (-c₀)) := by
          refine mul_le_mul_of_nonneg_left ?_ hCpn
          simp only [ε, δ]
          nlinarith [mul_le_mul_of_nonneg_left h1 hC, mul_le_mul_of_nonneg_left h2 hC']
      _ = Cp * Cn * (C + 1 + C') * (N : ℝ) ^ (-c₀) := by ring

/-- `(K N_s^{-c₀})^{1/2} = √K 2^{-(c₀/2) s}`. -/
lemma arith_ofReal_mul_liftN_rpow_half {K c₀ : ℝ} (hK : 0 ≤ K) (s : ℕ) :
    ENNReal.ofReal (K * ((liftN s : ℕ) : ℝ) ^ (-c₀)) ^ (1 / 2 : ℝ) =
      ENNReal.ofReal (Real.sqrt K * (2 : ℝ) ^ (-(c₀ / 2 * s))) := by
  have h2 : ((liftN s : ℕ) : ℝ) ^ (-c₀) = (2 : ℝ) ^ (-(c₀ * s)) := by
    rw [liftN, Nat.cast_pow, Nat.cast_ofNat, ← Real.rpow_natCast, ← Real.rpow_mul (by norm_num)]
    congr 1; ring
  rw [ENNReal.ofReal_rpow_of_nonneg (by positivity) (by norm_num), h2,
    Real.mul_rpow hK (by positivity), ← Real.rpow_mul (by norm_num), Real.sqrt_eq_rpow]
  congr 2; ring_nf

/-- **Blueprint Lemma 9.2 (`lem:arithmax`), eq. (9.5) (`eq:arith2`)**, arithmetic maximal decay
in `ℓ²`: for `n ≥ 1` and `d ≥ 1` (`D = 2d`) there is `γ > 0` (depending only on `n, d`) and a
constant `C` (independent of the parameters `Ω, p` of the §9 setup) such that for every `s ≥ 1`
and every `f ∈ ℓ¹(ℤⁿ)` (in particular every finitely supported `f`),
`‖sup_{α ∈ 𝓡_s} |A_{s,α} f|‖_{ℓ²} ≤ C 2^{-γ s} ‖f‖_{ℓ²}`,
the supremum being over the finite set `𝓡_s = liftRat s` of reduced `α = a/q`,
`N_s/2 ≤ q < N_s`, and `A_{s,a/q} = liftA n d Ω p s a q`. -/
theorem arith_maximal_decay (n d : ℕ) (hn : 1 ≤ n) (hd : 1 ≤ d) :
    ∃ γ : ℝ, 0 < γ ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ),
      1 ≤ s → ∀ f : (Fin n → ℤ) → ℂ, Summable (fun z => ‖f z‖) →
        eLpNorm (fun x => (liftRat s).sup fun aq =>
            ‖latMult (liftA n d Ω p s aq.1 aq.2) f x‖ₑ) 2 Measure.count ≤
          ENNReal.ofReal (C * (2 : ℝ) ^ (-(γ * s))) * eLpNorm f 2 Measure.count := by
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  obtain ⟨K, c₀, hK, hc₀, hlin⟩ := arith_linearized_bound (m := m) hd
  refine ⟨c₀ / 2, by positivity, Real.sqrt K, Real.sqrt_nonneg _, fun Ω p s hs f hf => ?_⟩
  refine eLpNorm_finset_sup_le_of_linearization_op
    (fun (aq : ℕ × ℕ) f x => latMult (liftA (m + 1) d Ω p s aq.1 aq.2) f x) f (liftRat s)
    (fun _ _ => AEStronglyMeasurable.of_discrete) _ fun σ hσ _ => ?_
  refine (hlin Ω p s hs σ hσ f hf).trans (le_of_eq ?_)
  rw [arith_ofReal_mul_liftN_rpow_half hK]

/-! #### The vector-valued estimate (9.6) -/

/-- The maximal function `sup_{α ∈ 𝓡_s} |A_{s,α} u(x)|` (real-valued). -/
noncomputable def arithSup (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ)
    (u : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) : ℝ :=
  (((liftRat s).sup fun aq => ‖latMult (liftA n d Ω p s aq.1 aq.2) u x‖₊ : ℝ≥0) : ℝ)

lemma arithSup_nonneg (s : ℕ) (u : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) :
    0 ≤ arithSup n d Ω p s u x := NNReal.coe_nonneg _

lemma enorm_arithSup (s : ℕ) (u : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) :
    ‖arithSup n d Ω p s u x‖ₑ =
      (liftRat s).sup fun aq => ‖latMult (liftA n d Ω p s aq.1 aq.2) u x‖ₑ := by
  rw [arithSup, Real.enorm_eq_ofReal (NNReal.coe_nonneg _), ENNReal.ofReal_coe_nnreal,
    ENNReal.coe_finset_sup]
  rfl

/-- A bound for a finite supremum of norms. -/
lemma arith_coe_finset_sup_nnnorm_le {α : Type*} {s : Finset α} {g : α → ℂ} {R : ℝ} (hR : 0 ≤ R)
    (h : ∀ a ∈ s, ‖g a‖ ≤ R) : ((s.sup fun a => ‖g a‖₊ : ℝ≥0) : ℝ) ≤ R := by
  have : s.sup (fun a => ‖g a‖₊) ≤ R.toNNReal := Finset.sup_le fun a ha => by
    rw [← NNReal.coe_le_coe, Real.coe_toNNReal _ hR]; exact h a ha
  exact (NNReal.coe_le_coe.2 this).trans_eq (Real.coe_toNNReal _ hR)

lemma norm_le_arithSup {s : ℕ} {aq : ℕ × ℕ} (haq : aq ∈ liftRat s) (u : (Fin n → ℤ) → ℂ)
    (x : Fin n → ℤ) : ‖latMult (liftA n d Ω p s aq.1 aq.2) u x‖ ≤ arithSup n d Ω p s u x := by
  have := Finset.le_sup (f := fun aq : ℕ × ℕ => ‖latMult (liftA n d Ω p s aq.1 aq.2) u x‖₊) haq
  exact_mod_cast this

/-- Subadditivity of the maximal function on `ℓ¹`. -/
lemma arithSup_add_le (s : ℕ) {u v : (Fin n → ℤ) → ℂ} (hu : Summable fun z => ‖u z‖)
    (hv : Summable fun z => ‖v z‖) (x : Fin n → ℤ) :
    arithSup n d Ω p s (u + v) x ≤ arithSup n d Ω p s u x + arithSup n d Ω p s v x := by
  refine arith_coe_finset_sup_nnnorm_le (add_nonneg (arithSup_nonneg s u x) (arithSup_nonneg s v x))
    fun aq haq => ?_
  have hint : IntegrableOn (liftA n d Ω p s aq.1 aq.2) (torusCube n) :=
    integrableOn_liftSym (by simpa using integrable_liftChi (n := n) (d := d) (Ω := Ω) (p := p) s)
  rw [latMult_add hint hu hv, Pi.add_apply]
  exact (norm_add_le _ _).trans (add_le_add (norm_le_arithSup haq u x) (norm_le_arithSup haq v x))

/-- Pointwise domination (Blueprint Lemma 9.1): `sup_α |A_{s,α} u(x)| ≤ ∑_w |φ_s(w)| |u(x - w)|`. -/
lemma arithSup_le_conv (s : ℕ) {u : (Fin n → ℤ) → ℂ} (hu : Summable fun z => ‖u z‖)
    (x : Fin n → ℤ) :
    arithSup n d Ω p s u x ≤ ∑' w, ‖liftPhi n d Ω p s (latEmbed w)‖ * ‖u (x - w)‖ := by
  obtain ⟨C, hC, hb⟩ := arith_liftPhi_bounds n
  have hs : Summable fun w => ‖liftPhi n d Ω p s (latEmbed w)‖ * ‖u (x - w)‖ := by
    refine Summable.of_nonneg_of_le (fun _ => by positivity) (fun w => ?_)
      ((hu.comp_injective (Equiv.subLeft x).injective).mul_left C)
    exact mul_le_mul_of_nonneg_right ((hb d Ω p s).2.1 w) (norm_nonneg _)
  refine arith_coe_finset_sup_nnnorm_le (tsum_nonneg fun _ => by positivity) fun aq haq => ?_
  have hq : 1 ≤ aq.2 := one_le_of_mem_liftRat (a := aq.1) (by simpa using haq)
  rw [arith_latMult_liftA_eq s aq.1 hq hu x]
  have hs' : Summable fun y => ‖eC ((aq.1 : ℝ) / aq.2 * (radialPolyZ n d (x - y) : ℝ)) *
      liftPhi n d Ω p s (latEmbed (x - y)) * u y‖ := by
    have := hs.comp_injective (Equiv.subLeft x).injective
    refine this.congr fun y => ?_
    simp [norm_eC]
  refine (norm_tsum_le_tsum_norm hs').trans (le_of_eq ?_)
  rw [← (Equiv.subLeft x).tsum_eq]
  refine tsum_congr fun w => ?_
  simp [norm_eC]

/-- `(∑_ν sup_{α ∈ 𝓡_s} |A_{s,α} g_ν(x)|²)^{1/2}` for an `ℓ²`-valued input `g = (g_ν)_ν`. -/
noncomputable def arithVec {ι : Type*} [Fintype ι] (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ)
    (p : ℝ) (s : ℕ) (g : (Fin n → ℤ) → EuclideanSpace ℂ ι) (x : Fin n → ℤ) : ℝ :=
  Real.sqrt (∑ ν, arithSup n d Ω p s (fun y => g y ν) x ^ 2)

section Vector

variable {ι : Type*} [Fintype ι]

lemma arith_norm_toLp_le_of_le {u v : ι → ℝ} (h0 : ∀ i, 0 ≤ u i) (h : ∀ i, u i ≤ v i) :
    ‖(WithLp.toLp 2 u : EuclideanSpace ℝ ι)‖ ≤ ‖(WithLp.toLp 2 v : EuclideanSpace ℝ ι)‖ := by
  rw [EuclideanSpace.norm_eq, EuclideanSpace.norm_eq]
  refine Real.sqrt_le_sqrt (Finset.sum_le_sum fun i _ => ?_)
  simp only [Real.norm_eq_abs, sq_abs]
  exact pow_le_pow_left₀ (h0 i) (h i) 2

lemma arithVec_eq_norm (s : ℕ) (g : (Fin n → ℤ) → EuclideanSpace ℂ ι) (x : Fin n → ℤ) :
    arithVec n d Ω p s g x =
      ‖(WithLp.toLp 2 fun ν => arithSup n d Ω p s (fun y => g y ν) x : EuclideanSpace ℝ ι)‖ := by
  rw [EuclideanSpace.norm_eq, arithVec]
  simp only [Real.norm_eq_abs, sq_abs]

lemma arithVec_nonneg (s : ℕ) (g : (Fin n → ℤ) → EuclideanSpace ℂ ι) (x : Fin n → ℤ) :
    0 ≤ arithVec n d Ω p s g x := Real.sqrt_nonneg _

lemma arith_summable_coord {g : (Fin n → ℤ) → EuclideanSpace ℂ ι} (hg : Summable fun x => ‖g x‖)
    (ν : ι) : Summable fun x => ‖g x ν‖ :=
  Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun x => PiLp.norm_apply_le (g x) ν) hg

lemma arithVec_add_le (s : ℕ) {g h : (Fin n → ℤ) → EuclideanSpace ℂ ι}
    (hg : Summable fun x => ‖g x‖) (hh : Summable fun x => ‖h x‖) (x : Fin n → ℤ) :
    arithVec n d Ω p s (g + h) x ≤ arithVec n d Ω p s g x + arithVec n d Ω p s h x := by
  rw [arithVec_eq_norm, arithVec_eq_norm, arithVec_eq_norm]
  have e : ∀ ν, (fun y => (g + h) y ν) = (fun y => g y ν) + (fun y => h y ν) := fun ν => by
    funext y; simp
  refine (arith_norm_toLp_le_of_le (fun ν => arithSup_nonneg _ _ _) (fun ν => ?_)).trans
    ((le_of_eq (congrArg norm (WithLp.toLp_add 2 _ _))).trans (norm_add_le _ _))
  rw [e ν]
  exact arithSup_add_le s (arith_summable_coord hg ν) (arith_summable_coord hh ν) x

/-- Minkowski and Blueprint Lemma 9.1: `(∑_ν sup_α |A_{s,α} g_ν(x)|²)^{1/2} ≤ (|φ_s| * |g|)(x)`. -/
lemma arithVec_le_conv (s : ℕ) {g : (Fin n → ℤ) → EuclideanSpace ℂ ι}
    (hg : Summable fun x => ‖g x‖) (x : Fin n → ℤ) :
    arithVec n d Ω p s g x ≤ ∑' w, ‖liftPhi n d Ω p s (latEmbed w)‖ * ‖g (x - w)‖ := by
  obtain ⟨C, hC, hb⟩ := arith_liftPhi_bounds n
  set a : (Fin n → ℤ) → ℝ := fun w => ‖liftPhi n d Ω p s (latEmbed w)‖
  set V : (Fin n → ℤ) → EuclideanSpace ℝ ι := fun w =>
    a w • (WithLp.toLp 2 fun ν => ‖g (x - w) ν‖ : EuclideanSpace ℝ ι)
  have hnormV : ∀ w, ‖V w‖ = a w * ‖g (x - w)‖ := by
    intro w
    simp only [V, norm_smul, Real.norm_of_nonneg (norm_nonneg _), a]
    congr 1
    rw [EuclideanSpace.norm_eq, EuclideanSpace.norm_eq]
    simp only [norm_norm]
  have hsV : Summable fun w => ‖V w‖ := by
    simp_rw [hnormV]
    refine Summable.of_nonneg_of_le (fun _ => by positivity) (fun w => ?_)
      ((hg.comp_injective (Equiv.subLeft x).injective).mul_left C)
    exact mul_le_mul_of_nonneg_right ((hb d Ω p s).2.1 w) (norm_nonneg _)
  have hV : Summable V := hsV.of_norm
  set W := ∑' w, V w
  have hcoord : ∀ ν, W ν = ∑' w, a w * ‖g (x - w) ν‖ := by
    intro ν
    have := (EuclideanSpace.proj ν : EuclideanSpace ℝ ι →L[ℝ] ℝ).map_tsum hV
    simpa [V, W] using this
  rw [arithVec_eq_norm]
  calc ‖(WithLp.toLp 2 fun ν => arithSup n d Ω p s (fun y => g y ν) x : EuclideanSpace ℝ ι)‖
      ≤ ‖(WithLp.toLp 2 (WithLp.ofLp W) : EuclideanSpace ℝ ι)‖ := by
        refine arith_norm_toLp_le_of_le (fun ν => arithSup_nonneg _ _ _) fun ν => ?_
        refine (arithSup_le_conv s (arith_summable_coord hg ν) x).trans (le_of_eq ?_)
        rw [← hcoord ν]
    _ = ‖W‖ := by rw [WithLp.toLp_ofLp]
    _ ≤ ∑' w, ‖V w‖ := norm_tsum_le_tsum_norm hsV
    _ = ∑' w, ‖liftPhi n d Ω p s (latEmbed w)‖ * ‖g (x - w)‖ := tsum_congr hnormV

/-- `∑_w |φ_s(w)| ≤ C C_n` (real form). -/
lemma arith_tsum_norm_liftPhi_le (n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ),
      ∑' w : Fin n → ℤ, ‖liftPhi n d Ω p s (latEmbed w)‖ ≤ C * envelopeConst n := by
  obtain ⟨C, hC, hb⟩ := arith_liftPhi_bounds n
  refine ⟨C, hC, fun d Ω p s => ?_⟩
  have hL1 : (1 : ℝ) ≤ liftL n d Ω p s := by
    unfold liftL; exact_mod_cast Nat.one_le_two_pow
  obtain ⟨hs, hsum⟩ := summable_latEnvelope_and_tsum_le (n := n) hL1
  calc ∑' w : Fin n → ℤ, ‖liftPhi n d Ω p s (latEmbed w)‖
      ≤ ∑' w, C * latEnvelope n (liftL n d Ω p s) w :=
        (arith_summable_norm_liftPhi s).tsum_le_tsum (hb d Ω p s).1 (hs.mul_left C)
    _ ≤ C * envelopeConst n := by rw [tsum_mul_left]; exact mul_le_mul_of_nonneg_left hsum hC

/-- The endpoint bounds (`ℓ^r`, `1 ≤ r ≤ ∞`, by Young's inequality): for `g ∈ ℓ¹(ℤⁿ; ℓ²)`,
`‖(∑_ν sup_α |A_{s,α} g_ν|²)^{1/2}‖_r ≤ C ‖g‖_r`, `C` independent of `s`. -/
lemma eLpNorm_arithVec_le_young (n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ) {r : ℝ≥0∞},
      1 ≤ r → ∀ {ι : Type*} [Fintype ι] (g : (Fin n → ℤ) → EuclideanSpace ℂ ι),
      Summable (fun x => ‖g x‖) →
        eLpNorm (arithVec n d Ω p s g) r Measure.count ≤
          ENNReal.ofReal C * eLpNorm g r Measure.count := by
  obtain ⟨C, hC, hb⟩ := arith_liftPhi_bounds n
  refine ⟨C * envelopeConst n, by unfold envelopeConst; positivity,
    fun d Ω p s r hr ι _ g hg => ?_⟩
  set G : (Fin n → ℤ) → ℂ := fun x => ((‖g x‖ : ℝ) : ℂ)
  set k : (Fin n → ℤ) → ℂ := fun w => liftPhi n d Ω p s (latEmbed w)
  have hGe : ∀ y, ‖G y‖ₑ = ‖g y‖ₑ := fun y => by
    rw [← ofReal_norm, ← ofReal_norm]; simp [G]
  have hpt : ∀ x, ‖arithVec n d Ω p s g x‖ₑ ≤ ‖∑' w, ‖k w‖ₑ * ‖G (x - w)‖ₑ‖ₑ := by
    intro x
    rw [enorm_eq_self, Real.enorm_eq_ofReal (arithVec_nonneg s g x)]
    have hs : Summable fun w => ‖liftPhi n d Ω p s (latEmbed w)‖ * ‖g (x - w)‖ := by
      refine Summable.of_nonneg_of_le (fun _ => by positivity) (fun w => ?_)
        ((hg.comp_injective (Equiv.subLeft x).injective).mul_left C)
      exact mul_le_mul_of_nonneg_right ((hb d Ω p s).2.1 w) (norm_nonneg _)
    refine (ENNReal.ofReal_le_ofReal (arithVec_le_conv s hg x)).trans (le_of_eq ?_)
    rw [ENNReal.ofReal_tsum_of_nonneg (fun _ => by positivity) hs]
    refine tsum_congr fun w => ?_
    rw [ENNReal.ofReal_mul (norm_nonneg _), ofReal_norm, ofReal_norm]
    rw [hGe]
  refine (eLpNorm_mono_enorm AEStronglyMeasurable.of_discrete hpt).trans
    ((eLpNorm_tsum_enorm_mul_sub_le hr k G).trans ?_)
  have hk : eLpNorm k 1 Measure.count ≤ ENNReal.ofReal (C * envelopeConst n) := by
    rw [eLpNorm_one_eq_lintegral_enorm AEStronglyMeasurable.of_discrete, lintegral_count]
    exact (hb d Ω p s).2.2
  have hG : eLpNorm G r Measure.count = eLpNorm g r Measure.count :=
    eLpNorm_congr_enorm_ae AEStronglyMeasurable.of_discrete AEStronglyMeasurable.of_discrete
      (ae_of_all _ hGe)
  rw [hG]
  gcongr

/-- The `ℓ^∞` endpoint: `|g| ≤ S` implies `(∑_ν sup_α |A_{s,α} g_ν|²)^{1/2} ≤ C S`. -/
lemma arithVec_le_of_norm_le (n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ)
      {ι : Type*} [Fintype ι] (g : (Fin n → ℤ) → EuclideanSpace ℂ ι),
      Summable (fun x => ‖g x‖) → ∀ S : ℝ, (∀ x, ‖g x‖ ≤ S) → ∀ x,
        arithVec n d Ω p s g x ≤ C * S := by
  obtain ⟨C, hC, hb⟩ := arith_liftPhi_bounds n
  obtain ⟨C₁, hC₁, hsum⟩ := arith_tsum_norm_liftPhi_le n
  refine ⟨C₁ * envelopeConst n, by unfold envelopeConst; positivity,
    fun d Ω p s ι _ g hg S hS x => ?_⟩
  have hS0 : 0 ≤ S := (norm_nonneg _).trans (hS 0)
  have hs1 : Summable fun w => ‖liftPhi n d Ω p s (latEmbed w)‖ * ‖g (x - w)‖ := by
    refine Summable.of_nonneg_of_le (fun _ => by positivity) (fun w => ?_)
      ((hg.comp_injective (Equiv.subLeft x).injective).mul_left C)
    exact mul_le_mul_of_nonneg_right ((hb d Ω p s).2.1 w) (norm_nonneg _)
  refine (arithVec_le_conv s hg x).trans ?_
  calc ∑' w, ‖liftPhi n d Ω p s (latEmbed w)‖ * ‖g (x - w)‖
      ≤ ∑' w, ‖liftPhi n d Ω p s (latEmbed w)‖ * S :=
        hs1.tsum_le_tsum (fun w => mul_le_mul_of_nonneg_left (hS _) (norm_nonneg _))
          ((arith_summable_norm_liftPhi s).mul_right S)
    _ = (∑' w, ‖liftPhi n d Ω p s (latEmbed w)‖) * S := tsum_mul_right
    _ ≤ C₁ * envelopeConst n * S := mul_le_mul_of_nonneg_right (hsum d Ω p s) hS0

/-- `‖v‖₂² = ∑_x |v x|²` for counting measure (any normed codomain). -/
lemma arith_eLpNorm_two_sq_eq_tsum {α E : Type*} [MeasurableSpace α] [MeasurableSingletonClass α]
    [Countable α] [NormedAddCommGroup E] (v : α → E) :
    eLpNorm v 2 Measure.count ^ 2 = ∑' x, ‖v x‖ₑ ^ 2 := by
  have := eLpNorm_two_rpow_two (ν := Measure.count) (AEStronglyMeasurable.of_discrete (f := v))
  rw [lintegral_count] at this
  rw [← ENNReal.rpow_natCast, Nat.cast_ofNat, this]
  simp_rw [← ENNReal.rpow_natCast, Nat.cast_ofNat]

lemma arith_enorm_sq_euclidean {𝕜 : Type*} [RCLike 𝕜] (u : EuclideanSpace 𝕜 ι) :
    ‖u‖ₑ ^ 2 = ∑ ν, ‖u ν‖ₑ ^ 2 := by
  rw [← ofReal_norm, EuclideanSpace.norm_eq, ← ENNReal.ofReal_pow (Real.sqrt_nonneg _),
    Real.sq_sqrt (Finset.sum_nonneg fun _ _ => by positivity),
    ENNReal.ofReal_sum_of_nonneg fun _ _ => by positivity]
  refine Finset.sum_congr rfl fun ν _ => ?_
  rw [ENNReal.ofReal_pow (norm_nonneg _), ofReal_norm]

lemma enorm_arithVec_sq (s : ℕ) (g : (Fin n → ℤ) → EuclideanSpace ℂ ι) (x : Fin n → ℤ) :
    ‖arithVec n d Ω p s g x‖ₑ ^ 2 = ∑ ν, ‖arithSup n d Ω p s (fun y => g y ν) x‖ₑ ^ 2 := by
  rw [Real.enorm_eq_ofReal (arithVec_nonneg s g x), arithVec_eq_norm, ofReal_norm,
    arith_enorm_sq_euclidean]

/-- The `ℓ²` case of eq. (9.6): the square function of the maximal functions is bounded on
`ℓ²(ℤⁿ; ℓ²)` with the constant of the scalar bound (9.5) (square and sum over `ν`). -/
lemma eLpNorm_arithVec_two_le {B : ℝ} (s : ℕ)
    (h2 : ∀ u : (Fin n → ℤ) → ℂ, Summable (fun z => ‖u z‖) →
      eLpNorm (fun x => (liftRat s).sup fun aq =>
        ‖latMult (liftA n d Ω p s aq.1 aq.2) u x‖ₑ) 2 Measure.count ≤
          ENNReal.ofReal B * eLpNorm u 2 Measure.count)
    (g : (Fin n → ℤ) → EuclideanSpace ℂ ι) (hg : Summable fun x => ‖g x‖) :
    eLpNorm (arithVec n d Ω p s g) 2 Measure.count ≤
      ENNReal.ofReal B * eLpNorm g 2 Measure.count := by
  have key : eLpNorm (arithVec n d Ω p s g) 2 Measure.count ^ 2 ≤
      1 * (ENNReal.ofReal B * eLpNorm g 2 Measure.count) ^ 2 := by
    rw [one_mul, arith_eLpNorm_two_sq_eq_tsum, mul_pow, arith_eLpNorm_two_sq_eq_tsum]
    simp_rw [enorm_arithVec_sq, arith_enorm_sq_euclidean]
    rw [Summable.tsum_finsetSum (fun _ _ => ENNReal.summable),
      Summable.tsum_finsetSum (fun _ _ => ENNReal.summable), Finset.mul_sum]
    refine Finset.sum_le_sum fun ν _ => ?_
    have h := h2 (fun y => g y ν) (arith_summable_coord hg ν)
    have e1 : eLpNorm (arithSup n d Ω p s (fun y => g y ν)) 2 Measure.count =
        eLpNorm (fun x => (liftRat s).sup fun aq =>
          ‖latMult (liftA n d Ω p s aq.1 aq.2) (fun y => g y ν) x‖ₑ) 2 Measure.count := by
      rw [← eLpNorm_enorm _ AEStronglyMeasurable.of_discrete]
      simp_rw [enorm_arithSup]
    rw [← arith_eLpNorm_two_sq_eq_tsum (arithSup n d Ω p s (fun y => g y ν)),
      ← arith_eLpNorm_two_sq_eq_tsum (fun y => g y ν), e1, ← mul_pow]
    gcongr
  have := band_le_of_sq_le key
  rwa [ENNReal.one_rpow, one_mul] at this

end Vector

/-- The inputs `g ∈ ℓ¹(ℤⁿ; ℓ²)` form a truncation-closed class. -/
lemma arith_isTruncationClosed_summable {ι : Type*} [Fintype ι] :
    IsTruncationClosed {g : (Fin n → ℤ) → EuclideanSpace ℂ ι | Summable fun x => ‖g x‖} := by
  intro g hg s _
  have hg' : Summable fun x => ‖g x‖ := hg
  refine ⟨?_, ?_⟩
  · exact Summable.of_nonneg_of_le (fun _ => norm_nonneg _)
      (fun x => norm_indicator_le_norm_self _ _) hg'
  · exact Summable.of_nonneg_of_le (fun _ => norm_nonneg _)
      (fun x => norm_indicator_le_norm_self _ _) hg'

/-- Marcinkiewicz interpolation (Blueprint Lemma 2.3) of the uniform `ℓ¹` and `ℓ^∞` endpoint
bounds of `g ↦ (∑_ν sup_α |A_{s,α} g_ν|²)^{1/2}` with an `ℓ²` bound `B` (for `ℓ²`-valued inputs):
for `1 < t < ∞`, `‖·‖_t ≤ K B^{a_t} ‖g‖_t`, `a_t = min(2/t, 2/t')`, with `K` independent of `s`,
`B`, the index set and `g`. -/
theorem arithVec_lp_of_l2 (n : ℕ) {t : ℝ} (ht : 1 < t) :
    ∃ K : ℝ≥0∞, K ≠ ⊤ ∧ ∀ (d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ)
      {ι : Type*} [Fintype ι] (B : ℝ≥0),
      (∀ u : (Fin n → ℤ) → ℂ, Summable (fun z => ‖u z‖) →
        eLpNorm (fun x => (liftRat s).sup fun aq =>
          ‖latMult (liftA n d Ω p s aq.1 aq.2) u x‖ₑ) 2 Measure.count ≤
            ENNReal.ofReal B * eLpNorm u 2 Measure.count) →
      ∀ g : (Fin n → ℤ) → EuclideanSpace ℂ ι, Summable (fun x => ‖g x‖) →
        eLpNorm (arithVec n d Ω p s g) (ENNReal.ofReal t) Measure.count ≤
          K * (B : ℝ≥0∞) ^ paramA t * eLpNorm g (ENNReal.ofReal t) Measure.count := by
  obtain ⟨A₁, hA₁, hyoung⟩ := eLpNorm_arithVec_le_young n
  obtain ⟨A₂, hA₂, hinfty⟩ := arithVec_le_of_norm_le n
  set A : ℝ≥0 := (max (max A₁ A₂) 1).toNNReal
  have hA : (A : ℝ≥0∞) = ENNReal.ofReal (max (max A₁ A₂) 1) := rfl
  have hApos : 0 < A := Real.toNNReal_pos.2 (lt_of_lt_of_le one_pos (le_max_right _ _))
  -- the common hypotheses
  have hsub : ∀ d Ω p s (ι : Type _) [Fintype ι], IsSublinearOn (arithVec (ι := ι) n d Ω p s)
      {g | Summable fun x => ‖g x‖} Measure.count := by
    intro d Ω p s ι _ f hf g hg
    refine ae_of_all _ fun x => ?_
    rw [Real.norm_of_nonneg (arithVec_nonneg s _ x), Real.norm_of_nonneg (arithVec_nonneg s _ x),
      Real.norm_of_nonneg (arithVec_nonneg s _ x)]
    exact arithVec_add_le s hf hg x
  have hone : ∀ d Ω p s (ι : Type _) [Fintype ι], HasStrongTypeOn (arithVec (ι := ι) n d Ω p s)
      {g | Summable fun x => ‖g x‖} 1 A Measure.count Measure.count := by
    intro d Ω p s ι _ g hg
    rw [ENNReal.ofReal_one]
    refine (hyoung d Ω p s le_rfl g hg).trans ?_
    rw [hA]; gcongr; exact (le_max_left _ _).trans (le_max_left _ _)
  have hinf : ∀ d Ω p s (ι : Type _) [Fintype ι], HasLinftyBoundOn (arithVec (ι := ι) n d Ω p s)
      {g | Summable fun x => ‖g x‖} A Measure.count := by
    intro d Ω p s ι _ g hg S hS
    refine ae_of_all _ fun x => ?_
    have hS0 : 0 ≤ S := (norm_nonneg _).trans (hS 0)
    rw [Real.norm_of_nonneg (arithVec_nonneg s _ x), Real.coe_toNNReal _ (by positivity)]
    exact (hinfty d Ω p s g hg S hS x).trans
      (mul_le_mul_of_nonneg_right ((le_max_right _ _).trans (le_max_left _ _)) hS0)
  have htwo : ∀ d Ω p s (ι : Type _) [Fintype ι] (B : ℝ≥0),
      (∀ u : (Fin n → ℤ) → ℂ, Summable (fun z => ‖u z‖) →
        eLpNorm (fun x => (liftRat s).sup fun aq =>
          ‖latMult (liftA n d Ω p s aq.1 aq.2) u x‖ₑ) 2 Measure.count ≤
            ENNReal.ofReal B * eLpNorm u 2 Measure.count) →
      HasStrongTypeOn (arithVec (ι := ι) n d Ω p s) {g | Summable fun x => ‖g x‖} 2 B
        Measure.count Measure.count := by
    intro d Ω p s ι _ B h g hg
    rw [ENNReal.ofReal_ofNat, ← ENNReal.ofReal_coe_nnreal]
    exact eLpNorm_arithVec_two_le s h g hg
  rcases lt_trichotomy t 2 with ht2 | rfl | ht2
  · -- `1 < t < 2`: interpolate between `(1,1)` and `(2,2)`, `θ = 2 - 2/t`
    set θ : ℝ := 2 - 2 / t
    have hθ : 1 / t = (1 - θ) / 1 + θ / 2 := by simp only [θ]; field_simp; ring
    have h1θ : 0 ≤ 1 - θ := by
      have : 1 ≤ 2 / t := by rw [le_div_iff₀ (by linarith)]; linarith
      simp only [θ]; linarith
    refine ⟨(marcinkiewiczConst 1 2 t : ℝ≥0∞) * (A : ℝ≥0∞) ^ (1 - θ),
      ENNReal.mul_ne_top ENNReal.coe_ne_top (ENNReal.rpow_ne_top_of_nonneg h1θ ENNReal.coe_ne_top),
      fun d Ω p s ι _ B h g hg => ?_⟩
    rw [paramA_eq_of_le_two ht ht2.le]
    refine (eLpNorm_le_of_hasWeakTypeOn one_pos ht ht2 hθ
      ((hone d Ω p s ι).hasWeakTypeOn one_pos) ((htwo d Ω p s ι B h).hasWeakTypeOn two_pos)
      (hsub d Ω p s ι) arith_isTruncationClosed_summable hg AEStronglyMeasurable.of_discrete
      AEStronglyMeasurable.of_discrete).trans (le_of_eq ?_)
    ring
  · -- `t = 2`
    refine ⟨1, ENNReal.one_ne_top, fun d Ω p s ι _ B h g hg => ?_⟩
    rw [paramA_eq_of_two_le ht le_rfl, div_self two_ne_zero, ENNReal.rpow_one, one_mul]
    exact htwo d Ω p s ι B h g hg
  · -- `2 < t < ∞`: interpolate between `(2,2)` and `(∞,∞)`
    have h1 : 0 ≤ 1 - 2 / t := by rw [sub_nonneg, div_le_one (by linarith)]; linarith
    refine ⟨(marcinkiewiczConstTop 2 t : ℝ≥0∞) * (A : ℝ≥0∞) ^ (1 - 2 / t),
      ENNReal.mul_ne_top ENNReal.coe_ne_top (ENNReal.rpow_ne_top_of_nonneg h1 ENNReal.coe_ne_top),
      fun d Ω p s ι _ B h g hg => ?_⟩
    rw [paramA_eq_of_two_le ht ht2.le]
    calc eLpNorm (arithVec n d Ω p s g) (ENNReal.ofReal t) Measure.count
        ≤ (marcinkiewiczConstTop 2 t : ℝ≥0∞) * (B : ℝ≥0∞) ^ (2 / t) * (A : ℝ≥0∞) ^ (1 - 2 / t) *
            eLpNorm g (ENNReal.ofReal t) Measure.count :=
          eLpNorm_le_of_hasWeakTypeOn_of_linfty two_pos ht2
            ((htwo d Ω p s ι B h).hasWeakTypeOn two_pos) (hinf d Ω p s ι) (hsub d Ω p s ι)
            arith_isTruncationClosed_summable hg AEStronglyMeasurable.of_discrete
            AEStronglyMeasurable.of_discrete (Or.inl hApos)
      _ = _ := by ring

/-- **Blueprint Lemma 9.2 (`lem:arithmax`), eq. (9.6) (`eq:arithvector`)**, the vector-valued
arithmetic maximal decay: for `n ≥ 1`, `d ≥ 1` and `1 < t < ∞` there are `δ_t > 0` and `C_t`
(independent of `Ω, p`, of `s` and of the list) such that for every `s ≥ 1` and every finite
list `(f_ν)_{ν ∈ F}` of functions in `ℓ¹(ℤⁿ)` (e.g. finitely supported),
`‖(∑_ν sup_{α ∈ 𝓡_s} |A_{s,α} f_ν|²)^{1/2}‖_{ℓ^t} ≤ C_t 2^{-δ_t s} ‖(∑_ν |f_ν|²)^{1/2}‖_{ℓ^t}`.
One may take `δ_t = γ min(2/t, 2/t')` (`γ` from eq. (9.5), `arith_maximal_decay`). -/
theorem arith_maximal_decay_vector (n d : ℕ) (hn : 1 ≤ n) (hd : 1 ≤ d) {t : ℝ} (ht : 1 < t) :
    ∃ δ : ℝ, 0 < δ ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ),
      1 ≤ s → ∀ {ι : Type*} (F : Finset ι) (f : ι → (Fin n → ℤ) → ℂ),
        (∀ ν ∈ F, Summable fun z => ‖f ν z‖) →
        eLpNorm (fun x => Real.sqrt (∑ ν ∈ F,
            ((((liftRat s).sup fun aq =>
              ‖latMult (liftA n d Ω p s aq.1 aq.2) (f ν) x‖₊ : ℝ≥0) : ℝ) ^ 2)))
            (ENNReal.ofReal t) Measure.count ≤
          ENNReal.ofReal (C * (2 : ℝ) ^ (-(δ * s))) *
            eLpNorm (fun x => Real.sqrt (∑ ν ∈ F, ‖f ν x‖ ^ 2)) (ENNReal.ofReal t)
              Measure.count := by
  obtain ⟨γ, hγ, C₂, hC₂, h95⟩ := arith_maximal_decay n d hn hd
  obtain ⟨K, hK, hint⟩ := arithVec_lp_of_l2 n ht
  set θ := paramA t
  have hθ : 0 < θ := paramA_pos ht
  refine ⟨γ * θ, by positivity, K.toReal * C₂ ^ θ, by positivity,
    fun Ω p s hs ι F f hf => ?_⟩
  set g : (Fin n → ℤ) → EuclideanSpace ℂ F := fun x => WithLp.toLp 2 fun ν => f ν x
  have hgnorm : ∀ x, ‖g x‖ = Real.sqrt (∑ ν ∈ F, ‖f ν x‖ ^ 2) := by
    intro x
    rw [EuclideanSpace.norm_eq]
    simp only [g]
    rw [Finset.sum_coe_sort F (fun ν => ‖f ν x‖ ^ 2)]
  have hg : Summable fun x => ‖g x‖ := by
    refine Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun x => ?_)
      (summable_sum fun ν hν => hf ν hν)
    rw [hgnorm]
    refine Real.sqrt_le_iff.2 ⟨Finset.sum_nonneg fun _ _ => norm_nonneg _, ?_⟩
    exact Finset.sum_sq_le_sq_sum_of_nonneg fun _ _ => norm_nonneg _
  set B : ℝ := C₂ * (2 : ℝ) ^ (-(γ * s))
  have hB : 0 ≤ B := by positivity
  have h2 : ∀ u : (Fin n → ℤ) → ℂ, Summable (fun z => ‖u z‖) →
      eLpNorm (fun x => (liftRat s).sup fun aq =>
        ‖latMult (liftA n d Ω p s aq.1 aq.2) u x‖ₑ) 2 Measure.count ≤
          ENNReal.ofReal (B.toNNReal : ℝ) * eLpNorm u 2 Measure.count := by
    intro u hu
    rw [Real.coe_toNNReal _ hB]
    exact h95 Ω p s hs u hu
  have hmain := hint d Ω p s B.toNNReal h2 g hg
  have hL : (fun x => Real.sqrt (∑ ν ∈ F,
      ((((liftRat s).sup fun aq =>
        ‖latMult (liftA n d Ω p s aq.1 aq.2) (f ν) x‖₊ : ℝ≥0) : ℝ) ^ 2))) =
      arithVec n d Ω p s g := by
    funext x
    rw [arithVec, ← Finset.sum_coe_sort F]
    rfl
  have hR : eLpNorm g (ENNReal.ofReal t) Measure.count =
      eLpNorm (fun x => Real.sqrt (∑ ν ∈ F, ‖f ν x‖ ^ 2)) (ENNReal.ofReal t) Measure.count :=
    eLpNorm_congr_norm_ae AEStronglyMeasurable.of_discrete AEStronglyMeasurable.of_discrete
      (ae_of_all _ fun x => by
      rw [hgnorm, Real.norm_of_nonneg (Real.sqrt_nonneg _)])
  rw [hL, ← hR]
  refine hmain.trans (le_of_eq ?_)
  congr 1
  change K * ENNReal.ofReal B ^ θ = _
  rw [ENNReal.ofReal_rpow_of_nonneg hB hθ.le, ← ENNReal.ofReal_toReal hK,
    ← ENNReal.ofReal_mul ENNReal.toReal_nonneg, ENNReal.ofReal_toReal hK]
  congr 1
  simp only [B]
  rw [Real.mul_rpow hC₂ (by positivity), ← Real.rpow_mul (by norm_num), mul_assoc]
  congr 3; ring


end ArithMax

/-! ### Blueprint Lemma 9.3 (`lem:liftsquare`): the factorization (9.8) -/

/-- `L_s ≥ 8`. -/
lemma eight_le_liftL (s : ℕ) : (8 : ℝ) ≤ liftL n d Ω p s := by
  have h := pow_le_liftL (n := n) (d := d) (Ω := Ω) (p := p) s
  have h3 : 3 ≤ 100 * (n + 2 * d + 1) * (s + 1) := by nlinarith
  have : (2 : ℕ) ^ 3 ≤ liftL n d Ω p s := (Nat.pow_le_pow_right (by norm_num) h3).trans h
  exact_mod_cast this

/-- `χ_s ≠ 0` forces `χ̃_s ≠ 0` (from `χ_s χ̃_s = χ_s`). -/
lemma liftChiT_ne_zero_of_liftChi_ne_zero {s : ℕ} {η : EuclideanSpace ℝ (Fin n)}
    (h : liftChi n d Ω p s η ≠ 0) : liftChiT n d Ω p s η ≠ 0 := by
  intro h0
  apply h
  rw [← liftChi_mul_liftChiT s η, h0, mul_zero]

/-- The box bound `|ηᵢ| ≤ 2 (1/L_s)` on the support of `χ̃_s`. -/
lemma abs_le_of_liftChiT_ne_zero {s : ℕ} {η : EuclideanSpace ℝ (Fin n)}
    (h : liftChiT n d Ω p s η ≠ 0) (i : Fin n) :
    |η i| ≤ 2 * (1 / (liftL n d Ω p s : ℝ)) := by
  have := support_liftChiT (n := n) (d := d) (Ω := Ω) (p := p) s h i
  rw [mul_one_div]; exact this

/-- At most one lattice translate of `χ̃_s` is nonzero at any point. -/
lemma liftChiT_translate_unique {s : ℕ} {ζ : EuclideanSpace ℝ (Fin n)} {z z' : Fin n → ℤ}
    (hz : liftChiT n d Ω p s (ζ - latEmbed z) ≠ 0)
    (hz' : liftChiT n d Ω p s (ζ - latEmbed z') ≠ 0) : z = z' := by
  have hL := eight_le_liftL (n := n) (d := d) (Ω := Ω) (p := p) s
  have hε4 : 4 * (1 / (liftL n d Ω p s : ℝ)) < 1 := by
    rw [mul_one_div, div_lt_one (by linarith)]; linarith
  refine periodize_atMostOne (m := fun η => (liftChiT n d Ω p s η : ℂ))
    (ε := 1 / (liftL n d Ω p s : ℝ))
    (fun η hη => abs_le_of_liftChiT_ne_zero (by exact_mod_cast hη)) hε4 ζ z z'
    (by exact_mod_cast hz) (by exact_mod_cast hz')

/-- At any point at most one center `β ∈ 𝒰_{N_s}` and one translate `z` have
`χ̃_s(ξ - β - z) ≠ 0` (`s ≥ 1`). -/
lemma liftChiT_center_unique {s : ℕ} (hs : 1 ≤ s)
    {γ γ' : Fin n → ZMod (blockProd (goodBlocks (paramRho n d Ω p) (liftN s)))}
    (hγ : γ ∈ paramGoodSet n d Ω p (liftN s)) (hγ' : γ' ∈ paramGoodSet n d Ω p (liftN s))
    {ξ : EuclideanSpace ℝ (Fin n)} {z z' : Fin n → ℤ}
    (h : liftChiT n d Ω p s
      (ξ - ratPt (blockProd (goodBlocks (paramRho n d Ω p) (liftN s))) γ - latEmbed z) ≠ 0)
    (h' : liftChiT n d Ω p s
      (ξ - ratPt (blockProd (goodBlocks (paramRho n d Ω p) (liftN s))) γ' - latEmbed z') ≠ 0) :
    γ = γ' ∧ z = z' := by
  have hL := liftL_pos (n := n) (d := d) (Ω := Ω) (p := p) s
  have hb : ∀ {η : EuclideanSpace ℝ (Fin n)}, liftChiT n d Ω p s η ≠ 0 → ∀ i,
      |η i| ≤ 2 * (4 / (liftL n d Ω p s : ℝ)) := fun hη i => by
    refine (abs_le_of_liftChiT_ne_zero hη i).trans ?_
    gcongr; norm_num
  have hγγ : γ = γ' := eq_of_near_ratPt goodBlocks_one_lt goodBlocks_pairwise_coprime
    (by positivity) (liftEps_threshold hs) hγ hγ' (z := z) (z' := z') (ξ := ξ)
    (fun i => by simpa [latEmbed_apply] using hb h i)
    (fun i => by simpa [latEmbed_apply] using hb h' i)
  subst hγγ
  exact ⟨rfl, liftChiT_translate_unique h h'⟩

/-- For `g` supported where `χ̃_s ≠ 0`: if `χ̃_s(ζ - z) ≠ 0` then `g_per(ζ) = g(ζ - z)`. -/
lemma periodize_eq_of_liftChiT {s : ℕ} {g : EuclideanSpace ℝ (Fin n) → ℂ}
    (hg : ∀ η, g η ≠ 0 → liftChiT n d Ω p s η ≠ 0) {ζ : EuclideanSpace ℝ (Fin n)}
    {z : Fin n → ℤ} (hz : liftChiT n d Ω p s (ζ - latEmbed z) ≠ 0) :
    periodize g ζ = g (ζ - latEmbed z) := by
  rw [periodize, tsum_eq_single z]
  intro z' hz'
  by_contra h
  exact hz' (liftChiT_translate_unique (hg _ h) hz)

/-- For `g` supported where `χ̃_s ≠ 0`: if no translate of `χ̃_s` is nonzero at `ζ`, then
`g_per(ζ) = 0`. -/
lemma periodize_eq_zero_of_liftChiT {s : ℕ} {g : EuclideanSpace ℝ (Fin n) → ℂ}
    (hg : ∀ η, g η ≠ 0 → liftChiT n d Ω p s η ≠ 0) {ζ : EuclideanSpace ℝ (Fin n)}
    (h : ∀ z : Fin n → ℤ, liftChiT n d Ω p s (ζ - latEmbed z) = 0) : periodize g ζ = 0 := by
  by_contra h'
  obtain ⟨z, hz⟩ := exists_ne_zero_of_periodize_ne_zero h'
  exact hg _ hz (h z)

/-- The good-set periodization of `g` (supported where `χ̃_s ≠ 0`) at an active point:
if `χ̃_s(ξ - β - z) ≠ 0` with `β ∈ 𝒰_{N_s}`, then `∑_{β' ∈ 𝒰} g_per(ξ - β') = g(ξ - β - z)`. -/
lemma cosetSymbol_eq_of_liftChiT {s : ℕ} (hs : 1 ≤ s) {g : EuclideanSpace ℝ (Fin n) → ℂ}
    (hg : ∀ η, g η ≠ 0 → liftChiT n d Ω p s η ≠ 0) {ξ : EuclideanSpace ℝ (Fin n)}
    {β : Fin n → ZMod (blockProd (goodBlocks (paramRho n d Ω p) (liftN s)))}
    (hβ : β ∈ paramGoodSet n d Ω p (liftN s)) {z : Fin n → ℤ}
    (hz : liftChiT n d Ω p s
      (ξ - ratPt (blockProd (goodBlocks (paramRho n d Ω p) (liftN s))) β - latEmbed z) ≠ 0) :
    cosetSymbol (blockProd (goodBlocks (paramRho n d Ω p) (liftN s))) g
        (paramGoodSet n d Ω p (liftN s)) ξ =
      g (ξ - ratPt (blockProd (goodBlocks (paramRho n d Ω p) (liftN s))) β - latEmbed z) := by
  unfold cosetSymbol
  rw [Finset.sum_eq_single_of_mem β hβ, periodize_eq_of_liftChiT hg hz]
  intro β' hβ' hne
  refine periodize_eq_zero_of_liftChiT hg fun z' => ?_
  by_contra h
  exact hne (liftChiT_center_unique hs hβ' hβ h hz).1

/-- The good-set periodization of `g` (supported where `χ̃_s ≠ 0`) vanishes at inactive points. -/
lemma cosetSymbol_eq_zero_of_liftChiT {s : ℕ} {g : EuclideanSpace ℝ (Fin n) → ℂ}
    (hg : ∀ η, g η ≠ 0 → liftChiT n d Ω p s η ≠ 0) {ξ : EuclideanSpace ℝ (Fin n)}
    (h : ∀ β ∈ paramGoodSet n d Ω p (liftN s), ∀ z : Fin n → ℤ, liftChiT n d Ω p s
      (ξ - ratPt (blockProd (goodBlocks (paramRho n d Ω p) (liftN s))) β - latEmbed z) = 0) :
    cosetSymbol (blockProd (goodBlocks (paramRho n d Ω p) (liftN s))) g
        (paramGoodSet n d Ω p (liftN s)) ξ = 0 :=
  Finset.sum_eq_zero fun β hβ => periodize_eq_zero_of_liftChiT hg (h β hβ)

/-- **Blueprint Lemma 9.3 (`lem:liftsquare`), eq. (9.8) (`eq:liftfactor`)**, the exact symbol
factorization: for `s ≥ 1`, `α = a/q ∈ 𝓡_s` and every symbol `m`,
`Lift_{s,α}[m] = A_{s,α} · D_s[m]` pointwise on `E`. -/
theorem liftSym_eq_liftA_mul_liftD {s : ℕ} (hs : 1 ≤ s) {a q : ℕ} (haq : (a, q) ∈ liftRat s)
    (m : EuclideanSpace ℝ (Fin n) → ℂ) (ξ : EuclideanSpace ℝ (Fin n)) :
    liftSym n d Ω p s a q m ξ = liftA n d Ω p s a q ξ * liftD n d Ω p s m ξ := by
  obtain ⟨-, hqN, -, -⟩ := mem_liftRat.1 haq
  have hq1 : 1 ≤ q := one_le_of_mem_liftRat haq
  set Q := blockProd (goodBlocks (paramRho n d Ω p) (liftN s))
  have hgT : ∀ η, m η * (liftChiT n d Ω p s η : ℂ) ≠ 0 → liftChiT n d Ω p s η ≠ 0 :=
    fun η h h0 => h (by rw [h0, Complex.ofReal_zero, mul_zero])
  have hgC : ∀ (c : EuclideanSpace ℝ (Fin n) → ℂ) η, c η * (liftChi n d Ω p s η : ℂ) ≠ 0 →
      liftChiT n d Ω p s η ≠ 0 := fun c η h => liftChiT_ne_zero_of_liftChi_ne_zero
    fun h0 => h (by rw [h0, Complex.ofReal_zero, mul_zero])
  unfold liftA liftSym
  rw [Finset.sum_mul]
  refine Finset.sum_congr rfl fun b _ => ?_
  rw [mul_assoc]
  congr 1
  obtain ⟨hγ, hγpt⟩ := gridEmb_mem_goodSet (n := n) (paramRho_pos n d Ω p) (two_le_liftN hs) hq1
    hqN.le b
  rw [← hγpt]
  by_cases hact : ∃ z : Fin n → ℤ, liftChiT n d Ω p s
      (ξ - ratPt Q (gridEmb Q q b) - latEmbed z) ≠ 0
  · obtain ⟨z, hz⟩ := hact
    rw [periodize_eq_of_liftChiT (hgC m) hz, periodize_eq_of_liftChiT (hgC _) hz, liftD,
      cosetSymbol_eq_of_liftChiT hs hgT hγ hz]
    set η := ξ - ratPt Q (gridEmb Q q b) - latEmbed z
    have h := liftChi_mul_liftChiT (n := n) (d := d) (Ω := Ω) (p := p) s η
    have h' : (liftChi n d Ω p s η : ℂ) * (liftChiT n d Ω p s η : ℂ) = liftChi n d Ω p s η := by
      exact_mod_cast h
    calc m η * (liftChi n d Ω p s η : ℂ)
        = m η * ((liftChi n d Ω p s η : ℂ) * (liftChiT n d Ω p s η : ℂ)) := by rw [h']
      _ = 1 * (liftChi n d Ω p s η : ℂ) * (m η * (liftChiT n d Ω p s η : ℂ)) := by ring
  · push Not at hact
    rw [periodize_eq_zero_of_liftChiT (hgC m) hact, periodize_eq_zero_of_liftChiT (hgC _) hact,
      zero_mul]


/-! #### The operator form of (9.8) -/

lemma continuous_liftChi (s : ℕ) :
    Continuous fun ξ : EuclideanSpace ℝ (Fin n) => (liftChi n d Ω p s ξ : ℂ) :=
  Complex.continuous_ofReal.comp (contDiff_liftCutoff.continuous.comp (continuous_const_smul _))

lemma continuous_liftChiT (s : ℕ) :
    Continuous fun ξ : EuclideanSpace ℝ (Fin n) => (liftChiT n d Ω p s ξ : ℂ) :=
  Complex.continuous_ofReal.comp
    (contDiff_companionCutoff.continuous.comp (continuous_const_smul _))

/-- `A_{s,α}` is continuous. -/
lemma continuous_liftA (s a q : ℕ) : Continuous (liftA n d Ω p s a q) := by
  have hL := eight_le_liftL (n := n) (d := d) (Ω := Ω) (p := p) s
  unfold liftA liftSym
  refine continuous_finsetSum _ fun b _ => continuous_const.mul ?_
  refine (continuous_periodize_of_support (c := 1 / (liftL n d Ω p s : ℝ))
    (continuous_const.mul (continuous_liftChi s)) ?_ fun η hη i => ?_).comp
    (continuous_sub_right _)
  · rw [div_lt_div_iff₀ (by linarith) (by norm_num)]; linarith
  · have h : liftChi n d Ω p s η ≠ 0 := fun h0 => hη (by simp [h0])
    exact support_liftChi s h i

/-- Lifted symbols are `ℤⁿ`-periodic. -/
lemma liftSym_add_latEmbed (s a q : ℕ) (m : EuclideanSpace ℝ (Fin n) → ℂ)
    (ξ : EuclideanSpace ℝ (Fin n)) (k : Fin n → ℤ) :
    liftSym n d Ω p s a q m (ξ + latEmbed k) = liftSym n d Ω p s a q m ξ := by
  unfold liftSym
  refine Finset.sum_congr rfl fun b _ => ?_
  rw [add_sub_right_comm, periodize_add_latEmbed]

/-- The kernel of `A_{s,α}` is in `ℓ¹`. -/
lemma summable_latKernel_liftA (s a : ℕ) {q : ℕ} (hq : 1 ≤ q) :
    Summable fun y => ‖latKernel (liftA n d Ω p s a q) y‖ := by
  refine (arith_summable_norm_liftPhi (n := n) (d := d) (Ω := Ω) (p := p) s).congr fun y => ?_
  rw [latKernel_liftA s a hq, norm_mul, norm_eC, one_mul]

/-- `A_{s,α}` is integrable on the torus. -/
lemma integrableOn_liftA (s a q : ℕ) : IntegrableOn (liftA n d Ω p s a q) (torusCube n) :=
  integrableOn_liftSym (by simpa using integrable_liftChi (n := n) (d := d) (Ω := Ω) (p := p) s)

/-- Composition with a continuous periodic symbol with `ℓ¹` kernel, in convolution form: for
`D` integrable on the torus and `f ∈ ℓ¹`, `(A D)(D) f = Ǎ * (D(D) f)` (the second factor need
not be in `ℓ¹`). -/
lemma latMult_mul_eq_tsum {A D : EuclideanSpace ℝ (Fin n) → ℂ} (hA : Continuous A)
    (hper : ∀ ξ (k : Fin n → ℤ), A (ξ + latEmbed k) = A ξ)
    (hK : Summable fun y => ‖latKernel A y‖) (hD : IntegrableOn D (torusCube n))
    {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) (x : Fin n → ℤ) :
    latMult (fun ξ => A ξ * D ξ) f x = ∑' y, latKernel A y * latMult D f (x - y) := by
  have hH : IntegrableOn (fun ξ => D ξ * latFT f ξ * eC (inner ℝ (latEmbed x) ξ))
      (torusCube n) := by
    refine hD.mul_bdd (c := ∑' z, ‖f z‖)
      (((continuous_latFT hf).mul (by fun_prop : Continuous fun ξ : EuclideanSpace ℝ (Fin n) =>
        eC (inner ℝ (latEmbed x) ξ))).aestronglyMeasurable) ?_ |>.congr ?_
    · exact Filter.Eventually.of_forall fun ξ => by
        rw [Pi.mul_apply, norm_mul, norm_eC, mul_one]; exact norm_latFT_le hf ξ
    · exact Filter.Eventually.of_forall fun ξ => by simp only [Pi.mul_apply]; ring
  have e1 : latMult (fun ξ => A ξ * D ξ) f x = ∫ ξ in torusCube n, latFT (latKernel A) ξ *
      (D ξ * latFT f ξ * eC (inner ℝ (latEmbed x) ξ)) := by
    unfold latMult
    congr 1; funext ξ
    rw [latFT_latKernel_of_continuous hA hper hK ξ]; ring
  rw [e1, integral_latFT_mul hK hH]
  refine tsum_congr fun y => ?_
  congr 1
  unfold latMult
  congr 1; funext ξ
  rw [latEmbed_sub, inner_sub_left, sub_eq_add_neg, eC_add]; ring

/-- `χ̃_s` (as a complex function) is integrable. -/
lemma integrable_liftChiT (s : ℕ) :
    Integrable fun ξ : EuclideanSpace ℝ (Fin n) => (liftChiT n d Ω p s ξ : ℂ) := by
  refine (continuous_liftChiT s).integrable_of_hasCompactSupport ?_
  refine HasCompactSupport.intro (isCompact_box (2 / (liftL n d Ω p s : ℝ))) fun ξ hξ => ?_
  by_contra h
  exact hξ (support_liftChiT s (fun h0 => h (by simp [h0])))

/-- `m χ̃_s` is integrable for `m` a.e. strongly measurable and bounded. -/
lemma integrable_mul_liftChiT {s : ℕ} {m : EuclideanSpace ℝ (Fin n) → ℂ}
    (hm : AEStronglyMeasurable m volume) {B : ℝ} (hB : ∀ ξ, ‖m ξ‖ ≤ B) :
    Integrable fun ξ => m ξ * (liftChiT n d Ω p s ξ : ℂ) := by
  have hχ := integrable_liftChiT (n := n) (d := d) (Ω := Ω) (p := p) s
  exact Integrable.mono' (hχ.norm.const_mul B) (hm.mul hχ.aestronglyMeasurable)
    (Filter.Eventually.of_forall fun ξ => by
      rw [norm_mul]; exact mul_le_mul_of_nonneg_right (hB ξ) (norm_nonneg _))

/-- `D_s[m]` is integrable on the torus for bounded measurable `m`. -/
lemma integrableOn_liftD {s : ℕ} {m : EuclideanSpace ℝ (Fin n) → ℂ}
    (hm : AEStronglyMeasurable m volume) {B : ℝ} (hB : ∀ ξ, ‖m ξ‖ ≤ B) :
    IntegrableOn (liftD n d Ω p s m) (torusCube n) :=
  integrableOn_cosetSymbol (integrable_mul_liftChiT hm hB) _

/-- **Blueprint Lemma 9.3 (`lem:liftsquare`), eq. (9.8), operator form**: for `s ≥ 1`,
`α = a/q ∈ 𝓡_s`, `m` bounded measurable and `f ∈ ℓ¹` (e.g. finitely supported),
`Lift_{s,α}[m](D) f = Ǎ_{s,α} * (D_s[m](D) f)`, i.e. `A_{s,α}(D)` applied (by its `ℓ¹` kernel) to
`D_s[m](D) f` (which is bounded, but need not be in `ℓ¹`). -/
theorem latMult_liftSym_eq_tsum {s : ℕ} (hs : 1 ≤ s) {a q : ℕ} (haq : (a, q) ∈ liftRat s)
    {m : EuclideanSpace ℝ (Fin n) → ℂ} (hm : AEStronglyMeasurable m volume) {B : ℝ}
    (hB : ∀ ξ, ‖m ξ‖ ≤ B) {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖)
    (x : Fin n → ℤ) :
    latMult (liftSym n d Ω p s a q m) f x =
      ∑' y, latKernel (liftA n d Ω p s a q) y * latMult (liftD n d Ω p s m) f (x - y) := by
  have e : liftSym n d Ω p s a q m = fun ξ => liftA n d Ω p s a q ξ * liftD n d Ω p s m ξ :=
    funext (liftSym_eq_liftA_mul_liftD hs haq m)
  rw [e]
  exact latMult_mul_eq_tsum (continuous_liftA s a q) (liftSym_add_latEmbed s a q _)
    (summable_latKernel_liftA s a (one_le_of_mem_liftRat haq)) (integrableOn_liftD hm hB) hf x

/-- **Blueprint Lemma 9.3 (`lem:liftsquare`), eq. (9.8), composition form**: under the hypotheses
of `latMult_liftSym_eq_tsum`, if moreover `D_s[m](D) f ∈ ℓ¹`, then
`Lift_{s,α}[m](D) f = A_{s,α}(D) (D_s[m](D) f)`. -/
theorem latMult_liftSym_eq_latMult {s : ℕ} (hs : 1 ≤ s) {a q : ℕ} (haq : (a, q) ∈ liftRat s)
    {m : EuclideanSpace ℝ (Fin n) → ℂ} (hm : AEStronglyMeasurable m volume) {B : ℝ}
    (hB : ∀ ξ, ‖m ξ‖ ≤ B) {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖)
    (hDf : Summable fun z => ‖latMult (liftD n d Ω p s m) f z‖) :
    latMult (liftSym n d Ω p s a q m) f =
      latMult (liftA n d Ω p s a q) (latMult (liftD n d Ω p s m) f) := by
  funext x
  rw [latMult_liftSym_eq_tsum hs haq hm hB hf x,
    latMult_eq_latConv (integrableOn_liftA s a q) hDf, latConv]


/-! #### The arithmetic vector bound (9.6) for bounded inputs -/

open scoped NNReal ENNReal in
/-- Finite suprema of norms are continuous. -/
lemma tendsto_finset_sup_nnnorm {ι : Type*} (S : Finset ι) {u : ℕ → ι → ℂ} {v : ι → ℂ}
    (h : ∀ i ∈ S, Filter.Tendsto (fun N => u N i) Filter.atTop (nhds (v i))) :
    Filter.Tendsto (fun N => S.sup fun i => ‖u N i‖₊) Filter.atTop
      (nhds (S.sup fun i => ‖v i‖₊)) := by
  classical
  induction S using Finset.induction_on with
  | empty => simp
  | insert a S ha ih =>
    simp only [Finset.sup_insert]
    exact ((continuous_nnnorm.tendsto _).comp (h a (mem_insert_self a S))).max
      (ih fun i hi => h i (mem_insert_of_mem hi))

open scoped NNReal ENNReal in
/-- Eq. (9.6) of Blueprint Lemma 9.2 for bounded inputs (not necessarily in `ℓ¹`), with
`A_{s,α}` acting by its `ℓ¹` kernel `Ǎ_{s,α}`: for `1 < t < ∞` there are `δ_t > 0` and `C_t` such
that for every `s ≥ 1` and every finite list `(g_ν)` of functions bounded by `M`,
`‖(∑_ν sup_{α ∈ 𝓡_s} |Ǎ_{s,α} * g_ν|²)^{1/2}‖_t ≤ C_t 2^{-δ_t s} ‖(∑_ν |g_ν|²)^{1/2}‖_t`.
(Windowing `g_ν w_N ∈ ℓ¹`, `arith_maximal_decay_vector`, and Fatou as `N → ∞`.) -/
theorem arith_maximal_decay_vector_bdd (n d : ℕ) (hn : 1 ≤ n) (hd : 1 ≤ d) {t : ℝ}
    (ht : 1 < t) :
    ∃ δ : ℝ, 0 < δ ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ),
      1 ≤ s → ∀ {ι : Type*} (F : Finset ι) (g : ι → (Fin n → ℤ) → ℂ) (M : ℝ),
        (∀ ν ∈ F, ∀ x, ‖g ν x‖ ≤ M) →
        eLpNorm (fun x => Real.sqrt (∑ ν ∈ F,
            ((((liftRat s).sup fun aq =>
              ‖∑' y, latKernel (liftA n d Ω p s aq.1 aq.2) y * g ν (x - y)‖₊ : ℝ≥0) : ℝ) ^ 2)))
            (ENNReal.ofReal t) Measure.count ≤
          ENNReal.ofReal (C * (2 : ℝ) ^ (-(δ * s))) *
            eLpNorm (fun x => Real.sqrt (∑ ν ∈ F, ‖g ν x‖ ^ 2)) (ENNReal.ofReal t)
              Measure.count := by
  obtain ⟨δ, hδ, C, hC, h⟩ := arith_maximal_decay_vector n d hn hd ht
  refine ⟨δ, hδ, C, hC, fun Ω p s hs ι F g M hM => ?_⟩
  set gN : ℕ → ι → (Fin n → ℤ) → ℂ := fun N ν x => g ν x * windowFun n N x with hgN
  have hgNs : ∀ N, ∀ ν ∈ F, Summable fun z => ‖gN N ν z‖ := by
    intro N ν hν
    refine Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun z => ?_)
      ((summable_windowFun N).mul_left M)
    rw [hgN, norm_mul]
    exact mul_le_mul_of_nonneg_right (hM ν hν z) (norm_nonneg _)
  -- the kernel form of `A_{s,α}` on `ℓ¹`
  have hker : ∀ N, ∀ ν ∈ F, ∀ aq ∈ liftRat s, ∀ x,
      latMult (liftA n d Ω p s aq.1 aq.2) (gN N ν) x =
        ∑' y, latKernel (liftA n d Ω p s aq.1 aq.2) y * gN N ν (x - y) := by
    intro N ν hν aq _ x
    rw [latMult_eq_latConv (integrableOn_liftA s _ _) (hgNs N ν hν), latConv]
  refine eLpNorm_le_of_tendsto_of_eLpNorm_le
    (u := fun N x => Real.sqrt (∑ ν ∈ F,
      ((((liftRat s).sup fun aq =>
        ‖latMult (liftA n d Ω p s aq.1 aq.2) (gN N ν) x‖₊ : ℝ≥0) : ℝ) ^ 2)))
    (fun _ => AEStronglyMeasurable.of_discrete) (Filter.Eventually.of_forall fun x => ?_)
    fun N => ?_
  · -- pointwise convergence
    refine (Real.continuous_sqrt.tendsto _).comp (tendsto_finsetSum _ fun ν hν => ?_)
    refine ((continuous_pow 2).tendsto _).comp ((NNReal.continuous_coe.tendsto _).comp ?_)
    refine tendsto_finset_sup_nnnorm _ fun aq haq => ?_
    have hq : 1 ≤ aq.2 := one_le_of_mem_liftRat (a := aq.1) (by simpa using haq)
    simp_rw [hker _ ν hν aq haq x]
    refine tendsto_tsum_of_dominated_convergence (bound := fun y =>
        ‖latKernel (liftA n d Ω p s aq.1 aq.2) y‖ * M)
      ((summable_latKernel_liftA s aq.1 hq).mul_right M) (fun y => ?_)
      (Filter.Eventually.of_forall fun N y => ?_)
    · have := (tendsto_windowFun (n := n) (x - y)).const_mul (g ν (x - y))
      rw [mul_one] at this
      exact this.const_mul _
    · rw [norm_mul, hgN, norm_mul]
      refine mul_le_mul_of_nonneg_left ?_ (norm_nonneg _)
      calc ‖g ν (x - y)‖ * ‖windowFun n N (x - y)‖ ≤ ‖g ν (x - y)‖ * 1 :=
            mul_le_mul_of_nonneg_left (norm_windowFun_le N _) (norm_nonneg _)
        _ ≤ M := by rw [mul_one]; exact hM ν hν _
  · -- the windowed bound
    refine (h Ω p s hs F (gN N) (hgNs N)).trans ?_
    gcongr
    refine eLpNorm_mono_real AEStronglyMeasurable.of_discrete fun x => ?_
    rw [Real.norm_of_nonneg (Real.sqrt_nonneg _)]
    refine Real.sqrt_le_sqrt (Finset.sum_le_sum fun ν _ => ?_)
    rw [hgN, norm_mul]
    refine pow_le_pow_left₀ (by positivity) ?_ 2
    calc ‖g ν x‖ * ‖windowFun n N x‖ ≤ ‖g ν x‖ * 1 :=
          mul_le_mul_of_nonneg_left (norm_windowFun_le N _) (norm_nonneg _)
      _ = ‖g ν x‖ := mul_one _


/-! #### The `ℓ²` square estimate (9.9) -/

/-- Pointwise: `∑_ν |D_s[m_ν](ξ)|² ≤ sup_η ∑_ν |m_ν(η)|²` (the good-set bumps are disjoint and
`0 ≤ χ̃_s ≤ 1`). -/
lemma sum_norm_sq_liftD_le {s : ℕ} (hs : 1 ≤ s) {ι : Type*} (F : Finset ι)
    (m : ι → EuclideanSpace ℝ (Fin n) → ℂ) {B : ℝ} (hB : ∀ η, ∑ ν ∈ F, ‖m ν η‖ ^ 2 ≤ B ^ 2)
    (ξ : EuclideanSpace ℝ (Fin n)) :
    ∑ ν ∈ F, ‖liftD n d Ω p s (m ν) ξ‖ ^ 2 ≤ B ^ 2 := by
  have hgT : ∀ ν η, m ν η * (liftChiT n d Ω p s η : ℂ) ≠ 0 → liftChiT n d Ω p s η ≠ 0 :=
    fun ν η h h0 => h (by rw [h0, Complex.ofReal_zero, mul_zero])
  by_cases hact : ∃ β ∈ paramGoodSet n d Ω p (liftN s), ∃ z : Fin n → ℤ, liftChiT n d Ω p s
      (ξ - ratPt (blockProd (goodBlocks (paramRho n d Ω p) (liftN s))) β - latEmbed z) ≠ 0
  · obtain ⟨β, hβ, z, hz⟩ := hact
    set η := ξ - ratPt (blockProd (goodBlocks (paramRho n d Ω p) (liftN s))) β - latEmbed z
    refine le_trans (Finset.sum_le_sum fun ν _ => ?_) (hB η)
    rw [liftD, cosetSymbol_eq_of_liftChiT hs (hgT ν) hβ hz, norm_mul, Complex.norm_real,
      Real.norm_of_nonneg (liftChiT_nonneg s η)]
    refine pow_le_pow_left₀ (mul_nonneg (norm_nonneg _) (liftChiT_nonneg s η)) ?_ 2
    exact mul_le_of_le_one_right (norm_nonneg _) (liftChiT_le_one s η)
  · push Not at hact
    rw [Finset.sum_eq_zero fun ν _ => by
      rw [liftD, cosetSymbol_eq_zero_of_liftChiT (hgT ν) hact, norm_zero]; norm_num]
    positivity

/-- A single term of a finite sum of squares is bounded by the bound of the sum. -/
lemma lift_norm_le_of_sum_sq_le {ι : Type*} {F : Finset ι} {a : ι → ℂ} {B : ℝ} (hB0 : 0 ≤ B)
    (h : ∑ ν ∈ F, ‖a ν‖ ^ 2 ≤ B ^ 2) {ν : ι} (hν : ν ∈ F) : ‖a ν‖ ≤ B := by
  have h1 : ‖a ν‖ ^ 2 ≤ B ^ 2 :=
    (Finset.single_le_sum (f := fun ν => ‖a ν‖ ^ 2) (fun _ _ => by positivity) hν).trans h
  exact (pow_le_pow_iff_left₀ (norm_nonneg _) hB0 two_ne_zero).1 h1

/-- `ℓ¹ ⊆ ℓ²` on `ℤⁿ` (summability of `|f|²`). -/
lemma summable_norm_sq_of_summable {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) :
    Summable fun z => ‖f z‖ ^ 2 := by
  refine Summable.of_nonneg_of_le (fun _ => by positivity) (fun z => ?_)
    (hf.mul_left (∑' z, ‖f z‖))
  rw [sq]
  exact mul_le_mul_of_nonneg_right (hf.le_tsum z fun _ _ => norm_nonneg _) (norm_nonneg _)

/-- `‖(∑_ν |g_ν|²)^{1/2}‖₂² = ∑_ν ∑_x |g_ν(x)|²` for square-summable `g_ν` on `ℤⁿ`. -/
lemma eLpNorm_sqrt_sum_sq_two_sq {ι : Type*} (F : Finset ι) (g : ι → (Fin n → ℤ) → ℂ)
    (hg : ∀ ν ∈ F, Summable fun x => ‖g ν x‖ ^ 2) :
    eLpNorm (fun x => Real.sqrt (∑ ν ∈ F, ‖g ν x‖ ^ 2)) 2 Measure.count ^ 2 =
      ENNReal.ofReal (∑ ν ∈ F, ∑' x, ‖g ν x‖ ^ 2) := by
  rw [arith_eLpNorm_two_sq_eq_tsum]
  have e : ∀ x, ‖Real.sqrt (∑ ν ∈ F, ‖g ν x‖ ^ 2)‖ₑ ^ 2 =
      ENNReal.ofReal (∑ ν ∈ F, ‖g ν x‖ ^ 2) := by
    intro x
    rw [Real.enorm_eq_ofReal (Real.sqrt_nonneg _), ← ENNReal.ofReal_pow (Real.sqrt_nonneg _),
      Real.sq_sqrt (Finset.sum_nonneg fun _ _ => by positivity)]
  simp_rw [e]
  rw [← ENNReal.ofReal_tsum_of_nonneg (fun x => Finset.sum_nonneg fun _ _ => by positivity)
    (summable_sum hg), Summable.tsum_finsetSum hg]

/-- The `ℓ²` bound of the proof of eq. (9.9): Parseval (Bessel) and disjointness of the
good-set bumps give `‖(∑_ν |D_s[m_ν](D) f|²)^{1/2}‖₂ ≤ B ‖f‖₂` when
`∑_ν |m_ν(η)|² ≤ B²` for all `η`. -/
lemma eLpNorm_sqrt_sum_liftD_two_le {s : ℕ} (hs : 1 ≤ s) {ι : Type*} (F : Finset ι)
    (m : ι → EuclideanSpace ℝ (Fin n) → ℂ) (hm : ∀ ν ∈ F, AEStronglyMeasurable (m ν) volume)
    {B : ℝ} (hB0 : 0 ≤ B) (hB : ∀ η, ∑ ν ∈ F, ‖m ν η‖ ^ 2 ≤ B ^ 2)
    {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) :
    eLpNorm (fun x => Real.sqrt (∑ ν ∈ F, ‖latMult (liftD n d Ω p s (m ν)) f x‖ ^ 2)) 2
      Measure.count ≤ ENNReal.ofReal B * eLpNorm f 2 Measure.count := by
  set D := fun ν => liftD n d Ω p s (m ν) with hD
  have hmB : ∀ ν ∈ F, ∀ η, ‖m ν η‖ ≤ B := fun ν hν η => lift_norm_le_of_sum_sq_le hB0 (hB η) hν
  have hDB : ∀ ν ∈ F, ∀ ξ, ‖D ν ξ‖ ≤ B := fun ν hν ξ =>
    lift_norm_le_of_sum_sq_le (a := fun ν => D ν ξ) hB0 (sum_norm_sq_liftD_le hs F m hB ξ) hν
  have hDm : ∀ ν ∈ F, AEStronglyMeasurable (D ν) (volume.restrict (torusCube n)) :=
    fun ν hν => (integrableOn_liftD (hm ν hν) (hmB ν hν)).aestronglyMeasurable
  have hBes := fun ν hν => summable_and_tsum_norm_sq_latMult_le_integral (hDm ν hν)
    (fun ξ _ => hDB ν hν ξ) hf
  set S := ∑' z, ‖f z‖
  have hfb : ∀ ξ, ‖latFT f ξ‖ ≤ S := norm_latFT_le hf
  have hint : ∀ ν ∈ F, IntegrableOn (fun ξ => ‖D ν ξ‖ ^ 2 * ‖latFT f ξ‖ ^ 2) (torusCube n) := by
    intro ν hν
    refine integrableOn_torusCube_of_bound
      (((hDm ν hν).norm.pow 2).mul ((continuous_latFT hf).norm.pow 2).aestronglyMeasurable)
      (B ^ 2 * S ^ 2) fun ξ _ => ?_
    rw [Real.norm_of_nonneg (by positivity)]
    gcongr
    · exact hDB ν hν ξ
    · exact hfb ξ
  have hintR : IntegrableOn (fun ξ => B ^ 2 * ‖latFT f ξ‖ ^ 2) (torusCube n) := by
    refine integrableOn_torusCube_of_bound
      ((continuous_const.mul ((continuous_latFT hf).norm.pow 2)).aestronglyMeasurable)
      (B ^ 2 * S ^ 2) fun ξ _ => ?_
    rw [Real.norm_of_nonneg (by positivity)]
    gcongr
    exact hfb ξ
  have hreal : ∑ ν ∈ F, ∑' x, ‖latMult (D ν) f x‖ ^ 2 ≤ B ^ 2 * ∑' x, ‖f x‖ ^ 2 := by
    calc ∑ ν ∈ F, ∑' x, ‖latMult (D ν) f x‖ ^ 2
        ≤ ∑ ν ∈ F, ∫ ξ in torusCube n, ‖D ν ξ‖ ^ 2 * ‖latFT f ξ‖ ^ 2 :=
          Finset.sum_le_sum fun ν hν => (hBes ν hν).2
      _ = ∫ ξ in torusCube n, (∑ ν ∈ F, ‖D ν ξ‖ ^ 2) * ‖latFT f ξ‖ ^ 2 := by
          rw [← integral_finsetSum _ hint]
          congr 1; funext ξ; rw [Finset.sum_mul]
      _ ≤ ∫ ξ in torusCube n, B ^ 2 * ‖latFT f ξ‖ ^ 2 := by
          refine integral_mono_of_nonneg (Filter.Eventually.of_forall fun ξ => by positivity)
            hintR (Filter.Eventually.of_forall fun ξ => ?_)
          exact mul_le_mul_of_nonneg_right (sum_norm_sq_liftD_le hs F m hB ξ) (by positivity)
      _ = B ^ 2 * ∑' x, ‖f x‖ ^ 2 := by rw [integral_const_mul, integral_norm_sq_latFT hf]
  have key : eLpNorm (fun x => Real.sqrt (∑ ν ∈ F, ‖latMult (D ν) f x‖ ^ 2)) 2
      Measure.count ^ 2 ≤ 1 * (ENNReal.ofReal B * eLpNorm f 2 Measure.count) ^ 2 := by
    rw [eLpNorm_sqrt_sum_sq_two_sq F _ fun ν hν => (hBes ν hν).1, one_mul, mul_pow,
      arith_eLpNorm_two_sq_eq_tsum]
    have e : ∑' x, ‖f x‖ₑ ^ 2 = ENNReal.ofReal (∑' x, ‖f x‖ ^ 2) := by
      rw [ENNReal.ofReal_tsum_of_nonneg (fun _ => by positivity)
        (summable_norm_sq_of_summable hf)]
      refine tsum_congr fun x => ?_
      rw [ENNReal.ofReal_pow (norm_nonneg _), ofReal_norm]
    rw [e, ← ENNReal.ofReal_pow hB0, ← ENNReal.ofReal_mul (by positivity)]
    exact ENNReal.ofReal_le_ofReal hreal
  have := band_le_of_sq_le key
  rwa [ENNReal.one_rpow, one_mul] at this

/-- The bounded inputs `D_s[m](D) f` (`|D_s[m](D) f| ≤ ‖D_s[m]‖_{L¹(𝕋ⁿ)} ‖f‖_{ℓ¹}`) of a finite
family, with a common bound. -/
lemma exists_bound_latMult_liftD {s : ℕ} {ι : Type*} (F : Finset ι)
    {m : ι → EuclideanSpace ℝ (Fin n) → ℂ} (hm : ∀ ν ∈ F, AEStronglyMeasurable (m ν) volume)
    {B : ℝ} (hmB : ∀ ν ∈ F, ∀ η, ‖m ν η‖ ≤ B) {f : (Fin n → ℤ) → ℂ}
    (hf : Summable fun z => ‖f z‖) :
    ∃ M : ℝ, ∀ ν ∈ F, ∀ x, ‖latMult (liftD n d Ω p s (m ν)) f x‖ ≤ M := by
  refine ⟨∑ ν ∈ F, (∫ η in torusCube n, ‖liftD n d Ω p s (m ν) η‖) * ∑' z, ‖f z‖,
    fun ν hν x => ?_⟩
  refine (norm_latMult_le (integrableOn_liftD (hm ν hν) (hmB ν hν)) hf x).trans ?_
  exact Finset.single_le_sum (f := fun ν => (∫ η in torusCube n,
    ‖liftD n d Ω p s (m ν) η‖) * ∑' z, ‖f z‖)
    (fun _ _ => mul_nonneg (integral_nonneg fun _ => norm_nonneg _)
      (tsum_nonneg fun _ => norm_nonneg _)) hν

open scoped NNReal ENNReal in
/-- The lifted square function equals the arithmetic square function of the inputs
`D_s[m_ν](D) f` (factorization (9.8), operator form). -/
lemma lift_sqrt_sum_eq {s : ℕ} (hs : 1 ≤ s) {ι : Type*} (F : Finset ι)
    {m : ι → EuclideanSpace ℝ (Fin n) → ℂ} (hm : ∀ ν ∈ F, AEStronglyMeasurable (m ν) volume)
    {B : ℝ} (hmB : ∀ ν ∈ F, ∀ η, ‖m ν η‖ ≤ B) {f : (Fin n → ℤ) → ℂ}
    (hf : Summable fun z => ‖f z‖) :
    (fun x => Real.sqrt (∑ ν ∈ F,
      ((((liftRat s).sup fun aq =>
        ‖latMult (liftSym n d Ω p s aq.1 aq.2 (m ν)) f x‖₊ : ℝ≥0) : ℝ) ^ 2))) =
      fun x => Real.sqrt (∑ ν ∈ F,
      ((((liftRat s).sup fun aq =>
        ‖∑' y, latKernel (liftA n d Ω p s aq.1 aq.2) y *
          latMult (liftD n d Ω p s (m ν)) f (x - y)‖₊ : ℝ≥0) : ℝ) ^ 2)) := by
  funext x
  congr 1
  refine Finset.sum_congr rfl fun ν hν => ?_
  refine congrArg (fun t : ℝ≥0 => (t : ℝ) ^ 2) (Finset.sup_congr rfl fun aq haq => ?_)
  rw [latMult_liftSym_eq_tsum hs (a := aq.1) (q := aq.2) (by simpa using haq) (hm ν hν)
    (hmB ν hν) hf x]

open scoped NNReal ENNReal in
/-- **Blueprint Lemma 9.3 (`lem:liftsquare`), eq. (9.9) (`eq:liftL2square`)**, the `ℓ²` lifted
square estimate: for `n, d ≥ 1` there are `γ > 0` and `C` (independent of `Ω, p`, of `s`, of the
family and of `f`) such that for every `s ≥ 1`, every finite family `(m_ν)_{ν ∈ F}` of
a.e. strongly measurable symbols with `∑_ν |m_ν(η)|² ≤ B²` for all `η` (`B ≥ 0`; i.e.
`B ≥ (sup_η ∑_ν |m_ν(η)|²)^{1/2}`), and every `f ∈ ℓ¹(ℤⁿ)` (e.g. finitely supported),
`‖(∑_ν sup_{α ∈ 𝓡_s} |Lift_{s,α}[m_ν](D) f|²)^{1/2}‖₂ ≤ C 2^{-γ s} B ‖f‖₂`. -/
theorem lift_square_two (n d : ℕ) (hn : 1 ≤ n) (hd : 1 ≤ d) :
    ∃ γ : ℝ, 0 < γ ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ),
      1 ≤ s → ∀ {ι : Type*} (F : Finset ι) (m : ι → EuclideanSpace ℝ (Fin n) → ℂ) (B : ℝ),
        (∀ ν ∈ F, AEStronglyMeasurable (m ν) volume) → 0 ≤ B →
        (∀ η, ∑ ν ∈ F, ‖m ν η‖ ^ 2 ≤ B ^ 2) →
        ∀ f : (Fin n → ℤ) → ℂ, Summable (fun z => ‖f z‖) →
          eLpNorm (fun x => Real.sqrt (∑ ν ∈ F,
              ((((liftRat s).sup fun aq =>
                ‖latMult (liftSym n d Ω p s aq.1 aq.2 (m ν)) f x‖₊ : ℝ≥0) : ℝ) ^ 2)))
              2 Measure.count ≤
            ENNReal.ofReal (C * (2 : ℝ) ^ (-(γ * s)) * B) * eLpNorm f 2 Measure.count := by
  obtain ⟨γ, hγ, C, hC, h⟩ := arith_maximal_decay_vector_bdd n d hn hd (t := 2) one_lt_two
  refine ⟨γ, hγ, C, hC, fun Ω p s hs ι F m B hm hB0 hB f hf => ?_⟩
  have hmB : ∀ ν ∈ F, ∀ η, ‖m ν η‖ ≤ B := fun ν hν η => lift_norm_le_of_sum_sq_le hB0 (hB η) hν
  obtain ⟨M, hM⟩ := exists_bound_latMult_liftD (d := d) (Ω := Ω) (p := p) (s := s) F hm hmB hf
  have h1 := h Ω p s hs F (fun ν => latMult (liftD n d Ω p s (m ν)) f) M hM
  rw [show ENNReal.ofReal 2 = 2 by norm_num] at h1
  rw [lift_sqrt_sum_eq hs F hm hmB hf]
  refine h1.trans ((mul_le_mul' le_rfl (eLpNorm_sqrt_sum_liftD_two_le hs F m hm hB0 hB hf)).trans
    (le_of_eq ?_))
  rw [ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ C * (2 : ℝ) ^ (-(γ * s))), mul_assoc]


/-! #### The `ℓ^p` square estimate (9.10) -/

lemma hasCompactSupport_liftChiT (s : ℕ) :
    HasCompactSupport fun ξ : EuclideanSpace ℝ (Fin n) => (liftChiT n d Ω p s ξ : ℂ) :=
  HasCompactSupport.intro (isCompact_box (2 / (liftL n d Ω p s : ℝ))) fun ξ hξ => by
    by_contra h
    exact hξ (support_liftChiT s (fun h0 => h (by simp [h0])))

/-- `χ̃_s` as a (complex-valued) Schwartz function. -/
noncomputable def liftChiTSchwartz (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ)
    (s : ℕ) : 𝓢(EuclideanSpace ℝ (Fin n), ℂ) :=
  (hasCompactSupport_liftChiT (n := n) (d := d) (Ω := Ω) (p := p) s).toSchwartzMap
    (Complex.ofRealCLM.contDiff.comp
      (contDiff_companionCutoff.comp (contDiff_const_smul (liftL n d Ω p s : ℝ))))

@[simp] lemma liftChiTSchwartz_apply (s : ℕ) (ξ : EuclideanSpace ℝ (Fin n)) :
    liftChiTSchwartz n d Ω p s ξ = (liftChiT n d Ω p s ξ : ℂ) := rfl

/-- The companion cutoff `χ̃ = θ` as a Schwartz function. -/
noncomputable def companionSchwartz (n : ℕ) : 𝓢(EuclideanSpace ℝ (Fin n), ℂ) :=
  (HasCompactSupport.intro (isCompact_box (2 : ℝ)) fun ξ hξ => by
      by_contra h
      exact hξ (support_companionCutoff (n := n) (fun h0 => h (by simp [h0])))
    : HasCompactSupport fun ξ : EuclideanSpace ℝ (Fin n) => (companionCutoff n ξ : ℂ)).toSchwartzMap
    (Complex.ofRealCLM.contDiff.comp contDiff_companionCutoff)

/-- Uniform envelope bound for the kernels of `χ̃_s`: `|𝓕⁻ χ̃_s| ≤ C B_{L_s}` with `C`
depending only on `n`. -/
lemma exists_norm_fourierInv_liftChiT_le (n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ)
      (x : EuclideanSpace ℝ (Fin n)),
      ‖𝓕⁻ (fun ξ => (liftChiT n d Ω p s ξ : ℂ)) x‖ ≤ C * envelope n (liftL n d Ω p s) x := by
  obtain ⟨K, hK, hKb⟩ := exists_norm_le_envelope (𝓕⁻ (companionSchwartz n))
  refine ⟨K, hK, fun d Ω p s x => ?_⟩
  set L : ℝ := (liftL n d Ω p s : ℝ)
  have hL : 0 < L := liftL_pos s
  have hL' : 0 < L⁻¹ := inv_pos.2 hL
  have hfun : (fun ξ : EuclideanSpace ℝ (Fin n) => (liftChiT n d Ω p s ξ : ℂ)) =
      fun ξ => companionSchwartz n ((L⁻¹)⁻¹ • ξ) := by
    funext ξ; rw [inv_inv]; rfl
  rw [hfun, fourierInv_comp_inv_smul _ hL', ← SchwartzMap.fourierInv_coe, norm_mul,
    Complex.norm_real, Real.norm_of_nonneg (by positivity)]
  have hb := hKb (L⁻¹ • x)
  have he : envelope n 1 (L⁻¹ • x) = ((1 + ‖x‖ / L) ^ (n + 1))⁻¹ := by
    rw [envelope, norm_smul, Real.norm_of_nonneg hL'.le]
    simp [div_eq_inv_mul]
  rw [he] at hb
  calc (L⁻¹) ^ n * ‖(𝓕⁻ (companionSchwartz n)) (L⁻¹ • x)‖
      ≤ (L⁻¹) ^ n * (K * ((1 + ‖x‖ / L) ^ (n + 1))⁻¹) :=
        mul_le_mul_of_nonneg_left hb (by positivity)
    _ = K * envelope n L x := by rw [envelope, inv_pow]; ring

/-- Uniform `L¹` bound for the kernels of `χ̃_s`: `‖𝓕⁻ χ̃_s‖_{L¹} ≤ K` with `K` depending only
on `n`. -/
lemma exists_eLpNorm_fourierInv_liftChiT_le (n : ℕ) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ (d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ),
      eLpNorm (𝓕⁻ (fun ξ => (liftChiT n d Ω p s ξ : ℂ))) 1 volume ≤ ENNReal.ofReal K := by
  obtain ⟨C, hC, h⟩ := exists_norm_fourierInv_liftChiT_le n
  have hE : 0 ≤ envelopeConst n := by unfold envelopeConst; positivity
  refine ⟨C * envelopeConst n, by positivity, fun d Ω p s => ?_⟩
  have hL := liftL_pos (n := n) (d := d) (Ω := Ω) (p := p) s
  obtain ⟨hi, hI⟩ := integrable_envelope_and_integral_le (n := n) hL
  have hmeas : AEStronglyMeasurable (𝓕⁻ (fun ξ => (liftChiT n d Ω p s ξ : ℂ))) volume := by
    have e : (fun ξ => (liftChiT n d Ω p s ξ : ℂ)) = ⇑(liftChiTSchwartz n d Ω p s) := rfl
    rw [e, ← SchwartzMap.fourierInv_coe]
    exact (𝓕⁻ (liftChiTSchwartz n d Ω p s)).continuous.aestronglyMeasurable
  refine (eLpNorm_mono_real (g := fun x => C * envelope n (liftL n d Ω p s) x) hmeas
      (h d Ω p s)).trans ?_
  rw [eLpNorm_one_eq_lintegral_enorm (hi.const_mul C).aestronglyMeasurable]
  rw [← ofReal_integral_norm_eq_lintegral_enorm (hi.const_mul C)]
  refine ENNReal.ofReal_le_ofReal ?_
  calc ∫ x, ‖C * envelope n (liftL n d Ω p s) x‖
      = ∫ x, C * envelope n (liftL n d Ω p s) x := by
        congr 1; funext x
        rw [Real.norm_of_nonneg (mul_nonneg hC (envelope_nonneg hL x))]
    _ ≤ C * envelopeConst n := by
        rw [integral_const_mul]; exact mul_le_mul_of_nonneg_left hI hC


open scoped Convolution ENNReal in
/-- Young for the cutoff: if `M` has Euclidean `L^P` multiplier norm `≤ A` on Schwartz inputs
(`1 ≤ P`), then so does `M χ̃_s`, with norm `≤ A K`, where `‖𝓕⁻ χ̃_s‖_{L¹} ≤ K`. -/
lemma eLpNorm_fourierInv_mul_liftChiT_le {s : ℕ} {K : ℝ}
    (hK : eLpNorm (𝓕⁻ (fun ξ => (liftChiT n d Ω p s ξ : ℂ))) 1 volume ≤ ENNReal.ofReal K)
    (hK0 : 0 ≤ K) {P : ℝ≥0∞} (hP : 1 ≤ P) {M : EuclideanSpace ℝ (Fin n) → ℂ} {A : ℝ}
    (hA : ∀ F : 𝓢(EuclideanSpace ℝ (Fin n), ℂ),
      eLpNorm (𝓕⁻ (fun ξ => M ξ * 𝓕 (F : EuclideanSpace ℝ (Fin n) → ℂ) ξ)) P volume ≤
        ENNReal.ofReal A * eLpNorm F P volume)
    (F : 𝓢(EuclideanSpace ℝ (Fin n), ℂ)) :
    eLpNorm (𝓕⁻ (fun ξ => (M ξ * (liftChiT n d Ω p s ξ : ℂ)) *
        𝓕 (F : EuclideanSpace ℝ (Fin n) → ℂ) ξ)) P volume ≤
      ENNReal.ofReal (A * K) * eLpNorm F P volume := by
  set φ : 𝓢(EuclideanSpace ℝ (Fin n), ℂ) := 𝓕⁻ (liftChiTSchwartz n d Ω p s) with hφ
  set G := SchwartzMap.convolution (ContinuousLinearMap.mul ℂ ℂ) φ F with hG
  have hGF : ∀ ξ, 𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ =
      (liftChiT n d Ω p s ξ : ℂ) * 𝓕 (F : EuclideanSpace ℝ (Fin n) → ℂ) ξ := by
    intro ξ
    have h := congrArg (fun H : 𝓢(EuclideanSpace ℝ (Fin n), ℂ) => H ξ)
      (SchwartzMap.fourier_convolution (ContinuousLinearMap.mul ℂ ℂ) φ F)
    simp only [SchwartzMap.pairing_apply_apply, hφ, FourierTransform.fourier_fourierInv_eq,
      ContinuousLinearMap.mul_apply', liftChiTSchwartz_apply] at h
    rw [← SchwartzMap.fourier_coe, h, SchwartzMap.fourier_coe]
  have e : (fun ξ => (M ξ * (liftChiT n d Ω p s ξ : ℂ)) *
      𝓕 (F : EuclideanSpace ℝ (Fin n) → ℂ) ξ) =
      fun ξ => M ξ * 𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ := by
    funext ξ; rw [hGF, mul_assoc]
  rw [e]
  refine (hA G).trans ?_
  have hGc : (G : EuclideanSpace ℝ (Fin n) → ℂ) =
      (φ : EuclideanSpace ℝ (Fin n) → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ, volume]
        (F : EuclideanSpace ℝ (Fin n) → ℂ) :=
    funext fun x => SchwartzMap.convolution_apply _ φ F x
  have hY := (young_convolution_euclidean hP (φ.memLp 1) (F.memLp P)).2.1
  have hφK : eLpNorm (φ : EuclideanSpace ℝ (Fin n) → ℂ) 1 volume ≤ ENNReal.ofReal K := by
    rw [hφ, SchwartzMap.fourierInv_coe]; exact hK
  rw [hGc, ENNReal.ofReal_mul' hK0, mul_assoc]
  gcongr
  exact hY.trans (by gcongr)

open scoped ENNReal in
/-- Lower Khintchine inequality for `L^p` norms (Blueprint Lemma 2.6): if every signed sum
`∑_ν ±g_ν` has `L^p` norm `≤ K` (`0 < p`), then `‖(∑_ν |g_ν|²)^{1/2}‖_p ≤ c_p⁻¹ K`. -/
lemma eLpNorm_sqrt_sum_le_of_rademacher {α : Type*} [MeasurableSpace α] {μ : Measure α}
    {ι : Type*} [DecidableEq ι] (F : Finset ι) (g : ι → α → ℂ)
    (hg : ∀ ν ∈ F, AEStronglyMeasurable (g ν) μ) {p : ℝ} (hp : 0 < p) {K : ℝ≥0∞}
    (h : ∀ u ∈ F.powerset, eLpNorm (fun x => rademacherSum F u (fun ν => g ν x))
      (ENNReal.ofReal p) μ ≤ K) :
    eLpNorm (fun x => Real.sqrt (∑ ν ∈ F, ‖g ν x‖ ^ 2)) (ENNReal.ofReal p) μ ≤
      ENNReal.ofReal (khintchineLowerConst p)⁻¹ * K := by
  set P := ENNReal.ofReal p
  have hP0 : P ≠ 0 := (ENNReal.ofReal_pos.mpr hp).ne'
  have hPtop : P ≠ ⊤ := ENNReal.ofReal_ne_top
  have hPr : P.toReal = p := ENNReal.toReal_ofReal hp.le
  have hc := khintchineLowerConst_pos p
  set c := khintchineLowerConst p
  set S := fun x => Real.sqrt (∑ ν ∈ F, ‖g ν x‖ ^ 2)
  have hSm : AEStronglyMeasurable S μ := aestronglyMeasurable_sqrt_sum_norm_sq F g hg
  have hRm : ∀ u, AEStronglyMeasurable (fun x => rademacherSum F u (fun ν => g ν x)) μ :=
    fun u => aestronglyMeasurable_rademacherSum F u g hg
  have hR : ∀ u ∈ F.powerset, ∫⁻ x, ‖rademacherSum F u (fun ν => g ν x)‖ₑ ^ p ∂μ ≤ K ^ p := by
    intro u hu
    have h1 := h u hu
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hP0 hPtop (hRm u), hPr] at h1
    have h2 := ENNReal.rpow_le_rpow h1 hp.le
    rwa [one_div, ENNReal.rpow_inv_rpow hp.ne'] at h2
  set N : ℝ≥0∞ := (2 ^ F.card : ℝ≥0∞)⁻¹
  have hcS : ∫⁻ x, (ENNReal.ofReal c * ‖S x‖ₑ) ^ p ∂μ ≤ K ^ p := by
    calc ∫⁻ x, (ENNReal.ofReal c * ‖S x‖ₑ) ^ p ∂μ
        ≤ ∫⁻ x, N * ∑ u ∈ F.powerset, ‖rademacherSum F u (fun ν => g ν x)‖ₑ ^ p ∂μ :=
          lintegral_mono fun x => khintchine_lower_enorm ℂ F (fun ν => g ν x) hp
      _ = N * ∑ u ∈ F.powerset, ∫⁻ x, ‖rademacherSum F u (fun ν => g ν x)‖ₑ ^ p ∂μ := by
          rw [lintegral_const_mul' _ _ (ENNReal.inv_ne_top.mpr (by positivity)),
            lintegral_finsetSum']
          intro u _
          exact (hRm u).enorm.pow_const p
      _ ≤ N * ∑ u ∈ F.powerset, K ^ p := by gcongr with u hu; exact hR u hu
      _ = K ^ p := by
          rw [Finset.sum_const, Finset.card_powerset, nsmul_eq_mul, ← mul_assoc]
          rw [show ((2 ^ F.card : ℕ) : ℝ≥0∞) = (2 : ℝ≥0∞) ^ F.card by push_cast; rfl]
          rw [ENNReal.inv_mul_cancel (by positivity) (by simp), one_mul]
  have hcS' : ENNReal.ofReal c * eLpNorm S P μ ≤ K := by
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hP0 hPtop hSm, hPr]
    have e : ENNReal.ofReal c = (ENNReal.ofReal c ^ p) ^ (1 / p) := by
      rw [one_div, ENNReal.rpow_rpow_inv hp.ne']
    rw [e, ← ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← lintegral_const_mul' _ _
      (ENNReal.rpow_ne_top_of_nonneg hp.le ENNReal.ofReal_ne_top)]
    have e2 : ∀ x, ENNReal.ofReal c ^ p * ‖S x‖ₑ ^ p = (ENNReal.ofReal c * ‖S x‖ₑ) ^ p :=
      fun x => (ENNReal.mul_rpow_of_nonneg _ _ hp.le).symm
    simp_rw [e2]
    calc (∫⁻ x, (ENNReal.ofReal c * ‖S x‖ₑ) ^ p ∂μ) ^ (1 / p) ≤ (K ^ p) ^ (1 / p) :=
          ENNReal.rpow_le_rpow hcS (by positivity)
      _ = K := by rw [one_div, ENNReal.rpow_rpow_inv hp.ne']
  have hc0 : ENNReal.ofReal c ≠ 0 := (ENNReal.ofReal_pos.mpr hc).ne'
  calc eLpNorm S P μ = (ENNReal.ofReal c)⁻¹ * (ENNReal.ofReal c * eLpNorm S P μ) := by
        rw [← mul_assoc, ENNReal.inv_mul_cancel hc0 ENNReal.ofReal_ne_top, one_mul]
    _ ≤ (ENNReal.ofReal c)⁻¹ * K := by gcongr
    _ = ENNReal.ofReal c⁻¹ * K := by rw [ENNReal.ofReal_inv_of_pos hc]

/-- `D_s` is linear in the symbol: `D_s[∑_ν c_ν m_ν] = ∑_ν c_ν D_s[m_ν]` (`s ≥ 1`). -/
lemma liftD_sum_smul {s : ℕ} (hs : 1 ≤ s) {ι : Type*} (F : Finset ι) (c : ι → ℂ)
    (m : ι → EuclideanSpace ℝ (Fin n) → ℂ) (ξ : EuclideanSpace ℝ (Fin n)) :
    liftD n d Ω p s (fun η => ∑ ν ∈ F, c ν * m ν η) ξ =
      ∑ ν ∈ F, c ν * liftD n d Ω p s (m ν) ξ := by
  have hgT : ∀ (M : EuclideanSpace ℝ (Fin n) → ℂ) η, M η * (liftChiT n d Ω p s η : ℂ) ≠ 0 →
      liftChiT n d Ω p s η ≠ 0 :=
    fun M η h h0 => h (by rw [h0, Complex.ofReal_zero, mul_zero])
  by_cases hact : ∃ β ∈ paramGoodSet n d Ω p (liftN s), ∃ z : Fin n → ℤ, liftChiT n d Ω p s
      (ξ - ratPt (blockProd (goodBlocks (paramRho n d Ω p) (liftN s))) β - latEmbed z) ≠ 0
  · obtain ⟨β, hβ, z, hz⟩ := hact
    simp only [liftD]
    rw [cosetSymbol_eq_of_liftChiT hs (hgT _) hβ hz, Finset.sum_mul]
    refine Finset.sum_congr rfl fun ν _ => ?_
    rw [cosetSymbol_eq_of_liftChiT hs (hgT _) hβ hz, mul_assoc]
  · push Not at hact
    simp only [liftD]
    rw [cosetSymbol_eq_zero_of_liftChiT (hgT _) hact]
    refine (Finset.sum_eq_zero fun ν _ => ?_).symm
    rw [cosetSymbol_eq_zero_of_liftChiT (hgT _) hact, mul_zero]

open scoped NNReal ENNReal in
/-- **Blueprint Lemma 9.3 (`lem:liftsquare`), eq. (9.10) (`eq:liftLpsquare`)**, the `ℓ^p` lifted
square estimate at the fixed exponent `p > 1` (with `r = paramR p`): for `n, d ≥ 1` there are
`δ_p > 0` and `C_p` (independent of `s`, of the family, of `A` and of `f`) such that for every
`s ≥ 1`, every finite family `(m_ν)_{ν ∈ F}` of bounded a.e. strongly measurable symbols such that
every signed sum `∑_ν ε_ν m_ν` (`ε_ν ∈ {-1, 1}`) has Euclidean `L^{2r}` multiplier norm at most
`A ≥ 0` (on Schwartz inputs), and every finitely supported `f`,
`‖(∑_ν sup_{α ∈ 𝓡_s} |Lift_{s,α}[m_ν](D) f|²)^{1/2}‖_p ≤ C_p 2^{-δ_p s} A ‖f‖_p`. -/
theorem lift_square_p (n d : ℕ) (hn : 1 ≤ n) (hd : 1 ≤ d) (Ω : EuclideanSpace ℝ (Fin n) → ℂ)
    {p : ℝ} (hp : 1 < p) :
    ∃ δ : ℝ, 0 < δ ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ s : ℕ, 1 ≤ s →
      ∀ {ι : Type*} (F : Finset ι) (m : ι → EuclideanSpace ℝ (Fin n) → ℂ) (B A : ℝ),
        (∀ ν ∈ F, AEStronglyMeasurable (m ν) volume) → (∀ ν ∈ F, ∀ η, ‖m ν η‖ ≤ B) →
        0 ≤ A →
        (∀ ε : ι → ℝ, (∀ ν ∈ F, ε ν = 1 ∨ ε ν = -1) →
          ∀ G : 𝓢(EuclideanSpace ℝ (Fin n), ℂ),
            eLpNorm (𝓕⁻ (fun ξ => (∑ ν ∈ F, (ε ν : ℂ) * m ν ξ) *
                𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ))
              (ENNReal.ofReal (2 * paramR p)) volume ≤
            ENNReal.ofReal A * eLpNorm G (ENNReal.ofReal (2 * paramR p)) volume) →
        ∀ f : (Fin n → ℤ) → ℂ, (Function.support f).Finite →
          eLpNorm (fun x => Real.sqrt (∑ ν ∈ F,
              ((((liftRat s).sup fun aq =>
                ‖latMult (liftSym n d Ω p s aq.1 aq.2 (m ν)) f x‖₊ : ℝ≥0) : ℝ) ^ 2)))
              (ENNReal.ofReal p) Measure.count ≤
            ENNReal.ofReal (C * (2 : ℝ) ^ (-(δ * s)) * A) *
              eLpNorm f (ENNReal.ofReal p) Measure.count := by
  obtain ⟨δ, hδ, Cv, hCv, hv⟩ := arith_maximal_decay_vector_bdd n d hn hd hp
  obtain ⟨CT, hCT, hT⟩ := lift_transference n d Ω hp
  obtain ⟨K, hK0, hKb⟩ := exists_eLpNorm_fourierInv_liftChiT_le n
  have hc := khintchineLowerConst_pos p
  set c := khintchineLowerConst p
  refine ⟨δ, hδ, Cv * (c⁻¹ * (CT * K)), by positivity,
    fun s hs ι F m B A hm hmB hA0 hA f hf => ?_⟩
  classical
  have hf1 : Summable fun z => ‖f z‖ := summable_of_finite_support hf
  obtain ⟨M, hM⟩ := exists_bound_latMult_liftD (d := d) (Ω := Ω) (p := p) (s := s) F hm hmB hf1
  set g : ι → (Fin n → ℤ) → ℂ := fun ν => latMult (liftD n d Ω p s (m ν)) f with hg
  rw [lift_sqrt_sum_eq hs F hm hmB hf1]
  refine (hv Ω p s hs F g M hM).trans ?_
  have hP : (1 : ℝ≥0∞) ≤ ENNReal.ofReal (2 * paramR p) := by
    rw [← ENNReal.ofReal_one]
    refine ENNReal.ofReal_le_ofReal ?_
    have := one_le_paramR p
    have : (1 : ℝ) ≤ paramR p := by exact_mod_cast this
    linarith
  have hsq : eLpNorm (fun x => Real.sqrt (∑ ν ∈ F, ‖g ν x‖ ^ 2)) (ENNReal.ofReal p)
      Measure.count ≤ ENNReal.ofReal c⁻¹ *
        (ENNReal.ofReal (CT * (A * K)) * eLpNorm f (ENNReal.ofReal p) Measure.count) := by
    refine eLpNorm_sqrt_sum_le_of_rademacher F g (fun _ _ => AEStronglyMeasurable.of_discrete)
      (by linarith) fun u _ => ?_
    set ε : ι → ℝ := fun ν => if ν ∈ u then 1 else -1 with hε
    set Mu : EuclideanSpace ℝ (Fin n) → ℂ := fun η => ∑ ν ∈ F, (ε ν : ℂ) * m ν η with hMu
    have hmi : ∀ ν ∈ F, IntegrableOn (liftD n d Ω p s (m ν)) (torusCube n) :=
      fun ν hν => integrableOn_liftD (hm ν hν) (hmB ν hν)
    have e : (fun x => rademacherSum F u (fun ν => g ν x)) =
        cosetMult (blockProd (goodBlocks (paramRho n d Ω p) (liftN s)))
          (fun η => Mu η * (liftChiT n d Ω p s η : ℂ)) (paramGoodSet n d Ω p (liftN s)) f := by
      funext x
      have h1 : rademacherSum F u (fun ν => g ν x) = ∑ ν ∈ F, (ε ν : ℂ) * g ν x := by
        unfold rademacherSum
        refine Finset.sum_congr rfl fun ν _ => ?_
        by_cases h : ν ∈ u <;> simp [hε, h]
      rw [h1, cosetMult]
      have h2 := latMult_sum_mul F (fun ν => (ε ν : ℂ)) hmi hf1 x
      rw [← h2]
      congr 1
      funext ξ
      exact (liftD_sum_smul hs F (fun ν => (ε ν : ℂ)) m ξ).symm
    rw [e]
    have hMum : AEStronglyMeasurable (fun η => Mu η * (liftChiT n d Ω p s η : ℂ)) volume :=
      (Finset.aestronglyMeasurable_fun_sum F fun ν hν =>
        (hm ν hν).const_mul _).mul (continuous_liftChiT s).aestronglyMeasurable
    have hMuB : ∀ ξ, ‖Mu ξ * (liftChiT n d Ω p s ξ : ℂ)‖ ≤ F.card * B := by
      intro ξ
      rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (liftChiT_nonneg s ξ)]
      refine (mul_le_of_le_one_right (norm_nonneg _) (liftChiT_le_one s ξ)).trans ?_
      refine (norm_sum_le _ _).trans ?_
      rw [← nsmul_eq_mul, ← Finset.sum_const]
      refine Finset.sum_le_sum fun ν hν => ?_
      rw [norm_mul]
      have : ‖(ε ν : ℂ)‖ = 1 := by by_cases h : ν ∈ u <;> simp [hε, h]
      rw [this, one_mul]; exact hmB ν hν ξ
    have hsupp : Function.support (fun η => Mu η * (liftChiT n d Ω p s η : ℂ)) ⊆
        {ξ | ∀ i, |ξ i| ≤ 2 / (liftL n d Ω p s : ℝ)} := fun ξ hξ =>
      support_liftChiT s fun h0 => hξ (by simp [h0])
    have hmult := fun G => eLpNorm_fourierInv_mul_liftChiT_le (hKb d Ω p s) hK0 hP
      (hA ε fun ν _ => by by_cases h : ν ∈ u <;> simp [hε, h]) G
    exact hT s hs _ _ _ hMum hMuB hsupp hmult f hf
  calc ENNReal.ofReal (Cv * (2 : ℝ) ^ (-(δ * s))) *
        eLpNorm (fun x => Real.sqrt (∑ ν ∈ F, ‖g ν x‖ ^ 2)) (ENNReal.ofReal p) Measure.count
      ≤ ENNReal.ofReal (Cv * (2 : ℝ) ^ (-(δ * s))) * (ENNReal.ofReal c⁻¹ *
        (ENNReal.ofReal (CT * (A * K)) * eLpNorm f (ENNReal.ofReal p) Measure.count)) := by
        gcongr
    _ = _ := by
        rw [← mul_assoc, ← mul_assoc, ← ENNReal.ofReal_mul (by positivity),
          ← ENNReal.ofReal_mul (by positivity)]
        congr 2
        ring


/-! ### Blueprint Lemma 9.4 (`lem:liftenvelope`): positive envelopes for lifted kernels -/

lemma hasCompactSupport_liftChi (s : ℕ) :
    HasCompactSupport fun ξ : EuclideanSpace ℝ (Fin n) => (liftChi n d Ω p s ξ : ℂ) :=
  HasCompactSupport.intro (isCompact_box (1 / (liftL n d Ω p s : ℝ))) fun ξ hξ => by
    by_contra h
    exact hξ (support_liftChi s (fun h0 => h (by simp [h0])))

/-- `χ_s` as a (complex-valued) Schwartz function. -/
noncomputable def liftChiSchwartz (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ)
    (s : ℕ) : 𝓢(EuclideanSpace ℝ (Fin n), ℂ) :=
  (hasCompactSupport_liftChi (n := n) (d := d) (Ω := Ω) (p := p) s).toSchwartzMap
    (Complex.ofRealCLM.contDiff.comp
      (contDiff_liftCutoff.comp (contDiff_const_smul (liftL n d Ω p s : ℝ))))

@[simp] lemma liftChiSchwartz_apply (s : ℕ) (ξ : EuclideanSpace ℝ (Fin n)) :
    liftChiSchwartz n d Ω p s ξ = (liftChi n d Ω p s ξ : ℂ) := rfl

/-- `𝓕 H` is continuous and bounded by `‖H‖_{L¹}` for integrable `H`. -/
lemma continuous_fourier_and_norm_le {H : EuclideanSpace ℝ (Fin n) → ℂ} (hH : Integrable H) :
    Continuous (𝓕 H) ∧ ∀ ξ, ‖𝓕 H ξ‖ ≤ ∫ x, ‖H x‖ := by
  refine ⟨VectorFourier.fourierIntegral_continuous Real.continuous_fourierChar continuous_inner hH,
    fun ξ => ?_⟩
  rw [fourier_eq_integral_eC]
  refine (norm_integral_le_integral_norm _).trans (le_of_eq ?_)
  congr 1; funext x; rw [norm_mul, norm_eC, one_mul]

open scoped Convolution in
/-- The Euclidean kernel of `𝓕H · χ_s` is `H * φ_s` (`H` integrable). -/
lemma fourierInv_fourier_mul_liftChi {H : EuclideanSpace ℝ (Fin n) → ℂ} (hH : Integrable H)
    (s : ℕ) :
    𝓕⁻ (fun ξ => 𝓕 H ξ * (liftChi n d Ω p s ξ : ℂ)) =
      H ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] liftPhi n d Ω p s := by
  set f : 𝓢(EuclideanSpace ℝ (Fin n), ℂ) := 𝓕⁻ (liftChiSchwartz n d Ω p s) with hf
  have hff : 𝓕 (f : EuclideanSpace ℝ (Fin n) → ℂ) = fun ξ => (liftChi n d Ω p s ξ : ℂ) := by
    rw [← SchwartzMap.fourier_coe, hf, FourierTransform.fourier_fourierInv_eq]; rfl
  have hfφ : (f : EuclideanSpace ℝ (Fin n) → ℂ) = liftPhi n d Ω p s := by
    rw [hf, SchwartzMap.fourierInv_coe]; rfl
  have h := fourierInv_fourier_mul_eq_convolution hH (continuous_fourier_and_norm_le hH).2 f
  rw [hff, hfφ] at h
  exact h

open scoped Convolution in
/-- Envelope bound for the kernel: if `|H| ≤ K B_R` (`R > 0`), then
`|H * φ_s| ≤ C K B_{max(R, L_s)}` with `C` depending only on `n`. -/
lemma exists_norm_convolution_liftPhi_le (n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ)
      (H : EuclideanSpace ℝ (Fin n) → ℂ) (K R : ℝ), 0 < R → 0 ≤ K →
      (∀ z, ‖H z‖ ≤ K * envelope n R z) → ∀ y : EuclideanSpace ℝ (Fin n),
        ‖(H ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] liftPhi n d Ω p s) y‖ ≤
          C * K * envelope n (max R (liftL n d Ω p s)) y := by
  obtain ⟨Cφ, hCφ, hφ⟩ := norm_liftPhi_le n
  have hcc : 0 ≤ envelopeConvConst n := by
    unfold envelopeConvConst envelopeConst; positivity
  refine ⟨Cφ * envelopeConvConst n, by positivity, fun d Ω p s H K R hR hK hHK y => ?_⟩
  have hL := liftL_pos (n := n) (d := d) (Ω := Ω) (p := p) s
  obtain ⟨hi, hI⟩ := envelope_conv_le (n := n) hL hR y
  rw [MeasureTheory.convolution_def]
  refine (norm_integral_le_integral_norm _).trans ?_
  calc ∫ t, ‖(ContinuousLinearMap.mul ℂ ℂ) (H t) (liftPhi n d Ω p s (y - t))‖
      ≤ ∫ t, K * Cφ * (envelope n (liftL n d Ω p s) (y - t) * envelope n R t) := by
        refine integral_mono_of_nonneg (Filter.Eventually.of_forall fun _ => norm_nonneg _)
          (hi.const_mul _) (Filter.Eventually.of_forall fun t => ?_)
        simp only [ContinuousLinearMap.mul_apply', norm_mul]
        calc ‖H t‖ * ‖liftPhi n d Ω p s (y - t)‖
            ≤ (K * envelope n R t) * (Cφ * envelope n (liftL n d Ω p s) (y - t)) :=
              mul_le_mul (hHK t) ((hφ d Ω p s).1 _) (norm_nonneg _)
                (mul_nonneg hK (envelope_nonneg hR _))
          _ = _ := by ring
    _ = K * Cφ * ∫ t, envelope n (liftL n d Ω p s) (y - t) * envelope n R t :=
        integral_const_mul _ _
    _ ≤ K * Cφ * (envelopeConvConst n * envelope n (max (liftL n d Ω p s : ℝ) R) y) :=
        mul_le_mul_of_nonneg_left hI (by positivity)
    _ = Cφ * envelopeConvConst n * K * envelope n (max R (liftL n d Ω p s)) y := by
        rw [max_comm]; ring

/-- `1 ≤ L_s`. -/
lemma one_le_liftL (s : ℕ) : (1 : ℝ) ≤ liftL n d Ω p s := by
  have := eight_le_liftL (n := n) (d := d) (Ω := Ω) (p := p) s
  linarith


/-- `B_R * |f| ≤ C_n 𝖬 f` in the form used below: for `R ≥ 1`, `f ∈ ℓ¹` and `x`,
`ofReal (∑_y B_R(y) |f(x - y)|) ≤ C_n 𝖬 f(x)`. -/
lemma ofReal_tsum_latEnvelope_mul_le {R : ℝ} (hR : 1 ≤ R) {f : (Fin n → ℤ) → ℂ}
    (hf : Summable fun z => ‖f z‖) (x : Fin n → ℤ) :
    ENNReal.ofReal (∑' y, latEnvelope n R y * ‖f (x - y)‖) ≤
      ENNReal.ofReal (envelopeConst n) * cubeMaximalInt n f x := by
  obtain ⟨hsE, -⟩ := summable_latEnvelope_and_tsum_le (n := n) hR
  have hfb : ∀ z, ‖f z‖ ≤ ∑' z, ‖f z‖ := fun z => hf.le_tsum z fun _ _ => norm_nonneg _
  have hs2 : Summable fun y => latEnvelope n R y * ‖f (x - y)‖ :=
    Summable.of_nonneg_of_le
      (fun y => mul_nonneg (envelope_nonneg (by linarith) _) (norm_nonneg _))
      (fun y => mul_le_mul_of_nonneg_left (hfb _) (envelope_nonneg (by linarith) _))
      (hsE.mul_right _)
  refine le_trans (le_of_eq ((ENNReal.ofReal_tsum_of_nonneg
    (fun y => mul_nonneg (envelope_nonneg (by linarith) _) (norm_nonneg _)) hs2).trans
      (tsum_congr fun y => ?_))) (tsum_envelope_mul_le_cubeMaximalInt hR f x)
  rw [ENNReal.ofReal_mul (envelope_nonneg (by linarith) _), ofReal_norm]
  rfl

/-- The pointwise envelope bound for lifted symbols `𝓕 H` (the proof of Blueprint Lemma 9.4
(`lem:liftenvelope`), for general kernels): there is `C` depending only on `n` such that, if `H`
is integrable with `|H| ≤ K B_R` (`K ≥ 0`, `R > 0`), then for all `s`, `a`, `q ≥ 1`, `f ∈ ℓ¹`
and `x ∈ ℤⁿ`, `|Lift_{s,a/q}[𝓕 H](D) f(x)| ≤ C K ∑_y B_{max(R, L_s)}(y) |f(x - y)|`
(the lattice kernel is `e((a/q) P(y)) (H *_E φ_s)(y)` by Lemma 9.1). -/
theorem norm_latMult_liftSym_fourier_le (n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s a q : ℕ), 1 ≤ q →
      ∀ (H : EuclideanSpace ℝ (Fin n) → ℂ) (K R : ℝ), Integrable H → 0 < R → 0 ≤ K →
      (∀ z, ‖H z‖ ≤ K * envelope n R z) →
      ∀ f : (Fin n → ℤ) → ℂ, Summable (fun z => ‖f z‖) → ∀ x : Fin n → ℤ,
        ‖latMult (liftSym n d Ω p s a q (𝓕 H)) f x‖ ≤
          C * K * ∑' y, latEnvelope n (max R (liftL n d Ω p s)) y * ‖f (x - y)‖ := by
  obtain ⟨C, hC, hconv⟩ := exists_norm_convolution_liftPhi_le n
  refine ⟨C, hC, fun d Ω p s a q hq H K R hH hR hK hHK f hf x => ?_⟩
  obtain ⟨hFc, hFb⟩ := continuous_fourier_and_norm_le hH
  set R' := max R (liftL n d Ω p s : ℝ) with hR'def
  have hR' : 1 ≤ R' := le_max_of_le_right (one_le_liftL s)
  have hint : IntegrableOn (liftSym n d Ω p s a q (𝓕 H)) (torusCube n) :=
    integrableOn_liftSym (integrable_mul_liftChi hFc.aestronglyMeasurable (fun ξ _ => hFb ξ))
  have hker : ∀ y, ‖latKernel (liftSym n d Ω p s a q (𝓕 H)) y‖ ≤
      C * K * latEnvelope n R' y := by
    intro y
    rw [latKernel_liftSym_of_bdd s a hq hFc.aestronglyMeasurable (fun ξ _ => hFb ξ) y, norm_mul,
      norm_eC, one_mul, fourierInv_fourier_mul_liftChi hH]
    exact hconv d Ω p s H K R hR hK hHK _
  obtain ⟨hsE, -⟩ := summable_latEnvelope_and_tsum_le (n := n) hR'
  have hfb : ∀ z, ‖f z‖ ≤ ∑' z, ‖f z‖ := fun z => hf.le_tsum z fun _ _ => norm_nonneg _
  have hs2 : Summable fun y => latEnvelope n R' y * ‖f (x - y)‖ :=
    Summable.of_nonneg_of_le
      (fun y => mul_nonneg (envelope_nonneg (by linarith) _) (norm_nonneg _))
      (fun y => mul_le_mul_of_nonneg_left (hfb _) (envelope_nonneg (by linarith) _))
      (hsE.mul_right _)
  have hs3 : Summable fun y => C * K * latEnvelope n R' y * ‖f (x - y)‖ :=
    (hs2.mul_left (C * K)).congr fun y => by ring
  have hs1 : Summable fun y => ‖latKernel (liftSym n d Ω p s a q (𝓕 H)) y * f (x - y)‖ :=
    Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun y => by
      rw [norm_mul]; exact mul_le_mul_of_nonneg_right (hker y) (norm_nonneg _)) hs3
  rw [latMult_eq_latConv hint hf, latConv]
  calc ‖∑' y, latKernel (liftSym n d Ω p s a q (𝓕 H)) y * f (x - y)‖
      ≤ ∑' y, ‖latKernel (liftSym n d Ω p s a q (𝓕 H)) y * f (x - y)‖ :=
        norm_tsum_le_tsum_norm hs1
    _ ≤ ∑' y, C * K * latEnvelope n R' y * ‖f (x - y)‖ :=
        hs1.tsum_le_tsum (fun y => by
          rw [norm_mul]; exact mul_le_mul_of_nonneg_right (hker y) (norm_nonneg _)) hs3
    _ = C * K * ∑' y, latEnvelope n R' y * ‖f (x - y)‖ := by
        rw [← tsum_mul_left]; exact tsum_congr fun y => by ring

/-- `|e(μ P) K_j| ≤ C B_{2^j}` uniformly in `j ∈ ℤ` and `μ ∈ ℝ` (Lemma 4.1 and the support of
`K_j` in `|x| < 2^{j+1}`). -/
lemma exists_norm_oscKernel_le {Ω : EuclideanSpace ℝ (Fin n) → ℂ} (hΩ : IsSWProfile Ω) (d : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (j : ℤ) (μ : ℝ) (x : EuclideanSpace ℝ (Fin n)),
      ‖eC (μ * radialPoly n d x) * dyadicKernel Ω j x‖ ≤
        C * envelope n ((2 : ℝ) ^ j) x := by
  obtain ⟨C, hC, hK⟩ := norm_dyadicKernel_le hΩ
  refine ⟨C * 3 ^ (n + 1), by positivity, fun j μ x => ?_⟩
  rw [norm_mul, norm_eC, one_mul]
  have h2 : (0 : ℝ) < 2 ^ j := by positivity
  by_cases hx : dyadicKernel Ω j x = 0
  · rw [hx, norm_zero]
    exact mul_nonneg (by positivity) (envelope_nonneg h2 _)
  have hsupp := (support_dyadicKernel (Ω := Ω) j hx).2
  have hlt : ‖x‖ / 2 ^ j < 2 := by
    rw [div_lt_iff₀ h2]
    calc ‖x‖ < 2 ^ (j + 1) := hsupp
      _ = 2 * 2 ^ j := by rw [zpow_add_one₀ two_ne_zero]; ring
  have hz : (2 : ℝ) ^ (-j * (n : ℤ)) = (((2 : ℝ) ^ j) ^ n)⁻¹ := by
    rw [← zpow_natCast, ← zpow_mul, neg_mul, zpow_neg]
  have h3 : ((1 + ‖x‖ / 2 ^ j) ^ (n + 1))⁻¹ ≥ ((3 : ℝ) ^ (n + 1))⁻¹ := by
    have h0 : 0 ≤ ‖x‖ / 2 ^ j := by positivity
    exact inv_anti₀ (by positivity) (pow_le_pow_left₀ (by positivity) (by linarith) _)
  calc ‖dyadicKernel Ω j x‖ ≤ C * (2 : ℝ) ^ (-j * (n : ℤ)) := hK j x
    _ = C * 3 ^ (n + 1) * ((((2 : ℝ) ^ j) ^ n)⁻¹ * ((3 : ℝ) ^ (n + 1))⁻¹) := by
        rw [hz]; field_simp
    _ ≤ C * 3 ^ (n + 1) * ((((2 : ℝ) ^ j) ^ n)⁻¹ * ((1 + ‖x‖ / 2 ^ j) ^ (n + 1))⁻¹) := by
        gcongr
    _ = C * 3 ^ (n + 1) * envelope n ((2 : ℝ) ^ j) x := rfl

/-- `e(μ P) K_j` is integrable. -/
lemma integrable_oscKernel {Ω : EuclideanSpace ℝ (Fin n) → ℂ} (hΩ : IsSWProfile Ω) (d : ℕ)
    (j : ℤ) (μ : ℝ) :
    Integrable fun x : EuclideanSpace ℝ (Fin n) =>
      eC (μ * radialPoly n d x) * dyadicKernel Ω j x := by
  have hc : Continuous fun x : EuclideanSpace ℝ (Fin n) => eC (μ * radialPoly n d x) := by
    unfold radialPoly; fun_prop
  refine Integrable.mono' (integrable_dyadicKernel hΩ j).norm
    (hc.aestronglyMeasurable.mul (integrable_dyadicKernel hΩ j).aestronglyMeasurable)
    (Filter.Eventually.of_forall fun x => ?_)
  rw [norm_mul, norm_eC, one_mul]

/-- **Blueprint Lemma 9.4 (`lem:liftenvelope`)**, positive envelopes for lifted annular kernels:
for a Stein–Wainger profile `Ω` and `d`, there is `C` (independent of `p`, `s`, `j`, `μ`, `α` and
`f`) such that for every `j ∈ ℤ` (in particular every `j ≥ 1`), every real `μ`, every
`α = a/q` with `q ≥ 1` (in particular every `α ∈ 𝓡_s`), every `f ∈ ℓ¹(ℤⁿ)` (e.g. finitely
supported) and every `x ∈ ℤⁿ`,
`|Lift_{s,α}[Φ_{j,μ}](D) f(x)| ≤ C (B_{max(2^j, L_s)} * |f|)(x) ≤ C C_n 𝖬 f(x)`,
where `Φ_{j,μ} = radialOscPhi Ω d j μ`, `B_R` is the envelope and `𝖬 = cubeMaximalInt`. -/
theorem lift_envelope (n d : ℕ) {Ω : EuclideanSpace ℝ (Fin n) → ℂ} (hΩ : IsSWProfile Ω) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (p : ℝ) (s : ℕ) (j : ℤ) (μ : ℝ) (a q : ℕ), 1 ≤ q →
      ∀ f : (Fin n → ℤ) → ℂ, Summable (fun z => ‖f z‖) → ∀ x : Fin n → ℤ,
        ‖latMult (liftSym n d Ω p s a q (radialOscPhi Ω d j μ)) f x‖ ≤
            C * ∑' y, latEnvelope n (max ((2 : ℝ) ^ j) (liftL n d Ω p s)) y * ‖f (x - y)‖ ∧
          ‖latMult (liftSym n d Ω p s a q (radialOscPhi Ω d j μ)) f x‖ₑ ≤
            ENNReal.ofReal (C * envelopeConst n) * cubeMaximalInt n f x := by
  obtain ⟨C₁, hC₁, h₁⟩ := norm_latMult_liftSym_fourier_le n
  obtain ⟨C₂, hC₂, h₂⟩ := exists_norm_oscKernel_le hΩ d
  refine ⟨C₁ * C₂, by positivity, fun p s j μ a q hq f hf x => ?_⟩
  have hR : (0 : ℝ) < 2 ^ j := by positivity
  have h := h₁ d Ω p s a q hq _ C₂ _ (integrable_oscKernel hΩ d j μ) hR hC₂
    (fun z => h₂ j μ z) f hf x
  have e : radialOscPhi Ω d j μ = 𝓕 fun x => eC (μ * radialPoly n d x) * dyadicKernel Ω j x := by
    funext ξ; rfl
  rw [← e] at h
  refine ⟨h, ?_⟩
  have hR' : 1 ≤ max ((2 : ℝ) ^ j) (liftL n d Ω p s) := le_max_of_le_right (one_le_liftL s)
  rw [← ofReal_norm]
  refine (ENNReal.ofReal_le_ofReal h).trans ?_
  have hS0 : 0 ≤ ∑' y, latEnvelope n (max ((2 : ℝ) ^ j) (liftL n d Ω p s)) y * ‖f (x - y)‖ :=
    tsum_nonneg fun y => mul_nonneg (envelope_nonneg (by linarith) _) (norm_nonneg _)
  rw [ENNReal.ofReal_mul (by positivity)]
  refine (mul_le_mul' le_rfl (ofReal_tsum_latEnvelope_mul_le hR' hf x)).trans (le_of_eq ?_)
  rw [← mul_assoc, ← ENNReal.ofReal_mul (by positivity)]

open scoped ENNReal in
/-- **Blueprint Lemma 9.4 (`lem:liftenvelope`)**, the supremum over all indices at fixed `s`:
with `C` from `lift_envelope`, for every `f ∈ ℓ¹` and `x`,
`sup_{j, μ, α ∈ 𝓡_s} |Lift_{s,α}[Φ_{j,μ}](D) f(x)| ≤ C C_n 𝖬 f(x)`. -/
theorem lift_envelope_sup (n d : ℕ) {Ω : EuclideanSpace ℝ (Fin n) → ℂ} (hΩ : IsSWProfile Ω) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (p : ℝ) (s : ℕ) (f : (Fin n → ℤ) → ℂ), Summable (fun z => ‖f z‖) →
      ∀ x : Fin n → ℤ,
        (⨆ (j : ℤ) (μ : ℝ) (aq ∈ liftRat s),
          ‖latMult (liftSym n d Ω p s aq.1 aq.2 (radialOscPhi Ω d j μ)) f x‖ₑ) ≤
            ENNReal.ofReal (C * envelopeConst n) * cubeMaximalInt n f x := by
  obtain ⟨C, hC, h⟩ := lift_envelope n d hΩ
  refine ⟨C, hC, fun p s f hf x => iSup_le fun j => iSup_le fun μ => iSup₂_le fun aq haq => ?_⟩
  exact (h p s j μ aq.1 aq.2 (one_le_of_mem_liftRat (a := aq.1) (by simpa using haq)) f hf x).2

end Lifting

section Truncation

/-!
## Lifted maximal truncations

Results from §10 ("Lifted maximal truncations") of `blueprints/discrete-sw.tex`: Blueprint
Lemma 10.1 (`lem:lifttrunc`, "The unmodulated lifted maximal truncation"), namely the choice of
the long threshold, the short range, the long range decomposition, the bounds for all long range
pieces (including the long smooth maximum of `τ_J m_K`, via the averaging argument), and
eq. (10.1) itself (`lift_trunc`).

### Conventions

Mathlib Fourier sign, lattice conventions of section `Sampling`, and the §9 setup of
section `Lifting` (`liftSym … s a q m = Lift_{s,a/q}[m]`, `liftRat s = 𝓡_s`,
`liftN s = N_s = 2^s`, `liftV = v_s`). `K_j = dyadicKernel Ω j`, `m_K = dyadicSymbol Ω`,
`τ_J = bpTau J`, `E_J = smoothErr Ω J`. The truncation index `J` ranges over `ℕ` (`J ≥ 1`).

### Definitions

* `truncQ s = Q_s = lcm(1, …, N_s - 1)`; `truncC1 = C₁ = n + 2⌈C_*⌉ + 13` (irreducible);
  `truncJ … s = J_s = 2^{C₁(s+1)}`;
* `truncSym Ω J = ∑_{1 ≤ j < J} 𝓕 K_j`; `binBlock l k = I_{l,k}` (the blocks of Lemma 2.7).

### Results

* eq. (10.2) (`eq:longthreshold`): `truncQ_le` (`Q_s ≤ N^N`), `truncQ_le_two_pow`,
  `logb_truncQ_le` (`log₂ Q_s ≤ s 2^s`), `dvd_truncQ`, `truncJ_spec` and `exists_truncC1`
  (`J_s ≥ v_s + 10`, `√n Q_s ≤ 2^{J_s-3}`, `N^{n+2} Q_s 2^{-J_s} ≤ 2^{-10s}`);
* linearity of the lifting in the symbol: `liftSym_sum_mul`, `latMult_liftSym_sum_mul`,
  `latMult_liftSym_sub`;
* Euclidean multiplier forms of Lemmas 4.3 and 4.5 on Schwartz inputs:
  `eLpNorm_fourierInv_sum_fourier_dyadicKernel_le`,
  `eLpNorm_fourierInv_sum_fourier_smoothErr_le`;
* the short range: `lift_trunc_short`
  (`‖sup_{α, 1 ≤ J ≤ J_s} |Lift[∑_{j<J} 𝓕K_j](D) f|‖_p ≤ C (s+1) 2^{-δs} ‖f‖_p`, via Lemma 2.7
  with the supremum in `α` inside every block square and eq. (9.10) on each binary level);
* the long range decomposition: `truncSym_decomp` (`∑_{j<J} 𝓕K_j = m_K - m_{≥J}`,
  `m_{≥J} = τ_J m_K + Ê_J`) and `truncSym_eq_sub`;
* the long range bounds: `lift_dyadicSymbol_bound` (whole multiplier), `lift_smoothErr_finset`
  and `lift_smoothErr_sup` (smoothing errors, finite `J` sets and all `J ≥ 1`);
* `lift_trunc_of_long`: eq. (10.1) follows from the remaining bound
  `‖sup_{α, J > J_s} |Lift[τ_J m_K](D) f|‖_p ≤ C' 2^{-δ' s} ‖f‖_p` (the long smooth maximum);
* the long smooth maximum `lift_trunc_long`, with ingredients: the expansion
  `Lift_{s,a/q}[m](D) f = ∑_b S(a/q,b/q) M_{b/q} (m χ_s)_per(D) M_{-b/q} f`
  (`latMult_liftSym_eq_sum`), products of periodizations (`periodize_mul_eq`), `τ_J` as
  convolution with the sampled `φ_J` (`latMult_periodize_bpTau_mul`), eq. (10.3) at `u = 0`
  (`latMult_liftSym_bpTau_eq`: `Lift[τ_J m_K](D) f(x) = ∑_y φ_J(y) H_{α,x}(x - y)`) and the inner
  identity `Lift[e(-u · ξ) m_K](D) f(x) = H_{α,x}(x - u)` (`latMult_liftSym_eC_eq`), where
  `G_β = K_s M_{-β} f` (`truncG`, `K_s = (m_K χ_s)_per(D)`, `truncKs`) and
  `H_{α,v} = ∑_β S(α,β) e(v · β) G_β` (`truncH`); the translation bound for `φ_J`
  (`exists_norm_bpPhiDil_sub_le`); `K_s` bounded on `ℓ^p` (`truncKs_bound`); the one-element
  lifted estimate for `e(-u · ξ) m_K` uniformly in `u` (`lift_eC_dyadicSymbol_bound`); the
  pointwise main term / shift error bound (`lift_trunc_long_pointwise`); the change of variables
  over `𝒱_s = {0, …, Q_s - 1}ⁿ` (`sum_tsum_sub_finIntVec_eq`) and the averaging argument
  (`exists_shift_eLpNorm_cubeMaximalInt_le`);
* `lift_trunc`: eq. (10.1) (`eq:lifttrunc`).

The Mathlib sign convention turns the blueprint's `e(u · ξ)` into `e(-u · ξ)` and the blueprint's
`e(-β · x)` into `e(x · β)`. Instead of Minkowski over the averaging space, the proof uses a shift
`u ∈ 𝒱_s` whose shifted main term is at most the average (which gives the same bound).
-/

open MeasureTheory Set Real Finset
open scoped FourierTransform ContDiff SchwartzMap ENNReal NNReal Convolution

variable {n d : ℕ} {Ω : EuclideanSpace ℝ (Fin n) → ℂ} {p : ℝ}

/-! ### The long threshold `J_s` (eq. (10.2), `eq:longthreshold`) -/

/-- `Q_s = lcm(1, …, N_s - 1)` of Blueprint Lemma 10.1 (`lem:lifttrunc`), `N_s = 2^s`. -/
def truncQ (s : ℕ) : ℕ := (Finset.Ico 1 (liftN s)).lcm id

/-- Every `1 ≤ q < N_s` divides `Q_s`. -/
lemma dvd_truncQ {s q : ℕ} (h1 : 1 ≤ q) (h2 : q < liftN s) : q ∣ truncQ s :=
  Finset.dvd_lcm (f := id) (Finset.mem_Ico.2 ⟨h1, h2⟩)

/-- `Q_s ≥ 1`. -/
lemma truncQ_pos (s : ℕ) : 0 < truncQ s := by
  refine Nat.pos_of_ne_zero fun h => ?_
  rw [truncQ, Finset.lcm_eq_zero_iff] at h
  obtain ⟨q, hq, hq0⟩ := h
  have := (Finset.mem_Ico.1 hq).1
  simp only [id] at hq0
  omega

/-- Blueprint Lemma 10.1 (`lem:lifttrunc`), proof: `Q_s ≤ ∏_{1 ≤ q < N} q ≤ N^N` (`N = N_s`). -/
theorem truncQ_le (s : ℕ) : truncQ s ≤ liftN s ^ liftN s := by
  have hN : 1 ≤ liftN s := Nat.one_le_two_pow
  have h1 : truncQ s ∣ ∏ q ∈ Finset.Ico 1 (liftN s), q :=
    Finset.lcm_dvd fun q hq => Finset.dvd_prod_of_mem _ hq
  have hpos : 0 < ∏ q ∈ Finset.Ico 1 (liftN s), q :=
    Finset.prod_pos fun q hq => by have := (Finset.mem_Ico.1 hq).1; omega
  refine (Nat.le_of_dvd hpos h1).trans ?_
  refine (Finset.prod_le_pow_card _ _ (liftN s) fun q hq => (Finset.mem_Ico.1 hq).2.le).trans ?_
  refine Nat.pow_le_pow_right hN ?_
  rw [Nat.card_Ico]; omega

/-- `Q_s ≤ 2^{s 2^s}`. -/
theorem truncQ_le_two_pow (s : ℕ) : truncQ s ≤ 2 ^ (s * 2 ^ s) := by
  have := truncQ_le s
  rwa [liftN, ← pow_mul] at this

/-- Blueprint Lemma 10.1 (`lem:lifttrunc`), proof: `log₂ Q_s ≤ s 2^s`. -/
theorem logb_truncQ_le (s : ℕ) : Real.logb 2 (truncQ s) ≤ s * 2 ^ s := by
  have hQ : (0 : ℝ) < truncQ s := by exact_mod_cast truncQ_pos s
  have h : (truncQ s : ℝ) ≤ (2 : ℝ) ^ ((s : ℝ) * 2 ^ s) := by
    have := truncQ_le_two_pow s
    rw [show ((s : ℝ) * 2 ^ s) = ((s * 2 ^ s : ℕ) : ℝ) by push_cast; ring, Real.rpow_natCast]
    exact_mod_cast this
  calc Real.logb 2 (truncQ s) ≤ Real.logb 2 ((2 : ℝ) ^ ((s : ℝ) * 2 ^ s)) :=
        Real.logb_le_logb_of_le (by norm_num) hQ h
    _ = s * 2 ^ s := by rw [Real.logb_rpow (by norm_num) (by norm_num)]

/-- The integer `C₁ = n + 2⌈C_*⌉ + 13 ≥ 3` of eq. (10.2) (`eq:longthreshold`) (a fixed choice
depending on `n, d, Ω, p` through `C_* = liftCStar`). -/
@[irreducible] noncomputable def truncC1 (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) : ℕ :=
  n + 2 * ⌈liftCStar n d Ω p⌉₊ + 13

lemma truncC1_eq : truncC1 n d Ω p = n + 2 * ⌈liftCStar n d Ω p⌉₊ + 13 := by
  unfold truncC1; rfl

/-- The long threshold `J_s = 2^{C₁(s+1)}` of eq. (10.2) (`eq:longthreshold`). -/
noncomputable def truncJ (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ) : ℕ :=
  2 ^ (truncC1 n d Ω p * (s + 1))

lemma three_le_truncC1 : 3 ≤ truncC1 n d Ω p := by rw [truncC1_eq]; omega

/-- `J_s ≥ 2^{C₁} 4^s`. -/
lemma truncJ_ge (s : ℕ) :
    2 ^ truncC1 n d Ω p * (2 ^ s * 2 ^ s) ≤ truncJ n d Ω p s := by
  have hC := three_le_truncC1 (n := n) (d := d) (Ω := Ω) (p := p)
  calc 2 ^ truncC1 n d Ω p * (2 ^ s * 2 ^ s) = 2 ^ (truncC1 n d Ω p + (s + s)) := by
        rw [pow_add, pow_add]
    _ ≤ truncJ n d Ω p s := Nat.pow_le_pow_right (by norm_num) (by nlinarith)

lemma truncC1_lt_two_pow : truncC1 n d Ω p < 2 ^ truncC1 n d Ω p := Nat.lt_two_pow_self

/-- Arithmetic for the first requirement of eq. (10.2). -/
lemma liftV_threshold_arith {K M : ℝ} {v s : ℕ} {T : ℝ} (hK : 0 < K) (hM : 1 ≤ M)
    (hv : (v : ℝ) < K * ((s : ℝ) + 1) * (1 + (2 : ℝ) ^ ((s : ℝ) / (2 * M))) + 1)
    (hT : 2 * K + 11 ≤ T) : (v : ℝ) + 10 ≤ T * ((2 : ℝ) ^ s * (2 : ℝ) ^ s) := by
  have hts : (2 : ℝ) ^ ((s : ℝ) / (2 * M)) ≤ (2 : ℝ) ^ s := by
    rw [← Real.rpow_natCast]
    refine Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_
    rw [div_le_iff₀ (by linarith : (0 : ℝ) < 2 * M)]
    have : (0 : ℝ) ≤ s := Nat.cast_nonneg s
    nlinarith
  have hs2 : s + 1 ≤ 2 ^ s := Nat.lt_two_pow_self
  have hsa : (s : ℝ) + 1 ≤ (2 : ℝ) ^ s := by exact_mod_cast hs2
  have ha1 : (1 : ℝ) ≤ (2 : ℝ) ^ s := one_le_pow₀ (by norm_num)
  have h1 : K * ((s : ℝ) + 1) * (1 + (2 : ℝ) ^ ((s : ℝ) / (2 * M))) ≤
      K * (2 : ℝ) ^ s * ((2 : ℝ) ^ s + (2 : ℝ) ^ s) := by
    gcongr
  have h2 : (1 : ℝ) ≤ (2 : ℝ) ^ s * (2 : ℝ) ^ s := by nlinarith
  nlinarith

/-- Arithmetic for the second and third requirements of eq. (10.2). -/
lemma truncJ_threshold_arith {n s C J : ℕ} (hC : n + 13 ≤ C) (hT : C < 2 ^ C)
    (hJ : 2 ^ C * (2 ^ s * 2 ^ s) ≤ J) :
    n + s * 2 ^ s + 3 ≤ J ∧ s * (n + 2) + s * 2 ^ s + 10 * s ≤ J := by
  have hs2 : s < 2 ^ s := Nat.lt_two_pow_self
  have h0 : s * 2 ^ s ≤ 2 ^ s * 2 ^ s := Nat.mul_le_mul_right _ hs2.le
  have h1' : 1 ≤ 2 ^ s * 2 ^ s := Nat.one_le_iff_ne_zero.2 (by positivity)
  have hs3 : s ≤ 2 ^ s * 2 ^ s := hs2.le.trans (Nat.le_mul_of_pos_right _ (by positivity))
  generalize 2 ^ s * 2 ^ s = a at *
  generalize 2 ^ C = T at *
  constructor
  · nlinarith
  · nlinarith

/-- **Blueprint Lemma 10.1 (`lem:lifttrunc`), eq. (10.2) (`eq:longthreshold`)**, for the fixed
choice `C₁ = truncC1 ≥ 3`: for every `s` (in particular every `s ≥ 1`), `J_s = 2^{C₁(s+1)}`
satisfies `J_s ≥ v_s + 10`, `√n Q_s ≤ 2^{J_s - 3}` and `N_s^{n+2} Q_s 2^{-J_s} ≤ 2^{-10 s}`. -/
theorem truncJ_spec (s : ℕ) :
    liftV n d Ω p s + 10 ≤ truncJ n d Ω p s ∧
    Real.sqrt n * truncQ s ≤ (2 : ℝ) ^ (truncJ n d Ω p s - 3) ∧
    ((liftN s : ℕ) : ℝ) ^ (n + 2) * truncQ s / (2 : ℝ) ^ truncJ n d Ω p s ≤
      ((2 : ℝ) ^ (10 * s))⁻¹ := by
  have hJ : 2 ^ truncC1 n d Ω p * (2 ^ s * 2 ^ s) ≤ truncJ n d Ω p s := truncJ_ge s
  have hT : truncC1 n d Ω p < 2 ^ truncC1 n d Ω p := truncC1_lt_two_pow
  have hCn : n + 13 ≤ truncC1 n d Ω p := by rw [truncC1_eq]; omega
  have hKC : 2 * liftCStar n d Ω p + 11 ≤ (truncC1 n d Ω p : ℝ) := by
    rw [truncC1_eq]
    have hKc : liftCStar n d Ω p ≤ ⌈liftCStar n d Ω p⌉₊ := Nat.le_ceil _
    push_cast
    have : (0 : ℝ) ≤ n := Nat.cast_nonneg n
    linarith
  have hQ : (truncQ s : ℝ) ≤ (2 : ℝ) ^ (s * 2 ^ s) := by exact_mod_cast truncQ_le_two_pow s
  have hK : 0 < liftCStar n d Ω p := liftCStar_pos
  have hM : (1 : ℝ) ≤ paramM n d Ω p := by
    have : (2 : ℝ) ≤ paramM n d Ω p := by exact_mod_cast two_le_paramM n d Ω p
    linarith
  have hv : (liftV n d Ω p s : ℝ) < liftCStar n d Ω p * ((s : ℝ) + 1) *
      (1 + (2 : ℝ) ^ ((s : ℝ) / (2 * (paramM n d Ω p : ℝ)))) + 1 := by
    have h1 : (0 : ℝ) < (2 : ℝ) ^ ((s : ℝ) / (2 * (paramM n d Ω p : ℝ))) :=
      Real.rpow_pos_of_pos (by norm_num) _
    have h2 : (0 : ℝ) ≤ (s : ℝ) + 1 := by have := Nat.cast_nonneg (α := ℝ) s; linarith
    have h0 : 0 ≤ liftCStar n d Ω p * ((s : ℝ) + 1) *
        (1 + (2 : ℝ) ^ ((s : ℝ) / (2 * (paramM n d Ω p : ℝ)))) :=
      mul_nonneg (mul_nonneg hK.le h2) (by linarith)
    have := Nat.ceil_lt_add_one (R := ℝ) h0
    exact this
  generalize truncJ n d Ω p s = J at *
  generalize truncC1 n d Ω p = C at *
  generalize liftV n d Ω p s = v at *
  generalize liftCStar n d Ω p = K at *
  generalize (paramM n d Ω p : ℝ) = M at *
  obtain ⟨hA, hB⟩ := truncJ_threshold_arith hCn hT hJ
  refine ⟨?_, ?_, ?_⟩
  · have hTC : 2 * K + 11 ≤ ((2 ^ C : ℕ) : ℝ) := by
      have : (C : ℝ) ≤ ((2 ^ C : ℕ) : ℝ) := by exact_mod_cast hT.le
      linarith
    have hbound := liftV_threshold_arith hK hM hv hTC
    have : ((v + 10 : ℕ) : ℝ) ≤ ((2 ^ C * (2 ^ s * 2 ^ s) : ℕ) : ℝ) := by
      push_cast at hbound ⊢; exact hbound
    exact (Nat.cast_le.1 this).trans hJ
  · have hsq : Real.sqrt n ≤ (2 : ℝ) ^ n := by
      have h1 : (n : ℝ) + 1 ≤ 2 ^ n := by
        have : n + 1 ≤ 2 ^ n := Nat.lt_two_pow_self
        exact_mod_cast this
      rw [Real.sqrt_le_left (by positivity)]
      have : (0 : ℝ) ≤ n := Nat.cast_nonneg n
      nlinarith
    have hexp : n + s * 2 ^ s ≤ J - 3 := by omega
    calc Real.sqrt n * truncQ s ≤ (2 : ℝ) ^ n * (2 : ℝ) ^ (s * 2 ^ s) :=
          mul_le_mul hsq hQ (Nat.cast_nonneg _) (by positivity)
      _ = (2 : ℝ) ^ (n + s * 2 ^ s) := by rw [pow_add]
      _ ≤ (2 : ℝ) ^ (J - 3) := pow_le_pow_right₀ (by norm_num) hexp
  · have hN : ((liftN s : ℕ) : ℝ) ^ (n + 2) = (2 : ℝ) ^ (s * (n + 2)) := by
      rw [liftN, Nat.cast_pow, Nat.cast_ofNat, ← pow_mul]
    rw [div_le_iff₀ (by positivity), hN, ← div_eq_inv_mul, le_div_iff₀ (by positivity)]
    calc (2 : ℝ) ^ (s * (n + 2)) * truncQ s * 2 ^ (10 * s)
        ≤ (2 : ℝ) ^ (s * (n + 2)) * 2 ^ (s * 2 ^ s) * 2 ^ (10 * s) := by gcongr
      _ = (2 : ℝ) ^ (s * (n + 2) + s * 2 ^ s + 10 * s) := by rw [pow_add, pow_add]
      _ ≤ (2 : ℝ) ^ J := pow_le_pow_right₀ (by norm_num) hB

/-- **Blueprint Lemma 10.1 (`lem:lifttrunc`), eq. (10.2) (`eq:longthreshold`)**, existence form:
there is an integer `C₁ ≥ 3` such that for every `s ≥ 1`, `J_s = 2^{C₁(s+1)}` satisfies
`J_s ≥ v_s + 10`, `√n Q_s ≤ 2^{J_s - 3}` and `N_s^{n+2} Q_s 2^{-J_s} ≤ 2^{-10 s}`; the choice
`C₁ = truncC1` (used in `truncJ`) is such an integer. -/
theorem exists_truncC1 (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) :
    ∃ C₁ : ℕ, 3 ≤ C₁ ∧ C₁ = truncC1 n d Ω p ∧ ∀ s : ℕ, 1 ≤ s →
      liftV n d Ω p s + 10 ≤ 2 ^ (C₁ * (s + 1)) ∧
      Real.sqrt n * truncQ s ≤ (2 : ℝ) ^ (2 ^ (C₁ * (s + 1)) - 3) ∧
      ((liftN s : ℕ) : ℝ) ^ (n + 2) * truncQ s / (2 : ℝ) ^ (2 ^ (C₁ * (s + 1))) ≤
        ((2 : ℝ) ^ (10 * s))⁻¹ :=
  ⟨truncC1 n d Ω p, three_le_truncC1, rfl, fun s _ => truncJ_spec s⟩

/-! ### Linearity of the lifted symbols in `m` -/

/-- `m χ_s` is supported where `χ̃_s ≠ 0`. -/
lemma liftChiT_ne_zero_of_mul_liftChi_ne_zero {s : ℕ} {m : EuclideanSpace ℝ (Fin n) → ℂ}
    {η : EuclideanSpace ℝ (Fin n)} (h : m η * (liftChi n d Ω p s η : ℂ) ≠ 0) :
    liftChiT n d Ω p s η ≠ 0 :=
  liftChiT_ne_zero_of_liftChi_ne_zero fun h0 => h (by rw [h0, Complex.ofReal_zero, mul_zero])

/-- Linearity of `m ↦ (m χ_s)_per` (at most one translate of `χ_s` is active at each point). -/
lemma periodize_sum_mul_liftChi {s : ℕ} {ι : Type*} (F : Finset ι) (c : ι → ℂ)
    (m : ι → EuclideanSpace ℝ (Fin n) → ℂ) (ζ : EuclideanSpace ℝ (Fin n)) :
    periodize (fun η => (∑ i ∈ F, c i * m i η) * (liftChi n d Ω p s η : ℂ)) ζ =
      ∑ i ∈ F, c i * periodize (fun η => m i η * (liftChi n d Ω p s η : ℂ)) ζ := by
  have hg : ∀ (M : EuclideanSpace ℝ (Fin n) → ℂ) η, M η * (liftChi n d Ω p s η : ℂ) ≠ 0 →
      liftChiT n d Ω p s η ≠ 0 := fun M η h => liftChiT_ne_zero_of_mul_liftChi_ne_zero h
  by_cases h : ∃ z : Fin n → ℤ, liftChiT n d Ω p s (ζ - latEmbed z) ≠ 0
  · obtain ⟨z, hz⟩ := h
    rw [periodize_eq_of_liftChiT (hg _) hz, Finset.sum_mul]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [periodize_eq_of_liftChiT (hg _) hz, mul_assoc]
  · push Not at h
    rw [periodize_eq_zero_of_liftChiT (hg _) h]
    refine (Finset.sum_eq_zero fun i _ => ?_).symm
    rw [periodize_eq_zero_of_liftChiT (hg _) h, mul_zero]

/-- Linearity of the lifted symbol in `m`:
`Lift_{s,α}[∑_i c_i m_i] = ∑_i c_i Lift_{s,α}[m_i]` pointwise. -/
theorem liftSym_sum_mul (s a q : ℕ) {ι : Type*} (F : Finset ι) (c : ι → ℂ)
    (m : ι → EuclideanSpace ℝ (Fin n) → ℂ) (ξ : EuclideanSpace ℝ (Fin n)) :
    liftSym n d Ω p s a q (fun η => ∑ i ∈ F, c i * m i η) ξ =
      ∑ i ∈ F, c i * liftSym n d Ω p s a q (m i) ξ := by
  simp only [liftSym, periodize_sum_mul_liftChi, Finset.mul_sum]
  rw [Finset.sum_comm]
  exact Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun b _ => by ring

/-- Linearity of the lifted operators in the symbol: for bounded a.e. strongly measurable
`m_i` and `f ∈ ℓ¹`, `Lift_{s,α}[∑_i c_i m_i](D) f = ∑_i c_i Lift_{s,α}[m_i](D) f`. -/
theorem latMult_liftSym_sum_mul {s a q : ℕ} {ι : Type*} (F : Finset ι) (c : ι → ℂ)
    {m : ι → EuclideanSpace ℝ (Fin n) → ℂ} (hm : ∀ i ∈ F, AEStronglyMeasurable (m i) volume)
    {B : ℝ} (hB : ∀ i ∈ F, ∀ ξ, ‖m i ξ‖ ≤ B) {f : (Fin n → ℤ) → ℂ}
    (hf : Summable fun z => ‖f z‖) (x : Fin n → ℤ) :
    latMult (liftSym n d Ω p s a q (fun η => ∑ i ∈ F, c i * m i η)) f x =
      ∑ i ∈ F, c i * latMult (liftSym n d Ω p s a q (m i)) f x := by
  have e : liftSym n d Ω p s a q (fun η => ∑ i ∈ F, c i * m i η) =
      fun ξ => ∑ i ∈ F, c i * liftSym n d Ω p s a q (m i) ξ :=
    funext (liftSym_sum_mul s a q F c m)
  rw [e]
  exact latMult_sum_mul F c (fun i hi => integrableOn_liftSym
    (integrable_mul_liftChi (hm i hi) fun ξ _ => hB i hi ξ)) hf x

/-- Two-term form: `Lift[m₁ - m₂](D) f = Lift[m₁](D) f - Lift[m₂](D) f`. -/
theorem latMult_liftSym_sub {s a q : ℕ} {m₁ m₂ : EuclideanSpace ℝ (Fin n) → ℂ}
    (hm₁ : AEStronglyMeasurable m₁ volume) (hm₂ : AEStronglyMeasurable m₂ volume) {B : ℝ}
    (hB₁ : ∀ ξ, ‖m₁ ξ‖ ≤ B) (hB₂ : ∀ ξ, ‖m₂ ξ‖ ≤ B) {f : (Fin n → ℤ) → ℂ}
    (hf : Summable fun z => ‖f z‖) (x : Fin n → ℤ) :
    latMult (liftSym n d Ω p s a q (fun η => m₁ η - m₂ η)) f x =
      latMult (liftSym n d Ω p s a q m₁) f x - latMult (liftSym n d Ω p s a q m₂) f x := by
  have h := latMult_liftSym_sum_mul (d := d) (Ω := Ω) (p := p) (s := s) (a := a) (q := q)
    (Finset.univ : Finset (Fin 2)) ![1, -1] (m := ![m₁, m₂])
    (fun i _ => by fin_cases i <;> simpa) (B := B) (fun i _ => by fin_cases i <;> simpa)
    hf x
  simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one,
    one_mul, neg_one_mul] at h
  simpa only [sub_eq_add_neg] using h

/-! ### The truncated symbols and the signed dyadic multiplier bounds -/

/-- The truncated symbol `∑_{1 ≤ j < J} 𝓕 K_j` of Blueprint Lemma 10.1 (`lem:lifttrunc`)
(Mathlib's Fourier transform; `J ∈ ℕ`, empty for `J ≤ 1`). -/
noncomputable def truncSym (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (J : ℕ)
    (ξ : EuclideanSpace ℝ (Fin n)) : ℂ :=
  ∑ j ∈ Finset.Ico 1 J, 𝓕 (dyadicKernel Ω (j : ℤ)) ξ

/-- `𝓕 K_j` is continuous. -/
lemma continuous_fourier_dyadicKernel (hΩ : IsSWProfile Ω) (j : ℤ) :
    Continuous (𝓕 (dyadicKernel Ω j)) :=
  (continuous_fourier_and_norm_le (integrable_dyadicKernel hΩ j)).1

/-- Finite sums of `𝓕 K_j` over `j ∈ T ⊆ ℕ` are continuous. -/
lemma continuous_sum_fourier_dyadicKernel (hΩ : IsSWProfile Ω) (T : Finset ℕ) :
    Continuous fun ξ : EuclideanSpace ℝ (Fin n) => ∑ j ∈ T, 𝓕 (dyadicKernel Ω (j : ℤ)) ξ :=
  continuous_finsetSum _ fun j _ => continuous_fourier_dyadicKernel hΩ j

/-- Uniform bound `|∑_{j ∈ T} 𝓕 K_j(ξ)| ≤ A` over finite `T ⊆ ℕ`. -/
lemma norm_sum_fourier_dyadicKernel_nat_le (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) :
    ∃ A : ℝ, 0 ≤ A ∧ ∀ (T : Finset ℕ) (ξ : EuclideanSpace ℝ (Fin n)),
      ‖∑ j ∈ T, 𝓕 (dyadicKernel Ω (j : ℤ)) ξ‖ ≤ A := by
  obtain ⟨A, hA0, hA⟩ := sum_norm_fourier_dyadicKernel_le hn hΩ
  refine ⟨A, hA0, fun T ξ => (norm_sum_le _ _).trans ?_⟩
  have := hA (T.map Nat.castEmbedding) ξ
  rwa [Finset.sum_map] at this

/-- Blueprint Lemma 4.3 (`lem:signedK`) in multiplier form on Schwartz inputs: for `1 < t < ∞`
there is `A` such that for every finite `T ⊆ ℕ` and all `|c_j| ≤ 1`,
`‖𝓕⁻((∑_{j ∈ T} c_j 𝓕 K_j) 𝓕 G)‖_t ≤ A ‖G‖_t` for every Schwartz `G`. -/
theorem eLpNorm_fourierInv_sum_fourier_dyadicKernel_le (hn : 1 ≤ n) (hΩ : IsSWProfile Ω)
    {t : ℝ} (ht : 1 < t) :
    ∃ A : ℝ, 0 ≤ A ∧ ∀ (T : Finset ℕ) (c : ℕ → ℂ), (∀ j, ‖c j‖ ≤ 1) →
      ∀ G : 𝓢(EuclideanSpace ℝ (Fin n), ℂ),
        eLpNorm (𝓕⁻ (fun ξ => (∑ j ∈ T, c j * 𝓕 (dyadicKernel Ω (j : ℤ)) ξ) *
            𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ)) (ENNReal.ofReal t) volume ≤
          ENNReal.ofReal A * eLpNorm G (ENNReal.ofReal t) volume := by
  obtain ⟨C, hC0, hC⟩ := exists_eLpNorm_convolution_sum_smul_dyadicKernel_le hn hΩ ht
  obtain ⟨A, hA0, hA⟩ := norm_fourier_sum_smul_dyadicKernel_le hn hΩ
  refine ⟨C, hC0, fun T c hc G => ?_⟩
  set c' : ℤ → ℂ := fun j => c j.toNat with hc'def
  have hc' : ∀ j, ‖c' j‖ ≤ 1 := fun j => hc _
  have hH : Integrable (∑ j ∈ T.map Nat.castEmbedding, c' j • dyadicKernel Ω j) :=
    integrable_finsetSum' _ fun j _ => (integrable_dyadicKernel hΩ j).smul _
  have e : (fun ξ => (∑ j ∈ T, c j * 𝓕 (dyadicKernel Ω (j : ℤ)) ξ) *
      𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ) = fun ξ =>
        𝓕 (∑ j ∈ T.map Nat.castEmbedding, c' j • dyadicKernel Ω j) ξ *
          𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ := by
    funext ξ
    rw [fourier_sum_smul_dyadicKernel hΩ, Finset.sum_map]
    simp [hc'def]
  rw [e, fourierInv_fourier_mul_eq_convolution hH (hA _ c' hc') G]
  exact hC _ c' hc' _ (G.memLp _ _)

/-! ### Binary blocks -/

/-- The dyadic block `I_{l,k} = {k 2^l + 1, …, (k+1) 2^l}` of Blueprint Lemma 2.7
(`lem:binary`). -/
def binBlock (l k : ℕ) : Finset ℕ := Finset.Icc (k * 2 ^ l + 1) ((k + 1) * 2 ^ l)

lemma div_of_mem_binBlock {l k j : ℕ} (h : j ∈ binBlock l k) : (j - 1) / 2 ^ l = k := by
  rw [binBlock, Finset.mem_Icc] at h
  refine Nat.div_eq_of_lt_le (by omega) ?_
  have : 0 < 2 ^ l := by positivity
  omega

/-- A signed sum of block sums is a sum over the union of the (disjoint) blocks, with
coefficient `ε_{(j-1)/2^l}` at `j`. -/
lemma sum_signed_binBlock (l : ℕ) (F : Finset ℕ) (ε : ℕ → ℂ) (g : ℕ → ℂ) :
    ∑ k ∈ F, ε k * ∑ j ∈ binBlock l k, g j =
      ∑ j ∈ F.biUnion (binBlock l),
        (if (j - 1) / 2 ^ l ∈ F then ε ((j - 1) / 2 ^ l) else 0) * g j := by
  classical
  rw [Finset.sum_biUnion]
  · refine Finset.sum_congr rfl fun k hk => ?_
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun j hj => ?_
    rw [div_of_mem_binBlock hj]
    simp only [hk, ↓reduceIte]
  · intro k _ k' _ hkk'
    refine Finset.disjoint_left.2 fun j hj hj' => hkk' ?_
    exact (div_of_mem_binBlock hj).symm.trans (div_of_mem_binBlock hj')

/-! ### The short range `1 ≤ J ≤ J_s` -/

/-- Linearity for the finite dyadic sums: `Lift[∑_{j ∈ T} 𝓕 K_j](D) f = ∑_{j ∈ T} Lift[𝓕 K_j](D) f`
(`f ∈ ℓ¹`). -/
lemma latMult_liftSym_sum_fourier_dyadicKernel (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) {s : ℕ}
    (T : Finset ℕ) (aq : ℕ × ℕ) {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖)
    (x : Fin n → ℤ) :
    latMult (liftSym n d Ω p s aq.1 aq.2
        (fun ξ => ∑ j ∈ T, 𝓕 (dyadicKernel Ω (j : ℤ)) ξ)) f x =
      ∑ j ∈ T, latMult (liftSym n d Ω p s aq.1 aq.2 (𝓕 (dyadicKernel Ω (j : ℤ)))) f x := by
  obtain ⟨B, -, hB⟩ := norm_sum_fourier_dyadicKernel_nat_le hn hΩ
  have := latMult_liftSym_sum_mul (d := d) (Ω := Ω) (p := p) (s := s) (a := aq.1) (q := aq.2)
    T (fun _ => 1) (m := fun j => 𝓕 (dyadicKernel Ω (j : ℤ)))
    (fun j _ => (continuous_fourier_dyadicKernel hΩ _).aestronglyMeasurable)
    (B := B) (fun j _ ξ => by simpa using hB {j} ξ) hf x
  simpa only [one_mul] using this

/-- **Blueprint Lemma 10.1 (`lem:lifttrunc`), the short range `J ≤ J_s`**: for `n, d ≥ 1`,
admissible `Ω` and `1 < p < ∞` there are `δ > 0` and `C` such that for every `s ≥ 1` and every
finitely supported `f`,
`‖sup_{α ∈ 𝓡_s, 1 ≤ J ≤ J_s} |Lift_{s,α}[∑_{1 ≤ j < J} 𝓕 K_j](D) f|‖_p ≤ C (s+1) 2^{-δ s} ‖f‖_p`
(the supremum is the finite maximum over `(α, J) ∈ 𝓡_s × {1, …, J_s}`; `δ` is the exponent of
eq. (9.10), `lift_square_p`). -/
theorem lift_trunc_short (hn : 1 ≤ n) (hd : 1 ≤ d) (hΩ : IsSWProfile Ω) (hp : 1 < p) :
    ∃ δ : ℝ, 0 < δ ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ s : ℕ, 1 ≤ s →
      ∀ f : (Fin n → ℤ) → ℂ, (Function.support f).Finite →
        eLpNorm (fun x => ((((liftRat s) ×ˢ (Finset.Icc 1 (truncJ n d Ω p s))).sup fun aJ =>
            ‖latMult (liftSym n d Ω p s aJ.1.1 aJ.1.2 (truncSym Ω aJ.2)) f x‖₊ : ℝ≥0) : ℝ))
          (ENNReal.ofReal p) Measure.count ≤
        ENNReal.ofReal (C * ((s : ℝ) + 1) * (2 : ℝ) ^ (-(δ * s))) *
          eLpNorm f (ENNReal.ofReal p) Measure.count := by
  obtain ⟨δ, hδ, CL, hCL, hsq⟩ := lift_square_p n d hn hd Ω hp
  have ht : 1 < 2 * (paramR p : ℝ) := by
    have : (1 : ℝ) ≤ paramR p := by exact_mod_cast one_le_paramR p
    linarith
  obtain ⟨A, hA0, hA⟩ := eLpNorm_fourierInv_sum_fourier_dyadicKernel_le hn hΩ ht
  obtain ⟨B, hB0, hB⟩ := norm_sum_fourier_dyadicKernel_nat_le hn hΩ
  have hC1 : (0 : ℝ) ≤ truncC1 n d Ω p := Nat.cast_nonneg _
  refine ⟨δ, hδ, CL * A * ((truncC1 n d Ω p : ℝ) + 1),
    mul_nonneg (mul_nonneg hCL hA0) (by linarith), fun s hs f hf => ?_⟩
  classical
  have hf1 : Summable fun z => ‖f z‖ := summable_of_finite_support hf
  have hJL : truncJ n d Ω p s = 2 ^ (truncC1 n d Ω p * (s + 1)) := rfl
  set L := truncC1 n d Ω p * (s + 1) with hL
  set blk : ℕ → ℕ → EuclideanSpace ℝ (Fin n) → ℂ := fun l k ξ =>
    ∑ j ∈ binBlock l k, 𝓕 (dyadicKernel Ω (j : ℤ)) ξ with hblk
  set Q : ℕ → (Fin n → ℤ) → ℝ := fun l x => Real.sqrt (∑ k ∈ Finset.range (2 ^ (L - l)),
    ((((liftRat s).sup fun aq =>
      ‖latMult (liftSym n d Ω p s aq.1 aq.2 (blk l k)) f x‖₊ : ℝ≥0) : ℝ) ^ 2)) with hQ
  -- the pointwise binary bound, with the supremum over `α` inside each block square
  have hpt : ∀ x, (((liftRat s ×ˢ Finset.Icc 1 (truncJ n d Ω p s)).sup fun aJ =>
      ‖latMult (liftSym n d Ω p s aJ.1.1 aJ.1.2 (truncSym Ω aJ.2)) f x‖₊ : ℝ≥0) : ℝ) ≤
        ∑ l ∈ Finset.range (L + 1), Q l x := by
    intro x
    refine arith_coe_finset_sup_nnnorm_le (Finset.sum_nonneg fun l _ => Real.sqrt_nonneg _) ?_
    rintro ⟨aq, J⟩ haJ
    rw [Finset.mem_product, Finset.mem_Icc] at haJ
    obtain ⟨haq, hJ1, hJ2⟩ := haJ
    have e1 : truncSym Ω J =
        fun ξ => ∑ j ∈ Finset.Icc 1 (J - 1), 𝓕 (dyadicKernel Ω (j : ℤ)) ξ := by
      funext ξ
      unfold truncSym
      congr 1
    simp only
    rw [e1, latMult_liftSym_sum_fourier_dyadicKernel hn hΩ _ aq hf1 x]
    refine (binary_maximal_inequality L _ (J - 1) (by rw [hJL] at hJ2; omega)).trans ?_
    refine Finset.sum_le_sum fun l _ => Real.sqrt_le_sqrt (Finset.sum_le_sum fun k _ => ?_)
    have e2 : ∑ j ∈ Finset.Icc (k * 2 ^ l + 1) ((k + 1) * 2 ^ l),
        latMult (liftSym n d Ω p s aq.1 aq.2 (𝓕 (dyadicKernel Ω (j : ℤ)))) f x =
          latMult (liftSym n d Ω p s aq.1 aq.2 (blk l k)) f x :=
      (latMult_liftSym_sum_fourier_dyadicKernel hn hΩ (binBlock l k) aq hf1 x).symm
    rw [e2]
    have hle := Finset.le_sup
      (f := fun aq : ℕ × ℕ => ‖latMult (liftSym n d Ω p s aq.1 aq.2 (blk l k)) f x‖₊) haq
    have h' : ‖latMult (liftSym n d Ω p s aq.1 aq.2 (blk l k)) f x‖ ≤
        (((liftRat s).sup fun aq =>
          ‖latMult (liftSym n d Ω p s aq.1 aq.2 (blk l k)) f x‖₊ : ℝ≥0) : ℝ) := by
      exact_mod_cast hle
    exact pow_le_pow_left₀ (norm_nonneg _) h' 2
  -- each binary level is bounded by eq. (9.10)
  have hlev : ∀ l, eLpNorm (Q l) (ENNReal.ofReal p) Measure.count ≤
      ENNReal.ofReal (CL * (2 : ℝ) ^ (-(δ * s)) * A) *
        eLpNorm f (ENNReal.ofReal p) Measure.count := by
    intro l
    refine hsq s hs (Finset.range (2 ^ (L - l))) (blk l) B A
      (fun k _ => (continuous_sum_fourier_dyadicKernel hΩ _).aestronglyMeasurable)
      (fun k _ ξ => hB _ ξ) hA0 (fun ε hε G => ?_) f hf
    have e : (fun ξ => (∑ k ∈ Finset.range (2 ^ (L - l)), (ε k : ℂ) * blk l k ξ) *
        𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ) = fun ξ =>
          (∑ j ∈ (Finset.range (2 ^ (L - l))).biUnion (binBlock l),
            (if (j - 1) / 2 ^ l ∈ Finset.range (2 ^ (L - l)) then (ε ((j - 1) / 2 ^ l) : ℂ)
              else 0) * 𝓕 (dyadicKernel Ω (j : ℤ)) ξ) *
            𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ := by
      funext ξ
      congr 1
      exact sum_signed_binBlock l _ (fun k => (ε k : ℂ)) (fun j => 𝓕 (dyadicKernel Ω (j : ℤ)) ξ)
    rw [e]
    refine hA _ _ (fun j => ?_) G
    split_ifs with h
    · rcases hε _ h with h1 | h1 <;> simp [h1]
    · simp
  have hp1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hp.le
  have h2 : (0 : ℝ) ≤ (2 : ℝ) ^ (-(δ * s)) := Real.rpow_nonneg (by norm_num) _
  have hX : 0 ≤ CL * (2 : ℝ) ^ (-(δ * s)) * A := mul_nonneg (mul_nonneg hCL h2) hA0
  calc eLpNorm (fun x => ((((liftRat s) ×ˢ (Finset.Icc 1 (truncJ n d Ω p s))).sup fun aJ =>
            ‖latMult (liftSym n d Ω p s aJ.1.1 aJ.1.2 (truncSym Ω aJ.2)) f x‖₊ : ℝ≥0) : ℝ))
          (ENNReal.ofReal p) Measure.count
      ≤ eLpNorm (∑ l ∈ Finset.range (L + 1), Q l) (ENNReal.ofReal p) Measure.count := by
        refine eLpNorm_mono_real AEStronglyMeasurable.of_discrete fun x => ?_
        rw [Finset.sum_apply, Real.norm_of_nonneg (NNReal.coe_nonneg _)]
        exact hpt x
    _ ≤ ∑ l ∈ Finset.range (L + 1), eLpNorm (Q l) (ENNReal.ofReal p) Measure.count :=
        eLpNorm_sum_le hp1
    _ ≤ ∑ l ∈ Finset.range (L + 1), ENNReal.ofReal (CL * (2 : ℝ) ^ (-(δ * s)) * A) *
          eLpNorm f (ENNReal.ofReal p) Measure.count := Finset.sum_le_sum fun l _ => hlev l
    _ = ENNReal.ofReal (((L + 1 : ℕ) : ℝ) * (CL * (2 : ℝ) ^ (-(δ * s)) * A)) *
          eLpNorm f (ENNReal.ofReal p) Measure.count := by
        rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul,
          ENNReal.ofReal_mul (Nat.cast_nonneg _), ENNReal.ofReal_natCast]
        ring
    _ ≤ ENNReal.ofReal (CL * A * ((truncC1 n d Ω p : ℝ) + 1) * ((s : ℝ) + 1) *
          (2 : ℝ) ^ (-(δ * s))) * eLpNorm f (ENNReal.ofReal p) Measure.count := by
        refine mul_le_mul_left (ENNReal.ofReal_le_ofReal ?_) _
        have hs0 : (0 : ℝ) ≤ s := Nat.cast_nonneg s
        have hL1 : ((L + 1 : ℕ) : ℝ) ≤ ((truncC1 n d Ω p : ℝ) + 1) * ((s : ℝ) + 1) := by
          rw [hL]; push_cast; nlinarith
        calc ((L + 1 : ℕ) : ℝ) * (CL * (2 : ℝ) ^ (-(δ * s)) * A)
            ≤ ((truncC1 n d Ω p : ℝ) + 1) * ((s : ℝ) + 1) * (CL * (2 : ℝ) ^ (-(δ * s)) * A) :=
              mul_le_mul_of_nonneg_right hL1 hX
          _ = _ := by ring

/-! ### The long range `J > J_s`: the decomposition -/

/-- Helper: `∑_{j ∈ [1, J) ⊆ ℕ} g(j) = ∑_{j ∈ [1, J) ⊆ ℤ} g(j)`. -/
lemma sum_Ico_natCast_eq (g : ℤ → ℂ) (J : ℕ) :
    ∑ j ∈ Finset.Ico 1 J, g (j : ℤ) = ∑ j ∈ Finset.Ico (1 : ℤ) J, g j := by
  have h : (Finset.Ico 1 J).map Nat.castEmbedding = Finset.Ico (1 : ℤ) J := by
    ext j
    simp only [Finset.mem_map, Finset.mem_Ico, Nat.castEmbedding_apply]
    constructor
    · rintro ⟨a, ⟨h1, h2⟩, rfl⟩; omega
    · rintro ⟨h1, h2⟩; exact ⟨j.toNat, ⟨by omega, by omega⟩, by omega⟩
  rw [← h, Finset.sum_map]
  rfl

/-- **Blueprint Lemma 10.1 (`lem:lifttrunc`), the long range decomposition**: for `J ≥ 1` and
every `ξ`, the series `m_{≥J}(ξ) = ∑_{j ≥ J} 𝓕 K_j(ξ)` converges absolutely,
`∑_{1 ≤ j < J} 𝓕 K_j = m_K - m_{≥J}` and `m_{≥J} = τ_J m_K + Ê_J` (from Lemma 4.5,
`fourier_smoothErr`; here these are identities everywhere). -/
theorem truncSym_decomp (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) {J : ℕ} (hJ : 1 ≤ J)
    (ξ : EuclideanSpace ℝ (Fin n)) :
    Summable (fun i : ℕ => ‖𝓕 (dyadicKernel Ω ((J : ℤ) + i)) ξ‖) ∧
    truncSym Ω J ξ = dyadicSymbol Ω ξ - ∑' i : ℕ, 𝓕 (dyadicKernel Ω ((J : ℤ) + i)) ξ ∧
    ∑' i : ℕ, 𝓕 (dyadicKernel Ω ((J : ℤ) + i)) ξ =
      bpTau J ξ * dyadicSymbol Ω ξ + 𝓕 (smoothErr Ω J) ξ := by
  have hJ' : (1 : ℤ) ≤ J := by exact_mod_cast hJ
  obtain ⟨-, -, -, -, hF⟩ := fourier_smoothErr hn hΩ hJ'
  obtain ⟨A, -, hA, -⟩ := dyadicSymbol_spec hn hΩ
  refine ⟨(hF ξ).1, ?_, ?_⟩
  · have h := tsum_succ_eq_sum_Ico_add_tsum (g := fun j : ℤ => 𝓕 (dyadicKernel Ω j) ξ)
      (hA ξ).1.of_norm hJ'
    rw [truncSym, sum_Ico_natCast_eq (fun j : ℤ => 𝓕 (dyadicKernel Ω j) ξ), dyadicSymbol, h]
    ring
  · rw [(hF ξ).2]; ring

/-- The long range decomposition in the form used for the operators: for `J ≥ 1`,
`∑_{1 ≤ j < J} 𝓕 K_j = m_K - τ_J m_K - Ê_J` pointwise. -/
theorem truncSym_eq_sub (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) {J : ℕ} (hJ : 1 ≤ J) :
    truncSym Ω J = fun ξ =>
      dyadicSymbol Ω ξ - bpTau J ξ * dyadicSymbol Ω ξ - 𝓕 (smoothErr Ω J) ξ := by
  funext ξ
  obtain ⟨-, h1, h2⟩ := truncSym_decomp hn hΩ hJ ξ
  rw [h1, h2]; ring

/-! #### Measurability and boundedness of the long range symbols -/

lemma aestronglyMeasurable_dyadicSymbol (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) :
    AEStronglyMeasurable (dyadicSymbol Ω) volume := by
  obtain ⟨A, -, hA, -⟩ := dyadicSymbol_spec hn hΩ
  refine aestronglyMeasurable_of_tendsto_ae Filter.atTop (f := fun N ξ =>
    ∑ j ∈ Finset.range N, 𝓕 (dyadicKernel Ω ((j : ℤ) + 1)) ξ) (fun N => ?_)
    (Filter.Eventually.of_forall fun ξ => (hA ξ).2.2.1.tendsto_sum_nat)
  exact (continuous_finsetSum _ fun j _ =>
    continuous_fourier_dyadicKernel hΩ _).aestronglyMeasurable

lemma continuous_bpTau (J : ℤ) : Continuous (bpTau (n := n) J) := by
  have e : bpTau (n := n) J = 𝓕 (bpPhiDilC J) := funext fun ξ => (fourier_bpPhiDil J ξ).symm
  rw [e]
  exact (continuous_fourier_and_norm_le (integrable_bpPhiDilC J)).1

/-- `min(t, t⁻¹) ≤ 1`. -/
lemma min_self_inv_le_one (t : ℝ) : min t t⁻¹ ≤ 1 := by
  rcases le_total t 1 with h | h
  · exact (min_le_left _ _).trans h
  · exact (min_le_right _ _).trans (inv_le_one_of_one_le₀ h)

/-- Uniform bounds and measurability for `m_K`, `τ_J m_K` and `Ê_J` (`J ≥ 1`). -/
lemma long_symbols_bounds (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) :
    ∃ B : ℝ, 0 ≤ B ∧ (∀ ξ, ‖dyadicSymbol Ω ξ‖ ≤ B) ∧
      (∀ (J : ℤ) ξ, ‖bpTau J ξ * dyadicSymbol Ω ξ‖ ≤ B) ∧
      (∀ J : ℤ, 1 ≤ J → ∀ ξ, ‖𝓕 (smoothErr Ω J) ξ‖ ≤ B) ∧
      AEStronglyMeasurable (dyadicSymbol Ω) volume ∧
      (∀ J : ℤ, AEStronglyMeasurable (fun ξ => bpTau J ξ * dyadicSymbol Ω ξ) volume) ∧
      (∀ J : ℤ, 1 ≤ J → Continuous (𝓕 (smoothErr Ω J))) := by
  obtain ⟨Am, hAm0, hAm, -⟩ := dyadicSymbol_spec hn hΩ
  obtain ⟨S₀, S₁, Lτ, hS₀, -, -, hτ⟩ := norm_bpTau_le (n := n)
  obtain ⟨CE, hCE0, hCE⟩ := norm_fourier_smoothErr_le hn hΩ
  have hm := aestronglyMeasurable_dyadicSymbol hn hΩ
  refine ⟨max Am (max (S₀ * Am) CE), le_max_of_le_left hAm0, fun ξ => ?_, fun J ξ => ?_,
    fun J hJ ξ => ?_, hm, fun J => (continuous_bpTau J).aestronglyMeasurable.mul hm,
    fun J hJ => (fourier_smoothErr hn hΩ hJ).2.2.1⟩
  · exact ((hAm ξ).2.2.2).trans (le_max_left _ _)
  · rw [norm_mul]
    refine (mul_le_mul (hτ J ξ).1 (hAm ξ).2.2.2 (norm_nonneg _) hS₀).trans ?_
    exact (le_max_left _ _).trans (le_max_right _ _)
  · refine (hCE J hJ ξ).trans ?_
    have : CE * min (2 ^ J * ‖ξ‖) (2 ^ J * ‖ξ‖)⁻¹ ≤ CE :=
      mul_le_of_le_one_right hCE0 (min_self_inv_le_one _)
    exact this.trans ((le_max_right _ _).trans (le_max_right _ _))

/-! #### Signed multiplier bounds for the long range symbols -/

/-- A multiplier bound for `m` gives the same bound for `± m`. -/
lemma eLpNorm_fourierInv_sign_mul_le {m : EuclideanSpace ℝ (Fin n) → ℂ} {t : ℝ≥0∞} {A : ℝ}
    (h : ∀ G : 𝓢(EuclideanSpace ℝ (Fin n), ℂ),
      eLpNorm (𝓕⁻ (fun ξ => m ξ * 𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ)) t volume ≤
        ENNReal.ofReal A * eLpNorm G t volume)
    {ε : ℝ} (hε : ε = 1 ∨ ε = -1) (G : 𝓢(EuclideanSpace ℝ (Fin n), ℂ)) :
    eLpNorm (𝓕⁻ (fun ξ => ((ε : ℂ) * m ξ) * 𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ)) t volume ≤
      ENNReal.ofReal A * eLpNorm G t volume := by
  rcases hε with rfl | rfl
  · simpa using h G
  · have e : 𝓕⁻ (fun ξ => (((-1 : ℝ) : ℂ) * m ξ) * 𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ) =
        -𝓕⁻ (fun ξ => m ξ * 𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ) := by
      funext x
      simp only [Real.fourierInv_eq, Pi.neg_apply, ← integral_neg]
      congr 1
      funext v
      simp only [Complex.ofReal_neg, Complex.ofReal_one, neg_mul, one_mul, smul_neg]
    rw [e, eLpNorm_neg]
    exact h G

/-- Blueprint Lemma 4.5 (`lem:smootherrors`) in multiplier form on Schwartz inputs: for
`1 < t < ∞` there is `A` such that for every finite `S ⊆ ℕ` of indices `J ≥ 1` and every choice
of signs `ε_J = ±1` (`J ∈ S`), `‖𝓕⁻((∑_{J ∈ S} ε_J Ê_J) 𝓕 G)‖_t ≤ A ‖G‖_t` for Schwartz `G`. -/
theorem eLpNorm_fourierInv_sum_fourier_smoothErr_le (hn : 1 ≤ n) (hΩ : IsSWProfile Ω)
    {t : ℝ} (ht : 1 < t) :
    ∃ A : ℝ, 0 ≤ A ∧ ∀ S : Finset ℕ, (∀ J ∈ S, 1 ≤ J) → ∀ ε : ℕ → ℝ,
      (∀ J ∈ S, ε J = 1 ∨ ε J = -1) → ∀ G : 𝓢(EuclideanSpace ℝ (Fin n), ℂ),
        eLpNorm (𝓕⁻ (fun ξ => (∑ J ∈ S, (ε J : ℂ) * 𝓕 (smoothErr Ω J) ξ) *
            𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ)) (ENNReal.ofReal t) volume ≤
          ENNReal.ofReal A * eLpNorm G (ENNReal.ofReal t) volume := by
  obtain ⟨C, hC0, hC⟩ := exists_eLpNorm_convolution_sum_smul_smoothErr_le hn hΩ ht
  refine ⟨C, hC0, fun S hS ε hε G => ?_⟩
  classical
  set c : ℤ → ℂ := fun J => if J.toNat ∈ S then (ε J.toNat : ℂ) else 0 with hcdef
  have hc : ∀ J, ‖c J‖ ≤ 1 := fun J => by
    simp only [hcdef]
    split_ifs with h
    · rcases hε _ h with h1 | h1 <;> simp [h1]
    · simp
  have hS' : ∀ J ∈ S.map Nat.castEmbedding, (1 : ℤ) ≤ J := by
    intro J hJ
    obtain ⟨j, hj, rfl⟩ := Finset.mem_map.1 hJ
    simp only [Nat.castEmbedding_apply]
    exact_mod_cast hS j hj
  have hint : ∀ J ∈ S.map Nat.castEmbedding, Integrable (smoothErr Ω J) :=
    fun J hJ => integrable_smoothErr hn hΩ (hS' J hJ)
  set H := ∑ J ∈ S.map Nat.castEmbedding, c J • smoothErr Ω J with hH
  have hHi : Integrable H := integrable_finsetSum' _ fun J hJ => (hint J hJ).smul _
  have e : (fun ξ => (∑ J ∈ S, (ε J : ℂ) * 𝓕 (smoothErr Ω J) ξ) *
      𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ) = fun ξ =>
        𝓕 H ξ * 𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ := by
    funext ξ
    rw [hH, fourier_finsetSum_smul _ c hint, Finset.sum_map]
    congr 1
    refine Finset.sum_congr rfl fun j hj => ?_
    simp [hcdef, hj]
  rw [e, fourierInv_fourier_mul_eq_convolution hHi (continuous_fourier_and_norm_le hHi).2 G]
  exact hC _ hS' c hc _ (G.memLp _ _)

/-! #### The bounds for the whole multiplier and for the smoothing errors -/

/-- **Blueprint Lemma 10.1 (`lem:lifttrunc`), long range, the whole multiplier**: the one-element
case of eq. (9.10): there are `δ > 0` and `C` such that for every `s ≥ 1` and finitely supported
`f`, `‖sup_{α ∈ 𝓡_s} |Lift_{s,α}[m_K](D) f|‖_p ≤ C 2^{-δ s} ‖f‖_p`. -/
theorem lift_dyadicSymbol_bound (hn : 1 ≤ n) (hd : 1 ≤ d) (hΩ : IsSWProfile Ω) (hp : 1 < p) :
    ∃ δ : ℝ, 0 < δ ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ s : ℕ, 1 ≤ s →
      ∀ f : (Fin n → ℤ) → ℂ, (Function.support f).Finite →
        eLpNorm (fun x => (((liftRat s).sup fun aq =>
            ‖latMult (liftSym n d Ω p s aq.1 aq.2 (dyadicSymbol Ω)) f x‖₊ : ℝ≥0) : ℝ))
          (ENNReal.ofReal p) Measure.count ≤
        ENNReal.ofReal (C * (2 : ℝ) ^ (-(δ * s))) * eLpNorm f (ENNReal.ofReal p) Measure.count := by
  obtain ⟨δ, hδ, CL, hCL, hsq⟩ := lift_square_p n d hn hd Ω hp
  have ht : 1 < 2 * (paramR p : ℝ) := by
    have : (1 : ℝ) ≤ paramR p := by exact_mod_cast one_le_paramR p
    linarith
  obtain ⟨A, hA0, hA⟩ := exists_eLpNorm_fourierInv_dyadicSymbol_mul_le hn hΩ ht
  obtain ⟨B, -, hB, -, -, hm, -, -⟩ := long_symbols_bounds hn hΩ
  refine ⟨δ, hδ, CL * A, mul_nonneg hCL hA0, fun s hs f hf => ?_⟩
  have h := hsq s hs ({()} : Finset Unit) (fun _ => dyadicSymbol Ω) B A (fun _ _ => hm)
    (fun _ _ => hB) hA0 (fun ε hε G => ?_) f hf
  · simp only [Finset.sum_singleton] at h
    have e : (fun x => Real.sqrt ((((liftRat s).sup fun aq =>
        ‖latMult (liftSym n d Ω p s aq.1 aq.2 (dyadicSymbol Ω)) f x‖₊ : ℝ≥0) : ℝ) ^ 2)) =
        fun x => (((liftRat s).sup fun aq =>
          ‖latMult (liftSym n d Ω p s aq.1 aq.2 (dyadicSymbol Ω)) f x‖₊ : ℝ≥0) : ℝ) := by
      funext x; exact Real.sqrt_sq (NNReal.coe_nonneg _)
    rw [e] at h
    refine h.trans (le_of_eq ?_)
    congr 2; ring
  · simp only [Finset.sum_singleton]
    exact eLpNorm_fourierInv_sign_mul_le hA (hε () (Finset.mem_singleton_self _)) G

/-- **Blueprint Lemma 10.1 (`lem:lifttrunc`), long range, the smoothing errors, finite `J` sets**:
there are `δ > 0` and `C` such that for every `s ≥ 1`, every finite set `S` of integers `J ≥ 1`
and every finitely supported `f`,
`‖sup_{α ∈ 𝓡_s, J ∈ S} |Lift_{s,α}[Ê_J](D) f|‖_p ≤ C 2^{-δ s} ‖f‖_p` (via the square function
of eq. (9.10) and the uniform signed bounds of Lemma 4.5). -/
theorem lift_smoothErr_finset (hn : 1 ≤ n) (hd : 1 ≤ d) (hΩ : IsSWProfile Ω) (hp : 1 < p) :
    ∃ δ : ℝ, 0 < δ ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ s : ℕ, 1 ≤ s → ∀ S : Finset ℕ, (∀ J ∈ S, 1 ≤ J) →
      ∀ f : (Fin n → ℤ) → ℂ, (Function.support f).Finite →
        eLpNorm (fun x => ((((liftRat s) ×ˢ S).sup fun aJ =>
            ‖latMult (liftSym n d Ω p s aJ.1.1 aJ.1.2 (𝓕 (smoothErr Ω aJ.2))) f x‖₊ : ℝ≥0) : ℝ))
          (ENNReal.ofReal p) Measure.count ≤
        ENNReal.ofReal (C * (2 : ℝ) ^ (-(δ * s))) * eLpNorm f (ENNReal.ofReal p) Measure.count := by
  obtain ⟨δ, hδ, CL, hCL, hsq⟩ := lift_square_p n d hn hd Ω hp
  have ht : 1 < 2 * (paramR p : ℝ) := by
    have : (1 : ℝ) ≤ paramR p := by exact_mod_cast one_le_paramR p
    linarith
  obtain ⟨A, hA0, hA⟩ := eLpNorm_fourierInv_sum_fourier_smoothErr_le hn hΩ ht
  obtain ⟨B, -, -, -, hB, -, -, hc⟩ := long_symbols_bounds hn hΩ
  refine ⟨δ, hδ, CL * A, mul_nonneg hCL hA0, fun s hs S hS f hf => ?_⟩
  have hS' : ∀ J ∈ S, (1 : ℤ) ≤ J := fun J hJ => by exact_mod_cast hS J hJ
  have h := hsq s hs S (fun J => 𝓕 (smoothErr Ω J)) B A
    (fun J hJ => (hc J (hS' J hJ)).aestronglyMeasurable) (fun J hJ => hB J (hS' J hJ)) hA0
    (fun ε hε G => hA S hS ε hε G) f hf
  refine le_trans ?_ (h.trans (le_of_eq ?_))
  · refine eLpNorm_mono_real AEStronglyMeasurable.of_discrete fun x => ?_
    rw [Real.norm_of_nonneg (NNReal.coe_nonneg _)]
    refine arith_coe_finset_sup_nnnorm_le (Real.sqrt_nonneg _) ?_
    rintro ⟨aq, J⟩ haJ
    obtain ⟨haq, hJ⟩ := Finset.mem_product.1 haJ
    have hle := Finset.le_sup (f := fun aq : ℕ × ℕ =>
      ‖latMult (liftSym n d Ω p s aq.1 aq.2 (𝓕 (smoothErr Ω J))) f x‖₊) haq
    have h1 : ‖latMult (liftSym n d Ω p s aq.1 aq.2 (𝓕 (smoothErr Ω J))) f x‖ ≤
        (((liftRat s).sup fun aq =>
          ‖latMult (liftSym n d Ω p s aq.1 aq.2 (𝓕 (smoothErr Ω J))) f x‖₊ : ℝ≥0) : ℝ) := by
      exact_mod_cast hle
    refine h1.trans (Real.le_sqrt_of_sq_le ?_)
    exact Finset.single_le_sum (f := fun J : ℕ => ((((liftRat s).sup fun aq =>
      ‖latMult (liftSym n d Ω p s aq.1 aq.2 (𝓕 (smoothErr Ω J))) f x‖₊ : ℝ≥0) : ℝ) ^ 2))
      (fun _ _ => sq_nonneg _) hJ
  · congr 2; ring

/-- Helper: the `ℓ^p` norm of an `ℝ≥0`-valued function, viewed in `ℝ≥0∞` or in `ℝ`. -/
lemma eLpNorm_coe_nnreal_eq {q : ℝ≥0∞} (h : (Fin n → ℤ) → ℝ≥0) :
    eLpNorm (fun x => (h x : ℝ≥0∞)) q Measure.count =
      eLpNorm (fun x => (h x : ℝ)) q Measure.count := by
  have e : (fun x => (h x : ℝ≥0∞)) = fun x => ‖(h x : ℝ)‖ₑ := by
    funext x
    rw [Real.enorm_eq_ofReal (NNReal.coe_nonneg _), ENNReal.ofReal_coe_nnreal]
  rw [e]
  exact eLpNorm_enorm _ AEStronglyMeasurable.of_discrete

/-- Helper: `‖g a‖ₑ ≤ max_{b ∈ S} ‖g b‖₊` for `a ∈ S`. -/
lemma enorm_le_coe_finset_sup {α : Type*} {S : Finset α} {g : α → ℂ} {a : α} (ha : a ∈ S) :
    ‖g a‖ₑ ≤ ((S.sup fun b => ‖g b‖₊ : ℝ≥0) : ℝ≥0∞) := by
  rw [enorm_eq_nnnorm]
  exact ENNReal.coe_le_coe.2 (Finset.le_sup (f := fun b => ‖g b‖₊) ha)

/-- **Blueprint Lemma 10.1 (`lem:lifttrunc`), long range, the smoothing errors, all `J`**: there
are `δ > 0` and `C` such that for every `s ≥ 1` and every finitely supported `f`,
`‖sup_{α ∈ 𝓡_s, J ≥ 1} |Lift_{s,α}[Ê_J](D) f|‖_p ≤ C 2^{-δ s} ‖f‖_p` (the supremum over all
integers `J ≥ 1`, as an extended nonnegative function; in particular over all `J > J_s`),
from the finite-set bound and Lemma 2.1 (`lem:finite`). -/
theorem lift_smoothErr_sup (hn : 1 ≤ n) (hd : 1 ≤ d) (hΩ : IsSWProfile Ω) (hp : 1 < p) :
    ∃ δ : ℝ, 0 < δ ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ s : ℕ, 1 ≤ s →
      ∀ f : (Fin n → ℤ) → ℂ, (Function.support f).Finite →
        eLpNorm (fun x => ⨆ J : ℕ, ⨆ (_ : 1 ≤ J), (liftRat s).sup fun aq =>
            ‖latMult (liftSym n d Ω p s aq.1 aq.2 (𝓕 (smoothErr Ω J))) f x‖ₑ)
          (ENNReal.ofReal p) Measure.count ≤
        ENNReal.ofReal (C * (2 : ℝ) ^ (-(δ * s))) * eLpNorm f (ENNReal.ofReal p) Measure.count := by
  obtain ⟨δ, hδ, C, hC, h⟩ := lift_smoothErr_finset hn hd hΩ hp
  refine ⟨δ, hδ, C, hC, fun s hs f hf => ?_⟩
  classical
  refine eLpNorm_iSup_le_of_finset_count ENNReal.ofReal_ne_top _ _ fun F => ?_
  have hF : ∀ J ∈ F.filter (1 ≤ ·), 1 ≤ J := fun J hJ => (Finset.mem_filter.1 hJ).2
  refine le_trans ?_ ((h s hs _ hF f hf).trans_eq' (eLpNorm_coe_nnreal_eq _).symm)
  refine eLpNorm_mono_enorm AEStronglyMeasurable.of_discrete fun x => ?_
  rw [enorm_eq_self, enorm_eq_self]
  refine Finset.sup_le fun J hJ => iSup_le fun hJ1 => Finset.sup_le fun aq haq => ?_
  exact enorm_le_coe_finset_sup (g := fun aJ : (ℕ × ℕ) × ℕ =>
    latMult (liftSym n d Ω p s aJ.1.1 aJ.1.2 (𝓕 (smoothErr Ω aJ.2))) f x)
    (a := (aq, J)) (Finset.mem_product.2 ⟨haq, Finset.mem_filter.2 ⟨hJ, hJ1⟩⟩)

/-! ### Assembly: reduction of eq. (10.1) to the long smooth maximum -/

/-- Helper: for `θ < δ` there is `K` with `(s+1) 2^{-δ s} ≤ K 2^{-θ s}` for all `s ∈ ℕ`. -/
lemma exists_add_one_mul_rpow_le {δ θ : ℝ} (hθδ : θ < δ) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ s : ℕ,
      ((s : ℝ) + 1) * (2 : ℝ) ^ (-(δ * s)) ≤ K * (2 : ℝ) ^ (-(θ * s)) := by
  set b := Real.log 2 * (δ - θ) with hb
  have hb0 : 0 < b := mul_pos (Real.log_pos (by norm_num)) (by linarith)
  have hbi : 0 < b⁻¹ := inv_pos.2 hb0
  refine ⟨1 + b⁻¹, by linarith, fun s => ?_⟩
  have hs0 : (0 : ℝ) ≤ s := Nat.cast_nonneg s
  have hsplit : (2 : ℝ) ^ (-(δ * s)) =
      (2 : ℝ) ^ (-((δ - θ) * s)) * (2 : ℝ) ^ (-(θ * s)) := by
    rw [← Real.rpow_add (by norm_num)]; ring_nf
  have hexp : (2 : ℝ) ^ ((δ - θ) * s) = Real.exp (b * s) := by
    rw [Real.rpow_def_of_pos (by norm_num), hb, mul_assoc]
  have hkey : (s : ℝ) + 1 ≤ (1 + b⁻¹) * (2 : ℝ) ^ ((δ - θ) * s) := by
    rw [hexp]
    have h1 := Real.add_one_le_exp (b * s)
    have h2 : (s : ℝ) + 1 ≤ (1 + b⁻¹) * (b * s + 1) := by
      have e : (1 + b⁻¹) * (b * s + 1) = b * s + 1 + (b⁻¹ * b) * s + b⁻¹ := by ring
      rw [e, inv_mul_cancel₀ hb0.ne']
      have := mul_nonneg hb0.le hs0
      linarith
    exact h2.trans (mul_le_mul_of_nonneg_left h1 (by linarith))
  have hpos : 0 < (2 : ℝ) ^ ((δ - θ) * s) := Real.rpow_pos_of_pos (by norm_num) _
  rw [hsplit, Real.rpow_neg (by norm_num), ← mul_assoc]
  refine mul_le_mul_of_nonneg_right ?_ (Real.rpow_nonneg (by norm_num) _)
  rw [← div_eq_mul_inv, div_le_iff₀ hpos]
  exact hkey

/-- **Blueprint Lemma 10.1 (`lem:lifttrunc`), eq. (10.1) (`eq:lifttrunc`), reduced to the long
smooth maximum** (the remaining obligation): for `n, d ≥ 1`, admissible `Ω` and `1 < p < ∞`,
suppose that there are `δ' > 0` and `C'` such that for every `s ≥ 1` and every finitely
supported `f`,
`‖sup_{α ∈ 𝓡_s, J > J_s} |Lift_{s,α}[τ_J m_K](D) f|‖_p ≤ C' 2^{-δ' s} ‖f‖_p`.
Then there are `θ > 0` and `C` such that for every `s ≥ 1` and every finitely supported `f`,
`‖sup_{α ∈ 𝓡_s, J ≥ 1} |Lift_{s,α}[∑_{1 ≤ j < J} 𝓕 K_j](D) f|‖_p ≤ C 2^{-θ s} ‖f‖_p`
(suprema over integers `J`, as extended nonnegative functions). -/
theorem lift_trunc_of_long (hn : 1 ≤ n) (hd : 1 ≤ d) (hΩ : IsSWProfile Ω) (hp : 1 < p)
    (hlong : ∃ δ : ℝ, 0 < δ ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ s : ℕ, 1 ≤ s →
      ∀ f : (Fin n → ℤ) → ℂ, (Function.support f).Finite →
        eLpNorm (fun x => ⨆ J : ℕ, ⨆ (_ : truncJ n d Ω p s < J), (liftRat s).sup fun aq =>
            ‖latMult (liftSym n d Ω p s aq.1 aq.2
              (fun ξ => bpTau J ξ * dyadicSymbol Ω ξ)) f x‖ₑ)
          (ENNReal.ofReal p) Measure.count ≤
        ENNReal.ofReal (C * (2 : ℝ) ^ (-(δ * s))) * eLpNorm f (ENNReal.ofReal p) Measure.count) :
    ∃ θ : ℝ, 0 < θ ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ s : ℕ, 1 ≤ s →
      ∀ f : (Fin n → ℤ) → ℂ, (Function.support f).Finite →
        eLpNorm (fun x => ⨆ J : ℕ, ⨆ (_ : 1 ≤ J), (liftRat s).sup fun aq =>
            ‖latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω J)) f x‖ₑ)
          (ENNReal.ofReal p) Measure.count ≤
        ENNReal.ofReal (C * (2 : ℝ) ^ (-(θ * s))) * eLpNorm f (ENNReal.ofReal p) Measure.count := by
  obtain ⟨δ₁, hδ₁, C₁, hC₁, hS⟩ := lift_trunc_short hn hd hΩ hp
  obtain ⟨δ₂, hδ₂, C₂, hC₂, hM⟩ := lift_dyadicSymbol_bound hn hd hΩ hp
  obtain ⟨δ₃, hδ₃, C₃, hC₃, hE⟩ := lift_smoothErr_sup hn hd hΩ hp
  obtain ⟨δ₄, hδ₄, C₄, hC₄, hT⟩ := hlong
  set δm := min (min δ₁ δ₂) (min δ₃ δ₄) with hδm
  have hδm0 : 0 < δm := lt_min (lt_min hδ₁ hδ₂) (lt_min hδ₃ hδ₄)
  set θ := δm / 2 with hθ
  have hθ0 : 0 < θ := by rw [hθ]; linarith
  have hθδ : θ < δm := by rw [hθ]; linarith
  have hθ1 : θ < δ₁ := hθδ.trans_le ((min_le_left _ _).trans (min_le_left _ _))
  have hle : ∀ δ, δm ≤ δ → ∀ s : ℕ, (2 : ℝ) ^ (-(δ * s)) ≤ (2 : ℝ) ^ (-(θ * s)) := by
    intro δ hδ s
    refine Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_
    have : (0 : ℝ) ≤ s := Nat.cast_nonneg s
    have : θ ≤ δ := hθδ.le.trans hδ
    nlinarith
  obtain ⟨K, hK0, hK⟩ := exists_add_one_mul_rpow_le hθ1
  refine ⟨θ, hθ0, C₁ * K + C₂ + C₃ + C₄,
    add_nonneg (add_nonneg (add_nonneg (mul_nonneg hC₁ hK0) hC₂) hC₃) hC₄,
    fun s hs f hf => ?_⟩
  have hf1 : Summable fun z => ‖f z‖ := summable_of_finite_support hf
  obtain ⟨B, hB0, hBm, hBτ, hBE, hmm, hmτ, hcE⟩ := long_symbols_bounds hn hΩ
  set SR : (Fin n → ℤ) → ℝ≥0∞ := fun x => ((((liftRat s) ×ˢ (Finset.Icc 1 (truncJ n d Ω p s))).sup
    fun aJ => ‖latMult (liftSym n d Ω p s aJ.1.1 aJ.1.2 (truncSym Ω aJ.2)) f x‖₊ : ℝ≥0) :
      ℝ≥0∞) with hSR
  set MK : (Fin n → ℤ) → ℝ≥0∞ := fun x => (((liftRat s).sup fun aq =>
    ‖latMult (liftSym n d Ω p s aq.1 aq.2 (dyadicSymbol Ω)) f x‖₊ : ℝ≥0) : ℝ≥0∞) with hMK
  set TA : (Fin n → ℤ) → ℝ≥0∞ := fun x => ⨆ J : ℕ, ⨆ (_ : truncJ n d Ω p s < J),
    (liftRat s).sup fun aq => ‖latMult (liftSym n d Ω p s aq.1 aq.2
      (fun ξ => bpTau J ξ * dyadicSymbol Ω ξ)) f x‖ₑ with hTA
  set EE : (Fin n → ℤ) → ℝ≥0∞ := fun x => ⨆ J : ℕ, ⨆ (_ : 1 ≤ J),
    (liftRat s).sup fun aq => ‖latMult (liftSym n d Ω p s aq.1 aq.2
      (𝓕 (smoothErr Ω J))) f x‖ₑ with hEE
  -- the pointwise splitting into the short range and the three long range pieces
  have hpt : ∀ x, (⨆ J : ℕ, ⨆ (_ : 1 ≤ J), (liftRat s).sup fun aq =>
      ‖latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω J)) f x‖ₑ) ≤
        SR x + MK x + TA x + EE x := by
    intro x
    refine iSup_le fun J => iSup_le fun hJ => Finset.sup_le fun aq haq => ?_
    by_cases hJs : J ≤ truncJ n d Ω p s
    · have h1 : ‖latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω J)) f x‖ₑ ≤ SR x :=
        enorm_le_coe_finset_sup (g := fun aJ : (ℕ × ℕ) × ℕ =>
          latMult (liftSym n d Ω p s aJ.1.1 aJ.1.2 (truncSym Ω aJ.2)) f x) (a := (aq, J))
          (Finset.mem_product.2 ⟨haq, Finset.mem_Icc.2 ⟨hJ, hJs⟩⟩)
      refine h1.trans ?_
      rw [add_assoc, add_assoc]
      exact le_self_add
    · push Not at hJs
      have hJ' : (1 : ℤ) ≤ J := by exact_mod_cast hJ
      have e1 := latMult_liftSym_sub (d := d) (Ω := Ω) (p := p) (s := s) (a := aq.1) (q := aq.2)
        (m₁ := fun ξ => dyadicSymbol Ω ξ - bpTau J ξ * dyadicSymbol Ω ξ)
        (m₂ := 𝓕 (smoothErr Ω J)) (hmm.sub (hmτ J)) (hcE J hJ').aestronglyMeasurable
        (B := B + B) (fun ξ => (norm_sub_le _ _).trans (add_le_add (hBm ξ) (hBτ J ξ)))
        (fun ξ => (hBE J hJ' ξ).trans (by linarith)) hf1 x
      have e2 := latMult_liftSym_sub (d := d) (Ω := Ω) (p := p) (s := s) (a := aq.1) (q := aq.2)
        (m₁ := dyadicSymbol Ω) (m₂ := fun ξ => bpTau J ξ * dyadicSymbol Ω ξ) hmm (hmτ J)
        (B := B) hBm (hBτ J) hf1 x
      beta_reduce at e1 e2
      rw [truncSym_eq_sub hn hΩ hJ, e1, e2]
      have h1 : ‖latMult (liftSym n d Ω p s aq.1 aq.2 (dyadicSymbol Ω)) f x‖ₑ ≤ MK x :=
        enorm_le_coe_finset_sup (g := fun aq : ℕ × ℕ =>
          latMult (liftSym n d Ω p s aq.1 aq.2 (dyadicSymbol Ω)) f x) haq
      have h2 : ‖latMult (liftSym n d Ω p s aq.1 aq.2
          (fun ξ => bpTau J ξ * dyadicSymbol Ω ξ)) f x‖ₑ ≤ TA x :=
        le_iSup_of_le J (le_iSup_of_le hJs (Finset.le_sup (f := fun aq : ℕ × ℕ =>
          ‖latMult (liftSym n d Ω p s aq.1 aq.2
            (fun ξ => bpTau J ξ * dyadicSymbol Ω ξ)) f x‖ₑ) haq))
      have h3 : ‖latMult (liftSym n d Ω p s aq.1 aq.2 (𝓕 (smoothErr Ω J))) f x‖ₑ ≤ EE x :=
        le_iSup_of_le J (le_iSup_of_le hJ (Finset.le_sup (f := fun aq : ℕ × ℕ =>
          ‖latMult (liftSym n d Ω p s aq.1 aq.2 (𝓕 (smoothErr Ω J))) f x‖ₑ) haq))
      calc _ ≤ ‖latMult (liftSym n d Ω p s aq.1 aq.2 (dyadicSymbol Ω)) f x -
              latMult (liftSym n d Ω p s aq.1 aq.2
                (fun ξ => bpTau J ξ * dyadicSymbol Ω ξ)) f x‖ₑ +
            ‖latMult (liftSym n d Ω p s aq.1 aq.2 (𝓕 (smoothErr Ω J))) f x‖ₑ := enorm_sub_le
        _ ≤ ‖latMult (liftSym n d Ω p s aq.1 aq.2 (dyadicSymbol Ω)) f x‖ₑ +
              ‖latMult (liftSym n d Ω p s aq.1 aq.2
                (fun ξ => bpTau J ξ * dyadicSymbol Ω ξ)) f x‖ₑ +
            ‖latMult (liftSym n d Ω p s aq.1 aq.2 (𝓕 (smoothErr Ω J))) f x‖ₑ :=
          add_le_add enorm_sub_le le_rfl
        _ ≤ MK x + TA x + EE x := add_le_add (add_le_add h1 h2) h3
        _ ≤ SR x + MK x + TA x + EE x := by
          rw [add_assoc (SR x), add_assoc (SR x)]
          rw [add_assoc (MK x)]
          exact le_add_self
  have hp1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hp.le
  set X : ℝ := (2 : ℝ) ^ (-(θ * s)) with hX
  have hX0 : 0 ≤ X := Real.rpow_nonneg (by norm_num) _
  set nf := eLpNorm f (ENNReal.ofReal p) Measure.count
  have hSRb : eLpNorm SR (ENNReal.ofReal p) Measure.count ≤ ENNReal.ofReal (C₁ * K * X) * nf := by
    rw [hSR, eLpNorm_coe_nnreal_eq]
    refine (hS s hs f hf).trans (mul_le_mul_left (ENNReal.ofReal_le_ofReal ?_) _)
    have := hK s
    rw [mul_assoc, mul_assoc]
    exact mul_le_mul_of_nonneg_left this hC₁
  have hMKb : eLpNorm MK (ENNReal.ofReal p) Measure.count ≤ ENNReal.ofReal (C₂ * X) * nf := by
    rw [hMK, eLpNorm_coe_nnreal_eq]
    refine (hM s hs f hf).trans (mul_le_mul_left (ENNReal.ofReal_le_ofReal ?_) _)
    exact mul_le_mul_of_nonneg_left (hle δ₂ ((min_le_left _ _).trans (min_le_right _ _)) s) hC₂
  have hTAb : eLpNorm TA (ENNReal.ofReal p) Measure.count ≤ ENNReal.ofReal (C₄ * X) * nf := by
    refine (hT s hs f hf).trans (mul_le_mul_left (ENNReal.ofReal_le_ofReal ?_) _)
    exact mul_le_mul_of_nonneg_left (hle δ₄ ((min_le_right _ _).trans (min_le_right _ _)) s) hC₄
  have hEEb : eLpNorm EE (ENNReal.ofReal p) Measure.count ≤ ENNReal.ofReal (C₃ * X) * nf := by
    refine (hE s hs f hf).trans (mul_le_mul_left (ENNReal.ofReal_le_ofReal ?_) _)
    exact mul_le_mul_of_nonneg_left (hle δ₃ ((min_le_right _ _).trans (min_le_left _ _)) s) hC₃
  calc eLpNorm (fun x => ⨆ J : ℕ, ⨆ (_ : 1 ≤ J), (liftRat s).sup fun aq =>
          ‖latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω J)) f x‖ₑ)
          (ENNReal.ofReal p) Measure.count
      ≤ eLpNorm (SR + MK + TA + EE) (ENNReal.ofReal p) Measure.count := by
        refine eLpNorm_mono_enorm AEStronglyMeasurable.of_discrete fun x => ?_
        rw [enorm_eq_self, enorm_eq_self]
        exact hpt x
    _ ≤ eLpNorm SR (ENNReal.ofReal p) Measure.count + eLpNorm MK (ENNReal.ofReal p) Measure.count +
          eLpNorm TA (ENNReal.ofReal p) Measure.count +
          eLpNorm EE (ENNReal.ofReal p) Measure.count := by
        refine (eLpNorm_add_le hp1).trans (add_le_add ?_ le_rfl)
        refine (eLpNorm_add_le hp1).trans (add_le_add ?_ le_rfl)
        exact eLpNorm_add_le hp1
    _ ≤ ENNReal.ofReal (C₁ * K * X) * nf + ENNReal.ofReal (C₂ * X) * nf +
          ENNReal.ofReal (C₄ * X) * nf + ENNReal.ofReal (C₃ * X) * nf :=
        add_le_add (add_le_add (add_le_add hSRb hMKb) hTAb) hEEb
    _ = ENNReal.ofReal ((C₁ * K + C₂ + C₃ + C₄) * X) * nf := by
        rw [← add_mul, ← add_mul, ← add_mul, ← ENNReal.ofReal_add (by positivity) (by positivity),
          ← ENNReal.ofReal_add (by positivity) (by positivity),
          ← ENNReal.ofReal_add (by positivity) (by positivity)]
        congr 2
        ring

/-! ### The long smooth maximum `τ_J m_K`, `J > J_s` (second part of the proof) -/

/-! #### Symbol calculus: Gauss sums, the expansion of `Lift`, modulation, products -/

/-- `|S(α, β)| ≤ 1`. -/
lemma norm_gaussSum_le_one (a : ℕ) {q : ℕ} (hq : 1 ≤ q) (b : Fin n → Fin q) :
    ‖gaussSum n d a q b‖ ≤ 1 := by
  unfold gaussSum
  rw [norm_mul, norm_inv, norm_pow, Complex.norm_natCast]
  have hq0 : (0 : ℝ) < (q : ℝ) ^ n := by
    have : (0 : ℝ) < q := by exact_mod_cast hq
    positivity
  rw [inv_mul_le_iff₀ hq0, mul_one]
  refine (norm_sum_le _ _).trans ?_
  simp [norm_eC]

/-- The lifted operator as a sum of modulated periodic multipliers:
`Lift_{s,a/q}[m](D) f(x) = ∑_b S(a/q, b/q) e(x · b/q) (m χ_s)_per(D) (M_{-b/q} f)(x)`. -/
lemma latMult_liftSym_eq_sum {s a q : ℕ} {m : EuclideanSpace ℝ (Fin n) → ℂ}
    (hm : Integrable fun ξ => m ξ * (liftChi n d Ω p s ξ : ℂ))
    {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) (x : Fin n → ℤ) :
    latMult (liftSym n d Ω p s a q m) f x = ∑ b : Fin n → Fin q, gaussSum n d a q b *
      (eC (inner ℝ (latEmbed x) (gridPt q b)) *
        latMult (periodize fun η => m η * (liftChi n d Ω p s η : ℂ))
          (latModulate (-gridPt q b) f) x) := by
  have e : liftSym n d Ω p s a q m = fun ξ => ∑ b : Fin n → Fin q, gaussSum n d a q b *
      (fun ξ => periodize (fun η => m η * (liftChi n d Ω p s η : ℂ)) (ξ - gridPt q b)) ξ := rfl
  rw [e, latMult_sum_mul _ _ (fun b _ => ?_) hf x]
  · refine Finset.sum_congr rfl fun b _ => ?_
    rw [latMult_comp_sub (periodize_add_latEmbed _) (gridPt q b) f]
    rfl
  · simp_rw [periodize_comp_sub]
    exact integrableOn_periodize (hm.comp_sub_right _)

/-- `(e(-u · η) g)_per = e(-u · ζ) g_per` for `u ∈ ℤⁿ`. -/
lemma periodize_eC_mul (u : Fin n → ℤ) (g : EuclideanSpace ℝ (Fin n) → ℂ)
    (ζ : EuclideanSpace ℝ (Fin n)) :
    periodize (fun η => eC (-inner ℝ (latEmbed u) η) * g η) ζ =
      eC (-inner ℝ (latEmbed u) ζ) * periodize g ζ := by
  unfold periodize
  rw [← tsum_mul_left]
  congr 1; funext k
  simp only
  congr 1
  rw [inner_sub_right, neg_sub, sub_eq_add_neg, eC_add, inner_latEmbed_latEmbed, eC_intCast,
    one_mul]

/-- Output translation: `[e(-u · ξ) P](D) g (x) = P(D) g (x - u)`. -/
lemma latMult_eC_mul (u : Fin n → ℤ) (P : EuclideanSpace ℝ (Fin n) → ℂ)
    (g : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) :
    latMult (fun ξ => eC (-inner ℝ (latEmbed u) ξ) * P ξ) g x = latMult P g (x - u) := by
  unfold latMult
  congr 1; funext ξ
  rw [latEmbed_sub, inner_sub_left, sub_eq_add_neg, eC_add]; ring

/-- Products of periodizations of symbols supported in `[-1/4, 1/4]ⁿ` are periodizations of the
products. -/
lemma periodize_mul_eq {A B : EuclideanSpace ℝ (Fin n) → ℂ}
    (hA : ∀ η, A η ≠ 0 → ∀ i, |η i| ≤ 1 / 4) (hB : ∀ η, B η ≠ 0 → ∀ i, |η i| ≤ 1 / 4)
    (ζ : EuclideanSpace ℝ (Fin n)) :
    periodize (fun η => A η * B η) ζ = periodize A ζ * periodize B ζ := by
  have huniq : ∀ k k' : Fin n → ℤ, (∀ i, |(ζ - latEmbed k) i| ≤ 1 / 4) →
      (∀ i, |(ζ - latEmbed k') i| ≤ 1 / 4) → k = k' := by
    intro k k' hk hk'
    refine eq_of_abs_sub_intCast_le (ε := 1 / 8) (η := ζ) (by norm_num) (fun i => ?_) (fun i => ?_)
    · have := hk i; simp only [PiLp.sub_apply, latEmbed_apply] at this; linarith
    · have := hk' i; simp only [PiLp.sub_apply, latEmbed_apply] at this; linarith
  by_cases h : ∃ k : Fin n → ℤ, B (ζ - latEmbed k) ≠ 0
  · obtain ⟨k, hk⟩ := h
    have hB' : periodize B ζ = B (ζ - latEmbed k) := by
      rw [periodize, tsum_eq_single k]
      intro k' hk'
      by_contra h'
      exact hk' (huniq _ _ (hB _ h') (hB _ hk))
    have hA' : periodize A ζ = A (ζ - latEmbed k) := by
      rw [periodize, tsum_eq_single k]
      intro k' hk'
      by_contra h'
      exact hk' (huniq _ _ (hA _ h') (hB _ hk))
    rw [hA', hB', periodize, tsum_eq_single k]
    intro k' hk'
    by_contra h'
    have h2 : B (ζ - latEmbed k') ≠ 0 := fun h0 => h' (by simp [h0])
    exact hk' (huniq _ _ (hB _ h2) (hB _ hk))
  · push Not at h
    have h1 : periodize B ζ = 0 := by simp [periodize, h]
    have h2 : periodize (fun η => A η * B η) ζ = 0 := by simp [periodize, h]
    rw [h1, h2, mul_zero]

/-- `supp τ_J ⊆ [-1/16, 1/16]ⁿ` for `J ≥ 0`. -/
lemma bpTau_ne_zero_abs_le {J : ℤ} (hJ : 0 ≤ J) (η : EuclideanSpace ℝ (Fin n))
    (hη : bpTau J η ≠ 0) (i : Fin n) : |η i| ≤ 1 / 16 := by
  by_contra h
  push Not at h
  apply hη
  refine bpTau_eq_zero J ⟨i, lt_of_le_of_lt ?_ h⟩
  have : (2 : ℝ) ^ (-J) ≤ 1 := zpow_le_one_of_nonpos₀ (by norm_num) (by omega)
  linarith

lemma integrable_bpTau {J : ℤ} (hJ : 0 ≤ J) : Integrable (bpTau (n := n) J) :=
  (continuous_bpTau J).integrable_of_hasCompactSupport
    (HasCompactSupport.intro (isCompact_box (1 / 16)) fun ξ hξ => by
      by_contra h
      exact hξ (bpTau_ne_zero_abs_le hJ ξ h))

/-- `𝓕⁻ τ_J = φ_J`. -/
lemma fourierInv_bpTau {J : ℤ} (hJ : 0 ≤ J) : 𝓕⁻ (bpTau (n := n) J) = bpPhiDilC J := by
  have e : bpTau (n := n) J = 𝓕 (bpPhiDilC J) := funext fun ξ => (fourier_bpPhiDil J ξ).symm
  have hi : Integrable (𝓕 (bpPhiDilC (n := n) J)) := e ▸ integrable_bpTau hJ
  rw [e]
  exact (contDiff_bpPhiDilC J).continuous.fourierInv_fourier_eq (integrable_bpPhiDilC J) hi

/-- The lattice kernel of `(τ_J)_per` is the sampled `φ_J`. -/
lemma latKernel_periodize_bpTau {J : ℤ} (hJ : 0 ≤ J) (y : Fin n → ℤ) :
    latKernel (periodize (bpTau J)) y = (bpPhiDil J (latEmbed y) : ℂ) := by
  rw [latKernel_periodize (integrable_bpTau hJ), fourierInv_bpTau hJ]; rfl

/-- The sampled `φ_J` is in `ℓ¹` (`J ≥ 0`). -/
lemma summable_bpPhiDil_latEmbed {J : ℤ} (hJ : 0 ≤ J) :
    Summable fun y : Fin n → ℤ => ‖(bpPhiDil J (latEmbed y) : ℂ)‖ := by
  have hR : (1 : ℝ) ≤ 2 ^ J := one_le_zpow₀ (by norm_num) hJ
  refine Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun y => ?_)
    ((summable_latEnvelope_and_tsum_le (n := n) hR).1.mul_left (bpPhiConst n))
  rw [Complex.norm_real, Real.norm_of_nonneg (bpPhiDil_nonneg _ _)]
  exact bpPhiDil_le_envelope J _

lemma continuous_periodize_bpTau {J : ℤ} (hJ : 0 ≤ J) :
    Continuous (periodize (bpTau (n := n) J)) :=
  continuous_periodize_of_support (continuous_bpTau J) (c := 1 / 16) (by norm_num)
    (bpTau_ne_zero_abs_le hJ)

/-- Blueprint Lemma 6.1 in the form used for (10.3): multiplication of a symbol `g` supported in
`[-1/4, 1/4]ⁿ` by `τ_J` corresponds, after periodization, to convolution with the sampled `φ_J`. -/
lemma latMult_periodize_bpTau_mul {J : ℤ} (hJ : 0 ≤ J) {g : EuclideanSpace ℝ (Fin n) → ℂ}
    (hg : Integrable g) (hgs : ∀ η, g η ≠ 0 → ∀ i, |η i| ≤ 1 / 4) {f : (Fin n → ℤ) → ℂ}
    (hf : Summable fun z => ‖f z‖) (x : Fin n → ℤ) :
    latMult (periodize fun η => bpTau J η * g η) f x =
      ∑' y, (bpPhiDil J (latEmbed y) : ℂ) * latMult (periodize g) f (x - y) := by
  have e : periodize (fun η => bpTau J η * g η) =
      fun ξ => periodize (bpTau J) ξ * periodize g ξ :=
    funext (periodize_mul_eq (fun η h i => (bpTau_ne_zero_abs_le hJ η h i).trans (by norm_num))
      hgs)
  rw [e, latMult_mul_eq_tsum (continuous_periodize_bpTau hJ) (periodize_add_latEmbed _)
    ((summable_bpPhiDil_latEmbed hJ).congr fun y => by rw [latKernel_periodize_bpTau hJ])
    (integrableOn_periodize hg) hf x]
  simp_rw [latKernel_periodize_bpTau hJ]

/-! #### The operators `K_s`, `G_β = K_s M_{-β} f` and `H_{α,v}` -/

/-- The symbol `(m_K χ_s)_per` of the lattice operator `K_s` of Blueprint Lemma 10.1. -/
noncomputable def truncKs (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ) :
    EuclideanSpace ℝ (Fin n) → ℂ :=
  periodize fun η => dyadicSymbol Ω η * (liftChi n d Ω p s η : ℂ)

/-- `G_β = K_s M_{-β} f`, `β = b/q`, of Blueprint Lemma 10.1. -/
noncomputable def truncG (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s q : ℕ)
    (b : Fin n → Fin q) (f : (Fin n → ℤ) → ℂ) : (Fin n → ℤ) → ℂ :=
  latMult (truncKs n d Ω p s) (latModulate (-gridPt q b) f)

/-- `H_{α,v}(z) = ∑_{β ∈ T[q]} S(α, β) e(v · β) G_β(z)`, `α = a/q`, of Blueprint Lemma 10.1
(Mathlib sign). -/
noncomputable def truncH (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s a q : ℕ)
    (f : (Fin n → ℤ) → ℂ) (v z : Fin n → ℤ) : ℂ :=
  ∑ b : Fin n → Fin q, gaussSum n d a q b *
    (eC (inner ℝ (latEmbed v) (gridPt q b)) * truncG n d Ω p s q b f z)

lemma integrable_dyadicSymbol_mul_liftChi (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) (s : ℕ) :
    Integrable fun η => dyadicSymbol Ω η * (liftChi n d Ω p s η : ℂ) := by
  obtain ⟨B, -, hB, -, -, hm, -, -⟩ := long_symbols_bounds hn hΩ
  exact integrable_mul_liftChi hm fun ξ _ => hB ξ

/-- `supp (m χ_s) ⊆ [-1/8, 1/8]ⁿ`. -/
lemma mul_liftChi_ne_zero_abs_le {s : ℕ} {m : EuclideanSpace ℝ (Fin n) → ℂ}
    (η : EuclideanSpace ℝ (Fin n)) (h : m η * (liftChi n d Ω p s η : ℂ) ≠ 0) (i : Fin n) :
    |η i| ≤ 1 / 8 := by
  have h1 : liftChi n d Ω p s η ≠ 0 := fun h0 => h (by rw [h0, Complex.ofReal_zero, mul_zero])
  have h2 := support_liftChi (n := n) (d := d) (Ω := Ω) (p := p) s h1 i
  have hL := eight_le_liftL (n := n) (d := d) (Ω := Ω) (p := p) s
  refine h2.trans ?_
  rw [div_le_div_iff₀ (by linarith) (by norm_num)]; linarith

lemma summable_latModulate {β : EuclideanSpace ℝ (Fin n)} {f : (Fin n → ℤ) → ℂ}
    (hf : Summable fun z => ‖f z‖) : Summable fun z => ‖latModulate β f z‖ :=
  hf.congr fun z => by rw [latModulate, norm_mul, norm_eC, one_mul]

/-- `G_β` is bounded for `f ∈ ℓ¹`. -/
lemma truncG_bounded (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) (s q : ℕ) (b : Fin n → Fin q)
    {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) :
    ∃ M : ℝ, ∀ z, ‖truncG n d Ω p s q b f z‖ ≤ M :=
  ⟨_, fun z => norm_latMult_le (integrableOn_periodize
    (integrable_dyadicSymbol_mul_liftChi (d := d) (p := p) hn hΩ s)) (summable_latModulate hf) z⟩

/-- **Eq. (10.3) (`eq:Ishift`) at `u = 0`**: for `J ≥ 0`,
`Lift_{s,a/q}[τ_J m_K](D) f(x) = ∑_y φ_J(y) H_{a/q,x}(x - y)` (`f ∈ ℓ¹`). -/
lemma latMult_liftSym_bpTau_eq (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) {J : ℤ} (hJ : 0 ≤ J)
    (s a q : ℕ) {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) (x : Fin n → ℤ) :
    latMult (liftSym n d Ω p s a q (fun ξ => bpTau J ξ * dyadicSymbol Ω ξ)) f x =
      ∑' y, (bpPhiDil J (latEmbed y) : ℂ) * truncH n d Ω p s a q f x (x - y) := by
  obtain ⟨B, -, -, hBτ, -, hm, hmτ, -⟩ := long_symbols_bounds hn hΩ
  have hint : Integrable fun ξ => (bpTau J ξ * dyadicSymbol Ω ξ) * (liftChi n d Ω p s ξ : ℂ) :=
    integrable_mul_liftChi (hmτ J) fun ξ _ => hBτ J ξ
  rw [latMult_liftSym_eq_sum hint hf x]
  have e2 : ∀ b : Fin n → Fin q, latMult (periodize fun η =>
      (bpTau J η * dyadicSymbol Ω η) * (liftChi n d Ω p s η : ℂ)) (latModulate (-gridPt q b) f) x =
      ∑' y, (bpPhiDil J (latEmbed y) : ℂ) * truncG n d Ω p s q b f (x - y) := by
    intro b
    have e3 : (fun η => (bpTau J η * dyadicSymbol Ω η) * (liftChi n d Ω p s η : ℂ)) =
        fun η => bpTau J η * (dyadicSymbol Ω η * (liftChi n d Ω p s η : ℂ)) := by
      funext η; ring
    rw [e3]
    exact latMult_periodize_bpTau_mul hJ (integrable_dyadicSymbol_mul_liftChi hn hΩ s)
      (fun η h i => (mul_liftChi_ne_zero_abs_le η h i).trans (by norm_num))
      (summable_latModulate hf) x
  simp_rw [e2]
  unfold truncH
  simp_rw [Finset.mul_sum]
  rw [Summable.tsum_finsetSum]
  · refine Finset.sum_congr rfl fun b _ => ?_
    rw [← tsum_mul_left, ← tsum_mul_left]
    congr 1; funext y; ring
  · intro b _
    obtain ⟨M, hM⟩ := truncG_bounded (d := d) (p := p) hn hΩ s q b hf
    refine Summable.of_norm_bounded ((summable_bpPhiDil_latEmbed hJ).mul_right M) fun y => ?_
    rw [norm_mul, norm_mul, norm_mul, norm_eC, one_mul]
    refine mul_le_mul_of_nonneg_left ?_ (norm_nonneg _)
    calc ‖gaussSum n d a q b‖ * ‖truncG n d Ω p s q b f (x - y)‖
        ≤ 1 * M := by
          rcases Nat.eq_zero_or_pos q with rfl | hq
          · exact (b ⟨0, by omega⟩).elim0
          · exact mul_le_mul (norm_gaussSum_le_one a hq b) (hM _) (norm_nonneg _) zero_le_one
      _ = M := one_mul M

/-- **The inner expression of the averaging argument**: `u ∈ ℤⁿ`,
`Lift_{s,a/q}[e(-u · ξ) m_K](D) f(x) = H_{a/q,x}(x - u)` (`f ∈ ℓ¹`). -/
lemma latMult_liftSym_eC_eq (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) (u : Fin n → ℤ) (s a q : ℕ)
    {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) (x : Fin n → ℤ) :
    latMult (liftSym n d Ω p s a q
        (fun ξ => eC (-inner ℝ (latEmbed u) ξ) * dyadicSymbol Ω ξ)) f x =
      truncH n d Ω p s a q f x (x - u) := by
  obtain ⟨B, -, hB, -, -, hm, -, -⟩ := long_symbols_bounds hn hΩ
  have hint : Integrable fun ξ => (eC (-inner ℝ (latEmbed u) ξ) * dyadicSymbol Ω ξ) *
      (liftChi n d Ω p s ξ : ℂ) := by
    refine integrable_mul_liftChi (((by fun_prop : Continuous fun ξ : EuclideanSpace ℝ (Fin n) =>
      eC (-inner ℝ (latEmbed u) ξ))).aestronglyMeasurable.mul hm) (B := B) fun ξ _ => ?_
    rw [norm_mul, norm_eC, one_mul]; exact hB ξ
  rw [latMult_liftSym_eq_sum hint hf x]
  unfold truncH truncG
  refine Finset.sum_congr rfl fun b _ => ?_
  have e : periodize (fun η => (eC (-inner ℝ (latEmbed u) η) * dyadicSymbol Ω η) *
      (liftChi n d Ω p s η : ℂ)) =
      fun ζ => eC (-inner ℝ (latEmbed u) ζ) * truncKs n d Ω p s ζ := by
    funext ζ
    rw [truncKs, ← periodize_eC_mul]
    congr 1; funext η; ring
  rw [e, latMult_eC_mul]

/-! #### The translation bound for `φ_J` -/

/-- The translation bound of Blueprint Lemma 10.1: there is `C` such that for all `J ∈ ℤ` and
`‖z‖ ≤ 2^J`, `|φ_J(w) - φ_J(w - z)| ≤ C ‖z‖ 2^{-J} B_{2^J}(w)` (mean value theorem and the
Schwartz derivative bounds for `φ`). -/
lemma exists_norm_bpPhiDil_sub_le (n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (J : ℤ) (w z : EuclideanSpace ℝ (Fin n)), ‖z‖ ≤ (2 : ℝ) ^ J →
      ‖(bpPhiDil J w : ℂ) - (bpPhiDil J (w - z) : ℂ)‖ ≤
        C * ‖z‖ * ((2 : ℝ) ^ J)⁻¹ * envelope n ((2 : ℝ) ^ J) w := by
  obtain ⟨Q, hQ0, hQ⟩ := norm_iteratedFDeriv_bpPhiDilC_le (n := n) 1 (n + 1)
  refine ⟨Q * 2 ^ (n + 1), by positivity, fun J w z hz => ?_⟩
  set R : ℝ := (2 : ℝ) ^ J with hRdef
  have hR : 0 < R := by positivity
  have hM : ∀ t ∈ Icc (0 : ℝ) 1, ‖fderiv ℝ (bpPhiDilC J) (w - t • z)‖ ≤
      Q * 2 ^ (n + 1) * R⁻¹ * envelope n R w := by
    intro t ht
    have h1 := hQ J (w - t • z)
    rw [norm_iteratedFDeriv_one] at h1
    refine h1.trans ?_
    have htz : ‖t • z‖ ≤ R := by
      rw [norm_smul, Real.norm_of_nonneg ht.1]
      calc t * ‖z‖ ≤ 1 * R := mul_le_mul ht.2 hz (norm_nonneg _) zero_le_one
        _ = R := one_mul R
    have htri : ‖w‖ ≤ ‖w - t • z‖ + ‖t • z‖ := by
      have := norm_add_le (w - t • z) (t • z)
      rwa [sub_add_cancel] at this
    set a := 1 + ‖w - t • z‖ / R with ha
    set b := 1 + ‖w‖ / R with hb
    have ha0 : 0 < a := by positivity
    have hb0 : 0 < b := by positivity
    have hlow : b ≤ 2 * a := by
      rw [ha, hb]
      have : ‖w‖ / R ≤ ‖w - t • z‖ / R + 1 := by
        rw [div_add_one hR.ne', div_le_div_iff_of_pos_right hR]; linarith
      have : 0 ≤ ‖w - t • z‖ / R := by positivity
      linarith
    have hpow : b ^ (n + 1) ≤ 2 ^ (n + 1) * a ^ (n + 1) := by
      rw [← mul_pow]; exact pow_le_pow_left₀ hb0.le hlow _
    have hR' : ((2 : ℝ) ^ J) = R := rfl
    rw [hR', envelope, ← hb]
    rw [div_le_iff₀ (by positivity)]
    calc Q = Q * 2 ^ (n + 1) * R⁻¹ * ((R ^ n)⁻¹ * (b ^ (n + 1))⁻¹) *
          (R ^ (n + 1) * b ^ (n + 1) / 2 ^ (n + 1)) := by
          field_simp; ring
      _ ≤ Q * 2 ^ (n + 1) * R⁻¹ * ((R ^ n)⁻¹ * (b ^ (n + 1))⁻¹) * (R ^ (n + 1) * a ^ (n + 1)) := by
          refine mul_le_mul_of_nonneg_left ?_ (by positivity)
          rw [div_le_iff₀ (by positivity), mul_assoc, mul_comm (a ^ (n + 1))]
          exact mul_le_mul_of_nonneg_left hpow (by positivity)
  have hdiff : Differentiable ℝ (bpPhiDilC (n := n) J) :=
    (contDiff_bpPhiDilC J).differentiable (by simp)
  have h := norm_sub_le_of_norm_fderiv_segment hdiff hM (s := 1) ⟨zero_le_one, le_rfl⟩
  rw [one_smul, mul_one] at h
  rw [norm_sub_rev]
  calc ‖(bpPhiDil J (w - z) : ℂ) - (bpPhiDil J w : ℂ)‖
      = ‖bpPhiDilC J (w - z) - bpPhiDilC J w‖ := rfl
    _ ≤ Q * 2 ^ (n + 1) * R⁻¹ * envelope n R w * ‖z‖ := h
    _ = Q * 2 ^ (n + 1) * ‖z‖ * R⁻¹ * envelope n R w := by ring

/-! #### Bounds and periodicity of `H_{α,v}` -/

lemma norm_truncH_le (s a : ℕ) {q : ℕ} (hq : 1 ≤ q) (f : (Fin n → ℤ) → ℂ) (v z : Fin n → ℤ) :
    ‖truncH n d Ω p s a q f v z‖ ≤ ∑ b : Fin n → Fin q, ‖truncG n d Ω p s q b f z‖ := by
  unfold truncH
  refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun b _ => ?_)
  rw [norm_mul, norm_mul, norm_eC, one_mul]
  calc ‖gaussSum n d a q b‖ * ‖truncG n d Ω p s q b f z‖ ≤ 1 * ‖truncG n d Ω p s q b f z‖ :=
        mul_le_mul_of_nonneg_right (norm_gaussSum_le_one a hq b) (norm_nonneg _)
    _ = _ := one_mul _

/-- `H_{α,v}` depends on `v` only modulo `q`. -/
lemma truncH_congr (s a : ℕ) {q : ℕ} (hq : 1 ≤ q) (f : (Fin n → ℤ) → ℂ) {v v' : Fin n → ℤ}
    (h : ∀ i, (q : ℤ) ∣ v i - v' i) (z : Fin n → ℤ) :
    truncH n d Ω p s a q f v z = truncH n d Ω p s a q f v' z := by
  unfold truncH
  refine Finset.sum_congr rfl fun b _ => ?_
  choose k hk using h
  have hq0 : (q : ℝ) ≠ 0 := by exact_mod_cast (show q ≠ 0 by omega)
  have e : inner ℝ (latEmbed v) (gridPt q b) =
      inner ℝ (latEmbed v') (gridPt q b) + ((∑ i, k i * ((b i : ℕ) : ℤ) : ℤ) : ℝ) := by
    simp only [gridPt, PiLp.inner_apply, latEmbed_apply, RCLike.inner_apply, conj_trivial]
    push_cast
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun i _ => ?_
    have hki : (v i : ℝ) = v' i + q * k i := by
      have := congrArg (fun t : ℤ => (t : ℝ)) (hk i)
      push_cast at this; linarith
    rw [hki]
    field_simp
  rw [e, eC_add, eC_intCast, mul_one]

/-- The change of variables of the averaging argument: for `F(v, z)` depending on `v` only
modulo `Q`, `∑_{u ∈ 𝒱} ∑_x F(x, x - u) = ∑_{v ∈ 𝒱} ∑_z F(v, z)`, `𝒱 = {0, …, Q-1}ⁿ`
(the bijection `(x, u) ↦ (z = x - u, v = x mod Q)`). -/
lemma sum_tsum_sub_finIntVec_eq {Q : ℕ} [NeZero Q]
    (F : (Fin n → ℤ) → (Fin n → ℤ) → ℝ≥0∞)
    (hF : ∀ v v' z, (∀ i, (Q : ℤ) ∣ v i - v' i) → F v z = F v' z) :
    ∑ u : Fin n → Fin Q, ∑' x, F x (x - finIntVec u) =
      ∑ v : Fin n → Fin Q, ∑' z, F (finIntVec v) z := by
  have h1 : ∀ u : Fin n → Fin Q, ∑' x, F x (x - finIntVec u) = ∑' z, F (z + finIntVec u) z := by
    intro u
    rw [← (Equiv.addRight (finIntVec u)).tsum_eq]
    simp only [Equiv.coe_addRight, add_sub_cancel_right]
  simp_rw [h1]
  rw [← Summable.tsum_finsetSum (fun _ _ => ENNReal.summable),
    ← Summable.tsum_finsetSum (fun _ _ => ENNReal.summable)]
  congr 1; funext z
  have hQ : 1 ≤ Q := Nat.one_le_iff_ne_zero.2 (NeZero.ne Q)
  set c : Fin n → Fin Q := resVec hQ z with hc
  refine Fintype.sum_equiv (Equiv.addLeft c) _ _ fun u => hF _ _ _ fun i => ?_
  have hci : ((c i : ℕ) : ℤ) = z i % Q := finIntVec_resVec hQ z i
  have e : finIntVec ((Equiv.addLeft c) u) i = (z i % Q + ((u i : ℕ) : ℤ)) % Q := by
    simp only [Equiv.coe_addLeft, finIntVec, Pi.add_apply, Fin.val_add]
    push_cast
    rw [hci]
  rw [e, Pi.add_apply]
  have hm : (z i % Q + ((u i : ℕ) : ℤ)) % Q ≡ z i + finIntVec u i [ZMOD Q] :=
    (Int.mod_modEq _ _).trans ((Int.mod_modEq _ _).add_right _)
  exact hm.dvd


/-! #### `ℓ^p` bookkeeping for `ℝ≥0∞`-valued functions on `ℤⁿ` -/

lemma eLpNorm_count_ennreal_eq (g : (Fin n → ℤ) → ℝ≥0∞) {p : ℝ} (hp : 0 < p) :
    eLpNorm g (ENNReal.ofReal p) Measure.count = (∑' x, g x ^ p) ^ (1 / p) := by
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simpa using hp) ENNReal.ofReal_ne_top
    AEStronglyMeasurable.of_discrete, ENNReal.toReal_ofReal hp.le, lintegral_count]
  simp only [enorm_eq_self]

lemma eLpNorm_count_const_mul (c : ℝ≥0∞) (g : (Fin n → ℤ) → ℝ≥0∞) {p : ℝ} (hp : 0 < p) :
    eLpNorm (fun x => c * g x) (ENNReal.ofReal p) Measure.count =
      c * eLpNorm g (ENNReal.ofReal p) Measure.count := by
  rw [eLpNorm_count_ennreal_eq _ hp, eLpNorm_count_ennreal_eq _ hp]
  simp_rw [ENNReal.mul_rpow_of_nonneg _ _ hp.le]
  rw [ENNReal.tsum_mul_left, ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul,
    mul_one_div_cancel hp.ne', ENNReal.rpow_one]

lemma tsum_rpow_le_of_eLpNorm_count_le {g : (Fin n → ℤ) → ℝ≥0∞} {X : ℝ≥0∞} {p : ℝ}
    (hp : 0 < p) (h : eLpNorm g (ENNReal.ofReal p) Measure.count ≤ X) :
    ∑' x, g x ^ p ≤ X ^ p := by
  rw [eLpNorm_count_ennreal_eq _ hp] at h
  have h2 := ENNReal.rpow_le_rpow h hp.le
  rwa [← ENNReal.rpow_mul, one_div_mul_cancel hp.ne', ENNReal.rpow_one] at h2

lemma eLpNorm_count_le_of_tsum_rpow_le {g : (Fin n → ℤ) → ℝ≥0∞} {X : ℝ≥0∞} {p : ℝ}
    (hp : 0 < p) (h : ∑' x, g x ^ p ≤ X ^ p) :
    eLpNorm g (ENNReal.ofReal p) Measure.count ≤ X := by
  rw [eLpNorm_count_ennreal_eq _ hp]
  have h2 := ENNReal.rpow_le_rpow h (by positivity : (0 : ℝ) ≤ 1 / p)
  rwa [← ENNReal.rpow_mul, mul_one_div_cancel hp.ne', ENNReal.rpow_one] at h2

/-! #### `K_s` is bounded on `ℓ^p` -/

open scoped Convolution in
/-- Young for a Schwartz cutoff `χ'`: if `M` has Euclidean `L^P` multiplier norm `≤ A` on Schwartz
inputs (`1 ≤ P`) and `‖𝓕⁻ χ'‖_{L¹} ≤ K`, then `M χ'` has multiplier norm `≤ A K`. -/
lemma eLpNorm_fourierInv_mul_schwartz_le (χ' : 𝓢(EuclideanSpace ℝ (Fin n), ℂ)) {K : ℝ}
    (hK : eLpNorm (𝓕⁻ (χ' : EuclideanSpace ℝ (Fin n) → ℂ)) 1 volume ≤ ENNReal.ofReal K)
    (hK0 : 0 ≤ K) {P : ℝ≥0∞} (hP : 1 ≤ P) {M : EuclideanSpace ℝ (Fin n) → ℂ} {A : ℝ}
    (hA : ∀ F : 𝓢(EuclideanSpace ℝ (Fin n), ℂ),
      eLpNorm (𝓕⁻ (fun ξ => M ξ * 𝓕 (F : EuclideanSpace ℝ (Fin n) → ℂ) ξ)) P volume ≤
        ENNReal.ofReal A * eLpNorm F P volume)
    (F : 𝓢(EuclideanSpace ℝ (Fin n), ℂ)) :
    eLpNorm (𝓕⁻ (fun ξ => (M ξ * χ' ξ) * 𝓕 (F : EuclideanSpace ℝ (Fin n) → ℂ) ξ)) P volume ≤
      ENNReal.ofReal (A * K) * eLpNorm F P volume := by
  set φ : 𝓢(EuclideanSpace ℝ (Fin n), ℂ) := 𝓕⁻ χ' with hφ
  set G := SchwartzMap.convolution (ContinuousLinearMap.mul ℂ ℂ) φ F with hG
  have hGF : ∀ ξ, 𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ =
      χ' ξ * 𝓕 (F : EuclideanSpace ℝ (Fin n) → ℂ) ξ := by
    intro ξ
    have h := congrArg (fun H : 𝓢(EuclideanSpace ℝ (Fin n), ℂ) => H ξ)
      (SchwartzMap.fourier_convolution (ContinuousLinearMap.mul ℂ ℂ) φ F)
    simp only [SchwartzMap.pairing_apply_apply, hφ, FourierTransform.fourier_fourierInv_eq,
      ContinuousLinearMap.mul_apply'] at h
    rw [← SchwartzMap.fourier_coe, h, SchwartzMap.fourier_coe]
  have e : (fun ξ => (M ξ * χ' ξ) * 𝓕 (F : EuclideanSpace ℝ (Fin n) → ℂ) ξ) =
      fun ξ => M ξ * 𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ := by
    funext ξ; rw [hGF, mul_assoc]
  rw [e]
  refine (hA G).trans ?_
  have hGc : (G : EuclideanSpace ℝ (Fin n) → ℂ) =
      (φ : EuclideanSpace ℝ (Fin n) → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ, volume]
        (F : EuclideanSpace ℝ (Fin n) → ℂ) :=
    funext fun x => SchwartzMap.convolution_apply _ φ F x
  have hY := (young_convolution_euclidean hP (φ.memLp 1) (F.memLp P)).2.1
  have hφK : eLpNorm (φ : EuclideanSpace ℝ (Fin n) → ℂ) 1 volume ≤ ENNReal.ofReal K := by
    rw [hφ, SchwartzMap.fourierInv_coe]; exact hK
  rw [hGc, ENNReal.ofReal_mul' hK0, mul_assoc]
  gcongr
  exact hY.trans (by gcongr)

/-- Uniform `L¹` bound for `φ_s = 𝓕⁻ χ_s`. -/
lemma exists_eLpNorm_liftPhi_le (n : ℕ) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ (d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ),
      eLpNorm (liftPhi n d Ω p s) 1 volume ≤ ENNReal.ofReal K := by
  obtain ⟨C, hC, h⟩ := norm_liftPhi_le n
  have hE : 0 ≤ envelopeConst n := by unfold envelopeConst; positivity
  refine ⟨C * envelopeConst n, by positivity, fun d Ω p s => ?_⟩
  have hL := liftL_pos (n := n) (d := d) (Ω := Ω) (p := p) s
  obtain ⟨hi, hI⟩ := integrable_envelope_and_integral_le (n := n) hL
  have hmeas : AEStronglyMeasurable (liftPhi n d Ω p s) volume := by
    have e : liftPhi n d Ω p s = ((𝓕⁻ (liftChiSchwartz n d Ω p s) :
        𝓢(EuclideanSpace ℝ (Fin n), ℂ)) : EuclideanSpace ℝ (Fin n) → ℂ) := by
      rw [SchwartzMap.fourierInv_coe]; rfl
    rw [e]
    exact (𝓕⁻ (liftChiSchwartz n d Ω p s) :
      𝓢(EuclideanSpace ℝ (Fin n), ℂ)).continuous.aestronglyMeasurable
  refine (eLpNorm_mono_real (g := fun x => C * envelope n (liftL n d Ω p s) x) hmeas
      (h d Ω p s).1).trans ?_
  rw [eLpNorm_one_eq_lintegral_enorm (hi.const_mul C).aestronglyMeasurable]
  rw [← ofReal_integral_norm_eq_lintegral_enorm (hi.const_mul C)]
  refine ENNReal.ofReal_le_ofReal ?_
  calc ∫ x, ‖C * envelope n (liftL n d Ω p s) x‖
      = ∫ x, C * envelope n (liftL n d Ω p s) x := by
        congr 1; funext x
        rw [Real.norm_of_nonneg (mul_nonneg hC (envelope_nonneg hL x))]
    _ ≤ C * envelopeConst n := by
        rw [integral_const_mul]; exact mul_le_mul_of_nonneg_left hI hC

/-- `K_s = (m_K χ_s)_per(D)` is bounded on `ℓ^p` uniformly in `s` (Blueprint Lemma 10.1, proof:
Lemma 6.2 `sampling_single`, Lemma 4.3 and Young for the cutoff). -/
theorem truncKs_bound (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) (hp : 1 < p) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (s : ℕ) (g : (Fin n → ℤ) → ℂ), (Function.support g).Finite →
      eLpNorm (latMult (truncKs n d Ω p s) g) (ENNReal.ofReal p) Measure.count ≤
        ENNReal.ofReal C * eLpNorm g (ENNReal.ofReal p) Measure.count := by
  obtain ⟨CS, hCS, hS⟩ := sampling_single n
  obtain ⟨A, hA0, hA⟩ := exists_eLpNorm_fourierInv_dyadicSymbol_mul_le hn hΩ hp
  obtain ⟨K, hK0, hK⟩ := exists_eLpNorm_liftPhi_le n
  obtain ⟨B, hB0, hB, -, -, -, -, -⟩ := long_symbols_bounds hn hΩ
  refine ⟨CS * (A * K), by positivity, fun s g hg => ?_⟩
  have hP : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hp.le
  have hKs : eLpNorm (𝓕⁻ ((liftChiSchwartz n d Ω p s : 𝓢(EuclideanSpace ℝ (Fin n), ℂ)) :
      EuclideanSpace ℝ (Fin n) → ℂ)) 1 volume ≤ ENNReal.ofReal K := by
    have e : 𝓕⁻ ((liftChiSchwartz n d Ω p s : 𝓢(EuclideanSpace ℝ (Fin n), ℂ)) :
        EuclideanSpace ℝ (Fin n) → ℂ) = liftPhi n d Ω p s := rfl
    rw [e]; exact hK d Ω p s
  refine hS p hp.le (fun η => dyadicSymbol Ω η * (liftChi n d Ω p s η : ℂ)) B (A * K)
    (integrable_dyadicSymbol_mul_liftChi hn hΩ s).aestronglyMeasurable (fun ξ => ?_)
    (fun η hη i => mul_liftChi_ne_zero_abs_le η hη i) (fun F => ?_) g hg
  · rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (liftChi_nonneg s ξ)]
    calc ‖dyadicSymbol Ω ξ‖ * liftChi n d Ω p s ξ ≤ B * 1 :=
          mul_le_mul (hB ξ) (liftChi_le_one s ξ) (liftChi_nonneg s ξ) hB0
      _ = B := mul_one B
  · exact eLpNorm_fourierInv_mul_schwartz_le (liftChiSchwartz n d Ω p s) hKs hK0 hP hA F

/-! #### The one-element lifted estimate for the translated multipliers `e(-u · ξ) m_K` -/

/-- Output translation on `E`: `𝓕⁻(e(-u · ξ) h)(x) = 𝓕⁻ h (x - u)`. -/
lemma fourierInv_eC_mul (u : EuclideanSpace ℝ (Fin n)) (h : EuclideanSpace ℝ (Fin n) → ℂ) :
    𝓕⁻ (fun ξ => eC (-inner ℝ u ξ) * h ξ) = fun x => 𝓕⁻ h (x - u) := by
  funext x
  rw [fourierInv_eq_integral_eC, fourierInv_eq_integral_eC]
  congr 1; funext ξ
  rw [inner_sub_right, real_inner_comm u ξ, sub_eq_add_neg, eC_add]; ring

/-- **Blueprint Lemma 10.1 (`lem:lifttrunc`), proof: the one-element case of eq. (9.10) for the
translated multipliers**: there are `δ > 0` and `C` such that for every `s ≥ 1`, every `u ∈ ℤⁿ`
and every finitely supported `f`,
`‖sup_{α ∈ 𝓡_s} |Lift_{s,α}[e(-u · ξ) m_K](D) f|‖_p ≤ C 2^{-δ s} ‖f‖_p` (uniformly in `u`: the
multiplier `e(-u · ξ) m_K` is an output translate of `m_K(D)`). -/
theorem lift_eC_dyadicSymbol_bound (hn : 1 ≤ n) (hd : 1 ≤ d) (hΩ : IsSWProfile Ω) (hp : 1 < p) :
    ∃ δ : ℝ, 0 < δ ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ s : ℕ, 1 ≤ s → ∀ u : Fin n → ℤ,
      ∀ f : (Fin n → ℤ) → ℂ, (Function.support f).Finite →
        eLpNorm (fun x => (((liftRat s).sup fun aq =>
            ‖latMult (liftSym n d Ω p s aq.1 aq.2
              (fun ξ => eC (-inner ℝ (latEmbed u) ξ) * dyadicSymbol Ω ξ)) f x‖₊ : ℝ≥0) : ℝ))
          (ENNReal.ofReal p) Measure.count ≤
        ENNReal.ofReal (C * (2 : ℝ) ^ (-(δ * s))) * eLpNorm f (ENNReal.ofReal p) Measure.count := by
  obtain ⟨δ, hδ, CL, hCL, hsq⟩ := lift_square_p n d hn hd Ω hp
  have ht : 1 < 2 * (paramR p : ℝ) := by
    have : (1 : ℝ) ≤ paramR p := by exact_mod_cast one_le_paramR p
    linarith
  obtain ⟨A, hA0, hA⟩ := exists_eLpNorm_fourierInv_dyadicSymbol_mul_le hn hΩ ht
  obtain ⟨B, -, hB, -, -, hm, -, -⟩ := long_symbols_bounds hn hΩ
  refine ⟨δ, hδ, CL * A, mul_nonneg hCL hA0, fun s hs u f hf => ?_⟩
  set mu : EuclideanSpace ℝ (Fin n) → ℂ :=
    fun ξ => eC (-inner ℝ (latEmbed u) ξ) * dyadicSymbol Ω ξ with hmu_def
  have hmu : AEStronglyMeasurable mu volume :=
    ((by fun_prop : Continuous fun ξ : EuclideanSpace ℝ (Fin n) =>
      eC (-inner ℝ (latEmbed u) ξ))).aestronglyMeasurable.mul hm
  have hBu : ∀ ξ, ‖mu ξ‖ ≤ B := fun ξ => by
    simp only [mu]; rw [norm_mul, norm_eC, one_mul]; exact hB ξ
  have hAu : ∀ G : 𝓢(EuclideanSpace ℝ (Fin n), ℂ),
      eLpNorm (𝓕⁻ (fun ξ => mu ξ * 𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ))
        (ENNReal.ofReal (2 * paramR p)) volume ≤
      ENNReal.ofReal A * eLpNorm G (ENNReal.ofReal (2 * paramR p)) volume := by
    intro G
    have e : (fun ξ => mu ξ * 𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ) = fun ξ =>
        eC (-inner ℝ (latEmbed u) ξ) *
          (dyadicSymbol Ω ξ * 𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ) := by
      funext ξ; simp only [mu]; ring
    have hGi : Integrable (𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ)) := by
      rw [← SchwartzMap.fourier_coe]; exact (𝓕 G).integrable
    have hi : Integrable fun ξ => dyadicSymbol Ω ξ * 𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ :=
      hGi.bdd_mul (c := B) hm (Filter.Eventually.of_forall hB)
    rw [e, fourierInv_eC_mul]
    have hc := continuous_fourierInv_of_integrable hi
    have h2 : eLpNorm (fun x => 𝓕⁻ (fun ξ => dyadicSymbol Ω ξ *
        𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ) (x - latEmbed u))
          (ENNReal.ofReal (2 * paramR p)) volume =
        eLpNorm (𝓕⁻ (fun ξ => dyadicSymbol Ω ξ * 𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ))
          (ENNReal.ofReal (2 * paramR p)) volume :=
      eLpNorm_comp_measurePreserving hc.aestronglyMeasurable
        (measurePreserving_sub_right volume (latEmbed u))
    rw [h2]
    exact hA G
  have h := hsq s hs ({()} : Finset Unit) (fun _ => mu) B A (fun _ _ => hmu)
    (fun _ _ => hBu) hA0 (fun ε hε G => ?_) f hf
  · simp only [Finset.sum_singleton] at h
    have e : (fun x => Real.sqrt ((((liftRat s).sup fun aq =>
        ‖latMult (liftSym n d Ω p s aq.1 aq.2 mu) f x‖₊ : ℝ≥0) : ℝ) ^ 2)) =
        fun x => (((liftRat s).sup fun aq =>
          ‖latMult (liftSym n d Ω p s aq.1 aq.2 mu) f x‖₊ : ℝ≥0) : ℝ) := by
      funext x; exact Real.sqrt_sq (NNReal.coe_nonneg _)
    rw [e] at h
    refine h.trans (le_of_eq ?_)
    congr 2; ring
  · simp only [Finset.sum_singleton]
    exact eLpNorm_fourierInv_sign_mul_le hAu (hε () (Finset.mem_singleton_self _)) G


/-! #### The pointwise bound: shifted main term plus shift error -/

/-- `‖u‖ ≤ √n Q` for `u ∈ 𝒱 = {0, …, Q-1}ⁿ`. -/
lemma norm_latEmbed_finIntVec_le {Q : ℕ} (u : Fin n → Fin Q) :
    ‖latEmbed (finIntVec u)‖ ≤ Real.sqrt n * Q := by
  rw [EuclideanSpace.norm_eq]
  have h : ∑ i, ‖(latEmbed (finIntVec u)) i‖ ^ 2 ≤ n * (Q : ℝ) ^ 2 := by
    calc ∑ i, ‖(latEmbed (finIntVec u)) i‖ ^ 2 ≤ ∑ _i : Fin n, (Q : ℝ) ^ 2 :=
          Finset.sum_le_sum fun i _ => by
            rw [latEmbed_apply, Real.norm_eq_abs, sq_abs]
            have e : ((finIntVec u i : ℤ) : ℝ) = ((u i : ℕ) : ℝ) := by simp [finIntVec]
            rw [e]
            have h1 : ((u i : ℕ) : ℝ) ≤ Q := by exact_mod_cast (u i).isLt.le
            have h0 : (0 : ℝ) ≤ ((u i : ℕ) : ℝ) := Nat.cast_nonneg _
            nlinarith
      _ = n * (Q : ℝ) ^ 2 := by simp
  calc Real.sqrt (∑ i, ‖(latEmbed (finIntVec u)) i‖ ^ 2) ≤ Real.sqrt (n * (Q : ℝ) ^ 2) :=
        Real.sqrt_le_sqrt h
    _ = Real.sqrt n * Q := by
        rw [Real.sqrt_mul (Nat.cast_nonneg _), Real.sqrt_sq (Nat.cast_nonneg _)]

/-- The maximal function `sup_{α ∈ 𝓡_s} |H_{α,v}|` of the averaging argument, as a real
function of `z` (for fixed `v`). -/
noncomputable def truncHsup (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ)
    (f : (Fin n → ℤ) → ℂ) (v z : Fin n → ℤ) : ℝ :=
  (((liftRat s).sup fun aq => ‖truncH n d Ω p s aq.1 aq.2 f v z‖₊ : ℝ≥0) : ℝ)

lemma enorm_truncHsup (s : ℕ) (f : (Fin n → ℤ) → ℂ) (v z : Fin n → ℤ) :
    ‖truncHsup n d Ω p s f v z‖ₑ =
      (((liftRat s).sup fun aq => ‖truncH n d Ω p s aq.1 aq.2 f v z‖₊ : ℝ≥0) : ℝ≥0∞) := by
  rw [truncHsup, Real.enorm_eq_ofReal (NNReal.coe_nonneg _), ENNReal.ofReal_coe_nnreal]

/-- **Pointwise form of eqs. (10.3)–(10.4)**: for `J > J₀` with `‖u‖ ≤ R ≤ 2^{J₀}`,
`sup_{α, J > J₀} |Lift_{s,α}[τ_J m_K](D) f(x)| ≤ C 𝖬(sup_α |H_{α,x}|)(x - u)
  + C_φ C_n R 2^{-J₀} ∑_{α ∈ 𝓡_s} ∑_{β ∈ T[q]} 𝖬 G_β(x)`
(the first term is the shifted main term `sup |φ_J * H_{α,x}|(x - u)`, the second the shift
error; `C = bpPhiConst n * envelopeConst n`, `C_n = envelopeConst n`). -/
lemma lift_trunc_long_pointwise (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) {Cφ : ℝ} (hCφ : 0 ≤ Cφ)
    (hφ : ∀ (J : ℤ) (w z : EuclideanSpace ℝ (Fin n)), ‖z‖ ≤ (2 : ℝ) ^ J →
      ‖(bpPhiDil J w : ℂ) - (bpPhiDil J (w - z) : ℂ)‖ ≤
        Cφ * ‖z‖ * ((2 : ℝ) ^ J)⁻¹ * envelope n ((2 : ℝ) ^ J) w)
    {s : ℕ} {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) {J₀ : ℕ} {u : Fin n → ℤ}
    {R : ℝ} (hR : ‖latEmbed u‖ ≤ R) (hRJ : R ≤ (2 : ℝ) ^ J₀) (x : Fin n → ℤ) :
    (⨆ J : ℕ, ⨆ (_ : J₀ < J), (liftRat s).sup fun aq =>
      ‖latMult (liftSym n d Ω p s aq.1 aq.2 (fun ξ => bpTau J ξ * dyadicSymbol Ω ξ)) f x‖ₑ) ≤
    ENNReal.ofReal (bpPhiConst n * envelopeConst n) *
        cubeMaximalInt n (truncHsup n d Ω p s f x) (x - u) +
      ENNReal.ofReal (Cφ * envelopeConst n * R * ((2 : ℝ) ^ J₀)⁻¹) *
        ∑ aq ∈ liftRat s, ∑ b : Fin n → Fin aq.2,
          cubeMaximalInt n (truncG n d Ω p s aq.2 b f) x := by
  refine iSup_le fun J => iSup_le fun hJ => Finset.sup_le fun aq haq => ?_
  obtain ⟨a, q⟩ := aq
  have hq : 1 ≤ q := one_le_of_mem_liftRat haq
  have hJ0 : (0 : ℤ) ≤ (J : ℤ) := Nat.cast_nonneg _
  have h2J : (2 : ℝ) ^ J₀ ≤ (2 : ℝ) ^ (J : ℤ) := by
    rw [zpow_natCast]; exact pow_le_pow_right₀ (by norm_num) hJ.le
  have hR0 : 0 ≤ R := (norm_nonneg _).trans hR
  have hE0 : 0 ≤ envelopeConst n := by unfold envelopeConst; positivity
  rw [latMult_liftSym_bpTau_eq hn hΩ hJ0 s a q hf x]
  set H := truncH n d Ω p s a q f x with hH
  set φ : (Fin n → ℤ) → ℂ := fun y => (bpPhiDil (J : ℤ) (latEmbed y) : ℂ) with hφdef
  have hsplit : ∀ y, φ y * H (x - y) =
      φ (y - u) * H (x - y) + (φ y - φ (y - u)) * H (x - y) := fun y => by ring
  -- the shifted main term
  have h1 : ∑' y, ‖φ (y - u)‖ₑ * ‖H (x - y)‖ₑ ≤
      ENNReal.ofReal (bpPhiConst n * envelopeConst n) *
        cubeMaximalInt n (truncHsup n d Ω p s f x) (x - u) := by
    rw [← (Equiv.addRight u).tsum_eq]
    simp only [Equiv.coe_addRight, add_sub_cancel_right]
    refine le_trans (ENNReal.tsum_le_tsum fun w => ?_)
      (tsum_bpPhiDil_latEmbed_mul_le_cubeMaximalInt hJ0 (truncHsup n d Ω p s f x) (x - u))
    have e1 : ‖φ w‖ₑ = ENNReal.ofReal (bpPhiDil (J : ℤ) (latEmbed w)) := by
      rw [hφdef, ← ofReal_norm, Complex.norm_real,
        Real.norm_of_nonneg (bpPhiDil_nonneg _ _)]
    have e2 : x - (w + u) = x - u - w := by abel
    rw [e1, e2, enorm_truncHsup]
    gcongr
    exact enorm_le_coe_finset_sup (g := fun aq : ℕ × ℕ =>
      truncH n d Ω p s aq.1 aq.2 f x (x - u - w)) (a := (a, q)) haq
  -- the shift error
  have h2 : ∑' y, ‖φ y - φ (y - u)‖ₑ * ‖H (x - y)‖ₑ ≤
      ENNReal.ofReal (Cφ * envelopeConst n * R * ((2 : ℝ) ^ J₀)⁻¹) *
        ∑ aq ∈ liftRat s, ∑ b : Fin n → Fin aq.2,
          cubeMaximalInt n (truncG n d Ω p s aq.2 b f) x := by
    set c : ℝ := Cφ * R * ((2 : ℝ) ^ J₀)⁻¹ with hc
    have hc0 : 0 ≤ c := by positivity
    have hterm : ∀ y, ‖φ y - φ (y - u)‖ₑ * ‖H (x - y)‖ₑ ≤
        ENNReal.ofReal c * ∑ b : Fin n → Fin q,
          ENNReal.ofReal (latEnvelope n ((2 : ℝ) ^ (J : ℤ)) y) *
            ‖truncG n d Ω p s q b f (x - y)‖ₑ := by
      intro y
      have hd := hφ (J : ℤ) (latEmbed y) (latEmbed u) (hR.trans (hRJ.trans h2J))
      rw [← latEmbed_sub] at hd
      have hd' : ‖φ y - φ (y - u)‖ ≤ c * latEnvelope n ((2 : ℝ) ^ (J : ℤ)) y := by
        refine hd.trans ?_
        rw [latEnvelope, hc]
        have henv : 0 ≤ envelope n ((2 : ℝ) ^ (J : ℤ)) (latEmbed y) :=
          envelope_nonneg (by positivity) _
        have hinv : ((2 : ℝ) ^ (J : ℤ))⁻¹ ≤ ((2 : ℝ) ^ J₀)⁻¹ :=
          inv_anti₀ (by positivity) h2J
        gcongr
      have hH' : ‖H (x - y)‖ₑ ≤ ∑ b : Fin n → Fin q, ‖truncG n d Ω p s q b f (x - y)‖ₑ := by
        rw [← ofReal_norm]
        refine (ENNReal.ofReal_le_ofReal (norm_truncH_le s a hq f x (x - y))).trans (le_of_eq ?_)
        rw [ENNReal.ofReal_sum_of_nonneg (fun b _ => norm_nonneg _)]
        simp only [ofReal_norm]
      calc ‖φ y - φ (y - u)‖ₑ * ‖H (x - y)‖ₑ
          ≤ ENNReal.ofReal (c * latEnvelope n ((2 : ℝ) ^ (J : ℤ)) y) *
              ∑ b : Fin n → Fin q, ‖truncG n d Ω p s q b f (x - y)‖ₑ := by
            gcongr
            rw [← ofReal_norm]; exact ENNReal.ofReal_le_ofReal hd'
        _ = _ := by
            rw [ENNReal.ofReal_mul hc0, mul_assoc, Finset.mul_sum]
    refine (ENNReal.tsum_le_tsum hterm).trans ?_
    rw [ENNReal.tsum_mul_left, Summable.tsum_finsetSum (fun _ _ => ENNReal.summable)]
    have hR1 : (1 : ℝ) ≤ (2 : ℝ) ^ (J : ℤ) := one_le_zpow₀ (by norm_num) hJ0
    calc ENNReal.ofReal c * ∑ b : Fin n → Fin q, ∑' y,
          ENNReal.ofReal (latEnvelope n ((2 : ℝ) ^ (J : ℤ)) y) *
            ‖truncG n d Ω p s q b f (x - y)‖ₑ
        ≤ ENNReal.ofReal c * ∑ b : Fin n → Fin q,
            ENNReal.ofReal (envelopeConst n) * cubeMaximalInt n (truncG n d Ω p s q b f) x := by
          gcongr with b
          exact tsum_envelope_mul_le_cubeMaximalInt hR1 _ x
      _ = ENNReal.ofReal (Cφ * envelopeConst n * R * ((2 : ℝ) ^ J₀)⁻¹) *
            ∑ b : Fin n → Fin q, cubeMaximalInt n (truncG n d Ω p s q b f) x := by
          rw [← Finset.mul_sum, ← mul_assoc, ← ENNReal.ofReal_mul hc0, hc]
          congr 2; ring
      _ ≤ _ := by
          gcongr
          exact Finset.single_le_sum (f := fun aq : ℕ × ℕ => ∑ b : Fin n → Fin aq.2,
            cubeMaximalInt n (truncG n d Ω p s aq.2 b f) x) (fun _ _ => zero_le) haq
  calc ‖∑' y, φ y * H (x - y)‖ₑ ≤ ∑' y, ‖φ y * H (x - y)‖ₑ := enorm_tsum_le_tsum_enorm
    _ ≤ ∑' y, (‖φ (y - u)‖ₑ * ‖H (x - y)‖ₑ + ‖φ y - φ (y - u)‖ₑ * ‖H (x - y)‖ₑ) :=
        ENNReal.tsum_le_tsum fun y => by
          rw [hsplit y]
          refine (enorm_add_le _ _).trans (le_of_eq ?_)
          rw [enorm_mul, enorm_mul]
    _ = ∑' y, ‖φ (y - u)‖ₑ * ‖H (x - y)‖ₑ + ∑' y, ‖φ y - φ (y - u)‖ₑ * ‖H (x - y)‖ₑ :=
        ENNReal.tsum_add
    _ ≤ _ := add_le_add h1 h2


/-! #### The averaging argument over `𝒱_s` -/

/-- **The averaging argument of Blueprint Lemma 10.1**: let `h(v, z)` depend on `v` only modulo
`Q`, and suppose that for every `u ∈ 𝒱 = {0, …, Q-1}ⁿ` the function `x ↦ h(x, x - u)` has
`ℓ^p` norm `≤ X` (`1 < p`). Then for some `u ∈ 𝒱`, `‖x ↦ 𝖬(h(x, ·))(x - u)‖_p ≤ C_{n,p} X`.
(Average the `p`-th powers over `u`, change variables `(x, u) ↦ (z = x - u, v = x mod Q)`,
apply the maximal theorem for each fixed `v`, and change variables back.) -/
lemma exists_shift_eLpNorm_cubeMaximalInt_le {Q : ℕ} [NeZero Q] (hp : 1 < p)
    (h : (Fin n → ℤ) → (Fin n → ℤ) → ℝ)
    (hper : ∀ v v' : Fin n → ℤ, (∀ i, (Q : ℤ) ∣ v i - v' i) → h v = h v') {X : ℝ≥0∞}
    (hX : ∀ u : Fin n → Fin Q,
      eLpNorm (fun x => h x (x - finIntVec u)) (ENNReal.ofReal p) Measure.count ≤ X) :
    ∃ u : Fin n → Fin Q,
      eLpNorm (fun x => cubeMaximalInt n (h x) (x - finIntVec u)) (ENNReal.ofReal p)
        Measure.count ≤ hlMaximalConst (5 ^ n) p * X := by
  have hp0 : 0 < p := by linarith
  set CMe := hlMaximalConst (5 ^ n) p with hCMe
  have hA : ∀ u : Fin n → Fin Q, ∑' x, ‖h x (x - finIntVec u)‖ₑ ^ p ≤ X ^ p := by
    intro u
    refine tsum_rpow_le_of_eLpNorm_count_le (g := fun x => ‖h x (x - finIntVec u)‖ₑ) hp0 ?_
    rw [eLpNorm_enorm _ AEStronglyMeasurable.of_discrete]
    exact hX u
  have hB : ∀ v, ∑' z, cubeMaximalInt n (h v) z ^ p ≤ CMe ^ p * ∑' z, ‖h v z‖ₑ ^ p := by
    intro v
    have h1 := eLpNorm_cubeMaximalInt_le (n := n) hp (h v)
    rw [← eLpNorm_enorm (h v) AEStronglyMeasurable.of_discrete,
      eLpNorm_count_ennreal_eq (fun x => ‖h v x‖ₑ) hp0] at h1
    refine (tsum_rpow_le_of_eLpNorm_count_le hp0 h1).trans (le_of_eq ?_)
    rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le, ← ENNReal.rpow_mul, one_div_mul_cancel hp0.ne',
      ENNReal.rpow_one]
  set a : (Fin n → Fin Q) → ℝ≥0∞ := fun u =>
    ∑' x, cubeMaximalInt n (h x) (x - finIntVec u) ^ p with ha
  have hsum : ∑ u, a u ≤ CMe ^ p * ((Fintype.card (Fin n → Fin Q) : ℝ≥0∞) * X ^ p) := by
    have e1 := sum_tsum_sub_finIntVec_eq (Q := Q)
      (fun v z => cubeMaximalInt n (h v) z ^ p) (fun v v' z hvv => by rw [hper v v' hvv])
    have e2 := sum_tsum_sub_finIntVec_eq (Q := Q)
      (fun v z => ‖h v z‖ₑ ^ p) (fun v v' z hvv => by rw [hper v v' hvv])
    calc ∑ u, a u = ∑ v : Fin n → Fin Q, ∑' z, cubeMaximalInt n (h (finIntVec v)) z ^ p := e1
      _ ≤ ∑ v : Fin n → Fin Q, CMe ^ p * ∑' z, ‖h (finIntVec v) z‖ₑ ^ p :=
          Finset.sum_le_sum fun v _ => hB _
      _ = CMe ^ p * ∑ u : Fin n → Fin Q, ∑' x, ‖h x (x - finIntVec u)‖ₑ ^ p := by
          rw [← Finset.mul_sum, e2]
      _ ≤ CMe ^ p * ∑ _u : Fin n → Fin Q, X ^ p := by
          gcongr with u; exact hA u
      _ = CMe ^ p * ((Fintype.card (Fin n → Fin Q) : ℝ≥0∞) * X ^ p) := by
          rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
  obtain ⟨u, -, hu⟩ := Finset.exists_min_image Finset.univ a Finset.univ_nonempty
  refine ⟨u, eLpNorm_count_le_of_tsum_rpow_le hp0 ?_⟩
  have hc0 : (Fintype.card (Fin n → Fin Q) : ℝ≥0∞) ≠ 0 := by
    simp [NeZero.ne Q]
  have hct : (Fintype.card (Fin n → Fin Q) : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _
  have h3 : (Fintype.card (Fin n → Fin Q) : ℝ≥0∞) * a u ≤
      (Fintype.card (Fin n → Fin Q) : ℝ≥0∞) * (CMe ^ p * X ^ p) := by
    calc (Fintype.card (Fin n → Fin Q) : ℝ≥0∞) * a u = ∑ _v : Fin n → Fin Q, a u := by
          rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
      _ ≤ ∑ v, a v := Finset.sum_le_sum fun v _ => hu v (Finset.mem_univ v)
      _ ≤ _ := hsum.trans (le_of_eq (by ring))
  rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le]
  exact (ENNReal.mul_le_mul_iff_right hc0 hct).1 h3

/-! #### The long smooth maximum -/

/-- `sup_α |H_{α,v}|` depends on `v` only modulo `Q_s`. -/
lemma truncHsup_congr {s : ℕ} (f : (Fin n → ℤ) → ℂ) {v v' : Fin n → ℤ}
    (h : ∀ i, (truncQ s : ℤ) ∣ v i - v' i) :
    truncHsup n d Ω p s f v = truncHsup n d Ω p s f v' := by
  funext z
  unfold truncHsup
  congr 1
  refine Finset.sup_congr rfl fun aq haq => ?_
  have hq : 1 ≤ aq.2 := one_le_of_mem_liftRat (a := aq.1) haq
  have hqN : aq.2 < liftN s := (mem_liftRat.1 haq).2.1
  have h' : ∀ i, (aq.2 : ℤ) ∣ v i - v' i := fun i =>
    (Int.natCast_dvd_natCast.2 (dvd_truncQ hq hqN)).trans (h i)
  rw [truncH_congr s aq.1 hq f h' z]

lemma eLpNorm_latModulate (β : EuclideanSpace ℝ (Fin n)) (f : (Fin n → ℤ) → ℂ) {P : ℝ≥0∞} :
    eLpNorm (latModulate β f) P Measure.count = eLpNorm f P Measure.count :=
  eLpNorm_congr_norm_ae AEStronglyMeasurable.of_discrete AEStronglyMeasurable.of_discrete
    (ae_of_all _ fun x => by rw [latModulate, norm_mul, norm_eC, one_mul])

/-- The shift error in `ℓ^p`: `‖∑_{α ∈ 𝓡_s} ∑_{β ∈ T[q]} 𝖬 G_β‖_p ≤ N_s^{n+2} C_{n,p} C_K ‖f‖_p`. -/
lemma eLpNorm_sum_cubeMaximalInt_truncG_le (hp : 1 < p) {CK : ℝ}
    (hK : ∀ (s : ℕ) (g : (Fin n → ℤ) → ℂ), (Function.support g).Finite →
      eLpNorm (latMult (truncKs n d Ω p s) g) (ENNReal.ofReal p) Measure.count ≤
        ENNReal.ofReal CK * eLpNorm g (ENNReal.ofReal p) Measure.count)
    (s : ℕ) {f : (Fin n → ℤ) → ℂ} (hf : (Function.support f).Finite) :
    eLpNorm (fun x => ∑ aq ∈ liftRat s, ∑ b : Fin n → Fin aq.2,
        cubeMaximalInt n (truncG n d Ω p s aq.2 b f) x) (ENNReal.ofReal p) Measure.count ≤
      ((liftN s ^ (n + 2) : ℕ) : ℝ≥0∞) * (hlMaximalConst (5 ^ n) p *
        (ENNReal.ofReal CK * eLpNorm f (ENNReal.ofReal p) Measure.count)) := by
  have hp1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hp.le
  set K := hlMaximalConst (5 ^ n) p *
    (ENNReal.ofReal CK * eLpNorm f (ENNReal.ofReal p) Measure.count) with hKdef
  have hG : ∀ q (b : Fin n → Fin q), eLpNorm (cubeMaximalInt n (truncG n d Ω p s q b f))
      (ENNReal.ofReal p) Measure.count ≤ K := by
    intro q b
    refine (eLpNorm_cubeMaximalInt_le (n := n) hp _).trans ?_
    rw [hKdef]
    gcongr
    refine (hK s _ (hf.subset fun x hx => ?_)).trans (le_of_eq ?_)
    · intro h0; apply hx; simp [latModulate, h0]
    · rw [eLpNorm_latModulate]
  have e : (fun x => ∑ aq ∈ liftRat s, ∑ b : Fin n → Fin aq.2,
      cubeMaximalInt n (truncG n d Ω p s aq.2 b f) x) =
      ∑ aq ∈ liftRat s, ∑ b : Fin n → Fin aq.2, cubeMaximalInt n (truncG n d Ω p s aq.2 b f) := by
    funext x; simp only [Finset.sum_apply]
  rw [e]
  refine (eLpNorm_sum_le hp1).trans ?_
  refine (Finset.sum_le_sum fun aq _ => eLpNorm_sum_le hp1).trans ?_
  refine (Finset.sum_le_sum fun aq _ => Finset.sum_le_sum fun b _ => hG aq.2 b).trans ?_
  simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fun, Fintype.card_fin, nsmul_eq_mul]
  rw [← Finset.sum_mul]
  gcongr
  have hle : ∑ aq ∈ liftRat s, aq.2 ^ n ≤ liftN s ^ (n + 2) := by
    calc ∑ aq ∈ liftRat s, aq.2 ^ n ≤ ∑ _aq ∈ liftRat s, liftN s ^ n :=
          Finset.sum_le_sum fun aq haq => Nat.pow_le_pow_left (mem_liftRat.1 haq).2.1.le n
      _ = (liftRat s).card * liftN s ^ n := by rw [Finset.sum_const, smul_eq_mul]
      _ ≤ liftN s ^ 2 * liftN s ^ n := Nat.mul_le_mul_right _ (card_liftRat_le s)
      _ = liftN s ^ (n + 2) := by rw [← pow_add, add_comm]
  exact_mod_cast hle

/-- **Blueprint Lemma 10.1 (`lem:lifttrunc`), the long smooth maximum** (proof, lines on
eqs. (10.3)–(10.4) and the averaging argument): for `n, d ≥ 1`, admissible `Ω` and `1 < p < ∞`
there are `δ > 0` and `C` such that for every `s ≥ 1` and every finitely supported `f`,
`‖sup_{α ∈ 𝓡_s, J > J_s} |Lift_{s,α}[τ_J m_K](D) f|‖_p ≤ C 2^{-δ s} ‖f‖_p`
(the supremum over all integers `J > J_s`, as an extended nonnegative function). -/
theorem lift_trunc_long (hn : 1 ≤ n) (hd : 1 ≤ d) (hΩ : IsSWProfile Ω) (hp : 1 < p) :
    ∃ δ : ℝ, 0 < δ ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ s : ℕ, 1 ≤ s →
      ∀ f : (Fin n → ℤ) → ℂ, (Function.support f).Finite →
        eLpNorm (fun x => ⨆ J : ℕ, ⨆ (_ : truncJ n d Ω p s < J), (liftRat s).sup fun aq =>
            ‖latMult (liftSym n d Ω p s aq.1 aq.2
              (fun ξ => bpTau J ξ * dyadicSymbol Ω ξ)) f x‖ₑ)
          (ENNReal.ofReal p) Measure.count ≤
        ENNReal.ofReal (C * (2 : ℝ) ^ (-(δ * s))) *
          eLpNorm f (ENNReal.ofReal p) Measure.count := by
  obtain ⟨δL, hδL, CL, hCL, hL⟩ := lift_eC_dyadicSymbol_bound hn hd hΩ hp
  obtain ⟨CK, hCK, hK⟩ := truncKs_bound (d := d) hn hΩ hp
  obtain ⟨Cφ, hCφ, hφ⟩ := exists_norm_bpPhiDil_sub_le n
  have hp0 : 0 < p := by linarith
  have hp1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hp.le
  set CM := (hlMaximalConst (5 ^ n) p).toReal with hCM
  have hCMe : hlMaximalConst (5 ^ n) p = ENNReal.ofReal CM :=
    (ENNReal.ofReal_toReal (hlMaximalConst_ne_top _ hp0)).symm
  have hCM0 : 0 ≤ CM := ENNReal.toReal_nonneg
  have hE0 : 0 ≤ envelopeConst n := by unfold envelopeConst; positivity
  have hB0 : 0 ≤ bpPhiConst n := bpPhiConst_nonneg
  set c1 := bpPhiConst n * envelopeConst n with hc1
  set δ := min δL 10 with hδ
  refine ⟨δ, lt_min hδL (by norm_num),
    c1 * CM * CL + Cφ * envelopeConst n * Real.sqrt n * CM * CK, by positivity,
    fun s hs f hf => ?_⟩
  have hf1 : Summable fun z => ‖f z‖ := summable_of_finite_support hf
  have : NeZero (truncQ s) := ⟨(truncQ_pos s).ne'⟩
  obtain ⟨-, hsq, hNQ⟩ := truncJ_spec (n := n) (d := d) (Ω := Ω) (p := p) s
  set Js := truncJ n d Ω p s with hJs
  set R := Real.sqrt n * (truncQ s : ℝ) with hRdef
  have hR0 : 0 ≤ R := by positivity
  have hRJ : R ≤ (2 : ℝ) ^ Js :=
    hsq.trans (pow_le_pow_right₀ (by norm_num) (Nat.sub_le _ _))
  set Er : (Fin n → ℤ) → ℝ≥0∞ := fun x => ∑ aq ∈ liftRat s, ∑ b : Fin n → Fin aq.2,
    cubeMaximalInt n (truncG n d Ω p s aq.2 b f) x with hEr
  set c2 := Cφ * envelopeConst n * R * ((2 : ℝ) ^ Js)⁻¹ with hc2
  have hc20 : 0 ≤ c2 := by positivity
  set nf := eLpNorm f (ENNReal.ofReal p) Measure.count with hnf
  -- the averaging argument: a good shift `u ∈ 𝒱_s`
  have hX : ∀ u : Fin n → Fin (truncQ s),
      eLpNorm (fun x => truncHsup n d Ω p s f x (x - finIntVec u)) (ENNReal.ofReal p)
        Measure.count ≤ ENNReal.ofReal (CL * (2 : ℝ) ^ (-(δL * s))) * nf := by
    intro u
    have e : (fun x => truncHsup n d Ω p s f x (x - finIntVec u)) = fun x =>
        (((liftRat s).sup fun aq => ‖latMult (liftSym n d Ω p s aq.1 aq.2
          (fun ξ => eC (-inner ℝ (latEmbed (finIntVec u)) ξ) * dyadicSymbol Ω ξ)) f x‖₊ :
            ℝ≥0) : ℝ) := by
      funext x
      unfold truncHsup
      congr 1
      refine Finset.sup_congr rfl fun aq _ => ?_
      rw [latMult_liftSym_eC_eq hn hΩ _ s aq.1 aq.2 hf1 x]
    rw [e]
    exact hL s hs _ f hf
  obtain ⟨u, hu⟩ := exists_shift_eLpNorm_cubeMaximalInt_le hp (truncHsup n d Ω p s f)
    (fun v v' h => truncHsup_congr f h) hX
  set W : (Fin n → ℤ) → ℝ≥0∞ := fun x =>
    cubeMaximalInt n (truncHsup n d Ω p s f x) (x - finIntVec u) with hW
  -- the pointwise bound
  have hpt : ∀ x, (⨆ J : ℕ, ⨆ (_ : Js < J), (liftRat s).sup fun aq =>
      ‖latMult (liftSym n d Ω p s aq.1 aq.2 (fun ξ => bpTau J ξ * dyadicSymbol Ω ξ)) f x‖ₑ) ≤
        ENNReal.ofReal c1 * W x + ENNReal.ofReal c2 * Er x := fun x =>
    lift_trunc_long_pointwise hn hΩ hCφ hφ hf1 (norm_latEmbed_finIntVec_le u) hRJ x
  have hErb := eLpNorm_sum_cubeMaximalInt_truncG_le (d := d) (Ω := Ω) hp hK s hf
  rw [hCMe] at hu hErb
  have hN : ((liftN s ^ (n + 2) : ℕ) : ℝ≥0∞) =
      ENNReal.ofReal (((liftN s : ℕ) : ℝ) ^ (n + 2)) := by
    rw [← ENNReal.ofReal_natCast]; push_cast; rfl
  rw [hN] at hErb
  have h2L : (2 : ℝ) ^ (-(δL * s)) ≤ (2 : ℝ) ^ (-(δ * s)) := by
    refine Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_
    have : δ ≤ δL := min_le_left _ _
    have : (0 : ℝ) ≤ s := Nat.cast_nonneg s
    nlinarith
  have h2E : ((2 : ℝ) ^ (10 * s))⁻¹ ≤ (2 : ℝ) ^ (-(δ * s)) := by
    rw [← Real.rpow_natCast, ← Real.rpow_neg (by norm_num)]
    refine Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_
    have : δ ≤ 10 := min_le_right _ _
    have : (0 : ℝ) ≤ s := Nat.cast_nonneg s
    push_cast; nlinarith
  have hQ2 : c2 * ((liftN s : ℕ) : ℝ) ^ (n + 2) =
      Cφ * envelopeConst n * Real.sqrt n *
        (((liftN s : ℕ) : ℝ) ^ (n + 2) * truncQ s / (2 : ℝ) ^ Js) := by
    rw [hc2, hRdef]; field_simp
  calc eLpNorm (fun x => ⨆ J : ℕ, ⨆ (_ : Js < J), (liftRat s).sup fun aq =>
          ‖latMult (liftSym n d Ω p s aq.1 aq.2
            (fun ξ => bpTau J ξ * dyadicSymbol Ω ξ)) f x‖ₑ) (ENNReal.ofReal p) Measure.count
      ≤ eLpNorm (fun x => ENNReal.ofReal c1 * W x + ENNReal.ofReal c2 * Er x)
          (ENNReal.ofReal p) Measure.count := by
        refine eLpNorm_mono_enorm AEStronglyMeasurable.of_discrete fun x => ?_
        rw [enorm_eq_self, enorm_eq_self]
        exact hpt x
    _ ≤ eLpNorm (fun x => ENNReal.ofReal c1 * W x) (ENNReal.ofReal p) Measure.count +
          eLpNorm (fun x => ENNReal.ofReal c2 * Er x) (ENNReal.ofReal p) Measure.count :=
        eLpNorm_add_le (f := fun x => ENNReal.ofReal c1 * W x)
          (g := fun x => ENNReal.ofReal c2 * Er x) hp1
    _ = ENNReal.ofReal c1 * eLpNorm W (ENNReal.ofReal p) Measure.count +
          ENNReal.ofReal c2 * eLpNorm Er (ENNReal.ofReal p) Measure.count := by
        rw [eLpNorm_count_const_mul _ _ hp0, eLpNorm_count_const_mul _ _ hp0]
    _ ≤ ENNReal.ofReal c1 * (ENNReal.ofReal CM *
            (ENNReal.ofReal (CL * (2 : ℝ) ^ (-(δL * s))) * nf)) +
          ENNReal.ofReal c2 * (ENNReal.ofReal (((liftN s : ℕ) : ℝ) ^ (n + 2)) *
            (ENNReal.ofReal CM * (ENNReal.ofReal CK * nf))) := by
        gcongr
    _ = ENNReal.ofReal (c1 * CM * CL * (2 : ℝ) ^ (-(δL * s)) +
          c2 * ((liftN s : ℕ) : ℝ) ^ (n + 2) * CM * CK) * nf := by
        have h2 : (0 : ℝ) ≤ (2 : ℝ) ^ (-(δL * s)) := Real.rpow_nonneg (by norm_num) _
        rw [ENNReal.ofReal_add (by positivity) (by positivity)]
        simp only [ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ c1),
          ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ c1 * CM),
          ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ c1 * CM * CL),
          ENNReal.ofReal_mul hCL, ENNReal.ofReal_mul hc20,
          ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ c2 * ((liftN s : ℕ) : ℝ) ^ (n + 2)),
          ENNReal.ofReal_mul (by positivity :
            (0 : ℝ) ≤ c2 * ((liftN s : ℕ) : ℝ) ^ (n + 2) * CM)]
        ring
    _ ≤ ENNReal.ofReal ((c1 * CM * CL + Cφ * envelopeConst n * Real.sqrt n * CM * CK) *
          (2 : ℝ) ^ (-(δ * s))) * nf := by
        gcongr ENNReal.ofReal ?_ * nf
        rw [mul_assoc (c2 * _), mul_comm (c2 * _) (CM * CK), hQ2]
        have h3 : Cφ * envelopeConst n * Real.sqrt n *
            (((liftN s : ℕ) : ℝ) ^ (n + 2) * truncQ s / (2 : ℝ) ^ Js) ≤
            Cφ * envelopeConst n * Real.sqrt n * (2 : ℝ) ^ (-(δ * s)) :=
          mul_le_mul_of_nonneg_left (hNQ.trans h2E) (by positivity)
        have h4 : c1 * CM * CL * (2 : ℝ) ^ (-(δL * s)) ≤ c1 * CM * CL * (2 : ℝ) ^ (-(δ * s)) :=
          mul_le_mul_of_nonneg_left h2L (by positivity)
        have h5 : CM * CK * (Cφ * envelopeConst n * Real.sqrt n *
            (((liftN s : ℕ) : ℝ) ^ (n + 2) * truncQ s / (2 : ℝ) ^ Js)) ≤
            CM * CK * (Cφ * envelopeConst n * Real.sqrt n * (2 : ℝ) ^ (-(δ * s))) :=
          mul_le_mul_of_nonneg_left h3 (by positivity)
        nlinarith

/-- **Blueprint Lemma 10.1 (`lem:lifttrunc`), eq. (10.1) (`eq:lifttrunc`)**: for `n, d ≥ 1`,
admissible `Ω` and `1 < p < ∞` there are `θ_p > 0` and `C_p` such that for every `s ≥ 1` and
every finitely supported `f`,
`‖sup_{α ∈ 𝓡_s, J ≥ 1} |Lift_{s,α}[∑_{1 ≤ j < J} 𝓕 K_j](D) f|‖_p ≤ C_p 2^{-θ_p s} ‖f‖_p`
(the supremum over integers `J ≥ 1`, as an extended nonnegative function). -/
theorem lift_trunc (hn : 1 ≤ n) (hd : 1 ≤ d) (hΩ : IsSWProfile Ω) (hp : 1 < p) :
    ∃ θ : ℝ, 0 < θ ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ s : ℕ, 1 ≤ s →
      ∀ f : (Fin n → ℤ) → ℂ, (Function.support f).Finite →
        eLpNorm (fun x => ⨆ J : ℕ, ⨆ (_ : 1 ≤ J), (liftRat s).sup fun aq =>
            ‖latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω J)) f x‖ₑ)
          (ENNReal.ofReal p) Measure.count ≤
        ENNReal.ofReal (C * (2 : ℝ) ^ (-(θ * s))) * eLpNorm f (ENNReal.ofReal p) Measure.count :=
  lift_trunc_of_long hn hd hΩ hp (lift_trunc_long hn hd hΩ hp)

end Truncation

section Bands

/-!
## Lifted oscillatory bands and their assembly

Results from §11 ("Lifted oscillatory bands and their assembly") of
`blueprints/discrete-sw.tex`: Blueprint Lemma 11.1 (`lem:middleband`, "A uniform-in-band
arithmetic gain"), Blueprint Lemma 11.2 (`lem:highband`, "The high-band analytic gain") and
Blueprint Theorem 11.3 (`thm:liftedSW`, "Lifted polynomial partial sums").

### Conventions

Mathlib Fourier sign, lattice conventions of section `Sampling`, and the §9 setup of
section `Lifting` (`liftSym … s a q m = Lift_{s,a/q}[m]`, `liftRat s = 𝓡_s`,
`liftChi … s = χ_s`). `Φ_{j,μ} = radialOscPhi Ω d j μ = 𝓕(e(μ P) K_j)`, `D = 2d`.

### Definitions

* `bandOp n d Ω p s ℓ f x = 𝓑_{s,ℓ} f(x) =
  sup_{α ∈ 𝓡_s, j ≥ 1, 2^ℓ ≤ |μ| 2^{Dj} ≤ 2^{ℓ+1}} |Lift_{s,α}[Φ_{j,μ}](D) f(x)|`
  (valued in `[0, ∞]`); `bandOp_eq_iSup` rewrites it as a supremum over the admissible
  triples `bandIdx d s ℓ`.
* `liftedPartialMax n d Ω p s f x = 𝒫_s f(x) =
  sup_{α ∈ 𝓡_s, μ ∈ ℝ, 1 ≤ a ≤ b} |Lift_{s,α}[∑_{j=a}^b Φ_{j,μ}](D) f(x)|` (integers `a, b`).

### Results

* Blueprint Lemma 11.2 (`lem:highband`): `bandOp_high` (`ℓ ≥ 0`:
  `‖𝓑_{s,ℓ} f‖_p ≤ C_p 2^{(n+2)s} 2^{-σ_p ℓ} ‖f‖_p`, `σ_p = (2D)^{-1} min(1/p, 1/p')`).
  Ingredients: the Euclidean family `Φ_{j,μ} χ_s` is the annular family applied to `χ_s(D) F`
  (`band_euclid_max`, via Lemma 5.3 `eLpNorm_contBandMax_le` and Young), the sampling transfer
  (`band_periodized_finset`, Lemma 6.2 `sampling_maximal`), the passage to all admissible
  parameters (`band_periodized_sup`, Lemma 2.1) and the expansion of the lift into modulated
  periodizations (`bandOp_le_sum`).
* Blueprint Lemma 11.1 (`lem:middleband`): `bandOp_uniform` (there is `b_p > 0` with
  `‖𝓑_{s,ℓ} f‖_p ≤ C_p 2^{-b_p s} ‖f‖_p` for every integer `ℓ`).
  Ingredients: the kernel expansion of the lifted operators (`latMult_liftSym_eq_finsum`), the
  differentiation in the dilation parameter `u` (`hasDerivAt_latMult_liftSym`), the fundamental
  theorem of calculus square inequality (`enorm_sq_le_of_hasDerivAt`), the uniform `ℓ²` bound for
  finite families (`band_two_finset`, from eq. (9.9) `lift_square_two` and (5.2), (5.3)),
  the weak `(1,1)` and `ℓ^∞` bounds (Lemma 9.4 `lift_envelope` and the maximal theorem) and
  Marcinkiewicz interpolation (`band_lp_finset`); `b_p = γ min(2/p, 2/p')`.
* Blueprint Theorem 11.3 (`thm:liftedSW`, eq. (11.1)): `lift_partial_sums` (there is `c_p > 0`
  with `‖𝒫_s f‖_p ≤ C_p 2^{-c_p s} ‖f‖_p`). Ingredients: the pointwise decomposition
  `liftedPartialMax_le` into middle bands, high bands (at most one `j` per band,
  `band_log_injective`), twice the maximal function of Lemma 10.1 (the low indices form an
  initial interval, `filter_Icc_eq_Ico`) and the low error `C 2^{-B_s} 𝖬 f`
  (`exists_norm_oscErr_le` and the envelope form `norm_latMult_liftSym_fourier_le`), and
  Minkowski for the infinite high-band majorant (`eLpNorm_tsum_le_count`). Here
  `B_s = N s` with `N σ_p ≥ n + 3`, and `c_p = min(θ_p, b_p/2, 1)`.
-/

open MeasureTheory Set Real Finset
open scoped FourierTransform ContDiff SchwartzMap ENNReal NNReal Convolution

variable {n d : ℕ} {Ω : EuclideanSpace ℝ (Fin n) → ℂ} {p : ℝ}

/-! ### The band operator -/

/-- The band maximal operator of §11:
`𝓑_{s,ℓ} f(x) = sup_{α ∈ 𝓡_s, j ≥ 1, 2^ℓ ≤ |μ| 2^{Dj} ≤ 2^{ℓ+1}} |Lift_{s,α}[Φ_{j,μ}](D) f(x)|`
(`D = 2d`), valued in `[0, ∞]`. -/
noncomputable def bandOp (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ) (ℓ : ℤ)
    (f : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) : ℝ≥0∞ :=
  ⨆ (aq ∈ liftRat s) (j : ℤ) (_ : 1 ≤ j) (μ : ℝ)
    (_ : (2 : ℝ) ^ ℓ ≤ |μ| * (2 : ℝ) ^ ((2 * d : ℤ) * j) ∧
      |μ| * (2 : ℝ) ^ ((2 * d : ℤ) * j) ≤ (2 : ℝ) ^ (ℓ + 1)),
    ‖latMult (liftSym n d Ω p s aq.1 aq.2 (radialOscPhi Ω d j μ)) f x‖ₑ

/-- The admissible triples `(α, j, μ)` of `𝓑_{s,ℓ}`. -/
def bandIdx (d s : ℕ) (ℓ : ℤ) : Set ((ℕ × ℕ) × ℤ × ℝ) :=
  {i | i.1 ∈ liftRat s ∧ 1 ≤ i.2.1 ∧ ((2 : ℝ) ^ ℓ ≤ |i.2.2| * (2 : ℝ) ^ ((2 * d : ℤ) * i.2.1) ∧
      |i.2.2| * (2 : ℝ) ^ ((2 * d : ℤ) * i.2.1) ≤ (2 : ℝ) ^ (ℓ + 1))}

/-- `𝓑_{s,ℓ}` as a supremum over the admissible triples. -/
lemma bandOp_eq_iSup (s : ℕ) (ℓ : ℤ) (f : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) :
    bandOp n d Ω p s ℓ f x = ⨆ i : bandIdx d s ℓ,
      ‖latMult (liftSym n d Ω p s i.1.1.1 i.1.1.2 (radialOscPhi Ω d i.1.2.1 i.1.2.2)) f x‖ₑ := by
  refine le_antisymm (iSup₂_le fun aq haq => iSup₂_le fun j hj => iSup₂_le fun μ hμ => ?_)
    (iSup_le fun i => ?_)
  · exact le_iSup_of_le (⟨(aq, j, μ), haq, hj, hμ⟩ : bandIdx d s ℓ) le_rfl
  · obtain ⟨⟨aq, j, μ⟩, h1, h2, h3⟩ := i
    exact le_iSup₂_of_le aq h1 (le_iSup₂_of_le j h2 (le_iSup₂_of_le μ h3 le_rfl))

/-- The band condition `2^ℓ ≤ |μ| 2^{Dj} ≤ 2^{ℓ+1}` is `IsBandAdm d 2^ℓ (j, μ)`. -/
lemma isBandAdm_of_band {ℓ j : ℤ} {μ : ℝ}
    (h : (2 : ℝ) ^ ℓ ≤ |μ| * (2 : ℝ) ^ ((2 * d : ℤ) * j) ∧
      |μ| * (2 : ℝ) ^ ((2 * d : ℤ) * j) ≤ (2 : ℝ) ^ (ℓ + 1)) :
    IsBandAdm d ((2 : ℝ) ^ ℓ) (j, μ) := by
  refine ⟨h.1, ?_⟩
  have := h.2
  rw [zpow_add_one₀ two_ne_zero] at this
  change |μ| * (2 : ℝ) ^ ((2 * d : ℤ) * j) ≤ 2 * 2 ^ ℓ
  linarith

/-! ### Blueprint Lemma 11.2 (`lem:highband`) -/

/-- `Φ_{j,μ}` is continuous and bounded by `‖K_j‖_{L¹}`. -/
lemma continuous_radialOscPhi_and_le (hΩ : IsSWProfile Ω) (j : ℤ) (μ : ℝ) :
    Continuous (radialOscPhi Ω d j μ) ∧
      ∀ ξ, ‖radialOscPhi Ω d j μ ξ‖ ≤ ∫ x, ‖bandKer n d Ω (j, μ) x‖ :=
  continuous_fourier_and_norm_le (integrable_oscKernel hΩ d j μ)

/-- The Euclidean maximal family with symbols `Φ_{j,μ} χ_s` (the proof of Blueprint Lemma 11.2,
first step): it is the continuous annular family applied to `χ_s(D) F`, so for `T ≥ 1` and every
finite family of parameters `a u` with `T ≤ |μ| 2^{Dj} ≤ 2T`, the maximal function is bounded on
`L^p(E)` by `C T^{-σ_p}` (Lemma 5.3 and Young, uniformly in `s`). -/
lemma band_euclid_max (hn : 1 ≤ n) (hd : 1 ≤ d) (hΩ : IsSWProfile Ω) (hp : 1 < p) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (s : ℕ) (T : ℝ), 1 ≤ T → ∀ {ι : Type*} (U : Finset ι) (a : ι → ℤ × ℝ),
      (∀ u ∈ U, IsBandAdm d T (a u)) → ∀ F : 𝓢(EuclideanSpace ℝ (Fin n), ℂ),
        eLpNorm (fun x => U.sup fun u => ‖𝓕⁻ (fun ξ => (radialOscPhi Ω d (a u).1 (a u).2 ξ *
            (liftChi n d Ω p s ξ : ℂ)) * 𝓕 (F : EuclideanSpace ℝ (Fin n) → ℂ) ξ) x‖ₑ)
          (ENNReal.ofReal p) volume ≤
        ENNReal.ofReal (C * T ^ (-(1 / (2 * (2 * d : ℝ)) * min (1 / p) (1 - 1 / p)))) *
          eLpNorm F (ENNReal.ofReal p) volume := by
  obtain ⟨Cb, hCb⟩ := eLpNorm_contBandMax_le hn hd hΩ hp
  obtain ⟨K, hK0, hK⟩ := exists_eLpNorm_liftPhi_le n
  refine ⟨max Cb 0 * K, by positivity, fun s T hT ι U a hU F => ?_⟩
  set σ := 1 / (2 * (2 * d : ℝ)) * min (1 / p) (1 - 1 / p)
  have hP : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hp.le
  set φ : 𝓢(EuclideanSpace ℝ (Fin n), ℂ) := 𝓕⁻ (liftChiSchwartz n d Ω p s) with hφ
  set G := SchwartzMap.convolution (ContinuousLinearMap.mul ℂ ℂ) φ F with hG
  have hGF : ∀ ξ, 𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ =
      liftChiSchwartz n d Ω p s ξ * 𝓕 (F : EuclideanSpace ℝ (Fin n) → ℂ) ξ := by
    intro ξ
    have h := congrArg (fun H : 𝓢(EuclideanSpace ℝ (Fin n), ℂ) => H ξ)
      (SchwartzMap.fourier_convolution (ContinuousLinearMap.mul ℂ ℂ) φ F)
    simp only [SchwartzMap.pairing_apply_apply, hφ, FourierTransform.fourier_fourierInv_eq,
      ContinuousLinearMap.mul_apply'] at h
    rw [← SchwartzMap.fourier_coe, h, SchwartzMap.fourier_coe]
  have hconv : ∀ u, 𝓕⁻ (fun ξ => (radialOscPhi Ω d (a u).1 (a u).2 ξ *
      (liftChi n d Ω p s ξ : ℂ)) * 𝓕 (F : EuclideanSpace ℝ (Fin n) → ℂ) ξ) =
      fun x => bandConv n d Ω (a u) G x := by
    intro u
    have hH : Integrable (bandKer n d Ω (a u)) :=
      (continuous_bandKer hΩ (a u)).integrable_of_hasCompactSupport (hasCompactSupport_bandKer _)
    have e : (fun ξ => (radialOscPhi Ω d (a u).1 (a u).2 ξ *
        (liftChi n d Ω p s ξ : ℂ)) * 𝓕 (F : EuclideanSpace ℝ (Fin n) → ℂ) ξ) =
        fun ξ => 𝓕 (bandKer n d Ω (a u)) ξ * 𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ := by
      funext ξ; rw [hGF, liftChiSchwartz_apply, ← mul_assoc]; rfl
    rw [e, fourierInv_fourier_mul_eq_convolution hH (continuous_fourier_and_norm_le hH).2 G]
    funext x
    rw [convolution_def]
    rfl
  have hfl : LocallyIntegrable (G : EuclideanSpace ℝ (Fin n) → ℂ) volume :=
    G.integrable.locallyIntegrable
  have heq : (fun x => U.sup fun u => ‖𝓕⁻ (fun ξ => (radialOscPhi Ω d (a u).1 (a u).2 ξ *
      (liftChi n d Ω p s ξ : ℂ)) * 𝓕 (F : EuclideanSpace ℝ (Fin n) → ℂ) ξ) x‖ₑ) =
      fun x => U.sup fun u => ‖bandConv n d Ω (a u) G x‖ₑ := by
    funext x; simp only [hconv]
  rw [heq]
  have hmeas : Measurable (fun x => U.sup fun u => ‖bandConv n d Ω (a u) G x‖ₑ) := by
    simp_rw [Finset.sup_eq_iSup]
    exact Measurable.biSup _ U.countable_toSet fun u _ =>
      (continuous_bandConv hΩ (a u) hfl).measurable.enorm
  have hpt : ∀ x, ‖(U.sup fun u => ‖bandConv n d Ω (a u) G x‖ₑ)‖ₑ ≤
      ‖contBandMax n d Ω T G x‖ₑ := by
    intro x
    rw [enorm_eq_self, enorm_eq_self]
    refine Finset.sup_le fun u hu => ?_
    rw [contBandMax_eq]
    exact le_iSup₂_of_le (a u) (hU u hu) le_rfl
  refine (eLpNorm_mono_enorm hmeas.aestronglyMeasurable hpt).trans ?_
  refine (hCb T hT G (G.memLp _)).trans ?_
  have hGc : (G : EuclideanSpace ℝ (Fin n) → ℂ) =
      (φ : EuclideanSpace ℝ (Fin n) → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ, volume]
        (F : EuclideanSpace ℝ (Fin n) → ℂ) :=
    funext fun x => SchwartzMap.convolution_apply _ φ F x
  have hY := (young_convolution_euclidean hP (φ.memLp 1) (F.memLp (ENNReal.ofReal p))).2.1
  have hφK : eLpNorm (φ : EuclideanSpace ℝ (Fin n) → ℂ) 1 volume ≤ ENNReal.ofReal K := by
    rw [hφ, SchwartzMap.fourierInv_coe]; exact hK d Ω p s
  have hGF' : eLpNorm (G : EuclideanSpace ℝ (Fin n) → ℂ) (ENNReal.ofReal p) volume ≤
      ENNReal.ofReal K * eLpNorm F (ENNReal.ofReal p) volume := by
    rw [hGc]; exact hY.trans (by gcongr)
  have hT0 : 0 < T := by linarith
  have hTσ : 0 ≤ T ^ (-σ) := Real.rpow_nonneg hT0.le _
  calc ENNReal.ofReal (Cb * T ^ (-σ)) * eLpNorm (G : EuclideanSpace ℝ (Fin n) → ℂ)
        (ENNReal.ofReal p) volume
      ≤ ENNReal.ofReal (max Cb 0 * T ^ (-σ)) *
          (ENNReal.ofReal K * eLpNorm F (ENNReal.ofReal p) volume) := by
        gcongr
        exact le_max_left _ _
    _ = ENNReal.ofReal (max Cb 0 * K * T ^ (-σ)) * eLpNorm F (ENNReal.ofReal p) volume := by
        rw [← mul_assoc, ← ENNReal.ofReal_mul (by positivity)]
        congr 2; ring

/-- The sampling transfer (the proof of Blueprint Lemma 11.2, Lemma 6.2): for every finite family
of band parameters, the maximal function of the periodizations `(Φ_{j,μ} χ_s)_per(D)` is bounded
on `ℓ^p(ℤⁿ)` by `C T^{-σ_p}`. -/
lemma band_periodized_finset (hn : 1 ≤ n) (hd : 1 ≤ d) (hΩ : IsSWProfile Ω) (hp : 1 < p) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (s : ℕ) (T : ℝ), 1 ≤ T → ∀ {ι : Type*} (U : Finset ι) (a : ι → ℤ × ℝ),
      (∀ u ∈ U, IsBandAdm d T (a u)) → ∀ g : (Fin n → ℤ) → ℂ, (Function.support g).Finite →
        eLpNorm (fun x => U.sup fun u => ‖latMult (periodize fun η =>
            radialOscPhi Ω d (a u).1 (a u).2 η * (liftChi n d Ω p s η : ℂ)) g x‖ₑ)
          (ENNReal.ofReal p) Measure.count ≤
        ENNReal.ofReal (C * T ^ (-(1 / (2 * (2 * d : ℝ)) * min (1 / p) (1 - 1 / p)))) *
          eLpNorm g (ENNReal.ofReal p) Measure.count := by
  obtain ⟨CS, hCS, hS⟩ := sampling_maximal n
  obtain ⟨CA, hCA, hA⟩ := band_euclid_max (p := p) hn hd hΩ hp
  refine ⟨CS * CA, by positivity, fun s T hT ι U a hU g hg => ?_⟩
  set σ := 1 / (2 * (2 * d : ℝ)) * min (1 / p) (1 - 1 / p)
  have hL := eight_le_liftL (n := n) (d := d) (Ω := Ω) (p := p) s
  set B : ℝ := ∑ u ∈ U, ∫ x, ‖bandKer n d Ω (a u) x‖ with hB
  have h := hS p hp.le U (fun u η => radialOscPhi Ω d (a u).1 (a u).2 η *
      (liftChi n d Ω p s η : ℂ)) B (CA * T ^ (-σ))
    (fun u _ => ((continuous_radialOscPhi_and_le hΩ (a u).1 (a u).2).1.mul
      (continuous_liftChi s)).aestronglyMeasurable)
    (fun u hu ξ => ?_) (fun u _ ξ hξ i => ?_) (hA s T hT U a hU) g hg
  · refine h.trans (le_of_eq ?_)
    congr 2; ring
  · rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (liftChi_nonneg s ξ)]
    have h1 := (continuous_radialOscPhi_and_le (d := d) hΩ (a u).1 (a u).2).2 ξ
    have h2 : ∫ x, ‖bandKer n d Ω (a u) x‖ ≤ B :=
      Finset.single_le_sum (f := fun u => ∫ x, ‖bandKer n d Ω (a u) x‖)
        (fun u _ => integral_nonneg fun _ => norm_nonneg _) hu
    calc ‖radialOscPhi Ω d (a u).1 (a u).2 ξ‖ * liftChi n d Ω p s ξ
        ≤ ‖radialOscPhi Ω d (a u).1 (a u).2 ξ‖ * 1 :=
          mul_le_mul_of_nonneg_left (liftChi_le_one s ξ) (norm_nonneg _)
      _ ≤ B := by rw [mul_one]; exact h1.trans h2
  · have hχ : liftChi n d Ω p s ξ ≠ 0 := fun h0 => hξ (by simp [h0])
    have h1 := support_liftChi s hχ i
    have h2 : 1 / (liftL n d Ω p s : ℝ) ≤ 1 / 8 :=
      one_div_le_one_div_of_le (by norm_num) hL
    exact h1.trans h2

/-- The sampling transfer for all band parameters (the proof of Blueprint Lemma 11.2, with
Lemma 2.1): the supremum over all `(j, μ)` with `T ≤ |μ| 2^{Dj} ≤ 2T`. -/
lemma band_periodized_sup (hn : 1 ≤ n) (hd : 1 ≤ d) (hΩ : IsSWProfile Ω) (hp : 1 < p) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (s : ℕ) (T : ℝ), 1 ≤ T → ∀ g : (Fin n → ℤ) → ℂ,
      (Function.support g).Finite →
        eLpNorm (fun x => ⨆ u : {u : ℤ × ℝ // IsBandAdm d T u}, ‖latMult (periodize fun η =>
            radialOscPhi Ω d u.1.1 u.1.2 η * (liftChi n d Ω p s η : ℂ)) g x‖ₑ)
          (ENNReal.ofReal p) Measure.count ≤
        ENNReal.ofReal (C * T ^ (-(1 / (2 * (2 * d : ℝ)) * min (1 / p) (1 - 1 / p)))) *
          eLpNorm g (ENNReal.ofReal p) Measure.count := by
  obtain ⟨C, hC, h⟩ := band_periodized_finset (p := p) hn hd hΩ hp
  refine ⟨C, hC, fun s T hT g hg => ?_⟩
  exact eLpNorm_iSup_le_of_finset_count ENNReal.ofReal_ne_top _ _
    (fun F => h s T hT F Subtype.val (fun u _ => u.2) g hg)

/-- The pointwise expansion of the lift (the proof of Blueprint Lemma 11.2): `|S(α, β)| ≤ 1`,
modulation, and the rational supremum bounded by the sum over the pairs `(α, β)`. -/
lemma bandOp_le_sum (hΩ : IsSWProfile Ω) (s : ℕ) (ℓ : ℤ) {f : (Fin n → ℤ) → ℂ}
    (hf : (Function.support f).Finite) (x : Fin n → ℤ) :
    bandOp n d Ω p s ℓ f x ≤ ∑ aq ∈ liftRat s, ∑ b : Fin n → Fin aq.2,
      ⨆ u : {u : ℤ × ℝ // IsBandAdm d ((2 : ℝ) ^ ℓ) u}, ‖latMult (periodize fun η =>
        radialOscPhi Ω d u.1.1 u.1.2 η * (liftChi n d Ω p s η : ℂ))
          (latModulate (-gridPt aq.2 b) f) x‖ₑ := by
  have hf1 : Summable fun z => ‖f z‖ := summable_of_finite_support hf
  refine iSup₂_le fun aq haq => iSup₂_le fun j _ => iSup₂_le fun μ hμ => ?_
  set Y : (ℕ × ℕ) → ℝ≥0∞ := fun aq => ∑ b : Fin n → Fin aq.2,
      ⨆ u : {u : ℤ × ℝ // IsBandAdm d ((2 : ℝ) ^ ℓ) u}, ‖latMult (periodize fun η =>
        radialOscPhi Ω d u.1.1 u.1.2 η * (liftChi n d Ω p s η : ℂ))
          (latModulate (-gridPt aq.2 b) f) x‖ₑ with hY
  refine le_trans ?_ (Finset.single_le_sum (f := Y) (fun _ _ => zero_le) haq)
  have hq : 1 ≤ aq.2 := one_le_of_mem_liftRat (a := aq.1) (by simpa using haq)
  obtain ⟨hc, hb⟩ := continuous_radialOscPhi_and_le (d := d) hΩ j μ
  have hint : Integrable fun ξ => radialOscPhi Ω d j μ ξ * (liftChi n d Ω p s ξ : ℂ) :=
    integrable_mul_liftChi hc.aestronglyMeasurable (fun ξ _ => hb ξ)
  rw [latMult_liftSym_eq_sum hint hf1 x]
  refine (enorm_sum_le _ _).trans (Finset.sum_le_sum fun b _ => ?_)
  rw [enorm_mul, enorm_mul]
  have h1 : ‖gaussSum n d aq.1 aq.2 b‖ₑ ≤ 1 := by
    rw [← ofReal_norm, ← ENNReal.ofReal_one]
    exact ENNReal.ofReal_le_ofReal (norm_gaussSum_le_one aq.1 hq b)
  have h2 : ‖eC (inner ℝ (latEmbed x) (gridPt aq.2 b))‖ₑ = 1 := by
    rw [← ofReal_norm, norm_eC, ENNReal.ofReal_one]
  rw [h2, one_mul]
  calc ‖gaussSum n d aq.1 aq.2 b‖ₑ * ‖latMult (periodize fun η =>
        radialOscPhi Ω d j μ η * (liftChi n d Ω p s η : ℂ)) (latModulate (-gridPt aq.2 b) f) x‖ₑ
      ≤ 1 * ‖latMult (periodize fun η =>
        radialOscPhi Ω d j μ η * (liftChi n d Ω p s η : ℂ)) (latModulate (-gridPt aq.2 b) f) x‖ₑ :=
        mul_le_mul_left h1 _
    _ = _ := one_mul _
    _ ≤ _ := le_iSup_of_le (⟨(j, μ), isBandAdm_of_band hμ⟩ :
        {u : ℤ × ℝ // IsBandAdm d ((2 : ℝ) ^ ℓ) u}) le_rfl

/-- **Blueprint Lemma 11.2 (`lem:highband`)**, the high-band analytic gain: for `n, d ≥ 1`, an
admissible profile `Ω` and `1 < p < ∞` there is `C_p` such that for every `s ≥ 1`, every
integer `ℓ ≥ 0` and every finitely supported `f`,
`‖𝓑_{s,ℓ} f‖_p ≤ C_p 2^{(n+2)s} 2^{-σ_p ℓ} ‖f‖_p`, where
`σ_p = (2D)^{-1} min(1/p, 1/p')` (`D = 2d`) is the exponent of Lemma 5.3
(`eLpNorm_contBandMax_le`). -/
theorem bandOp_high (hn : 1 ≤ n) (hd : 1 ≤ d) (hΩ : IsSWProfile Ω) (hp : 1 < p) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ s : ℕ, 1 ≤ s → ∀ ℓ : ℤ, 0 ≤ ℓ →
      ∀ f : (Fin n → ℤ) → ℂ, (Function.support f).Finite →
        eLpNorm (bandOp n d Ω p s ℓ f) (ENNReal.ofReal p) Measure.count ≤
          ENNReal.ofReal (C * (2 : ℝ) ^ ((n + 2) * s) *
            (2 : ℝ) ^ (-(1 / (2 * (2 * d : ℝ)) * min (1 / p) (1 - 1 / p) * ℓ))) *
            eLpNorm f (ENNReal.ofReal p) Measure.count := by
  obtain ⟨C, hC, h⟩ := band_periodized_sup (p := p) hn hd hΩ hp
  refine ⟨C, hC, fun s _ ℓ hℓ f hf => ?_⟩
  set σ := 1 / (2 * (2 * d : ℝ)) * min (1 / p) (1 - 1 / p)
  have hp1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hp.le
  have hT : (1 : ℝ) ≤ (2 : ℝ) ^ ℓ := one_le_zpow₀ (by norm_num) hℓ
  set Y : ∀ q : ℕ, (Fin n → Fin q) → (Fin n → ℤ) → ℝ≥0∞ := fun q b x =>
      ⨆ u : {u : ℤ × ℝ // IsBandAdm d ((2 : ℝ) ^ ℓ) u}, ‖latMult (periodize fun η =>
        radialOscPhi Ω d u.1.1 u.1.2 η * (liftChi n d Ω p s η : ℂ))
          (latModulate (-gridPt q b) f) x‖ₑ with hYdef
  set K := ENNReal.ofReal (C * ((2 : ℝ) ^ ℓ) ^ (-σ)) * eLpNorm f (ENNReal.ofReal p) Measure.count
  have hYb : ∀ q (b : Fin n → Fin q), eLpNorm (Y q b) (ENNReal.ofReal p) Measure.count ≤ K := by
    intro q b
    refine (h s _ hT _ (hf.subset fun x hx => ?_)).trans (le_of_eq ?_)
    · intro h0; apply hx; simp [latModulate, h0]
    · rw [eLpNorm_latModulate]
  have hpt : ∀ x, ‖bandOp n d Ω p s ℓ f x‖ₑ ≤
      ‖(∑ aq ∈ liftRat s, ∑ b : Fin n → Fin aq.2, Y aq.2 b) x‖ₑ := by
    intro x
    rw [enorm_eq_self, enorm_eq_self]
    simp only [Finset.sum_apply]
    exact bandOp_le_sum hΩ s ℓ hf x
  refine (eLpNorm_mono_enorm AEStronglyMeasurable.of_discrete hpt).trans ?_
  refine (eLpNorm_sum_le hp1).trans ?_
  refine (Finset.sum_le_sum fun aq _ => eLpNorm_sum_le hp1).trans ?_
  refine (Finset.sum_le_sum fun aq _ => Finset.sum_le_sum fun b _ => hYb aq.2 b).trans ?_
  simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fun, Fintype.card_fin, nsmul_eq_mul]
  rw [← Finset.sum_mul]
  have hle : ∑ aq ∈ liftRat s, aq.2 ^ n ≤ liftN s ^ (n + 2) := by
    calc ∑ aq ∈ liftRat s, aq.2 ^ n ≤ ∑ _aq ∈ liftRat s, liftN s ^ n :=
          Finset.sum_le_sum fun aq haq => Nat.pow_le_pow_left (mem_liftRat.1 haq).2.1.le n
      _ = (liftRat s).card * liftN s ^ n := by rw [Finset.sum_const, smul_eq_mul]
      _ ≤ liftN s ^ 2 * liftN s ^ n := Nat.mul_le_mul_right _ (card_liftRat_le s)
      _ = liftN s ^ (n + 2) := by rw [← pow_add, add_comm]
  have hle' : (∑ aq ∈ liftRat s, ((aq.2 ^ n : ℕ) : ℝ≥0∞)) ≤ ((liftN s ^ (n + 2) : ℕ) : ℝ≥0∞) := by
    exact_mod_cast hle
  have e2 : ((liftN s ^ (n + 2) : ℕ) : ℝ≥0∞) = ENNReal.ofReal ((2 : ℝ) ^ ((n + 2) * s)) := by
    rw [← ENNReal.ofReal_natCast]; congr 1; simp [liftN, ← pow_mul, mul_comm]
  have e3 : ((2 : ℝ) ^ ℓ) ^ (-σ) = (2 : ℝ) ^ (-(σ * ℓ)) := by
    rw [← Real.rpow_intCast, ← Real.rpow_mul (by norm_num)]; congr 1; ring
  calc (∑ aq ∈ liftRat s, ((aq.2 ^ n : ℕ) : ℝ≥0∞)) * K
      ≤ ((liftN s ^ (n + 2) : ℕ) : ℝ≥0∞) * K := mul_le_mul' hle' le_rfl
    _ = ENNReal.ofReal (C * (2 : ℝ) ^ ((n + 2) * s) * (2 : ℝ) ^ (-(σ * ℓ))) *
          eLpNorm f (ENNReal.ofReal p) Measure.count := by
        rw [e2]; simp only [K]; rw [e3, ← mul_assoc, ← ENNReal.ofReal_mul (by positivity)]
        congr 2; ring

/-! ### Blueprint Lemma 11.1 (`lem:middleband`): differentiation in the dilation parameter -/

/-- The kernel expansion of the lifted operators on finitely supported inputs (Lemma 9.1):
`Lift_{s,a/q}[m](D) f(x) = ∑_{z ∈ S} e((a/q) P(x - z)) (m χ_s)ˇ(x - z) f(z)` for bounded measurable
`m` and `f` vanishing off the finite set `S`. -/
lemma latMult_liftSym_eq_finsum (s a : ℕ) {q : ℕ} (hq : 1 ≤ q)
    {m : EuclideanSpace ℝ (Fin n) → ℂ} (hm : AEStronglyMeasurable m volume) {B : ℝ}
    (hB : ∀ ξ, ‖m ξ‖ ≤ B) {f : (Fin n → ℤ) → ℂ} {S : Finset (Fin n → ℤ)}
    (hS : ∀ z ∉ S, f z = 0) (x : Fin n → ℤ) :
    latMult (liftSym n d Ω p s a q m) f x = ∑ z ∈ S,
      eC ((a : ℝ) / q * (radialPolyZ n d (x - z) : ℝ)) *
        𝓕⁻ (fun ξ => m ξ * (liftChi n d Ω p s ξ : ℂ)) (latEmbed (x - z)) * f z := by
  have hf : Summable fun z => ‖f z‖ :=
    summable_of_ne_finset_zero (s := S) fun z hz => by simp [hS z hz]
  rw [latMult_eq_latConv (integrableOn_liftSym (integrable_mul_liftChi hm fun ξ _ => hB ξ)) hf,
    latConv, ← (Equiv.subLeft x).tsum_eq,
    tsum_eq_sum (s := S) fun z hz => by simp [Equiv.subLeft_apply, hS z hz]]
  refine Finset.sum_congr rfl fun z _ => ?_
  simp only [Equiv.subLeft_apply, sub_sub_cancel]
  rw [latKernel_liftSym_of_bdd s a hq hm (fun ξ _ => hB ξ)]

/-- Differentiation of `(M_v χ_s)ˇ(w)` in the parameter `v` under the integral sign. -/
lemma hasDerivAt_fourierInv_mul_liftChi (s : ℕ) {M M' : ℝ → EuclideanSpace ℝ (Fin n) → ℂ}
    (hMm : ∀ v, AEStronglyMeasurable (M v) volume)
    (hM'm : ∀ v, AEStronglyMeasurable (M' v) volume) {B B' : ℝ}
    (hB : ∀ v ξ, ‖M v ξ‖ ≤ B) (hB' : ∀ v ξ, ‖M' v ξ‖ ≤ B')
    (hder : ∀ v ξ, HasDerivAt (fun v => M v ξ) (M' v ξ) v)
    (w : EuclideanSpace ℝ (Fin n)) (v : ℝ) :
    HasDerivAt (fun v => 𝓕⁻ (fun ξ => M v ξ * (liftChi n d Ω p s ξ : ℂ)) w)
      (𝓕⁻ (fun ξ => M' v ξ * (liftChi n d Ω p s ξ : ℂ)) w) v := by
  simp only [fourierInv_eq_integral_eC]
  have hχ := integrable_liftChi (n := n) (d := d) (Ω := Ω) (p := p) s
  have hc : Continuous fun ξ : EuclideanSpace ℝ (Fin n) => eC (inner ℝ ξ w) := by fun_prop
  refine (hasDerivAt_integral_of_dominated_loc_of_deriv_le
    (F := fun v ξ => eC (inner ℝ ξ w) * (M v ξ * (liftChi n d Ω p s ξ : ℂ)))
    (F' := fun v ξ => eC (inner ℝ ξ w) * (M' v ξ * (liftChi n d Ω p s ξ : ℂ)))
    (bound := fun ξ => B' * ‖(liftChi n d Ω p s ξ : ℂ)‖) (s := univ) Filter.univ_mem
    (Filter.Eventually.of_forall fun v =>
      hc.aestronglyMeasurable.mul ((hMm v).mul hχ.aestronglyMeasurable)) ?_
    (hc.aestronglyMeasurable.mul ((hM'm v).mul hχ.aestronglyMeasurable))
    (ae_of_all _ fun ξ v' _ => ?_) (hχ.norm.const_mul B')
    (ae_of_all _ fun ξ v' _ => ?_)).2
  · refine Integrable.mono' (hχ.norm.const_mul B)
      (hc.aestronglyMeasurable.mul ((hMm v).mul hχ.aestronglyMeasurable))
      (ae_of_all _ fun ξ => ?_)
    rw [norm_mul, norm_eC, one_mul, norm_mul]
    exact mul_le_mul_of_nonneg_right (hB v ξ) (norm_nonneg _)
  · rw [norm_mul, norm_eC, one_mul, norm_mul]
    exact mul_le_mul_of_nonneg_right (hB' v' ξ) (norm_nonneg _)
  · exact ((hder v' ξ).mul_const _).const_mul _

/-- Continuity of `(M'_v χ_s)ˇ(w)` in the parameter `v` (dominated convergence). -/
lemma continuous_fourierInv_mul_liftChi (s : ℕ) {M' : ℝ → EuclideanSpace ℝ (Fin n) → ℂ}
    (hM'm : ∀ v, AEStronglyMeasurable (M' v) volume) {B' : ℝ} (hB' : ∀ v ξ, ‖M' v ξ‖ ≤ B')
    (hc : ∀ ξ, Continuous fun v => M' v ξ) (w : EuclideanSpace ℝ (Fin n)) :
    Continuous fun v => 𝓕⁻ (fun ξ => M' v ξ * (liftChi n d Ω p s ξ : ℂ)) w := by
  simp only [fourierInv_eq_integral_eC]
  have hχ := integrable_liftChi (n := n) (d := d) (Ω := Ω) (p := p) s
  have hce : Continuous fun ξ : EuclideanSpace ℝ (Fin n) => eC (inner ℝ ξ w) := by fun_prop
  refine continuous_of_dominated (bound := fun ξ => B' * ‖(liftChi n d Ω p s ξ : ℂ)‖)
    (fun v => hce.aestronglyMeasurable.mul ((hM'm v).mul hχ.aestronglyMeasurable))
    (fun v => ae_of_all _ fun ξ => ?_) (hχ.norm.const_mul B')
    (ae_of_all _ fun ξ => continuous_const.mul ((hc ξ).mul continuous_const))
  rw [norm_mul, norm_eC, one_mul, norm_mul]
  exact mul_le_mul_of_nonneg_right (hB' v ξ) (norm_nonneg _)

/-- Differentiation of the lifted operators in the parameter (the proof of Blueprint
Lemma 11.1): for bounded measurable symbols `M_v` with bounded measurable `v`-derivatives `M'_v`
(continuous in `v`) and finitely supported `f`, `v ↦ Lift_{s,a/q}[M_v](D) f(x)` has derivative
`Lift_{s,a/q}[M'_v](D) f(x)`, which is continuous in `v`. -/
lemma hasDerivAt_latMult_liftSym (s a : ℕ) {q : ℕ} (hq : 1 ≤ q)
    {M M' : ℝ → EuclideanSpace ℝ (Fin n) → ℂ}
    (hMm : ∀ v, AEStronglyMeasurable (M v) volume)
    (hM'm : ∀ v, AEStronglyMeasurable (M' v) volume) {B B' : ℝ}
    (hB : ∀ v ξ, ‖M v ξ‖ ≤ B) (hB' : ∀ v ξ, ‖M' v ξ‖ ≤ B')
    (hder : ∀ v ξ, HasDerivAt (fun v => M v ξ) (M' v ξ) v)
    (hc : ∀ ξ, Continuous fun v => M' v ξ)
    {f : (Fin n → ℤ) → ℂ} (hf : (Function.support f).Finite) (x : Fin n → ℤ) :
    (∀ v, HasDerivAt (fun v => latMult (liftSym n d Ω p s a q (M v)) f x)
      (latMult (liftSym n d Ω p s a q (M' v)) f x) v) ∧
    Continuous fun v => latMult (liftSym n d Ω p s a q (M' v)) f x := by
  set S := hf.toFinset
  have hS : ∀ z ∉ S, f z = 0 := fun z hz => by simpa [S] using hz
  have e1 : (fun v => latMult (liftSym n d Ω p s a q (M v)) f x) = fun v => ∑ z ∈ S,
      eC ((a : ℝ) / q * (radialPolyZ n d (x - z) : ℝ)) *
        𝓕⁻ (fun ξ => M v ξ * (liftChi n d Ω p s ξ : ℂ)) (latEmbed (x - z)) * f z :=
    funext fun v => latMult_liftSym_eq_finsum s a hq (hMm v) (hB v) hS x
  have e2 : (fun v => latMult (liftSym n d Ω p s a q (M' v)) f x) = fun v => ∑ z ∈ S,
      eC ((a : ℝ) / q * (radialPolyZ n d (x - z) : ℝ)) *
        𝓕⁻ (fun ξ => M' v ξ * (liftChi n d Ω p s ξ : ℂ)) (latEmbed (x - z)) * f z :=
    funext fun v => latMult_liftSym_eq_finsum s a hq (hM'm v) (hB' v) hS x
  refine ⟨fun v => ?_, ?_⟩
  · rw [e1, show latMult (liftSym n d Ω p s a q (M' v)) f x = _ from congrFun e2 v]
    exact HasDerivAt.fun_sum fun z _ =>
      ((hasDerivAt_fourierInv_mul_liftChi s hMm hM'm hB hB' hder _ v).const_mul _).mul_const _
  · rw [e2]
    exact continuous_finsetSum S fun z _ =>
      (continuous_const.mul (continuous_fourierInv_mul_liftChi s hM'm hB' hc _)).mul
        continuous_const

/-- The fundamental theorem of calculus square inequality (the proof of Blueprint Lemma 11.1):
for `φ` with continuous derivative `φ'` and `u ∈ [1, 2]`,
`|φ(u)|² ≤ |φ(1)|² + 2 ∫_1^2 |φ| |φ'|`. -/
lemma enorm_sq_le_of_hasDerivAt {φ φ' : ℝ → ℂ} (hφ : ∀ v, HasDerivAt φ (φ' v) v)
    (hφ' : Continuous φ') {u : ℝ} (hu : u ∈ Icc (1 : ℝ) 2) :
    ‖φ u‖ₑ ^ 2 ≤ ‖φ 1‖ₑ ^ 2 + 2 * ∫⁻ v in Ioc (1 : ℝ) 2, ‖φ v‖ₑ * ‖φ' v‖ₑ := by
  have hφc : Continuous φ := continuous_iff_continuousAt.2 fun v => (hφ v).continuousAt
  have hg : ∀ v, HasDerivAt (fun v => ‖φ v‖ ^ 2) (2 * inner ℝ (φ v) (φ' v)) v :=
    fun v => (hφ v).norm_sq
  have hgc : Continuous fun v => 2 * inner ℝ (φ v) (φ' v) := continuous_const.mul (hφc.inner hφ')
  have hFTC := intervalIntegral.integral_eq_sub_of_hasDerivAt (a := 1) (b := u)
    (fun v _ => hg v) (hgc.intervalIntegrable _ _)
  have hh : Continuous fun v => ‖φ v‖ * ‖φ' v‖ := hφc.norm.mul hφ'.norm
  have h1 : ∫ v in (1 : ℝ)..u, 2 * inner ℝ (φ v) (φ' v) ≤
      ∫ v in (1 : ℝ)..u, 2 * (‖φ v‖ * ‖φ' v‖) :=
    intervalIntegral.integral_mono_on hu.1 (hgc.intervalIntegrable _ _)
      ((continuous_const.mul hh).intervalIntegrable _ _) fun v _ => by
        have := real_inner_le_norm (φ v) (φ' v); linarith
  have h2 : ∫ v in (1 : ℝ)..u, 2 * (‖φ v‖ * ‖φ' v‖) ≤
      ∫ v in (1 : ℝ)..2, 2 * (‖φ v‖ * ‖φ' v‖) :=
    intervalIntegral.integral_mono_interval le_rfl hu.1 hu.2
      (Filter.Eventually.of_forall fun v => by positivity)
      ((continuous_const.mul hh).intervalIntegrable _ _)
  have hI0 : 0 ≤ ∫ v in (1 : ℝ)..2, ‖φ v‖ * ‖φ' v‖ :=
    intervalIntegral.integral_nonneg (by norm_num) fun v _ => by positivity
  have h3 : ‖φ u‖ ^ 2 ≤ ‖φ 1‖ ^ 2 + 2 * ∫ v in (1 : ℝ)..2, ‖φ v‖ * ‖φ' v‖ := by
    simp only [intervalIntegral.integral_const_mul] at h1 h2 hFTC; linarith
  have hint : IntegrableOn (fun v => ‖φ v‖ * ‖φ' v‖) (Ioc (1 : ℝ) 2) :=
    (hh.integrableOn_Icc (a := 1) (b := 2)).mono_set Ioc_subset_Icc_self
  have h4 : ENNReal.ofReal (∫ v in (1 : ℝ)..2, ‖φ v‖ * ‖φ' v‖) =
      ∫⁻ v in Ioc (1 : ℝ) 2, ‖φ v‖ₑ * ‖φ' v‖ₑ := by
    rw [intervalIntegral.integral_of_le (by norm_num),
      ofReal_integral_eq_lintegral_ofReal hint (ae_of_all _ fun v => by positivity)]
    congr 1; funext v; rw [ENNReal.ofReal_mul (norm_nonneg _), ofReal_norm, ofReal_norm]
  calc ‖φ u‖ₑ ^ 2 = ENNReal.ofReal (‖φ u‖ ^ 2) := by
        rw [← ofReal_norm, ENNReal.ofReal_pow (norm_nonneg _)]
    _ ≤ ENNReal.ofReal (‖φ 1‖ ^ 2 + 2 * ∫ v in (1 : ℝ)..2, ‖φ v‖ * ‖φ' v‖) :=
        ENNReal.ofReal_le_ofReal h3
    _ = ‖φ 1‖ₑ ^ 2 + 2 * ∫⁻ v in Ioc (1 : ℝ) 2, ‖φ v‖ₑ * ‖φ' v‖ₑ := by
        rw [ENNReal.ofReal_add (by positivity) (by positivity), ENNReal.ofReal_mul (by norm_num),
          h4, ← ofReal_norm, ENNReal.ofReal_pow (norm_nonneg _)]
        norm_num

/-- `∑_x ∫ g_x ≤ ∫ ∑_x g_x` for `[0, ∞]`-valued functions (no measurability needed). -/
lemma tsum_lintegral_le_lintegral_tsum {α β : Type*} [MeasurableSpace α] {μ : Measure α}
    (g : β → α → ℝ≥0∞) : ∑' b, ∫⁻ a, g b a ∂μ ≤ ∫⁻ a, ∑' b, g b a ∂μ := by
  classical
  rw [ENNReal.tsum_eq_iSup_sum]
  refine iSup_le fun S => ?_
  refine le_trans ?_ (lintegral_mono fun a => ENNReal.sum_le_tsum S)
  induction S using Finset.induction_on with
  | empty => simp
  | insert b S hb ih =>
    rw [Finset.sum_insert hb]
    refine (add_le_add le_rfl ih).trans (le_trans (le_lintegral_add _ _) (le_of_eq ?_))
    congr 1; funext a; rw [Finset.sum_insert hb]

/-- `(t, η) ↦ Ψ_a(t, η)` is continuous for continuous compactly supported amplitudes. -/
lemma continuous_radialOscInt {a : EuclideanSpace ℝ (Fin n) → ℂ} (ha : Continuous a)
    {S : Set (EuclideanSpace ℝ (Fin n))} (hS : IsCompact S) (haS : ∀ z, z ∉ S → a z = 0) :
    Continuous fun q : ℝ × EuclideanSpace ℝ (Fin n) => radialOscInt d a q.1 q.2 := by
  unfold radialOscInt
  have hai : Integrable a := osc_integrable_of_vanish ha hS haS
  have hP : Continuous (radialPoly n d) := (contDiff_radialPoly d).continuous
  refine continuous_of_dominated (bound := fun z => ‖a z‖) (fun q => ?_)
    (fun q => ae_of_all _ fun z => ?_) hai.norm (ae_of_all _ fun z => ?_)
  · exact (((continuous_eC.comp ((continuous_const.mul hP).sub
      (continuous_id.inner continuous_const))).mul ha)).aestronglyMeasurable
  · rw [norm_mul, norm_eC, one_mul]
  · exact (continuous_eC.comp ((continuous_fst.mul continuous_const).sub
      (continuous_const.inner continuous_snd))).mul continuous_const


/-- The `u`-derivative symbol `∂_u Φ_{j, σ u 2^{ℓ-Dj}} = σ 2^ℓ (∂_t Ψ)(σ u 2^ℓ, 2^j ξ)` of (5.3). -/
noncomputable def bandDerSym (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (d : ℕ) (σ : ℝ) (ℓ j : ℤ) (v : ℝ)
    (ξ : EuclideanSpace ℝ (Fin n)) : ℂ :=
  ((σ * (2 : ℝ) ^ ℓ : ℝ) : ℂ) *
    radialOscInt d (radialOscAmpDeriv Ω d) (σ * v * (2 : ℝ) ^ ℓ) ((2 : ℝ) ^ j • ξ)

/-- The lifted band operators are continuously differentiable in the dilation parameter `u`
(the proof of Blueprint Lemma 11.1): `∂_u Lift[Φ_{j, σ u 2^{ℓ-Dj}}](D) f(x) =
Lift[∂_u Φ_{j, σ u 2^{ℓ-Dj}}](D) f(x)` for finitely supported `f`. -/
lemma band_deriv_props (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) (s a : ℕ) {q : ℕ} (hq : 1 ≤ q)
    (σ : ℝ) (ℓ j : ℤ) {f : (Fin n → ℤ) → ℂ} (hf : (Function.support f).Finite)
    (x : Fin n → ℤ) :
    (∀ v, HasDerivAt (fun v => latMult (liftSym n d Ω p s a q
        (radialOscPhi Ω d j (σ * v * (2 : ℝ) ^ (ℓ - (2 * d : ℤ) * j)))) f x)
      (latMult (liftSym n d Ω p s a q (bandDerSym Ω d σ ℓ j v)) f x) v) ∧
    Continuous fun v => latMult (liftSym n d Ω p s a q (bandDerSym Ω d σ ℓ j v)) f x := by
  have ha := isRadialOscAmp_radialOscAmpDeriv hn hΩ d
  have hcont := continuous_radialOscInt (d := d) ha.1.continuous isCompact_radialOscAnnulus ha.2.1
  refine hasDerivAt_latMult_liftSym s a hq
    (M := fun v => radialOscPhi Ω d j (σ * v * (2 : ℝ) ^ (ℓ - (2 * d : ℤ) * j)))
    (M' := bandDerSym Ω d σ ℓ j)
    (fun v => (continuous_radialOscPhi_and_le hΩ j _).1.aestronglyMeasurable)
    (fun v => (continuous_const.mul (hcont.comp (continuous_const.prodMk
      (continuous_const_smul _)))).aestronglyMeasurable)
    (B := ∫ x, ‖dyadicKernel Ω j x‖) (B' := |σ * (2 : ℝ) ^ ℓ| * ∫ z, ‖radialOscAmpDeriv Ω d z‖)
    (fun v ξ => ?_) (fun v ξ => ?_) (fun v ξ => hasDerivAt_radialOscPhi_u hΩ d σ j ℓ ξ v)
    (fun ξ => continuous_const.mul (hcont.comp (Continuous.prodMk (by fun_prop)
      continuous_const))) hf x
  · have h := (continuous_radialOscPhi_and_le (d := d) hΩ j
      (σ * v * (2 : ℝ) ^ (ℓ - (2 * d : ℤ) * j))).2 ξ
    simpa only [norm_bandKer] using h
  · rw [bandDerSym, norm_mul, Complex.norm_real, Real.norm_eq_abs]
    exact mul_le_mul_of_nonneg_left (norm_radialOscInt_le _ _ _ _) (abs_nonneg _)

/-- A single term is bounded by the square function of the suprema. -/
lemma enorm_le_enorm_sqrt_sum_sup {ι κ : Type*} (J : Finset ι) (A : Finset κ)
    (w : ι → κ → ℂ) {j : ι} (hj : j ∈ J) {a : κ} (ha : a ∈ A) :
    ‖w j a‖ₑ ≤ ‖Real.sqrt (∑ j ∈ J, (((A.sup fun a => ‖w j a‖₊ : ℝ≥0)) : ℝ) ^ 2)‖ₑ := by
  rw [← ofReal_norm, ← ofReal_norm]
  refine ENNReal.ofReal_le_ofReal ?_
  rw [Real.norm_of_nonneg (Real.sqrt_nonneg _)]
  have h1 : ‖w j a‖ ≤ ((A.sup fun a => ‖w j a‖₊ : ℝ≥0) : ℝ) := by
    exact_mod_cast Finset.le_sup (f := fun a => ‖w j a‖₊) ha
  calc ‖w j a‖ ≤ Real.sqrt ((((A.sup fun a => ‖w j a‖₊ : ℝ≥0)) : ℝ) ^ 2) := by
        rw [Real.sqrt_sq (NNReal.coe_nonneg _)]; exact h1
    _ ≤ _ := Real.sqrt_le_sqrt (Finset.single_le_sum
        (f := fun j => (((A.sup fun a => ‖w j a‖₊ : ℝ≥0)) : ℝ) ^ 2)
        (fun _ _ => by positivity) hj)

/-- The finite maximal functions of `𝓑_{s,ℓ}`:
`max_{(α, j, μ) ∈ F} |Lift_{s,α}[Φ_{j,μ}](D) f(x)|` for a finite set `F` of admissible triples. -/
noncomputable def bandFin (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ) (ℓ : ℤ)
    (F : Finset (bandIdx d s ℓ)) (f : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) : ℝ :=
  ((F.sup fun i =>
    ‖latMult (liftSym n d Ω p s i.1.1.1 i.1.1.2 (radialOscPhi Ω d i.1.2.1 i.1.2.2)) f x‖₊ :
      ℝ≥0) : ℝ)

lemma enorm_bandFin (s : ℕ) (ℓ : ℤ) (F : Finset (bandIdx d s ℓ)) (f : (Fin n → ℤ) → ℂ)
    (x : Fin n → ℤ) : ‖bandFin n d Ω p s ℓ F f x‖ₑ = F.sup fun i =>
      ‖latMult (liftSym n d Ω p s i.1.1.1 i.1.1.2 (radialOscPhi Ω d i.1.2.1 i.1.2.2)) f x‖ₑ := by
  rw [bandFin, Real.enorm_eq_ofReal (NNReal.coe_nonneg _), ENNReal.ofReal_coe_nnreal,
    ENNReal.coe_finset_sup]
  rfl

lemma bandFin_nonneg (s : ℕ) (ℓ : ℤ) (F : Finset (bandIdx d s ℓ)) (f : (Fin n → ℤ) → ℂ)
    (x : Fin n → ℤ) : 0 ≤ bandFin n d Ω p s ℓ F f x := NNReal.coe_nonneg _

/-- Every admissible `μ` is `σ u 2^{ℓ - Dj}` with `σ = ±1` and `u ∈ [1, 2]`. -/
lemma exists_sign_dil {ℓ j : ℤ} {μ : ℝ}
    (h1 : (2 : ℝ) ^ ℓ ≤ |μ| * (2 : ℝ) ^ ((2 * d : ℤ) * j))
    (h2 : |μ| * (2 : ℝ) ^ ((2 * d : ℤ) * j) ≤ (2 : ℝ) ^ (ℓ + 1)) :
    ∃ σ : ℝ, (σ = 1 ∨ σ = -1) ∧ ∃ u ∈ Icc (1 : ℝ) 2,
      μ = σ * u * (2 : ℝ) ^ (ℓ - (2 * d : ℤ) * j) := by
  have hX0 : 0 < (2 : ℝ) ^ ((2 * d : ℤ) * j) := by positivity
  have hT0 : 0 < (2 : ℝ) ^ ℓ := by positivity
  have h2' : |μ| * (2 : ℝ) ^ ((2 * d : ℤ) * j) ≤ 2 * (2 : ℝ) ^ ℓ := by
    rw [zpow_add_one₀ two_ne_zero] at h2; linarith
  have hsub : (2 : ℝ) ^ (ℓ - (2 * d : ℤ) * j) =
      (2 : ℝ) ^ ℓ / (2 : ℝ) ^ ((2 * d : ℤ) * j) := by
    rw [zpow_sub₀ two_ne_zero]
  refine ⟨if 0 ≤ μ then 1 else -1, by split_ifs <;> simp,
    |μ| * (2 : ℝ) ^ ((2 * d : ℤ) * j) / (2 : ℝ) ^ ℓ, ⟨?_, ?_⟩, ?_⟩
  · rw [le_div_iff₀ hT0]; linarith
  · rw [div_le_iff₀ hT0]; linarith
  · rw [hsub]
    split_ifs with hμ
    · rw [abs_of_nonneg hμ]; field_simp
    · rw [abs_of_neg (not_le.1 hμ)]; field_simp

/-- **The uniform `ℓ²` bound for finite families** (the proof of Blueprint Lemma 11.1, `p = 2`):
there are `γ > 0` and `C` such that for every `p`, `s ≥ 1`, `ℓ ∈ ℤ`, every finite set `F` of
admissible triples and every finitely supported `f`,
`‖max_{F} |Lift_{s,α}[Φ_{j,μ}](D) f|‖₂ ≤ C 2^{-γ s} ‖f‖₂`. The proof uses the fundamental theorem
of calculus in `u`, Cauchy–Schwarz, eq. (9.9) and eqs. (5.2), (5.3). -/
lemma band_two_finset (hn : 1 ≤ n) (hd : 1 ≤ d) (hΩ : IsSWProfile Ω) :
    ∃ γ : ℝ, 0 < γ ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ (p : ℝ) (s : ℕ), 1 ≤ s → ∀ (ℓ : ℤ)
      (F : Finset (bandIdx d s ℓ)) (f : (Fin n → ℤ) → ℂ), (Function.support f).Finite →
        eLpNorm (bandFin n d Ω p s ℓ F f) 2 Measure.count ≤
          ENNReal.ofReal (C * (2 : ℝ) ^ (-(γ * s))) * eLpNorm f 2 Measure.count := by
  obtain ⟨γ, hγ, CL, hCL, hsq⟩ := lift_square_two n d hn hd
  obtain ⟨CG, hCG, hG⟩ := radialOscPhi_square hn hd hΩ
  obtain ⟨CH, hCH, hH⟩ := radialOscPhi_deriv_square hn hd hΩ
  refine ⟨γ, hγ, CL * Real.sqrt (2 * (CG + 2 * Real.sqrt (CG * CH))), by positivity,
    fun p s hs ℓ F f hf => ?_⟩
  have hf1 : Summable fun z => ‖f z‖ := summable_of_finite_support hf
  set J : Finset ℤ := F.image fun i => i.1.2.1 with hJ
  set cG : ℝ := if 0 ≤ ℓ then (2 : ℝ) ^ (-(n : ℤ) * ℓ) else 1 with hcG
  set cH : ℝ := if 0 ≤ ℓ then (2 : ℝ) ^ ((2 - n : ℤ) * ℓ) else (2 : ℝ) ^ (2 * ℓ) with hcH
  have hcG0 : 0 ≤ cG := by rw [hcG]; split_ifs <;> positivity
  have hcH0 : 0 ≤ cH := by rw [hcH]; split_ifs <;> positivity
  have hcG1 : cG ≤ 1 := by
    rw [hcG]; split_ifs with hℓ
    · exact zpow_le_one_of_nonpos₀ (by norm_num) (by nlinarith)
    · exact le_rfl
  have hcGH : cG * cH ≤ 1 := by
    rw [hcG, hcH]; split_ifs with hℓ
    · rw [← zpow_add₀ two_ne_zero]
      exact zpow_le_one_of_nonpos₀ (by norm_num) (by
        have : (1 : ℤ) ≤ n := by exact_mod_cast hn
        nlinarith)
    · rw [one_mul]; exact zpow_le_one_of_nonpos₀ (by norm_num) (by omega)
  set BG := Real.sqrt (CG * cG) with hBG
  set BH := Real.sqrt (CH * cH) with hBH
  set K : ℝ := CL * (2 : ℝ) ^ (-(γ * s)) with hK
  have hK0 : 0 ≤ K := by positivity
  set N := eLpNorm f 2 Measure.count with hN
  -- the square functions
  set g : ℝ → ℝ → (Fin n → ℤ) → ℝ := fun σ v x => Real.sqrt (∑ j ∈ J,
    ((((liftRat s).sup fun aq => ‖latMult (liftSym n d Ω p s aq.1 aq.2
      (radialOscPhi Ω d j (σ * v * (2 : ℝ) ^ (ℓ - (2 * d : ℤ) * j)))) f x‖₊ : ℝ≥0)) : ℝ) ^ 2)
    with hgdef
  set h : ℝ → ℝ → (Fin n → ℤ) → ℝ := fun σ v x => Real.sqrt (∑ j ∈ J,
    ((((liftRat s).sup fun aq => ‖latMult (liftSym n d Ω p s aq.1 aq.2
      (bandDerSym Ω d σ ℓ j v)) f x‖₊ : ℝ≥0)) : ℝ) ^ 2) with hhdef
  have hgL2 : ∀ σ : ℝ, (σ = 1 ∨ σ = -1) → ∀ v ∈ Icc (1 : ℝ) 2,
      eLpNorm (g σ v) 2 Measure.count ≤ ENNReal.ofReal (K * BG) * N := by
    intro σ hσ v hv
    exact hsq Ω p s hs J (fun j => radialOscPhi Ω d j (σ * v * (2 : ℝ) ^ (ℓ - (2 * d : ℤ) * j)))
      BG (fun j _ => (continuous_radialOscPhi_and_le hΩ j _).1.aestronglyMeasurable)
      (Real.sqrt_nonneg _) (fun η => by
        rw [hBG, Real.sq_sqrt (by positivity)]; exact hG σ hσ v hv ℓ J η) f hf1
  have hhL2 : ∀ σ : ℝ, (σ = 1 ∨ σ = -1) → ∀ v ∈ Icc (1 : ℝ) 2,
      eLpNorm (h σ v) 2 Measure.count ≤ ENNReal.ofReal (K * BH) * N := by
    intro σ hσ v hv
    have ha := isRadialOscAmp_radialOscAmpDeriv hn hΩ d
    have hcont := continuous_radialOscInt (d := d) ha.1.continuous isCompact_radialOscAnnulus
      ha.2.1
    exact hsq Ω p s hs J (fun j => bandDerSym Ω d σ ℓ j v) BH
      (fun j _ => (continuous_const.mul (hcont.comp (continuous_const.prodMk
        (continuous_const_smul _)))).aestronglyMeasurable)
      (Real.sqrt_nonneg _) (fun η => by
        rw [hBH, Real.sq_sqrt (by positivity)]; exact (hH σ hσ v hv ℓ J η).2) f hf1
  -- the pointwise square inequality
  set Q : ℝ → (Fin n → ℤ) → ℝ≥0∞ := fun σ x => ‖g σ 1 x‖ₑ ^ 2 +
    2 * ∫⁻ v in Ioc (1 : ℝ) 2, ‖g σ v x‖ₑ * ‖h σ v x‖ₑ with hQ
  have hpt : ∀ x, ‖bandFin n d Ω p s ℓ F f x‖ₑ ^ 2 ≤ Q 1 x + Q (-1) x := by
    intro x
    have key : ∀ i ∈ F, ‖latMult (liftSym n d Ω p s i.1.1.1 i.1.1.2
        (radialOscPhi Ω d i.1.2.1 i.1.2.2)) f x‖ₑ ^ 2 ≤ Q 1 x + Q (-1) x := by
      rintro ⟨⟨aq, j, μ⟩, haq, hj, hb1, hb2⟩ hi
      have hjJ : j ∈ J := Finset.mem_image.2 ⟨_, hi, rfl⟩
      have hq : 1 ≤ aq.2 := one_le_of_mem_liftRat (a := aq.1) (by simpa using haq)
      obtain ⟨σ, hσ, u, hu, hμ⟩ := exists_sign_dil (d := d) (ℓ := ℓ) (j := j) (μ := μ) hb1 hb2
      subst hμ
      obtain ⟨hder, hcont⟩ := band_deriv_props (p := p) hn hΩ s aq.1 hq σ ℓ j hf x
      have hF := enorm_sq_le_of_hasDerivAt hder hcont hu
      have hQσ : Q σ x ≤ Q 1 x + Q (-1) x := by
        rcases hσ with rfl | rfl
        · exact le_self_add
        · exact le_add_self
      refine le_trans ?_ hQσ
      refine hF.trans (add_le_add (pow_le_pow_left' ?_ 2)
        (mul_le_mul' le_rfl (lintegral_mono fun v => mul_le_mul' ?_ ?_)))
      · exact enorm_le_enorm_sqrt_sum_sup J (liftRat s) (fun j aq => latMult (liftSym n d Ω p s
          aq.1 aq.2 (radialOscPhi Ω d j (σ * 1 * (2 : ℝ) ^ (ℓ - (2 * d : ℤ) * j)))) f x) hjJ haq
      · exact enorm_le_enorm_sqrt_sum_sup J (liftRat s) (fun j aq => latMult (liftSym n d Ω p s
          aq.1 aq.2 (radialOscPhi Ω d j (σ * v * (2 : ℝ) ^ (ℓ - (2 * d : ℤ) * j)))) f x) hjJ haq
      · exact enorm_le_enorm_sqrt_sum_sup J (liftRat s) (fun j aq => latMult (liftSym n d Ω p s
          aq.1 aq.2 (bandDerSym Ω d σ ℓ j v)) f x) hjJ haq
    rw [enorm_bandFin]
    rcases F.eq_empty_or_nonempty with hF | hF
    · simp [hF]
    · obtain ⟨i, hi, he⟩ := Finset.exists_mem_eq_sup F hF (fun i => ‖latMult (liftSym n d Ω p s
        i.1.1.1 i.1.1.2 (radialOscPhi Ω d i.1.2.1 i.1.2.2)) f x‖ₑ)
      rw [he]; exact key i hi
  -- summation in `x`
  set A := ENNReal.ofReal (K * BG) * N with hA
  set B := ENNReal.ofReal (K * BH) * N with hB
  have hQsum : ∀ σ : ℝ, (σ = 1 ∨ σ = -1) → ∑' x, Q σ x ≤ A ^ 2 + 2 * (A * B) := by
    intro σ hσ
    have h1 : ∑' x, ‖g σ 1 x‖ₑ ^ 2 ≤ A ^ 2 := by
      rw [← arith_eLpNorm_two_sq_eq_tsum]
      exact pow_le_pow_left' (hgL2 σ hσ 1 ⟨le_rfl, one_le_two⟩) 2
    have h2 : ∑' x, ∫⁻ v in Ioc (1 : ℝ) 2, ‖g σ v x‖ₑ * ‖h σ v x‖ₑ ≤ A * B := by
      refine (tsum_lintegral_le_lintegral_tsum _).trans ?_
      refine (setLIntegral_mono' (g := fun _ => A * B) measurableSet_Ioc
        fun v hv => ?_).trans (le_of_eq ?_)
      · have hvI : v ∈ Icc (1 : ℝ) 2 := Ioc_subset_Icc_self hv
        rw [← lintegral_count]
        exact (band_lintegral_enorm_mul_le AEStronglyMeasurable.of_discrete
          AEStronglyMeasurable.of_discrete).trans (mul_le_mul' (hgL2 σ hσ v hvI) (hhL2 σ hσ v hvI))
      · rw [setLIntegral_const, Real.volume_Ioc]; norm_num
    simp only [hQ]
    rw [ENNReal.tsum_add, ENNReal.tsum_mul_left]
    exact add_le_add h1 (mul_le_mul' le_rfl h2)
  have htot : eLpNorm (bandFin n d Ω p s ℓ F f) 2 Measure.count ^ 2 ≤
      2 * (A ^ 2 + 2 * (A * B)) := by
    rw [arith_eLpNorm_two_sq_eq_tsum]
    calc ∑' x, ‖bandFin n d Ω p s ℓ F f x‖ₑ ^ 2 ≤ ∑' x, (Q 1 x + Q (-1) x) :=
          ENNReal.tsum_le_tsum hpt
      _ = ∑' x, Q 1 x + ∑' x, Q (-1) x := ENNReal.tsum_add
      _ ≤ (A ^ 2 + 2 * (A * B)) + (A ^ 2 + 2 * (A * B)) :=
          add_le_add (hQsum 1 (Or.inl rfl)) (hQsum (-1) (Or.inr rfl))
      _ = 2 * (A ^ 2 + 2 * (A * B)) := by ring
  -- the constants
  set Z : ℝ := 2 * ((K * BG) ^ 2 + 2 * ((K * BG) * (K * BH))) with hZ
  have hZ0 : 0 ≤ Z := by positivity
  have eZ : 2 * (A ^ 2 + 2 * (A * B)) = ENNReal.ofReal Z * N ^ 2 := by
    have hKG : 0 ≤ K * BG := mul_nonneg hK0 (Real.sqrt_nonneg _)
    have hKH : 0 ≤ K * BH := mul_nonneg hK0 (Real.sqrt_nonneg _)
    rw [hZ, ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 2), ENNReal.ofReal_add (pow_nonneg hKG 2)
      (mul_nonneg (by norm_num) (mul_nonneg hKG hKH)),
      ENNReal.ofReal_pow hKG, ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 2),
      ENNReal.ofReal_mul hKG, hA, hB]
    simp only [ENNReal.ofReal_ofNat]
    ring
  rw [eZ] at htot
  have h3 := band_le_of_sq_le htot
  refine h3.trans (mul_le_mul_left ?_ _)
  rw [ENNReal.ofReal_rpow_of_nonneg hZ0 (by norm_num), ← Real.sqrt_eq_rpow]
  refine ENNReal.ofReal_le_ofReal ?_
  have hBG2 : BG ^ 2 ≤ CG := by
    rw [hBG, Real.sq_sqrt (by positivity)]; nlinarith
  have hBGH : BG * BH ≤ Real.sqrt (CG * CH) := by
    rw [hBG, hBH, ← Real.sqrt_mul (by positivity)]
    refine Real.sqrt_le_sqrt ?_
    calc CG * cG * (CH * cH) = CG * CH * (cG * cH) := by ring
      _ ≤ CG * CH * 1 := mul_le_mul_of_nonneg_left hcGH (by positivity)
      _ = CG * CH := mul_one _
  have hW : Z ≤ (K * Real.sqrt (2 * (CG + 2 * Real.sqrt (CG * CH)))) ^ 2 := by
    rw [mul_pow, Real.sq_sqrt (by positivity), hZ]
    have hK2 : 0 ≤ K ^ 2 := by positivity
    nlinarith
  calc Real.sqrt Z ≤ Real.sqrt ((K * Real.sqrt (2 * (CG + 2 * Real.sqrt (CG * CH)))) ^ 2) :=
        Real.sqrt_le_sqrt hW
    _ = K * Real.sqrt (2 * (CG + 2 * Real.sqrt (CG * CH))) := Real.sqrt_sq (by positivity)
    _ = CL * Real.sqrt (2 * (CG + 2 * Real.sqrt (CG * CH))) * (2 : ℝ) ^ (-(γ * s)) := by
        rw [hK]; ring


/-! ### Blueprint Lemma 11.1 (`lem:middleband`): endpoint bounds and interpolation -/

lemma one_le_of_mem_bandIdx {s : ℕ} {ℓ : ℤ} (i : bandIdx d s ℓ) : 1 ≤ i.1.1.2 :=
  one_le_of_mem_liftRat (a := i.1.1.1) (by simpa using i.2.1)

/-- Subadditivity of the finite maximal functions on `ℓ¹`. -/
lemma bandFin_add_le (hΩ : IsSWProfile Ω) (s : ℕ) (ℓ : ℤ) (F : Finset (bandIdx d s ℓ))
    {f g : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) (hg : Summable fun z => ‖g z‖)
    (x : Fin n → ℤ) :
    bandFin n d Ω p s ℓ F (f + g) x ≤ bandFin n d Ω p s ℓ F f x + bandFin n d Ω p s ℓ F g x := by
  refine arith_coe_finset_sup_nnnorm_le
    (add_nonneg (bandFin_nonneg s ℓ F f x) (bandFin_nonneg s ℓ F g x)) fun i hi => ?_
  obtain ⟨hc, hb⟩ := continuous_radialOscPhi_and_le (d := d) hΩ i.1.2.1 i.1.2.2
  have hint := integrableOn_liftSym (n := n) (d := d) (Ω := Ω) (p := p) (a := i.1.1.1)
    (q := i.1.1.2) (integrable_mul_liftChi (s := s) hc.aestronglyMeasurable (fun ξ _ => hb ξ))
  rw [latMult_add hint hf hg, Pi.add_apply]
  refine (norm_add_le _ _).trans (add_le_add ?_ ?_)
  · exact_mod_cast Finset.le_sup (f := fun i : bandIdx d s ℓ =>
      ‖latMult (liftSym n d Ω p s i.1.1.1 i.1.1.2 (radialOscPhi Ω d i.1.2.1 i.1.2.2)) f x‖₊) hi
  · exact_mod_cast Finset.le_sup (f := fun i : bandIdx d s ℓ =>
      ‖latMult (liftSym n d Ω p s i.1.1.1 i.1.1.2 (radialOscPhi Ω d i.1.2.1 i.1.2.2)) g x‖₊) hi

/-- Finitely supported functions form a truncation closed class. -/
lemma isTruncationClosed_finite_support :
    IsTruncationClosed {f : (Fin n → ℤ) → ℂ | (Function.support f).Finite} := by
  intro f hf s _
  have hf' : (Function.support f).Finite := hf
  refine ⟨hf'.subset fun x hx => ?_, hf'.subset fun x hx => ?_⟩
  · intro h0; apply hx; simp [Set.indicator_apply, h0]
  · intro h0; apply hx; simp [Set.indicator_apply, h0]

/-- Weak type `(1, 1)` of the finite maximal functions, uniformly in `p, s, ℓ, F` (Lemma 9.4 and
the maximal theorem on `ℤⁿ`). -/
lemma hasWeakTypeOn_one_bandFin (hΩ : IsSWProfile Ω) :
    ∃ A : ℝ≥0, ∀ (p : ℝ) (s : ℕ) (ℓ : ℤ) (F : Finset (bandIdx d s ℓ)),
      HasWeakTypeOn (bandFin n d Ω p s ℓ F) {f | (Function.support f).Finite} 1 A
        Measure.count Measure.count := by
  obtain ⟨C, hC, hdom⟩ := lift_envelope n d hΩ
  have hE : 0 ≤ envelopeConst n := by unfold envelopeConst; positivity
  set c : ℝ := C * envelopeConst n + 1 with hc
  have hc0 : 0 < c := by positivity
  refine ⟨(5 ^ n : ℝ≥0) * c.toNNReal, fun p s ℓ F f hf t ht => ?_⟩
  have hf1 : Summable fun z => ‖f z‖ := summable_of_finite_support hf
  by_cases htop : t = (⊤ : ℝ≥0∞)
  · simp [distributionFunction, htop]
  set c' : ℝ≥0∞ := ENNReal.ofReal c with hc'
  have hc'0 : c' ≠ 0 := by rw [hc']; simpa using hc0
  have hc't : c' ≠ (⊤ : ℝ≥0∞) := ENNReal.ofReal_ne_top
  have hsub : {x | t < ‖bandFin n d Ω p s ℓ F f x‖ₑ} ⊆
      {x | t / c' < cubeMaximalInt n f x} := by
    intro x hx
    simp only [mem_ofPred_eq] at hx ⊢
    rw [ENNReal.div_lt_iff (Or.inl hc'0) (Or.inl hc't)]
    refine hx.trans_le ?_
    rw [enorm_bandFin]
    refine Finset.sup_le fun i _ => ((hdom p s i.1.2.1 i.1.2.2 i.1.1.1 i.1.1.2
      (one_le_of_mem_bandIdx i) f hf1 x).2).trans ?_
    rw [mul_comm]
    gcongr
    exact ENNReal.ofReal_le_ofReal (by linarith)
  have hw := cubeMaximalInt_weak_one n f (t / c')
  calc distributionFunction (bandFin n d Ω p s ℓ F f) t Measure.count
      ≤ Measure.count {x | t / c' < cubeMaximalInt n f x} := measure_mono hsub
    _ ≤ ((5 ^ n : ℝ≥0) : ℝ≥0∞) / (t / c') * ∫⁻ y, ‖f y‖ₑ ∂Measure.count := hw
    _ = ((((5 ^ n : ℝ≥0) * c.toNNReal : ℝ≥0) : ℝ≥0∞) *
          eLpNorm f (ENNReal.ofReal 1) Measure.count / t) ^ (1 : ℝ) := by
        rw [ENNReal.rpow_one, ENNReal.ofReal_one,
          eLpNorm_one_eq_lintegral_enorm AEStronglyMeasurable.of_discrete, ENNReal.coe_mul]
        change _ = _ * c' * _ / t
        rw [ENNReal.div_eq_inv_mul (b := t / c'), ENNReal.inv_div (Or.inl hc't) (Or.inl hc'0)]
        simp only [div_eq_mul_inv]
        ring

/-- The `ℓ^∞` bound of the finite maximal functions, uniformly in `p, s, ℓ, F` (Lemma 9.4 and the
lattice sum of the envelope). -/
lemma hasLinftyBoundOn_bandFin (hΩ : IsSWProfile Ω) :
    ∃ A : ℝ≥0, 0 < A ∧ ∀ (p : ℝ) (s : ℕ) (ℓ : ℤ) (F : Finset (bandIdx d s ℓ)),
      HasLinftyBoundOn (bandFin n d Ω p s ℓ F) {f | (Function.support f).Finite} A
        Measure.count := by
  obtain ⟨C, hC, hdom⟩ := lift_envelope n d hΩ
  have hE : 0 ≤ envelopeConst n := by unfold envelopeConst; positivity
  refine ⟨(C * envelopeConst n + 1).toNNReal, Real.toNNReal_pos.2 (by positivity),
    fun p s ℓ F f hf S hS => ae_of_all _ fun x => ?_⟩
  have hf1 : Summable fun z => ‖f z‖ := summable_of_finite_support hf
  have hS0 : 0 ≤ S := (norm_nonneg _).trans (hS 0)
  rw [Real.norm_of_nonneg (bandFin_nonneg s ℓ F f x), Real.coe_toNNReal _ (by positivity)]
  refine arith_coe_finset_sup_nnnorm_le (by positivity) fun i _ => ?_
  refine ((hdom p s i.1.2.1 i.1.2.2 i.1.1.1 i.1.1.2 (one_le_of_mem_bandIdx i) f hf1 x).1).trans ?_
  set R := max ((2 : ℝ) ^ i.1.2.1) (liftL n d Ω p s : ℝ) with hRdef
  have hR : 1 ≤ R := le_max_of_le_right (one_le_liftL s)
  obtain ⟨hsE, hsum⟩ := summable_latEnvelope_and_tsum_le (n := n) hR
  have hle : ∀ y, latEnvelope n R y * ‖f (x - y)‖ ≤ latEnvelope n R y * S := fun y =>
    mul_le_mul_of_nonneg_left (hS _) (envelope_nonneg (by linarith) _)
  have h1 : ∑' y, latEnvelope n R y * ‖f (x - y)‖ ≤ ∑' y, latEnvelope n R y * S :=
    Summable.tsum_le_tsum hle (Summable.of_nonneg_of_le
      (fun y => mul_nonneg (envelope_nonneg (by linarith) _) (norm_nonneg _)) hle
      (hsE.mul_right S)) (hsE.mul_right S)
  rw [tsum_mul_right] at h1
  calc C * ∑' y, latEnvelope n R y * ‖f (x - y)‖
      ≤ C * ((∑' y, latEnvelope n R y) * S) := mul_le_mul_of_nonneg_left h1 hC
    _ ≤ C * (envelopeConst n * S) := by gcongr
    _ ≤ (C * envelopeConst n + 1) * S := by nlinarith

/-- Marcinkiewicz interpolation (Blueprint Lemma 2.3) of the uniform weak `(1,1)` and `ℓ^∞` bounds
with the `ℓ²` bound `C 2^{-γ s}` of `band_two_finset`: for `1 < t < ∞`,
`‖max_F |Lift_{s,α}[Φ_{j,μ}](D) f|‖_t ≤ C_t 2^{-γ a_t s} ‖f‖_t`, `a_t = min(2/t, 2/t')`. -/
lemma band_lp_finset (hn : 1 ≤ n) (hd : 1 ≤ d) (hΩ : IsSWProfile Ω) {t : ℝ} (ht : 1 < t) :
    ∃ γ : ℝ, 0 < γ ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ (p : ℝ) (s : ℕ), 1 ≤ s → ∀ (ℓ : ℤ)
      (F : Finset (bandIdx d s ℓ)) (f : (Fin n → ℤ) → ℂ), (Function.support f).Finite →
        eLpNorm (bandFin n d Ω p s ℓ F f) (ENNReal.ofReal t) Measure.count ≤
          ENNReal.ofReal (C * (2 : ℝ) ^ (-(γ * paramA t * s))) *
            eLpNorm f (ENNReal.ofReal t) Measure.count := by
  obtain ⟨γ, hγ, C₂, hC₂, h2⟩ := band_two_finset hn hd hΩ
  obtain ⟨A₁, hA₁⟩ := hasWeakTypeOn_one_bandFin (n := n) (d := d) hΩ
  obtain ⟨A₂, hA₂pos, hA₂⟩ := hasLinftyBoundOn_bandFin (n := n) (d := d) hΩ
  set D := {f : (Fin n → ℤ) → ℂ | (Function.support f).Finite}
  set Bs : ℕ → ℝ≥0 := fun s => (C₂ * (2 : ℝ) ^ (-(γ * s))).toNNReal with hBs
  have hsub : ∀ p s ℓ (F : Finset (bandIdx d s ℓ)),
      IsSublinearOn (bandFin n d Ω p s ℓ F) D Measure.count := by
    intro p s ℓ F f hf g hg
    refine ae_of_all _ fun x => ?_
    rw [Real.norm_of_nonneg (bandFin_nonneg s ℓ F _ x),
      Real.norm_of_nonneg (bandFin_nonneg s ℓ F _ x),
      Real.norm_of_nonneg (bandFin_nonneg s ℓ F _ x)]
    exact bandFin_add_le hΩ s ℓ F (summable_of_finite_support hf)
      (summable_of_finite_support hg) x
  have htwo : ∀ p s, 1 ≤ s → ∀ ℓ (F : Finset (bandIdx d s ℓ)),
      HasStrongTypeOn (bandFin n d Ω p s ℓ F) D 2 (Bs s) Measure.count Measure.count := by
    intro p s hs ℓ F f hf
    rw [ENNReal.ofReal_ofNat]
    exact h2 p s hs ℓ F f hf
  -- the interpolated bound with a constant `K` and the power `a_t` of the `ℓ²` constant
  obtain ⟨K, hK, hKb⟩ : ∃ K : ℝ≥0∞, K ≠ ⊤ ∧ ∀ (p : ℝ) (s : ℕ), 1 ≤ s → ∀ (ℓ : ℤ)
      (F : Finset (bandIdx d s ℓ)) (f : (Fin n → ℤ) → ℂ), (Function.support f).Finite →
        eLpNorm (bandFin n d Ω p s ℓ F f) (ENNReal.ofReal t) Measure.count ≤
          K * (Bs s : ℝ≥0∞) ^ paramA t * eLpNorm f (ENNReal.ofReal t) Measure.count := by
    rcases lt_trichotomy t 2 with ht2 | rfl | ht2
    · set θ : ℝ := 2 - 2 / t
      have hθ : 1 / t = (1 - θ) / 1 + θ / 2 := by simp only [θ]; field_simp; ring
      have h1θ : 0 ≤ 1 - θ := by
        have : 1 ≤ 2 / t := by rw [le_div_iff₀ (by linarith)]; linarith
        simp only [θ]; linarith
      refine ⟨(marcinkiewiczConst 1 2 t : ℝ≥0∞) * (A₁ : ℝ≥0∞) ^ (1 - θ),
        ENNReal.mul_ne_top ENNReal.coe_ne_top
          (ENNReal.rpow_ne_top_of_nonneg h1θ ENNReal.coe_ne_top),
        fun p s hs ℓ F f hf => ?_⟩
      rw [paramA_eq_of_le_two ht ht2.le]
      refine (eLpNorm_le_of_hasWeakTypeOn one_pos ht ht2 hθ
        (hA₁ p s ℓ F) ((htwo p s hs ℓ F).hasWeakTypeOn two_pos)
        (hsub p s ℓ F) isTruncationClosed_finite_support hf AEStronglyMeasurable.of_discrete
        AEStronglyMeasurable.of_discrete).trans (le_of_eq ?_)
      ring
    · refine ⟨1, ENNReal.one_ne_top, fun p s hs ℓ F f hf => ?_⟩
      rw [paramA_eq_of_two_le ht le_rfl, div_self two_ne_zero, ENNReal.rpow_one, one_mul]
      exact htwo p s hs ℓ F f hf
    · have h1 : 0 ≤ 1 - 2 / t := by rw [sub_nonneg, div_le_one (by linarith)]; linarith
      refine ⟨(marcinkiewiczConstTop 2 t : ℝ≥0∞) * (A₂ : ℝ≥0∞) ^ (1 - 2 / t),
        ENNReal.mul_ne_top ENNReal.coe_ne_top (ENNReal.rpow_ne_top_of_nonneg h1 ENNReal.coe_ne_top),
        fun p s hs ℓ F f hf => ?_⟩
      rw [paramA_eq_of_two_le ht ht2.le]
      calc eLpNorm (bandFin n d Ω p s ℓ F f) (ENNReal.ofReal t) Measure.count
          ≤ (marcinkiewiczConstTop 2 t : ℝ≥0∞) * (Bs s : ℝ≥0∞) ^ (2 / t) *
              (A₂ : ℝ≥0∞) ^ (1 - 2 / t) * eLpNorm f (ENNReal.ofReal t) Measure.count :=
            eLpNorm_le_of_hasWeakTypeOn_of_linfty two_pos ht2
              ((htwo p s hs ℓ F).hasWeakTypeOn two_pos) (hA₂ p s ℓ F) (hsub p s ℓ F)
              isTruncationClosed_finite_support hf AEStronglyMeasurable.of_discrete
              AEStronglyMeasurable.of_discrete (Or.inl hA₂pos)
        _ = _ := by ring
  have ha := paramA_pos ht
  refine ⟨γ, hγ, K.toReal * C₂ ^ paramA t, by positivity, fun p s hs ℓ F f hf => ?_⟩
  refine (hKb p s hs ℓ F f hf).trans (le_of_eq ?_)
  congr 1
  have e1 : ((Bs s : ℝ≥0) : ℝ≥0∞) = ENNReal.ofReal (C₂ * (2 : ℝ) ^ (-(γ * s))) := rfl
  rw [e1, ENNReal.ofReal_rpow_of_nonneg (by positivity) ha.le,
    Real.mul_rpow hC₂ (by positivity), ← Real.rpow_mul (by norm_num),
    ← ENNReal.ofReal_toReal hK, ← ENNReal.ofReal_mul ENNReal.toReal_nonneg]
  congr 1
  rw [ENNReal.ofReal_toReal hK]
  ring_nf

/-- **Blueprint Lemma 11.1 (`lem:middleband`)**, a uniform-in-band arithmetic gain: for
`n, d ≥ 1`, an admissible profile `Ω` and `1 < p < ∞` there are `b_p > 0` and `C_p` such that
for every `s ≥ 1`, every integer `ℓ` and every finitely supported `f`,
`‖𝓑_{s,ℓ} f‖_p ≤ C_p 2^{-b_p s} ‖f‖_p`, where
`𝓑_{s,ℓ} f = sup_{α ∈ 𝓡_s, j ≥ 1, 2^ℓ ≤ |μ| 2^{Dj} ≤ 2^{ℓ+1}} |Lift_{s,α}[Φ_{j,μ}](D) f|`
(`bandOp`). One may take `b_p = γ min(2/p, 2/p')` (`γ` from eq. (9.9)). -/
theorem bandOp_uniform (hn : 1 ≤ n) (hd : 1 ≤ d) (hΩ : IsSWProfile Ω) (hp : 1 < p) :
    ∃ b : ℝ, 0 < b ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ s : ℕ, 1 ≤ s → ∀ ℓ : ℤ,
      ∀ f : (Fin n → ℤ) → ℂ, (Function.support f).Finite →
        eLpNorm (bandOp n d Ω p s ℓ f) (ENNReal.ofReal p) Measure.count ≤
          ENNReal.ofReal (C * (2 : ℝ) ^ (-(b * s))) *
            eLpNorm f (ENNReal.ofReal p) Measure.count := by
  obtain ⟨γ, hγ, C, hC, h⟩ := band_lp_finset hn hd hΩ hp
  refine ⟨γ * paramA p, mul_pos hγ (paramA_pos hp), C, hC, fun s hs ℓ f hf => ?_⟩
  have e : bandOp n d Ω p s ℓ f = fun x => ⨆ i : bandIdx d s ℓ,
      ‖latMult (liftSym n d Ω p s i.1.1.1 i.1.1.2 (radialOscPhi Ω d i.1.2.1 i.1.2.2)) f x‖ₑ :=
    funext fun x => bandOp_eq_iSup s ℓ f x
  rw [e]
  refine eLpNorm_iSup_le_of_finset_count ENNReal.ofReal_ne_top _ _ fun F => ?_
  have h1 := h p s hs ℓ F f hf
  rw [← eLpNorm_enorm _ AEStronglyMeasurable.of_discrete] at h1
  simpa only [enorm_bandFin] using h1

/-! ### Blueprint Theorem 11.3 (`thm:liftedSW`) -/

/-- Minkowski for countable sums of `[0, ∞]`-valued functions on `ℤⁿ` (finite sums and monotone
convergence). -/
lemma eLpNorm_tsum_le_count {q : ℝ≥0∞} (hq : 1 ≤ q) (hq' : q ≠ ⊤)
    (g : ℕ → (Fin n → ℤ) → ℝ≥0∞) :
    eLpNorm (fun x => ∑' k, g k x) q Measure.count ≤ ∑' k, eLpNorm (g k) q Measure.count := by
  have e : (fun x => ∑' k, g k x) = fun x => ⨆ N : ℕ, ∑ k ∈ Finset.range N, g k x :=
    funext fun x => ENNReal.tsum_eq_iSup_nat
  rw [e]
  refine eLpNorm_iSup_le_of_finset_count hq' _ _ fun F => ?_
  have hpt : ∀ x, ‖F.sup fun N => ∑ k ∈ Finset.range N, g k x‖ₑ ≤
      ‖(∑ k ∈ Finset.range (F.sup id), g k) x‖ₑ := by
    intro x
    rw [enorm_eq_self, enorm_eq_self, Finset.sum_apply]
    exact Finset.sup_le fun N hN => Finset.sum_le_sum_of_subset
      (Finset.range_mono (Finset.le_sup (f := id) hN))
  refine (eLpNorm_mono_enorm AEStronglyMeasurable.of_discrete hpt).trans ?_
  exact (eLpNorm_sum_le hq).trans (ENNReal.sum_le_tsum _)

/-- The indices of `[a, b]` satisfying a downward closed condition form an initial interval
`[a, c)`. -/
lemma filter_Icc_eq_Ico (a b : ℕ) (P : ℕ → Prop) [DecidablePred P]
    (hP : ∀ i j, i ≤ j → P j → P i) :
    ∃ c, a ≤ c ∧ (Finset.Icc a b).filter P = Finset.Ico a c := by
  refine ⟨((Finset.Icc a b).filter P).sup (· + 1) ⊔ a, le_sup_right, ?_⟩
  ext j
  simp only [Finset.mem_filter, Finset.mem_Icc, Finset.mem_Ico]
  constructor
  · rintro ⟨⟨h1, h2⟩, h3⟩
    refine ⟨h1, lt_of_lt_of_le (Nat.lt_succ_self j) (le_sup_of_le_left ?_)⟩
    exact Finset.le_sup (f := (· + 1)) (Finset.mem_filter.2 ⟨Finset.mem_Icc.2 ⟨h1, h2⟩, h3⟩)
  · rintro ⟨h1, h2⟩
    rcases lt_sup_iff.1 h2 with h | h
    · obtain ⟨i, hi, hji⟩ := Finset.lt_sup_iff.1 h
      simp only [Finset.mem_filter, Finset.mem_Icc] at hi
      exact ⟨⟨h1, by omega⟩, hP j i (by omega) hi.2⟩
    · omega

/-- Linearity of the lifted operators over finite sums of continuous bounded symbols. -/
lemma latMult_liftSym_finsetSum {s a q : ℕ} {ι : Type*} (F : Finset ι)
    {m : ι → EuclideanSpace ℝ (Fin n) → ℂ} (hc : ∀ i, Continuous (m i)) {M : ι → ℝ}
    (hM : ∀ i ξ, ‖m i ξ‖ ≤ M i) {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖)
    (x : Fin n → ℤ) :
    latMult (liftSym n d Ω p s a q (fun ξ => ∑ i ∈ F, m i ξ)) f x =
      ∑ i ∈ F, latMult (liftSym n d Ω p s a q (m i)) f x := by
  have hM0 : ∀ i, 0 ≤ M i := fun i => (norm_nonneg _).trans (hM i 0)
  have h := latMult_liftSym_sum_mul (d := d) (Ω := Ω) (p := p) (s := s) (a := a) (q := q) F
    (fun _ => 1) (m := m) (fun i _ => (hc i).aestronglyMeasurable) (B := ∑ i ∈ F, M i)
    (fun i hi ξ => (hM i ξ).trans (Finset.single_le_sum (fun j _ => hM0 j) hi)) hf x
  simpa only [one_mul] using h

/-- For `j < j'`, `4 |μ| 2^{Dj} ≤ |μ| 2^{Dj'}` (`D = 2d ≥ 2`). -/
lemma band_weight_four_mul_le (hd : 1 ≤ d) {μ : ℝ} {j j' : ℕ} (h : j < j') :
    4 * (|μ| * (2 : ℝ) ^ ((2 * d : ℤ) * (j : ℤ))) ≤ |μ| * (2 : ℝ) ^ ((2 * d : ℤ) * (j' : ℤ)) := by
  have e : (2 : ℝ) ^ ((2 * d : ℤ) * (j' : ℤ)) =
      (2 : ℝ) ^ ((2 * d : ℤ) * (j : ℤ)) * (2 : ℝ) ^ ((2 * d : ℤ) * ((j' : ℤ) - j)) := by
    rw [← zpow_add₀ two_ne_zero]; congr 1; ring
  have h4 : (4 : ℝ) ≤ (2 : ℝ) ^ ((2 * d : ℤ) * ((j' : ℤ) - j)) := by
    have : (2 : ℤ) ≤ (2 * d : ℤ) * ((j' : ℤ) - j) := by
      have h1 : (1 : ℤ) ≤ (j' : ℤ) - j := by omega
      have h2 : (2 : ℤ) ≤ 2 * (d : ℤ) := by omega
      nlinarith
    calc (4 : ℝ) = (2 : ℝ) ^ (2 : ℤ) := by norm_num
      _ ≤ _ := zpow_le_zpow_right₀ (by norm_num) this
  rw [e]
  have h0 : 0 ≤ |μ| * (2 : ℝ) ^ ((2 * d : ℤ) * (j : ℤ)) := by positivity
  nlinarith

/-- At most one scale lies in a band: `j ↦ ⌊log₂(|μ| 2^{Dj})⌋` is injective where `μ ≠ 0`. -/
lemma band_log_injective (hd : 1 ≤ d) {μ : ℝ} (hμ : μ ≠ 0) {j j' : ℕ}
    (h : Int.log 2 (|μ| * (2 : ℝ) ^ ((2 * d : ℤ) * (j : ℤ))) =
      Int.log 2 (|μ| * (2 : ℝ) ^ ((2 * d : ℤ) * (j' : ℤ)))) : j = j' := by
  have key : ∀ i i' : ℕ, i < i' → Int.log 2 (|μ| * (2 : ℝ) ^ ((2 * d : ℤ) * (i : ℤ))) ≠
      Int.log 2 (|μ| * (2 : ℝ) ^ ((2 * d : ℤ) * (i' : ℤ))) := by
    intro i i' hii' he
    set X := |μ| * (2 : ℝ) ^ ((2 * d : ℤ) * (i : ℤ))
    set X' := |μ| * (2 : ℝ) ^ ((2 * d : ℤ) * (i' : ℤ))
    have hX : 0 < X := by positivity
    have h1 := Int.zpow_log_le_self (b := 2) (by norm_num) hX
    have h2 := Int.lt_zpow_succ_log_self (b := 2) (by norm_num) X'
    rw [← he, zpow_add_one₀ (by norm_num)] at h2
    have h3 := band_weight_four_mul_le (μ := μ) hd hii'
    push_cast at h1 h2
    nlinarith
  rcases lt_trichotomy j j' with hl | he | hl
  · exact absurd h (key j j' hl)
  · exact he
  · exact absurd h.symm (key j' j hl)

/-- The maximal lifted polynomial partial sums of Blueprint Theorem 11.3 (`thm:liftedSW`):
`𝒫_s f(x) = sup_{α ∈ 𝓡_s, μ ∈ ℝ, 1 ≤ a ≤ b} |Lift_{s,α}[∑_{j=a}^b Φ_{j,μ}](D) f(x)|`
(integers `a, b`), valued in `[0, ∞]`. -/
noncomputable def liftedPartialMax (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ)
    (s : ℕ) (f : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) : ℝ≥0∞ :=
  ⨆ (aq ∈ liftRat s) (μ : ℝ) (a : ℕ) (b : ℕ) (_ : 1 ≤ a ∧ a ≤ b),
    ‖latMult (liftSym n d Ω p s aq.1 aq.2
      (fun ξ => ∑ j ∈ Finset.Icc a b, radialOscPhi Ω d j μ ξ)) f x‖ₑ

/-- The low-band error kernel (the proof of Blueprint Theorem 11.3): on the support of `K_j`,
`|e(μ P) - 1| ≤ C |μ| 2^{Dj}`, hence `|(e(μ P) - 1) K_j| ≤ C |μ| 2^{Dj} B_{2^j}`. -/
lemma exists_norm_oscErr_le (hΩ : IsSWProfile Ω) (d : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (j : ℤ) (μ : ℝ) (z : EuclideanSpace ℝ (Fin n)),
      ‖eC (μ * radialPoly n d z) * dyadicKernel Ω j z - dyadicKernel Ω j z‖ ≤
        C * (|μ| * (2 : ℝ) ^ ((2 * d : ℤ) * j)) * envelope n ((2 : ℝ) ^ j) z := by
  obtain ⟨C₂, hC₂, h₂⟩ := exists_norm_oscKernel_le hΩ d
  refine ⟨2 * π * 2 ^ (2 * d) * C₂, by positivity, fun j μ z => ?_⟩
  have hK : ‖dyadicKernel Ω j z‖ ≤ C₂ * envelope n ((2 : ℝ) ^ j) z := by
    simpa [eC_zero] using h₂ j 0 z
  have henv : 0 ≤ envelope n ((2 : ℝ) ^ j) z := envelope_nonneg (by positivity) _
  rw [← sub_one_mul, norm_mul]
  by_cases hz : dyadicKernel Ω j z = 0
  · rw [hz, norm_zero, mul_zero]; positivity
  have hsupp := (support_dyadicKernel (Ω := Ω) j hz).2
  have he : ‖eC (μ * radialPoly n d z) - 1‖ ≤
      2 * π * 2 ^ (2 * d) * (|μ| * (2 : ℝ) ^ ((2 * d : ℤ) * j)) := by
    rw [radialPoly_eq_norm_pow]
    have h1 := norm_eC_sub_eC_le (μ * ‖z‖ ^ (2 * d)) 0
    rw [eC_zero, sub_zero, abs_mul, abs_pow, abs_norm] at h1
    have h2 : ‖z‖ ^ (2 * d) ≤ 2 ^ (2 * d) * (2 : ℝ) ^ ((2 * d : ℤ) * j) := by
      calc ‖z‖ ^ (2 * d) ≤ ((2 : ℝ) ^ (j + 1)) ^ (2 * d) :=
            pow_le_pow_left₀ (norm_nonneg _) hsupp.le _
        _ = _ := by
          rw [← zpow_natCast, ← zpow_mul, ← zpow_natCast (2 : ℝ) (2 * d), ← zpow_add₀ two_ne_zero]
          congr 1; push_cast; ring
    calc _ ≤ 2 * π * (|μ| * ‖z‖ ^ (2 * d)) := h1
      _ ≤ 2 * π * (|μ| * (2 ^ (2 * d) * (2 : ℝ) ^ ((2 * d : ℤ) * j))) := by gcongr
      _ = _ := by ring
  calc ‖eC (μ * radialPoly n d z) - 1‖ * ‖dyadicKernel Ω j z‖
      ≤ (2 * π * 2 ^ (2 * d) * (|μ| * (2 : ℝ) ^ ((2 * d : ℤ) * j))) *
          (C₂ * envelope n ((2 : ℝ) ^ j) z) :=
        mul_le_mul he hK (norm_nonneg _) (by positivity)
    _ = _ := by ring

/-- The pointwise decomposition of `𝒫_s f` (the proof of Blueprint Theorem 11.3): for every
`B ∈ ℕ`, uniformly in `α, μ, a, b`,
`𝒫_s f ≤ ∑_{-B ≤ ℓ < B} 𝓑_{s,ℓ} f + ∑_{ℓ ≥ B} 𝓑_{s,ℓ} f + 2 T f + C 2^{-B} 𝖬 f`, where `T f` is the
maximal function of Lemma 10.1 (`lift_trunc`). -/
lemma liftedPartialMax_le (hd : 1 ≤ d) (hΩ : IsSWProfile Ω) :
    ∃ Ce : ℝ, 0 ≤ Ce ∧ ∀ (s B : ℕ) (f : (Fin n → ℤ) → ℂ), (Function.support f).Finite →
      ∀ x : Fin n → ℤ, liftedPartialMax n d Ω p s f x ≤
        (∑ ℓ ∈ Finset.Ico (-(B : ℤ)) B, bandOp n d Ω p s ℓ f x) +
        (∑' k : ℕ, bandOp n d Ω p s ((B : ℤ) + k) f x) +
        ((⨆ J : ℕ, ⨆ (_ : 1 ≤ J), (liftRat s).sup fun aq =>
            ‖latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω J)) f x‖ₑ) +
          (⨆ J : ℕ, ⨆ (_ : 1 ≤ J), (liftRat s).sup fun aq =>
            ‖latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω J)) f x‖ₑ)) +
        ENNReal.ofReal (Ce * (2 : ℝ) ^ (-(B : ℤ))) * cubeMaximalInt n f x := by
  obtain ⟨C₁, hC₁, h₁⟩ := norm_latMult_liftSym_fourier_le n
  obtain ⟨C₃, hC₃, h₃⟩ := exists_norm_oscErr_le (n := n) hΩ d
  have hE0 : 0 ≤ envelopeConst n := by unfold envelopeConst; positivity
  refine ⟨C₁ * C₃ * envelopeConst n * 2 ^ (2 * d), by positivity, ?_⟩
  intro s B f hf x
  classical
  set T := (⨆ J : ℕ, ⨆ (_ : 1 ≤ J), (liftRat s).sup fun aq =>
    ‖latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω J)) f x‖ₑ) with hT
  have hf1 : Summable fun z => ‖f z‖ := summable_of_finite_support hf
  refine iSup₂_le fun aq haq => iSup_le fun μ => iSup_le fun a => iSup_le fun b =>
    iSup_le fun hab => ?_
  have hq : 1 ≤ aq.2 := one_le_of_mem_liftRat (a := aq.1) (by simpa using haq)
  set X : ℕ → ℝ := fun j => |μ| * (2 : ℝ) ^ ((2 * d : ℤ) * (j : ℤ)) with hX
  set L := (Finset.Icc a b).filter (fun j => X j < (2 : ℝ) ^ (-(B : ℤ))) with hL
  set R := (Finset.Icc a b).filter (fun j => ¬ X j < (2 : ℝ) ^ (-(B : ℤ))) with hR
  -- linearity in the symbol
  have hsum : latMult (liftSym n d Ω p s aq.1 aq.2
      (fun ξ => ∑ j ∈ Finset.Icc a b, radialOscPhi Ω d j μ ξ)) f x =
      ∑ j ∈ L, latMult (liftSym n d Ω p s aq.1 aq.2 (radialOscPhi Ω d j μ)) f x +
        ∑ j ∈ R, latMult (liftSym n d Ω p s aq.1 aq.2 (radialOscPhi Ω d j μ)) f x := by
    rw [latMult_liftSym_finsetSum (Finset.Icc a b) (m := fun j : ℕ => radialOscPhi Ω d j μ)
      (fun j => (continuous_radialOscPhi_and_le hΩ j μ).1)
      (fun j ξ => (continuous_radialOscPhi_and_le hΩ j μ).2 ξ) hf1 x]
    exact (Finset.sum_filter_add_sum_filter_not _ _ _).symm
  -- `Φ_{j,μ} = 𝓕 K_j + 𝓕((e(μP) - 1) K_j)`
  have hLdec : ∀ j : ℕ, latMult (liftSym n d Ω p s aq.1 aq.2 (radialOscPhi Ω d j μ)) f x =
      latMult (liftSym n d Ω p s aq.1 aq.2 (𝓕 (dyadicKernel Ω j))) f x +
      latMult (liftSym n d Ω p s aq.1 aq.2 (𝓕 (fun z =>
        eC (μ * radialPoly n d z) * dyadicKernel Ω j z - dyadicKernel Ω j z))) f x := by
    intro j
    have hi1 := integrable_oscKernel hΩ d (j : ℤ) μ
    have hi2 := integrable_dyadicKernel hΩ (j : ℤ)
    have e : 𝓕 (fun z => eC (μ * radialPoly n d z) * dyadicKernel Ω j z - dyadicKernel Ω j z) =
        fun ξ => radialOscPhi Ω d j μ ξ - 𝓕 (dyadicKernel Ω j) ξ := by
      funext ξ
      exact fourier_sub_apply hi1 hi2 ξ
    obtain ⟨hc1, hb1⟩ := continuous_radialOscPhi_and_le (d := d) hΩ j μ
    obtain ⟨hc2, hb2⟩ := continuous_fourier_and_norm_le hi2
    rw [e, latMult_liftSym_sub hc1.aestronglyMeasurable hc2.aestronglyMeasurable
      (B := (∫ z, ‖bandKer n d Ω ((j : ℤ), μ) z‖) + ∫ z, ‖dyadicKernel Ω j z‖)
      (fun ξ => (hb1 ξ).trans (le_add_of_nonneg_right (integral_nonneg fun _ => norm_nonneg _)))
      (fun ξ => (hb2 ξ).trans (le_add_of_nonneg_left (integral_nonneg fun _ => norm_nonneg _)))
      hf1 x]
    ring
  -- the low indices form an initial interval `[a, c)`
  obtain ⟨c, hac, hLc⟩ := filter_Icc_eq_Ico a b (fun j => X j < (2 : ℝ) ^ (-(B : ℤ)))
    (fun i j hij hj => lt_of_le_of_lt (mul_le_mul_of_nonneg_left
      (zpow_le_zpow_right₀ (by norm_num) (mul_le_mul_of_nonneg_left (by exact_mod_cast hij)
        (by positivity))) (abs_nonneg μ)) hj)
  have htr : ∀ J : ℕ, latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω J)) f x =
      ∑ j ∈ Finset.Ico 1 J,
        latMult (liftSym n d Ω p s aq.1 aq.2 (𝓕 (dyadicKernel Ω (j : ℤ)))) f x := fun J =>
    latMult_liftSym_finsetSum (Finset.Ico 1 J) (m := fun j : ℕ => 𝓕 (dyadicKernel Ω (j : ℤ)))
      (fun j => continuous_fourier_dyadicKernel hΩ j)
      (fun j ξ => (continuous_fourier_and_norm_le (integrable_dyadicKernel hΩ j)).2 ξ) hf1 x
  have hTle : ∀ J : ℕ, 1 ≤ J →
      ‖latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω J)) f x‖ₑ ≤ T := by
    intro J hJ
    have hh : aq ∈ liftRat s := haq
    have h1 : ‖latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω J)) f x‖ₑ ≤
        (liftRat s).sup (fun aq : ℕ × ℕ =>
          ‖latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω J)) f x‖ₑ) :=
      Finset.le_sup (f := fun aq : ℕ × ℕ =>
        ‖latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω J)) f x‖ₑ) hh
    refine h1.trans ?_
    rw [hT]
    exact le_iSup₂_of_le (f := fun (J : ℕ) (_ : 1 ≤ J) => (liftRat s).sup fun aq =>
      ‖latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω J)) f x‖ₑ) J hJ le_rfl
  have hlow1 : ∑ j ∈ L, latMult (liftSym n d Ω p s aq.1 aq.2 (𝓕 (dyadicKernel Ω j))) f x =
      latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω c)) f x -
        latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω a)) f x := by
    have hLc' : L = Finset.Ico a c := by rw [hL]; convert hLc
    rw [htr, htr, hLc', ← Finset.sum_Ico_consecutive _ hab.1 hac]; ring
  -- the low error
  have herr : ∀ j : ℕ, ‖latMult (liftSym n d Ω p s aq.1 aq.2 (𝓕 (fun z =>
        eC (μ * radialPoly n d z) * dyadicKernel Ω j z - dyadicKernel Ω j z))) f x‖ₑ ≤
      ENNReal.ofReal (C₁ * C₃ * envelopeConst n * X j) * cubeMaximalInt n f x := by
    intro j
    have hR0 : (0 : ℝ) < 2 ^ (j : ℤ) := by positivity
    have hK0 : 0 ≤ C₃ * X j := by positivity
    have h := h₁ d Ω p s aq.1 aq.2 hq _ (C₃ * X j) _
      ((integrable_oscKernel hΩ d (j : ℤ) μ).sub (integrable_dyadicKernel hΩ (j : ℤ))) hR0 hK0
      (fun z => h₃ j μ z) f hf1 x
    have hR' : 1 ≤ max ((2 : ℝ) ^ (j : ℤ)) (liftL n d Ω p s) :=
      le_max_of_le_right (one_le_liftL s)
    have hS0 : 0 ≤ ∑' y, latEnvelope n (max ((2 : ℝ) ^ (j : ℤ)) (liftL n d Ω p s)) y *
        ‖f (x - y)‖ :=
      tsum_nonneg fun y => mul_nonneg (envelope_nonneg (by linarith) _) (norm_nonneg _)
    rw [← ofReal_norm]
    refine (ENNReal.ofReal_le_ofReal h).trans ?_
    rw [ENNReal.ofReal_mul (by positivity)]
    refine (mul_le_mul' le_rfl (ofReal_tsum_latEnvelope_mul_le hR' hf1 x)).trans (le_of_eq ?_)
    rw [← mul_assoc, ← ENNReal.ofReal_mul (by positivity)]
    congr 2; ring
  have hgeo : ∑ j ∈ L, X j ≤ 2 ^ (2 * d) * (2 : ℝ) ^ (-(B : ℤ)) := by
    rcases L.eq_empty_or_nonempty with hLe | hLne
    · rw [hLe, Finset.sum_empty]; positivity
    set m := L.max' hLne
    have hmL : m ∈ L := L.max'_mem hLne
    have hXm : X m < (2 : ℝ) ^ (-(B : ℤ)) := (Finset.mem_filter.1 hmL).2
    have hXj : ∀ j : ℕ, X j = |μ| * ((2 : ℝ) ^ (2 * d)) ^ j := by
      intro j
      simp only [hX]
      rw [show ((2 * d : ℤ) * (j : ℤ)) = ((2 * d * j : ℕ) : ℤ) by push_cast; ring, zpow_natCast,
        pow_mul]
    have hlt : ∀ j ∈ L, j < m + 1 := fun j hj => Nat.lt_succ_of_le (L.le_max' j hj)
    have h2 : 2 ≤ 2 ^ (2 * d) :=
      calc 2 = 2 ^ 1 := by norm_num
        _ ≤ 2 ^ (2 * d) := Nat.pow_le_pow_right (by norm_num) (by omega)
    have hg := (Nat.cast_le (α := ℝ)).2 (Nat.geomSum_lt h2 hlt).le
    push_cast at hg
    calc ∑ j ∈ L, X j = |μ| * ∑ j ∈ L, ((2 : ℝ) ^ (2 * d)) ^ j := by
          rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun j _ => hXj j
      _ ≤ |μ| * ((2 : ℝ) ^ (2 * d)) ^ (m + 1) := mul_le_mul_of_nonneg_left hg (abs_nonneg _)
      _ = 2 ^ (2 * d) * X m := by rw [hXj, pow_succ]; ring
      _ ≤ 2 ^ (2 * d) * (2 : ℝ) ^ (-(B : ℤ)) := by gcongr
  have hlow2 : ‖∑ j ∈ L, latMult (liftSym n d Ω p s aq.1 aq.2 (𝓕 (fun z =>
        eC (μ * radialPoly n d z) * dyadicKernel Ω j z - dyadicKernel Ω j z))) f x‖ₑ ≤
      ENNReal.ofReal (C₁ * C₃ * envelopeConst n * 2 ^ (2 * d) * (2 : ℝ) ^ (-(B : ℤ))) *
        cubeMaximalInt n f x := by
    refine (enorm_sum_le _ _).trans ((Finset.sum_le_sum fun j _ => herr j).trans ?_)
    rw [← Finset.sum_mul, ← ENNReal.ofReal_sum_of_nonneg (fun j _ => by positivity)]
    gcongr
    rw [← Finset.mul_sum]
    calc C₁ * C₃ * envelopeConst n * ∑ j ∈ L, X j
        ≤ C₁ * C₃ * envelopeConst n * (2 ^ (2 * d) * (2 : ℝ) ^ (-(B : ℤ))) :=
          mul_le_mul_of_nonneg_left hgeo (by positivity)
      _ = _ := by ring
  -- the bands
  have hRpos : ∀ j ∈ R, 0 < X j := fun j hj =>
    lt_of_lt_of_le (by positivity) (not_lt.1 (Finset.mem_filter.1 hj).2)
  set lg : ℕ → ℤ := fun j => Int.log 2 (X j) with hlg
  have hlg1 : ∀ j ∈ R, (2 : ℝ) ^ (lg j) ≤ X j ∧ X j ≤ (2 : ℝ) ^ (lg j + 1) := by
    intro j hj
    have h1 := Int.zpow_log_le_self (b := 2) (by norm_num) (hRpos j hj)
    have h2 := Int.lt_zpow_succ_log_self (b := 2) (by norm_num) (X j)
    push_cast at h1 h2
    exact ⟨h1, h2.le⟩
  have hlgB : ∀ j ∈ R, -(B : ℤ) ≤ lg j := by
    intro j hj
    have h1 : (2 : ℝ) ^ (-(B : ℤ)) ≤ X j := not_lt.1 (Finset.mem_filter.1 hj).2
    have h2 := Int.lt_zpow_succ_log_self (b := 2) (by norm_num) (X j)
    push_cast at h2
    have h3 : (2 : ℝ) ^ (-(B : ℤ)) < (2 : ℝ) ^ (lg j + 1) := h1.trans_lt h2
    have := (zpow_lt_zpow_iff_right₀ (by norm_num : (1 : ℝ) < 2)).1 h3
    omega
  have hμ : ∀ j ∈ R, μ ≠ 0 := fun j hj h0 => by
    have := hRpos j hj; simp [hX, h0] at this
  have hband : ∀ j ∈ R, ‖latMult (liftSym n d Ω p s aq.1 aq.2 (radialOscPhi Ω d j μ)) f x‖ₑ ≤
      bandOp n d Ω p s (lg j) f x := by
    intro j hj
    have hj1 : (1 : ℤ) ≤ (j : ℤ) := by
      have := (Finset.mem_Icc.1 (Finset.mem_filter.1 hj).1).1
      have := hab.1
      omega
    exact le_iSup₂_of_le aq haq (le_iSup₂_of_le (j : ℤ) hj1 (le_iSup₂_of_le μ (hlg1 j hj) le_rfl))
  have hRsum : ‖∑ j ∈ R, latMult (liftSym n d Ω p s aq.1 aq.2 (radialOscPhi Ω d j μ)) f x‖ₑ ≤
      (∑ ℓ ∈ Finset.Ico (-(B : ℤ)) B, bandOp n d Ω p s ℓ f x) +
        ∑' k : ℕ, bandOp n d Ω p s ((B : ℤ) + k) f x := by
    refine (enorm_sum_le _ _).trans ((Finset.sum_le_sum hband).trans ?_)
    rw [← Finset.sum_image (f := fun ℓ => bandOp n d Ω p s ℓ f x) (s := R) (g := lg)
      (by intro j hj j' hj' h; exact band_log_injective hd (hμ j hj) h)]
    set S := R.image lg with hSdef
    have hS : ∀ ℓ ∈ S, -(B : ℤ) ≤ ℓ := by
      intro ℓ hℓ
      obtain ⟨j, hj, rfl⟩ := Finset.mem_image.1 hℓ
      exact hlgB j hj
    rw [← Finset.sum_filter_add_sum_filter_not S (fun ℓ => ℓ < (B : ℤ))]
    refine add_le_add (Finset.sum_le_sum_of_subset fun ℓ hℓ => ?_) ?_
    · obtain ⟨h1, h2⟩ := Finset.mem_filter.1 hℓ
      exact Finset.mem_Ico.2 ⟨hS ℓ h1, h2⟩
    · calc ∑ ℓ ∈ S.filter (fun ℓ => ¬ ℓ < (B : ℤ)), bandOp n d Ω p s ℓ f x
          = ∑ ℓ ∈ S.filter (fun ℓ => ¬ ℓ < (B : ℤ)),
              (fun k : ℕ => bandOp n d Ω p s ((B : ℤ) + k) f x) (ℓ - (B : ℤ)).toNat := by
            refine Finset.sum_congr rfl fun ℓ hℓ => ?_
            have := not_lt.1 (Finset.mem_filter.1 hℓ).2
            simp only
            rw [show (B : ℤ) + ((ℓ - (B : ℤ)).toNat : ℤ) = ℓ by omega]
        _ = ∑ k ∈ (S.filter (fun ℓ => ¬ ℓ < (B : ℤ))).image (fun ℓ : ℤ => (ℓ - (B : ℤ)).toNat),
              bandOp n d Ω p s ((B : ℤ) + k) f x := by
            rw [Finset.sum_image]
            intro ℓ hℓ ℓ' hℓ' h
            have h1 := not_lt.1 (Finset.mem_filter.1 hℓ).2
            have h2 := not_lt.1 (Finset.mem_filter.1 hℓ').2
            simp only at h
            omega
        _ ≤ _ := ENNReal.sum_le_tsum _
  -- assembly
  rw [hsum]
  have hLsplit : ∑ j ∈ L, latMult (liftSym n d Ω p s aq.1 aq.2 (radialOscPhi Ω d j μ)) f x =
      (latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω c)) f x -
        latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω a)) f x) +
      ∑ j ∈ L, latMult (liftSym n d Ω p s aq.1 aq.2 (𝓕 (fun z =>
        eC (μ * radialPoly n d z) * dyadicKernel Ω j z - dyadicKernel Ω j z))) f x := by
    rw [Finset.sum_congr rfl fun j _ => hLdec j, Finset.sum_add_distrib, hlow1]
  rw [hLsplit]
  have hsub : ‖latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω c)) f x -
      latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω a)) f x‖ₑ ≤ T + T :=
    (enorm_sub_le).trans (add_le_add (hTle c (by have := hab.1; omega)) (hTle a hab.1))
  calc _ ≤ ‖latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω c)) f x -
        latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω a)) f x‖ₑ +
      ‖∑ j ∈ L, latMult (liftSym n d Ω p s aq.1 aq.2 (𝓕 (fun z =>
        eC (μ * radialPoly n d z) * dyadicKernel Ω j z - dyadicKernel Ω j z))) f x‖ₑ +
      ‖∑ j ∈ R, latMult (liftSym n d Ω p s aq.1 aq.2 (radialOscPhi Ω d j μ)) f x‖ₑ :=
        (enorm_add_le _ _).trans (add_le_add (enorm_add_le _ _) le_rfl)
    _ ≤ (T + T) + ENNReal.ofReal (C₁ * C₃ * envelopeConst n * 2 ^ (2 * d) *
          (2 : ℝ) ^ (-(B : ℤ))) * cubeMaximalInt n f x +
        ((∑ ℓ ∈ Finset.Ico (-(B : ℤ)) B, bandOp n d Ω p s ℓ f x) +
          ∑' k : ℕ, bandOp n d Ω p s ((B : ℤ) + k) f x) := by
        gcongr
    _ = _ := by ring

/-- **Blueprint Theorem 11.3 (`thm:liftedSW`)**, lifted polynomial partial sums, eq. (11.1)
(`eq:liftedSW`): for `n, d ≥ 1`, an admissible profile `Ω` and `1 < p < ∞` there are `c_p > 0` and
`C_p` such that for every `s ≥ 1` and every finitely supported `f`,
`‖sup_{α ∈ 𝓡_s, μ ∈ ℝ, 1 ≤ a ≤ b < ∞} |Lift_{s,α}[∑_{j=a}^b Φ_{j,μ}](D) f|‖_p`
`≤ C_p 2^{-c_p s} ‖f‖_p`,
where the maximal expression is `𝒫_s f = liftedPartialMax n d Ω p s f` (integers `a, b`, as an
extended nonnegative function). -/
theorem lift_partial_sums (hn : 1 ≤ n) (hd : 1 ≤ d) (hΩ : IsSWProfile Ω) (hp : 1 < p) :
    ∃ c : ℝ, 0 < c ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ s : ℕ, 1 ≤ s →
      ∀ f : (Fin n → ℤ) → ℂ, (Function.support f).Finite →
        eLpNorm (liftedPartialMax n d Ω p s f) (ENNReal.ofReal p) Measure.count ≤
          ENNReal.ofReal (C * (2 : ℝ) ^ (-(c * s))) *
            eLpNorm f (ENNReal.ofReal p) Measure.count := by
  obtain ⟨Ch, hCh, hH⟩ := bandOp_high hn hd hΩ hp
  obtain ⟨b, hb, Cu, hCu, hU⟩ := bandOp_uniform hn hd hΩ hp
  obtain ⟨θ, hθ, Ct, hCt, hT⟩ := lift_trunc hn hd hΩ hp
  obtain ⟨Ce, hCe, hpt⟩ := liftedPartialMax_le (p := p) hd hΩ
  obtain ⟨K, hK0, hK⟩ := exists_add_one_mul_rpow_le (δ := b) (θ := b / 2) (by linarith)
  set σ := 1 / (2 * (2 * d : ℝ)) * min (1 / p) (1 - 1 / p) with hσ
  have hσ0 : 0 < σ := by
    have h1 : 0 < 1 / p := by have : (0 : ℝ) < p := by linarith
                              positivity
    have h2 : 0 < 1 - 1 / p := by
      rw [sub_pos, div_lt_one (by linarith)]; exact hp
    have hd' : (0 : ℝ) < d := by exact_mod_cast hd
    exact mul_pos (by positivity) (lt_min h1 h2)
  set ρ := (2 : ℝ) ^ (-σ) with hρ
  have hρ0 : 0 ≤ ρ := by positivity
  have hρ1 : ρ < 1 := Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by linarith)
  have hρ1' : 0 ≤ (1 - ρ)⁻¹ := inv_nonneg.2 (by linarith)
  set N : ℕ := ⌈(n + 3 : ℝ) / σ⌉₊ + 1 with hNdef
  have hN : (n + 3 : ℝ) ≤ σ * N := by
    have h := Nat.le_ceil ((n + 3 : ℝ) / σ)
    rw [div_le_iff₀ hσ0] at h
    have : ((N : ℕ) : ℝ) = (⌈(n + 3 : ℝ) / σ⌉₊ : ℝ) + 1 := by rw [hNdef]; push_cast; ring
    rw [this]; nlinarith
  have hN1 : 1 ≤ N := by rw [hNdef]; omega
  set CM := (hlMaximalConst (5 ^ n) p).toReal with hCMdef
  have hCM : hlMaximalConst (5 ^ n) p = ENNReal.ofReal CM :=
    (ENNReal.ofReal_toReal (hlMaximalConst_ne_top _ (by linarith))).symm
  have hCM0 : 0 ≤ CM := ENNReal.toReal_nonneg
  set c := min (min θ (b / 2)) 1 with hc
  have hc0 : 0 < c := lt_min (lt_min hθ (by linarith)) one_pos
  set A1 := Ch * (1 - ρ)⁻¹ with hA1
  set A2 := 2 * (N : ℝ) * Cu * K with hA2
  set A4 := Ce * CM with hA4
  have hA1' : 0 ≤ A1 := mul_nonneg hCh hρ1'
  have hA2' : 0 ≤ A2 := by positivity
  have hA4' : 0 ≤ A4 := mul_nonneg hCe hCM0
  refine ⟨c, hc0, A1 + A2 + 2 * Ct + A4, by positivity, fun s hs f hf => ?_⟩
  set B : ℕ := N * s with hBdef
  set nf := eLpNorm f (ENNReal.ofReal p) Measure.count with hnf
  have hp1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hp.le
  have hs0 : (0 : ℝ) ≤ s := Nat.cast_nonneg s
  set Mid : (Fin n → ℤ) → ℝ≥0∞ := fun x => ∑ ℓ ∈ Finset.Ico (-(B : ℤ)) B, bandOp n d Ω p s ℓ f x
    with hMid
  set High : (Fin n → ℤ) → ℝ≥0∞ := fun x => ∑' k : ℕ, bandOp n d Ω p s ((B : ℤ) + k) f x
    with hHigh
  set Tr : (Fin n → ℤ) → ℝ≥0∞ := fun x => ⨆ J : ℕ, ⨆ (_ : 1 ≤ J), (liftRat s).sup fun aq =>
    ‖latMult (liftSym n d Ω p s aq.1 aq.2 (truncSym Ω J)) f x‖ₑ with hTr
  set Er : (Fin n → ℤ) → ℝ≥0∞ := fun x =>
    ENNReal.ofReal (Ce * (2 : ℝ) ^ (-(B : ℤ))) * cubeMaximalInt n f x with hEr
  have hmaj : ∀ x, ‖liftedPartialMax n d Ω p s f x‖ₑ ≤ ‖(Mid + High + (Tr + Tr) + Er) x‖ₑ := by
    intro x; rw [enorm_eq_self, enorm_eq_self]; exact hpt s B f hf x
  -- the high bands
  have hHighB : eLpNorm High (ENNReal.ofReal p) Measure.count ≤
      ENNReal.ofReal (A1 * (2 : ℝ) ^ (-(s : ℝ))) * nf := by
    refine (eLpNorm_tsum_le_count hp1 ENNReal.ofReal_ne_top _).trans ?_
    have hterm : ∀ k : ℕ, eLpNorm (bandOp n d Ω p s ((B : ℤ) + k) f) (ENNReal.ofReal p)
        Measure.count ≤
        ENNReal.ofReal (Ch * (2 : ℝ) ^ ((n + 2) * s) * (2 : ℝ) ^ (-(σ * B)) * ρ ^ k) * nf := by
      intro k
      refine (hH s hs _ (by positivity) f hf).trans (le_of_eq ?_)
      congr 2
      rw [show -(σ * ((((B : ℤ) + (k : ℤ) : ℤ)) : ℝ)) = -(σ * B) + (-σ) * k by push_cast; ring,
        Real.rpow_add two_pos, Real.rpow_mul_natCast (by norm_num)]
      ring
    refine (ENNReal.tsum_le_tsum hterm).trans ?_
    rw [ENNReal.tsum_mul_right, ← ENNReal.ofReal_tsum_of_nonneg (fun k => by positivity)
      ((summable_geometric_of_lt_one hρ0 hρ1).mul_left _), tsum_mul_left,
      tsum_geometric_of_lt_one hρ0 hρ1]
    gcongr ?_ * nf
    apply ENNReal.ofReal_le_ofReal
    have hexp : (2 : ℝ) ^ ((n + 2) * s) * (2 : ℝ) ^ (-(σ * B)) ≤ (2 : ℝ) ^ (-(s : ℝ)) := by
      rw [← Real.rpow_natCast, ← Real.rpow_add two_pos]
      apply Real.rpow_le_rpow_of_exponent_le (by norm_num)
      have h := mul_le_mul_of_nonneg_right hN hs0
      rw [hBdef]; push_cast
      nlinarith
    calc Ch * (2 : ℝ) ^ ((n + 2) * s) * (2 : ℝ) ^ (-(σ * B)) * (1 - ρ)⁻¹
        = A1 * ((2 : ℝ) ^ ((n + 2) * s) * (2 : ℝ) ^ (-(σ * B))) := by rw [hA1]; ring
      _ ≤ A1 * (2 : ℝ) ^ (-(s : ℝ)) := mul_le_mul_of_nonneg_left hexp hA1'
  -- the middle bands
  have hMidB : eLpNorm Mid (ENNReal.ofReal p) Measure.count ≤
      ENNReal.ofReal (A2 * (2 : ℝ) ^ (-(b / 2 * s))) * nf := by
    have e : Mid = ∑ ℓ ∈ Finset.Ico (-(B : ℤ)) B, bandOp n d Ω p s ℓ f := by
      funext x; rw [hMid, Finset.sum_apply]
    rw [e]
    refine (eLpNorm_sum_le hp1).trans ?_
    refine (Finset.sum_le_sum fun ℓ _ => hU s hs ℓ f hf).trans ?_
    rw [Finset.sum_const, Int.card_Ico, nsmul_eq_mul,
      show ((B : ℤ) - -(B : ℤ)).toNat = 2 * B by omega, ← mul_assoc]
    gcongr ?_ * nf
    rw [← ENNReal.ofReal_natCast, ← ENNReal.ofReal_mul (by positivity)]
    apply ENNReal.ofReal_le_ofReal
    have h := hK s
    rw [hBdef]; push_cast
    calc 2 * ((N : ℝ) * s) * (Cu * (2 : ℝ) ^ (-(b * s)))
        = 2 * N * Cu * ((s : ℝ) * (2 : ℝ) ^ (-(b * s))) := by ring
      _ ≤ 2 * N * Cu * (((s : ℝ) + 1) * (2 : ℝ) ^ (-(b * s))) := by gcongr; linarith
      _ ≤ 2 * N * Cu * (K * (2 : ℝ) ^ (-(b / 2 * s))) := by gcongr
      _ = A2 * (2 : ℝ) ^ (-(b / 2 * s)) := by rw [hA2]; ring
  -- the truncated partial sums (Lemma 10.1)
  have hTrB : eLpNorm Tr (ENNReal.ofReal p) Measure.count ≤
      ENNReal.ofReal (Ct * (2 : ℝ) ^ (-(θ * s))) * nf := hT s hs f hf
  -- the low error
  have hErB : eLpNorm Er (ENNReal.ofReal p) Measure.count ≤
      ENNReal.ofReal (A4 * (2 : ℝ) ^ (-(s : ℝ))) * nf := by
    rw [hEr, eLpNorm_count_const_mul _ _ (by linarith : (0 : ℝ) < p)]
    refine (mul_le_mul' le_rfl (eLpNorm_cubeMaximalInt_le (n := n) hp f)).trans ?_
    rw [hCM, ← mul_assoc, ← ENNReal.ofReal_mul (by positivity)]
    gcongr ?_ * nf
    apply ENNReal.ofReal_le_ofReal
    have h2 : (2 : ℝ) ^ (-(B : ℤ)) ≤ (2 : ℝ) ^ (-(s : ℝ)) := by
      rw [← Real.rpow_intCast]
      apply Real.rpow_le_rpow_of_exponent_le (by norm_num)
      have : (1 : ℝ) ≤ N := by exact_mod_cast hN1
      rw [hBdef]; push_cast
      nlinarith
    calc Ce * (2 : ℝ) ^ (-(B : ℤ)) * CM = A4 * (2 : ℝ) ^ (-(B : ℤ)) := by rw [hA4]; ring
      _ ≤ A4 * (2 : ℝ) ^ (-(s : ℝ)) := mul_le_mul_of_nonneg_left h2 hA4'
  -- assembly
  have hz1 : (2 : ℝ) ^ (-(s : ℝ)) ≤ (2 : ℝ) ^ (-(c * s)) :=
    Real.rpow_le_rpow_of_exponent_le (by norm_num)
      (neg_le_neg (by nlinarith [min_le_right (min θ (b / 2)) 1]))
  have hz2 : (2 : ℝ) ^ (-(b / 2 * s)) ≤ (2 : ℝ) ^ (-(c * s)) :=
    Real.rpow_le_rpow_of_exponent_le (by norm_num) (neg_le_neg (mul_le_mul_of_nonneg_right
      ((min_le_left _ _).trans (min_le_right _ _)) hs0))
  have hz3 : (2 : ℝ) ^ (-(θ * s)) ≤ (2 : ℝ) ^ (-(c * s)) :=
    Real.rpow_le_rpow_of_exponent_le (by norm_num) (neg_le_neg (mul_le_mul_of_nonneg_right
      ((min_le_left _ _).trans (min_le_left _ _)) hs0))
  calc eLpNorm (liftedPartialMax n d Ω p s f) (ENNReal.ofReal p) Measure.count
      ≤ eLpNorm (Mid + High + (Tr + Tr) + Er) (ENNReal.ofReal p) Measure.count :=
        eLpNorm_mono_enorm AEStronglyMeasurable.of_discrete hmaj
    _ ≤ eLpNorm Mid (ENNReal.ofReal p) Measure.count +
          eLpNorm High (ENNReal.ofReal p) Measure.count +
          (eLpNorm Tr (ENNReal.ofReal p) Measure.count +
            eLpNorm Tr (ENNReal.ofReal p) Measure.count) +
          eLpNorm Er (ENNReal.ofReal p) Measure.count :=
        (eLpNorm_add_le hp1).trans (add_le_add ((eLpNorm_add_le hp1).trans
          (add_le_add (eLpNorm_add_le hp1) (eLpNorm_add_le hp1))) le_rfl)
    _ ≤ ENNReal.ofReal (A2 * (2 : ℝ) ^ (-(b / 2 * s))) * nf +
          ENNReal.ofReal (A1 * (2 : ℝ) ^ (-(s : ℝ))) * nf +
          (ENNReal.ofReal (Ct * (2 : ℝ) ^ (-(θ * s))) * nf +
            ENNReal.ofReal (Ct * (2 : ℝ) ^ (-(θ * s))) * nf) +
          ENNReal.ofReal (A4 * (2 : ℝ) ^ (-(s : ℝ))) * nf := by
        gcongr
    _ = ENNReal.ofReal (A2 * (2 : ℝ) ^ (-(b / 2 * s)) + A1 * (2 : ℝ) ^ (-(s : ℝ)) +
          (Ct * (2 : ℝ) ^ (-(θ * s)) + Ct * (2 : ℝ) ^ (-(θ * s))) +
          A4 * (2 : ℝ) ^ (-(s : ℝ))) * nf := by
        rw [ENNReal.ofReal_add (by positivity) (by positivity),
          ENNReal.ofReal_add (by positivity) (by positivity),
          ENNReal.ofReal_add (by positivity) (by positivity),
          ENNReal.ofReal_add (by positivity) (by positivity)]
        ring
    _ ≤ ENNReal.ofReal ((A1 + A2 + 2 * Ct + A4) * (2 : ℝ) ^ (-(c * s))) * nf := by
        gcongr ?_ * nf
        apply ENNReal.ofReal_le_ofReal
        have e1 := mul_le_mul_of_nonneg_left hz1 hA1'
        have e2 := mul_le_mul_of_nonneg_left hz2 hA2'
        have e3 := mul_le_mul_of_nonneg_left hz3 hCt
        have e4 := mul_le_mul_of_nonneg_left hz1 hA4'
        nlinarith

end Bands

section MajorArcs

/-!
## Kernel-side major-arc approximation and coherent grouping

Results from §12 ("Kernel-side major-arc approximation and coherent grouping") of
`blueprints/discrete-sw.tex`.

### Definitions

* `majorH Ω d j μ = h_{j,μ} = e(μ P) K_j` (so `radialOscPhi Ω d j μ = 𝓕 h_{j,μ}`);
* `majorExp M j = ⌊M log₂(j+1)⌋` (so `H_j = minorH M j = 2^{majorExp M j}`);
* `IsMajorCenter M j a q`: `a/q` is an admissible center of `X_j` (`1 ≤ q < H_j`, `0 ≤ a < q`,
  `(a, q) = 1`);
* `CoherenceSpec n d Ω p j₀`: `j₀ ≥ j₁` and the three properties (1)–(3) of Lemma 12.2 for all
  `j ≥ j₀`; `coherJ0 n d Ω p = j₀` is the least such integer, and
  `coherJs n d Ω p s = j_s = max(j₀, ⌈2^{s/M}⌉ - 1)`;
* `majorIdx n d Ω p s λ J`: the finite set of `j ∈ [j₀, J]` whose major center (the center of the
  arc of `X_j` containing `λ`) lies in `𝓡_s`.

### Main results

* `major_kernel_error`: Blueprint Lemma 12.1 (`lem:kernelerror`), eq. (12.1);
* `latKernel_liftSym_radialOscPhi`, `major_kernel_formula`: Lemma 12.1, the lattice kernel formula;
* `coherJ0_spec` (with `exists_coherenceSpec`): Lemma 12.2 (`lem:coherence`), (1)–(3);
* `isMajorCenter_of_mem_liftRat`, `isMajorCenter_of_le_majorExp`, `two_pow_le_minorH_iff`:
  admissibility of `𝓡_s` in `X_j` and the formula for `j_s`;
* `minorArcs_center_unique`: uniqueness of the major center;
* `major_coherence`: the coherent interval `[j_s, b]`, the common center `α` and the common
  representative `μ` with `|μ| < 1/4`, together with `|μ| 2^{Dj} ≤ (j+1)^M` and `L_s ≤ 2^{j/2}`;
* `mem_minorArcs_iff_exists_majorIdx`, `eq_of_mem_majorIdx`: every major index belongs to
  exactly one group `s`;
* `finite_dyadic_stein_wainger`: Blueprint Proposition 12.3 (`prop:finiteSW`), eq. (12.2),
  with the smoothing error `finSW_kernel_error`, the pointwise majorant `finSW_pointwise` and the
  group majorants `finSWMain` (`𝒫_s f` for `s ≥ 1`).

### Proof notes (deviations from the blueprint)

* Lemma 12.1 is proved without the hypotheses `j ≥ 1` and `L_s ≤ R` (they are not needed), and
  the kernel formula holds for every `α = a/q` with `q ≥ 1` (not only `α ∈ 𝓡_s`). The gradient
  bound is replaced by the equivalent Lipschitz bound `|h(y) - h(y - z)| ≤ C (1 + U) R^{-n-1}|z|`
  (`exists_majorH_bounds`), and the first moment bound `∫ |z| |φ_s(z)| ≤ C L_s` is used in the
  pointwise form `|z| |φ_s(z)| ≤ C L_s B_{L_s}(z)` (`norm_mul_norm_liftPhi_le`).
* In Lemma 12.2, property (3) holds for all `s ≤ ⌊M log₂(j+1)⌋` (including `s = 0`), and the
  lower scale needs `d ≥ 1` (for `d = 0` the widths `w_j` increase).
* In Proposition 12.3 the supremum is over `λ ∈ ℝ` (equivalent to `λ ∈ 𝕋` by `1`-periodicity).
  The group index `s` is bounded by `s < 2^s ≤ H_J`, so the major sum is a finite disjoint union
  over `s < H_J + 1`; the main-term majorant is `∑_{s ≥ 0} 𝒫_s f` (with `𝒫_0 := 0`), bounded
  by the countable Minkowski inequality `eLpNorm_tsum_le_count`.
-/

open MeasureTheory Set Real Finset
open scoped FourierTransform ContDiff SchwartzMap Convolution

variable {n d : ℕ} {Ω : EuclideanSpace ℝ (Fin n) → ℂ} {p : ℝ}

/-! ### Blueprint Lemma 12.1 (`lem:kernelerror`) -/

/-- `h_{j,μ}(x) = e(μ P(x)) K_j(x)` of Blueprint Lemma 12.1 (`lem:kernelerror`). -/
noncomputable def majorH (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (d : ℕ) (j : ℤ) (μ : ℝ)
    (x : EuclideanSpace ℝ (Fin n)) : ℂ :=
  eC (μ * radialPoly n d x) * dyadicKernel Ω j x

/-- `Φ_{j,μ} = 𝓕 h_{j,μ}`. -/
lemma radialOscPhi_eq_fourier_majorH (j : ℤ) (μ : ℝ) :
    radialOscPhi Ω d j μ = 𝓕 (majorH Ω d j μ) := rfl

/-- `φ_s` is the Schwartz function `𝓕⁻ χ_s`. -/
lemma coe_fourierInv_liftChiSchwartz (s : ℕ) :
    ((𝓕⁻ (liftChiSchwartz n d Ω p s) : 𝓢(EuclideanSpace ℝ (Fin n), ℂ)) :
      EuclideanSpace ℝ (Fin n) → ℂ) = liftPhi n d Ω p s := by
  rw [SchwartzMap.fourierInv_coe]; rfl

/-- `φ_s` is integrable. -/
lemma integrable_liftPhi (s : ℕ) : Integrable (liftPhi n d Ω p s) := by
  rw [← coe_fourierInv_liftChiSchwartz]; exact SchwartzMap.integrable _

/-- `∫ φ_s = χ_s(0) = 1` (Fourier inversion). -/
lemma integral_liftPhi (s : ℕ) : ∫ x, liftPhi n d Ω p s x = 1 := by
  have key : 𝓕 (liftPhi n d Ω p s) = fun ξ => (liftChi n d Ω p s ξ : ℂ) := by
    rw [← coe_fourierInv_liftChiSchwartz, ← SchwartzMap.fourier_coe,
      FourierTransform.fourier_fourierInv_eq]; rfl
  have h := congrFun key 0
  rw [fourier_eq_integral_eC] at h
  simp only [inner_zero_right, neg_zero, eC_zero, one_mul] at h
  rw [h, liftChi, smul_zero, liftCutoff_eq_one (fun i => by simp)]
  simp

/-- First-moment decay of `φ_s`: `|z| |φ_s(z)| ≤ K L_s B_{L_s}(z)` with `K` depending only on
`n` (from the Schwartz decay of `𝓕⁻ χ` of order `n + 2` and scaling). -/
lemma norm_mul_norm_liftPhi_le (n : ℕ) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ (d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ)
      (z : EuclideanSpace ℝ (Fin n)),
      ‖z‖ * ‖liftPhi n d Ω p s z‖ ≤ K * (liftL n d Ω p s : ℝ) * envelope n (liftL n d Ω p s) z := by
  obtain ⟨K, hK, hKb⟩ := exists_schwartz_decay (arithPhiS n) (n + 2)
  refine ⟨K, hK, fun d Ω p s z => ?_⟩
  have hL := liftL_pos (n := n) (d := d) (Ω := Ω) (p := p) s
  set L : ℝ := (liftL n d Ω p s : ℝ)
  rw [arith_liftPhi_eq_dilateL]
  have h1 := norm_dilateL_le (fun x => (hKb x).1) hL z
  set t : ℝ := ‖z‖ / L with ht
  have ht0 : 0 ≤ t := by positivity
  have hz : ‖z‖ = L * t := by rw [ht]; field_simp
  rw [envelope, hz]
  calc L * t * ‖dilateL (⇑(arithPhiS n)) L z‖
      ≤ L * t * (K * ((L ^ n)⁻¹ * ((1 + t) ^ (n + 2))⁻¹)) := by
        gcongr
    _ = K * L * ((L ^ n)⁻¹ * ((1 + t) ^ (n + 1))⁻¹) * (t / (1 + t)) := by
        field_simp; ring
    _ ≤ K * L * ((L ^ n)⁻¹ * ((1 + t) ^ (n + 1))⁻¹) * 1 := by
        gcongr
        rw [div_le_one (by positivity)]; linarith
    _ = _ := by rw [mul_one, ← hz, ← ht]

/-- The scalar inequality `|μ| D (3R)^{D-1} R ≤ D 3^D U` from `|μ| R^D ≤ U`. -/
lemma major_phase_scalar {D : ℕ} {μ R U : ℝ} (hR : 0 < R) (hU : |μ| * R ^ D ≤ U) :
    |μ| * D * (3 * R) ^ (D - 1) * R ≤ D * 3 ^ D * U := by
  rcases D with _ | k
  · simp
  · have hU0 : 0 ≤ U := le_trans (by positivity) hU
    rw [Nat.add_sub_cancel, mul_pow]
    have e : |μ| * ((k + 1 : ℕ) : ℝ) * (3 ^ k * R ^ k) * R =
        ((k + 1 : ℕ) : ℝ) * 3 ^ k * (|μ| * R ^ (k + 1)) := by ring
    rw [e, pow_succ 3 k]
    have h3 : (3 : ℝ) ^ k * U ≤ 3 ^ k * 3 * U := by nlinarith [pow_pos (by norm_num : (0:ℝ) < 3) k]
    calc ((k + 1 : ℕ) : ℝ) * 3 ^ k * (|μ| * R ^ (k + 1)) ≤ ((k + 1 : ℕ) : ℝ) * 3 ^ k * U := by
          gcongr
      _ ≤ ((k + 1 : ℕ) : ℝ) * (3 ^ k * 3) * U := by
          rw [mul_assoc, mul_assoc]; gcongr

/-- Size and Lipschitz bounds for `h_{j,μ} = e(μP) K_j` with `|μ| R^D ≤ U`, `R = 2^j`:
`|h| ≤ C₀ R^{-n}` and `|h(y) - h(y - z)| ≤ A (1 + U) R^{-n-1} |z|`. -/
lemma exists_majorH_bounds (hΩ : IsSWProfile Ω) (d : ℕ) :
    ∃ C₀ A : ℝ, 0 ≤ C₀ ∧ 0 ≤ A ∧ ∀ (j : ℕ) (μ U : ℝ), |μ| * ((2 : ℝ) ^ j) ^ (2 * d) ≤ U →
      (∀ x, ‖majorH Ω d j μ x‖ ≤ C₀ / ((2 : ℝ) ^ j) ^ n) ∧
      ∀ y z, ‖majorH Ω d j μ y - majorH Ω d j μ (y - z)‖ ≤
        A * (1 + U) * ‖z‖ / ((2 : ℝ) ^ j) ^ (n + 1) := by
  obtain ⟨C₀, C₁, hC₀, hC₁, hK⟩ := minor_kernel_bounds (Ω := Ω) hΩ
  set D := 2 * d with hD
  refine ⟨C₀, 2 * π * D * 3 ^ D * C₀ + C₁ + 2 * C₀, hC₀, by positivity, fun j μ U hU => ?_⟩
  set R : ℝ := 2 ^ j with hRdef
  have hR : 0 < R := by positivity
  have hU0 : 0 ≤ U := le_trans (by positivity) hU
  have hnorm : ∀ x, ‖majorH Ω d j μ x‖ ≤ C₀ / R ^ n := fun x => by
    rw [majorH, norm_mul, norm_eC, one_mul]; exact (hK j).1 x
  refine ⟨hnorm, fun y z => ?_⟩
  have hRn : 0 < R ^ (n + 1) := by positivity
  have hz0 : 0 ≤ ‖z‖ := norm_nonneg z
  rw [le_div_iff₀ hRn]
  by_cases hz : R ≤ ‖z‖
  · calc ‖majorH Ω d j μ y - majorH Ω d j μ (y - z)‖ * R ^ (n + 1)
        ≤ (C₀ / R ^ n + C₀ / R ^ n) * R ^ (n + 1) := by
          gcongr; exact (norm_sub_le _ _).trans (add_le_add (hnorm _) (hnorm _))
      _ = 2 * C₀ * R := by rw [pow_succ]; field_simp; ring
      _ ≤ 2 * C₀ * ‖z‖ := by gcongr
      _ ≤ (2 * π * D * 3 ^ D * C₀ + C₁ + 2 * C₀) * (1 + U) * ‖z‖ := by
          have : 0 ≤ 2 * π * D * 3 ^ D * C₀ := by positivity
          nlinarith [mul_nonneg hC₀ hU0, mul_nonneg (mul_nonneg this hU0) hz0,
            mul_nonneg (mul_nonneg hC₁ hU0) hz0, mul_nonneg hC₁ hz0, mul_nonneg this hz0,
            mul_nonneg (mul_nonneg hC₀ hU0) hz0]
  push Not at hz
  set e1 := eC (μ * radialPoly n d y)
  set e2 := eC (μ * radialPoly n d (y - z))
  have hsplit : majorH Ω d j μ y - majorH Ω d j μ (y - z) =
      (e1 - e2) * dyadicKernel Ω j y + e2 * (dyadicKernel Ω j y - dyadicKernel Ω j (y - z)) := by
    simp only [majorH, e1, e2]; ring
  have hsecond : ‖e2 * (dyadicKernel Ω j y - dyadicKernel Ω j (y - z))‖ ≤
      C₁ / R ^ (n + 1) * ‖z‖ := by
    rw [norm_mul, norm_eC, one_mul]
    have := (hK j).2 y (y - z)
    rwa [sub_sub_cancel] at this
  have hfirst : ‖(e1 - e2) * dyadicKernel Ω j y‖ * R ^ (n + 1) ≤
      2 * π * D * 3 ^ D * C₀ * U * ‖z‖ := by
    by_cases hKy : dyadicKernel Ω j y = 0
    · rw [hKy, mul_zero, norm_zero, zero_mul]; positivity
    have hy : ‖y‖ < 2 * R := by
      have := (support_dyadicKernel (Ω := Ω) (j : ℤ) hKy).2
      rwa [zpow_add_one₀ two_ne_zero, zpow_natCast, mul_comm] at this
    have hyz : ‖y - z‖ ≤ 3 * R := by
      have := norm_sub_le y z; linarith
    have hP : |radialPoly n d y - radialPoly n d (y - z)| ≤ ‖z‖ * D * (3 * R) ^ (D - 1) := by
      rw [radialPoly_eq_norm_pow, radialPoly_eq_norm_pow]
      refine (abs_pow_sub_pow_le _ _ _).trans ?_
      have h1 : |‖y‖ - ‖y - z‖| ≤ ‖z‖ := by
        have := abs_norm_sub_norm_le y (y - z); rwa [sub_sub_cancel] at this
      have h2 : max |‖y‖| |‖y - z‖| ≤ 3 * R := by
        rw [abs_norm, abs_norm]; exact max_le (by linarith) hyz
      gcongr
    have he : ‖e1 - e2‖ ≤ 2 * π * (|μ| * (‖z‖ * D * (3 * R) ^ (D - 1))) := by
      refine (norm_eC_sub_eC_le _ _).trans ?_
      rw [← mul_sub, abs_mul]
      gcongr
    have hKb := (hK j).1 y
    have hsc := major_phase_scalar (D := D) hR hU
    calc ‖(e1 - e2) * dyadicKernel Ω j y‖ * R ^ (n + 1)
        ≤ 2 * π * (|μ| * (‖z‖ * D * (3 * R) ^ (D - 1))) * (C₀ / R ^ n) * R ^ (n + 1) := by
          rw [norm_mul]; gcongr
      _ = 2 * π * C₀ * ‖z‖ * (|μ| * D * (3 * R) ^ (D - 1) * R) := by
          rw [pow_succ]; field_simp
      _ ≤ 2 * π * C₀ * ‖z‖ * (D * 3 ^ D * U) := by gcongr
      _ = 2 * π * D * 3 ^ D * C₀ * U * ‖z‖ := by ring
  rw [hsplit]
  have hs2 : ‖e2 * (dyadicKernel Ω j y - dyadicKernel Ω j (y - z))‖ * R ^ (n + 1) ≤ C₁ * ‖z‖ := by
    have := mul_le_mul_of_nonneg_right hsecond hRn.le
    rwa [div_mul_eq_mul_div, div_mul_eq_mul_div, mul_div_assoc, div_self hRn.ne', mul_one] at this
  calc ‖(e1 - e2) * dyadicKernel Ω j y + e2 * (dyadicKernel Ω j y - dyadicKernel Ω j (y - z))‖ *
        R ^ (n + 1)
      ≤ (‖(e1 - e2) * dyadicKernel Ω j y‖ +
          ‖e2 * (dyadicKernel Ω j y - dyadicKernel Ω j (y - z))‖) * R ^ (n + 1) := by
        gcongr; exact norm_add_le _ _
    _ ≤ 2 * π * D * 3 ^ D * C₀ * U * ‖z‖ + C₁ * ‖z‖ := by rw [add_mul]; exact add_le_add hfirst hs2
    _ ≤ (2 * π * D * 3 ^ D * C₀ + C₁ + 2 * C₀) * (1 + U) * ‖z‖ := by
        have : 0 ≤ 2 * π * D * 3 ^ D * C₀ := by positivity
        nlinarith [mul_nonneg (mul_nonneg this hU0) hz0, mul_nonneg (mul_nonneg hC₁ hU0) hz0,
          mul_nonneg hC₁ hz0, mul_nonneg this hz0, mul_nonneg (mul_nonneg hC₀ hU0) hz0,
          mul_nonneg hC₀ hz0]

/-- `B_R(y) ≥ R^{-n} 5^{-n-1}` for `|y| ≤ 4R`. -/
lemma envelope_ge_of_le_four_mul {R : ℝ} (hR : 0 < R) {y : EuclideanSpace ℝ (Fin n)}
    (hy : ‖y‖ ≤ 4 * R) : (R ^ n)⁻¹ * ((5 : ℝ) ^ (n + 1))⁻¹ ≤ envelope n R y := by
  unfold envelope
  have h1 : ‖y‖ / R ≤ 4 := by rw [div_le_iff₀ hR]; linarith
  gcongr
  linarith

/-- `B_R(y) ≥ R 2^{-n-1} |y|^{-n-1}` for `|y| ≥ R`. -/
lemma envelope_ge_of_le_norm {R : ℝ} (hR : 0 < R) {y : EuclideanSpace ℝ (Fin n)}
    (hy : R ≤ ‖y‖) : R / (2 ^ (n + 1) * ‖y‖ ^ (n + 1)) ≤ envelope n R y := by
  have hy0 : 0 < ‖y‖ := lt_of_lt_of_le hR hy
  have e : envelope n R y = R / (R + ‖y‖) ^ (n + 1) := by
    unfold envelope
    rw [show 1 + ‖y‖ / R = (R + ‖y‖) / R by field_simp, div_pow, pow_succ R n]
    field_simp
  rw [e, ← mul_pow]
  gcongr
  linarith

/-- `B_L(w) ≤ L |w|^{-n-1}` for `w ≠ 0`. -/
lemma envelope_le_div_norm_pow {L : ℝ} (hL : 0 < L) {w : EuclideanSpace ℝ (Fin n)}
    (hw : 0 < ‖w‖) : envelope n L w ≤ L / ‖w‖ ^ (n + 1) := by
  have e : envelope n L w = L / (L + ‖w‖) ^ (n + 1) := by
    unfold envelope
    rw [show 1 + ‖w‖ / L = (L + ‖w‖) / L by field_simp, div_pow, pow_succ L n]
    field_simp
  rw [e]
  gcongr
  linarith

/-- **Blueprint Lemma 12.1 (`lem:kernelerror`)**, eq. (12.1): for a Stein–Wainger profile `Ω`
and `d`, there is `C ≥ 0` (independent of `p`, `s`, `j`, `μ`, `U`) such that, with `R = 2^j`,
`h_{j,μ} = e(μ P) K_j` and `φ_s = 𝓕⁻ χ_s`, whenever `|μ| R^D ≤ U` (`D = 2d`),
`|h_{j,μ}(y) - (h_{j,μ} *_E φ_s)(y)| ≤ C (1 + U) (L_s / R) B_R(y)` for all `y ∈ E` (hence on `G`).
(The blueprint's hypotheses `j ≥ 1`, `1 ≤ L_s ≤ R` are not needed; `L_s ≥ 1` always holds.) -/
theorem major_kernel_error (hΩ : IsSWProfile Ω) (d : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (p : ℝ) (s j : ℕ) (μ U : ℝ), |μ| * ((2 : ℝ) ^ j) ^ (2 * d) ≤ U →
      ∀ y : EuclideanSpace ℝ (Fin n),
        ‖majorH Ω d j μ y -
            (majorH Ω d j μ ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] liftPhi n d Ω p s) y‖ ≤
          C * (1 + U) * ((liftL n d Ω p s : ℝ) / 2 ^ j) * envelope n (2 ^ j) y := by
  obtain ⟨C₀, A, hC₀, hA, hH⟩ := exists_majorH_bounds hΩ d
  obtain ⟨Kφ, hKφ, hmom⟩ := norm_mul_norm_liftPhi_le n
  obtain ⟨Cφ, hCφ, hφ⟩ := norm_liftPhi_le n
  obtain ⟨CL1, hCL1⟩ := dyadicKernel_L1 hΩ
  have hCn : 0 ≤ envelopeConst n := by unfold envelopeConst; positivity
  have hCL0 : 0 ≤ CL1 := (integral_nonneg fun _ => norm_nonneg _).trans (hCL1 0).2.1
  refine ⟨A * Kφ * envelopeConst n * 5 ^ (n + 1) + CL1 * Cφ * 4 ^ (n + 1), by positivity,
    fun p s j μ U hU y => ?_⟩
  obtain ⟨hHb, hHl⟩ := hH j μ U hU
  set R : ℝ := 2 ^ j with hRdef
  set L : ℝ := (liftL n d Ω p s : ℝ) with hLdef
  set h := majorH Ω d j μ with hhdef
  set φ := liftPhi n d Ω p s with hφdef
  have hR : 0 < R := by positivity
  have hL : 0 < L := liftL_pos s
  have hU0 : 0 ≤ U := le_trans (by positivity) hU
  have hconv : (h ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] φ) y = ∫ t, h t * φ (y - t) := by
    rw [convolution_def]; rfl
  have hhc : Continuous h := by
    have : Continuous fun x : EuclideanSpace ℝ (Fin n) => eC (μ * radialPoly n d x) := by
      unfold radialPoly eC; fun_prop
    exact this.mul (contDiff_dyadicKernel hΩ j).continuous
  have hCpos : 0 ≤ A * Kφ * envelopeConst n * 5 ^ (n + 1) := by positivity
  have hCpos' : 0 ≤ CL1 * Cφ * 4 ^ (n + 1) := by positivity
  have hE0 : 0 ≤ envelope n R y := envelope_nonneg hR y
  by_cases hy : ‖y‖ ≤ 4 * R
  · have hconv' : (h ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] φ) y = ∫ z, h (y - z) * φ z := by
      rw [hconv, ← integral_sub_left_eq_self (fun t => h t * φ (y - t)) volume y]
      simp_rw [sub_sub_cancel]
    have hint1 : Integrable fun z => h (y - z) * φ z :=
      (integrable_liftPhi s).bdd_mul
        (hhc.comp (continuous_const.sub continuous_id)).aestronglyMeasurable
        (ae_of_all _ fun z => hHb _)
    have hint2 : Integrable fun z => h y * φ z := (integrable_liftPhi s).const_mul _
    have hrep : h y - (h ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] φ) y =
        ∫ z, (h y - h (y - z)) * φ z := by
      simp_rw [sub_mul]
      rw [hconv', integral_sub hint2 hint1, integral_const_mul, hφdef, integral_liftPhi, mul_one]
    obtain ⟨hEi, hEI⟩ := integrable_envelope_and_integral_le (n := n) hL
    have hbound : ∀ z, ‖(h y - h (y - z)) * φ z‖ ≤
        A * (1 + U) / R ^ (n + 1) * (Kφ * L * envelope n L z) := by
      intro z; rw [norm_mul]
      calc ‖h y - h (y - z)‖ * ‖φ z‖ ≤ (A * (1 + U) * ‖z‖ / R ^ (n + 1)) * ‖φ z‖ := by
            gcongr; exact hHl y z
        _ = A * (1 + U) / R ^ (n + 1) * (‖z‖ * ‖φ z‖) := by ring
        _ ≤ _ := mul_le_mul_of_nonneg_left (hmom d Ω p s z) (by positivity)
    have hI : ‖h y - (h ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] φ) y‖ ≤
        A * (1 + U) / R ^ (n + 1) * (Kφ * L * envelopeConst n) := by
      rw [hrep]
      refine (norm_integral_le_of_norm_le ((hEi.const_mul (Kφ * L)).const_mul _)
        (ae_of_all _ hbound)).trans ?_
      rw [integral_const_mul, integral_const_mul]
      gcongr
    have hE := envelope_ge_of_le_four_mul hR hy
    calc ‖h y - (h ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] φ) y‖
        ≤ A * (1 + U) / R ^ (n + 1) * (Kφ * L * envelopeConst n) := hI
      _ = A * Kφ * envelopeConst n * 5 ^ (n + 1) * (1 + U) * (L / R) *
            ((R ^ n)⁻¹ * ((5 : ℝ) ^ (n + 1))⁻¹) := by
          rw [pow_succ R n]; field_simp
      _ ≤ A * Kφ * envelopeConst n * 5 ^ (n + 1) * (1 + U) * (L / R) * envelope n R y := by
          gcongr
      _ ≤ _ := by gcongr; exact le_add_of_nonneg_right hCpos'
  · push Not at hy
    have hy0 : 0 < ‖y‖ := by linarith
    have hhy : h y = 0 := by
      simp only [hhdef, majorH]
      rw [dyadicKernel_eq_zero_of_le, mul_zero]
      rw [zpow_add_one₀ two_ne_zero, zpow_natCast]; linarith
    rw [hhy, zero_sub, norm_neg, hconv]
    set B : ℝ := Cφ * L * 2 ^ (n + 1) / ‖y‖ ^ (n + 1) with hB
    have hbound : ∀ t, ‖h t * φ (y - t)‖ ≤ ‖h t‖ * B := by
      intro t; rw [norm_mul]
      by_cases ht : dyadicKernel Ω j t = 0
      · have : h t = 0 := by simp [hhdef, majorH, ht]
        rw [this, norm_zero, zero_mul, zero_mul]
      have htR : ‖t‖ < 2 * R := by
        have := (support_dyadicKernel (Ω := Ω) (j : ℤ) ht).2
        rwa [zpow_add_one₀ two_ne_zero, zpow_natCast, mul_comm] at this
      have hyt : ‖y‖ / 2 ≤ ‖y - t‖ := by have := norm_sub_norm_le y t; linarith
      have hyt0 : 0 < ‖y - t‖ := by linarith
      gcongr
      calc ‖φ (y - t)‖ ≤ Cφ * envelope n L (y - t) := (hφ d Ω p s).1 _
        _ ≤ Cφ * (L / ‖y - t‖ ^ (n + 1)) := by gcongr; exact envelope_le_div_norm_pow hL hyt0
        _ ≤ Cφ * (L / (‖y‖ / 2) ^ (n + 1)) := by gcongr
        _ = B := by rw [div_pow, hB]; field_simp
    have hhi : Integrable fun t => ‖h t‖ := (integrable_oscKernel hΩ d j μ).norm
    refine (norm_integral_le_of_norm_le (hhi.mul_const B) (ae_of_all _ hbound)).trans ?_
    rw [integral_mul_const]
    have hnorm_int : ∫ t, ‖h t‖ = ∫ t, ‖dyadicKernel Ω j t‖ := by
      congr 1; funext t; simp [hhdef, majorH, norm_eC]
    have hL1 : ∫ t, ‖h t‖ ≤ CL1 := hnorm_int ▸ (hCL1 j).2.1
    have hE := envelope_ge_of_le_norm (n := n) hR (by linarith : R ≤ ‖y‖)
    have hB0 : 0 ≤ B := by positivity
    calc (∫ t, ‖h t‖) * B ≤ CL1 * B := by gcongr
      _ = CL1 * Cφ * 4 ^ (n + 1) * (L / R) * (R / (2 ^ (n + 1) * ‖y‖ ^ (n + 1))) := by
          rw [hB, show (4 : ℝ) = 2 * 2 by norm_num, mul_pow]; field_simp
      _ ≤ CL1 * Cφ * 4 ^ (n + 1) * (L / R) * envelope n R y := by gcongr
      _ ≤ CL1 * Cφ * 4 ^ (n + 1) * (1 + U) * (L / R) * envelope n R y := by
          have : 0 ≤ CL1 * Cφ * 4 ^ (n + 1) * (L / R) * envelope n R y := by positivity
          nlinarith [mul_nonneg this hU0]
      _ ≤ _ := by gcongr; exact le_add_of_nonneg_left hCpos

/-- `|m̌(y)| ≤ ∫_{[0,1)ⁿ} |m|`. -/
lemma norm_latKernel_le_integral (m : EuclideanSpace ℝ (Fin n) → ℂ) (y : Fin n → ℤ) :
    ‖latKernel m y‖ ≤ ∫ ξ in torusCube n, ‖m ξ‖ := by
  unfold latKernel
  refine (norm_integral_le_integral_norm _).trans (le_of_eq ?_)
  congr 1; funext ξ; rw [norm_mul, norm_eC, mul_one]

/-- If `λ = α + μ` modulo `ℤ`, then `e(λ P(y)) = e(α P(y)) e(μ P(y))` for `y ∈ G` (since
`P(y) ∈ ℤ`). -/
lemma eC_mul_radialPolyZ_of_eq_add (d : ℕ) {α μ lam : ℝ} (hlam : ∃ k : ℤ, lam = α + μ + k)
    (y : Fin n → ℤ) :
    eC (lam * (radialPolyZ n d y : ℝ)) =
      eC (α * (radialPolyZ n d y : ℝ)) * eC (μ * radialPoly n d (latEmbed y)) := by
  obtain ⟨k, rfl⟩ := hlam
  rw [radialPoly_latEmbed, ← eC_add]
  have : (α + μ + k) * (radialPolyZ n d y : ℝ) =
      α * (radialPolyZ n d y : ℝ) + μ * (radialPolyZ n d y : ℝ) +
        ((k * radialPolyZ n d y : ℤ) : ℝ) := by
    push_cast; ring
  rw [this, eC_add, eC_intCast, mul_one]

/-- Blueprint Lemma 12.1 (`lem:kernelerror`), via eq. (`eq:liftkernel`): for `α = a/q`, `q ≥ 1`,
the kernel of `Lift_{s,α}[Φ_{j,μ}]` is `e(α P(y)) (h_{j,μ} *_E φ_s)(y)` for every `y ∈ G`. -/
theorem latKernel_liftSym_radialOscPhi (hΩ : IsSWProfile Ω) (p : ℝ) (s a : ℕ) {q : ℕ}
    (hq : 1 ≤ q) (j : ℤ) (μ : ℝ) (y : Fin n → ℤ) :
    latKernel (liftSym n d Ω p s a q (radialOscPhi Ω d j μ)) y =
      eC ((a : ℝ) / q * (radialPolyZ n d y : ℝ)) *
        (majorH Ω d j μ ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] liftPhi n d Ω p s)
          (latEmbed y) := by
  have hH : Integrable (majorH Ω d j μ) := integrable_oscKernel hΩ d j μ
  obtain ⟨hFc, hFb⟩ := continuous_fourier_and_norm_le hH
  rw [radialOscPhi_eq_fourier_majorH,
    latKernel_liftSym_of_bdd s a hq hFc.aestronglyMeasurable (fun ξ _ => hFb ξ) y,
    fourierInv_fourier_mul_liftChi hH]

/-- **Blueprint Lemma 12.1 (`lem:kernelerror`)**, lattice kernel formula: if `λ = α + μ` in `𝕋`
(`λ - a/q - μ ∈ ℤ`), with `α = a/q`, `q ≥ 1` (in particular `α ∈ 𝓡_s`), then for every
`f ∈ ℓ¹(G)` (e.g. finitely supported) and `x ∈ G`,
`T_{j,λ} f(x) - Lift_{s,α}[Φ_{j,μ}](D) f(x) =
  ∑_y e(α P(y)) [h_{j,μ}(y) - (h_{j,μ} *_E φ_s)(y)] f(x - y)`,
i.e. the lattice convolution kernel of `T_{j,λ} - Lift_{s,α}[Φ_{j,μ}](D)` is
`e(α P(y)) [h_{j,μ}(y) - (h_{j,μ} *_E φ_s)(y)]`, including its value at `y = 0`. -/
theorem major_kernel_formula (hΩ : IsSWProfile Ω) (p : ℝ) (s a : ℕ) {q : ℕ} (hq : 1 ≤ q)
    (j : ℕ) {lam μ : ℝ} (hlam : ∃ k : ℤ, lam = a / q + μ + k) {f : (Fin n → ℤ) → ℂ}
    (hf : Summable fun z => ‖f z‖) (x : Fin n → ℤ) :
    minorOp Ω d j lam f x - latMult (liftSym n d Ω p s a q (radialOscPhi Ω d j μ)) f x =
      ∑' y, eC ((a : ℝ) / q * (radialPolyZ n d y : ℝ)) *
        (majorH Ω d j μ (latEmbed y) -
          (majorH Ω d j μ ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] liftPhi n d Ω p s)
            (latEmbed y)) * f (x - y) := by
  set H := majorH Ω d j μ with hHdef
  have hH : Integrable H := integrable_oscKernel hΩ d j μ
  obtain ⟨hFc, hFb⟩ := continuous_fourier_and_norm_le hH
  have hint : IntegrableOn (liftSym n d Ω p s a q (𝓕 H)) (torusCube n) :=
    integrableOn_liftSym (integrable_mul_liftChi hFc.aestronglyMeasurable (fun ξ _ => hFb ξ))
  have hker : ∀ y, latKernel (liftSym n d Ω p s a q (𝓕 H)) y =
      eC ((a : ℝ) / q * (radialPolyZ n d y : ℝ)) *
        (H ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] liftPhi n d Ω p s) (latEmbed y) := by
    intro y
    rw [← radialOscPhi_eq_fourier_majorH]
    exact latKernel_liftSym_radialOscPhi hΩ p s a hq j μ y
  rw [radialOscPhi_eq_fourier_majorH, latMult_eq_latConv hint hf, latConv, minorOp]
  have hs1 : Summable fun y : Fin n → ℤ =>
      eC (lam * (radialPolyZ n d y : ℝ)) * dyadicKernel Ω j (latEmbed y) * f (x - y) := by
    refine summable_of_ne_finset_zero (s := minorBox n (2 * 2 ^ j)) fun y hy => ?_
    rw [minor_kernel_eq_zero j hy, mul_zero, zero_mul]
  have hfx : Summable fun y => ‖f (x - y)‖ :=
    (Equiv.subLeft x).summable_iff.2 hf
  have hs2 : Summable fun y => latKernel (liftSym n d Ω p s a q (𝓕 H)) y * f (x - y) := by
    refine Summable.of_norm_bounded (hfx.mul_left (∫ ξ in torusCube n,
      ‖liftSym n d Ω p s a q (𝓕 H) ξ‖)) fun y => ?_
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_right (norm_latKernel_le_integral _ y) (norm_nonneg _)
  rw [← hs1.tsum_sub hs2]
  refine tsum_congr fun y => ?_
  rw [hker, eC_mul_radialPolyZ_of_eq_add d hlam y, hHdef, majorH]
  ring

/-! ### Blueprint Lemma 12.2 (`lem:coherence`) -/

/-- The exponent `⌊M log₂(j+1)⌋` of `H_j = 2^{⌊M log₂(j+1)⌋}`. -/
noncomputable def majorExp (M j : ℕ) : ℕ := ⌊(M : ℝ) * Real.logb 2 ((j : ℝ) + 1)⌋₊

/-- `H_j = 2^{⌊M log₂(j+1)⌋}`. -/
lemma minorH_eq_two_pow (M j : ℕ) : minorH M j = 2 ^ majorExp M j := rfl

/-- `H_j ≤ (j+1)^M`. -/
lemma minorH_le_pow (M j : ℕ) : (minorH M j : ℝ) ≤ ((j : ℝ) + 1) ^ M := by
  set x : ℝ := (M : ℝ) * Real.logb 2 ((j : ℝ) + 1) with hx
  have hj : (0 : ℝ) < (j : ℝ) + 1 := by positivity
  have hx0 : 0 ≤ x := mul_nonneg (Nat.cast_nonneg _)
    (Real.logb_nonneg (by norm_num) (by linarith [(Nat.cast_nonneg j : (0 : ℝ) ≤ j)]))
  have h2x : (2 : ℝ) ^ x = ((j : ℝ) + 1) ^ M := by
    rw [hx, mul_comm, Real.rpow_mul (by norm_num), Real.rpow_logb (by norm_num) (by norm_num) hj,
      Real.rpow_natCast]
  rw [minorH, Nat.cast_pow, Nat.cast_ofNat, ← h2x, ← Real.rpow_natCast]
  exact Real.rpow_le_rpow_of_exponent_le (by norm_num) (Nat.floor_le hx0)

/-- `s ≤ ⌊M log₂(j+1)⌋ ⟺ j ≥ ⌈2^{s/M}⌉ - 1` (for `M ≥ 1`). -/
lemma le_majorExp_iff {M : ℕ} (hM : 1 ≤ M) (s j : ℕ) :
    s ≤ majorExp M j ↔ ⌈(2 : ℝ) ^ ((s : ℝ) / M)⌉₊ - 1 ≤ j := by
  have hj : (0 : ℝ) < (j : ℝ) + 1 := by positivity
  have hM' : (0 : ℝ) < M := by exact_mod_cast hM
  have hx0 : 0 ≤ (M : ℝ) * Real.logb 2 ((j : ℝ) + 1) := mul_nonneg (Nat.cast_nonneg _)
    (Real.logb_nonneg (by norm_num) (by linarith [(Nat.cast_nonneg j : (0 : ℝ) ≤ j)]))
  rw [majorExp, Nat.le_floor_iff hx0, ← div_le_iff₀' hM',
    Real.le_logb_iff_rpow_le one_lt_two hj,
    show ((j : ℝ) + 1) = ((j + 1 : ℕ) : ℝ) by push_cast; ring, ← Nat.ceil_le]
  omega

/-- Blueprint Lemma 12.2 (`lem:coherence`): `H_j ≥ 2^s ⟺ j ≥ ⌈2^{s/M}⌉ - 1` (for `M ≥ 1`). -/
lemma two_pow_le_minorH_iff {M : ℕ} (hM : 1 ≤ M) (s j : ℕ) :
    2 ^ s ≤ minorH M j ↔ ⌈(2 : ℝ) ^ ((s : ℝ) / M)⌉₊ - 1 ≤ j := by
  rw [minorH_eq_two_pow, Nat.pow_le_pow_iff_right (by norm_num), le_majorExp_iff hM]

/-- Rational separation (Lemma 3.2): two reduced fractions `a/q`, `a'/q'` in `[0, 1)` with
`q, q' < B` and `‖a/q - a'/q'‖_𝕋 < B^{-2}` coincide. -/
lemma reduced_eq_of_norm_lt {a q a' q' : ℕ} (hq : 1 ≤ q) (ha : a < q) (hc : Nat.Coprime a q)
    (hq' : 1 ≤ q') (ha' : a' < q') (hc' : Nat.Coprime a' q') {B : ℝ} (hqB : (q : ℝ) < B)
    (hq'B : (q' : ℝ) < B)
    (h : ‖(((a : ℝ) / q - a' / q' : ℝ) : UnitAddCircle)‖ < 1 / B ^ 2) : a = a' ∧ q = q' := by
  by_contra hne
  have hq0 : (0 : ℝ) < q := by exact_mod_cast hq
  have hq0' : (0 : ℝ) < q' := by exact_mod_cast hq'
  have hnot : ¬ ∃ m : ℤ,
      (((a : ℤ) : ℝ) / ((q : ℤ) : ℝ) - ((a' : ℤ) : ℝ) / ((q' : ℤ) : ℝ) : ℝ) = m := by
    rintro ⟨m, hm⟩
    push_cast at hm
    have h1 : (a : ℝ) / q < 1 := by rw [div_lt_one hq0]; exact_mod_cast ha
    have h2 : (a' : ℝ) / q' < 1 := by rw [div_lt_one hq0']; exact_mod_cast ha'
    have h3 : 0 ≤ (a : ℝ) / q := by positivity
    have h4 : 0 ≤ (a' : ℝ) / q' := by positivity
    have hm1 : (m : ℝ) < 1 := by linarith
    have hm2 : (-1 : ℝ) < m := by linarith
    have hm0 : m = 0 := by
      have : m < 1 := by exact_mod_cast hm1
      have : -1 < m := by exact_mod_cast hm2
      omega
    rw [hm0, Int.cast_zero, sub_eq_zero, div_eq_div_iff hq0.ne' hq0'.ne'] at hm
    have hnat : a * q' = a' * q := by exact_mod_cast hm
    apply hne
    have hd1 : q ∣ a * q' := ⟨a', by rw [hnat, mul_comm]⟩
    have hd2 : q' ∣ a' * q := ⟨a, by rw [← hnat, mul_comm]⟩
    have hqq : q = q' :=
      Nat.dvd_antisymm (hc.symm.dvd_of_dvd_mul_left hd1) (hc'.symm.dvd_of_dvd_mul_left hd2)
    subst hqq
    exact ⟨Nat.eq_of_mul_eq_mul_right (by omega) hnat, rfl⟩
  have hsep := one_div_mul_le_norm_addCircle (a : ℤ) (a' : ℤ)
    (by exact_mod_cast hq : (0 : ℤ) < q) (by exact_mod_cast hq' : (0 : ℤ) < q') hnot
  push_cast at hsep
  have hqq : (q : ℝ) * q' < B ^ 2 := by nlinarith
  have : 1 / B ^ 2 < 1 / ((q : ℝ) * q') := one_div_lt_one_div_of_lt (by positivity) hqq
  linarith

/-- `‖α - β‖_𝕋 ≤ ‖λ - α‖_𝕋 + ‖λ - β‖_𝕋`. -/
lemma norm_sub_centers_le (lam α β : ℝ) :
    ‖((α - β : ℝ) : UnitAddCircle)‖ ≤
      ‖((lam - α : ℝ) : UnitAddCircle)‖ + ‖((lam - β : ℝ) : UnitAddCircle)‖ := by
  have : ((α - β : ℝ) : UnitAddCircle) =
      ((lam - β : ℝ) : UnitAddCircle) - ((lam - α : ℝ) : UnitAddCircle) := by
    rw [← AddCircle.coe_sub]; congr 1; ring
  rw [this, add_comm]
  exact norm_sub_le _ _

/-- Property (3) of Blueprint Lemma 12.2 (`lem:coherence`) for all large `j`:
`v_s ≤ j/2` whenever `s ≤ ⌊M log₂(j+1)⌋`. -/
lemma exists_liftV_le_half (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) :
    ∃ N : ℕ, ∀ j ≥ N, ∀ s : ℕ, s ≤ majorExp (paramM n d Ω p) j →
      (liftV n d Ω p s : ℝ) ≤ (j : ℝ) / 2 := by
  set M := paramM n d Ω p with hMdef
  have hM : (2 : ℝ) ≤ M := by exact_mod_cast two_le_paramM n d Ω p
  set Cs := liftCStar n d Ω p
  have hCs : 0 < Cs := liftCStar_pos
  have hlog2 : 0 < Real.log 2 := Real.log_pos one_lt_two
  set K : ℝ := 2 * Cs * (4 * M / Real.log 2 + 1) with hK
  have hK0 : 0 ≤ K := by positivity
  refine ⟨⌈(4 * K + 4) ^ 4⌉₊, fun j hj s hs => ?_⟩
  set x : ℝ := (j : ℝ) + 1 with hx
  have hx0 : 0 < x := by positivity
  set t : ℝ := x ^ (1 / 4 : ℝ) with ht
  have ht1 : 1 ≤ t := Real.one_le_rpow (by linarith [(Nat.cast_nonneg j : (0 : ℝ) ≤ j)])
    (by norm_num)
  have ht4 : t ^ 4 = x := by
    rw [ht, ← Real.rpow_natCast, ← Real.rpow_mul hx0.le]; norm_num
  have ht2 : x ^ (1 / 2 : ℝ) = t ^ 2 := by
    rw [ht, ← Real.rpow_natCast, ← Real.rpow_mul hx0.le]; norm_num
  have htK : 4 * K + 4 ≤ t := by
    refine le_of_pow_le_pow_left₀ (n := 4) (by norm_num) (by linarith) ?_
    rw [ht4]
    have := Nat.le_ceil ((4 * K + 4) ^ 4)
    have h2 : ((⌈(4 * K + 4) ^ 4⌉₊ : ℕ) : ℝ) ≤ j := by exact_mod_cast hj
    linarith
  have hlogb0 : 0 ≤ Real.logb 2 x := Real.logb_nonneg one_lt_two (by
    linarith [(Nat.cast_nonneg j : (0 : ℝ) ≤ j)])
  have hsR : (s : ℝ) ≤ M * Real.logb 2 x := by
    have h1 : (s : ℝ) ≤ majorExp M j := by exact_mod_cast hs
    exact h1.trans (Nat.floor_le (mul_nonneg (by positivity) hlogb0))
  have hlog : Real.log x ≤ 4 * t := by
    have := Real.log_le_rpow_div hx0.le (by norm_num : (0 : ℝ) < 1 / 4)
    rw [← ht] at this; linarith [show t / (1 / 4) = 4 * t by ring]
  have hs1 : (s : ℝ) + 1 ≤ (4 * M / Real.log 2 + 1) * t := by
    have : M * Real.logb 2 x ≤ 4 * M / Real.log 2 * t := by
      rw [Real.logb, mul_div_assoc', div_mul_eq_mul_div, div_le_div_iff_of_pos_right hlog2]
      nlinarith
    nlinarith
  have hpow : (2 : ℝ) ^ ((s : ℝ) / (2 * M)) ≤ t ^ 2 := by
    rw [← ht2]
    have e : x ^ (1 / 2 : ℝ) = (2 : ℝ) ^ (Real.logb 2 x * (1 / 2)) := by
      rw [Real.rpow_mul (by norm_num), Real.rpow_logb (by norm_num) (by norm_num) hx0]
    rw [e]
    refine Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_
    rw [div_le_iff₀ (by positivity)]
    nlinarith
  have hv : (liftV n d Ω p s : ℝ) ≤ Cs * ((s : ℝ) + 1) * (1 + (2 : ℝ) ^ ((s : ℝ) / (2 * M))) + 1 :=
    (Nat.ceil_lt_add_one (by positivity)).le
  have hv2 : Cs * ((s : ℝ) + 1) * (1 + (2 : ℝ) ^ ((s : ℝ) / (2 * M))) ≤ K * t ^ 3 := by
    have h1 : 1 + (2 : ℝ) ^ ((s : ℝ) / (2 * M)) ≤ 2 * t ^ 2 := by nlinarith
    calc Cs * ((s : ℝ) + 1) * (1 + (2 : ℝ) ^ ((s : ℝ) / (2 * M)))
        ≤ Cs * ((4 * M / Real.log 2 + 1) * t) * (2 * t ^ 2) := by gcongr
      _ = K * t ^ 3 := by rw [hK]; ring
  have hjx : (j : ℝ) = t ^ 4 - 1 := by rw [ht4, hx]; ring
  rw [hjx]
  have h3 : 1 ≤ t ^ 3 := one_le_pow₀ ht1
  have h4 : (4 * K + 4) * t ^ 3 ≤ t * t ^ 3 := mul_le_mul_of_nonneg_right htK (by positivity)
  nlinarith

/-- `w_{j+1} < w_j` once `j + 1 ≥ M` (for `d ≥ 1`). -/
lemma minorW_succ_lt {d M j : ℕ} (hd : 1 ≤ d) (hMj : M ≤ j + 1) :
    minorW d M (j + 1) < minorW d M j := by
  have hj0 : (0 : ℝ) < (j : ℝ) + 1 := by positivity
  have hexp : ((j : ℝ) + 2) ^ M ≤ Real.exp 1 * ((j : ℝ) + 1) ^ M := by
    have h1 : (j : ℝ) + 2 ≤ ((j : ℝ) + 1) * Real.exp (1 / ((j : ℝ) + 1)) := by
      have := Real.add_one_le_exp (1 / ((j : ℝ) + 1))
      calc (j : ℝ) + 2 = ((j : ℝ) + 1) * (1 / ((j : ℝ) + 1) + 1) := by field_simp; ring
        _ ≤ ((j : ℝ) + 1) * Real.exp (1 / ((j : ℝ) + 1)) := by gcongr
    calc ((j : ℝ) + 2) ^ M ≤ (((j : ℝ) + 1) * Real.exp (1 / ((j : ℝ) + 1))) ^ M := by gcongr
      _ = ((j : ℝ) + 1) ^ M * Real.exp (M * (1 / ((j : ℝ) + 1))) := by
          rw [mul_pow, ← Real.exp_nat_mul]
      _ ≤ ((j : ℝ) + 1) ^ M * Real.exp 1 := by
          gcongr
          rw [mul_one_div, div_le_one hj0]
          exact_mod_cast hMj
      _ = _ := by ring
  have he4 : Real.exp 1 < 4 := by have := Real.exp_one_lt_d9; linarith
  have h4 : (4 : ℝ) ≤ 2 ^ (2 * d) := by
    calc (4 : ℝ) = 2 ^ 2 := by norm_num
      _ ≤ 2 ^ (2 * d) := pow_le_pow_right₀ (by norm_num) (by omega)
  rw [minorW, minorW, div_lt_div_iff₀ (by positivity) (by positivity),
    show 2 * d * (j + 1) = 2 * d * j + 2 * d by ring, pow_add]
  push_cast
  rw [show (j : ℝ) + 1 + 1 = (j : ℝ) + 2 by ring]
  have hp : (0 : ℝ) < 2 ^ (2 * d * j) := by positivity
  have hX : (0 : ℝ) < ((j : ℝ) + 1) ^ M := by positivity
  have : ((j : ℝ) + 2) ^ M < ((j : ℝ) + 1) ^ M * 2 ^ (2 * d) := by nlinarith
  nlinarith

/-- Property (1) of Blueprint Lemma 12.2 (`lem:coherence`) for all large `j`. -/
lemma eventually_minorW_bounds {d : ℕ} (hd : 1 ≤ d) (M : ℕ) : ∃ N : ℕ, ∀ j ≥ N,
    minorW d M j < 1 / 4 ∧ minorW d M (j + 1) < minorW d M j ∧
      minorW d M j ≤ ((minorH M j : ℝ) ^ 2)⁻¹ / 16 := by
  obtain ⟨NA, hNA⟩ := minor_eventually_pow_le_two_pow (16 * 2 ^ (3 * M)) (3 * M)
  refine ⟨max (max NA 1) M, fun j hj => ?_⟩
  have hj1 : 1 ≤ j := le_trans (le_max_right _ _) (le_trans (le_max_left _ _) hj)
  have hjA : NA ≤ j := le_trans (le_max_left _ _) (le_trans (le_max_left _ _) hj)
  have hjM : M ≤ j := le_trans (le_max_right _ _) hj
  set X : ℝ := ((j : ℝ) + 1) ^ M with hXdef
  have hX1 : 1 ≤ X := one_le_pow₀ (by linarith [(Nat.cast_nonneg j : (0 : ℝ) ≤ j)])
  have hA : 16 * X ^ 3 ≤ (2 : ℝ) ^ (2 * d * j) := by
    have h1 : (j : ℝ) + 1 ≤ 2 * j := by
      have : (1 : ℝ) ≤ j := by exact_mod_cast hj1
      linarith
    have h2 : X ^ 3 ≤ 2 ^ (3 * M) * (j : ℝ) ^ (3 * M) := by
      rw [hXdef, ← pow_mul, ← mul_pow, show M * 3 = 3 * M by ring]; gcongr
    have h3 := hNA j hjA
    have h4 : (2 : ℝ) ^ j ≤ 2 ^ (2 * d * j) := pow_le_pow_right₀ (by norm_num) (by nlinarith)
    nlinarith
  have hW : minorW d M j ≤ 1 / (16 * X ^ 2) := by
    rw [minorW, div_le_div_iff₀ (by positivity) (by positivity)]
    nlinarith
  have hH : (minorH M j : ℝ) ≤ X := minorH_le_pow M j
  have hH0 : (0 : ℝ) < minorH M j := by rw [minorH]; positivity
  refine ⟨?_, minorW_succ_lt hd (by omega), ?_⟩
  · calc minorW d M j ≤ 1 / (16 * X ^ 2) := hW
      _ ≤ 1 / 16 := by gcongr; nlinarith
      _ < 1 / 4 := by norm_num
  · calc minorW d M j ≤ 1 / (16 * X ^ 2) := hW
      _ ≤ 1 / (16 * (minorH M j : ℝ) ^ 2) := by gcongr
      _ = _ := by field_simp

/-- `a/q` is an admissible center of the major arcs `X_j`: `1 ≤ q < H_j`, `0 ≤ a < q`,
`(a, q) = 1`. -/
def IsMajorCenter (M j a q : ℕ) : Prop :=
  1 ≤ q ∧ q < minorH M j ∧ a < q ∧ Nat.Coprime a q

/-- The requirements on the final lower scale `j₀` of Blueprint Lemma 12.2 (`lem:coherence`):
`j₀ ≥ j₁`, and for every `j ≥ j₀`: (1) `w_j < 1/4`, `w_{j+1} < w_j`, `w_j ≤ H_j^{-2}/16`;
(2) the arcs defining `X_j` are pairwise disjoint (two admissible centers whose arcs share a point
coincide); (3) `v_s ≤ j/2` for `1 ≤ s ≤ ⌊M log₂(j+1)⌋`. -/
def CoherenceSpec (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (j₀ : ℕ) : Prop :=
  paramJ1 n d Ω p ≤ j₀ ∧ ∀ j ≥ j₀,
    (minorW d (paramM n d Ω p) j < 1 / 4 ∧
      minorW d (paramM n d Ω p) (j + 1) < minorW d (paramM n d Ω p) j ∧
      minorW d (paramM n d Ω p) j ≤ ((minorH (paramM n d Ω p) j : ℝ) ^ 2)⁻¹ / 16) ∧
    (∀ a q a' q' : ℕ, IsMajorCenter (paramM n d Ω p) j a q →
      IsMajorCenter (paramM n d Ω p) j a' q' → ∀ lam : ℝ,
        ‖((lam - a / q : ℝ) : UnitAddCircle)‖ ≤ minorW d (paramM n d Ω p) j →
        ‖((lam - a' / q' : ℝ) : UnitAddCircle)‖ ≤ minorW d (paramM n d Ω p) j →
        a = a' ∧ q = q') ∧
    (∀ s : ℕ, 1 ≤ s → s ≤ majorExp (paramM n d Ω p) j → (liftV n d Ω p s : ℝ) ≤ (j : ℝ) / 2)

/-- Disjointness of the arcs of `X_j` from `w_j ≤ H_j^{-2}/16` (rational separation). -/
lemma arcs_disjoint_of_le {M d j : ℕ}
    (hw : minorW d M j ≤ ((minorH M j : ℝ) ^ 2)⁻¹ / 16) {a q a' q' : ℕ}
    (h : IsMajorCenter M j a q) (h' : IsMajorCenter M j a' q') {lam : ℝ}
    (h1 : ‖((lam - a / q : ℝ) : UnitAddCircle)‖ ≤ minorW d M j)
    (h2 : ‖((lam - a' / q' : ℝ) : UnitAddCircle)‖ ≤ minorW d M j) : a = a' ∧ q = q' := by
  obtain ⟨hq, hqH, ha, hc⟩ := h
  obtain ⟨hq', hqH', ha', hc'⟩ := h'
  have hH0 : (0 : ℝ) < minorH M j := by rw [minorH]; positivity
  refine reduced_eq_of_norm_lt hq ha hc hq' ha' hc' (B := minorH M j) (by exact_mod_cast hqH)
    (by exact_mod_cast hqH') ?_
  calc ‖(((a : ℝ) / q - a' / q' : ℝ) : UnitAddCircle)‖ ≤ minorW d M j + minorW d M j :=
        (norm_sub_centers_le lam _ _).trans (add_le_add h1 h2)
    _ ≤ 2 * (((minorH M j : ℝ) ^ 2)⁻¹ / 16) := by linarith
    _ < 1 / (minorH M j : ℝ) ^ 2 := by
        rw [one_div]; have : 0 < ((minorH M j : ℝ) ^ 2)⁻¹ := by positivity
        linarith

/-- Blueprint Lemma 12.2 (`lem:coherence`), existence of the final lower scale: for `d ≥ 1`
there is `j₀` satisfying `CoherenceSpec`. -/
theorem exists_coherenceSpec {d : ℕ} (hd : 1 ≤ d) (n : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ)
    (p : ℝ) : ∃ j₀, CoherenceSpec n d Ω p j₀ := by
  obtain ⟨N₁, h₁⟩ := eventually_minorW_bounds hd (paramM n d Ω p)
  obtain ⟨N₂, h₂⟩ := exists_liftV_le_half n d Ω p
  refine ⟨max (max N₁ N₂) (paramJ1 n d Ω p), le_max_right _ _, fun j hj => ?_⟩
  have hj₁ : N₁ ≤ j := le_trans (le_max_left _ _) (le_trans (le_max_left _ _) hj)
  have hj₂ : N₂ ≤ j := le_trans (le_max_right _ _) (le_trans (le_max_left _ _) hj)
  obtain hw := h₁ j hj₁
  exact ⟨hw, fun a q a' q' h h' lam hl hl' => arcs_disjoint_of_le hw.2.2 h h' hl hl',
    fun s _ hs => h₂ j hj₂ s hs⟩

/-- The final lower scale `j₀` of Blueprint Lemma 12.2 (`lem:coherence`): the least integer
satisfying `CoherenceSpec` (chosen after all previous constants `M`, `j₁`, `v_s`). -/
noncomputable def coherJ0 (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) : ℕ :=
  sInf {j₀ | CoherenceSpec n d Ω p j₀}

/-- **Blueprint Lemma 12.2 (`lem:coherence`)**, (1)–(3): for `d ≥ 1`, `j₀ = coherJ0 n d Ω p ≥ j₁`
satisfies (1)–(3) for every `j ≥ j₀`. -/
theorem coherJ0_spec (hd : 1 ≤ d) : CoherenceSpec n d Ω p (coherJ0 n d Ω p) :=
  Nat.sInf_mem (exists_coherenceSpec hd n Ω p)

/-- `j_s = max(j₀, ⌈2^{s/M}⌉ - 1)` of Blueprint Lemma 12.2 (`lem:coherence`). -/
noncomputable def coherJs (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ) : ℕ :=
  max (coherJ0 n d Ω p) (⌈(2 : ℝ) ^ ((s : ℝ) / (paramM n d Ω p : ℝ))⌉₊ - 1)

/-- `M ≥ 1`. -/
lemma major_one_le_paramM : 1 ≤ paramM n d Ω p := le_trans (by norm_num) (two_le_paramM n d Ω p)

/-- Blueprint Lemma 12.2 (`lem:coherence`): `w_j` is decreasing on `[j₀, ∞)`. -/
theorem minorW_antitone (hd : 1 ≤ d) {j j' : ℕ} (hj : coherJ0 n d Ω p ≤ j) (hjj' : j ≤ j') :
    minorW d (paramM n d Ω p) j' ≤ minorW d (paramM n d Ω p) j := by
  induction j', hjj' using Nat.le_induction with
  | base => exact le_rfl
  | succ k hk ih => exact ((coherJ0_spec hd).2 k (hj.trans hk)).1.2.1.le.trans ih

/-- A pair of `𝓡_s` with `q < H_j` forces `1 ≤ s`, `2^s ≤ H_j` and `s ≤ ⌊M log₂(j+1)⌋`
(`H_j` is a power of two). -/
lemma liftRat_bounds_of_lt_minorH {M s j a q : ℕ} (h : (a, q) ∈ liftRat s)
    (hqH : q < minorH M j) : 1 ≤ s ∧ 2 ^ s ≤ minorH M j ∧ s ≤ majorExp M j := by
  obtain ⟨h1, h2, h3, -⟩ := mem_liftRat.1 h
  unfold liftN at h1 h2
  rw [minorH_eq_two_pow] at hqH ⊢
  have hs1 : 1 ≤ s := by
    rcases Nat.eq_zero_or_pos s with hs | hs
    · subst hs; simp at h2; omega
    · exact hs
  have hlt : 2 ^ s < 2 ^ (majorExp M j + 1) := by rw [pow_succ]; omega
  have hs : s ≤ majorExp M j := by
    have := (Nat.pow_lt_pow_iff_right (by norm_num : 1 < 2)).1 hlt; omega
  exact ⟨hs1, Nat.pow_le_pow_right (by norm_num) hs, hs⟩

/-- Blueprint Lemma 12.2 (`lem:coherence`), admissibility: for `j ≥ j_s` every center of `𝓡_s`
(denominator `q ∈ [2^{s-1}, 2^s)`) is allowed in `X_j`. -/
theorem isMajorCenter_of_mem_liftRat {s j a q : ℕ} (hj : coherJs n d Ω p s ≤ j)
    (h : (a, q) ∈ liftRat s) : IsMajorCenter (paramM n d Ω p) j a q := by
  obtain ⟨-, h2, h3, h4⟩ := mem_liftRat.1 h
  have hs : 2 ^ s ≤ minorH (paramM n d Ω p) j :=
    (two_pow_le_minorH_iff major_one_le_paramM s j).2 (le_trans (le_max_right _ _) hj)
  exact ⟨one_le_of_mem_liftRat h, lt_of_lt_of_le h2 hs, h3, h4⟩

/-- Blueprint Lemma 12.2 (`lem:coherence`), admissibility: if `s ≤ ⌊M log₂(j+1)⌋`, every center
of `𝓡_s` is allowed in `X_j`. -/
theorem isMajorCenter_of_le_majorExp {M s j a q : ℕ} (hs : s ≤ majorExp M j)
    (h : (a, q) ∈ liftRat s) : IsMajorCenter M j a q := by
  obtain ⟨-, h2, h3, h4⟩ := mem_liftRat.1 h
  have hs' : 2 ^ s ≤ minorH M j := by
    rw [minorH_eq_two_pow]; exact Nat.pow_le_pow_right (by norm_num) hs
  exact ⟨one_le_of_mem_liftRat h, lt_of_lt_of_le h2 hs', h3, h4⟩

/-- Blueprint Lemma 12.2 (`lem:coherence`), the unique major center: for `d ≥ 1`, `j ≥ j₀` and
`λ ∈ X_j` there is exactly one admissible `(a, q)` with `‖λ - a/q‖_𝕋 ≤ w_j`. -/
theorem minorArcs_center_unique (hd : 1 ≤ d) {j : ℕ} (hj : coherJ0 n d Ω p ≤ j) {lam : ℝ}
    (hlam : lam ∈ minorArcs d (paramM n d Ω p) j) :
    ∃! aq : ℕ × ℕ, IsMajorCenter (paramM n d Ω p) j aq.1 aq.2 ∧
      ‖((lam - aq.1 / aq.2 : ℝ) : UnitAddCircle)‖ ≤ minorW d (paramM n d Ω p) j := by
  obtain ⟨q, a, hq, hqH, ha, hc, hl⟩ := hlam
  refine ⟨(a, q), ⟨⟨hq, hqH, ha, hc⟩, hl⟩, fun aq haq => ?_⟩
  obtain ⟨h1, h2⟩ := ((coherJ0_spec hd).2 j hj).2.1 _ _ _ _ haq.1 ⟨hq, hqH, ha, hc⟩ lam haq.2 hl
  exact Prod.ext h1 h2

/-- Every reduced `a/q ∈ [0, 1)` lies in some `𝓡_s` (`s = ⌊log₂ q⌋ + 1`). -/
lemma exists_mem_liftRat {q : ℕ} (a : ℕ) (hq : 1 ≤ q) (ha : a < q) (hc : Nat.Coprime a q) :
    ∃ s, (a, q) ∈ liftRat s := by
  refine ⟨Nat.log 2 q + 1, mem_liftRat.2 ⟨?_, ?_, ha, hc⟩⟩
  · unfold liftN; rw [pow_succ, mul_comm]
    exact Nat.mul_le_mul_left 2 (Nat.pow_log_le_self 2 (by omega))
  · exact Nat.lt_pow_succ_log_self (by norm_num) q

/-- The sets `𝓡_s` are pairwise disjoint. -/
lemma eq_of_mem_liftRat {a q s s' : ℕ} (h : (a, q) ∈ liftRat s) (h' : (a, q) ∈ liftRat s') :
    s = s' := by
  obtain ⟨h1, h2, -, -⟩ := mem_liftRat.1 h
  obtain ⟨h1', h2', -, -⟩ := mem_liftRat.1 h'
  unfold liftN at h1 h2 h1' h2'
  have e1 : 2 ^ s < 2 ^ (s' + 1) := by rw [pow_succ]; omega
  have e2 : 2 ^ s' < 2 ^ (s + 1) := by rw [pow_succ]; omega
  have := (Nat.pow_lt_pow_iff_right (by norm_num : 1 < 2)).1 e1
  have := (Nat.pow_lt_pow_iff_right (by norm_num : 1 < 2)).1 e2
  omega

open Classical in
/-- The indices `j ∈ [j₀, J]` for which the major center of `λ` at scale `j` belongs to `𝓡_s`
(Blueprint Lemma 12.2 (`lem:coherence`)). -/
noncomputable def majorIdx (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ)
    (lam : ℝ) (J : ℕ) : Finset ℕ :=
  (Finset.Icc (coherJ0 n d Ω p) J).filter fun j => ∃ aq ∈ liftRat s,
    aq.2 < minorH (paramM n d Ω p) j ∧
      ‖((lam - aq.1 / aq.2 : ℝ) : UnitAddCircle)‖ ≤ minorW d (paramM n d Ω p) j

/-- Membership in `majorIdx`. -/
lemma mem_majorIdx {s : ℕ} {lam : ℝ} {J j : ℕ} :
    j ∈ majorIdx n d Ω p s lam J ↔ coherJ0 n d Ω p ≤ j ∧ j ≤ J ∧ ∃ a q : ℕ, (a, q) ∈ liftRat s ∧
      q < minorH (paramM n d Ω p) j ∧
      ‖((lam - a / q : ℝ) : UnitAddCircle)‖ ≤ minorW d (paramM n d Ω p) j := by
  simp only [majorIdx, Finset.mem_filter, Finset.mem_Icc, Prod.exists, and_assoc]

/-- **Blueprint Lemma 12.2 (`lem:coherence`)**, interval coherence: for `d ≥ 1`, fixed `s`, `λ`
and finite upper scale `J`, either no `j ∈ [j₀, J]` has its major center in `𝓡_s`, or there are
one center `α = a/q ∈ 𝓡_s` (so `s ≥ 1`), one real representative `μ` of `λ - α` with
`|μ| < 1/4`, and `b ≤ J` such that the set of these indices is the interval `[j_s, b]`,
`j_s = max(j₀, ⌈2^{s/M}⌉ - 1)`, and for each such `j`: `a/q` is admissible in `X_j` and is the
unique major center of `λ` at scale `j`, `‖λ - α‖_𝕋 = |μ| ≤ w_j`, `|μ| 2^{Dj} ≤ (j+1)^M`
(`D = 2d`), and `L_s ≤ 2^{j/2}`. -/
theorem major_coherence (hd : 1 ≤ d) (s : ℕ) (lam : ℝ) (J : ℕ) :
    majorIdx n d Ω p s lam J = ∅ ∨
      ∃ (a q : ℕ) (μ : ℝ) (b : ℕ), (a, q) ∈ liftRat s ∧ 1 ≤ s ∧ |μ| < 1 / 4 ∧
        (∃ k : ℤ, lam = a / q + μ + k) ∧ b ≤ J ∧
        majorIdx n d Ω p s lam J = Finset.Icc (coherJs n d Ω p s) b ∧
        ∀ j ∈ majorIdx n d Ω p s lam J,
          IsMajorCenter (paramM n d Ω p) j a q ∧
          (∀ a' q' : ℕ, IsMajorCenter (paramM n d Ω p) j a' q' →
            ‖((lam - a' / q' : ℝ) : UnitAddCircle)‖ ≤ minorW d (paramM n d Ω p) j →
              a' = a ∧ q' = q) ∧
          ‖((lam - a / q : ℝ) : UnitAddCircle)‖ ≤ minorW d (paramM n d Ω p) j ∧
          |μ| ≤ minorW d (paramM n d Ω p) j ∧
          |μ| * (2 : ℝ) ^ (2 * d * j) ≤ ((j : ℝ) + 1) ^ paramM n d Ω p ∧
          (liftL n d Ω p s : ℝ) ≤ (2 : ℝ) ^ ((j : ℝ) / 2) := by
  rcases (majorIdx n d Ω p s lam J).eq_empty_or_nonempty with h | hne
  · exact Or.inl h
  right
  set M := paramM n d Ω p with hMdef
  set S := majorIdx n d Ω p s lam J with hSdef
  have hspec := coherJ0_spec (n := n) (Ω := Ω) (p := p) hd
  obtain ⟨jst, hjst⟩ := hne
  obtain ⟨hj0st, hjJst, a, q, haq, hqH, hδ⟩ := mem_majorIdx.1 hjst
  obtain ⟨hs1, -, -⟩ := liftRat_bounds_of_lt_minorH haq hqH
  obtain ⟨-, hq2, ha, hc⟩ := mem_liftRat.1 haq
  have hq1 : 1 ≤ q := one_le_of_mem_liftRat haq
  set δ := ‖((lam - a / q : ℝ) : UnitAddCircle)‖ with hδdef
  have hws : ∀ j, coherJ0 n d Ω p ≤ j → 2 ^ s ≤ minorH M j →
      minorW d M j ≤ (((2 : ℝ) ^ s) ^ 2)⁻¹ / 16 := by
    intro j hj hsH
    refine ((hspec.2 j hj).1.2.2).trans ?_
    have : ((2 : ℝ) ^ s) ≤ minorH M j := by exact_mod_cast hsH
    gcongr
  have hcenter : ∀ j ∈ S, ∀ a' q' : ℕ, (a', q') ∈ liftRat s → q' < minorH M j →
      ‖((lam - a' / q' : ℝ) : UnitAddCircle)‖ ≤ minorW d M j → a' = a ∧ q' = q := by
    intro j hj a' q' h' hq'H hδ'
    obtain ⟨hj0, -, -⟩ := mem_majorIdx.1 hj
    obtain ⟨-, hsH', -⟩ := liftRat_bounds_of_lt_minorH h' hq'H
    obtain ⟨-, hsHst, -⟩ := liftRat_bounds_of_lt_minorH haq hqH
    obtain ⟨-, hq2', ha', hc'⟩ := mem_liftRat.1 h'
    have e1 := hws j hj0 hsH'
    have e2 := hws jst hj0st hsHst
    have hpos : 0 < (((2 : ℝ) ^ s) ^ 2)⁻¹ := by positivity
    refine reduced_eq_of_norm_lt (one_le_of_mem_liftRat h') ha' hc' hq1 ha hc (B := 2 ^ s)
      (by unfold liftN at hq2'; exact_mod_cast hq2') (by unfold liftN at hq2; exact_mod_cast hq2) ?_
    calc ‖(((a' : ℝ) / q' - a / q : ℝ) : UnitAddCircle)‖ ≤ minorW d M j + minorW d M jst :=
          (norm_sub_centers_le lam _ _).trans (add_le_add hδ' hδ)
      _ < 1 / ((2 : ℝ) ^ s) ^ 2 := by rw [one_div]; linarith
  have hmem : ∀ j, j ∈ S ↔ coherJs n d Ω p s ≤ j ∧ j ≤ J ∧ δ ≤ minorW d M j := by
    intro j
    constructor
    · intro hj
      obtain ⟨hj0, hjJ, a', q', h', hq'H, hδ'⟩ := mem_majorIdx.1 hj
      obtain ⟨rfl, rfl⟩ := hcenter j hj a' q' h' hq'H hδ'
      obtain ⟨-, hsH, -⟩ := liftRat_bounds_of_lt_minorH haq hq'H
      exact ⟨max_le hj0 ((two_pow_le_minorH_iff major_one_le_paramM s j).1 hsH), hjJ, hδ'⟩
    · rintro ⟨hjs, hjJ, hδj⟩
      exact mem_majorIdx.2 ⟨le_trans (le_max_left _ _) hjs, hjJ, a, q, haq,
        (isMajorCenter_of_mem_liftRat hjs haq).2.1, hδj⟩
  set b := S.max' ⟨jst, hjst⟩ with hbdef
  have hb : b ∈ S := S.max'_mem _
  obtain ⟨hbs, hbJ, hδb⟩ := (hmem b).1 hb
  have hSI : S = Finset.Icc (coherJs n d Ω p s) b := by
    ext j
    rw [Finset.mem_Icc]
    constructor
    · intro hj; exact ⟨((hmem j).1 hj).1, S.le_max' j hj⟩
    · rintro ⟨hjs, hjb⟩
      refine (hmem j).2 ⟨hjs, hjb.trans hbJ, hδb.trans ?_⟩
      exact minorW_antitone hd (le_trans (le_max_left _ _) hjs) hjb
  set μ : ℝ := lam - a / q - round (lam - a / q) with hμdef
  have hμδ : |μ| = δ := by rw [hδdef, UnitAddCircle.norm_eq]
  refine ⟨a, q, μ, b, haq, hs1, ?_, ⟨round (lam - a / q), by rw [hμdef]; ring⟩, hbJ, hSI,
    fun j hj => ?_⟩
  · rw [hμδ]; exact lt_of_le_of_lt hδ (hspec.2 jst hj0st).1.1
  obtain ⟨hjs, hjJ, hδj⟩ := (hmem j).1 hj
  have hj0 : coherJ0 n d Ω p ≤ j := le_trans (le_max_left _ _) hjs
  have hadm : IsMajorCenter M j a q := isMajorCenter_of_mem_liftRat hjs haq
  obtain ⟨-, -, hsE⟩ := liftRat_bounds_of_lt_minorH haq hadm.2.1
  refine ⟨hadm, fun a' q' h' hδ' => ?_, hδj, hμδ ▸ hδj, ?_, ?_⟩
  · obtain ⟨h1, h2⟩ := (hspec.2 j hj0).2.1 _ _ _ _ h' hadm lam hδ' hδj
    exact ⟨h1, h2⟩
  · have h1 : |μ| ≤ minorW d M j := hμδ ▸ hδj
    rw [minorW, le_div_iff₀ (by positivity)] at h1
    exact h1
  · have hv := (hspec.2 j hj0).2.2 s hs1 hsE
    rw [liftL, Nat.cast_pow, Nat.cast_ofNat, ← Real.rpow_natCast]
    exact Real.rpow_le_rpow_of_exponent_le (by norm_num) hv

/-- For Blueprint Proposition 12.3: for `j ∈ [j₀, J]`, `λ ∈ X_j` iff `j` is a major index of `λ`
for some group `s`. -/
theorem mem_minorArcs_iff_exists_majorIdx {j J : ℕ} (hj0 : coherJ0 n d Ω p ≤ j) (hjJ : j ≤ J)
    (lam : ℝ) :
    lam ∈ minorArcs d (paramM n d Ω p) j ↔ ∃ s, j ∈ majorIdx n d Ω p s lam J := by
  constructor
  · rintro ⟨q, a, hq, hqH, ha, hc, hl⟩
    obtain ⟨s, hs⟩ := exists_mem_liftRat a hq ha hc
    exact ⟨s, mem_majorIdx.2 ⟨hj0, hjJ, a, q, hs, hqH, hl⟩⟩
  · rintro ⟨s, hs⟩
    obtain ⟨-, -, a, q, haq, hqH, hl⟩ := mem_majorIdx.1 hs
    obtain ⟨-, -, ha, hc⟩ := mem_liftRat.1 haq
    exact ⟨q, a, one_le_of_mem_liftRat haq, hqH, ha, hc, hl⟩

/-- For Blueprint Proposition 12.3: a major index belongs to exactly one group `s`. -/
theorem eq_of_mem_majorIdx (hd : 1 ≤ d) {s s' : ℕ} {lam : ℝ} {J j : ℕ}
    (h : j ∈ majorIdx n d Ω p s lam J) (h' : j ∈ majorIdx n d Ω p s' lam J) : s = s' := by
  obtain ⟨hj0, -, a, q, haq, hqH, hl⟩ := mem_majorIdx.1 h
  obtain ⟨-, -, a', q', haq', hqH', hl'⟩ := mem_majorIdx.1 h'
  obtain ⟨-, -, ha, hc⟩ := mem_liftRat.1 haq
  obtain ⟨-, -, ha', hc'⟩ := mem_liftRat.1 haq'
  obtain ⟨rfl, rfl⟩ := ((coherJ0_spec hd).2 j hj0).2.1 a q a' q'
    ⟨one_le_of_mem_liftRat haq, hqH, ha, hc⟩ ⟨one_le_of_mem_liftRat haq', hqH', ha', hc'⟩ lam hl hl'
  exact eq_of_mem_liftRat haq haq'

/-! ### Blueprint Proposition 12.3 (`prop:finiteSW`) -/

section FiniteSW

open scoped ENNReal

/-- A finitely supported function on `ℤⁿ` lies in every `ℓ^q`. -/
lemma finSW_memLp {f : (Fin n → ℤ) → ℂ} (hf : (Function.support f).Finite) (q : ℝ≥0∞) :
    MemLp f q Measure.count := by
  have hb : MemLp f ∞ Measure.count := by
    refine memLp_top_of_bound AEStronglyMeasurable.of_discrete (∑ z ∈ hf.toFinset, ‖f z‖)
      (ae_of_all _ fun x => ?_)
    by_cases hx : x ∈ Function.support f
    · exact Finset.single_le_sum (f := fun z => ‖f z‖) (fun _ _ => norm_nonneg _)
        (hf.mem_toFinset.2 hx)
    · rw [Function.notMem_support.1 hx, norm_zero]
      exact Finset.sum_nonneg fun _ _ => norm_nonneg _
  exact hb.mono_exponent_of_measure_support_ne_top (s := Function.support f)
    (fun x hx => Function.notMem_support.1 hx) (Measure.count_apply_lt_top.2 hf).ne le_top

/-- The `λ`-independent smoothing-error majorant `(1 + (j+1)^M) 2^{-j/2} (B_{2^j} * |f|)(x)` of the
proof of Blueprint Proposition 12.3 (`prop:finiteSW`). -/
noncomputable def finSWErr (n M j : ℕ) (f : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) : ℝ≥0∞ :=
  ENNReal.ofReal ((1 + ((j : ℝ) + 1) ^ M) * (2 : ℝ) ^ (-((j : ℝ) / 2))) *
    ∑' y, ENNReal.ofReal (latEnvelope n (2 ^ j) y) * ‖f (x - y)‖ₑ

/-- The smoothing error of the proof of Blueprint Proposition 12.3 (`prop:finiteSW`), from
Lemma 12.1: if `λ = a/q + μ` in `𝕋`, `|μ| 2^{Dj} ≤ (j+1)^M` and `L_s ≤ 2^{j/2}`, then
`|T_{j,λ} f - Lift_{s,a/q}[Φ_{j,μ}] f| ≤ C (1 + (j+1)^M) 2^{-j/2} (B_{2^j} * |f|)` pointwise. -/
lemma finSW_kernel_error (hΩ : IsSWProfile Ω) (d : ℕ) :
    ∃ Ck : ℝ, 0 ≤ Ck ∧ ∀ (p : ℝ) (s a q : ℕ), 1 ≤ q → ∀ (j M : ℕ) (lam μ : ℝ),
      (∃ k : ℤ, lam = a / q + μ + k) → |μ| * (2 : ℝ) ^ (2 * d * j) ≤ ((j : ℝ) + 1) ^ M →
      (liftL n d Ω p s : ℝ) ≤ (2 : ℝ) ^ ((j : ℝ) / 2) →
      ∀ f : (Fin n → ℤ) → ℂ, Summable (fun z => ‖f z‖) → ∀ x,
        ‖minorOp Ω d j lam f x -
            latMult (liftSym n d Ω p s a q (radialOscPhi Ω d j μ)) f x‖ₑ ≤
          ENNReal.ofReal Ck * finSWErr n M j f x := by
  obtain ⟨C, hC, hK⟩ := major_kernel_error (n := n) hΩ d
  refine ⟨C, hC, fun p s a q hq j M lam μ hlam hμ hL f hf x => ?_⟩
  rw [major_kernel_formula hΩ p s a hq j hlam hf x, finSWErr, ← mul_assoc,
    ← ENNReal.ofReal_mul hC, ← ENNReal.tsum_mul_left]
  refine enorm_tsum_le_tsum_enorm.trans (ENNReal.tsum_le_tsum fun y => ?_)
  set U : ℝ := ((j : ℝ) + 1) ^ M with hUdef
  have hU0 : 0 ≤ U := by positivity
  have hU : |μ| * ((2 : ℝ) ^ j) ^ (2 * d) ≤ U := by
    rw [← pow_mul, mul_comm j]; exact hμ
  have hk := hK p s j μ U hU (latEmbed y)
  have hR : (0 : ℝ) < 2 ^ j := by positivity
  have hB : 0 ≤ latEnvelope n (2 ^ j) y := envelope_nonneg hR _
  have hLR : (liftL n d Ω p s : ℝ) / 2 ^ j ≤ (2 : ℝ) ^ (-((j : ℝ) / 2)) := by
    rw [div_le_iff₀ hR, ← Real.rpow_natCast, ← Real.rpow_add two_pos]
    convert hL using 2; ring
  rw [enorm_mul, enorm_mul, ← ofReal_norm (eC _), norm_eC, ENNReal.ofReal_one, one_mul,
    ← ofReal_norm, ← mul_assoc, ← ENNReal.ofReal_mul (by positivity)]
  gcongr
  calc _ ≤ C * (1 + U) * ((liftL n d Ω p s : ℝ) / 2 ^ j) * envelope n (2 ^ j) (latEmbed y) := hk
    _ ≤ C * (1 + U) * (2 : ℝ) ^ (-((j : ℝ) / 2)) * envelope n (2 ^ j) (latEmbed y) := by
        gcongr
    _ = _ := by rw [latEnvelope]; ring

/-- `ℓ^p` bound of the smoothing-error majorant (Young and the uniform lattice sum of `B_{2^j}`). -/
lemma eLpNorm_finSWErr_le {p : ℝ} (hp : 1 < p) (M j : ℕ) (f : (Fin n → ℤ) → ℂ) :
    eLpNorm (finSWErr n M j f) (ENNReal.ofReal p) Measure.count ≤
      ENNReal.ofReal ((1 + ((j : ℝ) + 1) ^ M) * (2 : ℝ) ^ (-((j : ℝ) / 2)) * envelopeConst n) *
        eLpNorm f (ENNReal.ofReal p) Measure.count := by
  have hp1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hp.le
  have hR : (0 : ℝ) < 2 ^ j := by positivity
  have hB : ∀ y, 0 ≤ latEnvelope n (2 ^ j) y := fun y => envelope_nonneg hR _
  have hk : ∀ y,
      ‖((latEnvelope n (2 ^ j) y : ℝ) : ℂ)‖ₑ = ENNReal.ofReal (latEnvelope n (2 ^ j) y) :=
    fun y => by rw [← ofReal_norm, Complex.norm_real, Real.norm_of_nonneg (hB y)]
  have e : finSWErr n M j f = fun x =>
      ENNReal.ofReal ((1 + ((j : ℝ) + 1) ^ M) * (2 : ℝ) ^ (-((j : ℝ) / 2))) *
        ∑' y, ‖((latEnvelope n (2 ^ j) y : ℝ) : ℂ)‖ₑ * ‖f (x - y)‖ₑ := by
    funext x; simp only [finSWErr, hk]
  rw [e, eLpNorm_count_const_mul _ _ (by linarith)]
  refine (mul_le_mul' le_rfl (eLpNorm_tsum_enorm_mul_sub_le hp1 _ f)).trans ?_
  rw [ENNReal.ofReal_mul (p := (1 + ((j : ℝ) + 1) ^ M) * (2 : ℝ) ^ (-((j : ℝ) / 2)))
    (by positivity), mul_assoc]
  refine mul_le_mul' le_rfl (mul_le_mul' ?_ le_rfl)
  rw [eLpNorm_one_eq_lintegral_enorm AEStronglyMeasurable.of_discrete, lintegral_count]
  obtain ⟨hs, hle⟩ := summable_latEnvelope_and_tsum_le (n := n) (R := 2 ^ j)
    (one_le_pow₀ one_le_two)
  simp only [hk]
  rw [← ENNReal.ofReal_tsum_of_nonneg hB hs]
  exact ENNReal.ofReal_le_ofReal hle

/-- The smoothing-error coefficients `(1 + (j+1)^M) 2^{-j/2}` are summable. -/
lemma finSW_summable_err (M : ℕ) :
    Summable fun j : ℕ => (1 + ((j : ℝ) + 1) ^ M) * (2 : ℝ) ^ (-((j : ℝ) / 2)) := by
  obtain ⟨r, hr⟩ : ∃ r : ℝ, r = (2 : ℝ) ^ (-(1 / 2 : ℝ)) := ⟨_, rfl⟩
  have hr0 : 0 < r := by rw [hr]; positivity
  have hr1 : r < 1 := by
    rw [hr]; exact Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by norm_num)
  have e : ∀ j : ℕ, (2 : ℝ) ^ (-((j : ℝ) / 2)) = r ^ j := by
    intro j; rw [hr, ← Real.rpow_mul_natCast (by norm_num)]; congr 1; ring
  have h1 : Summable fun j : ℕ => ((j + 1 : ℕ) : ℝ) ^ M * r ^ (j + 1) :=
    (summable_nat_add_iff (f := fun j : ℕ => (j : ℝ) ^ M * r ^ j) 1).2
      (summable_pow_mul_geometric_of_norm_lt_one M
      (by rw [Real.norm_of_nonneg hr0.le]; exact hr1))
  have h2 := summable_geometric_of_lt_one hr0.le hr1
  refine (h2.add (h1.mul_left r⁻¹)).congr fun j => ?_
  rw [e j, pow_succ]
  push_cast
  field_simp

/-- `j ↦ ⌊M log₂(j+1)⌋` is monotone. -/
lemma majorExp_mono (M : ℕ) {j j' : ℕ} (h : j ≤ j') : majorExp M j ≤ majorExp M j' := by
  unfold majorExp
  apply Nat.floor_mono
  have : (j : ℝ) ≤ j' := by exact_mod_cast h
  exact mul_le_mul_of_nonneg_left
    (Real.logb_le_logb_of_le (by norm_num) (by positivity) (by linarith)) (Nat.cast_nonneg _)

/-- The group majorant of the proof of Blueprint Proposition 12.3 (`prop:finiteSW`): `𝒫_s f` for
`s ≥ 1`, and `0` for `s = 0`. -/
noncomputable def finSWMain (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ)
    (f : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) : ℝ≥0∞ :=
  if 1 ≤ s then liftedPartialMax n d Ω p s f x else 0

open Classical in
/-- The pointwise majorant of the proof of Blueprint Proposition 12.3 (`prop:finiteSW`): for every
`λ`, `|∑_{j=j₀}^J T_{j,λ} f(x)|` is at most the sum of the minor-arc maximal functions
`sup_{λ' ∉ X_j} |T_{j,λ'} f(x)|`, the smoothing errors, and the group majorants `𝒫_s f(x)`
(a majorant independent of `λ`). -/
lemma finSW_pointwise (hn : 1 ≤ n) (hd : 1 ≤ d) (hΩ : IsSWProfile Ω) {Ck : ℝ}
    (hCk : ∀ (s a q : ℕ), 1 ≤ q → ∀ (j : ℕ) (lam μ : ℝ),
      (∃ k : ℤ, lam = a / q + μ + k) →
      |μ| * (2 : ℝ) ^ (2 * d * j) ≤ ((j : ℝ) + 1) ^ paramM n d Ω p →
      (liftL n d Ω p s : ℝ) ≤ (2 : ℝ) ^ ((j : ℝ) / 2) →
      ∀ f : (Fin n → ℤ) → ℂ, Summable (fun z => ‖f z‖) → ∀ x,
        ‖minorOp Ω d j lam f x -
            latMult (liftSym n d Ω p s a q (radialOscPhi Ω d j μ)) f x‖ₑ ≤
          ENNReal.ofReal Ck * finSWErr n (paramM n d Ω p) j f x)
    (J : ℕ) {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) (lam : ℝ) (x : Fin n → ℤ) :
    ‖∑ j ∈ Finset.Icc (coherJ0 n d Ω p) J, minorOp Ω d j lam f x‖ₑ ≤
      ∑ j ∈ Finset.Icc (coherJ0 n d Ω p) J,
          minorSup Ω d j (minorArcs d (paramM n d Ω p) j) f x +
        ∑ j ∈ Finset.Icc (coherJ0 n d Ω p) J,
          ENNReal.ofReal Ck * finSWErr n (paramM n d Ω p) j f x +
        ∑' s, finSWMain n d Ω p s f x := by
  set M := paramM n d Ω p with hMdef
  set A := Finset.Icc (coherJ0 n d Ω p) J with hAdef
  set N := minorH M J + 1 with hNdef
  have hj1 : 1 ≤ coherJ0 n d Ω p := (one_le_paramJ1 hn hd hΩ p).trans (coherJ0_spec hd).1
  have hMaj : A.filter (fun j => lam ∈ minorArcs d M j) =
      (Finset.range N).biUnion (fun s => majorIdx n d Ω p s lam J) := by
    ext j
    simp only [Finset.mem_filter, Finset.mem_biUnion, Finset.mem_range]
    constructor
    · rintro ⟨hjA, hl⟩
      obtain ⟨hj0, hjJ⟩ := Finset.mem_Icc.1 hjA
      obtain ⟨s, hs⟩ := (mem_minorArcs_iff_exists_majorIdx hj0 hjJ lam).1 hl
      refine ⟨s, ?_, hs⟩
      obtain ⟨-, -, a, q, haq, hqH, -⟩ := mem_majorIdx.1 hs
      obtain ⟨-, h2, -⟩ := liftRat_bounds_of_lt_minorH haq hqH
      have h3 : minorH M j ≤ minorH M J := by
        rw [minorH_eq_two_pow, minorH_eq_two_pow]
        exact Nat.pow_le_pow_right (by norm_num) (majorExp_mono M hjJ)
      have h2' : 2 ^ s ≤ minorH M j := h2
      have := Nat.lt_two_pow_self (n := s)
      omega
    · rintro ⟨s, -, hs⟩
      obtain ⟨hj0, hjJ, -⟩ := mem_majorIdx.1 hs
      exact ⟨Finset.mem_Icc.2 ⟨hj0, hjJ⟩,
        (mem_minorArcs_iff_exists_majorIdx hj0 hjJ lam).2 ⟨s, hs⟩⟩
  have hdisj : (↑(Finset.range N) : Set ℕ).PairwiseDisjoint
      (fun s => majorIdx n d Ω p s lam J) := by
    intro s _ s' _ hne
    exact Finset.disjoint_left.2 fun j h h' => hne (eq_of_mem_majorIdx hd h h')
  have hgroup : ∀ s, ‖∑ j ∈ majorIdx n d Ω p s lam J, minorOp Ω d j lam f x‖ₑ ≤
      ∑ j ∈ majorIdx n d Ω p s lam J, ENNReal.ofReal Ck * finSWErr n M j f x +
        finSWMain n d Ω p s f x := by
    intro s
    rcases major_coherence (n := n) (Ω := Ω) (p := p) hd s lam J with
      h | ⟨a, q, μ, b, haq, hs1, -, hlam, -, hI, hprop⟩
    · rw [h, Finset.sum_empty, Finset.sum_empty, enorm_zero]; exact zero_le
    have hq : 1 ≤ q := one_le_of_mem_liftRat haq
    have hsplit : ∑ j ∈ majorIdx n d Ω p s lam J, minorOp Ω d j lam f x =
        ∑ j ∈ majorIdx n d Ω p s lam J, (minorOp Ω d j lam f x -
          latMult (liftSym n d Ω p s a q (radialOscPhi Ω d j μ)) f x) +
        ∑ j ∈ Finset.Icc (coherJs n d Ω p s) b,
          latMult (liftSym n d Ω p s a q (radialOscPhi Ω d j μ)) f x := by
      rw [← hI, ← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun j _ => by ring
    rw [hsplit]
    refine (enorm_add_le _ _).trans (add_le_add ?_ ?_)
    · refine (enorm_sum_le _ _).trans (Finset.sum_le_sum fun j hj => ?_)
      obtain ⟨-, -, -, -, hμj, hLj⟩ := hprop j hj
      exact hCk s a q hq j lam μ hlam hμj hLj f hf x
    · by_cases hab : coherJs n d Ω p s ≤ b
      · have hlin : ∑ j ∈ Finset.Icc (coherJs n d Ω p s) b,
            latMult (liftSym n d Ω p s a q (radialOscPhi Ω d j μ)) f x =
            latMult (liftSym n d Ω p s a q (fun ξ => ∑ j ∈ Finset.Icc (coherJs n d Ω p s) b,
              radialOscPhi Ω d j μ ξ)) f x :=
          (latMult_liftSym_finsetSum _ (m := fun j : ℕ => radialOscPhi Ω d j μ)
            (fun j => (continuous_radialOscPhi_and_le hΩ j μ).1)
            (fun j ξ => (continuous_radialOscPhi_and_le hΩ j μ).2 ξ) hf x).symm
        rw [hlin]; simp only [finSWMain, hs1, ↓reduceIte]
        exact le_iSup₂_of_le (a, q) haq (le_iSup_of_le μ (le_iSup_of_le (coherJs n d Ω p s)
          (le_iSup_of_le b (le_iSup_of_le ⟨hj1.trans (le_max_left _ _), hab⟩ le_rfl))))
      · rw [Finset.Icc_eq_empty hab, Finset.sum_empty, enorm_zero]; exact zero_le
  have hA := Finset.sum_filter_add_sum_filter_not A (fun j => lam ∈ minorArcs d M j)
    (fun j => minorOp Ω d j lam f x)
  rw [← hA]
  refine (enorm_add_le _ _).trans ?_
  have hmaj : ‖∑ j ∈ A.filter (fun j => lam ∈ minorArcs d M j), minorOp Ω d j lam f x‖ₑ ≤
      ∑ j ∈ A, ENNReal.ofReal Ck * finSWErr n M j f x + ∑' s, finSWMain n d Ω p s f x := by
    rw [hMaj, Finset.sum_biUnion hdisj]
    refine (enorm_sum_le _ _).trans ((Finset.sum_le_sum fun s _ => hgroup s).trans ?_)
    rw [Finset.sum_add_distrib, ← Finset.sum_biUnion hdisj, ← hMaj]
    exact add_le_add (Finset.sum_le_sum_of_subset (Finset.filter_subset _ _))
      (ENNReal.sum_le_tsum _)
  have hmin : ‖∑ j ∈ A.filter (fun j => lam ∉ minorArcs d M j), minorOp Ω d j lam f x‖ₑ ≤
      ∑ j ∈ A, minorSup Ω d j (minorArcs d M j) f x := by
    refine (enorm_sum_le _ _).trans ((Finset.sum_le_sum fun j hj => ?_).trans
      (Finset.sum_le_sum_of_subset (Finset.filter_subset _ _)))
    exact le_iSup₂_of_le (f := fun (l : ℝ) (_ : l ∉ minorArcs d M j) => ‖minorOp Ω d j l f x‖ₑ)
      lam (Finset.mem_filter.1 hj).2 le_rfl
  calc _ ≤ (∑ j ∈ A, ENNReal.ofReal Ck * finSWErr n M j f x + ∑' s, finSWMain n d Ω p s f x) +
        ∑ j ∈ A, minorSup Ω d j (minorArcs d M j) f x := add_le_add hmaj hmin
    _ = _ := by ring

/-- `ℓ^p` bound of the group majorant: `‖𝒫_s f‖_p ≤ C ρ^s ‖f‖_p`, `ρ = 2^{-c}` (Theorem 11.3). -/
lemma eLpNorm_finSWMain_le (hn : 1 ≤ n) (hd : 1 ≤ d) (hΩ : IsSWProfile Ω) (hp : 1 < p) :
    ∃ c : ℝ, 0 < c ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ s : ℕ, ∀ f : (Fin n → ℤ) → ℂ,
      (Function.support f).Finite →
        eLpNorm (finSWMain n d Ω p s f) (ENNReal.ofReal p) Measure.count ≤
          ENNReal.ofReal (C * ((2 : ℝ) ^ (-c)) ^ s) *
            eLpNorm f (ENNReal.ofReal p) Measure.count := by
  obtain ⟨c, hc, C, hC, hP⟩ := lift_partial_sums hn hd hΩ hp
  refine ⟨c, hc, C, hC, fun s f hf => ?_⟩
  by_cases hs : 1 ≤ s
  · have e : finSWMain n d Ω p s f = liftedPartialMax n d Ω p s f := by
      funext x; simp only [finSWMain, hs, ↓reduceIte]
    rw [e, ← Real.rpow_natCast, ← Real.rpow_mul (by norm_num), neg_mul]
    exact hP s hs f hf
  · have e : finSWMain n d Ω p s f = 0 := by
      funext x; simp only [finSWMain, hs, ↓reduceIte, Pi.zero_apply]
    rw [e, eLpNorm_zero]; exact zero_le

/-- **Blueprint Proposition 12.3 (`prop:finiteSW`)**, uniform finite dyadic estimate, eq. (12.2)
(`eq:finiteSW`): for `n, d ≥ 1`, an admissible profile `Ω` and `1 < p < ∞`, with the final lower
scale `j₀ = coherJ0 n d Ω p` of Lemma 12.2, there is `C_p ≥ 0` such that for every integer
`J ≥ j₀` and every finitely supported `f : ℤⁿ → ℂ`,
`‖sup_{λ ∈ 𝕋} |∑_{j=j₀}^J T_{j,λ} f|‖_{ℓ^p} ≤ C_p ‖f‖_{ℓ^p}`
(`C_p` independent of `J` and `f`; the supremum is over `λ ∈ ℝ`, which is the same as over `𝕋`
since `T_{j,λ}` is `1`-periodic in `λ`). -/
theorem finite_dyadic_stein_wainger (hn : 1 ≤ n) (hd : 1 ≤ d) (hΩ : IsSWProfile Ω)
    (hp : 1 < p) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ J ≥ coherJ0 n d Ω p, ∀ f : (Fin n → ℤ) → ℂ,
      (Function.support f).Finite →
        eLpNorm (fun x => ⨆ lam : ℝ,
            ‖∑ j ∈ Finset.Icc (coherJ0 n d Ω p) J, minorOp Ω d j lam f x‖ₑ)
            (ENNReal.ofReal p) Measure.count ≤
          ENNReal.ofReal C * eLpNorm f (ENNReal.ofReal p) Measure.count := by
  obtain ⟨Cm, hCm, hmin⟩ := minor_arc_decay_lp hn hd hΩ hp
  obtain ⟨Ck, hCk, herr⟩ := finSW_kernel_error (n := n) hΩ d
  obtain ⟨c, hc, CP, hCP, hP⟩ := eLpNorm_finSWMain_le hn hd hΩ hp
  set M := paramM n d Ω p with hMdef
  set j₀ := coherJ0 n d Ω p with hj₀
  set ρ : ℝ := (2 : ℝ) ^ (-c) with hρ
  have hρ0 : 0 ≤ ρ := by positivity
  have hρ1 : ρ < 1 := Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by linarith)
  have hsum1 : Summable fun j : ℕ => (j : ℝ) ^ (-2 : ℝ) := Real.summable_nat_rpow.2 (by norm_num)
  have hsum2 := finSW_summable_err M
  set S1 := ∑' j : ℕ, (j : ℝ) ^ (-2 : ℝ) with hS1def
  set S2 := ∑' j : ℕ, (1 + ((j : ℝ) + 1) ^ M) * (2 : ℝ) ^ (-((j : ℝ) / 2)) with hS2def
  have hS1 : 0 ≤ S1 := tsum_nonneg fun j => by positivity
  have hS2 : 0 ≤ S2 := tsum_nonneg fun j => by positivity
  have hE0 : 0 ≤ envelopeConst n := by unfold envelopeConst; positivity
  have hρ' : 0 ≤ (1 - ρ)⁻¹ := inv_nonneg.2 (by linarith)
  refine ⟨Cm * S1 + Ck * envelopeConst n * S2 + CP * (1 - ρ)⁻¹, by positivity,
    fun J hJ f hf => ?_⟩
  set nf := eLpNorm f (ENNReal.ofReal p) Measure.count with hnf
  have hp1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hp.le
  have hf1 : Summable fun z => ‖f z‖ := summable_of_finite_support hf
  have hfL := finSW_memLp hf (ENNReal.ofReal p)
  set A := Finset.Icc j₀ J with hAdef
  set G1 : (Fin n → ℤ) → ℝ≥0∞ := ∑ j ∈ A, fun x => minorSup Ω d j (minorArcs d M j) f x
    with hG1
  set G2 : (Fin n → ℤ) → ℝ≥0∞ := ∑ j ∈ A, fun x => ENNReal.ofReal Ck * finSWErr n M j f x
    with hG2
  set G3 : (Fin n → ℤ) → ℝ≥0∞ := fun x => ∑' s, finSWMain n d Ω p s f x with hG3
  have hpt : ∀ x, ‖⨆ lam : ℝ, ‖∑ j ∈ A, minorOp Ω d j lam f x‖ₑ‖ₑ ≤ ‖(G1 + G2 + G3) x‖ₑ := by
    intro x
    rw [enorm_eq_self, enorm_eq_self]
    simp only [hG1, hG2, hG3, Pi.add_apply, Finset.sum_apply]
    exact iSup_le fun lam => finSW_pointwise hn hd hΩ
      (fun s a q hq j lam μ hlam hμ hL f hf x => herr p s a q hq j M lam μ hlam hμ hL f hf x)
      J hf1 lam x
  have h1 : eLpNorm G1 (ENNReal.ofReal p) Measure.count ≤ ENNReal.ofReal (Cm * S1) * nf := by
    refine (eLpNorm_sum_le hp1).trans ?_
    calc ∑ j ∈ A, eLpNorm (fun x => minorSup Ω d j (minorArcs d M j) f x)
          (ENNReal.ofReal p) Measure.count
        ≤ ∑ j ∈ A, ENNReal.ofReal (Cm * (j : ℝ) ^ (-2 : ℝ)) * nf :=
          Finset.sum_le_sum fun j hj =>
            hmin j ((coherJ0_spec hd).1.trans (Finset.mem_Icc.1 hj).1) f hfL
      _ = ENNReal.ofReal (∑ j ∈ A, Cm * (j : ℝ) ^ (-2 : ℝ)) * nf := by
          rw [← Finset.sum_mul, ENNReal.ofReal_sum_of_nonneg (fun j _ => by positivity)]
      _ ≤ _ := by
          gcongr
          rw [← Finset.mul_sum]
          gcongr
          exact hsum1.sum_le_tsum A (fun j _ => by positivity)
  have h2 : eLpNorm G2 (ENNReal.ofReal p) Measure.count ≤
      ENNReal.ofReal (Ck * envelopeConst n * S2) * nf := by
    refine (eLpNorm_sum_le hp1).trans ?_
    calc ∑ j ∈ A, eLpNorm (fun x => ENNReal.ofReal Ck * finSWErr n M j f x)
          (ENNReal.ofReal p) Measure.count
        ≤ ∑ j ∈ A, ENNReal.ofReal (Ck * envelopeConst n *
            ((1 + ((j : ℝ) + 1) ^ M) * (2 : ℝ) ^ (-((j : ℝ) / 2)))) * nf := by
          refine Finset.sum_le_sum fun j _ => ?_
          rw [eLpNorm_count_const_mul _ _ (by linarith)]
          refine (mul_le_mul' le_rfl (eLpNorm_finSWErr_le hp M j f)).trans (le_of_eq ?_)
          rw [← mul_assoc, ← ENNReal.ofReal_mul hCk]
          congr 2; ring
      _ = ENNReal.ofReal (∑ j ∈ A, Ck * envelopeConst n *
            ((1 + ((j : ℝ) + 1) ^ M) * (2 : ℝ) ^ (-((j : ℝ) / 2)))) * nf := by
          rw [← Finset.sum_mul, ENNReal.ofReal_sum_of_nonneg (fun j _ => by positivity)]
      _ ≤ _ := by
          gcongr
          rw [← Finset.mul_sum]
          gcongr
          exact hsum2.sum_le_tsum A (fun j _ => by positivity)
  have h3 : eLpNorm G3 (ENNReal.ofReal p) Measure.count ≤
      ENNReal.ofReal (CP * (1 - ρ)⁻¹) * nf := by
    refine (eLpNorm_tsum_le_count hp1 ENNReal.ofReal_ne_top _).trans ?_
    refine (ENNReal.tsum_le_tsum fun s => hP s f hf).trans (le_of_eq ?_)
    rw [ENNReal.tsum_mul_right, ← ENNReal.ofReal_tsum_of_nonneg (fun s => by positivity)
      ((summable_geometric_of_lt_one hρ0 hρ1).mul_left _), tsum_mul_left,
      tsum_geometric_of_lt_one hρ0 hρ1]
  calc eLpNorm (fun x => ⨆ lam : ℝ, ‖∑ j ∈ A, minorOp Ω d j lam f x‖ₑ)
        (ENNReal.ofReal p) Measure.count
      ≤ eLpNorm (G1 + G2 + G3) (ENNReal.ofReal p) Measure.count :=
        eLpNorm_mono_enorm AEStronglyMeasurable.of_discrete hpt
    _ ≤ eLpNorm G1 (ENNReal.ofReal p) Measure.count +
          eLpNorm G2 (ENNReal.ofReal p) Measure.count +
          eLpNorm G3 (ENNReal.ofReal p) Measure.count :=
        (eLpNorm_add_le hp1).trans (add_le_add (eLpNorm_add_le hp1) le_rfl)
    _ ≤ ENNReal.ofReal (Cm * S1) * nf + ENNReal.ofReal (Ck * envelopeConst n * S2) * nf +
          ENNReal.ofReal (CP * (1 - ρ)⁻¹) * nf := by gcongr
    _ = _ := by
        rw [ENNReal.ofReal_add (by positivity) (by positivity),
          ENNReal.ofReal_add (by positivity) (by positivity)]
        ring

end FiniteSW

end MajorArcs

section DiscreteSteinWainger

/-!
## The discrete Stein–Wainger maximal operator

Formalization of the blueprint `blueprints/discrete-sw.tex`
("The discrete Stein–Wainger maximal operator: the combined `ℓ^p` bound, `1 < p < ∞`").

Results from §13 ("The operator on all of `ℓ^p` and the final theorem").

### Main results

* `absolute_convergence_and_parameter_continuity`: Blueprint Lemma 13.1 (`lem:absolute`), with
  eq. (13.1) (`eq:pointwisecontinuity`);
* `eLpNorm_swMax_le_of_finite_support`: the finite-support case of Theorem 13.2;
* `discrete_stein_wainger_lp`: Blueprint Theorem 13.2 (`thm:main`), eq. (13.2) (`eq:MAIN`).

### Proof outline

* The restricted kernel `swLatKernel Ω` (`y ↦ K(y)`, `K(0) = 0`) is in `ℓ^{p'}` since
  `|K(y)| ≤ B |y|^{-n}` (`exists_norm_swKernel_le_div`) and `∑_{y} |y|^{-r} < ∞` for `r > n`
  (`summable_norm_latEmbed_rpow`, from Mathlib's `ZLattice.summable_norm_rpow`); Hölder
  (`tsum_enorm_mul_enorm_sub_le`) gives absolute convergence and (13.1).
* Finite support: by telescoping (`sum_Icc_dyadicKernel`), at `|y| ≤ 2^J` one has
  `K(y) = k_init(y) + ∑_{j=j₀}^{J} K_j(y)` with `k_init(y) = η(2^{1-j₀} y) K(y)`
  (`swInitKernel`, which equals `η K + ∑_{1 ≤ j < j₀} K_j` and has finite support); so
  `T_λ f(x) = ∑_y e(λP(y)) k_init(y) f(x-y) + ∑_{j=j₀}^{J} T_{j,λ} f(x)` for all `λ` once `J` is
  large (`swOp_eq_init_add_minor`). The first part is bounded by `|k_init| * |f|`
  (`eLpNorm_init_le`), the second by Proposition 12.3 (`finite_dyadic_stein_wainger`), and a
  Fatou-type argument over finite sets of points (`eLpNorm_le_of_eventually_le`) concludes.
* General `f ∈ ℓ^p`: truncations to lattice boxes, pointwise convergence of the maximal
  functions from (13.1) (`abs_swMax_sub_le`) and Fatou (`eLpNorm_le_of_tendsto_of_eLpNorm_le`).
-/

open MeasureTheory Filter Topology Set
open scoped ENNReal NNReal

variable {n d : ℕ} {Ω : EuclideanSpace ℝ (Fin n) → ℂ}

/-- Helper: the decay bound `|K(x)| ≤ B |x|^{-n}` for `x ≠ 0`. -/
lemma exists_norm_swKernel_le_div (hΩ : IsSWProfile Ω) :
    ∃ B : ℝ, 0 ≤ B ∧ ∀ x : EuclideanSpace ℝ (Fin n), x ≠ 0 → ‖swKernel Ω x‖ ≤ B / ‖x‖ ^ n := by
  obtain ⟨C, hC⟩ := (isCompact_sphere (0 : EuclideanSpace ℝ (Fin n)) 1).exists_bound_of_continuousOn
    (hΩ.1.continuousOn.mono fun y hy => by
      simp only [mem_sphere_zero_iff_norm] at hy
      simp only [mem_compl_iff, mem_singleton_iff]
      rintro rfl; simp at hy)
  refine ⟨max C 0, le_max_right _ _, fun x hx => ?_⟩
  have hpos : 0 < ‖x‖ := norm_pos_iff.2 hx
  have hmem : ‖x‖⁻¹ • x ∈ Metric.sphere (0 : EuclideanSpace ℝ (Fin n)) 1 := by
    simp [norm_smul, hpos.ne']
  have hΩx : Ω x = Ω (‖x‖⁻¹ • x) := (hΩ.2.1 x hx _ (inv_pos.2 hpos)).symm
  simp only [swKernel, hx, ↓reduceIte]
  rw [norm_div, hΩx]
  simp only [Complex.norm_real, Real.norm_eq_abs, abs_of_pos (pow_pos hpos n)]
  gcongr
  exact (hC _ hmem).trans (le_max_left _ _)

/-- Helper: the integer lattice as a `ℤ`-lattice in `E`. -/
noncomputable abbrev latL (n : ℕ) : Submodule ℤ (EuclideanSpace ℝ (Fin n)) :=
  Submodule.span ℤ (Set.range (EuclideanSpace.basisFun (Fin n) ℝ).toBasis)

/-- Helper: `ι y` lies in the lattice `latL n`. -/
lemma latEmbed_mem_latL (y : Fin n → ℤ) : latEmbed y ∈ latL n := by
  have : latEmbed y = ∑ i, (y i) • (EuclideanSpace.basisFun (Fin n) ℝ).toBasis i := by
    ext j
    simp [Finset.sum_apply, Pi.single_apply]
  rw [this]
  exact Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)


/-- Helper: `∑_{y ∈ ℤⁿ} |y|^r < ∞` for `r < -n` (the term at `0` is `0^r = 0`). -/
lemma summable_norm_latEmbed_rpow {r : ℝ} (hr : r < -n) :
    Summable fun y : Fin n → ℤ => ‖latEmbed y‖ ^ r := by
  have hrank : Module.finrank ℤ (latL n) = n := by
    rw [ZLattice.rank ℝ (latL n)]
    exact finrank_euclideanSpace_fin
  have hs : Summable fun z : latL n => ‖z‖ ^ r :=
    ZLattice.summable_norm_rpow (latL n) r (by rw [hrank]; exact hr)
  have hinj :
      Function.Injective (fun y : Fin n → ℤ => (⟨latEmbed y, latEmbed_mem_latL y⟩ : latL n)) :=
    fun y z h => latEmbed_injective (congrArg Subtype.val h)
  have h2 : Summable ((fun z : latL n => ‖z‖ ^ r) ∘ fun y : Fin n → ℤ =>
      (⟨latEmbed y, latEmbed_mem_latL y⟩ : latL n)) := Summable.comp_injective hs hinj
  exact h2


/-- Helper: `K(ι 0) = 0`. -/
lemma swKernel_latEmbed_zero : swKernel Ω (latEmbed (0 : Fin n → ℤ)) = 0 := by
  have : latEmbed (0 : Fin n → ℤ) = 0 := by ext i; simp
  simp [this, swKernel]

/-- Helper: `∑_{y} |K(y)|^r < ∞` for every real `r > 1`. -/
lemma summable_norm_swKernel_latEmbed_rpow (hΩ : IsSWProfile Ω) {r : ℝ} (hr : 1 < r) :
    Summable fun y : Fin n → ℤ => ‖swKernel Ω (latEmbed y)‖ ^ r := by
  obtain ⟨B, hB0, hB⟩ := exists_norm_swKernel_le_div (n := n) hΩ
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · exact Summable.of_finite
  have hs := (summable_norm_latEmbed_rpow (n := n) (r := -((n : ℝ) * r))
    (by nlinarith [(Nat.one_le_cast (α := ℝ)).2 hn])).mul_left (B ^ r)
  refine hs.of_nonneg_of_le (fun _ => Real.rpow_nonneg (norm_nonneg _) _) fun y => ?_
  by_cases hy : y = 0
  · subst hy
    rw [swKernel_latEmbed_zero, norm_zero, Real.zero_rpow (by linarith)]
    exact mul_nonneg (Real.rpow_nonneg hB0 _) (Real.rpow_nonneg (norm_nonneg _) _)
  have hy' : latEmbed y ≠ 0 := fun h => hy (latEmbed_injective (by rw [h]; ext i; simp))
  have hpos : 0 < ‖latEmbed y‖ := norm_pos_iff.2 hy'
  calc ‖swKernel Ω (latEmbed y)‖ ^ r ≤ (B / ‖latEmbed y‖ ^ n) ^ r :=
        Real.rpow_le_rpow (norm_nonneg _) (hB _ hy') (by linarith)
    _ = B ^ r * ‖latEmbed y‖ ^ (-((n : ℝ) * r)) := by
        rw [Real.div_rpow hB0 (by positivity), ← Real.rpow_natCast, ← Real.rpow_mul hpos.le,
          Real.rpow_neg hpos.le, div_eq_mul_inv]

/-- Helper: Hölder's inequality on `ℤⁿ` in the convolution form
`∑_y |k(y)| |f(x - y)| ≤ ‖k‖_{q} ‖f‖_{p}` (`1/p + 1/q = 1`). -/
lemma tsum_enorm_mul_enorm_sub_le {p q : ℝ} (hpq : p.HolderConjugate q)
    (k f : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) :
    ∑' y, ‖k y‖ₑ * ‖f (x - y)‖ₑ ≤
      eLpNorm k (ENNReal.ofReal q) Measure.count * eLpNorm f (ENNReal.ofReal p) Measure.count := by
  have h := ENNReal.lintegral_mul_le_Lp_mul_Lq (Measure.count : Measure (Fin n → ℤ)) hpq.symm
    (f := fun y => ‖k y‖ₑ) (g := fun y => ‖f (x - y)‖ₑ) (measurable_of_countable _).aemeasurable
    (measurable_of_countable _).aemeasurable
  simp only [lintegral_count, Pi.mul_apply] at h
  have ht : ∑' y, ‖f (x - y)‖ₑ ^ p = ∑' y, ‖f y‖ₑ ^ p :=
    (Equiv.subLeft x).tsum_eq (fun y => ‖f y‖ₑ ^ p)
  rw [ht] at h
  refine h.trans (le_of_eq ?_)
  rw [← eLpNorm_enorm k AEStronglyMeasurable.of_discrete,
    ← eLpNorm_enorm f AEStronglyMeasurable.of_discrete, eLpNorm_count_ennreal_eq _ hpq.symm.pos,
    eLpNorm_count_ennreal_eq _ hpq.pos]


/-- The restricted lattice kernel `K 𝟙_{G ∖ {0}}`: `y ↦ K(ι y)` (it vanishes at `y = 0`). -/
noncomputable def swLatKernel (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (y : Fin n → ℤ) : ℂ :=
  swKernel Ω (latEmbed y)

/-- Helper: the restricted kernel lies in `ℓ^q(G)` for every real `q > 1`. -/
lemma memLp_swLatKernel (hΩ : IsSWProfile Ω) {q : ℝ} (hq : 1 < q) :
    MemLp (swLatKernel Ω) (ENNReal.ofReal q) Measure.count := by
  rw [memLp_iff, ← eLpNorm_enorm _ AEStronglyMeasurable.of_discrete,
    eLpNorm_count_ennreal_eq _ (by linarith)]
  have hs : Summable fun y => ‖swLatKernel Ω y‖ ^ q := summable_norm_swKernel_latEmbed_rpow hΩ hq
  have : ∑' y, ‖swLatKernel Ω y‖ₑ ^ q = ENNReal.ofReal (∑' y, ‖swLatKernel Ω y‖ ^ q) := by
    rw [ENNReal.ofReal_tsum_of_nonneg (fun _ => Real.rpow_nonneg (norm_nonneg _) _) hs]
    congr 1; funext y
    rw [← ofReal_norm, ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) (by linarith)]
  rw [this]
  exact ENNReal.rpow_lt_top_of_nonneg (by positivity) ENNReal.ofReal_ne_top

/-- Helper: the summand at `y = 0` vanishes. -/
lemma swTerm_zero_right (lam : ℝ) (f : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) :
    swTerm n d Ω lam f x 0 = 0 := by
  simp [swTerm, swKernel_latEmbed_zero]

/-- Helper: `|e(λP(y)) K(y) f(x-y)| = |K(y)| |f(x-y)|`. -/
lemma norm_swTerm (lam : ℝ) (f : (Fin n → ℤ) → ℂ) (x y : Fin n → ℤ) :
    ‖swTerm n d Ω lam f x y‖ = ‖swLatKernel Ω y‖ * ‖f (x - y)‖ := by
  simp [swTerm, swLatKernel, norm_eC]

/-- Helper: extended-norm form of `norm_swTerm`. -/
lemma enorm_swTerm (lam : ℝ) (f : (Fin n → ℤ) → ℂ) (x y : Fin n → ℤ) :
    ‖swTerm n d Ω lam f x y‖ₑ = ‖swLatKernel Ω y‖ₑ * ‖f (x - y)‖ₑ := by
  rw [← ofReal_norm, norm_swTerm, ENNReal.ofReal_mul (norm_nonneg _),
    ofReal_norm, ofReal_norm]

/-- Helper: `T_λ f(x)` as a sum over all of `G` (the term at `y = 0` vanishes). -/
lemma swOp_eq_tsum (lam : ℝ) (f : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) :
    swOp n d Ω lam f x = ∑' y, swTerm n d Ω lam f x y := by
  have hs : Function.support (swTerm n d Ω lam f x) ⊆ {y | y ≠ 0} := by
    intro y hy h
    exact hy (by rw [h]; exact swTerm_zero_right lam f x)
  exact tsum_subtype_eq_of_support_subset hs

/-- Helper (Hölder, Lemma 13.1): `|T_λ f(x)| ≤ ∑_y |K(y)| |f(x-y)| ≤ ‖K‖_{p'} ‖f‖_p`. -/
lemma enorm_swOp_le {p q : ℝ} (hpq : p.HolderConjugate q) (lam : ℝ) (f : (Fin n → ℤ) → ℂ)
    (x : Fin n → ℤ) :
    ‖swOp n d Ω lam f x‖ₑ ≤
      eLpNorm (swLatKernel Ω) (ENNReal.ofReal q) Measure.count *
        eLpNorm f (ENNReal.ofReal p) Measure.count := by
  rw [swOp_eq_tsum]
  refine enorm_tsum_le_tsum_enorm.trans ?_
  simp_rw [enorm_swTerm]
  exact tsum_enorm_mul_enorm_sub_le hpq _ f x

/-- Helper: absolute summability of `y ↦ e(λP(y)) K(y) f(x-y)` for `f ∈ ℓ^p`, `p > 1`. -/
lemma summable_norm_swTerm (hΩ : IsSWProfile Ω) {p : ℝ} (hp : 1 < p) {f : (Fin n → ℤ) → ℂ}
    (hf : MemLp f (ENNReal.ofReal p) Measure.count) (lam : ℝ) (x : Fin n → ℤ) :
    Summable fun y => ‖swTerm n d Ω lam f x y‖ := by
  have hpq := Real.HolderConjugate.conjExponent hp
  have hK := memLp_swLatKernel hΩ hpq.symm.lt
  have h := tsum_enorm_mul_enorm_sub_le hpq (swLatKernel Ω) f x
  have hfin : ∑' y, (‖swTerm n d Ω lam f x y‖₊ : ℝ≥0∞) ≠ ∞ := by
    refine ne_top_of_le_ne_top (ENNReal.mul_ne_top hK.eLpNorm_ne_top hf.eLpNorm_ne_top) ?_
    refine le_trans (le_of_eq ?_) h
    congr 1; funext y
    rw [← enorm_swTerm (d := d) lam f x y]
    rfl
  have := NNReal.summable_coe.2 (ENNReal.tsum_coe_ne_top_iff_summable.1 hfin)
  simpa using this


/-- Helper: each summand `e(λP(y)) K(y) f(x-y)` is `1`-periodic (indeed `ℤ`-periodic) in `λ`. -/
lemma swTerm_add_int (lam : ℝ) (k : ℤ) (f : (Fin n → ℤ) → ℂ) (x y : Fin n → ℤ) :
    swTerm n d Ω (lam + k) f x y = swTerm n d Ω lam f x y := by
  simp only [swTerm]
  rw [show (lam + k) * (radialPolyZ n d y : ℝ) =
      lam * radialPolyZ n d y + ((k * radialPolyZ n d y : ℤ) : ℝ) by push_cast; ring,
    eC_add, eC_intCast, mul_one]

/-- Helper: `T_{λ+k} f = T_λ f` for `k ∈ ℤ`. -/
lemma swOp_add_int (lam : ℝ) (k : ℤ) (f : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) :
    swOp n d Ω (lam + k) f x = swOp n d Ω lam f x := by
  simp only [swOp, swTerm_add_int]

/-- Helper: each summand is continuous in `λ`. -/
lemma continuous_swTerm (f : (Fin n → ℤ) → ℂ) (x y : Fin n → ℤ) :
    Continuous fun lam : ℝ => swTerm n d Ω lam f x y := by
  unfold swTerm eC
  fun_prop

/-- **Blueprint Lemma 13.1 (`lem:absolute`)**, absolute convergence and the scalar supremum:
for `1 < p < ∞` (with dual exponent `p' = p/(p-1)`):
* the restricted kernel `K 𝟙_{G ∖ {0}}` (`swLatKernel Ω`, `y ↦ K(y)` with `K(0) = 0`) belongs to
  `ℓ^{p'}(G)`;
* for `f ∈ ℓ^p(G)` and each `x ∈ G`, the series `T_λ f(x) = ∑_{y ≠ 0} e(λP(y)) K(y) f(x-y)` is
  absolutely convergent, and its finite partial sums converge uniformly in `λ ∈ ℝ`;
* `λ ↦ T_λ f(x)` is continuous and `1`-periodic; `|T_λ f(x)|` is bounded in `λ` and attains its
  maximum over `ℝ` at a point of `[0, 1]` (i.e. on `𝕋`); the supremum `𝒞 f(x) = sup_λ |T_λ f(x)|`
  equals the supremum over rational parameters;
* eq. (13.1) (`eq:pointwisecontinuity`): `sup_λ |T_λ (f - g)(x)| ≤ ‖K‖_{ℓ^{p'}(G ∖ 0)} ‖f - g‖_p`
  (stated for arbitrary `f, g`; it is trivial unless the right side is finite). -/
theorem absolute_convergence_and_parameter_continuity (hΩ : IsSWProfile Ω) {p : ℝ} (hp : 1 < p) :
    MemLp (swLatKernel Ω) (ENNReal.ofReal p.conjExponent) Measure.count ∧
    (∀ f : (Fin n → ℤ) → ℂ, MemLp f (ENNReal.ofReal p) Measure.count → ∀ x : Fin n → ℤ,
      (∀ lam : ℝ, Summable fun y : {y : Fin n → ℤ // y ≠ 0} => ‖swTerm n d Ω lam f x y‖) ∧
      TendstoUniformly (fun (s : Finset {y : Fin n → ℤ // y ≠ 0}) (lam : ℝ) =>
          ∑ y ∈ s, swTerm n d Ω lam f x y) (fun lam => swOp n d Ω lam f x) atTop ∧
      Continuous (fun lam => swOp n d Ω lam f x) ∧
      Function.Periodic (fun lam => swOp n d Ω lam f x) 1 ∧
      BddAbove (Set.range fun lam : ℝ => ‖swOp n d Ω lam f x‖) ∧
      (∃ lam₀ ∈ Set.Icc (0 : ℝ) 1, ∀ lam : ℝ, ‖swOp n d Ω lam f x‖ ≤ ‖swOp n d Ω lam₀ f x‖) ∧
      swMax n d Ω f x = ⨆ r : ℚ, ‖swOp n d Ω (r : ℝ) f x‖) ∧
    ∀ (f g : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ),
      ENNReal.ofReal (swMax n d Ω (f - g) x) ≤
        eLpNorm (swLatKernel Ω) (ENNReal.ofReal p.conjExponent) Measure.count *
          eLpNorm (f - g) (ENNReal.ofReal p) Measure.count := by
  have hpq := Real.HolderConjugate.conjExponent hp
  refine ⟨memLp_swLatKernel hΩ hpq.symm.lt, fun f hf x => ?_, fun f g x => ?_⟩
  · set T : ℝ → ℂ := fun lam => swOp n d Ω lam f x with hT
    have hsum : Summable fun y : Fin n → ℤ => ‖swLatKernel Ω y‖ * ‖f (x - y)‖ := by
      simpa only [norm_swTerm] using summable_norm_swTerm (d := d) hΩ hp hf 0 x
    have hu := hsum.subtype {y | y ≠ 0}
    have hbound : ∀ (y : {y : Fin n → ℤ // y ≠ 0}) (lam : ℝ),
        ‖swTerm n d Ω lam f x y‖ ≤ ‖swLatKernel Ω y‖ * ‖f (x - y)‖ :=
      fun y lam => le_of_eq (norm_swTerm lam f x y)
    have hcont : Continuous T :=
      continuous_tsum (fun y => continuous_swTerm f x y) hu hbound
    obtain ⟨lam₀, hlam₀, hmax⟩ := isCompact_Icc.exists_isMaxOn
      (Set.nonempty_Icc.2 (zero_le_one' ℝ)) hcont.norm.continuousOn
    have hmax' : ∀ lam, ‖T lam‖ ≤ ‖T lam₀‖ := by
      intro lam
      have e : T lam = T (Int.fract lam) := by
        rw [hT]
        dsimp only
        rw [← swOp_add_int (Int.fract lam) ⌊lam⌋, Int.fract_add_floor]
      rw [e]
      exact hmax ⟨Int.fract_nonneg lam, (Int.fract_lt_one lam).le⟩
    have hbdd : BddAbove (Set.range fun lam => ‖T lam‖) := ⟨‖T lam₀‖, by
      rintro _ ⟨lam, rfl⟩; exact hmax' lam⟩
    have hbddQ : BddAbove (Set.range fun r : ℚ => ‖T r‖) := ⟨‖T lam₀‖, by
      rintro _ ⟨r, rfl⟩; exact hmax' r⟩
    refine ⟨fun lam => (summable_norm_swTerm hΩ hp hf lam x).subtype _,
      tendstoUniformly_tsum hu hbound, hcont, fun lam => ?_, hbdd, ⟨lam₀, hlam₀, hmax'⟩, ?_⟩
    · simpa using swOp_add_int (d := d) (Ω := Ω) lam 1 f x
    · have h1 : swMax n d Ω f x = ‖T lam₀‖ :=
        le_antisymm (ciSup_le hmax') (le_ciSup hbdd lam₀)
      rw [h1]
      refine le_antisymm ?_ (ciSup_le fun r => hmax' r)
      exact Rat.denseRange_cast.induction_on (p := fun b => ‖T b‖ ≤ ⨆ r : ℚ, ‖T r‖) lam₀
        (isClosed_le hcont.norm continuous_const) (fun r => le_ciSup hbddQ r)
  · set c := eLpNorm (swLatKernel Ω) (ENNReal.ofReal p.conjExponent) Measure.count *
      eLpNorm (f - g) (ENNReal.ofReal p) Measure.count
    by_cases hc : c = ∞
    · rw [hc]; exact le_top
    rw [ENNReal.ofReal_le_iff_le_toReal hc]
    refine ciSup_le fun lam => ?_
    have := enorm_swOp_le (d := d) (Ω := Ω) hpq lam (f - g) x
    rw [← ofReal_norm] at this
    exact (ENNReal.ofReal_le_iff_le_toReal hc).1 this


/-! ### The initial kernel and the finite dyadic sums -/

/-- Helper: `K_m(x) = (η(2^{-m} x) - η(2^{1-m} x)) K(x)`. -/
lemma dyadicKernel_eq_sub (m : ℤ) (z : EuclideanSpace ℝ (Fin n)) :
    dyadicKernel Ω m z =
      ((dyadicEta ((2 : ℝ) ^ (-m) • z) - dyadicEta ((2 : ℝ) ^ (1 - m) • z) : ℝ) : ℂ) *
        swKernel Ω z := by
  rw [dyadicKernel, dyadicPsi, smul_smul,
    show (2 : ℝ) * 2 ^ (-m) = 2 ^ (1 - m) by
      rw [sub_eq_add_neg, zpow_add₀ two_ne_zero, zpow_one], mul_comm]

/-- Helper (telescoping, Lemma 4.1): `∑_{j=j₀}^{J} K_j(x) = (η(2^{-J} x) - η(2^{1-j₀} x)) K(x)`. -/
lemma sum_Icc_dyadicKernel (z : EuclideanSpace ℝ (Fin n)) {j₀ J : ℕ} (hJ : j₀ ≤ J) :
    ∑ j ∈ Finset.Icc j₀ J, dyadicKernel Ω (j : ℤ) z =
      ((dyadicEta ((2 : ℝ) ^ (-(J : ℤ)) • z) - dyadicEta ((2 : ℝ) ^ (1 - (j₀ : ℤ)) • z) : ℝ) : ℂ) *
        swKernel Ω z := by
  induction J, hJ using Nat.le_induction with
  | base => rw [Finset.Icc_self, Finset.sum_singleton, dyadicKernel_eq_sub]
  | succ J hJ ih =>
    rw [Finset.sum_Icc_succ_top (by omega), ih, dyadicKernel_eq_sub,
      show (1 : ℤ) - ((J + 1 : ℕ) : ℤ) = -(J : ℤ) by push_cast; ring]
    push_cast
    ring

/-- Helper: for `|x| ≤ 2^J` and `j₀ ≤ J`, `K(x) = η(2^{1-j₀} x) K(x) + ∑_{j=j₀}^{J} K_j(x)`. -/
lemma swKernel_eq_init_add_sum (z : EuclideanSpace ℝ (Fin n)) {j₀ J : ℕ} (hJ : j₀ ≤ J)
    (hz : ‖z‖ ≤ 2 ^ J) :
    swKernel Ω z = ((dyadicEta ((2 : ℝ) ^ (1 - (j₀ : ℤ)) • z) : ℝ) : ℂ) * swKernel Ω z +
      ∑ j ∈ Finset.Icc j₀ J, dyadicKernel Ω (j : ℤ) z := by
  have h1 : dyadicEta ((2 : ℝ) ^ (-(J : ℤ)) • z) = 1 := by
    apply dyadicEta_eq_one
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (by positivity), zpow_neg, zpow_natCast,
      inv_mul_le_iff₀ (by positivity), mul_one]
    exact hz
  rw [sum_Icc_dyadicKernel z hJ, h1]
  push_cast
  ring

/-- The initial kernel `k_init(y) = η(y)K(y) + ∑_{1 ≤ j < j₀} K_j(y) = η(2^{1-j₀} y) K(y)` of the
proof of Theorem 13.2 (the second form by telescoping; it also covers `j₀ = 0`). -/
noncomputable def swInitKernel (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (j₀ : ℕ) (y : Fin n → ℤ) : ℂ :=
  ((dyadicEta ((2 : ℝ) ^ (1 - (j₀ : ℤ)) • latEmbed y) : ℝ) : ℂ) * swKernel Ω (latEmbed y)

/-- Helper: `k_init` is supported in the finite box `|y|_∞ ≤ 2^{j₀}`. -/
lemma swInitKernel_eq_zero {j₀ : ℕ} {y : Fin n → ℤ} (hy : y ∉ latBox n (2 ^ j₀)) :
    swInitKernel Ω j₀ y = 0 := by
  simp only [latBox, Set.mem_ofPred_eq, not_forall, not_le] at hy
  obtain ⟨i, hi⟩ := hy
  have hi' : (2 : ℝ) ^ j₀ < ‖latEmbed y‖ := by
    calc (2 : ℝ) ^ j₀ < |(y i : ℝ)| := by exact_mod_cast hi
      _ = ‖latEmbed y i‖ := by simp
      _ ≤ ‖latEmbed y‖ := PiLp.norm_apply_le _ _
  rw [swInitKernel, dyadicEta_eq_zero, Complex.ofReal_zero, zero_mul]
  rw [norm_smul, Real.norm_eq_abs, abs_of_pos (by positivity)]
  have h2 : (2 : ℝ) ^ (1 - (j₀ : ℤ)) * (2 : ℝ) ^ j₀ = 2 := by
    rw [← zpow_natCast, ← zpow_add₀ two_ne_zero]; simp
  have hpos : (0 : ℝ) < 2 ^ (1 - (j₀ : ℤ)) := by positivity
  nlinarith


/-- Helper: `|e(t) a b| = |a| |b|`. -/
lemma enorm_eC_mul_mul (t : ℝ) (a b : ℂ) : ‖eC t * a * b‖ₑ = ‖a‖ₑ * ‖b‖ₑ := by
  have : ‖eC t‖ₑ = 1 := by rw [← ofReal_norm, norm_eC, ENNReal.ofReal_one]
  rw [enorm_mul, enorm_mul, this, one_mul]

/-- Helper: for finitely supported `f`, `x ∈ G`, `j₀ ≤ J` and `|x - z| ≤ 2^J` on the support of
`f`, `T_λ f(x) = ∑_y e(λP(y)) k_init(y) f(x-y) + ∑_{j=j₀}^{J} T_{j,λ} f(x)` for every `λ`. -/
lemma swOp_eq_init_add_minor {f : (Fin n → ℤ) → ℂ} (hf : (Function.support f).Finite)
    (x : Fin n → ℤ) {j₀ J : ℕ} (hJ : j₀ ≤ J)
    (hxJ : ∀ z ∈ hf.toFinset, ‖latEmbed (x - z)‖ ≤ 2 ^ J) (lam : ℝ) :
    swOp n d Ω lam f x =
      ∑ y ∈ (latBox_finite n (2 ^ j₀)).toFinset,
          eC (lam * (radialPolyZ n d y : ℝ)) * swInitKernel Ω j₀ y * f (x - y) +
        ∑ j ∈ Finset.Icc j₀ J, minorOp Ω d j lam f x := by
  set Fx := hf.toFinset.image (fun z => x - z) with hFx
  have hF : ∀ y ∉ Fx, f (x - y) = 0 := by
    intro y hy
    by_contra h
    exact hy (Finset.mem_image.2 ⟨x - y, hf.mem_toFinset.2 h, sub_sub_cancel x y⟩)
  rw [swOp_eq_tsum, tsum_eq_sum (s := Fx) (fun y hy => by simp [swTerm, hF y hy])]
  have hmin : ∀ j : ℕ, minorOp Ω d j lam f x = ∑ y ∈ Fx,
      eC (lam * (radialPolyZ n d y : ℝ)) * dyadicKernel Ω j (latEmbed y) * f (x - y) :=
    fun j => tsum_eq_sum (fun y hy => by simp [hF y hy])
  have hI : ∑ y ∈ (latBox_finite n (2 ^ j₀)).toFinset,
        eC (lam * (radialPolyZ n d y : ℝ)) * swInitKernel Ω j₀ y * f (x - y) =
      ∑ y ∈ Fx, eC (lam * (radialPolyZ n d y : ℝ)) * swInitKernel Ω j₀ y * f (x - y) := by
    set g : (Fin n → ℤ) → ℂ := fun y =>
      eC (lam * (radialPolyZ n d y : ℝ)) * swInitKernel Ω j₀ y * f (x - y) with hg
    have h1 : ∑' y, g y = ∑ y ∈ (latBox_finite n (2 ^ j₀)).toFinset, g y := by
      refine tsum_eq_sum (fun y hy => ?_)
      rw [hg]; dsimp only
      rw [swInitKernel_eq_zero (fun h => hy ((latBox_finite n (2 ^ j₀)).mem_toFinset.2 h)),
        mul_zero, zero_mul]
    have h2 : ∑' y, g y = ∑ y ∈ Fx, g y := tsum_eq_sum (fun y hy => by simp [hg, hF y hy])
    exact h1.symm.trans h2
  simp_rw [hmin]
  rw [hI, Finset.sum_comm, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun y _ => ?_
  by_cases hy : f (x - y) = 0
  · simp [swTerm, hy]
  have hy' : ‖latEmbed y‖ ≤ 2 ^ J := by
    have := hxJ (x - y) (hf.mem_toFinset.2 hy)
    rwa [sub_sub_cancel] at this
  have e := swKernel_eq_init_add_sum (Ω := Ω) (latEmbed y) hJ hy'
  simp only [swTerm, swInitKernel]
  rw [← Finset.sum_mul, ← Finset.mul_sum]
  conv_lhs => rw [e]
  ring

/-- Helper: `ℓ^p` bound for the initial part, `‖∑_y |k_init(y)| |f(· - y)|‖_p ≤ ‖k_init‖₁ ‖f‖_p`
(`k_init` has finite support). -/
lemma eLpNorm_init_le {p : ℝ} (hp : 1 < p) (S : Finset (Fin n → ℤ)) (k f : (Fin n → ℤ) → ℂ) :
    eLpNorm (fun x => ∑ y ∈ S, ‖k y‖ₑ * ‖f (x - y)‖ₑ) (ENNReal.ofReal p) Measure.count ≤
      ENNReal.ofReal (∑ y ∈ S, ‖k y‖) * eLpNorm f (ENNReal.ofReal p) Measure.count := by
  have hp1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hp.le
  have htr : ∀ y, eLpNorm (fun x => ‖f (x - y)‖ₑ) (ENNReal.ofReal p) Measure.count =
      eLpNorm f (ENNReal.ofReal p) Measure.count := by
    intro y
    rw [← eLpNorm_enorm f AEStronglyMeasurable.of_discrete,
      eLpNorm_count_ennreal_eq _ (by linarith),
      eLpNorm_count_ennreal_eq _ (by linarith)]
    congr 1
    exact (Equiv.subRight y).tsum_eq (fun z => ‖‖f z‖ₑ‖ₑ ^ p)
  have e : (fun x => ∑ y ∈ S, ‖k y‖ₑ * ‖f (x - y)‖ₑ) =
      ∑ y ∈ S, fun x => ‖k y‖ₑ * ‖f (x - y)‖ₑ := by
    funext x; simp [Finset.sum_apply]
  rw [e]
  refine (eLpNorm_sum_le hp1).trans (le_of_eq ?_)
  simp_rw [eLpNorm_count_const_mul _ _ (by linarith : (0 : ℝ) < p), htr]
  rw [← Finset.sum_mul, ENNReal.ofReal_sum_of_nonneg (fun _ _ => norm_nonneg _)]
  simp_rw [ofReal_norm]

/-- Helper (Fatou for eventual pointwise majorants on `G`): if `M ≤ F_J` pointwise for all large
`J` (depending on the point) and eventually `‖F_J‖_p ≤ B`, then `‖M‖_p ≤ B`. -/
lemma eLpNorm_le_of_eventually_le {p : ℝ} (hp : 0 < p) (M : (Fin n → ℤ) → ℝ≥0∞)
    (F : ℕ → (Fin n → ℤ) → ℝ≥0∞) (B : ℝ≥0∞)
    (hF : ∀ᶠ J in atTop, eLpNorm (F J) (ENNReal.ofReal p) Measure.count ≤ B)
    (hM : ∀ x, ∀ᶠ J in atTop, M x ≤ F J x) :
    eLpNorm M (ENNReal.ofReal p) Measure.count ≤ B := by
  apply eLpNorm_count_le_of_tsum_rpow_le hp
  rw [ENNReal.tsum_eq_iSup_sum]
  refine iSup_le fun S => ?_
  obtain ⟨J, hJB, hJ⟩ := (hF.and ((Filter.eventually_all_finset S).2 fun x _ => hM x)).exists
  calc ∑ x ∈ S, M x ^ p ≤ ∑ x ∈ S, F J x ^ p :=
        Finset.sum_le_sum fun x hx => ENNReal.rpow_le_rpow (hJ x hx) hp.le
    _ ≤ ∑' x, F J x ^ p := ENNReal.sum_le_tsum S
    _ ≤ B ^ p := tsum_rpow_le_of_eLpNorm_count_le hp hJB


/-- Helper: `0 ≤ 𝒞 f(x)`. -/
lemma swMax_nonneg (f : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) : 0 ≤ swMax n d Ω f x :=
  Real.iSup_nonneg fun _ => norm_nonneg _

/-- The finite-support case of Theorem 13.2 (`thm:main`): for `n, d ≥ 1`, admissible `Ω` and
`1 < p < ∞` there is `C ≥ 0` with `‖𝒞 f‖_p ≤ C ‖f‖_p` for every finitely supported `f`. -/
theorem eLpNorm_swMax_le_of_finite_support (hn : 1 ≤ n) (hd : 1 ≤ d) (hΩ : IsSWProfile Ω)
    {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ f : (Fin n → ℤ) → ℂ, (Function.support f).Finite →
      eLpNorm (swMax n d Ω f) (ENNReal.ofReal p) Measure.count ≤
        ENNReal.ofReal C * eLpNorm f (ENNReal.ofReal p) Measure.count := by
  obtain ⟨C₁, hC₁, hfin⟩ := finite_dyadic_stein_wainger hn hd hΩ hp
  set j₀ := coherJ0 n d Ω p with hj₀
  set S := (latBox_finite n (2 ^ j₀)).toFinset with hS
  set A := ∑ y ∈ S, ‖swInitKernel Ω j₀ y‖ with hA
  have hA0 : 0 ≤ A := Finset.sum_nonneg fun _ _ => norm_nonneg _
  have hp1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hp.le
  refine ⟨A + C₁, by positivity, fun f hf => ?_⟩
  set F : ℕ → (Fin n → ℤ) → ℝ≥0∞ := fun J =>
    (fun x => ∑ y ∈ S, ‖swInitKernel Ω j₀ y‖ₑ * ‖f (x - y)‖ₑ) +
      (fun x => ⨆ lam : ℝ, ‖∑ j ∈ Finset.Icc j₀ J, minorOp Ω d j lam f x‖ₑ) with hFdef
  rw [← eLpNorm_enorm (swMax n d Ω f) AEStronglyMeasurable.of_discrete]
  apply eLpNorm_le_of_eventually_le (by linarith) _ F
  · filter_upwards [eventually_ge_atTop j₀] with J hJ
    refine (eLpNorm_add_le hp1).trans ?_
    calc _ ≤ ENNReal.ofReal A * eLpNorm f (ENNReal.ofReal p) Measure.count +
          ENNReal.ofReal C₁ * eLpNorm f (ENNReal.ofReal p) Measure.count :=
          add_le_add (eLpNorm_init_le hp S _ f) (hfin J hJ f hf)
      _ = _ := by rw [ENNReal.ofReal_add hA0 hC₁, add_mul]
  · intro x
    have hev : ∀ᶠ J in atTop, j₀ ≤ J ∧ ∀ z ∈ hf.toFinset, ‖latEmbed (x - z)‖ ≤ 2 ^ J :=
      (eventually_ge_atTop j₀).and ((Filter.eventually_all_finset _).2 fun z _ =>
        (tendsto_pow_atTop_atTop_of_one_lt one_lt_two).eventually_ge_atTop _)
    filter_upwards [hev] with J hJx
    obtain ⟨hJ, hxJ⟩ := hJx
    by_cases htop : F J x = ∞
    · rw [htop]; exact le_top
    rw [Real.enorm_eq_ofReal (swMax_nonneg f x), ENNReal.ofReal_le_iff_le_toReal htop]
    refine ciSup_le fun lam => ?_
    rw [← ENNReal.ofReal_le_iff_le_toReal htop, ofReal_norm,
      swOp_eq_init_add_minor hf x hJ hxJ lam]
    refine (enorm_add_le _ _).trans (add_le_add ?_
      (le_iSup (fun lam => ‖∑ j ∈ Finset.Icc j₀ J, minorOp Ω d j lam f x‖ₑ) lam))
    exact (enorm_sum_le _ _).trans (Finset.sum_le_sum fun y _ => le_of_eq (enorm_eC_mul_mul _ _ _))


/-- Helper: `𝒞 g(x) ≤ 𝒞 f(x) + ‖K‖_{p'} ‖g - f‖_p` for `f, g ∈ ℓ^p` (from (13.1) and linearity). -/
lemma swMax_le_swMax_add (hΩ : IsSWProfile Ω) {p : ℝ} (hp : 1 < p) {f g : (Fin n → ℤ) → ℂ}
    (hf : MemLp f (ENNReal.ofReal p) Measure.count) (hg : MemLp g (ENNReal.ofReal p) Measure.count)
    (x : Fin n → ℤ) :
    swMax n d Ω g x ≤ swMax n d Ω f x +
      (eLpNorm (swLatKernel Ω) (ENNReal.ofReal p.conjExponent) Measure.count *
        eLpNorm (g - f) (ENNReal.ofReal p) Measure.count).toReal := by
  have hpq := Real.HolderConjugate.conjExponent hp
  have hK := memLp_swLatKernel hΩ hpq.symm.lt
  have hgf := hg.sub hf
  have hc : eLpNorm (swLatKernel Ω) (ENNReal.ofReal p.conjExponent) Measure.count *
      eLpNorm (g - f) (ENNReal.ofReal p) Measure.count ≠ ∞ :=
    ENNReal.mul_ne_top hK.eLpNorm_ne_top hgf.eLpNorm_ne_top
  have hbdd := ((absolute_convergence_and_parameter_continuity (d := d) hΩ hp).2.1 f hf x).2.2.2.2.1
  refine ciSup_le fun lam => ?_
  have hlin : swOp n d Ω lam g x = swOp n d Ω lam f x + swOp n d Ω lam (g - f) x := by
    rw [swOp_eq_tsum, swOp_eq_tsum, swOp_eq_tsum,
      ← (summable_norm_swTerm hΩ hp hf lam x).of_norm.tsum_add
        (summable_norm_swTerm hΩ hp hgf lam x).of_norm]
    congr 1; funext y
    simp only [swTerm, Pi.sub_apply]
    ring
  have h2 : ‖swOp n d Ω lam (g - f) x‖ ≤
      (eLpNorm (swLatKernel Ω) (ENNReal.ofReal p.conjExponent) Measure.count *
        eLpNorm (g - f) (ENNReal.ofReal p) Measure.count).toReal := by
    rw [← ENNReal.ofReal_le_iff_le_toReal hc, ofReal_norm]
    exact enorm_swOp_le hpq lam (g - f) x
  rw [hlin]
  exact (norm_add_le _ _).trans (add_le_add (le_ciSup hbdd lam) h2)

/-- Helper: `|𝒞 g(x) - 𝒞 f(x)| ≤ ‖K‖_{p'} ‖g - f‖_p` for `f, g ∈ ℓ^p`. -/
lemma abs_swMax_sub_le (hΩ : IsSWProfile Ω) {p : ℝ} (hp : 1 < p) {f g : (Fin n → ℤ) → ℂ}
    (hf : MemLp f (ENNReal.ofReal p) Measure.count) (hg : MemLp g (ENNReal.ofReal p) Measure.count)
    (x : Fin n → ℤ) :
    |swMax n d Ω g x - swMax n d Ω f x| ≤
      (eLpNorm (swLatKernel Ω) (ENNReal.ofReal p.conjExponent) Measure.count *
        eLpNorm (g - f) (ENNReal.ofReal p) Measure.count).toReal := by
  have h1 := swMax_le_swMax_add (d := d) hΩ hp hf hg x
  have h2 := swMax_le_swMax_add (d := d) hΩ hp hg hf x
  rw [eLpNorm_sub_comm f g] at h2
  rw [abs_sub_le_iff]
  constructor <;> linarith

/-- **Blueprint Theorem 13.2 (`thm:main`)**, the combined discrete Stein–Wainger bound, eq. (13.2)
(`eq:MAIN`): let `n, d ≥ 1`, let `Ω` be smooth on `E ∖ {0}`, homogeneous of degree zero, with
integral zero on `S^{n-1}` (`IsSWProfile Ω`), `K(y) = Ω(y)|y|^{-n}` for `y ≠ 0` and
`P(y) = (y₁² + ⋯ + yₙ²)^d`. For every real `1 < p < ∞` there is a finite constant
`C = C_{p,n,d,Ω} ≥ 0` such that for all `f ∈ ℓ^p(ℤⁿ)`:
the series `T_λ f(x) = ∑_{y ∈ ℤⁿ ∖ {0}} e(λP(y)) K(y) f(x-y)` converges (absolutely, Lemma 13.1)
for all `λ ∈ ℝ` and `x`, the family `λ ↦ |T_λ f(x)|` is bounded (so the scalar supremum
`𝒞 f(x) = sup_{λ ∈ ℝ} |T_λ f(x)|` is a genuine supremum), `𝒞 f ∈ ℓ^p`, and
`‖sup_{λ ∈ ℝ} |T_λ f|‖_{ℓ^p} ≤ C ‖f‖_{ℓ^p}`. -/
theorem discrete_stein_wainger_lp {n d : ℕ} (hn : 1 ≤ n) (hd : 1 ≤ d)
    {Ω : EuclideanSpace ℝ (Fin n) → ℂ} (hΩ : IsSWProfile Ω) {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ f : (Fin n → ℤ) → ℂ, MemLp f (ENNReal.ofReal p) Measure.count →
      (∀ (lam : ℝ) (x : Fin n → ℤ), Summable fun y : {y : Fin n → ℤ // y ≠ 0} =>
        swTerm n d Ω lam f x y) ∧
      (∀ x, BddAbove (Set.range fun lam : ℝ => ‖swOp n d Ω lam f x‖)) ∧
      MemLp (swMax n d Ω f) (ENNReal.ofReal p) Measure.count ∧
      eLpNorm (swMax n d Ω f) (ENNReal.ofReal p) Measure.count ≤
        ENNReal.ofReal C * eLpNorm f (ENNReal.ofReal p) Measure.count := by
  obtain ⟨C, hC, hfin⟩ := eLpNorm_swMax_le_of_finite_support hn hd hΩ hp
  refine ⟨C, hC, fun f hf => ?_⟩
  have hpq := Real.HolderConjugate.conjExponent hp
  have hK := memLp_swLatKernel hΩ hpq.symm.lt
  have hbound : eLpNorm (swMax n d Ω f) (ENNReal.ofReal p) Measure.count ≤
      ENNReal.ofReal C * eLpNorm f (ENNReal.ofReal p) Measure.count := by
    have hfR : ∀ R : ℕ, MemLp ((latBox n R).indicator f) (ENNReal.ofReal p) Measure.count :=
      fun R => finSW_memLp (support_indicator_latBox_finite n R f) _
    refine eLpNorm_le_of_tendsto_of_eLpNorm_le
      (u := fun R : ℕ => swMax n d Ω ((latBox n R).indicator f))
      (fun R => AEStronglyMeasurable.of_discrete) (ae_of_all _ fun x => ?_) (fun R => ?_)
    · have ht := eLpNorm_sub_indicator_latBox_tendsto ENNReal.ofReal_ne_top hf
      have hc : Tendsto (fun R : ℕ =>
          (eLpNorm (swLatKernel Ω) (ENNReal.ofReal p.conjExponent) Measure.count *
            eLpNorm ((latBox n R).indicator f - f) (ENNReal.ofReal p) Measure.count).toReal)
          atTop (𝓝 0) := by
        simp_rw [eLpNorm_sub_comm _ f]
        have h1 := ENNReal.Tendsto.const_mul ht (Or.inr hK.eLpNorm_ne_top)
        rw [mul_zero] at h1
        have h2 := (ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp h1
        exact h2
      rw [tendsto_iff_norm_sub_tendsto_zero]
      exact squeeze_zero (fun _ => norm_nonneg _)
        (fun R => abs_swMax_sub_le (d := d) hΩ hp hf (hfR R) x) hc
    · refine (hfin _ (support_indicator_latBox_finite n R f)).trans ?_
      gcongr
      exact eLpNorm_indicator_le f (latBox_finite n R).measurableSet
  refine ⟨fun lam x => (summable_norm_swTerm hΩ hp hf lam x).of_norm.subtype _,
    fun x => ((absolute_convergence_and_parameter_continuity (d := d) hΩ hp).2.1 f hf x).2.2.2.2.1,
    memLp_iff.2 (lt_of_le_of_lt hbound
      (ENNReal.mul_lt_top ENNReal.ofReal_lt_top hf.eLpNorm_lt_top)),
    hbound⟩

end DiscreteSteinWainger

