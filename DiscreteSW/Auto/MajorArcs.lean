      ‖z‖ * ‖liftPhi n d Ω p s z‖ ≤ K * (liftL n d Ω p s : ℝ) * envelope n (liftL n d Ω p s) z := by
  obtain ⟨K, hK, hKb⟩ := exists_schwartz_decay (arithPhiS n) (n + 2)
  refine ⟨K, hK, fun d Ω p s z => ?_⟩
  have hL := liftL_pos (n := n) (d := d) (Ω := Ω) (p := p) s
  set L : ℝ := (liftL n d Ω p s : ℝ)
  rw [arith_liftPhi_eq_dilateL]
  have h1 := norm_dilateL_le (fun x => (hKb x).1) hL z
  set t : ℝ := ‖z‖ / L with ht
  have ht0 : 0 ≤ t := by positivity
  have hz : ‖z‖ = L * t := by rw [ht]; field_simp
  rw [envelope, hz]
  calc L * t * ‖dilateL (⇑(arithPhiS n)) L z‖
      ≤ L * t * (K * ((L ^ n)⁻¹ * ((1 + t) ^ (n + 2))⁻¹)) := by
        gcongr
    _ = K * L * ((L ^ n)⁻¹ * ((1 + t) ^ (n + 1))⁻¹) * (t / (1 + t)) := by
        field_simp; ring
    _ ≤ K * L * ((L ^ n)⁻¹ * ((1 + t) ^ (n + 1))⁻¹) * 1 := by
        gcongr
        rw [div_le_one (by positivity)]; linarith
    _ = _ := by rw [mul_one, ← hz, ← ht]

