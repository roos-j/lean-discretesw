namespace Auto

open Finset

variable {n : ℕ}

/-! ### Block products -/

/-- `Q_A = ∏_{q ∈ A} q` (with `Q_∅ = 1`) of Blueprint Definition 7.1 (`def:blocks`). -/
def blockProd (A : Finset ℕ) : ℕ := ∏ q ∈ A, q

/-- `q_* = max(2, max S)` of Blueprint Definition 7.1 (`def:blocks`). -/
def blockStar (S : Finset ℕ) : ℕ := max 2 (S.sup id)

lemma blockProd_pos {A : Finset ℕ} (hA : ∀ q ∈ A, 1 < q) : 0 < blockProd A :=
  Finset.prod_pos fun q hq => lt_trans Nat.zero_lt_one (hA q hq)

/-- The instance needed to form finite sets of points of `T[Q_S]`. -/
lemma neZero_blockProd {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q) : NeZero (blockProd S) :=
  ⟨(blockProd_pos hS1).ne'⟩

lemma dvd_blockProd {A : Finset ℕ} {q : ℕ} (hq : q ∈ A) : q ∣ blockProd A :=
  Finset.dvd_prod_of_mem _ hq

lemma blockProd_dvd_blockProd {A B : Finset ℕ} (h : A ⊆ B) : blockProd A ∣ blockProd B :=
  Finset.prod_dvd_prod_of_subset _ _ _ h

lemma two_le_blockStar (S : Finset ℕ) : 2 ≤ blockStar S := le_max_left _ _

lemma le_blockStar {S : Finset ℕ} {q : ℕ} (hq : q ∈ S) : q ≤ blockStar S :=
  le_trans (Finset.le_sup (f := id) hq) (le_max_right _ _)

lemma blockProd_le_pow {S A : Finset ℕ} (hA : A ⊆ S) : blockProd A ≤ blockStar S ^ A.card :=
  Finset.prod_le_pow_card _ _ _ fun _ hq => le_blockStar (hA hq)

lemma coprime_blockProd {S A : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime) {q : ℕ}
    (hq : q ∈ S) (hA : A ⊆ S) (hqA : q ∉ A) : Nat.Coprime q (blockProd A) :=
  Nat.Coprime.prod_right fun _ hp => hS hq (hA hp) (fun h => hqA (h ▸ hp))

lemma blockProd_dvd_of_forall_dvd {S A : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    (hA : A ⊆ S) {m : ℕ} (h : ∀ q ∈ A, q ∣ m) : blockProd A ∣ m := by
  induction A using Finset.induction_on with
  | empty => simp [blockProd]
  | insert a A haA ih =>
    rw [blockProd, Finset.prod_insert haA]
    have hA' : A ⊆ S := fun x hx => hA (Finset.mem_insert_of_mem hx)
    exact Nat.Coprime.mul_dvd_of_dvd_of_dvd
      (coprime_blockProd hS (hA (Finset.mem_insert_self a A)) hA' haA)
      (h a (Finset.mem_insert_self a A))
      (ih hA' fun q hq => h q (Finset.mem_insert_of_mem hq))

lemma blockProd_erase_mul {A : Finset ℕ} {q : ℕ} (hq : q ∈ A) :
    q * blockProd (A.erase q) = blockProd A := Finset.mul_prod_erase A id hq

/-! ### Reduction modulo a block -/

/-- Reduction of `x ∈ T[Q]` modulo `q` (coordinatewise `ZMod.cast`), used to read off block
components. -/
def blockRed (q : ℕ) {Q : ℕ} (x : Fin n → ZMod Q) : Fin n → ZMod q := fun i => (x i).cast

/-- Reduction modulo `q ∣ Q` as an additive homomorphism. -/
def blockRedHom {q Q : ℕ} (h : q ∣ Q) : (Fin n → ZMod Q) →+ (Fin n → ZMod q) :=
  (ZMod.castHom h (ZMod q)).toAddMonoidHom.compLeft (Fin n)

lemma blockRedHom_apply {q Q : ℕ} (h : q ∣ Q) (x : Fin n → ZMod Q) :
    blockRedHom h x = blockRed q x := rfl

lemma cast_eq_zero_iff_dvd_val {q Q : ℕ} [NeZero Q] (y : ZMod Q) :
    ((y.cast : ZMod q) = 0) ↔ q ∣ y.val := by
  rw [← ZMod.natCast_val, ZMod.natCast_eq_zero_iff]

lemma eq_zero_of_forall_cast_eq_zero {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] (y : ZMod (blockProd S)) (h : ∀ q ∈ S, (y.cast : ZMod q) = 0) :
    y = 0 := by
  have hd : blockProd S ∣ y.val := blockProd_dvd_of_forall_dvd hS subset_rfl fun q hq =>
    (cast_eq_zero_iff_dvd_val y).1 (h q hq)
  rw [← ZMod.val_eq_zero]
  exact Nat.eq_zero_of_dvd_of_lt hd (ZMod.val_lt y)

/-- A point of `T[Q_S]` all of whose reductions modulo the blocks vanish is zero. -/
lemma eq_zero_of_forall_blockRed {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] (x : Fin n → ZMod (blockProd S))
    (h : ∀ q ∈ S, blockRed q x = 0) : x = 0 := by
  funext i
  exact eq_zero_of_forall_cast_eq_zero hS (x i) fun q hq => congrFun (h q hq) i

/-- Points of `T[Q_S]` are determined by their reductions modulo the blocks. -/
lemma ext_blockRed {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {x y : Fin n → ZMod (blockProd S)}
    (h : ∀ q ∈ S, blockRed q x = blockRed q y) : x = y := by
  rw [← sub_eq_zero]
  refine eq_zero_of_forall_blockRed hS _ fun q hq => ?_
  rw [← blockRedHom_apply (dvd_blockProd hq), map_sub, blockRedHom_apply, blockRedHom_apply,
    h q hq, sub_self]


lemma blockRed_add {q Q : ℕ} (h : q ∣ Q) (x y : Fin n → ZMod Q) :
    blockRed q (x + y) = blockRed q x + blockRed q y := map_add (blockRedHom h) x y

lemma blockRed_neg {q Q : ℕ} (h : q ∣ Q) (x : Fin n → ZMod Q) :
    blockRed q (-x) = -blockRed q x := map_neg (blockRedHom h) x

lemma blockRed_sub {q Q : ℕ} (h : q ∣ Q) (x y : Fin n → ZMod Q) :
    blockRed q (x - y) = blockRed q x - blockRed q y := map_sub (blockRedHom h) x y

lemma blockRed_zero {q Q : ℕ} (h : q ∣ Q) : blockRed q (0 : Fin n → ZMod Q) = 0 :=
  map_zero (blockRedHom h)

lemma blockRed_nsmul {q Q : ℕ} (h : q ∣ Q) (d : ℕ) (x : Fin n → ZMod Q) :
    blockRed q (d • x) = d • blockRed q x := map_nsmul (blockRedHom h) d x

lemma blockRed_zsmul {q Q : ℕ} (h : q ∣ Q) (d : ℤ) (x : Fin n → ZMod Q) :
    blockRed q (d • x) = d • blockRed q x := map_zsmul (blockRedHom h) d x

lemma blockRed_sum {q Q : ℕ} (h : q ∣ Q) {ι : Type*} (s : Finset ι) (f : ι → Fin n → ZMod Q) :
    blockRed q (∑ j ∈ s, f j) = ∑ j ∈ s, blockRed q (f j) := map_sum (blockRedHom h) f s

/-- Multiplication by an integer coprime to `p` is injective on `(ZMod p)ⁿ`. -/
lemma eq_zero_of_nsmul_eq_zero_of_coprime {p c : ℕ} (hc : Nat.Coprime c p)
    {v : Fin n → ZMod p} (h : c • v = 0) : v = 0 := by
  funext i
  have hi := congrFun h i
  simp only [Pi.smul_apply, nsmul_eq_mul, Pi.zero_apply] at hi
  rw [← ZMod.coe_unitOfCoprime c hc] at hi
  exact (Units.mul_right_eq_zero _).1 hi

/-! ### The CRT idempotents and block projections -/

/-- The CRT idempotent `e_q ∈ ZMod Q_S`: `e_q ≡ 1 mod q` and `e_q ≡ 0 mod p` for `p ∈ S`,
`p ≠ q` (`cast_blockIdem`). -/
def blockIdem (S : Finset ℕ) (q : ℕ) : ZMod (blockProd S) :=
  (((blockProd (S.erase q) : ℕ) : ℤ) * Nat.gcdA (blockProd (S.erase q)) q : ℤ)

lemma cast_blockIdem {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime) {p q : ℕ}
    (hp : p ∈ S) (hq : q ∈ S) :
    ((blockIdem S q).cast : ZMod p) = if p = q then 1 else 0 := by
  unfold blockIdem
  rw [ZMod.cast_intCast (dvd_blockProd hp)]
  push_cast
  split_ifs with hpq
  · subst hpq
    have hcop : Nat.Coprime (blockProd (S.erase p)) p :=
      (coprime_blockProd hS hp (Finset.erase_subset p S) (Finset.notMem_erase p S)).symm
    have h := Nat.gcd_eq_gcd_ab (blockProd (S.erase p)) p
    rw [Nat.Coprime.gcd_eq_one hcop] at h
    have h' := congrArg (Int.cast : ℤ → ZMod p) h
    push_cast at h'
    rw [ZMod.natCast_self, zero_mul, add_zero] at h'
    exact h'.symm
  · have : ((blockProd (S.erase q) : ℕ) : ZMod p) = 0 :=
      (ZMod.natCast_eq_zero_iff _ _).2 (dvd_blockProd (Finset.mem_erase.2 ⟨hpq, hp⟩))
    rw [this, zero_mul]

/-- `e_A = ∑_{q ∈ S ∩ A} e_q`. -/
def blockIdemSet (S A : Finset ℕ) : ZMod (blockProd S) := ∑ q ∈ S.filter (· ∈ A), blockIdem S q

lemma cast_blockIdemSet {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime) (A : Finset ℕ)
    {p : ℕ} (hp : p ∈ S) :
    ((blockIdemSet S A).cast : ZMod p) = if p ∈ A then 1 else 0 := by
  unfold blockIdemSet
  rw [← ZMod.castHom_apply (h := dvd_blockProd hp) (R := ZMod p), map_sum]
  simp_rw [ZMod.castHom_apply]
  rw [Finset.sum_congr rfl fun q hq => cast_blockIdem hS hp (Finset.mem_filter.1 hq).1,
    Finset.sum_ite_eq]
  simp [hp]

/-- The `A`-part `e_A · x` of a point `x ∈ T[Q_S]`: its reduction modulo `p ∈ S` is that of `x`
for `p ∈ A` and zero otherwise (`blockRed_blockProj`). The `q`-th block component of
Blueprint Definition 7.1 (`def:blocks`) is `blockProj S {q} x`. -/
def blockProj (S A : Finset ℕ) (x : Fin n → ZMod (blockProd S)) : Fin n → ZMod (blockProd S) :=
  blockIdemSet S A • x

lemma blockProj_add (S A : Finset ℕ) (x y : Fin n → ZMod (blockProd S)) :
    blockProj S A (x + y) = blockProj S A x + blockProj S A y := smul_add _ _ _

lemma blockRed_blockProj {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime) (A : Finset ℕ)
    {p : ℕ} (hp : p ∈ S) (x : Fin n → ZMod (blockProd S)) :
    blockRed p (blockProj S A x) = if p ∈ A then blockRed p x else 0 := by
  funext i
  simp only [blockRed, blockProj, Pi.smul_apply, smul_eq_mul]
  rw [ZMod.cast_mul (dvd_blockProd hp), cast_blockIdemSet hS A hp]
  split_ifs <;> simp [blockRed]

/-! ### Block supports -/

/-- The block support `{q ∈ S | x ≢ 0 mod q}` of `x ∈ T[Q_S]`: the set of blocks whose
component is nonzero (`mem_blockSupp_iff`). -/
def blockSupp (S : Finset ℕ) (x : Fin n → ZMod (blockProd S)) : Finset ℕ :=
  S.filter fun q => blockRed q x ≠ 0

lemma mem_blockSupp {S : Finset ℕ} {x : Fin n → ZMod (blockProd S)} {q : ℕ} :
    q ∈ blockSupp S x ↔ q ∈ S ∧ blockRed q x ≠ 0 := Finset.mem_filter

lemma blockSupp_subset (S : Finset ℕ) (x : Fin n → ZMod (blockProd S)) : blockSupp S x ⊆ S :=
  Finset.filter_subset _ _

lemma blockRed_eq_zero_of_not_mem {S : Finset ℕ} {x : Fin n → ZMod (blockProd S)} {q : ℕ}
    (hq : q ∈ S) (h : q ∉ blockSupp S x) : blockRed q x = 0 := by
  by_contra h'
  exact h (mem_blockSupp.2 ⟨hq, h'⟩)

lemma blockSupp_blockProj {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime) (A : Finset ℕ)
    (x : Fin n → ZMod (blockProd S)) : blockSupp S (blockProj S A x) = blockSupp S x ∩ A := by
  ext p
  simp only [mem_blockSupp, Finset.mem_inter]
  constructor
  · rintro ⟨hp, h⟩
    rw [blockRed_blockProj hS A hp] at h
    split_ifs at h with hpA
    · exact ⟨⟨hp, h⟩, hpA⟩
    · exact absurd rfl h
  · rintro ⟨⟨hp, h⟩, hpA⟩
    refine ⟨hp, ?_⟩
    rw [blockRed_blockProj hS A hp, ite_eq_left hpA]
    exact h

lemma blockProj_eq_self {S A : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {x : Fin n → ZMod (blockProd S)} (h : blockSupp S x ⊆ A) :
    blockProj S A x = x := by
  refine ext_blockRed hS fun p hp => ?_
  rw [blockRed_blockProj hS A hp]
  split_ifs with hpA
  · rfl
  · exact (blockRed_eq_zero_of_not_mem hp fun h' => hpA (h h')).symm

lemma blockProj_eq_zero {S A : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {x : Fin n → ZMod (blockProd S)} (h : Disjoint (blockSupp S x) A) :
    blockProj S A x = 0 := by
  refine eq_zero_of_forall_blockRed hS _ fun p hp => ?_
  rw [blockRed_blockProj hS A hp]
  split_ifs with hpA
  · exact blockRed_eq_zero_of_not_mem hp fun h' => Finset.disjoint_left.1 h h' hpA
  · rfl

/-- If `A, B` are disjoint and cover the support of `x`, then `x = e_A x + e_B x`. -/
lemma blockProj_add_blockProj {S A B : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] (hAB : Disjoint A B) {x : Fin n → ZMod (blockProd S)}
    (h : blockSupp S x ⊆ A ∪ B) : blockProj S A x + blockProj S B x = x := by
  refine ext_blockRed hS fun p hp => ?_
  rw [blockRed_add (dvd_blockProd hp), blockRed_blockProj hS A hp, blockRed_blockProj hS B hp]
  by_cases hpA : p ∈ A
  · rw [ite_eq_left hpA, ite_eq_right (Finset.disjoint_left.1 hAB hpA), add_zero]
  · by_cases hpB : p ∈ B
    · rw [ite_eq_right hpA, ite_eq_left hpB, zero_add]
    · rw [ite_eq_right hpA, ite_eq_right hpB, add_zero]
      refine (blockRed_eq_zero_of_not_mem hp fun h' => ?_).symm
      rcases Finset.mem_union.1 (h h') with h'' | h''
      exacts [hpA h'', hpB h'']

lemma blockProj_add_blockProj_sdiff {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] (A : Finset ℕ) (x : Fin n → ZMod (blockProd S)) :
    blockProj S A x + blockProj S (S \ A) x = x := by
  refine blockProj_add_blockProj hS Finset.disjoint_sdiff fun q hq => ?_
  by_cases hqA : q ∈ A
  · exact Finset.mem_union_left _ hqA
  · exact Finset.mem_union_right _ (Finset.mem_sdiff.2 ⟨blockSupp_subset S x hq, hqA⟩)

lemma blockSupp_eq_empty_iff {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {x : Fin n → ZMod (blockProd S)} : blockSupp S x = ∅ ↔ x = 0 := by
  constructor
  · intro h
    exact eq_zero_of_forall_blockRed hS x fun q hq =>
      blockRed_eq_zero_of_not_mem hq (by simp [h])
  · rintro rfl
    exact Finset.filter_false_of_mem fun q hq h => h (blockRed_zero (dvd_blockProd hq))

lemma blockSupp_zero (S : Finset ℕ) : blockSupp S (0 : Fin n → ZMod (blockProd S)) = ∅ :=
  Finset.filter_false_of_mem fun _ hq h => h (blockRed_zero (dvd_blockProd hq))

lemma blockSupp_neg (S : Finset ℕ) (x : Fin n → ZMod (blockProd S)) :
    blockSupp S (-x) = blockSupp S x := by
  ext q
  simp only [mem_blockSupp]
  constructor
  · rintro ⟨hq, h⟩
    rw [blockRed_neg (dvd_blockProd hq), neg_ne_zero] at h
    exact ⟨hq, h⟩
  · rintro ⟨hq, h⟩
    rw [blockRed_neg (dvd_blockProd hq), neg_ne_zero]
    exact ⟨hq, h⟩

lemma blockSupp_add_subset (S : Finset ℕ) (x y : Fin n → ZMod (blockProd S)) :
    blockSupp S (x + y) ⊆ blockSupp S x ∪ blockSupp S y := by
  intro q hq
  obtain ⟨hqS, h⟩ := mem_blockSupp.1 hq
  rw [blockRed_add (dvd_blockProd hqS)] at h
  by_contra h'
  simp only [Finset.mem_union, not_or] at h'
  rw [blockRed_eq_zero_of_not_mem hqS h'.1, blockRed_eq_zero_of_not_mem hqS h'.2, add_zero] at h
  exact h rfl

/-- Direct block decomposition: supports of sums with disjoint supports are unions. -/
lemma blockSupp_add_of_disjoint (S : Finset ℕ) {x y : Fin n → ZMod (blockProd S)}
    (h : Disjoint (blockSupp S x) (blockSupp S y)) :
    blockSupp S (x + y) = blockSupp S x ∪ blockSupp S y := by
  refine Finset.Subset.antisymm (blockSupp_add_subset S x y) fun q hq => ?_
  rcases Finset.mem_union.1 hq with hx | hy
  · obtain ⟨hqS, h'⟩ := mem_blockSupp.1 hx
    refine mem_blockSupp.2 ⟨hqS, ?_⟩
    rw [blockRed_add (dvd_blockProd hqS),
      blockRed_eq_zero_of_not_mem hqS (Finset.disjoint_left.1 h hx), add_zero]
    exact h'
  · obtain ⟨hqS, h'⟩ := mem_blockSupp.1 hy
    refine mem_blockSupp.2 ⟨hqS, ?_⟩
    rw [blockRed_add (dvd_blockProd hqS),
      blockRed_eq_zero_of_not_mem hqS (Finset.disjoint_right.1 h hy), zero_add]
    exact h'

/-- The block component `blockProj S {q} x` vanishes iff `x ≡ 0 mod q`. -/
lemma blockProj_singleton_eq_zero_iff {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {q : ℕ} (hq : q ∈ S) (x : Fin n → ZMod (blockProd S)) :
    blockProj S {q} x = 0 ↔ blockRed q x = 0 := by
  constructor
  · intro h
    have := blockRed_blockProj hS {q} hq x
    rwa [h, blockRed_zero (dvd_blockProd hq), ite_eq_left (Finset.mem_singleton_self q), eq_comm]
      at this
  · intro h
    refine blockProj_eq_zero hS (Finset.disjoint_singleton_right.2 fun h' => ?_)
    exact (mem_blockSupp.1 h').2 h

/-- The block support is the set of blocks `q ∈ S` whose component `blockProj S {q} x` is
nonzero (the reading of Blueprint Definition 7.1 (`def:blocks`)). -/
lemma mem_blockSupp_iff {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {x : Fin n → ZMod (blockProd S)} {q : ℕ} :
    q ∈ blockSupp S x ↔ q ∈ S ∧ blockProj S {q} x ≠ 0 := by
  rw [mem_blockSupp]
  constructor
  · rintro ⟨hq, h⟩
    exact ⟨hq, fun h' => h ((blockProj_singleton_eq_zero_iff hS hq x).1 h')⟩
  · rintro ⟨hq, h⟩
    exact ⟨hq, fun h' => h ((blockProj_singleton_eq_zero_iff hS hq x).2 h')⟩


/-! ### The subgroups `T[d] ⊆ T[Q]` -/

/-- `T[d] = (d⁻¹ℤ/ℤ)ⁿ` inside `T[Q]` (for `d ∣ Q`): the points killed by `d`. -/
def blockGrid (Q d : ℕ) [NeZero Q] : Finset (Fin n → ZMod Q) :=
  Finset.univ.filter fun x => d • x = 0

lemma mem_blockGrid {Q d : ℕ} [NeZero Q] {x : Fin n → ZMod Q} :
    x ∈ blockGrid Q d ↔ d • x = 0 := by simp [blockGrid]

/-- For `A ⊆ S`: `x ∈ T[Q_A]` iff the block support of `x` is contained in `A`. -/
lemma nsmul_blockProd_eq_zero_iff {S A : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] (hA : A ⊆ S) {x : Fin n → ZMod (blockProd S)} :
    blockProd A • x = 0 ↔ blockSupp S x ⊆ A := by
  constructor
  · intro h p hp
    obtain ⟨hpS, hne⟩ := mem_blockSupp.1 hp
    by_contra hpA
    have h' := congrArg (blockRed p) h
    rw [blockRed_nsmul (dvd_blockProd hpS), blockRed_zero (dvd_blockProd hpS)] at h'
    exact hne (eq_zero_of_nsmul_eq_zero_of_coprime (coprime_blockProd hS hpS hA hpA).symm h')
  · intro h
    refine eq_zero_of_forall_blockRed hS _ fun p hp => ?_
    rw [blockRed_nsmul (dvd_blockProd hp)]
    by_cases hpA : p ∈ A
    · funext i
      simp only [Pi.smul_apply, nsmul_eq_mul, Pi.zero_apply]
      rw [(ZMod.natCast_eq_zero_iff _ _).2 (dvd_blockProd hpA), zero_mul]
    · rw [blockRed_eq_zero_of_not_mem hp fun h' => hpA (h h'), smul_zero]

lemma mem_blockGrid_blockProd_iff {S A : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] (hA : A ⊆ S) {x : Fin n → ZMod (blockProd S)} :
    x ∈ blockGrid (blockProd S) (blockProd A) ↔ blockSupp S x ⊆ A := by
  rw [mem_blockGrid, nsmul_blockProd_eq_zero_iff hS hA]

lemma blockGrid_blockProd_eq_filter {S A : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] (hA : A ⊆ S) :
    blockGrid (blockProd S) (blockProd A) =
      Finset.univ.filter fun x : Fin n → ZMod (blockProd S) => blockSupp S x ⊆ A := by
  ext x
  rw [mem_blockGrid_blockProd_iff hS hA]
  simp

lemma mem_blockGrid_singleton_iff {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {q : ℕ} (hq : q ∈ S) {x : Fin n → ZMod (blockProd S)} :
    x ∈ blockGrid (blockProd S) q ↔ blockSupp S x ⊆ {q} := by
  have := mem_blockGrid_blockProd_iff (x := x) hS (Finset.singleton_subset_iff.2 hq)
  simpa only [blockProd, Finset.prod_singleton] using this

/-- The `q`-th block component of `x` lies in `T[q]`. -/
lemma blockProj_singleton_mem_blockGrid {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {q : ℕ} (hq : q ∈ S) (x : Fin n → ZMod (blockProd S)) :
    blockProj S {q} x ∈ blockGrid (blockProd S) q := by
  rw [mem_blockGrid_singleton_iff hS hq, blockSupp_blockProj hS]
  exact Finset.inter_subset_right

lemma nsmul_eq_zero_of_dvd {Q d d' : ℕ} (h : d ∣ d') {x : Fin n → ZMod Q} (hx : d • x = 0) :
    d' • x = 0 := by
  obtain ⟨m, rfl⟩ := h
  rw [mul_comm, mul_smul, hx, smul_zero]

/-! ### Blueprint Definition 7.1 (`def:blocks`): the block-sum bijection -/

/-- Sums of block components with `a_q ∈ T[q]` (`q ∈ A`) lie in `T[Q_A]`. -/
lemma sum_mem_blockGrid_blockProd {S A : Finset ℕ} [NeZero (blockProd S)]
    (a : A → Fin n → ZMod (blockProd S)) (ha : ∀ q : A, a q ∈ blockGrid (blockProd S) q.1) :
    ∑ q, a q ∈ blockGrid (blockProd S) (blockProd A) := by
  rw [mem_blockGrid, Finset.smul_sum]
  refine Finset.sum_eq_zero fun q _ => ?_
  exact nsmul_eq_zero_of_dvd (dvd_blockProd q.2) (mem_blockGrid.1 (ha q))

/-- The map `∏_{q ∈ A} T[q] → T[Q_A]` that adds its coordinates. -/
def blockSumMap (S A : Finset ℕ) [NeZero (blockProd S)]
    (a : (q : A) → blockGrid (n := n) (blockProd S) (q : ℕ)) :
    blockGrid (n := n) (blockProd S) (blockProd A) :=
  ⟨∑ q, (a q : Fin n → ZMod (blockProd S)),
    sum_mem_blockGrid_blockProd (fun q => (a q : Fin n → ZMod (blockProd S))) fun q => (a q).2⟩

/-- The `p`-th block component of a sum of block components `a_q ∈ T[q]` is `a_p`. -/
lemma blockProj_sum_blockGrid {S A : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] (hA : A ⊆ S) (a : A → Fin n → ZMod (blockProd S))
    (ha : ∀ q : A, a q ∈ blockGrid (blockProd S) q.1) (p : A) :
    blockProj S {(p : ℕ)} (∑ q, a q) = a p := by
  rw [blockProj, Finset.smul_sum, Finset.sum_eq_single p]
  · exact blockProj_eq_self hS ((mem_blockGrid_singleton_iff hS (hA p.2)).1 (ha p))
  · intro q _ hqp
    refine blockProj_eq_zero hS (Finset.disjoint_singleton_right.2 fun h => hqp ?_)
    have := (mem_blockGrid_singleton_iff hS (hA q.2)).1 (ha q) h
    exact Subtype.ext (Finset.mem_singleton.1 this).symm
  · intro h; exact absurd (Finset.mem_univ p) h

/-- Every point is the sum of its block components over `A ⊇ supp x`. -/
lemma sum_blockProj_singleton {S A : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {x : Fin n → ZMod (blockProd S)} (hx : blockSupp S x ⊆ A) :
    ∑ q ∈ A, blockProj S {q} x = x := by
  refine ext_blockRed hS fun p hp => ?_
  rw [blockRed_sum (dvd_blockProd hp)]
  simp_rw [blockRed_blockProj hS _ hp, Finset.mem_singleton]
  rw [Finset.sum_ite_eq]
  split_ifs with hpA
  · rfl
  · exact (blockRed_eq_zero_of_not_mem hp fun h => hpA (hx h)).symm

/-- Blueprint Definition 7.1 (`def:blocks`), first claim: for a finite set `S` of pairwise
coprime integers `> 1` and `A ⊆ S`, the map `∏_{q ∈ A} T[q] → T[Q_A]` that adds its coordinates
is a bijection (here `T[d] = (d⁻¹ℤ/ℤ)ⁿ` is realized inside `T[Q_S]` as `blockGrid (Q_S) d`). -/
theorem blockSum_bijective {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {A : Finset ℕ} (hA : A ⊆ S) :
    Function.Bijective (blockSumMap (n := n) S A) := by
  constructor
  · intro a b hab
    have hab' := congrArg Subtype.val hab
    simp only [blockSumMap] at hab'
    funext p
    apply Subtype.ext
    rw [← blockProj_sum_blockGrid hS hA (fun q => (a q : Fin n → ZMod (blockProd S)))
      (fun q => (a q).2) p, hab',
      blockProj_sum_blockGrid hS hA (fun q => (b q : Fin n → ZMod (blockProd S)))
      (fun q => (b q).2) p]
  · rintro ⟨x, hx⟩
    rw [mem_blockGrid_blockProd_iff hS hA] at hx
    refine ⟨fun q => ⟨blockProj S {(q : ℕ)} x, blockProj_singleton_mem_blockGrid hS (hA q.2) x⟩,
      Subtype.ext ?_⟩
    simp only [blockSumMap]
    rw [Finset.sum_coe_sort A (fun q => blockProj S {q} x)]
    exact sum_blockProj_singleton hS hx

/-- Blueprint Definition 7.1 (`def:blocks`), unique decomposition: every point `x` of `T[Q_A]`
(`A ⊆ S`) is uniquely a sum `∑_{q ∈ A} a_q` with `a_q ∈ T[q]`, namely `a_q = blockProj S {q} x`. -/
theorem existsUnique_blockDecomp {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {A : Finset ℕ} (hA : A ⊆ S) {x : Fin n → ZMod (blockProd S)}
    (hx : x ∈ blockGrid (blockProd S) (blockProd A)) :
    ∃! a : A → Fin n → ZMod (blockProd S),
      (∀ q : A, a q ∈ blockGrid (blockProd S) q.1) ∧ ∑ q, a q = x := by
  rw [mem_blockGrid_blockProd_iff hS hA] at hx
  refine ⟨fun q => blockProj S {(q : ℕ)} x,
    ⟨fun q => blockProj_singleton_mem_blockGrid hS (hA q.2) x, ?_⟩, ?_⟩
  · rw [Finset.sum_coe_sort A (fun q => blockProj S {q} x)]
    exact sum_blockProj_singleton hS hx
  · rintro a ⟨ha, rfl⟩
    funext p
    exact (blockProj_sum_blockGrid hS hA a ha p).symm

/-! ### The sets `Σ_A`, `Σ_{≤k}`, `Σ^{A₀}` -/

/-- `Σ_A`: the points of `T[Q_S]` whose `q`-th block component is nonzero exactly for `q ∈ A`
(Blueprint Definition 7.1 (`def:blocks`)). -/
def sigmaBlock (S : Finset ℕ) [NeZero (blockProd S)] (A : Finset ℕ) :
    Finset (Fin n → ZMod (blockProd S)) :=
  Finset.univ.filter fun x => blockSupp S x = A

/-- `Σ_{≤k} = ⋃_{|A| ≤ k} Σ_A` (Blueprint Definition 7.1 (`def:blocks`)). -/
def sigmaLe (S : Finset ℕ) [NeZero (blockProd S)] (k : ℕ) :
    Finset (Fin n → ZMod (blockProd S)) :=
  Finset.univ.filter fun x => (blockSupp S x).card ≤ k

/-- `Σ^{A₀} = ⋃_{B ⊆ S \ A₀, |B| ≤ k - |A₀|} Σ_B` (Blueprint Definition 7.1 (`def:blocks`)). -/
def sigmaUpper (S : Finset ℕ) [NeZero (blockProd S)] (k : ℕ) (A₀ : Finset ℕ) :
    Finset (Fin n → ZMod (blockProd S)) :=
  Finset.univ.filter fun x => Disjoint (blockSupp S x) A₀ ∧ (blockSupp S x).card + A₀.card ≤ k

lemma mem_sigmaBlock {S A : Finset ℕ} [NeZero (blockProd S)] {x : Fin n → ZMod (blockProd S)} :
    x ∈ sigmaBlock S A ↔ blockSupp S x = A := by simp [sigmaBlock]

lemma mem_sigmaLe {S : Finset ℕ} [NeZero (blockProd S)] {k : ℕ}
    {x : Fin n → ZMod (blockProd S)} : x ∈ sigmaLe S k ↔ (blockSupp S x).card ≤ k := by
  simp [sigmaLe]

lemma mem_sigmaUpper {S : Finset ℕ} [NeZero (blockProd S)] {k : ℕ} {A₀ : Finset ℕ}
    {x : Fin n → ZMod (blockProd S)} :
    x ∈ sigmaUpper S k A₀ ↔ Disjoint (blockSupp S x) A₀ ∧ (blockSupp S x).card + A₀.card ≤ k := by
  simp [sigmaUpper]

/-- Membership in `Σ_A` in the blueprint's words: the `q`-th component is nonzero for every
`q ∈ A` and zero for `q ∈ S \ A` (and `A ⊆ S`). -/
lemma mem_sigmaBlock_iff {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {A : Finset ℕ} {x : Fin n → ZMod (blockProd S)} :
    x ∈ sigmaBlock S A ↔ A ⊆ S ∧ (∀ q ∈ A, blockProj S {q} x ≠ 0) ∧
      (∀ q ∈ S, q ∉ A → blockProj S {q} x = 0) := by
  rw [mem_sigmaBlock]
  constructor
  · rintro rfl
    refine ⟨blockSupp_subset S x, fun q hq => ((mem_blockSupp_iff hS).1 hq).2,
      fun q hq hqA => ?_⟩
    by_contra h
    exact hqA ((mem_blockSupp_iff hS).2 ⟨hq, h⟩)
  · rintro ⟨hAS, h1, h2⟩
    ext q
    rw [mem_blockSupp_iff hS]
    constructor
    · rintro ⟨hq, h⟩
      by_contra hqA
      exact h (h2 q hq hqA)
    · intro hq
      exact ⟨hAS hq, h1 q hq⟩

lemma sigmaBlock_subset_blockGrid {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {A : Finset ℕ} (hA : A ⊆ S) :
    sigmaBlock (n := n) S A ⊆ blockGrid (blockProd S) (blockProd A) := by
  intro x hx
  rw [mem_blockGrid_blockProd_iff hS hA, (mem_sigmaBlock.1 hx)]

lemma sigmaBlock_eq_empty {S : Finset ℕ} [NeZero (blockProd S)] {A : Finset ℕ} (hA : ¬ A ⊆ S) :
    sigmaBlock (n := n) S A = ∅ :=
  Finset.filter_false_of_mem fun x _ h => hA (h ▸ blockSupp_subset S x)

lemma sigmaUpper_subset_sigmaLe (S : Finset ℕ) [NeZero (blockProd S)] (k : ℕ)
    (A₀ : Finset ℕ) : sigmaUpper (n := n) S k A₀ ⊆ sigmaLe S k := by
  intro x hx
  rw [mem_sigmaUpper] at hx
  rw [mem_sigmaLe]
  omega

lemma sigmaBlock_subset_sigmaLe (S : Finset ℕ) [NeZero (blockProd S)] {k : ℕ} {A : Finset ℕ}
    (hA : A.card ≤ k) : sigmaBlock (n := n) S A ⊆ sigmaLe S k := by
  intro x hx
  rw [mem_sigmaLe, mem_sigmaBlock.1 hx]
  exact hA

/-- The sets `Σ_A` are pairwise disjoint (each point has a unique block support). -/
lemma pairwiseDisjoint_sigmaBlock (S : Finset ℕ) [NeZero (blockProd S)] :
    (Set.univ : Set (Finset ℕ)).PairwiseDisjoint (sigmaBlock (n := n) S) := by
  intro A _ B _ hAB
  refine Finset.disjoint_left.2 fun x hA hB => hAB ?_
  rw [← mem_sigmaBlock.1 hA, ← mem_sigmaBlock.1 hB]

/-- Blueprint Definition 7.1 (`def:blocks`), second claim, for `Σ_{≤k}`:
`Σ_{≤k} = ⋃_{A ⊆ S, |A| ≤ k} Σ_A`, and the union is disjoint (`pairwiseDisjoint_sigmaBlock`). -/
theorem sigmaLe_eq_biUnion (S : Finset ℕ) [NeZero (blockProd S)] (k : ℕ) :
    sigmaLe (n := n) S k = (S.powerset.filter fun A => A.card ≤ k).biUnion (sigmaBlock S) := by
  ext x
  simp only [mem_sigmaLe, Finset.mem_biUnion, Finset.mem_filter, Finset.mem_powerset,
    mem_sigmaBlock]
  constructor
  · intro h
    exact ⟨blockSupp S x, ⟨blockSupp_subset S x, h⟩, rfl⟩
  · rintro ⟨A, ⟨_, hA⟩, rfl⟩
    exact hA

/-- Blueprint Definition 7.1 (`def:blocks`), second claim, for `Σ^{A₀}` (with `|A₀| ≤ k`):
`Σ^{A₀} = ⋃_{B ⊆ S \ A₀, |B| ≤ k - |A₀|} Σ_B`, a disjoint union
(`pairwiseDisjoint_sigmaBlock`). -/
theorem sigmaUpper_eq_biUnion (S : Finset ℕ) [NeZero (blockProd S)] (k : ℕ) {A₀ : Finset ℕ}
    (hA₀ : A₀.card ≤ k) :
    sigmaUpper (n := n) S k A₀ =
      ((S \ A₀).powerset.filter fun B => B.card ≤ k - A₀.card).biUnion (sigmaBlock S) := by
  ext x
  simp only [mem_sigmaUpper, Finset.mem_biUnion, Finset.mem_filter, Finset.mem_powerset,
    mem_sigmaBlock]
  constructor
  · rintro ⟨hd, hc⟩
    refine ⟨blockSupp S x, ⟨fun q hq => Finset.mem_sdiff.2 ⟨blockSupp_subset S x hq,
      Finset.disjoint_left.1 hd hq⟩, by omega⟩, rfl⟩
  · rintro ⟨B, ⟨hB, hc⟩, rfl⟩
    refine ⟨Finset.disjoint_left.2 fun q hq => (Finset.mem_sdiff.1 (hB hq)).2, by omega⟩

/-- Sums over `Σ_{≤k}` split over the disjoint pieces `Σ_A`. -/
theorem sum_sigmaLe {M : Type*} [AddCommMonoid M] (S : Finset ℕ) [NeZero (blockProd S)] (k : ℕ)
    (f : (Fin n → ZMod (blockProd S)) → M) :
    ∑ x ∈ sigmaLe S k, f x =
      ∑ A ∈ S.powerset.filter (fun A => A.card ≤ k), ∑ x ∈ sigmaBlock S A, f x := by
  rw [sigmaLe_eq_biUnion, Finset.sum_biUnion]
  exact (pairwiseDisjoint_sigmaBlock S).subset (Set.subset_univ _)

/-- Sums over `Σ^{A₀}` split over the disjoint pieces `Σ_B`, `B ⊆ S \ A₀`, `|B| ≤ k - |A₀|`. -/
theorem sum_sigmaUpper {M : Type*} [AddCommMonoid M] (S : Finset ℕ) [NeZero (blockProd S)]
    (k : ℕ) {A₀ : Finset ℕ} (hA₀ : A₀.card ≤ k) (f : (Fin n → ZMod (blockProd S)) → M) :
    ∑ x ∈ sigmaUpper S k A₀, f x =
      ∑ B ∈ (S \ A₀).powerset.filter (fun B => B.card ≤ k - A₀.card),
        ∑ x ∈ sigmaBlock S B, f x := by
  rw [sigmaUpper_eq_biUnion S k hA₀, Finset.sum_biUnion]
  exact (pairwiseDisjoint_sigmaBlock S).subset (Set.subset_univ _)


/-! ### Direct block decomposition and cosets `α + Σ_{A₀}` -/

/-- For `α ∈ Σ_{A₁}`, `β ∈ Σ_{A₀}` with `A₁ ∩ A₀ = ∅`: `α + β ∈ Σ_{A₀ ∪ A₁}`. -/
lemma add_mem_sigmaBlock_union (S : Finset ℕ) [NeZero (blockProd S)] {A₀ A₁ : Finset ℕ}
    (hd : Disjoint A₁ A₀) {α β : Fin n → ZMod (blockProd S)} (hα : α ∈ sigmaBlock S A₁)
    (hβ : β ∈ sigmaBlock S A₀) : α + β ∈ sigmaBlock S (A₀ ∪ A₁) := by
  rw [mem_sigmaBlock] at hα hβ ⊢
  rw [blockSupp_add_of_disjoint S (by rwa [hα, hβ]), hα, hβ, Finset.union_comm]

/-- The map `(α, β) ↦ α + β` is a bijection `Σ_{A₁} × Σ_{A₀} → Σ_{A₀ ∪ A₁}` for disjoint
`A₁, A₀` (the direct block decomposition), with inverse `x ↦ (e_{A₁} x, e_{A₀} x)`. -/
theorem sigmaBlock_add_bijOn {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {A₀ A₁ : Finset ℕ} (hd : Disjoint A₁ A₀) :
    Set.BijOn (fun p : (Fin n → ZMod (blockProd S)) × (Fin n → ZMod (blockProd S)) => p.1 + p.2)
      ((sigmaBlock (n := n) S A₁ ×ˢ sigmaBlock (n := n) S A₀ : Finset _) : Set _)
      ((sigmaBlock (n := n) S (A₀ ∪ A₁) : Finset _) : Set _) := by
  refine Set.InvOn.bijOn (f' := fun x => (blockProj S A₁ x, blockProj S A₀ x)) ⟨?_, ?_⟩ ?_ ?_
  · rintro ⟨α, β⟩ h
    simp only [Finset.coe_product, Set.mem_prod, Finset.mem_coe, mem_sigmaBlock] at h
    obtain ⟨hα, hβ⟩ := h
    simp only [blockProj_add, Prod.mk.injEq]
    refine ⟨?_, ?_⟩
    · rw [blockProj_eq_self hS hα.le, blockProj_eq_zero hS (hβ ▸ hd.symm), add_zero]
    · rw [blockProj_eq_zero hS (hα ▸ hd), blockProj_eq_self hS hβ.le, zero_add]
  · intro x hx
    simp only [Finset.mem_coe, mem_sigmaBlock] at hx
    exact blockProj_add_blockProj hS hd (by rw [hx, Finset.union_comm])
  · rintro ⟨α, β⟩ h
    simp only [Finset.coe_product, Set.mem_prod, Finset.mem_coe] at h
    exact add_mem_sigmaBlock_union S hd h.1 h.2
  · intro x hx
    simp only [Finset.mem_coe, mem_sigmaBlock] at hx
    simp only [Finset.coe_product, Set.mem_prod, Finset.mem_coe, mem_sigmaBlock,
      blockSupp_blockProj hS, hx]
    constructor
    · ext q; simp only [Finset.mem_inter, Finset.mem_union]
      constructor
      · exact fun h => h.2
      · exact fun h => ⟨Or.inr h, h⟩
    · ext q; simp only [Finset.mem_inter, Finset.mem_union]
      constructor
      · exact fun h => h.2
      · exact fun h => ⟨Or.inl h, h⟩

/-- The direct block decomposition in sum form (used in Blueprint Lemmas 7.4–7.5):
for disjoint `A₁, A₀`, `f_{A₀ ∪ A₁} = ∑_{α ∈ Σ_{A₁}} f_{A₀,α}` where
`f_{A₀,α} = ∑_{β ∈ Σ_{A₀}} f_{α+β}`. -/
theorem sum_sigmaBlock_union {M : Type*} [AddCommMonoid M] {S : Finset ℕ}
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {A₀ A₁ : Finset ℕ}
    (hd : Disjoint A₁ A₀) (f : (Fin n → ZMod (blockProd S)) → M) :
    ∑ x ∈ sigmaBlock S (A₀ ∪ A₁), f x =
      ∑ α ∈ sigmaBlock S A₁, ∑ β ∈ sigmaBlock S A₀, f (α + β) := by
  rw [← Finset.sum_product' (f := fun α β => f (α + β))]
  symm
  exact Finset.sum_nbij (fun p => p.1 + p.2) (sigmaBlock_add_bijOn hS hd).mapsTo
    (sigmaBlock_add_bijOn hS hd).injOn (sigmaBlock_add_bijOn hS hd).surjOn fun _ _ => rfl

/-- Cosets `α + Σ_{A₀}`, `α ∈ Σ^{A₀}` (used in Blueprint Lemma 7.6): a point `x` lies in the
coset of `(A₀, α)` iff `A₀ ⊆ blockSupp S x`, `|blockSupp S x| ≤ k` and `α = e_{S \ A₀} x`; in
particular a center with support `A` occurs in some such coset exactly when `A₀ ⊆ A`, and then
`α` is uniquely determined. -/
theorem mem_coset_iff {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {k : ℕ} {A₀ : Finset ℕ}
    (x α : Fin n → ZMod (blockProd S)) :
    (α ∈ sigmaUpper S k A₀ ∧ x - α ∈ sigmaBlock S A₀) ↔
      (A₀ ⊆ blockSupp S x ∧ (blockSupp S x).card ≤ k ∧ α = blockProj S (S \ A₀) x) := by
  rw [mem_sigmaUpper, mem_sigmaBlock]
  constructor
  · rintro ⟨⟨hd, hc⟩, hβ⟩
    have hx : x = α + (x - α) := by abel
    have hsupp : blockSupp S x = blockSupp S α ∪ A₀ := by
      rw [hx, blockSupp_add_of_disjoint S (by rwa [hβ]), hβ]
    refine ⟨hsupp ▸ Finset.subset_union_right, ?_, ?_⟩
    · rw [hsupp, Finset.card_union_of_disjoint hd]; exact hc
    · rw [hx, blockProj_add, blockProj_eq_self hS (fun q hq => Finset.mem_sdiff.2
        ⟨blockSupp_subset S α hq, Finset.disjoint_left.1 hd hq⟩),
        blockProj_eq_zero hS (hβ ▸ Finset.disjoint_sdiff), add_zero]
  · rintro ⟨hsub, hc, rfl⟩
    have hsplit := blockProj_add_blockProj_sdiff hS A₀ x
    have hxa : x - blockProj S (S \ A₀) x = blockProj S A₀ x := by
      rw [sub_eq_iff_eq_add]; exact hsplit.symm
    have h1 : blockSupp S (blockProj S (S \ A₀) x) = blockSupp S x \ A₀ := by
      rw [blockSupp_blockProj hS]
      ext q
      simp only [Finset.mem_inter, Finset.mem_sdiff]
      constructor
      · exact fun h => ⟨h.1, h.2.2⟩
      · exact fun h => ⟨h.1, blockSupp_subset S x h.1, h.2⟩
    refine ⟨⟨?_, ?_⟩, ?_⟩
    · rw [h1]; exact Finset.sdiff_disjoint
    · have := Finset.card_le_card hsub
      rw [h1, Finset.card_sdiff_of_subset hsub]; omega
    · rw [hxa, blockSupp_blockProj hS, Finset.inter_eq_right.2 hsub]

/-! ### The embedding into `E` and the full grids `T[d]` -/

/-- The point `((xᵢ).val / Q)ᵢ ∈ [0,1)ⁿ ⊂ E` representing `x ∈ T[Q] = (Q⁻¹ℤ/ℤ)ⁿ`. -/
noncomputable def ratPt (Q : ℕ) (x : Fin n → ZMod Q) : EuclideanSpace ℝ (Fin n) :=
  WithLp.toLp 2 (fun i => ((x i).val : ℝ) / Q)

@[simp] lemma ratPt_apply (Q : ℕ) (x : Fin n → ZMod Q) (i : Fin n) :
    ratPt Q x i = ((x i).val : ℝ) / Q := rfl

lemma ratPt_injective (Q : ℕ) [NeZero Q] : Function.Injective (ratPt (n := n) Q) := by
  intro x y h
  funext i
  have hi := congrArg (fun v : EuclideanSpace ℝ (Fin n) => v i) h
  simp only [ratPt_apply] at hi
  have hQ : (Q : ℝ) ≠ 0 := Nat.cast_ne_zero.2 (NeZero.ne Q)
  rw [div_left_inj' hQ, Nat.cast_inj] at hi
  exact ZMod.val_injective Q hi

/-- The grid point `b ↦ b · (Q/d)` of `T[d] ⊆ T[Q]`, `b ∈ {0, …, d-1}ⁿ`. -/
def gridEmb (Q d : ℕ) (b : Fin n → Fin d) : Fin n → ZMod Q :=
  fun i => (((b i : ℕ) * (Q / d) : ℕ) : ZMod Q)

lemma val_gridEmb {Q d : ℕ} [NeZero Q] (hd : d ∣ Q) (b : Fin n → Fin d) (i : Fin n) :
    (gridEmb Q d b i).val = (b i : ℕ) * (Q / d) := by
  unfold gridEmb
  rw [ZMod.val_natCast, Nat.mod_eq_of_lt]
  have hd0 : 0 < d := (b i).pos
  have hQd : 0 < Q / d := Nat.div_pos (Nat.le_of_dvd (Nat.pos_of_ne_zero (NeZero.ne Q)) hd) hd0
  calc (b i : ℕ) * (Q / d) < d * (Q / d) := Nat.mul_lt_mul_of_pos_right (b i).2 hQd
    _ = Q := Nat.mul_div_cancel' hd

/-- `gridEmb` realizes the grid points `gridPt d b` of `gridSym`. -/
lemma ratPt_gridEmb {Q d : ℕ} [NeZero Q] (hd : d ∣ Q) (b : Fin n → Fin d) :
    ratPt Q (gridEmb Q d b) = gridPt d b := by
  ext i
  simp only [ratPt_apply, gridPt, PiLp.toLp_apply, val_gridEmb hd]
  have hd0 : (0 : ℝ) < d := Nat.cast_pos.2 (b i).pos
  have hQ : (Q : ℝ) = d * ((Q / d : ℕ) : ℝ) := by exact_mod_cast (Nat.mul_div_cancel' hd).symm
  have hQd : ((Q / d : ℕ) : ℝ) ≠ 0 := by
    intro h; rw [h, mul_zero] at hQ; exact NeZero.ne Q (by exact_mod_cast hQ)
  rw [hQ]; push_cast; field_simp

lemma gridEmb_injective {Q d : ℕ} [NeZero Q] (hd : d ∣ Q) :
    Function.Injective (gridEmb (n := n) Q d) := by
  intro b b' h
  funext i
  have h1 := congrArg (fun x => (x i).val) h
  simp only [val_gridEmb hd] at h1
  have hQd : 0 < Q / d :=
    Nat.div_pos (Nat.le_of_dvd (Nat.pos_of_ne_zero (NeZero.ne Q)) hd) (b i).pos
  exact Fin.ext (Nat.eq_of_mul_eq_mul_right hQd h1)

lemma gridEmb_mem_blockGrid {Q d : ℕ} [NeZero Q] (hd : d ∣ Q) (b : Fin n → Fin d) :
    gridEmb Q d b ∈ blockGrid Q d := by
  rw [mem_blockGrid]
  funext i
  simp only [Pi.smul_apply, gridEmb, nsmul_eq_mul, Pi.zero_apply]
  rw [← Nat.cast_mul, mul_left_comm, Nat.mul_div_cancel' hd, ZMod.natCast_eq_zero_iff]
  exact Dvd.intro_left _ rfl

lemma exists_gridEmb_eq {Q d : ℕ} [NeZero Q] (hd : d ∣ Q) {x : Fin n → ZMod Q}
    (hx : x ∈ blockGrid Q d) : ∃ b, gridEmb Q d b = x := by
  rw [mem_blockGrid] at hx
  have hQ0 : 0 < Q := Nat.pos_of_ne_zero (NeZero.ne Q)
  have hd0 : 0 < d := Nat.pos_of_dvd_of_pos hd hQ0
  have hQd : d * (Q / d) = Q := Nat.mul_div_cancel' hd
  have key : ∀ i, ∃ t : Fin d, (t : ℕ) * (Q / d) = (x i).val := by
    intro i
    have h1 := congrFun hx i
    simp only [Pi.smul_apply, nsmul_eq_mul, Pi.zero_apply] at h1
    rw [← ZMod.natCast_zmod_val (x i), ← Nat.cast_mul, ZMod.natCast_eq_zero_iff] at h1
    have h2 : d * (Q / d) ∣ d * (x i).val := by rw [hQd]; exact h1
    obtain ⟨t, ht⟩ := (Nat.mul_dvd_mul_iff_left hd0).1 h2
    refine ⟨⟨t, ?_⟩, by rw [ht, mul_comm]⟩
    have hlt := ZMod.val_lt (x i)
    rw [ht] at hlt
    nth_rewrite 2 [← hQd] at hlt
    rw [mul_comm d] at hlt
    exact Nat.lt_of_mul_lt_mul_left hlt
  choose b hb using key
  refine ⟨b, funext fun i => ?_⟩
  simp only [gridEmb]
  rw [hb i, ZMod.natCast_zmod_val]

/-- Sums over `T[d] ⊆ T[Q]` in the coordinates of `gridSym`. -/
theorem sum_blockGrid_eq_sum_gridPt {M : Type*} [AddCommMonoid M] {Q d : ℕ} [NeZero Q]
    (hd : d ∣ Q) (g : EuclideanSpace ℝ (Fin n) → M) :
    ∑ x ∈ blockGrid Q d, g (ratPt Q x) = ∑ b : Fin n → Fin d, g (gridPt d b) := by
  symm
  refine Finset.sum_bij (fun b _ => gridEmb Q d b) (fun b _ => gridEmb_mem_blockGrid hd b)
    (fun b _ b' _ h => gridEmb_injective hd h) (fun x hx => ?_) (fun b _ => by
      rw [ratPt_gridEmb hd])
  obtain ⟨b, rfl⟩ := exists_gridEmb_eq hd hx
  exact ⟨b, Finset.mem_univ _, rfl⟩

/-- The full-grid multiplier `T_{m;T[d]}` is `Δ_d m = gridSym d m` of Blueprint Lemma 6.2. -/
theorem sum_blockGrid_periodize_eq_gridSym {Q d : ℕ} [NeZero Q] (hd : d ∣ Q)
    (m : EuclideanSpace ℝ (Fin n) → ℂ) (ξ : EuclideanSpace ℝ (Fin n)) :
    ∑ x ∈ blockGrid Q d, periodize m (ξ - ratPt Q x) = gridSym d m ξ :=
  sum_blockGrid_eq_sum_gridPt hd (fun β => periodize m (ξ - β))

/-- `#T[d] = dⁿ`. -/
theorem card_blockGrid {Q d : ℕ} [NeZero Q] (hd : d ∣ Q) :
    (blockGrid (n := n) Q d).card = d ^ n := by
  have := sum_blockGrid_eq_sum_gridPt (n := n) (M := ℕ) hd (fun _ => 1)
  simp only [Finset.sum_const, smul_eq_mul, mul_one, Finset.card_univ, Fintype.card_fun,
    Fintype.card_fin] at this
  exact this

/-- `#Σ_A ≤ Q_Aⁿ`. -/
theorem card_sigmaBlock_le {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {A : Finset ℕ} (hA : A ⊆ S) :
    (sigmaBlock (n := n) S A).card ≤ blockProd A ^ n := by
  rw [← card_blockGrid (Q := blockProd S) (blockProd_dvd_blockProd hA)]
  exact Finset.card_le_card (sigmaBlock_subset_blockGrid hS hA)

/-! ### Inclusion–exclusion (eq. `inclusionexclusion` of Blueprint Lemma 7.6) -/

lemma sum_superset_neg_one_pow (C A₀ : Finset ℕ) :
    ∑ B ∈ A₀.powerset.filter (fun B => C ⊆ B), (-1 : ℤ) ^ (A₀.card - B.card) =
      if C = A₀ then 1 else 0 := by
  by_cases hC : C ⊆ A₀
  · rw [Finset.sum_nbij' (fun B => A₀ \ B) (fun D => A₀ \ D)
      (t := (A₀ \ C).powerset) (g := fun D => (-1 : ℤ) ^ D.card)]
    · rw [Finset.sum_powerset_neg_one_pow_card]
      by_cases h : C = A₀
      · simp [h]
      · have h' : A₀ \ C ≠ ∅ := fun h' =>
          h (Finset.Subset.antisymm hC (Finset.sdiff_eq_empty_iff_subset.1 h'))
        simp [h, h']
    · intro B hB
      simp only [Finset.mem_filter, Finset.mem_powerset] at hB ⊢
      exact Finset.sdiff_subset_sdiff subset_rfl hB.2
    · intro D hD
      simp only [Finset.mem_filter, Finset.mem_powerset] at hD ⊢
      refine ⟨Finset.sdiff_subset, fun q hq => Finset.mem_sdiff.2 ⟨hC hq, fun hqD => ?_⟩⟩
      exact (Finset.mem_sdiff.1 (hD hqD)).2 hq
    · intro B hB
      simp only [Finset.mem_filter, Finset.mem_powerset] at hB
      exact Finset.sdiff_sdiff_eq_self hB.1
    · intro D hD
      simp only [Finset.mem_powerset] at hD
      exact Finset.sdiff_sdiff_eq_self (hD.trans Finset.sdiff_subset)
    · intro B hB
      simp only [Finset.mem_filter, Finset.mem_powerset] at hB
      rw [Finset.card_sdiff_of_subset hB.1]
  · rw [ite_eq_right (fun h => hC h.le)]
    refine Finset.sum_eq_zero fun B hB => ?_
    simp only [Finset.mem_filter, Finset.mem_powerset] at hB
    exact absurd (hB.2.trans hB.1) hC

/-- Inclusion–exclusion on which block components vanish (eq. `inclusionexclusion` of Blueprint
Lemma 7.6): for `A₀ ⊆ S`,
`∑_{x ∈ Σ_{A₀}} f x = ∑_{B ⊆ A₀} (-1)^{|A₀|-|B|} ∑_{x ∈ T[Q_B]} f x`. -/
theorem sum_sigmaBlock_inclusion_exclusion {M : Type*} [AddCommGroup M] {S : Finset ℕ}
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {A₀ : Finset ℕ}
    (hA₀ : A₀ ⊆ S) (f : (Fin n → ZMod (blockProd S)) → M) :
    ∑ x ∈ sigmaBlock S A₀, f x =
      ∑ B ∈ A₀.powerset, (-1 : ℤ) ^ (A₀.card - B.card) •
        ∑ x ∈ blockGrid (blockProd S) (blockProd B), f x := by
  have hgrid : ∑ B ∈ A₀.powerset, (-1 : ℤ) ^ (A₀.card - B.card) •
        ∑ x ∈ blockGrid (blockProd S) (blockProd B), f x =
      ∑ B ∈ A₀.powerset, (-1 : ℤ) ^ (A₀.card - B.card) •
        ∑ x ∈ Finset.univ.filter (fun x : Fin n → ZMod (blockProd S) => blockSupp S x ⊆ B),
          f x :=
    Finset.sum_congr rfl fun B hB => by
      rw [blockGrid_blockProd_eq_filter hS ((Finset.mem_powerset.1 hB).trans hA₀)]
  rw [hgrid]
  simp_rw [Finset.sum_filter, Finset.smul_sum]
  rw [Finset.sum_comm]
  simp_rw [smul_ite, smul_zero, ← Finset.sum_filter, ← Finset.sum_smul,
    sum_superset_neg_one_pow, ite_smul, one_smul, zero_smul]
  rw [← Finset.sum_filter]
  rfl


/-! ### The separation property (7.1) -/

/-- `ratPt Q x ∈ ℤⁿ` iff `x = 0`. -/
lemma ratPt_mem_range_latEmbed_iff {Q : ℕ} [NeZero Q] (x : Fin n → ZMod Q) :
    ratPt Q x ∈ Set.range (latEmbed (n := n)) ↔ x = 0 := by
  constructor
  · rintro ⟨z, hz⟩
    funext i
    have hi := congrArg (fun v : EuclideanSpace ℝ (Fin n) => v i) hz
    simp only [latEmbed_apply, ratPt_apply] at hi
    have hQ : (0 : ℝ) < Q := Nat.cast_pos.2 (Nat.pos_of_ne_zero (NeZero.ne Q))
    have h0 : (0 : ℝ) ≤ (x i).val / Q := by positivity
    have h1 : ((x i).val : ℝ) / Q < 1 := by
      rw [div_lt_one hQ]; exact_mod_cast ZMod.val_lt (x i)
    rw [← hi] at h0 h1
    have hz0 : z i = 0 := by
      have a : (0 : ℤ) ≤ z i := by exact_mod_cast h0
      have b : z i < 1 := by exact_mod_cast h1
      omega
    rw [hz0, Int.cast_zero, eq_comm, div_eq_zero_iff] at hi
    rcases hi with h | h
    · rw [Pi.zero_apply, ← ZMod.val_eq_zero]; exact_mod_cast h
    · exact absurd h hQ.ne'
  · rintro rfl
    exact ⟨0, by ext i; simp [ratPt_apply, latEmbed_apply]⟩

lemma ratPt_intCast_coord (Q : ℕ) [NeZero Q] (w : ℤ) :
    ∃ z : ℤ, (((w : ZMod Q)).val : ℝ) / Q = w / Q + z := by
  refine ⟨-(w / (Q : ℤ)), ?_⟩
  have hQ : (Q : ℝ) ≠ 0 := Nat.cast_ne_zero.2 (NeZero.ne Q)
  have h1 : (((w : ZMod Q).val : ℤ)) = w % Q := ZMod.val_intCast w
  have h3 : ((w : ZMod Q).val : ℝ) = ((w % (Q : ℤ) : ℤ) : ℝ) := by
    rw [← h1]; simp
  rw [h3, Int.emod_def]
  push_cast
  field_simp
  ring

/-- The embedding `ratPt` is additive modulo `ℤⁿ`: for integer coefficients `σ_j`,
`ratPt (∑ σ_j α_j) - ∑ σ_j ratPt α_j ∈ ℤⁿ`. -/
theorem ratPt_sum_zsmul_sub_mem {Q : ℕ} [NeZero Q] {ι : Type*} (s : Finset ι) (σ : ι → ℤ)
    (α : ι → Fin n → ZMod Q) :
    ∃ z : Fin n → ℤ,
      ratPt Q (∑ j ∈ s, σ j • α j) = ∑ j ∈ s, σ j • ratPt Q (α j) + latEmbed z := by
  have key : ∀ i, ∃ z : ℤ, (((∑ j ∈ s, σ j • α j) i).val : ℝ) / Q =
      ∑ j ∈ s, (σ j : ℝ) * (((α j i).val : ℝ) / Q) + z := by
    intro i
    have hw : (∑ j ∈ s, σ j • α j) i = ((∑ j ∈ s, σ j * ((α j i).val : ℤ) : ℤ) : ZMod Q) := by
      simp only [Finset.sum_apply, zsmul_eq_mul]
      push_cast
      simp
    obtain ⟨z, hz⟩ := ratPt_intCast_coord Q (∑ j ∈ s, σ j * ((α j i).val : ℤ))
    refine ⟨z, ?_⟩
    rw [hw, hz]
    push_cast
    rw [Finset.sum_div]
    congr 1
    refine Finset.sum_congr rfl fun j _ => ?_
    ring
  choose z hz using key
  refine ⟨z, ?_⟩
  ext i
  simp only [ratPt_apply, hz i, PiLp.add_apply, latEmbed_apply]
  simp

lemma sum_zsmul_ratPt_mem_range_iff {Q : ℕ} [NeZero Q] {ι : Type*} (s : Finset ι)
    (σ : ι → ℤ) (α : ι → Fin n → ZMod Q) :
    ∑ j ∈ s, σ j • ratPt Q (α j) ∈ Set.range (latEmbed (n := n)) ↔
      ∑ j ∈ s, σ j • α j = 0 := by
  obtain ⟨z, hz⟩ := ratPt_sum_zsmul_sub_mem s σ α
  rw [← ratPt_mem_range_latEmbed_iff, hz]
  constructor
  · rintro ⟨w, hw⟩
    exact ⟨w + z, by rw [latEmbed_add, hw]⟩
  · rintro ⟨w, hw⟩
    refine ⟨w - z, ?_⟩
    rw [latEmbed_sub, hw, add_sub_cancel_right]

/-- A nonzero `y ∈ ZMod Q` killed by `D` has `y/Q` at distance `≥ 1/D` from every integer. -/
lemma inv_le_abs_sub_int {Q D : ℕ} [NeZero Q] {y : ZMod Q} (hy : y ≠ 0) (hD : D • y = 0)
    (z : ℤ) : ((D : ℝ))⁻¹ ≤ |(y.val : ℝ) / Q - z| := by
  rcases Nat.eq_zero_or_pos D with rfl | hD0
  · simp
  have hQ0 : 0 < Q := Nat.pos_of_ne_zero (NeZero.ne Q)
  have h1 : Q ∣ D * y.val := by
    rw [nsmul_eq_mul, ← ZMod.natCast_zmod_val y, ← Nat.cast_mul, ZMod.natCast_eq_zero_iff] at hD
    exact hD
  obtain ⟨t, ht⟩ := h1
  have hv0 : 0 < y.val := Nat.pos_of_ne_zero fun h => hy ((ZMod.val_eq_zero y).1 h)
  have hvQ := ZMod.val_lt y
  have ht0 : 0 < t := by
    rcases Nat.eq_zero_or_pos t with h | h
    · rw [h, mul_zero] at ht
      exact absurd ht (Nat.mul_pos hD0 hv0).ne'
    · exact h
  have htD : t < D := by
    by_contra h
    replace h := not_lt.1 h
    have : Q * D ≤ Q * t := Nat.mul_le_mul_left Q h
    have : D * y.val < D * Q := Nat.mul_lt_mul_of_pos_left hvQ hD0
    nlinarith
  have hDr : (0 : ℝ) < D := Nat.cast_pos.2 hD0
  have hQr : (0 : ℝ) < Q := Nat.cast_pos.2 hQ0
  have key : (y.val : ℝ) / Q - z = (((t : ℤ) - z * D : ℤ) : ℝ) / D := by
    have h' : (D : ℝ) * y.val = Q * t := by exact_mod_cast ht
    field_simp
    push_cast
    linear_combination h'
  rw [key, abs_div, abs_of_pos hDr, inv_eq_one_div]
  refine div_le_div_of_nonneg_right ?_ hDr.le
  have hne : (t : ℤ) - z * D ≠ 0 := by
    intro h
    have ht' : (t : ℤ) = z * D := by linarith
    have ht0' : (0 : ℤ) < t := by exact_mod_cast ht0
    have htD' : (t : ℤ) < D := by exact_mod_cast htD
    rcases le_or_gt z 0 with hz | hz
    · nlinarith
    · nlinarith
  exact_mod_cast Int.one_le_abs hne

/-- The `ε`-condition (7.1) gives `4rε < q_*^{-2rk}` (any base `q ≥ 1`, any exponent). -/
lemma four_mul_lt_of_le_eps {q r m : ℕ} (hq : 1 ≤ q) {ε : ℝ}
    (hεr : ε ≤ (100 * r * (q : ℝ) ^ m)⁻¹) : 4 * r * ε < ((q : ℝ) ^ m)⁻¹ := by
  have hX : (0 : ℝ) < (q : ℝ) ^ m := pow_pos (by exact_mod_cast hq) m
  rcases Nat.eq_zero_or_pos r with rfl | hr
  · simp [hX]
  have hr' : (0 : ℝ) < r := Nat.cast_pos.2 hr
  have c : (0 : ℝ) < 100 * r * (q : ℝ) ^ m := by positivity
  have h1 := mul_le_mul_of_nonneg_left hεr c.le
  rw [mul_inv_cancel₀ c.ne'] at h1
  rw [← one_div, lt_div_iff₀ hX]
  nlinarith

/-- Blueprint Definition 7.1 (`def:blocks`), separation property (7.1), quantitative form:
if `α_j ∈ Σ_{≤k}` for `j` in a finite index set `s` with `|s| ≤ 2r` (at most `2r` centers),
`σ_j ∈ ℤ` (e.g. signs `±1`), and the `i`-th coordinate of `∑ σ_j α_j` is nonzero in
`Q_S⁻¹ℤ/ℤ`, then the `i`-th coordinate of `∑ σ_j α_j ∈ E` has distance at least
`q_*^{-2rk}` from every integer. (Its denominator divides a product of at most `2rk` blocks.) -/
theorem separation_quantitative {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} {ι : Type*}
    (s : Finset ι) (hs : s.card ≤ 2 * r) (α : ι → Fin n → ZMod (blockProd S))
    (hα : ∀ j ∈ s, α j ∈ sigmaLe S k) (σ : ι → ℤ) {i : Fin n}
    (hi : (∑ j ∈ s, σ j • α j) i ≠ 0) (z : ℤ) :
    ((blockStar S : ℝ) ^ (2 * r * k))⁻¹ ≤
      |(∑ j ∈ s, σ j • ratPt (blockProd S) (α j)) i - z| := by
  set D := ∏ j ∈ s, blockProd (blockSupp S (α j)) with hDdef
  have hDy : D • (∑ j ∈ s, σ j • α j) = 0 := by
    rw [Finset.smul_sum]
    refine Finset.sum_eq_zero fun j hj => ?_
    rw [smul_comm, nsmul_eq_zero_of_dvd (Finset.dvd_prod_of_mem _ hj)
      ((nsmul_blockProd_eq_zero_iff hS (blockSupp_subset S (α j))).2 subset_rfl), smul_zero]
  have hDi : D • (∑ j ∈ s, σ j • α j) i = 0 := by
    have := congrFun hDy i
    simpa only [Pi.smul_apply, Pi.zero_apply] using this
  have hq1 : 1 ≤ blockStar S := le_trans (by norm_num) (two_le_blockStar S)
  have hDpos : 0 < D := Finset.prod_pos fun j _ =>
    blockProd_pos fun q hq => hS1 q (blockSupp_subset S (α j) hq)
  have hDle : D ≤ blockStar S ^ (2 * r * k) := by
    calc D ≤ (blockStar S ^ k) ^ s.card := by
          refine Finset.prod_le_pow_card _ _ _ fun j hj => ?_
          exact (blockProd_le_pow (blockSupp_subset S (α j))).trans
            (Nat.pow_le_pow_right hq1 (mem_sigmaLe.1 (hα j hj)))
      _ ≤ (blockStar S ^ k) ^ (2 * r) := Nat.pow_le_pow_right (Nat.one_le_pow _ _ hq1) hs
      _ = blockStar S ^ (2 * r * k) := by rw [← pow_mul, mul_comm k]
  obtain ⟨z0, hz0⟩ := ratPt_sum_zsmul_sub_mem s σ α
  have hcoord := congrArg (fun v : EuclideanSpace ℝ (Fin n) => v i) hz0
  simp only [ratPt_apply, PiLp.add_apply, latEmbed_apply] at hcoord
  have hmain := inv_le_abs_sub_int hi hDi (z0 i + z)
  have heq : (∑ j ∈ s, σ j • ratPt (blockProd S) (α j)) i - z =
      (((∑ j ∈ s, σ j • α j) i).val : ℝ) / (blockProd S) - ((z0 i + z : ℤ) : ℝ) := by
    rw [hcoord]; push_cast; ring
  rw [heq]
  refine le_trans ?_ hmain
  have hDr : (0 : ℝ) < D := Nat.cast_pos.2 hDpos
  rw [← Nat.cast_pow]
  exact inv_anti₀ hDr (by exact_mod_cast hDle)

/-- Blueprint Definition 7.1 (`def:blocks`), separation property (7.1): let `q_* = max(2, max S)`
and `0 < ε ≤ (100 r q_*^{2rk})⁻¹`. If `α_j ∈ Σ_{≤k}` (at most `2r` of them), `|σ_j| ≤ 1`
(e.g. signs `±1`) and `∑ σ_j α_j ≠ 0` in `T[Q_S]`, then for all perturbations `δ_j ∈ E` with
`‖δ_j‖_∞ ≤ 2ε` the perturbed sum `∑ σ_j (α_j + δ_j)` is not in `ℤⁿ`. -/
theorem separation {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} {ε : ℝ}
    (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹) {ι : Type*}
    (s : Finset ι) (hs : s.card ≤ 2 * r) (α : ι → Fin n → ZMod (blockProd S))
    (hα : ∀ j ∈ s, α j ∈ sigmaLe S k) (σ : ι → ℤ) (hσ : ∀ j ∈ s, |σ j| ≤ 1)
    (h : ∑ j ∈ s, σ j • α j ≠ 0) (δ : ι → EuclideanSpace ℝ (Fin n))
    (hδ : ∀ j ∈ s, ∀ i, |δ j i| ≤ 2 * ε) :
    ∑ j ∈ s, σ j • (ratPt (blockProd S) (α j) + δ j) ∉ Set.range (latEmbed (n := n)) := by
  obtain ⟨i, hi⟩ := Function.ne_iff.1 h
  rintro ⟨z, hz⟩
  have hlt := four_mul_lt_of_le_eps (q := blockStar S) (r := r) (m := 2 * r * k)
    (le_trans (by norm_num) (two_le_blockStar S)) hεr
  have hquant := separation_quantitative hS1 hS s hs α hα σ hi (z i)
  have hcoord := congrArg (fun v : EuclideanSpace ℝ (Fin n) => v i) hz
  simp only [latEmbed_apply, smul_add, Finset.sum_add_distrib, PiLp.add_apply] at hcoord
  have hsub : (∑ j ∈ s, σ j • ratPt (blockProd S) (α j)) i - z i =
      -(∑ j ∈ s, σ j • δ j) i := by rw [hcoord]; ring
  rw [hsub, abs_neg] at hquant
  have hbound : |(∑ j ∈ s, σ j • δ j) i| ≤ 4 * r * ε := by
    have e : (∑ j ∈ s, σ j • δ j) i = ∑ j ∈ s, (σ j : ℝ) * δ j i := by simp [zsmul_eq_mul]
    rw [e]
    calc |∑ j ∈ s, (σ j : ℝ) * δ j i| ≤ ∑ j ∈ s, |(σ j : ℝ) * δ j i| :=
          Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ _j ∈ s, 2 * ε := by
          refine Finset.sum_le_sum fun j hj => ?_
          rw [abs_mul]
          have h1 : |(σ j : ℝ)| ≤ 1 := by
            rw [← Int.cast_abs]; exact_mod_cast hσ j hj
          calc |(σ j : ℝ)| * |δ j i| ≤ 1 * (2 * ε) :=
                mul_le_mul h1 (hδ j hj i) (abs_nonneg _) zero_le_one
            _ = 2 * ε := one_mul _
      _ = s.card * (2 * ε) := by rw [Finset.sum_const, nsmul_eq_mul]
      _ ≤ (2 * r : ℕ) * (2 * ε) := by
          refine mul_le_mul_of_nonneg_right (by exact_mod_cast hs) (by positivity)
      _ = 4 * r * ε := by push_cast; ring
  linarith

/-- The separation property (7.1) with the non-cancellation hypothesis stated in `E`:
`∑ σ_j α_j ∉ ℤⁿ` for the embedded centers. -/
theorem separation_of_not_mem {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} {ε : ℝ}
    (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹) {ι : Type*}
    (s : Finset ι) (hs : s.card ≤ 2 * r) (α : ι → Fin n → ZMod (blockProd S))
    (hα : ∀ j ∈ s, α j ∈ sigmaLe S k) (σ : ι → ℤ) (hσ : ∀ j ∈ s, |σ j| ≤ 1)
    (h : ∑ j ∈ s, σ j • ratPt (blockProd S) (α j) ∉ Set.range (latEmbed (n := n)))
    (δ : ι → EuclideanSpace ℝ (Fin n)) (hδ : ∀ j ∈ s, ∀ i, |δ j i| ≤ 2 * ε) :
    ∑ j ∈ s, σ j • (ratPt (blockProd S) (α j) + δ j) ∉ Set.range (latEmbed (n := n)) :=
  separation hS1 hS hε hεr s hs α hα σ hσ
    (fun h0 => h ((sum_zsmul_ratPt_mem_range_iff s σ α).2 h0)) δ hδ

/-! ### Blueprint Lemma 7.2 (`lem:superorth`): superorthogonality from a singleton index -/

section Superorthogonality

/-- Elementary symmetric sums of nonnegative reals are bounded by powers of the full sum
(helper for Blueprint Lemma 7.2 (`lem:superorth`)). -/
lemma superorth_esymm_le {ι : Type*} [DecidableEq ι] (x : ι → ℝ) (hx : ∀ i, 0 ≤ x i) :
    ∀ (s : Finset ι) (l : ℕ), ∑ V ∈ s.powersetCard l, ∏ v ∈ V, x v ≤ (∑ v ∈ s, x v) ^ l := by
  intro s
  induction s using Finset.induction_on with
  | empty =>
    intro l
    cases l with
    | zero => simp
    | succ l => rw [powersetCard_eq_empty.2 (by simp)]; simp
  | @insert a s has ih =>
    intro l
    cases l with
    | zero => simp
    | succ l =>
      have hP : 0 ≤ ∑ v ∈ s, x v := sum_nonneg fun v _ => hx v
      rw [powersetCard_succ_insert has, sum_union, sum_image, sum_insert has]
      · have h1 := ih (l + 1)
        have h2 : ∑ V ∈ s.powersetCard l, ∏ v ∈ insert a V, x v
            = x a * ∑ V ∈ s.powersetCard l, ∏ v ∈ V, x v := by
          rw [mul_sum]
          refine sum_congr rfl fun V hV => ?_
          rw [prod_insert]
          exact fun h => has ((mem_powersetCard.1 hV).1 h)
        rw [h2]
        have h3 := mul_le_mul_of_nonneg_left (ih l) (hx a)
        calc _ ≤ (∑ v ∈ s, x v) ^ (l + 1) + x a * (∑ v ∈ s, x v) ^ l := add_le_add h1 h3
          _ ≤ (x a + ∑ v ∈ s, x v) ^ (l + 1) := by
            rw [pow_succ, pow_succ]
            have := pow_le_pow_left₀ hP (le_add_of_nonneg_left (hx a)) l
            nlinarith [hx a, pow_nonneg hP l]
      · intro V hV W hW hVW
        have hV' : a ∉ V := fun h => has ((mem_powersetCard.1 hV).1 h)
        have hW' : a ∉ W := fun h => has ((mem_powersetCard.1 hW).1 h)
        rw [← erase_insert hV', ← erase_insert hW']
        exact congrArg (fun U => U.erase a) hVW
      · rw [disjoint_left]
        intro V hV hV2
        obtain ⟨W, -, rfl⟩ := mem_image.1 hV2
        exact has ((mem_powersetCard.1 hV).1 (mem_insert_self a W))

open Classical in
/-- Blueprint Lemma 7.2 (`lem:superorth`), combinatorial core of the first assertion: the sum of
`∏_q a_{(i q).1} a_{(i q).2}` over all `r`-tuples of index pairs in `s` in which no index occurs
exactly once is at most `(r + 1) r^{2r} (∑_{j ∈ s} a_j²)^r`, for `a ≥ 0`. -/
lemma superorth_comb {ι : Type*} [DecidableEq ι] (s : Finset ι) (a : ι → ℝ)
    (ha : ∀ i, 0 ≤ a i) (r : ℕ) :
    ∑ i ∈ (Fintype.piFinset fun _ : Fin r => s ×ˢ s) with
        ¬ ∃ v, #{q | (i q).1 = v} + #{q | (i q).2 = v} = 1,
      ∏ q, a (i q).1 * a (i q).2
      ≤ ((r + 1) * r ^ (2 * r) : ℝ) * (∑ j ∈ s, a j ^ 2) ^ r := by
  set t := ∑ j ∈ s, a j ^ 2 with ht
  have ht0 : 0 ≤ t := sum_nonneg fun j _ => sq_nonneg _
  set M := Real.sqrt t
  have hM0 : 0 ≤ M := Real.sqrt_nonneg _
  have haM : ∀ v ∈ s, a v ≤ M := fun v hv =>
    Real.le_sqrt_of_sq_le (single_le_sum (f := fun j => a j ^ 2)
      (fun j _ => sq_nonneg _) hv)
  set NS := (Fintype.piFinset fun _ : Fin r => s ×ˢ s).filter
    (fun i : Fin r → ι × ι => ¬ ∃ v, #{q | (i q).1 = v} + #{q | (i q).2 = v} = 1)
  let V : (Fin r → ι × ι) → Finset ι := fun i =>
    (univ.image fun q => (i q).1) ∪ (univ.image fun q => (i q).2)
  let cnt : (Fin r → ι × ι) → ι → ℕ := fun i v => #{q | (i q).1 = v} + #{q | (i q).2 = v}
  let Φ : Finset ι → ℝ := fun W => t ^ (r - #W) * ∏ v ∈ W, a v ^ 2
  have hΦ0 : ∀ W, 0 ≤ Φ W := fun W => mul_nonneg (pow_nonneg ht0 _)
    (prod_nonneg fun v _ => sq_nonneg _)
  -- Step 1: rewriting the product over the positions
  have hprod : ∀ i : Fin r → ι × ι, ∏ q, a (i q).1 * a (i q).2 = ∏ v ∈ V i, a v ^ cnt i v := by
    intro i
    have key : ∀ g : Fin r → ι, univ.image g ⊆ V i →
        ∏ q, a (g q) = ∏ v ∈ V i, a v ^ #{q | g q = v} := by
      intro g hg
      rw [prod_comp (s := univ) a g]
      refine prod_subset hg fun v _ hv => ?_
      have : ({q | g q = v} : Finset (Fin r)) = ∅ := by
        rw [filter_eq_empty_iff]
        intro q _ hq
        exact hv (mem_image.2 ⟨q, mem_univ _, hq⟩)
      rw [this, card_empty, pow_zero]
    rw [prod_mul_distrib, key (fun q => (i q).1) subset_union_left,
      key (fun q => (i q).2) subset_union_right, ← prod_mul_distrib]
    refine prod_congr rfl fun v _ => ?_
    rw [← pow_add]
  -- Step 2: counting in a tuple without singletons
  have hsumcnt : ∀ i : Fin r → ι × ι, ∑ v ∈ V i, cnt i v = 2 * r := by
    intro i
    have e1 : #(univ : Finset (Fin r)) = ∑ v ∈ V i, #{q | (i q).1 = v} :=
      card_eq_sum_card_fiberwise (f := fun q => (i q).1) (fun q _ =>
        mem_union_left _ (mem_image_of_mem (f := fun q => (i q).1) (mem_univ q)))
    have e2 : #(univ : Finset (Fin r)) = ∑ v ∈ V i, #{q | (i q).2 = v} :=
      card_eq_sum_card_fiberwise (f := fun q => (i q).2) (fun q _ =>
        mem_union_right _ (mem_image_of_mem (f := fun q => (i q).2) (mem_univ q)))
    simp only [cnt, sum_add_distrib, ← e1, ← e2, card_univ, Fintype.card_fin]
    ring
  have hcnt2 : ∀ i ∈ NS, ∀ v ∈ V i, 2 ≤ cnt i v := by
    intro i hi v hv
    have hne : cnt i v ≠ 1 := fun h => (mem_filter.1 hi).2 ⟨v, h⟩
    have hpos : 0 < cnt i v := by
      rcases mem_union.1 hv with h | h
      · obtain ⟨q, -, hq⟩ := mem_image.1 h
        have : 0 < #({q | (i q).1 = v} : Finset (Fin r)) :=
          card_pos.2 ⟨q, mem_filter.2 ⟨mem_univ _, hq⟩⟩
        simp only [cnt]; omega
      · obtain ⟨q, -, hq⟩ := mem_image.1 h
        have : 0 < #({q | (i q).2 = v} : Finset (Fin r)) :=
          card_pos.2 ⟨q, mem_filter.2 ⟨mem_univ _, hq⟩⟩
        simp only [cnt]; omega
    omega
  have hVs : ∀ i ∈ NS, V i ⊆ s := by
    intro i hi v hv
    have hi' := Fintype.mem_piFinset.1 (mem_filter.1 hi).1
    rcases mem_union.1 hv with h | h
    · obtain ⟨q, -, rfl⟩ := mem_image.1 h
      exact (mem_product.1 (hi' q)).1
    · obtain ⟨q, -, rfl⟩ := mem_image.1 h
      exact (mem_product.1 (hi' q)).2
  have hVcard : ∀ i ∈ NS, #(V i) ≤ r := by
    intro i hi
    have := card_nsmul_le_sum (V i) (cnt i) 2 (hcnt2 i hi)
    rw [hsumcnt, smul_eq_mul] at this
    omega
  -- Step 3: pointwise bound for a surviving tuple
  have hpt : ∀ i ∈ NS, ∏ q, a (i q).1 * a (i q).2 ≤ Φ (V i) := by
    intro i hi
    rw [hprod]
    have h1 : ∀ v ∈ V i, a v ^ cnt i v ≤ a v ^ 2 * M ^ (cnt i v - 2) := by
      intro v hv
      have h2 := hcnt2 i hi v hv
      calc a v ^ cnt i v = a v ^ 2 * a v ^ (cnt i v - 2) := by
            rw [← pow_add]; congr 1; omega
        _ ≤ a v ^ 2 * M ^ (cnt i v - 2) :=
            mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (ha v) (haM v (hVs i hi hv)) _)
              (sq_nonneg _)
    calc ∏ v ∈ V i, a v ^ cnt i v ≤ ∏ v ∈ V i, (a v ^ 2 * M ^ (cnt i v - 2)) :=
          prod_le_prod₀ (fun v _ => pow_nonneg (ha v) _) h1
      _ = (∏ v ∈ V i, a v ^ 2) * M ^ (∑ v ∈ V i, (cnt i v - 2)) := by
          rw [prod_mul_distrib, prod_pow_eq_pow_sum]
      _ = Φ (V i) := by
          have hsub : ∑ v ∈ V i, (cnt i v - 2) = 2 * (r - #(V i)) := by
            have h3 : ∑ v ∈ V i, (cnt i v - 2) + ∑ v ∈ V i, 2 = ∑ v ∈ V i, cnt i v := by
              rw [← sum_add_distrib]
              exact sum_congr rfl fun v hv => Nat.sub_add_cancel (hcnt2 i hi v hv)
            rw [hsumcnt, sum_const, smul_eq_mul] at h3
            have := hVcard i hi
            omega
          rw [hsub, pow_mul, Real.sq_sqrt ht0, mul_comm]
  -- Step 4: grouping the tuples according to their sets of values
  have hfib : ∀ W : Finset ι, #(W) ≤ r → #{i ∈ NS | V i = W} ≤ r ^ (2 * r) := by
    intro W hW
    calc #{i ∈ NS | V i = W} ≤ #(Fintype.piFinset fun _ : Fin r => W ×ˢ W) := by
          refine card_le_card fun i hi => ?_
          obtain ⟨-, hiW⟩ := mem_filter.1 hi
          refine Fintype.mem_piFinset.2 fun q => mem_product.2 ⟨?_, ?_⟩
          · rw [← hiW]; exact mem_union_left _ (mem_image_of_mem _ (mem_univ q))
          · rw [← hiW]; exact mem_union_right _ (mem_image_of_mem _ (mem_univ q))
      _ = (#W * #W) ^ r := by simp
      _ ≤ (r * r) ^ r := Nat.pow_le_pow_left (Nat.mul_le_mul hW hW) _
      _ = r ^ (2 * r) := by rw [← pow_two, ← pow_mul, mul_comm]
  set P := s.powerset.filter (fun W => #W ≤ r)
  have hstep4 : ∑ i ∈ NS, Φ (V i) ≤ (r ^ (2 * r) : ℝ) * ∑ W ∈ P, Φ W := by
    rw [sum_comp (s := NS) Φ V, mul_sum]
    calc ∑ W ∈ NS.image V, #{i ∈ NS | V i = W} • Φ W
        ≤ ∑ W ∈ NS.image V, (r ^ (2 * r) : ℝ) * Φ W := by
          refine sum_le_sum fun W hW => ?_
          obtain ⟨i, hi, rfl⟩ := mem_image.1 hW
          rw [nsmul_eq_mul]
          refine mul_le_mul_of_nonneg_right ?_ (hΦ0 _)
          exact_mod_cast hfib _ (hVcard i hi)
      _ ≤ ∑ W ∈ P, (r ^ (2 * r) : ℝ) * Φ W := by
          refine sum_le_sum_of_subset_of_nonneg ?_ fun W _ _ =>
            mul_nonneg (by positivity) (hΦ0 W)
          intro W hW
          obtain ⟨i, hi, rfl⟩ := mem_image.1 hW
          exact mem_filter.2 ⟨mem_powerset.2 (hVs i hi), hVcard i hi⟩
  -- Step 5: summing over the cardinalities
  have hstep5 : ∑ W ∈ P, Φ W ≤ (r + 1 : ℝ) * t ^ r := by
    rw [← sum_fiberwise_of_maps_to (s := P) (t := range (r + 1)) (g := fun W => #W)
      (fun W hW => mem_range.2 (Nat.lt_succ_of_le (mem_filter.1 hW).2))]
    calc ∑ l ∈ range (r + 1), ∑ W ∈ P with #W = l, Φ W
        ≤ ∑ _l ∈ range (r + 1), t ^ r := by
          refine sum_le_sum fun l hl => ?_
          have hl' : l ≤ r := Nat.lt_succ_iff.1 (mem_range.1 hl)
          have hPl : ({W ∈ P | #W = l} : Finset (Finset ι)) = s.powersetCard l := by
            ext W
            simp only [P, mem_filter, mem_powerset, mem_powersetCard]
            constructor
            · rintro ⟨⟨h1, -⟩, h2⟩; exact ⟨h1, h2⟩
            · rintro ⟨h1, h2⟩; exact ⟨⟨h1, h2 ▸ hl'⟩, h2⟩
          rw [hPl]
          calc ∑ W ∈ s.powersetCard l, Φ W
              = t ^ (r - l) * ∑ W ∈ s.powersetCard l, ∏ v ∈ W, a v ^ 2 := by
                rw [mul_sum]
                refine sum_congr rfl fun W hW => ?_
                simp only [Φ, (mem_powersetCard.1 hW).2]
            _ ≤ t ^ (r - l) * t ^ l :=
                mul_le_mul_of_nonneg_left
                  (superorth_esymm_le (fun v => a v ^ 2) (fun v => sq_nonneg _) s l)
                  (pow_nonneg ht0 _)
            _ = t ^ r := by rw [← pow_add, Nat.sub_add_cancel hl']
      _ = (r + 1 : ℝ) * t ^ r := by simp
  calc ∑ i ∈ NS, ∏ q, a (i q).1 * a (i q).2 ≤ ∑ i ∈ NS, Φ (V i) := sum_le_sum hpt
    _ ≤ (r ^ (2 * r) : ℝ) * ((r + 1 : ℝ) * t ^ r) :=
        hstep4.trans (mul_le_mul_of_nonneg_left hstep5 (by positivity))
    _ = ((r + 1) * r ^ (2 * r) : ℝ) * t ^ r := by ring

open MeasureTheory
open scoped ENNReal

section SuperorthSingleton

variable {X : Type*} [MeasurableSpace X] {μ : Measure X}
  {𝕜 : Type*} [RCLike 𝕜] {H : Type*} [NormedAddCommGroup H] [InnerProductSpace 𝕜 H]

/-- Expansion of `‖∑_{i∈s} v_i‖^{2r} = ⟪∑ v_i, ∑ v_i⟫^r` into a sum over `r`-tuples of index pairs
(helper for Blueprint Lemma 7.2 (`lem:superorth`)). -/
lemma superorth_norm_pow_expand {ι : Type*} (s : Finset ι) (v : ι → H) (r : ℕ) :
    ((‖∑ i ∈ s, v i‖ ^ (2 * r) : ℝ) : 𝕜) =
      ∑ i ∈ (Fintype.piFinset fun _ : Fin r => s ×ˢ s),
        ∏ q, inner 𝕜 (v (i q).1) (v (i q).2) := by
  have h : inner 𝕜 (∑ i ∈ s, v i) (∑ i ∈ s, v i) =
      ∑ p ∈ s ×ˢ s, inner 𝕜 (v p.1) (v p.2) := by
    rw [sum_inner, sum_product]
    simp_rw [inner_sum]
  rw [pow_mul, RCLike.ofReal_pow, RCLike.ofReal_pow, ← inner_self_eq_norm_sq_to_K, h, sum_pow']

/-- Blueprint Lemma 7.2 (`lem:superorth`), first assertion, integrated `2r`-th moment form:
under the singleton vanishing hypothesis,
`∫ ‖∑_{i∈s} f_i‖^{2r} ≤ (r+1) r^{2r} ∫ (∑_{i∈s} ‖f_i‖²)^r`. -/
theorem superorth_singleton_integral_le {ι : Type*} [DecidableEq ι] {r : ℕ} (s : Finset ι)
    (f : ι → X → H) (hf : ∀ i ∈ s, MemLp (f i) ((2 * r : ℕ) : ℝ≥0∞) μ)
    (hvan : ∀ i : Fin r → ι × ι, (∀ q, (i q).1 ∈ s ∧ (i q).2 ∈ s) →
      (∃ v, #{q | (i q).1 = v} + #{q | (i q).2 = v} = 1) →
        ∫ x, ∏ q, inner 𝕜 (f (i q).1 x) (f (i q).2 x) ∂μ = 0) :
    ∫ x, ‖∑ i ∈ s, f i x‖ ^ (2 * r) ∂μ ≤
      ((r + 1) * r ^ (2 * r) : ℝ) * ∫ x, (∑ i ∈ s, ‖f i x‖ ^ 2) ^ r ∂μ := by
  classical
  rcases Nat.eq_zero_or_pos r with rfl | hr
  · simp
  set T := Fintype.piFinset fun _ : Fin r => s ×ˢ s
  let m : X → ℝ := fun x => ∑ j ∈ s, ‖f j x‖
  have hm0 : ∀ x, 0 ≤ m x := fun x => sum_nonneg fun j _ => norm_nonneg _
  have hfm : ∀ j ∈ s, ∀ x, ‖f j x‖ ≤ m x := fun j hj x =>
    single_le_sum (f := fun j => ‖f j x‖) (fun j _ => norm_nonneg _) hj
  have hmLp : MemLp m ((2 * r : ℕ) : ℝ≥0∞) μ :=
    memLp_finsetSum s fun j hj => (hf j hj).norm
  have hmint : Integrable (fun x => m x ^ (2 * r)) μ := by
    have := hmLp.integrable_norm_pow (by omega)
    simpa [Real.norm_of_nonneg (hm0 _)] using this
  have hmeas : ∀ j ∈ s, AEStronglyMeasurable (f j) μ := fun j hj => (hf j hj).aestronglyMeasurable
  -- the products and their absolute versions
  let P : (Fin r → ι × ι) → X → 𝕜 := fun i x => ∏ q, inner 𝕜 (f (i q).1 x) (f (i q).2 x)
  let Q : (Fin r → ι × ι) → X → ℝ := fun i x => ∏ q, ‖f (i q).1 x‖ * ‖f (i q).2 x‖
  have hT : ∀ i ∈ T, ∀ q, (i q).1 ∈ s ∧ (i q).2 ∈ s := fun i hi q =>
    mem_product.1 (Fintype.mem_piFinset.1 hi q)
  have hQm : ∀ i ∈ T, ∀ x, Q i x ≤ m x ^ (2 * r) := by
    intro i hi x
    calc Q i x ≤ ∏ _q : Fin r, m x * m x :=
          prod_le_prod₀ (fun q _ => mul_nonneg (norm_nonneg _) (norm_nonneg _))
            fun q _ => mul_le_mul (hfm _ (hT i hi q).1 x) (hfm _ (hT i hi q).2 x)
              (norm_nonneg _) (hm0 x)
      _ = m x ^ (2 * r) := by
          rw [prod_const, card_univ, Fintype.card_fin, ← pow_two, ← pow_mul]
  have hPQ : ∀ i x, ‖P i x‖ ≤ Q i x := by
    intro i x
    refine (Finset.norm_prod_le _ _).trans (prod_le_prod₀ (fun q _ => norm_nonneg _)
      fun q _ => norm_inner_le_norm _ _)
  have hQ0 : ∀ i x, 0 ≤ Q i x := fun i x =>
    prod_nonneg fun q _ => mul_nonneg (norm_nonneg _) (norm_nonneg _)
  have hPint : ∀ i ∈ T, Integrable (P i) μ := by
    intro i hi
    refine hmint.mono' ?_ (ae_of_all _ fun x => (hPQ i x).trans (hQm i hi x))
    exact Finset.aestronglyMeasurable_fun_prod _ fun q _ =>
      (hmeas _ (hT i hi q).1).inner (hmeas _ (hT i hi q).2)
  have hQint : ∀ i ∈ T, Integrable (Q i) μ := by
    intro i hi
    refine hmint.mono' ?_ (ae_of_all _ fun x => ?_)
    · exact Finset.aestronglyMeasurable_fun_prod _ fun q _ =>
        (hmeas _ (hT i hi q).1).norm.mul (hmeas _ (hT i hi q).2).norm
    · rw [Real.norm_of_nonneg (hQ0 i x)]; exact hQm i hi x
  have hgint : Integrable (fun x => (∑ i ∈ s, ‖f i x‖ ^ 2) ^ r) μ := by
    refine hmint.mono' ?_ (ae_of_all _ fun x => ?_)
    · exact ((Finset.aestronglyMeasurable_fun_sum s fun i hi => (hmeas i hi).norm.pow 2).pow r)
    · have h0 : 0 ≤ ∑ i ∈ s, ‖f i x‖ ^ 2 := sum_nonneg fun _ _ => sq_nonneg _
      rw [Real.norm_of_nonneg (pow_nonneg h0 _), pow_mul]
      refine pow_le_pow_left₀ h0 ?_ r
      calc ∑ i ∈ s, ‖f i x‖ ^ 2 ≤ ∑ i ∈ s, ‖f i x‖ * m x :=
            sum_le_sum fun i hi => by
              rw [pow_two]; exact mul_le_mul_of_nonneg_left (hfm i hi x) (norm_nonneg _)
        _ = m x ^ 2 := by rw [← sum_mul, pow_two]
  -- the expansion
  have hexp : ∀ x, ‖∑ i ∈ s, f i x‖ ^ (2 * r) = RCLike.re (∑ i ∈ T, P i x) := by
    intro x
    rw [← superorth_norm_pow_expand (𝕜 := 𝕜) s (fun i => f i x) r, RCLike.ofReal_re]
  have hsumint : Integrable (fun x => ∑ i ∈ T, P i x) μ := integrable_finsetSum _ hPint
  set NS := T.filter fun i => ¬ ∃ v, #{q | (i q).1 = v} + #{q | (i q).2 = v} = 1
  have h1 : ∫ x, ‖∑ i ∈ s, f i x‖ ^ (2 * r) ∂μ = ∑ i ∈ NS, RCLike.re (∫ x, P i x ∂μ) := by
    simp_rw [hexp]
    rw [integral_re hsumint, integral_finsetSum _ hPint, map_sum,
      ← sum_filter_add_sum_filter_not T
        (fun i => ∃ v, #{q | (i q).1 = v} + #{q | (i q).2 = v} = 1)]
    rw [sum_eq_zero (s := T.filter _) fun i hi => by
      rw [mem_filter] at hi
      rw [hvan i (hT i hi.1) hi.2, map_zero], zero_add]
  have h2 : ∀ i ∈ NS, RCLike.re (∫ x, P i x ∂μ) ≤ ∫ x, Q i x ∂μ := by
    intro i hi
    have hiT := (mem_filter.1 hi).1
    calc RCLike.re (∫ x, P i x ∂μ) ≤ ‖∫ x, P i x ∂μ‖ := RCLike.re_le_norm _
      _ ≤ ∫ x, ‖P i x‖ ∂μ := norm_integral_le_integral_norm _
      _ ≤ ∫ x, Q i x ∂μ := integral_mono (hPint i hiT).norm (hQint i hiT) (hPQ i)
  calc ∫ x, ‖∑ i ∈ s, f i x‖ ^ (2 * r) ∂μ ≤ ∑ i ∈ NS, ∫ x, Q i x ∂μ := by
        rw [h1]; exact sum_le_sum h2
    _ = ∫ x, ∑ i ∈ NS, Q i x ∂μ :=
        (integral_finsetSum _ fun i hi => hQint i (mem_filter.1 hi).1).symm
    _ ≤ ∫ x, ((r + 1) * r ^ (2 * r) : ℝ) * (∑ i ∈ s, ‖f i x‖ ^ 2) ^ r ∂μ := by
        refine integral_mono (integrable_finsetSum _ fun i hi => hQint i (mem_filter.1 hi).1)
          (hgint.const_mul _) fun x => ?_
        exact superorth_comb s (fun i => ‖f i x‖) (fun i => norm_nonneg _) r
    _ = _ := integral_const_mul _ _


/-- Blueprint Lemma 7.2 (`lem:superorth`), first assertion. Let `f_i : X → H` (`i ∈ s`, `s`
finite) be finitely many functions with values in a real or complex inner product space `H`,
each in `L^{2r}(μ)`. Suppose that every integral `∫ ∏_{q<r} ⟪f_{i_q}, f_{i'_q}⟫ dμ` vanishes
whenever some index occurs exactly once among the `2r` indices `i_0, i'_0, …, i_{r-1}, i'_{r-1}`
(an `r`-tuple of index pairs `((i_q, i'_q))_q`). Then
`‖∑_{i∈s} f_i‖_{2r} ≤ C_r ‖(∑_{i∈s} ‖f_i‖²)^{1/2}‖_{2r}` with `C_r = 2r`. -/
theorem superorth_singleton {ι : Type*} [DecidableEq ι] {r : ℕ} (s : Finset ι)
    (f : ι → X → H) (hf : ∀ i ∈ s, MemLp (f i) (ENNReal.ofReal (2 * r)) μ)
    (hvan : ∀ i : Fin r → ι × ι, (∀ q, (i q).1 ∈ s ∧ (i q).2 ∈ s) →
      (∃ v, #{q | (i q).1 = v} + #{q | (i q).2 = v} = 1) →
        ∫ x, ∏ q, inner 𝕜 (f (i q).1 x) (f (i q).2 x) ∂μ = 0) :
    eLpNorm (∑ i ∈ s, f i) (ENNReal.ofReal (2 * r)) μ ≤
      (2 * r : ℝ≥0∞) * eLpNorm (fun x => Real.sqrt (∑ i ∈ s, ‖f i x‖ ^ 2))
        (ENNReal.ofReal (2 * r)) μ := by
  rcases Nat.eq_zero_or_pos r with rfl | hr
  · have hm : AEStronglyMeasurable (∑ i ∈ s, f i) μ :=
      Finset.aestronglyMeasurable_sum s fun i hi => (hf i hi).aestronglyMeasurable
    simp [eLpNorm_exponent_zero hm]
  have hp : ENNReal.ofReal (2 * r) = ((2 * r : ℕ) : ℝ≥0∞) := by
    rw [← ENNReal.ofReal_natCast]; congr 1; push_cast; ring
  have hp0 : (0 : ℝ) < 2 * r := by positivity
  have hf' : ∀ i ∈ s, MemLp (f i) ((2 * r : ℕ) : ℝ≥0∞) μ := fun i hi => hp ▸ hf i hi
  have hmeas : ∀ j ∈ s, AEStronglyMeasurable (f j) μ :=
    fun j hj => (hf j hj).aestronglyMeasurable
  have hFLp : MemLp (fun x => ∑ i ∈ s, f i x) ((2 * r : ℕ) : ℝ≥0∞) μ := memLp_finsetSum s hf'
  have hFint := hFLp.integrable_norm_pow (by omega)
  have hmain := superorth_singleton_integral_le (𝕜 := 𝕜) s f hf' hvan
  set C : ℝ := (r + 1) * r ^ (2 * r)
  set g : X → ℝ := fun x => ∑ i ∈ s, ‖f i x‖ ^ 2
  have hg0 : ∀ x, 0 ≤ g x := fun x => sum_nonneg fun _ _ => sq_nonneg _
  have hsum : (∑ i ∈ s, f i) = fun x => ∑ i ∈ s, f i x := by ext x; simp
  have hsqm : AEStronglyMeasurable (fun x => Real.sqrt (∑ i ∈ s, ‖f i x‖ ^ 2)) μ :=
    Real.continuous_sqrt.comp_aestronglyMeasurable
      (Finset.aestronglyMeasurable_fun_sum s fun i hi => (hmeas i hi).norm.pow 2)
  rw [hsum, eLpNorm_ofReal_eq_lintegral hFLp.aestronglyMeasurable hp0,
    eLpNorm_ofReal_eq_lintegral hsqm hp0]
  have hpow : ∀ y : ℝ, 0 ≤ y → ENNReal.ofReal y ^ (2 * r : ℝ) = ENNReal.ofReal (y ^ (2 * r)) := by
    intro y hy
    rw [ENNReal.ofReal_rpow_of_nonneg hy hp0.le, show (2 * r : ℝ) = ((2 * r : ℕ) : ℝ) by
      push_cast; ring, Real.rpow_natCast]
  have hL : ∫⁻ x, ‖∑ i ∈ s, f i x‖ₑ ^ (2 * r : ℝ) ∂μ =
      ENNReal.ofReal (∫ x, ‖∑ i ∈ s, f i x‖ ^ (2 * r) ∂μ) := by
    rw [ofReal_integral_eq_lintegral_ofReal hFint (ae_of_all _ fun x => by positivity)]
    refine lintegral_congr fun x => ?_
    rw [← ofReal_norm, hpow _ (norm_nonneg _)]
  have hR : ENNReal.ofReal (∫ x, g x ^ r ∂μ) ≤
      ∫⁻ x, ‖Real.sqrt (g x)‖ₑ ^ (2 * r : ℝ) ∂μ := by
    calc ENNReal.ofReal (∫ x, g x ^ r ∂μ) ≤ ‖∫ x, g x ^ r ∂μ‖ₑ := by
          rw [Real.enorm_eq_ofReal_abs]; exact ENNReal.ofReal_le_ofReal (le_abs_self _)
      _ ≤ ∫⁻ x, ‖g x ^ r‖ₑ ∂μ := enorm_integral_le_lintegral_enorm _
      _ = _ := by
          refine lintegral_congr fun x => ?_
          rw [← ofReal_norm, ← ofReal_norm, hpow _ (norm_nonneg _),
            Real.norm_of_nonneg (pow_nonneg (hg0 x) _),
            Real.norm_of_nonneg (Real.sqrt_nonneg _), pow_mul, Real.sq_sqrt (hg0 x)]
  have hlint : ∫⁻ x, ‖∑ i ∈ s, f i x‖ₑ ^ (2 * r : ℝ) ∂μ ≤
      ENNReal.ofReal C * ∫⁻ x, ‖Real.sqrt (g x)‖ₑ ^ (2 * r : ℝ) ∂μ := by
    rw [hL]
    calc ENNReal.ofReal (∫ x, ‖∑ i ∈ s, f i x‖ ^ (2 * r) ∂μ)
        ≤ ENNReal.ofReal (C * ∫ x, g x ^ r ∂μ) := ENNReal.ofReal_le_ofReal hmain
      _ = ENNReal.ofReal C * ENNReal.ofReal (∫ x, g x ^ r ∂μ) :=
          ENNReal.ofReal_mul (by positivity)
      _ ≤ _ := by gcongr
  have hC : ENNReal.ofReal C ^ (1 / (2 * r : ℝ)) ≤ (2 * r : ℝ≥0∞) := by
    have h1 : (r + 1 : ℕ) ≤ 2 ^ (2 * r) :=
      (Nat.lt_two_pow_self).le.trans (Nat.pow_le_pow_right (by norm_num) (by omega))
    have h2 : C ≤ (2 * r : ℝ) ^ (2 * r) := by
      have h1' : (r + 1 : ℝ) ≤ 2 ^ (2 * r) := by exact_mod_cast h1
      rw [mul_pow]
      exact mul_le_mul_of_nonneg_right h1' (by positivity)
    calc ENNReal.ofReal C ^ (1 / (2 * r : ℝ))
        ≤ ENNReal.ofReal ((2 * r : ℝ) ^ (2 * r)) ^ (1 / (2 * r : ℝ)) :=
          ENNReal.rpow_le_rpow (ENNReal.ofReal_le_ofReal h2) (by positivity)
      _ = (2 * r : ℝ≥0∞) := by
          rw [← hpow _ hp0.le, ← ENNReal.rpow_mul, mul_one_div_cancel hp0.ne', ENNReal.rpow_one,
            ENNReal.ofReal_mul (by norm_num), ENNReal.ofReal_natCast]
          simp
  calc (∫⁻ x, ‖∑ i ∈ s, f i x‖ₑ ^ (2 * r : ℝ) ∂μ) ^ (1 / (2 * r : ℝ))
      ≤ (ENNReal.ofReal C * ∫⁻ x, ‖Real.sqrt (g x)‖ₑ ^ (2 * r : ℝ) ∂μ) ^ (1 / (2 * r : ℝ)) :=
        ENNReal.rpow_le_rpow hlint (by positivity)
    _ = ENNReal.ofReal C ^ (1 / (2 * r : ℝ)) *
          (∫⁻ x, ‖Real.sqrt (g x)‖ₑ ^ (2 * r : ℝ) ∂μ) ^ (1 / (2 * r : ℝ)) :=
        ENNReal.mul_rpow_of_nonneg _ _ (by positivity)
    _ ≤ _ := by gcongr


/-- Splitting a sum over `piFinset S` for `(l+1)`-tuples into the first coordinate and the tail
(helper for Blueprint Lemma 7.2 (`lem:superorth`)). -/
lemma superorth_sum_piFinset_succ {ι M : Type*} [AddCommMonoid M] {l : ℕ}
    (S : Fin (l + 1) → Finset ι) (φ : (Fin (l + 1) → ι) → M) :
    ∑ a ∈ Fintype.piFinset S, φ a =
      ∑ a0 ∈ S 0, ∑ a' ∈ Fintype.piFinset (fun j : Fin l => S j.succ), φ (Fin.cons a0 a') := by
  classical
  have h := Finset.filter_piFinset_eq_map_consEquiv S (fun _ => True)
  simp only [filter_true_of_mem (fun _ _ => trivial)] at h
  rw [h, sum_map, sum_product]
  rfl

/-- Integrability of the products `∏_q ⟪f_{i_q}, f_{i'_q}⟫` of `2r` functions in `L^{2r}`
(helper for Blueprint Lemma 7.2 (`lem:superorth`)). -/
lemma superorth_integrable_prod {ι : Type*} {r : ℕ} (hr : 0 < r) (s : Finset ι)
    (f : ι → X → H) (hf : ∀ i ∈ s, MemLp (f i) (ENNReal.ofReal (2 * r)) μ)
    (i : Fin r → ι × ι) (hi : ∀ q, (i q).1 ∈ s ∧ (i q).2 ∈ s) :
    Integrable (fun x => ∏ q, inner 𝕜 (f (i q).1 x) (f (i q).2 x)) μ := by
  have hp : ENNReal.ofReal (2 * r) = ((2 * r : ℕ) : ℝ≥0∞) := by
    rw [← ENNReal.ofReal_natCast]; congr 1; push_cast; ring
  let m : X → ℝ := fun x => ∑ j ∈ s, ‖f j x‖
  have hm0 : ∀ x, 0 ≤ m x := fun x => sum_nonneg fun j _ => norm_nonneg _
  have hfm : ∀ j ∈ s, ∀ x, ‖f j x‖ ≤ m x := fun j hj x =>
    single_le_sum (f := fun j => ‖f j x‖) (fun j _ => norm_nonneg _) hj
  have hmLp : MemLp m ((2 * r : ℕ) : ℝ≥0∞) μ :=
    memLp_finsetSum s fun j hj => (hp ▸ hf j hj).norm
  have hmint : Integrable (fun x => m x ^ (2 * r)) μ := by
    have := hmLp.integrable_norm_pow (by omega)
    simpa [Real.norm_of_nonneg (hm0 _)] using this
  refine hmint.mono' ?_ (ae_of_all _ fun x => ?_)
  · exact Finset.aestronglyMeasurable_fun_prod _ fun q _ =>
      (hf _ (hi q).1).aestronglyMeasurable.inner (hf _ (hi q).2).aestronglyMeasurable
  · calc ‖∏ q, inner 𝕜 (f (i q).1 x) (f (i q).2 x)‖
        ≤ ∏ q, ‖f (i q).1 x‖ * ‖f (i q).2 x‖ :=
          (Finset.norm_prod_le _ _).trans (prod_le_prod₀ (fun q _ => norm_nonneg _)
            fun q _ => norm_inner_le_norm _ _)
      _ ≤ ∏ _q : Fin r, m x * m x :=
          prod_le_prod₀ (fun q _ => mul_nonneg (norm_nonneg _) (norm_nonneg _))
            fun q _ => mul_le_mul (hfm _ (hi q).1 x) (hfm _ (hi q).2 x)
              (norm_nonneg _) (hm0 x)
      _ = m x ^ (2 * r) := by
          rw [prod_const, card_univ, Fintype.card_fin, ← pow_two, ← pow_mul]

end SuperorthSingleton

section SuperorthMulti

universe u

variable {X : Type*} [MeasurableSpace X] {μ : Measure X} {𝕜 : Type*} [RCLike 𝕜]

/-- Blueprint Lemma 7.2 (`lem:superorth`), iterated form used in the proof of the second
assertion: functions `g_a` indexed by `l`-tuples `a ∈ ∏_j S_j`. If every integral
`∫ ∏_{q<r} ⟪g_{a_q}, g_{a'_q}⟫` vanishes whenever for some coordinate `j` some value occurs
exactly once among the `j`-th coordinates of the `2r` tuples, then
`‖∑_a g_a‖_{2r} ≤ (2r)^l ‖(∑_a ‖g_a‖²)^{1/2}‖_{2r}`. -/
theorem superorth_multi {ι : Type u} [DecidableEq ι] {r : ℕ} (hr : 0 < r) :
    ∀ (l : ℕ) (H : Type u) [NormedAddCommGroup H] [InnerProductSpace 𝕜 H]
      (S : Fin l → Finset ι) (g : (Fin l → ι) → X → H),
      (∀ a ∈ Fintype.piFinset S, MemLp (g a) (ENNReal.ofReal (2 * r)) μ) →
      (∀ i : Fin r → (Fin l → ι) × (Fin l → ι),
        (∀ q, (i q).1 ∈ Fintype.piFinset S ∧ (i q).2 ∈ Fintype.piFinset S) →
        (∃ j v, #{q | (i q).1 j = v} + #{q | (i q).2 j = v} = 1) →
          ∫ x, ∏ q, inner 𝕜 (g (i q).1 x) (g (i q).2 x) ∂μ = 0) →
      eLpNorm (∑ a ∈ Fintype.piFinset S, g a) (ENNReal.ofReal (2 * r)) μ ≤
        (2 * r : ℝ≥0∞) ^ l * eLpNorm (fun x => Real.sqrt (∑ a ∈ Fintype.piFinset S, ‖g a x‖ ^ 2))
          (ENNReal.ofReal (2 * r)) μ := by
  intro l
  induction l with
  | zero =>
    intro H _ _ S g hg _
    have hu : Fintype.piFinset S = {Fin.elim0} := by
      ext a; simp only [Fintype.mem_piFinset, mem_singleton]
      exact ⟨fun _ => Subsingleton.elim _ _, fun _ j => j.elim0⟩
    rw [hu, sum_singleton, pow_zero, one_mul]
    simp only [sum_singleton, Real.sqrt_sq (norm_nonneg _)]
    rw [eLpNorm_norm _ (hg _ (hu ▸ mem_singleton_self _)).aestronglyMeasurable]
  | succ l ih =>
    intro H _ _ S g hg hvan
    classical
    set S0 := S 0
    set S' : Fin l → Finset ι := fun j => S j.succ
    have hcons : ∀ a0 ∈ S0, ∀ a' ∈ Fintype.piFinset S', Fin.cons a0 a' ∈ Fintype.piFinset S := by
      intro a0 h0 a' h'
      rw [Fin.mem_piFinset_iff_zero_tail]
      exact ⟨by simpa using h0, by simpa [Fin.tail] using h'⟩
    -- the first-coordinate functions
    let F : ι → X → H := fun a0 x => ∑ a' ∈ Fintype.piFinset S', g (Fin.cons a0 a') x
    -- the vector-valued functions of the tail
    let G : (Fin l → ι) → X → PiLp 2 (fun _ : S0 => H) := fun a' x =>
      WithLp.toLp 2 (fun b : S0 => g (Fin.cons (b : ι) a') x)
    set pS := Fintype.piFinset S
    set pS' := Fintype.piFinset S'
    set p := ENNReal.ofReal (2 * r)
    -- (A) the total sum is the sum of the first-coordinate functions
    have hsumF : (∑ a ∈ pS, g a) = ∑ a0 ∈ S0, F a0 := by
      ext x
      simp only [Finset.sum_apply, F]
      exact superorth_sum_piFinset_succ S (fun a => g a x)
    have hF : ∀ a0 ∈ S0, MemLp (F a0) p μ := fun a0 h0 =>
      memLp_finsetSum _ fun a' h' => hg _ (hcons a0 h0 a' h')
    -- (B) the singleton vanishing for the first-coordinate functions
    have hvanF : ∀ i : Fin r → ι × ι, (∀ q, (i q).1 ∈ S0 ∧ (i q).2 ∈ S0) →
        (∃ v, #{q | (i q).1 = v} + #{q | (i q).2 = v} = 1) →
          ∫ x, ∏ q, inner 𝕜 (F (i q).1 x) (F (i q).2 x) ∂μ = 0 := by
      rintro i hi ⟨v, hv⟩
      have h1 : ∀ x q, inner 𝕜 (F (i q).1 x) (F (i q).2 x) = ∑ t ∈ pS' ×ˢ pS',
          inner 𝕜 (g (Fin.cons (i q).1 t.1) x) (g (Fin.cons (i q).2 t.2) x) := by
        intro x q
        simp only [F]
        rw [sum_inner, sum_product]
        simp_rw [inner_sum]
        rfl
      have h2 : ∀ x, ∏ q, inner 𝕜 (F (i q).1 x) (F (i q).2 x) =
          ∑ τ ∈ Fintype.piFinset (fun _ : Fin r => pS' ×ˢ pS'),
            ∏ q, inner 𝕜 (g (Fin.cons (i q).1 (τ q).1) x) (g (Fin.cons (i q).2 (τ q).2) x) := by
        intro x
        simp_rw [h1 x]
        rw [prod_univ_sum]
      have hmemτ : ∀ τ ∈ Fintype.piFinset (fun _ : Fin r => pS' ×ˢ pS'), ∀ q,
          (Fin.cons (i q).1 (τ q).1 : Fin (l + 1) → ι) ∈ pS ∧
            (Fin.cons (i q).2 (τ q).2 : Fin (l + 1) → ι) ∈ pS := by
        intro τ hτ q
        have hτq := mem_product.1 (Fintype.mem_piFinset.1 hτ q)
        exact ⟨hcons _ (hi q).1 _ hτq.1, hcons _ (hi q).2 _ hτq.2⟩
      simp_rw [h2]
      rw [integral_finsetSum _ fun τ hτ =>
        superorth_integrable_prod hr pS g hg
          (fun q => (Fin.cons (i q).1 (τ q).1, Fin.cons (i q).2 (τ q).2)) (hmemτ τ hτ)]
      refine sum_eq_zero fun τ hτ => hvan
        (fun q => (Fin.cons (i q).1 (τ q).1, Fin.cons (i q).2 (τ q).2)) (hmemτ τ hτ)
        ⟨0, v, by simpa using hv⟩
    have h1 := superorth_singleton (𝕜 := 𝕜) S0 F hF hvanF
    -- (C) the vector-valued functions
    have hGrep : ∀ a' x, G a' x = ∑ b : S0, PiLp.single 2 b (g (Fin.cons (b : ι) a') x) := by
      intro a' x
      rw [WithLp.ext_iff]
      ext c
      simp [G, PiLp.ofLp_single, Pi.single_apply]
    have hGmeas : ∀ a' ∈ pS', AEStronglyMeasurable (G a') μ := by
      intro a' h'
      have : G a' = fun x => ∑ b : S0, PiLp.single 2 b (g (Fin.cons (b : ι) a') x) := by
        ext1 x; exact hGrep a' x
      rw [this]
      refine Finset.aestronglyMeasurable_fun_sum _ fun b _ => ?_
      have hc : Continuous fun y : H => PiLp.single 2 (β := fun _ : S0 => H) b y :=
        (PiLp.continuous_toLp 2 (fun _ : S0 => H)).comp (continuous_single (A := fun _ : S0 => H) b)
      exact hc.comp_aestronglyMeasurable (hg _ (hcons _ b.2 _ h')).aestronglyMeasurable
    have hG : ∀ a' ∈ pS', MemLp (G a') p μ := by
      intro a' h'
      have hm : MemLp (fun x => ∑ b : S0, ‖g (Fin.cons (b : ι) a') x‖) p μ :=
        memLp_finsetSum univ fun b _ => (hg _ (hcons _ b.2 _ h')).norm
      refine MemLp.of_le hm (hGmeas a' h') (ae_of_all _ fun x => ?_)
      rw [hGrep, Real.norm_of_nonneg (sum_nonneg fun _ _ => norm_nonneg _)]
      refine (norm_sum_le _ _).trans (le_of_eq ?_)
      simp [PiLp.norm_single]
    -- (D) the singleton vanishing for the vector-valued functions
    have hvanG : ∀ i : Fin r → (Fin l → ι) × (Fin l → ι),
        (∀ q, (i q).1 ∈ pS' ∧ (i q).2 ∈ pS') →
        (∃ j v, #{q | (i q).1 j = v} + #{q | (i q).2 j = v} = 1) →
          ∫ x, ∏ q, inner 𝕜 (G (i q).1 x) (G (i q).2 x) ∂μ = 0 := by
      rintro i hi ⟨j, v, hv⟩
      have h2 : ∀ x, ∏ q, inner 𝕜 (G (i q).1 x) (G (i q).2 x) =
          ∑ σ ∈ Fintype.piFinset (fun _ : Fin r => (univ : Finset S0)),
            ∏ q, inner 𝕜 (g (Fin.cons (σ q : ι) (i q).1) x)
              (g (Fin.cons (σ q : ι) (i q).2) x) := by
        intro x
        simp only [G, PiLp.inner_apply]
        rw [prod_univ_sum]
      have hmemσ : ∀ σ : Fin r → S0, ∀ q,
          (Fin.cons (σ q : ι) (i q).1 : Fin (l + 1) → ι) ∈ pS ∧
            (Fin.cons (σ q : ι) (i q).2 : Fin (l + 1) → ι) ∈ pS := fun σ q =>
        ⟨hcons _ (σ q).2 _ (hi q).1, hcons _ (σ q).2 _ (hi q).2⟩
      simp_rw [h2]
      rw [integral_finsetSum _ fun σ _ =>
        superorth_integrable_prod hr pS g hg
          (fun q => (Fin.cons (σ q : ι) (i q).1, Fin.cons (σ q : ι) (i q).2)) (hmemσ σ)]
      refine sum_eq_zero fun σ _ => hvan
        (fun q => (Fin.cons (σ q : ι) (i q).1, Fin.cons (σ q : ι) (i q).2)) (hmemσ σ)
        ⟨j.succ, v, by simpa using hv⟩
    have h2 := ih (PiLp 2 (fun _ : S0 => H)) S' G hG hvanG
    -- (E) the square functions
    have hsq1 : (fun x => Real.sqrt (∑ a0 ∈ S0, ‖F a0 x‖ ^ 2)) =
        fun x => ‖(∑ a' ∈ pS', G a') x‖ := by
      ext x
      rw [PiLp.norm_eq_of_L2, ← sum_coe_sort S0 (fun a0 => ‖F a0 x‖ ^ 2)]
      congr 1
      refine sum_congr rfl fun c _ => ?_
      simp [G, F, Finset.sum_apply]
      rfl
    have hsq2 : ∀ x, ∑ a' ∈ pS', ‖G a' x‖ ^ 2 = ∑ a ∈ pS, ‖g a x‖ ^ 2 := by
      intro x
      rw [superorth_sum_piFinset_succ S (fun a => ‖g a x‖ ^ 2), sum_comm]
      refine sum_congr rfl fun a' _ => ?_
      rw [PiLp.norm_sq_eq_of_L2, ← sum_coe_sort S0 (fun a0 => ‖g (Fin.cons a0 a') x‖ ^ 2)]
    have hGsum_meas : AEStronglyMeasurable (∑ a' ∈ pS', G a') μ :=
      Finset.aestronglyMeasurable_sum _ fun a' h' => hGmeas a' h'
    rw [hsumF]
    calc eLpNorm (∑ a0 ∈ S0, F a0) p μ
        ≤ (2 * r : ℝ≥0∞) * eLpNorm (fun x => Real.sqrt (∑ a0 ∈ S0, ‖F a0 x‖ ^ 2)) p μ := h1
      _ = (2 * r : ℝ≥0∞) * eLpNorm (∑ a' ∈ pS', G a') p μ := by
          rw [hsq1, eLpNorm_norm _ hGsum_meas]
      _ ≤ (2 * r : ℝ≥0∞) * ((2 * r : ℝ≥0∞) ^ l *
            eLpNorm (fun x => Real.sqrt (∑ a' ∈ pS', ‖G a' x‖ ^ 2)) p μ) := by gcongr
      _ = (2 * r : ℝ≥0∞) ^ (l + 1) *
            eLpNorm (fun x => Real.sqrt (∑ a ∈ pS, ‖g a x‖ ^ 2)) p μ := by
          simp_rw [hsq2]; rw [pow_succ]; ring


/-- Blueprint Lemma 7.2 (`lem:superorth`), second assertion for sets of one fixed cardinality `l`
(via random colorings, done as an exact finite average over all colorings `U → Fin l`):
`‖∑_{A ⊆ U, #A = l} f_A‖_{2r} ≤ (2rl)^l ‖(∑_{A ⊆ U, #A = l} ‖f_A‖²)^{1/2}‖_{2r}`. -/
theorem superorth_card {υ : Type u} [DecidableEq υ] {H : Type u} [NormedAddCommGroup H]
    [InnerProductSpace 𝕜 H] {r : ℕ} (hr : 0 < r) (l : ℕ) (U : Finset υ)
    (f : Finset υ → X → H)
    (hf : ∀ A ∈ U.powersetCard l, MemLp (f A) (ENNReal.ofReal (2 * r)) μ)
    (hvan : ∀ A : Fin r → Finset υ × Finset υ,
      (∀ q, (A q).1 ∈ U.powersetCard l ∧ (A q).2 ∈ U.powersetCard l) →
      (∃ u, #{q | u ∈ (A q).1} + #{q | u ∈ (A q).2} = 1) →
        ∫ x, ∏ q, inner 𝕜 (f (A q).1 x) (f (A q).2 x) ∂μ = 0) :
    eLpNorm (∑ A ∈ U.powersetCard l, f A) (ENNReal.ofReal (2 * r)) μ ≤
      (2 * r * l : ℝ≥0∞) ^ l * eLpNorm (fun x => Real.sqrt (∑ A ∈ U.powersetCard l, ‖f A x‖ ^ 2))
        (ENNReal.ofReal (2 * r)) μ := by
  classical
  set p := ENNReal.ofReal (2 * r)
  set 𝒜 := U.powersetCard l
  have hsqm : AEStronglyMeasurable (fun x => Real.sqrt (∑ A ∈ 𝒜, ‖f A x‖ ^ 2)) μ :=
    Real.continuous_sqrt.comp_aestronglyMeasurable
      (Finset.aestronglyMeasurable_fun_sum _ fun A hA => (hf A hA).aestronglyMeasurable.norm.pow 2)
  rcases Nat.eq_zero_or_pos l with rfl | hl
  · have h0 : 𝒜 = {∅} := powersetCard_zero U
    simp only [h0, sum_singleton, pow_zero, one_mul, Real.sqrt_sq (norm_nonneg _)]
    rw [eLpNorm_norm _ (hf ∅ (by simp [h0])).aestronglyMeasurable]
  by_cases hUl : l ≤ #U
  swap
  · have h0 : 𝒜 = ∅ := powersetCard_eq_empty.2 (not_le.1 hUl)
    simp only [h0, sum_empty]
    rw [eLpNorm_zero]; exact zero_le
  -- colorings of `U` with `l` colors
  let z : Fin l := ⟨0, hl⟩
  let col : (U → Fin l) → υ → Fin l := fun c u => if h : u ∈ U then c ⟨u, h⟩ else z
  let tr : (U → Fin l) → Finset υ → Prop := fun c A => ∀ j, ∃ u ∈ A, col c u = j
  let T : Finset υ → ℕ := fun A => #{c : U → Fin l | tr c A}
  set Tmin := l ^ (#U - l) with hTmin
  -- every `l`-set is transversal for at least `l ^ (#U - l)` colorings
  have hT : ∀ A ∈ 𝒜, Tmin ≤ T A := by
    intro A hA
    obtain ⟨hAU, hAl⟩ := mem_powersetCard.1 hA
    let e : A ≃ Fin l := A.equivFin.trans (finCongr hAl)
    let ext : ((U \ A : Finset υ) → Fin l) → (U → Fin l) := fun d u =>
      if h : (u : υ) ∈ A then e ⟨u, h⟩ else d ⟨u, mem_sdiff.2 ⟨u.2, h⟩⟩
    have hext_inj : Function.Injective ext := by
      intro d d' hdd
      funext w
      have hw := mem_sdiff.1 w.2
      have := congrFun hdd ⟨w, hw.1⟩
      simp only [ext, dite_eq_right hw.2] at this
      exact this
    have hext_tr : ∀ d, tr (ext d) A := by
      intro d j
      refine ⟨e.symm j, (e.symm j).2, ?_⟩
      have hU : ((e.symm j : A) : υ) ∈ U := hAU (e.symm j).2
      simp only [col, dite_eq_left hU, ext, dite_eq_left (e.symm j).2]
      simp
    calc Tmin = Fintype.card ((U \ A : Finset υ) → Fin l) := by
          rw [Fintype.card_fun, Fintype.card_fin, Fintype.card_coe, card_sdiff_of_subset hAU, hAl]
      _ = #((univ : Finset ((U \ A : Finset υ) → Fin l)).image ext) := by
          rw [card_image_of_injective _ hext_inj, card_univ]
      _ ≤ T A := by
          refine card_le_card fun c hc => ?_
          obtain ⟨d, -, rfl⟩ := mem_image.1 hc
          exact mem_filter.2 ⟨mem_univ _, hext_tr d⟩
  have hTpos : 0 < Tmin := pow_pos hl _
  have hTA0 : ∀ A ∈ 𝒜, (T A : 𝕜) ≠ 0 := fun A hA => by
    have := (hTpos.trans_le (hT A hA)).ne'
    exact_mod_cast this
  -- the average over colorings
  have hid : (∑ A ∈ 𝒜, f A) =
      ∑ c : U → Fin l, ∑ A ∈ 𝒜 with tr c A, fun x => (T A : 𝕜)⁻¹ • f A x := by
    ext x
    simp only [Finset.sum_apply]
    simp_rw [sum_filter]
    rw [sum_comm]
    refine sum_congr rfl fun A hA => ?_
    rw [← sum_filter, sum_const, ← Nat.cast_smul_eq_nsmul 𝕜, smul_smul,
      mul_inv_cancel₀ (hTA0 A hA), one_smul]
  -- the bound for a fixed coloring
  set E := eLpNorm (fun x => Real.sqrt (∑ A ∈ 𝒜, ‖f A x‖ ^ 2)) p μ
  have hc : ∀ c : U → Fin l,
      eLpNorm (∑ A ∈ 𝒜 with tr c A, fun x => (T A : 𝕜)⁻¹ • f A x) p μ ≤
        (2 * r : ℝ≥0∞) ^ l * ((Tmin : ℝ≥0∞)⁻¹ * E) := by
    intro c
    let S : Fin l → Finset υ := fun j => U.filter fun u => col c u = j
    let φ : (Fin l → υ) → Finset υ := fun a => univ.image a
    have hS : ∀ a ∈ Fintype.piFinset S, ∀ j, a j ∈ U ∧ col c (a j) = j := fun a ha j =>
      mem_filter.1 (Fintype.mem_piFinset.1 ha j)
    have hinjS : ∀ a ∈ Fintype.piFinset S, Function.Injective a := by
      intro a ha j j₂ hjj
      rw [← (hS a ha j).2, ← (hS a ha j₂).2, hjj]
    have hφmem : ∀ a ∈ Fintype.piFinset S, φ a ∈ 𝒜 ∧ tr c (φ a) := by
      intro a ha
      refine ⟨mem_powersetCard.2 ⟨fun u hu => ?_, ?_⟩,
        fun j => ⟨a j, mem_image_of_mem _ (mem_univ j), (hS a ha j).2⟩⟩
      · obtain ⟨j, -, rfl⟩ := mem_image.1 hu; exact (hS a ha j).1
      · rw [card_image_of_injective _ (hinjS a ha), card_univ, Fintype.card_fin]
    have hφinj : Set.InjOn φ (Fintype.piFinset S) := by
      intro a ha b hb hab
      funext j
      have hj : a j ∈ φ b := hab ▸ mem_image_of_mem _ (mem_univ j)
      obtain ⟨j₂, -, hj₂⟩ := mem_image.1 hj
      have : j₂ = j := by rw [← (hS b hb j₂).2, hj₂, (hS a ha j).2]
      rw [← hj₂, this]
    have himage : (Fintype.piFinset S).image φ = 𝒜.filter (tr c) := by
      ext A
      constructor
      · intro hA
        obtain ⟨a, ha, rfl⟩ := mem_image.1 hA
        exact mem_filter.2 (hφmem a ha)
      · intro hA
        obtain ⟨hA𝒜, htr⟩ := mem_filter.1 hA
        obtain ⟨hAU, hAl⟩ := mem_powersetCard.1 hA𝒜
        choose a ha hac using htr
        have hapi : a ∈ Fintype.piFinset S := Fintype.mem_piFinset.2 fun j =>
          mem_filter.2 ⟨hAU (ha j), hac j⟩
        refine mem_image.2 ⟨a, hapi, ?_⟩
        refine eq_of_subset_of_card_le (fun u hu => ?_) ?_
        · obtain ⟨j, -, rfl⟩ := mem_image.1 hu; exact ha j
        · rw [hAl, card_image_of_injective _ (hinjS a hapi), card_univ, Fintype.card_fin]
    let g : (Fin l → υ) → X → H := fun a x => (T (φ a) : 𝕜)⁻¹ • f (φ a) x
    have hG : (∑ A ∈ 𝒜 with tr c A, fun x => (T A : 𝕜)⁻¹ • f A x) =
        ∑ a ∈ Fintype.piFinset S, g a := by
      rw [← himage, sum_image hφinj]
    have hgm : ∀ a ∈ Fintype.piFinset S, MemLp (g a) p μ := fun a ha =>
      (hf _ (hφmem a ha).1).const_smul _
    have hvang : ∀ i : Fin r → (Fin l → υ) × (Fin l → υ),
        (∀ q, (i q).1 ∈ Fintype.piFinset S ∧ (i q).2 ∈ Fintype.piFinset S) →
        (∃ j v, #{q | (i q).1 j = v} + #{q | (i q).2 j = v} = 1) →
          ∫ x, ∏ q, inner 𝕜 (g (i q).1 x) (g (i q).2 x) ∂μ = 0 := by
      rintro i hi ⟨j, v, hv⟩
      have hvj : col c v = j := by
        by_contra hcon
        have h1 : #({q | (i q).1 j = v} : Finset (Fin r)) = 0 := by
          rw [card_eq_zero, filter_eq_empty_iff]
          intro q _ hq; exact hcon (hq ▸ (hS _ (hi q).1 j).2)
        have h2 : #({q | (i q).2 j = v} : Finset (Fin r)) = 0 := by
          rw [card_eq_zero, filter_eq_empty_iff]
          intro q _ hq; exact hcon (hq ▸ (hS _ (hi q).2 j).2)
        omega
      have key : ∀ a ∈ Fintype.piFinset S, (v ∈ φ a ↔ a j = v) := by
        intro a ha
        constructor
        · intro hv₂
          obtain ⟨j₂, -, hj₂⟩ := mem_image.1 hv₂
          have : j₂ = j := by rw [← (hS a ha j₂).2, hj₂, hvj]
          rw [← this]; exact hj₂
        · intro h; rw [← h]; exact mem_image_of_mem _ (mem_univ j)
      have hB := hvan (fun q => (φ (i q).1, φ (i q).2))
        (fun q => ⟨(hφmem _ (hi q).1).1, (hφmem _ (hi q).2).1⟩) ⟨v, by
          rw [filter_congr (fun q _ => key _ (hi q).1), filter_congr (fun q _ => key _ (hi q).2)]
          exact hv⟩
      have hprod : ∀ x, ∏ q, inner 𝕜 (g (i q).1 x) (g (i q).2 x) =
          (∏ q, (starRingEnd 𝕜 ((T (φ (i q).1) : 𝕜)⁻¹) * (T (φ (i q).2) : 𝕜)⁻¹)) *
            ∏ q, inner 𝕜 (f (φ (i q).1) x) (f (φ (i q).2) x) := by
        intro x
        rw [← prod_mul_distrib]
        refine prod_congr rfl fun q _ => ?_
        simp only [g, inner_smul_left, inner_smul_right]
        ring
      simp_rw [hprod]
      rw [integral_const_mul, hB, mul_zero]
    have hmain := superorth_multi (μ := μ) (𝕜 := 𝕜) hr l H S g hgm hvang
    have hgsqm : AEStronglyMeasurable
        (fun x => Real.sqrt (∑ a ∈ Fintype.piFinset S, ‖g a x‖ ^ 2)) μ :=
      Real.continuous_sqrt.comp_aestronglyMeasurable
        (Finset.aestronglyMeasurable_fun_sum _ fun a ha =>
          (hgm a ha).aestronglyMeasurable.norm.pow 2)
    have hTmin0 : (0 : ℝ) < Tmin := by exact_mod_cast hTpos
    have hpt : ∀ x, ‖Real.sqrt (∑ a ∈ Fintype.piFinset S, ‖g a x‖ ^ 2)‖ ≤
        (Tmin : ℝ)⁻¹ * Real.sqrt (∑ A ∈ 𝒜, ‖f A x‖ ^ 2) := by
      intro x
      rw [Real.norm_of_nonneg (Real.sqrt_nonneg _)]
      have h1 : ∑ a ∈ Fintype.piFinset S, ‖g a x‖ ^ 2 ≤
          ((Tmin : ℝ)⁻¹) ^ 2 * ∑ A ∈ 𝒜, ‖f A x‖ ^ 2 := by
        have h2 : ∑ a ∈ Fintype.piFinset S, ‖g a x‖ ^ 2 =
            ∑ A ∈ 𝒜 with tr c A, ‖(T A : 𝕜)⁻¹ • f A x‖ ^ 2 := by
          rw [← himage, sum_image hφinj]
        rw [h2, mul_sum]
        calc ∑ A ∈ 𝒜 with tr c A, ‖(T A : 𝕜)⁻¹ • f A x‖ ^ 2
            ≤ ∑ A ∈ 𝒜 with tr c A, ((Tmin : ℝ)⁻¹) ^ 2 * ‖f A x‖ ^ 2 := by
              refine sum_le_sum fun A hA => ?_
              have hA𝒜 := (mem_filter.1 hA).1
              rw [norm_smul, mul_pow, norm_inv, RCLike.norm_natCast]
              refine mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (by positivity) ?_ 2)
                (sq_nonneg _)
              exact inv_anti₀ hTmin0 (by exact_mod_cast hT A hA𝒜)
          _ ≤ ∑ A ∈ 𝒜, ((Tmin : ℝ)⁻¹) ^ 2 * ‖f A x‖ ^ 2 :=
              sum_le_sum_of_subset_of_nonneg (filter_subset _ _) fun _ _ _ => by positivity
      calc Real.sqrt (∑ a ∈ Fintype.piFinset S, ‖g a x‖ ^ 2)
          ≤ Real.sqrt (((Tmin : ℝ)⁻¹) ^ 2 * ∑ A ∈ 𝒜, ‖f A x‖ ^ 2) := Real.sqrt_le_sqrt h1
        _ = (Tmin : ℝ)⁻¹ * Real.sqrt (∑ A ∈ 𝒜, ‖f A x‖ ^ 2) := by
          rw [Real.sqrt_mul (by positivity), Real.sqrt_sq (by positivity)]
    have hE : eLpNorm (fun x => Real.sqrt (∑ a ∈ Fintype.piFinset S, ‖g a x‖ ^ 2)) p μ ≤
        (Tmin : ℝ≥0∞)⁻¹ * E := by
      calc _ ≤ eLpNorm (fun x => (Tmin : ℝ)⁻¹ * Real.sqrt (∑ A ∈ 𝒜, ‖f A x‖ ^ 2)) p μ :=
            eLpNorm_mono_real hgsqm hpt
        _ = (Tmin : ℝ≥0∞)⁻¹ * E := by
            have h := eLpNorm_const_smul ((Tmin : ℝ)⁻¹)
              (fun x => Real.sqrt (∑ A ∈ 𝒜, ‖f A x‖ ^ 2)) p μ
            have h' : ((Tmin : ℝ)⁻¹ • fun x => Real.sqrt (∑ A ∈ 𝒜, ‖f A x‖ ^ 2)) =
                fun x => (Tmin : ℝ)⁻¹ * Real.sqrt (∑ A ∈ 𝒜, ‖f A x‖ ^ 2) := by
              ext x; simp
            rw [← h', h]
            congr 1
            rw [enorm_inv (by positivity), Real.enorm_natCast]
    rw [hG]
    calc _ ≤ _ := hmain
      _ ≤ (2 * r : ℝ≥0∞) ^ l * ((Tmin : ℝ≥0∞)⁻¹ * E) := by gcongr
  have hp1 : 1 ≤ p := by
    rw [ENNReal.one_le_ofReal]
    have : (1 : ℝ) ≤ r := by exact_mod_cast hr
    linarith
  rw [hid]
  calc eLpNorm (∑ c : U → Fin l, ∑ A ∈ 𝒜 with tr c A, fun x => (T A : 𝕜)⁻¹ • f A x) p μ
      ≤ ∑ c : U → Fin l, eLpNorm (∑ A ∈ 𝒜 with tr c A, fun x => (T A : 𝕜)⁻¹ • f A x) p μ :=
        eLpNorm_sum_le hp1
    _ ≤ ∑ _c : U → Fin l, (2 * r : ℝ≥0∞) ^ l * ((Tmin : ℝ≥0∞)⁻¹ * E) :=
        sum_le_sum fun c _ => hc c
    _ = ((l ^ #U : ℕ) : ℝ≥0∞) * ((2 * r : ℝ≥0∞) ^ l * ((Tmin : ℝ≥0∞)⁻¹ * E)) := by
        rw [sum_const, card_univ, Fintype.card_fun, Fintype.card_fin, Fintype.card_coe,
          nsmul_eq_mul]
    _ = (2 * r * l : ℝ≥0∞) ^ l * E := by
        have h1 : ((l ^ #U : ℕ) : ℝ≥0∞) = (Tmin : ℝ≥0∞) * (l : ℝ≥0∞) ^ l := by
          rw [hTmin, ← Nat.cast_pow, ← Nat.cast_mul, ← pow_add, Nat.sub_add_cancel hUl]
        have h2 : (Tmin : ℝ≥0∞) * (Tmin : ℝ≥0∞)⁻¹ = 1 :=
          ENNReal.mul_inv_cancel (by exact_mod_cast hTpos.ne') (ENNReal.natCast_ne_top _)
        rw [h1, show (2 * r * l : ℝ≥0∞) ^ l = (2 * r : ℝ≥0∞) ^ l * (l : ℝ≥0∞) ^ l from mul_pow _ _ _]
        calc (Tmin : ℝ≥0∞) * (l : ℝ≥0∞) ^ l * ((2 * r : ℝ≥0∞) ^ l * ((Tmin : ℝ≥0∞)⁻¹ * E))
            = ((Tmin : ℝ≥0∞) * (Tmin : ℝ≥0∞)⁻¹) *
                ((2 * r : ℝ≥0∞) ^ l * (l : ℝ≥0∞) ^ l * E) := by ring
          _ = _ := by rw [h2, one_mul]


/-- Blueprint Lemma 7.2 (`lem:superorth`), second assertion. Let `U` be a finite set, `k ∈ ℕ`,
and let `f_A : X → H` (`A ⊆ U`, `#A ≤ k`) be functions in `L^{2r}(μ)` with values in a real or
complex inner product space `H`. Suppose that every integral
`∫ ∏_{q<r} ⟪f_{A_q}, f_{A'_q}⟫ dμ` (an `r`-tuple of pairs `(A_q, A'_q)` of such sets) vanishes
whenever some element `u` belongs to exactly one of the `2r` sets `A_0, A'_0, …, A_{r-1}, A'_{r-1}`.
Then `‖∑_A f_A‖_{2r} ≤ C_{k,r} ‖(∑_A ‖f_A‖²)^{1/2}‖_{2r}` (sums over `A ⊆ U`, `#A ≤ k`), with
`C_{k,r} = ∑_{l=0}^{k} (2rl)^l` depending only on `k` and `r`. -/
theorem superorth_subset {υ : Type u} [DecidableEq υ] {H : Type u} [NormedAddCommGroup H]
    [InnerProductSpace 𝕜 H] {r : ℕ} (k : ℕ) (U : Finset υ) (f : Finset υ → X → H)
    (hf : ∀ A ⊆ U, #A ≤ k → MemLp (f A) (ENNReal.ofReal (2 * r)) μ)
    (hvan : ∀ A : Fin r → Finset υ × Finset υ,
      (∀ q, ((A q).1 ⊆ U ∧ #(A q).1 ≤ k) ∧ ((A q).2 ⊆ U ∧ #(A q).2 ≤ k)) →
      (∃ u, #{q | u ∈ (A q).1} + #{q | u ∈ (A q).2} = 1) →
        ∫ x, ∏ q, inner 𝕜 (f (A q).1 x) (f (A q).2 x) ∂μ = 0) :
    eLpNorm (∑ A ∈ U.powerset with #A ≤ k, f A) (ENNReal.ofReal (2 * r)) μ ≤
      (∑ l ∈ range (k + 1), (2 * r * l : ℝ≥0∞) ^ l) *
        eLpNorm (fun x => Real.sqrt (∑ A ∈ U.powerset with #A ≤ k, ‖f A x‖ ^ 2))
          (ENNReal.ofReal (2 * r)) μ := by
  classical
  set P := U.powerset.filter fun A => #A ≤ k
  have hfP : ∀ A ∈ P, MemLp (f A) (ENNReal.ofReal (2 * r)) μ := fun A hA => by
    obtain ⟨h1, h2⟩ := mem_filter.1 hA
    exact hf A (mem_powerset.1 h1) h2
  rcases Nat.eq_zero_or_pos r with rfl | hr
  · have hm : AEStronglyMeasurable (∑ A ∈ P, f A) μ :=
      Finset.aestronglyMeasurable_sum _ fun A hA => (hfP A hA).aestronglyMeasurable
    simp [eLpNorm_exponent_zero hm]
  set p := ENNReal.ofReal (2 * r)
  have hp1 : 1 ≤ p := by
    rw [ENNReal.one_le_ofReal]
    have : (1 : ℝ) ≤ r := by exact_mod_cast hr
    linarith
  have hPl : ∀ l ∈ range (k + 1), ({A ∈ P | #A = l} : Finset (Finset υ)) = U.powersetCard l := by
    intro l hl
    have hl' : l ≤ k := Nat.lt_succ_iff.1 (mem_range.1 hl)
    ext A
    simp only [P, mem_filter, mem_powerset, mem_powersetCard]
    constructor
    · rintro ⟨⟨h1, -⟩, h2⟩; exact ⟨h1, h2⟩
    · rintro ⟨h1, h2⟩; exact ⟨⟨h1, h2 ▸ hl'⟩, h2⟩
  have hsplit : (∑ A ∈ P, f A) = ∑ l ∈ range (k + 1), ∑ A ∈ U.powersetCard l, f A := by
    rw [← sum_fiberwise_of_maps_to (s := P) (t := range (k + 1)) (g := fun A => #A)
      (fun A hA => mem_range.2 (Nat.lt_succ_of_le (mem_filter.1 hA).2))]
    exact sum_congr rfl fun l hl => by rw [hPl l hl]
  set E := eLpNorm (fun x => Real.sqrt (∑ A ∈ P, ‖f A x‖ ^ 2)) p μ
  have hl : ∀ l ∈ range (k + 1), eLpNorm (∑ A ∈ U.powersetCard l, f A) p μ ≤
      (2 * r * l : ℝ≥0∞) ^ l * E := by
    intro l hl
    have hsub : U.powersetCard l ⊆ P := by
      rw [← hPl l hl]; exact filter_subset _ _
    have h1 := superorth_card (μ := μ) (𝕜 := 𝕜) hr l U f (fun A hA => hfP A (hsub hA))
      (fun A hA hs => hvan A (fun q => by
        have h1 := mem_filter.1 (hsub (hA q).1)
        have h2 := mem_filter.1 (hsub (hA q).2)
        exact ⟨⟨mem_powerset.1 h1.1, h1.2⟩, ⟨mem_powerset.1 h2.1, h2.2⟩⟩) hs)
    refine h1.trans (mul_le_mul_right ?_ _)
    refine eLpNorm_mono_real (Real.continuous_sqrt.comp_aestronglyMeasurable
      (Finset.aestronglyMeasurable_fun_sum _ fun A hA =>
        (hfP A (hsub hA)).aestronglyMeasurable.norm.pow 2)) fun x => ?_
    rw [Real.norm_of_nonneg (Real.sqrt_nonneg _)]
    exact Real.sqrt_le_sqrt (sum_le_sum_of_subset_of_nonneg hsub fun _ _ _ => sq_nonneg _)
  rw [hsplit]
  calc eLpNorm (∑ l ∈ range (k + 1), ∑ A ∈ U.powersetCard l, f A) p μ
      ≤ ∑ l ∈ range (k + 1), eLpNorm (∑ A ∈ U.powersetCard l, f A) p μ := eLpNorm_sum_le hp1
    _ ≤ ∑ l ∈ range (k + 1), (2 * r * l : ℝ≥0∞) ^ l * E := sum_le_sum hl
    _ = _ := (sum_mul _ _ _).symm

end SuperorthMulti
end Superorthogonality


/-! ### Blueprint Lemma 7.3 (`lem:sunflower`): a weighted sunflower inequality -/

section Sunflower

variable {α : Type*} [DecidableEq α]

open scoped Nat in
/-- Blueprint Lemma 7.3 (`lem:sunflower`), sunflower step of the proof (Erdős–Rado): a family
`𝓕` of distinct `l`-element sets with `#𝓕 > l! (r-1)^l` contains `r` distinct sets
`B 0, …, B (r-1)` whose pairwise intersections are all equal (to some `A₀`). -/
theorem sunflower_erdos_rado (r : ℕ) : ∀ (l : ℕ) (𝓕 : Finset (Finset α)),
    (∀ A ∈ 𝓕, #A = l) → l ! * (r - 1) ^ l < #𝓕 →
    ∃ B : Fin r → Finset α, Function.Injective B ∧ (∀ i, B i ∈ 𝓕) ∧
      ∃ A₀, ∀ i j, i ≠ j → B i ∩ B j = A₀ := by
  intro l
  induction l with
  | zero =>
    intro 𝓕 h𝓕 hc
    exfalso
    have : #𝓕 ≤ 1 := Finset.card_le_one.2 fun a ha b hb => by
      rw [Finset.card_eq_zero.1 (h𝓕 a ha), Finset.card_eq_zero.1 (h𝓕 b hb)]
    simp at hc; omega
  | succ l ih =>
    intro 𝓕 h𝓕 hc
    classical
    set P := 𝓕.powerset.filter (fun D : Finset (Finset α) => (D : Set (Finset α)).PairwiseDisjoint id) with hP
    have hPne : P.Nonempty := ⟨∅, by simp [hP]⟩
    obtain ⟨D, hDP, hDmax⟩ := Finset.exists_max_image P Finset.card hPne
    have hDsub : D ⊆ 𝓕 := mem_powerset.1 (mem_filter.1 hDP).1
    have hDdisj : (D : Set (Finset α)).PairwiseDisjoint id := (mem_filter.1 hDP).2
    by_cases hDr : r ≤ #D
    · obtain ⟨D', hD'D, hD'c⟩ := Finset.exists_subset_card_eq hDr
      let e : Fin r ≃ D' := (D'.equivFin.trans (finCongr hD'c)).symm
      refine ⟨fun i => (e i).1, Subtype.val_injective.comp e.injective,
        fun i => hDsub (hD'D (e i).2), ∅, fun i j hij => ?_⟩
      have hne : (e i).1 ≠ (e j).1 := fun h => hij (e.injective (Subtype.val_injective h))
      exact Finset.disjoint_iff_inter_eq_empty.1
        (hDdisj (hD'D (e i).2) (hD'D (e j).2) hne)
    · push Not at hDr
      set U := D.biUnion id with hU
      have hUc : #U ≤ (r - 1) * (l + 1) := by
        calc #U ≤ ∑ A ∈ D, #A := Finset.card_biUnion_le
          _ = ∑ A ∈ D, (l + 1) := sum_congr rfl fun A hA => h𝓕 A (hDsub hA)
          _ = #D * (l + 1) := by rw [sum_const, smul_eq_mul]
          _ ≤ (r - 1) * (l + 1) := Nat.mul_le_mul_right _ (by omega)
      have hmeet : ∀ A ∈ 𝓕, ∃ x ∈ U, x ∈ A := by
        intro A hA
        by_contra hcon
        push Not at hcon
        have hAne : A.Nonempty := by
          rw [← Finset.card_pos, h𝓕 A hA]; omega
        have hAD : A ∉ D := by
          intro hAD
          obtain ⟨y, hy⟩ := hAne
          exact hcon y (mem_biUnion.2 ⟨A, hAD, hy⟩) hy
        have hins : insert A D ∈ P := by
          refine mem_filter.2 ⟨mem_powerset.2 (insert_subset hA hDsub), ?_⟩
          rw [coe_insert]
          refine hDdisj.insert fun B hB _ => ?_
          exact Finset.disjoint_left.2 fun y hyA hyB =>
            hcon y (mem_biUnion.2 ⟨B, hB, hyB⟩) hyA
        have := hDmax _ hins
        rw [card_insert_of_notMem hAD] at this
        omega
      have hex : ∃ x ∈ U, l ! * (r - 1) ^ l < #(𝓕.filter (x ∈ ·)) := by
        by_contra hcon
        push Not at hcon
        have h1 : 𝓕 ⊆ U.biUnion (fun x => 𝓕.filter (x ∈ ·)) := fun A hA => by
          obtain ⟨x, hxU, hxA⟩ := hmeet A hA
          exact mem_biUnion.2 ⟨x, hxU, mem_filter.2 ⟨hA, hxA⟩⟩
        have h2 : #𝓕 ≤ #U * (l ! * (r - 1) ^ l) := by
          calc #𝓕 ≤ #(U.biUnion (fun x => 𝓕.filter (x ∈ ·))) := card_le_card h1
            _ ≤ ∑ x ∈ U, #(𝓕.filter (x ∈ ·)) := card_biUnion_le
            _ ≤ ∑ x ∈ U, l ! * (r - 1) ^ l := sum_le_sum hcon
            _ = _ := by rw [sum_const, smul_eq_mul]
        have h3 : #U * (l ! * (r - 1) ^ l) ≤ (l + 1)! * (r - 1) ^ (l + 1) := by
          calc #U * (l ! * (r - 1) ^ l) ≤ (r - 1) * (l + 1) * (l ! * (r - 1) ^ l) :=
                Nat.mul_le_mul_right _ hUc
            _ = (l + 1)! * (r - 1) ^ (l + 1) := by
                rw [Nat.factorial_succ, pow_succ]; ring
        omega
      obtain ⟨x, -, hx⟩ := hex
      set 𝓕x := 𝓕.filter (x ∈ ·) with h𝓕x
      have hinj : Set.InjOn (fun s : Finset α => s.erase x) 𝓕x := fun a ha b hb hab =>
        Finset.erase_injOn' x (mem_filter.1 ha).2 (mem_filter.1 hb).2 hab
      have hcard : #(𝓕x.image (·.erase x)) = #𝓕x := card_image_of_injOn hinj
      obtain ⟨B', hB'inj, hB'mem, A₀', hA₀'⟩ := ih (𝓕x.image (·.erase x))
        (fun A hA => by
          obtain ⟨A', hA', rfl⟩ := mem_image.1 hA
          have := mem_filter.1 hA'
          rw [card_erase_of_mem this.2, h𝓕 A' this.1]; rfl)
        (by rw [hcard]; exact hx)
      have hB'x : ∀ i, x ∉ B' i ∧ insert x (B' i) ∈ 𝓕 := fun i => by
        obtain ⟨A', hA', hA'e⟩ := mem_image.1 (hB'mem i)
        have := mem_filter.1 hA'
        rw [← hA'e, insert_erase this.2]
        exact ⟨notMem_erase _ _, this.1⟩
      refine ⟨fun i => insert x (B' i), fun i j hij => hB'inj ?_, fun i => (hB'x i).2,
        insert x A₀', fun i j hij => ?_⟩
      · have := congrArg (·.erase x) hij
        simpa [erase_insert (hB'x i).1, erase_insert (hB'x j).1] using this
      · simp only
        rw [← insert_inter_distrib, hA₀' i j hij]

open scoped Nat in
/-- Blueprint Lemma 7.3 (`lem:sunflower`), consequence of the sunflower step: any family of at
least `M = 1 + ∑_{l=0}^k l! (r-1)^l` distinct sets of size `≤ k` contains `r` distinct sets
whose pairwise intersections are all equal. -/
theorem sunflower_of_card_le (r k : ℕ) (𝓕 : Finset (Finset α)) (h𝓕 : ∀ A ∈ 𝓕, #A ≤ k)
    (hM : 1 + ∑ l ∈ range (k + 1), l ! * (r - 1) ^ l ≤ #𝓕) :
    ∃ B : Fin r → Finset α, Function.Injective B ∧ (∀ i, B i ∈ 𝓕) ∧
      ∃ A₀, ∀ i j, i ≠ j → B i ∩ B j = A₀ := by
  have hex : ∃ l ∈ range (k + 1), l ! * (r - 1) ^ l < #(𝓕.filter (fun A => #A = l)) := by
    by_contra hcon
    push Not at hcon
    have := card_eq_sum_card_fiberwise (f := fun A => #A) (t := range (k + 1))
      (s := 𝓕) fun A hA => mem_range.2 (Nat.lt_succ_of_le (h𝓕 A hA))
    have := sum_le_sum hcon
    omega
  obtain ⟨l, -, hl⟩ := hex
  obtain ⟨B, hBinj, hBmem, A₀, hA₀⟩ :=
    sunflower_erdos_rado r l _ (fun A hA => (mem_filter.1 hA).2) hl
  exact ⟨B, hBinj, fun i => (mem_filter.1 (hBmem i)).1, A₀, hA₀⟩


/-- `B` is a sunflower tuple with core `A₀`. -/
def SunflowerCore {r : ℕ} (B : Fin r → Finset α) (A₀ : Finset α) : Prop :=
  (∀ i, A₀ ⊆ B i) ∧ ∀ i j, i ≠ j → B i ∩ B j = A₀

/-- Splitting off the first coordinate of a sum over `(Fin (m+1) → β)`-tuples. -/
lemma sum_piFinset_succ_const {β : Type*} (F : Finset β) (m : ℕ) (f : (Fin (m + 1) → β) → ℝ) :
    ∑ B ∈ Fintype.piFinset (fun _ : Fin (m + 1) => F), f B =
      ∑ A ∈ F, ∑ B ∈ Fintype.piFinset (fun _ : Fin m => F), f (Fin.cons A B) := by
  rw [← Finset.sum_product']
  refine Finset.sum_bij' (fun B _ => (B 0, Fin.tail B)) (fun p _ => Fin.cons p.1 p.2)
    ?_ ?_ ?_ ?_ ?_
  · intro B hB
    simp only [Fintype.mem_piFinset] at hB
    exact mem_product.2 ⟨hB 0, Fintype.mem_piFinset.2 fun i => hB _⟩
  · intro p hp
    obtain ⟨h1, h2⟩ := mem_product.1 hp
    rw [Fintype.mem_piFinset] at h2 ⊢
    intro i
    refine Fin.cases ?_ (fun j => ?_) i
    · simpa using h1
    · simpa using h2 j
  · intro B _; simp
  · intro p _; simp
  · intro B _; simp

/-- Light case: disjoint petals outside `Z` occur with weight `≥ W^m / 2^m`. -/
lemma sunflower_light (r : ℕ) (Z : Finset α) (F : Finset (Finset α)) (w : Finset α → ℝ)
    (hw : ∀ A ∈ F, 0 ≤ w A)
    (hlight : ∀ B ∈ F, 2 * r * ∑ A ∈ F with ¬ Disjoint (A \ Z) (B \ Z), w A ≤ ∑ A ∈ F, w A) :
    ∀ m ≤ r, (∑ A ∈ F, w A) ^ m ≤ 2 ^ m * ∑ B ∈ Fintype.piFinset (fun _ : Fin m => F) with
      (∀ i j, i ≠ j → Disjoint (B i \ Z) (B j \ Z)), ∏ i, w (B i) := by
  set W := ∑ A ∈ F, w A with hW
  have hW0 : 0 ≤ W := sum_nonneg hw
  intro m
  induction m with
  | zero => intro _; simp
  | succ m ih =>
    intro hm
    have ih := ih (by omega)
    set Sm := ∑ B ∈ Fintype.piFinset (fun _ : Fin m => F) with
      (∀ i j, i ≠ j → Disjoint (B i \ Z) (B j \ Z)), ∏ i, w (B i) with hSm
    have hprod0 : ∀ B ∈ Fintype.piFinset (fun _ : Fin m => F), 0 ≤ ∏ i, w (B i) :=
      fun B hB => prod_nonneg fun i _ => hw _ (Fintype.mem_piFinset.1 hB i)
    -- the inner sum
    have hinner : ∀ B ∈ Fintype.piFinset (fun _ : Fin m => F),
        W / 2 ≤ ∑ A ∈ F with (∀ j, Disjoint (A \ Z) (B j \ Z)), w A := by
      intro B hB
      have hBF := Fintype.mem_piFinset.1 hB
      set X := fun j => ∑ A ∈ F with ¬ Disjoint (A \ Z) (B j \ Z), w A
      have h1 : W ≤ (∑ A ∈ F with (∀ j, Disjoint (A \ Z) (B j \ Z)), w A) + ∑ j, X j := by
        simp only [X, sum_filter]
        rw [Finset.sum_comm, ← sum_add_distrib]
        refine sum_le_sum fun A hA => ?_
        split_ifs with h
        · exact le_add_of_nonneg_right (sum_nonneg fun j _ => by
            split_ifs <;> first | exact hw A hA | exact le_rfl)
        · push Not at h
          obtain ⟨j, hj⟩ := h
          rw [zero_add]
          refine le_trans ?_ (single_le_sum (f := fun j => if ¬ Disjoint (A \ Z) (B j \ Z)
            then w A else 0) (fun j _ => by split_ifs <;> first | exact hw A hA | exact le_rfl)
            (mem_univ j))
          simp [hj]
      have h2 : 2 * r * ∑ j, X j ≤ r * W := by
        rw [mul_sum]
        calc ∑ j, 2 * r * X j ≤ ∑ _j : Fin m, W := sum_le_sum fun j _ => hlight _ (hBF j)
          _ = m * W := by simp
          _ ≤ r * W := mul_le_mul_of_nonneg_right (by exact_mod_cast (by omega : m ≤ r)) hW0
      have hr : (0 : ℝ) < r := by exact_mod_cast (by omega : 0 < r)
      have h3 : 2 * ∑ j, X j ≤ W := by
        have : r * (2 * ∑ j, X j) ≤ r * W := by linarith
        exact le_of_mul_le_mul_left this hr
      linarith
    have hstep : W / 2 * Sm ≤ ∑ B ∈ Fintype.piFinset (fun _ : Fin (m + 1) => F) with
        (∀ i j, i ≠ j → Disjoint (B i \ Z) (B j \ Z)), ∏ i, w (B i) := by
      rw [sum_filter, sum_piFinset_succ_const, hSm, sum_filter, mul_sum]
      calc ∑ B ∈ Fintype.piFinset (fun _ : Fin m => F), W / 2 *
            (if ∀ i j, i ≠ j → Disjoint (B i \ Z) (B j \ Z) then ∏ i, w (B i) else 0)
          ≤ ∑ B ∈ Fintype.piFinset (fun _ : Fin m => F),
            ∑ A ∈ F, (if (∀ i j, i ≠ j → Disjoint (B i \ Z) (B j \ Z)) ∧
              (∀ j, Disjoint (A \ Z) (B j \ Z)) then w A * ∏ i, w (B i) else 0) := by
            refine sum_le_sum fun B hB => ?_
            split_ifs with hB'
            · simp only [and_iff_right hB']
              rw [← sum_filter, ← sum_mul]
              exact mul_le_mul_of_nonneg_right (hinner B hB) (hprod0 B hB)
            · rw [mul_zero]
              exact sum_nonneg fun A _ => by
                split_ifs with h
                · exact absurd h.1 hB'
                · exact le_rfl
        _ = ∑ A ∈ F, ∑ B ∈ Fintype.piFinset (fun _ : Fin m => F),
            (if (∀ i j, i ≠ j → Disjoint (B i \ Z) (B j \ Z)) ∧
              (∀ j, Disjoint (A \ Z) (B j \ Z)) then w A * ∏ i, w (B i) else 0) := sum_comm
        _ ≤ _ := by
            refine sum_le_sum fun A hA => sum_le_sum fun B hB => ?_
            split_ifs with h h'
            · rw [Fin.prod_univ_succ]; simp
            · exfalso; apply h'
              intro i j hij
              induction i using Fin.cases with
              | zero =>
                induction j using Fin.cases with
                | zero => exact absurd rfl hij
                | succ j => simpa using h.2 j
              | succ i =>
                induction j using Fin.cases with
                | zero => simpa using (h.2 i).symm
                | succ j => simpa using h.1 i j (fun e => hij (by rw [e]))
            · rw [Fin.prod_univ_succ]
              simp only [Fin.cons_zero, Fin.cons_succ]
              exact mul_nonneg (hw A hA) (hprod0 B hB)
            · exact le_rfl
    calc W ^ (m + 1) = W * W ^ m := by ring
      _ ≤ W * (2 ^ m * Sm) := mul_le_mul_of_nonneg_left ih hW0
      _ = 2 ^ (m + 1) * (W / 2 * Sm) := by ring
      _ ≤ _ := mul_le_mul_of_nonneg_left hstep (by positivity)

/-- Weight of sets meeting `B` outside `Z` is at most the sum of element weights over `B \ Z`. -/
lemma sum_not_disjoint_le (Z B : Finset α) (F : Finset (Finset α)) (w : Finset α → ℝ)
    (hw : ∀ A ∈ F, 0 ≤ w A) :
    ∑ A ∈ F with ¬ Disjoint (A \ Z) (B \ Z), w A ≤
      ∑ x ∈ B \ Z, ∑ A ∈ F with x ∈ A, w A := by
  simp only [sum_filter]
  rw [Finset.sum_comm]
  refine sum_le_sum fun A hA => ?_
  have hnn : 0 ≤ ∑ x ∈ B \ Z, if x ∈ A then w A else 0 :=
    sum_nonneg fun j _ => by split_ifs <;> first | exact hw A hA | exact le_rfl
  by_cases h : Disjoint (A \ Z) (B \ Z)
  · simpa [h] using hnn
  · obtain ⟨x, hxA, hxB⟩ := Finset.not_disjoint_iff.1 h
    have := single_le_sum (f := fun x => if x ∈ A then w A else 0)
      (fun j _ => by split_ifs <;> first | exact hw A hA | exact le_rfl) hxB
    simpa [h, (mem_sdiff.1 hxA).1] using this

/-- The explicit constant `C_{k,r} = (2(r+1)(k+1))^{r(k+1)}` of the weighted sunflower
inequality. -/
noncomputable def sunflowerConst (k r : ℕ) : ℝ := (2 * (r + 1) * (k + 1) : ℝ) ^ (r * (k + 1))

/-- The constant `sunflowerConst k r` is at least `1`. -/
lemma one_le_sunflowerConst (k r : ℕ) : 1 ≤ sunflowerConst k r :=
  one_le_pow₀ (by nlinarith [(Nat.cast_nonneg r : (0:ℝ) ≤ r), (Nat.cast_nonneg k : (0:ℝ) ≤ k)])

open Classical in
/-- Light case of `sunflower_core`: every element outside `Z` has small weight. -/
lemma sunflower_core_light (r k : ℕ) (Z : Finset α) (F : Finset (Finset α))
    (w : Finset α → ℝ) (hF : ∀ A ∈ F, Z ⊆ A ∧ #(A \ Z) ≤ k) (hw : ∀ A ∈ F, 0 ≤ w A)
    (hl : ∀ x ∉ Z, 2 * r * (k : ℝ) * ∑ A ∈ F with x ∈ A, w A ≤ ∑ A ∈ F, w A) :
    (∑ A ∈ F, w A) ^ r ≤ sunflowerConst k r *
      ∑ B ∈ Fintype.piFinset (fun _ : Fin r => F) with (∃ A₀, SunflowerCore B A₀),
        ∏ i, w (B i) := by
  set W := ∑ A ∈ F, w A with hW
  have hW0 : 0 ≤ W := sum_nonneg hw
  have hr0 : (0 : ℝ) ≤ r := Nat.cast_nonneg r
  have hlight : ∀ B ∈ F, 2 * r * ∑ A ∈ F with ¬ Disjoint (A \ Z) (B \ Z), w A ≤ W := by
    intro B hB
    have h1 := sum_not_disjoint_le Z B F w hw
    have h1' := mul_le_mul_of_nonneg_left h1 (by positivity : (0 : ℝ) ≤ 2 * r)
    refine h1'.trans ?_
    have h2 : (k : ℝ) * (2 * r * ∑ x ∈ B \ Z, ∑ A ∈ F with x ∈ A, w A) ≤ k * W := by
      rw [mul_sum, mul_sum]
      calc ∑ x ∈ B \ Z, (k : ℝ) * (2 * r * ∑ A ∈ F with x ∈ A, w A) ≤ ∑ _x ∈ B \ Z, W :=
            sum_le_sum fun x hx => by have := hl x (mem_sdiff.1 hx).2; linarith
        _ = #(B \ Z) * W := by simp
        _ ≤ k * W := mul_le_mul_of_nonneg_right (by exact_mod_cast (hF B hB).2) hW0
    rcases Nat.eq_zero_or_pos k with hk | hk
    · have : B \ Z = ∅ := card_eq_zero.1 (by have := (hF B hB).2; omega)
      rw [this]; simpa using hW0
    · have hk' : (0 : ℝ) < k := by exact_mod_cast hk
      exact le_of_mul_le_mul_left h2 hk'
  have hmain := sunflower_light r Z F w hw hlight r le_rfl
  have hsub : ∑ B ∈ Fintype.piFinset (fun _ : Fin r => F) with
        (∀ i j, i ≠ j → Disjoint (B i \ Z) (B j \ Z)), ∏ i, w (B i) ≤
      ∑ B ∈ Fintype.piFinset (fun _ : Fin r => F) with (∃ A₀, SunflowerCore B A₀),
        ∏ i, w (B i) := by
    refine sum_le_sum_of_subset_of_nonneg (fun B hB => ?_) (fun B hB _ => ?_)
    · obtain ⟨hB1, hB2⟩ := mem_filter.1 hB
      refine mem_filter.2 ⟨hB1, Z, fun i => (hF _ (Fintype.mem_piFinset.1 hB1 i)).1,
        fun i j hij => ?_⟩
      ext x
      simp only [mem_inter]
      constructor
      · rintro ⟨hxi, hxj⟩
        by_contra hxZ
        exact Finset.disjoint_left.1 (hB2 i j hij) (mem_sdiff.2 ⟨hxi, hxZ⟩)
          (mem_sdiff.2 ⟨hxj, hxZ⟩)
      · intro hxZ
        exact ⟨(hF _ (Fintype.mem_piFinset.1 hB1 i)).1 hxZ,
          (hF _ (Fintype.mem_piFinset.1 hB1 j)).1 hxZ⟩
    · exact prod_nonneg fun i _ =>
        hw _ (Fintype.mem_piFinset.1 (mem_filter.1 hB).1 i)
  have hC : (2 : ℝ) ^ r ≤ sunflowerConst k r := by
    unfold sunflowerConst
    have hk0 : (0 : ℝ) ≤ k := Nat.cast_nonneg k
    calc (2 : ℝ) ^ r ≤ 2 ^ (r * (k + 1)) :=
          pow_le_pow_right₀ (by norm_num) (Nat.le_mul_of_pos_right r (Nat.succ_pos k))
      _ ≤ _ := pow_le_pow_left₀ (by norm_num) (by nlinarith) _
  have hS0 : 0 ≤ ∑ B ∈ Fintype.piFinset (fun _ : Fin r => F) with (∃ A₀, SunflowerCore B A₀),
        ∏ i, w (B i) :=
    sum_nonneg fun B hB => prod_nonneg fun i _ =>
      hw _ (Fintype.mem_piFinset.1 (mem_filter.1 hB).1 i)
  calc W ^ r ≤ 2 ^ r * _ := hmain
    _ ≤ 2 ^ r * _ := mul_le_mul_of_nonneg_left hsub (by positivity)
    _ ≤ _ := mul_le_mul_of_nonneg_right hC hS0

open Classical in
/-- Relative form of the weighted sunflower inequality: sets containing `Z` with at most `k`
further elements. -/
theorem sunflower_core (r : ℕ) : ∀ (k : ℕ) (Z : Finset α) (F : Finset (Finset α))
    (w : Finset α → ℝ), (∀ A ∈ F, Z ⊆ A ∧ #(A \ Z) ≤ k) → (∀ A ∈ F, 0 ≤ w A) →
    (∑ A ∈ F, w A) ^ r ≤ sunflowerConst k r *
      ∑ B ∈ Fintype.piFinset (fun _ : Fin r => F) with (∃ A₀, SunflowerCore B A₀),
        ∏ i, w (B i) := by
  intro k
  induction k with
  | zero =>
    intro Z F w hF hw
    exact sunflower_core_light r 0 Z F w hF hw (fun x _ => by simpa using sum_nonneg hw)
  | succ k ih =>
    intro Z F w hF hw
    set W := ∑ A ∈ F, w A with hW
    have hW0 : 0 ≤ W := sum_nonneg hw
    by_cases hh : ∃ x ∉ Z, W < 2 * r * ((k + 1 : ℕ) : ℝ) * ∑ A ∈ F with x ∈ A, w A
    · obtain ⟨x, hxZ, hx⟩ := hh
      have hF' : ∀ A ∈ F.filter (x ∈ ·), insert x Z ⊆ A ∧ #(A \ insert x Z) ≤ k := by
        intro A hA
        obtain ⟨hAF, hxA⟩ := mem_filter.1 hA
        refine ⟨insert_subset hxA (hF A hAF).1, ?_⟩
        rw [sdiff_insert, card_erase_of_mem (mem_sdiff.2 ⟨hxA, hxZ⟩)]
        have := (hF A hAF).2
        omega
      have h1 := ih (insert x Z) (F.filter (x ∈ ·)) w hF' (fun A hA => hw A (mem_filter.1 hA).1)
      have hsub : ∑ B ∈ Fintype.piFinset (fun _ : Fin r => F.filter (x ∈ ·)) with
            (∃ A₀, SunflowerCore B A₀), ∏ i, w (B i) ≤
          ∑ B ∈ Fintype.piFinset (fun _ : Fin r => F) with (∃ A₀, SunflowerCore B A₀),
            ∏ i, w (B i) := by
        refine sum_le_sum_of_subset_of_nonneg (fun B hB => ?_) (fun B hB _ => ?_)
        · obtain ⟨hB1, hB2⟩ := mem_filter.1 hB
          exact mem_filter.2 ⟨Fintype.mem_piFinset.2 fun i =>
            (mem_filter.1 (Fintype.mem_piFinset.1 hB1 i)).1, hB2⟩
        · exact prod_nonneg fun i _ =>
            hw _ (Fintype.mem_piFinset.1 (mem_filter.1 hB).1 i)
      have hS0 : 0 ≤ ∑ B ∈ Fintype.piFinset (fun _ : Fin r => F.filter (x ∈ ·)) with
            (∃ A₀, SunflowerCore B A₀), ∏ i, w (B i) :=
        sum_nonneg fun B hB => prod_nonneg fun i _ =>
          hw _ (mem_filter.1 (Fintype.mem_piFinset.1 (mem_filter.1 hB).1 i)).1
      have hr0 : (0 : ℝ) ≤ r := Nat.cast_nonneg r
      have hk0 : (0 : ℝ) ≤ k := Nat.cast_nonneg k
      have hC : (2 * r * ((k + 1 : ℕ) : ℝ)) ^ r * sunflowerConst k r ≤
          sunflowerConst (k + 1) r := by
        unfold sunflowerConst
        push_cast
        rw [show r * (k + 1 + 1) = r + r * (k + 1) by ring, pow_add]
        exact mul_le_mul (pow_le_pow_left₀ (by positivity) (by nlinarith) _)
          (pow_le_pow_left₀ (by positivity) (by nlinarith) _) (by positivity) (by positivity)
      calc W ^ r ≤ (2 * r * ((k + 1 : ℕ) : ℝ) * ∑ A ∈ F with x ∈ A, w A) ^ r :=
            pow_le_pow_left₀ hW0 hx.le r
        _ = (2 * r * ((k + 1 : ℕ) : ℝ)) ^ r * (∑ A ∈ F with x ∈ A, w A) ^ r := mul_pow _ _ _
        _ ≤ (2 * r * ((k + 1 : ℕ) : ℝ)) ^ r * (sunflowerConst k r *
            ∑ B ∈ Fintype.piFinset (fun _ : Fin r => F.filter (x ∈ ·)) with
              (∃ A₀, SunflowerCore B A₀), ∏ i, w (B i)) := by
            refine mul_le_mul_of_nonneg_left ?_ (by positivity)
            simpa [sum_filter] using h1
        _ ≤ (2 * r * ((k + 1 : ℕ) : ℝ)) ^ r * (sunflowerConst k r *
            ∑ B ∈ Fintype.piFinset (fun _ : Fin r => F) with
              (∃ A₀, SunflowerCore B A₀), ∏ i, w (B i)) := by
            refine mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hsub ?_) (by positivity)
            exact zero_le_one.trans (one_le_sunflowerConst k r)
        _ ≤ _ := by
            rw [← mul_assoc]
            exact mul_le_mul_of_nonneg_right hC (hS0.trans hsub)
    · push Not at hh
      exact sunflower_core_light r (k + 1) Z F w hF hw hh

/-- Blueprint Lemma 7.3 (`lem:sunflower`), inequality (7.2) (`eq:weightedflower`): for weights
`w_A ≥ 0` on the subsets `A ⊆ S` with `|A| ≤ k`,
`(∑_A w_A)^r ≤ C_{k,r} ∑_{A₀} ∑_{(A_1,…,A_r)} ∏_{i=1}^r w_{A₀ ∪ A_i}`, where `A₀` ranges over
the subsets of `S` with `|A₀| ≤ k` and the inner sum over `r`-tuples of pairwise disjoint
(possibly empty) petals `A_i ⊆ S \ A₀` with `|A₀ ∪ A_i| ≤ k`. The constant is
`C_{k,r} = sunflowerConst k r = (2(r+1)(k+1))^{r(k+1)}`, depending only on `k` and `r`. -/
theorem weighted_sunflower (S : Finset α) (k r : ℕ) (w : Finset α → ℝ)
    (hw : ∀ A ⊆ S, #A ≤ k → 0 ≤ w A) :
    (∑ A ∈ S.powerset with #A ≤ k, w A) ^ r ≤ sunflowerConst k r *
      ∑ A₀ ∈ S.powerset with #A₀ ≤ k,
        ∑ t ∈ Fintype.piFinset (fun _ : Fin r => (S \ A₀).powerset) with
            ((∀ i j, i ≠ j → Disjoint (t i) (t j)) ∧ ∀ i, #(A₀ ∪ t i) ≤ k),
          ∏ i, w (A₀ ∪ t i) := by
  classical
  set F := S.powerset.filter (fun A => #A ≤ k) with hFdef
  have hFmem : ∀ A, A ∈ F ↔ A ⊆ S ∧ #A ≤ k := fun A => by simp [hFdef]
  have hwF : ∀ A ∈ F, 0 ≤ w A := fun A hA => hw A ((hFmem A).1 hA).1 ((hFmem A).1 hA).2
  have h := sunflower_core r k ∅ F w
    (fun A hA => ⟨empty_subset _, by simpa using ((hFmem A).1 hA).2⟩) hwF
  refine h.trans (mul_le_mul_of_nonneg_left ?_ (zero_le_one.trans (one_le_sunflowerConst k r)))
  set T : Finset α → Finset (Fin r → Finset α) := fun A₀ =>
    (Fintype.piFinset (fun _ : Fin r => (S \ A₀).powerset)).filter
      (fun t => (∀ i j, i ≠ j → Disjoint (t i) (t j)) ∧ ∀ i, #(A₀ ∪ t i) ≤ k) with hT
  refine le_trans ?_ (Finset.sum_sigma F T (fun p => ∏ i, w (p.1 ∪ p.2 i))).le
  set G := (Fintype.piFinset (fun _ : Fin r => F)).filter (fun B => ∃ A₀, SunflowerCore B A₀)
  have hGmem : ∀ B ∈ G, (∀ i, B i ∈ F) ∧ ∃ A₀, SunflowerCore B A₀ := fun B hB => by
    obtain ⟨h1, h2⟩ := mem_filter.1 hB
    exact ⟨Fintype.mem_piFinset.1 h1, h2⟩
  have hcore : ∀ B ∈ G, ∃ A₀ ∈ F, SunflowerCore B A₀ := by
    intro B hB
    obtain ⟨hBF, A₀, hA₀⟩ := hGmem B hB
    rcases Nat.eq_zero_or_pos r with hr | hr
    · refine ⟨∅, (hFmem ∅).2 ⟨empty_subset _, by simp⟩, fun i => ?_, fun i => ?_⟩
      · exact absurd i.2 (by omega)
      · exact absurd i.2 (by omega)
    · have h0 := (hFmem _).1 (hBF ⟨0, hr⟩)
      exact ⟨A₀, (hFmem _).2 ⟨(hA₀.1 _).trans h0.1, (card_le_card (hA₀.1 _)).trans h0.2⟩, hA₀⟩
  let c : (Fin r → Finset α) → Finset α := fun B =>
    if h : ∃ A₀ ∈ F, SunflowerCore B A₀ then h.choose else ∅
  have hc : ∀ B ∈ G, c B ∈ F ∧ SunflowerCore B (c B) := fun B hB => by
    simp only [c]
    split_ifs with h'
    · exact h'.choose_spec
    · exact absurd (hcore B hB) h'
  let φ : (Fin r → Finset α) → (Σ _ : Finset α, Fin r → Finset α) :=
    fun B => ⟨c B, fun i => B i \ c B⟩
  refine sum_le_sum_of_injOn φ ?_ ?_ ?_ ?_
  · intro B₁ hB₁ B₂ hB₂ he
    simp only [φ, Sigma.mk.inj_iff, heq_eq_eq] at he
    obtain ⟨he1, he2⟩ := he
    funext i
    rw [← union_sdiff_of_subset ((hc B₁ hB₁).2.1 i), ← union_sdiff_of_subset ((hc B₂ hB₂).2.1 i),
      ← he1]
    have := congrFun he2 i
    rw [← he1] at this
    rw [this]
  · intro p hp
    obtain ⟨B, hB, rfl⟩ := mem_image.1 hp
    obtain ⟨hcF, hcore1, hcore2⟩ := hc B hB
    have hBF := (hGmem B hB).1
    refine mem_sigma.2 ⟨hcF, mem_filter.2 ⟨Fintype.mem_piFinset.2 fun i => ?_, ?_, fun i => ?_⟩⟩
    · exact mem_powerset.2 (sdiff_subset_sdiff ((hFmem _).1 (hBF i)).1 le_rfl)
    · intro i j hij
      refine Finset.disjoint_left.2 fun x hxi hxj => ?_
      have : x ∈ B i ∩ B j := mem_inter.2 ⟨(mem_sdiff.1 hxi).1, (mem_sdiff.1 hxj).1⟩
      rw [hcore2 i j hij] at this
      exact (mem_sdiff.1 hxi).2 this
    · show #(c B ∪ (B i \ c B)) ≤ k
      rw [union_sdiff_of_subset (hcore1 i)]
      exact ((hFmem _).1 (hBF i)).2
  · intro B hB
    show ∏ i, w (B i) ≤ ∏ i, w (c B ∪ (B i \ c B))
    refine le_of_eq (prod_congr rfl fun i _ => ?_)
    rw [union_sdiff_of_subset ((hc B hB).2.1 i)]
  · intro p hp _
    obtain ⟨hp1, hp2⟩ := mem_sigma.1 hp
    obtain ⟨hp3, -, hp4⟩ := mem_filter.1 hp2
    refine prod_nonneg fun i _ => hw _ ?_ (hp4 i)
    have h1 := ((hFmem _).1 hp1).1
    have h2 := mem_powerset.1 (Fintype.mem_piFinset.1 hp3 i)
    exact union_subset h1 (h2.trans sdiff_subset)

end Sunflower

/-! ### Blueprint Lemma 7.4 (`lem:blockorthog`): two Fourier orthogonality statements -/

section BlockOrthog

open MeasureTheory
open scoped Pointwise ComplexConjugate

/-- The neighborhood `α + [-ε, ε]ⁿ + ℤⁿ` of the rational center `α ∈ T[Q]` in `E` (Fourier
supports in Blueprint Lemma 7.4 (`lem:blockorthog`)). -/
def ratNbhd (Q : ℕ) (ε : ℝ) (α : Fin n → ZMod Q) : Set (EuclideanSpace ℝ (Fin n)) :=
  {ξ | ∃ z : Fin n → ℤ, ∀ i, |ξ i - ratPt Q α i - z i| ≤ ε}

/-- Points of the cube `α + [-ε, ε]ⁿ` lie in `ratNbhd Q ε α`. -/
lemma mem_ratNbhd_of_abs_le {Q : ℕ} {ε : ℝ} {α : Fin n → ZMod Q}
    {ξ : EuclideanSpace ℝ (Fin n)} (h : ∀ i, |ξ i - ratPt Q α i| ≤ ε) :
    ξ ∈ ratNbhd Q ε α :=
  ⟨0, fun i => by simpa using h i⟩

/-- `f_A = ∑_{α ∈ Σ_A} f_α` of Blueprint Lemma 7.4 (`lem:blockorthog`). -/
noncomputable def blockFun (S : Finset ℕ) [NeZero (blockProd S)]
    (f : (Fin n → ZMod (blockProd S)) → (Fin n → ℤ) → ℂ) (A : Finset ℕ) (x : Fin n → ℤ) : ℂ :=
  ∑ α ∈ sigmaBlock S A, f α x

/-- `f_{A₀,α} = ∑_{β ∈ Σ_{A₀}} f_{α+β}` of Blueprint Lemma 7.4 (`lem:blockorthog`). -/
noncomputable def cosetFun (S : Finset ℕ) [NeZero (blockProd S)]
    (f : (Fin n → ZMod (blockProd S)) → (Fin n → ℤ) → ℂ) (A₀ : Finset ℕ)
    (α : Fin n → ZMod (blockProd S)) (x : Fin n → ℤ) : ℂ :=
  ∑ β ∈ sigmaBlock S A₀, f (α + β) x

/-- `Σ_{A₁} ⊆ Σ^{A₀}` for `A₁` disjoint from `A₀` with `|A₀| + |A₁| ≤ k`. -/
lemma sigmaBlock_subset_sigmaUpper (S : Finset ℕ) [NeZero (blockProd S)] {k : ℕ}
    {A₀ A₁ : Finset ℕ} (hd : Disjoint A₁ A₀) (hk : A₁.card + A₀.card ≤ k) :
    sigmaBlock (n := n) S A₁ ⊆ sigmaUpper S k A₀ := by
  intro x hx
  rw [mem_sigmaBlock] at hx
  rw [mem_sigmaUpper, hx]
  exact ⟨hd, hk⟩

/-- The direct block decomposition `f_{A₀ ∪ A₁} = ∑_{α ∈ Σ_{A₁}} f_{A₀,α}` for disjoint `A₁, A₀`
(used in Blueprint Lemma 7.5 (`lem:normdescription`)). -/
theorem blockFun_union_eq_sum_cosetFun {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] (f : (Fin n → ZMod (blockProd S)) → (Fin n → ℤ) → ℂ)
    {A₀ A₁ : Finset ℕ} (hd : Disjoint A₁ A₀) (x : Fin n → ℤ) :
    blockFun S f (A₀ ∪ A₁) x = ∑ α ∈ sigmaBlock S A₁, cosetFun S f A₀ α x :=
  sum_sigmaBlock_union hS hd (fun α => f α x)

/-- Separation of Fourier supports: for centers `a_q, b_q ∈ Σ_{≤k}` (`q < r`) with
`∑ a_q ≠ ∑ b_q`, the neighborhoods `∑_q (a_q + [-ε,ε]ⁿ) + ℤⁿ` and `∑_q (b_q + [-ε,ε]ⁿ) + ℤⁿ` are
disjoint (helper for Blueprint Lemma 7.4 (`lem:blockorthog`), via the separation property (7.1)). -/
theorem disjoint_sum_ratNbhd {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} {ε : ℝ}
    (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    (a b : Fin r → Fin n → ZMod (blockProd S)) (ha : ∀ q, a q ∈ sigmaLe S k)
    (hb : ∀ q, b q ∈ sigmaLe S k) (hne : ∑ q, a q ≠ ∑ q, b q) :
    Disjoint ((∑ q, ratNbhd (blockProd S) ε (a q)) + Set.range (latEmbed (n := n)))
      ((∑ q, ratNbhd (blockProd S) ε (b q)) + Set.range (latEmbed (n := n))) := by
  rw [Set.disjoint_left]
  rintro ξ ⟨x, hx, _, ⟨w, rfl⟩, rfl⟩ ⟨y, hy, _, ⟨w', rfl⟩, hxy⟩
  obtain ⟨g, hg, rfl⟩ := (Set.mem_finsetSum _ _ _).1 hx
  obtain ⟨h, hh, rfl⟩ := (Set.mem_finsetSum _ _ _).1 hy
  choose z hz using fun q => hg (Finset.mem_univ q)
  choose z' hz' using fun q => hh (Finset.mem_univ q)
  let α : Fin r ⊕ Fin r → Fin n → ZMod (blockProd S) := Sum.elim a b
  let σ : Fin r ⊕ Fin r → ℤ := Sum.elim (fun _ => 1) (fun _ => -1)
  let δ : Fin r ⊕ Fin r → EuclideanSpace ℝ (Fin n) :=
    Sum.elim (fun q => g q - ratPt (blockProd S) (a q) - latEmbed (z q))
      (fun q => h q - ratPt (blockProd S) (b q) - latEmbed (z' q))
  have hsep := separation hS1 hS hε hεr (Finset.univ : Finset (Fin r ⊕ Fin r))
    (by simp; omega) α (by rintro (q | q) -; exacts [ha q, hb q]) σ
    (by rintro (q | q) - <;> simp [σ])
    (by
      simp only [α, σ, Fintype.sum_sum_type, Sum.elim_inl, Sum.elim_inr, one_smul, neg_smul,
        Finset.sum_neg_distrib, ← sub_eq_add_neg, sub_ne_zero]
      exact hne) δ
    (by
      rintro (q | q) - i
      · simp only [δ, Sum.elim_inl, PiLp.sub_apply, latEmbed_apply]
        exact (hz q i).trans (by linarith)
      · simp only [δ, Sum.elim_inr, PiLp.sub_apply, latEmbed_apply]
        exact (hz' q i).trans (by linarith))
  apply hsep
  refine ⟨w' - w - ∑ q, z q + ∑ q, z' q, ?_⟩
  ext i
  have hi := congrArg (fun v : EuclideanSpace ℝ (Fin n) => v i) hxy
  simp only [PiLp.add_apply, latEmbed_apply] at hi
  simp [Fintype.sum_sum_type, α, σ, δ, latEmbed_apply, Finset.sum_add_distrib,
    Finset.sum_sub_distrib, Finset.sum_neg_distrib]
  simp only [WithLp.ofLp_sum, Finset.sum_apply] at hi
  linarith

/-- Products of `r ≥ 1` sequences in `ℓ¹` are in `ℓ¹`. -/
lemma summable_norm_prod_fin {r : ℕ} (hr : 0 < r) {u : Fin r → (Fin n → ℤ) → ℂ}
    (hu : ∀ q, Summable fun z => ‖u q z‖) : Summable fun z => ‖∏ q, u q z‖ :=
  haveI : Nonempty (Fin r) := ⟨⟨0, hr⟩⟩
  (latFT_prod_eq_zero_of_not_mem (s := Finset.univ) Finset.univ_nonempty
    (S := fun _ => Set.univ) (fun q _ => hu q)
    (fun _ _ ξ hξ => absurd (Set.mem_univ ξ) hξ)).1

section Hyp

variable {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} {ε : ℝ}
    (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    {f : (Fin n → ZMod (blockProd S)) → (Fin n → ℤ) → ℂ}
    (hf : ∀ α ∈ sigmaLe S k, Summable fun z => ‖f α z‖)
    (hsupp : ∀ α ∈ sigmaLe S k, ∀ ξ ∉ ratNbhd (blockProd S) ε α, latFT (f α) ξ = 0)
include hS1 hS hε hεr hf hsupp

/-- Orthogonality of two products `∏_q f_{a_q}`, `∏_q f_{b_q}` of `r` Fourier-localized pieces
whose center sums differ (helper for Blueprint Lemma 7.4 (`lem:blockorthog`)). -/
theorem tsum_prod_mul_conj_prod_ratNbhd_eq_zero
    (a b : Fin r → Fin n → ZMod (blockProd S)) (ha : ∀ q, a q ∈ sigmaLe S k)
    (hb : ∀ q, b q ∈ sigmaLe S k) (hne : ∑ q, a q ≠ ∑ q, b q) :
    ∑' x, (∏ q, f (a q) x) * conj (∏ q, f (b q) x) = 0 := by
  rcases Nat.eq_zero_or_pos r with rfl | hr
  · exact absurd (by simp) hne
  have : Nonempty (Fin r) := ⟨⟨0, hr⟩⟩
  exact tsum_prod_mul_conj_prod_eq_zero Finset.univ_nonempty Finset.univ_nonempty
    (u := fun q => f (a q)) (v := fun q => f (b q))
    (fun q _ => hf _ (ha q)) (fun q _ => hsupp _ (ha q)) (fun q _ => hf _ (hb q))
    (fun q _ => hsupp _ (hb q)) (disjoint_sum_ratNbhd hS1 hS hε hεr a b ha hb hne)

/-- Orthogonality of two finite sums of products of Fourier-localized pieces, when every pair
of center tuples has different sums (helper for Blueprint Lemma 7.4 (`lem:blockorthog`)). -/
theorem tsum_sum_prod_mul_conj_sum_prod_eq_zero {κ κ' : Type*} (P : Finset κ) (P' : Finset κ')
    (a : κ → Fin r → Fin n → ZMod (blockProd S)) (b : κ' → Fin r → Fin n → ZMod (blockProd S))
    (ha : ∀ j ∈ P, ∀ q, a j q ∈ sigmaLe S k) (hb : ∀ j ∈ P', ∀ q, b j q ∈ sigmaLe S k)
    (hne : ∀ j ∈ P, ∀ j' ∈ P', ∑ q, a j q ≠ ∑ q, b j' q) :
    ∑' x, (∑ j ∈ P, ∏ q, f (a j q) x) * conj (∑ j' ∈ P', ∏ q, f (b j' q) x) = 0 := by
  rcases Nat.eq_zero_or_pos r with rfl | hr
  · rcases P.eq_empty_or_nonempty with rfl | ⟨j, hj⟩
    · simp
    rcases P'.eq_empty_or_nonempty with rfl | ⟨j', hj'⟩
    · simp
    exact absurd (by simp) (hne j hj j' hj')
  have hsum : ∀ j ∈ P, ∀ j' ∈ P',
      Summable fun x => (∏ q, f (a j q) x) * conj (∏ q, f (b j' q) x) := fun j hj j' hj' =>
    Summable.of_norm (by
      simpa [norm_mul] using summable_norm_mul
        (summable_norm_prod_fin hr fun q => hf _ (ha j hj q))
        (summable_norm_prod_fin hr fun q => hf _ (hb j' hj' q)))
  simp_rw [map_sum, Finset.sum_mul_sum]
  rw [Summable.tsum_finsetSum (fun j hj => summable_sum fun j' hj' => hsum j hj j' hj')]
  refine Finset.sum_eq_zero fun j hj => ?_
  rw [Summable.tsum_finsetSum (fun j' hj' => hsum j hj j' hj')]
  exact Finset.sum_eq_zero fun j' hj' =>
    tsum_prod_mul_conj_prod_ratNbhd_eq_zero hS1 hS hε hεr hf hsupp _ _ (ha j hj) (hb j' hj')
      (hne j hj j' hj')

end Hyp

/-- Blueprint Lemma 7.4 (`lem:blockorthog`), first assertion. Let `S` be a finite set of pairwise
coprime integers `> 1`, `k, r ∈ ℕ`, `0 < ε ≤ (100 r q_*^{2rk})⁻¹`, and for each `α ∈ Σ_{≤k}` let
`f_α ∈ ℓ¹(ℤⁿ)` have Fourier transform vanishing off `α + [-ε,ε]ⁿ + ℤⁿ`. Then the functions
`f_A = ∑_{α ∈ Σ_A} f_α` (`A ⊆ S`, `|A| ≤ k`) satisfy the subset vanishing condition of Blueprint
Lemma 7.2 (`lem:superorth`), exactly in the form of the hypothesis `hvan` of `superorth_subset`
(`U = S`, counting measure on `ℤⁿ`, `H = ℂ`): if some `u` belongs to exactly one of the `2r` sets
`A_0, A'_0, …, A_{r-1}, A'_{r-1}`, then `∑_x ∏_q ⟪f_{A_q}(x), f_{A'_q}(x)⟫ = 0`. -/
theorem blockorthog_superorth {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} {ε : ℝ}
    (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    (f : (Fin n → ZMod (blockProd S)) → (Fin n → ℤ) → ℂ)
    (hf : ∀ α ∈ sigmaLe S k, Summable fun z => ‖f α z‖)
    (hsupp : ∀ α ∈ sigmaLe S k, ∀ ξ ∉ ratNbhd (blockProd S) ε α, latFT (f α) ξ = 0) :
    ∀ A : Fin r → Finset ℕ × Finset ℕ,
      (∀ q, ((A q).1 ⊆ S ∧ #(A q).1 ≤ k) ∧ ((A q).2 ⊆ S ∧ #(A q).2 ≤ k)) →
      (∃ u, #{q | u ∈ (A q).1} + #{q | u ∈ (A q).2} = 1) →
        ∫ x, ∏ q, inner ℂ (blockFun S f (A q).1 x) (blockFun S f (A q).2 x) ∂Measure.count
          = 0 := by
  intro A hA ⟨u, hu⟩
  -- the block `u` and the sign structure of its unique occurrence
  have hzero : ∀ (B : Fin r → Finset ℕ) (α : Fin r → Fin n → ZMod (blockProd S)),
      (∀ q, α q ∈ sigmaBlock S (B q)) → u ∈ S → (∀ q, u ∉ B q) →
        blockRed u (∑ q, α q) = 0 := by
    intro B α hα huS h0
    rw [blockRed_sum (dvd_blockProd huS)]
    exact Finset.sum_eq_zero fun q _ =>
      blockRed_eq_zero_of_not_mem huS (by rw [mem_sigmaBlock.1 (hα q)]; exact h0 q)
  have hone : ∀ (B : Fin r → Finset ℕ) (α : Fin r → Fin n → ZMod (blockProd S)),
      (∀ q, α q ∈ sigmaBlock S (B q)) → u ∈ S → #{q | u ∈ B q} = 1 →
        blockRed u (∑ q, α q) ≠ 0 := by
    intro B α hα huS h1
    obtain ⟨q0, hq0⟩ := Finset.card_eq_one.1 h1
    have hq : ∀ q, u ∈ B q ↔ q = q0 := fun q => by
      have := congrArg (q ∈ ·) hq0
      simpa using this
    rw [blockRed_sum (dvd_blockProd huS), Finset.sum_eq_single q0]
    · exact (mem_blockSupp.1 (by rw [mem_sigmaBlock.1 (hα q0)]; exact (hq q0).2 rfl)).2
    · intro q _ hq'
      exact blockRed_eq_zero_of_not_mem huS
        (by rw [mem_sigmaBlock.1 (hα q)]; exact fun h => hq' ((hq q).1 h))
    · intro h; exact absurd (Finset.mem_univ q0) h
  have hne : ∀ β ∈ Fintype.piFinset (fun q => sigmaBlock (n := n) S (A q).2),
      ∀ α ∈ Fintype.piFinset (fun q => sigmaBlock S (A q).1), ∑ q, β q ≠ ∑ q, α q := by
    intro β hβ α hα heq
    have hβ' := Fintype.mem_piFinset.1 hβ
    have hα' := Fintype.mem_piFinset.1 hα
    have huS : u ∈ S := by
      by_contra huS
      have h1 : ∀ q, u ∉ (A q).1 := fun q h => huS ((hA q).1.1 h)
      have h2 : ∀ q, u ∉ (A q).2 := fun q h => huS ((hA q).2.1 h)
      simp [h1, h2] at hu
    have hred := congrArg (blockRed u) heq
    rcases Nat.add_eq_one_iff.1 hu with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · rw [Finset.card_eq_zero, Finset.filter_eq_empty_iff] at h1
      exact hone _ β hβ' huS h2 (hred.trans (hzero _ α hα' huS fun q => h1 (Finset.mem_univ q)))
    · rw [Finset.card_eq_zero, Finset.filter_eq_empty_iff] at h2
      exact hone _ α hα' huS h1
        (hred.symm.trans (hzero _ β hβ' huS fun q => h2 (Finset.mem_univ q)))
  have e : ∀ x, ∏ q, inner ℂ (blockFun S f (A q).1 x) (blockFun S f (A q).2 x) =
      (∑ β ∈ Fintype.piFinset (fun q => sigmaBlock S (A q).2), ∏ q, f (β q) x) *
        conj (∑ α ∈ Fintype.piFinset (fun q => sigmaBlock S (A q).1), ∏ q, f (α q) x) := by
    intro x
    simp only [RCLike.inner_apply', blockFun]
    rw [Finset.prod_mul_distrib, mul_comm, ← map_prod, Finset.prod_univ_sum,
      Finset.prod_univ_sum]
  have key : ∑' x, ∏ q, inner ℂ (blockFun S f (A q).1 x) (blockFun S f (A q).2 x) = 0 := by
    simp_rw [e]
    exact tsum_sum_prod_mul_conj_sum_prod_eq_zero hS1 hS hε hεr hf hsupp _ _ id id
      (fun β hβ q => sigmaBlock_subset_sigmaLe S (hA q).2.2 (Fintype.mem_piFinset.1 hβ q))
      (fun α hα q => sigmaBlock_subset_sigmaLe S (hA q).1.2 (Fintype.mem_piFinset.1 hα q)) hne
  by_cases hint : Integrable
      (fun x => ∏ q, inner ℂ (blockFun S f (A q).1 x) (blockFun S f (A q).2 x)) Measure.count
  · rw [integral_countable hint]
    simpa [count_real_singleton] using key
  · exact integral_undef hint

/-- `∏_i f_{A₀, s_i} = ∑_{β ∈ Σ_{A₀}^r} ∏_i f_{s_i + β_i}` (expansion of a product of coset
functions). -/
lemma prod_cosetFun_eq_sum {S : Finset ℕ} [NeZero (blockProd S)] {r : ℕ}
    (f : (Fin n → ZMod (blockProd S)) → (Fin n → ℤ) → ℂ) (A₀ : Finset ℕ)
    (s : Fin r → Fin n → ZMod (blockProd S)) (x : Fin n → ℤ) :
    ∏ i, cosetFun S f A₀ (s i) x =
      ∑ β ∈ Fintype.piFinset (fun _ : Fin r => sigmaBlock (n := n) S A₀),
        ∏ i, f (s i + β i) x :=
  Finset.prod_univ_sum (fun _ => sigmaBlock S A₀) (fun i β => f (s i + β) x)

/-- Blueprint Lemma 7.4 (`lem:blockorthog`), second assertion. In the setting of
`blockorthog_superorth`, fix a core `A₀` and pairwise disjoint petals `A_1, …, A_r ⊆ S \ A₀`
with `|A₀ ∪ A_i| ≤ k`. For tuples `t, t'` with `t_i, t'_i ∈ Σ_{A_i}` (so `t_i ∈ Σ^{A₀}`, see
`sigmaBlock_subset_sigmaUpper`) and `t ≠ t'`, the products `∏_i f_{A₀,t_i}` and
`∏_i f_{A₀,t'_i}` are orthogonal in `ℓ²(ℤⁿ)`:
`∑_x (∏_i f_{A₀,t_i}(x)) · conj (∏_i f_{A₀,t'_i}(x)) = 0`. -/
theorem blockorthog_petals {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} {ε : ℝ}
    (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    (f : (Fin n → ZMod (blockProd S)) → (Fin n → ℤ) → ℂ)
    (hf : ∀ α ∈ sigmaLe S k, Summable fun z => ‖f α z‖)
    (hsupp : ∀ α ∈ sigmaLe S k, ∀ ξ ∉ ratNbhd (blockProd S) ε α, latFT (f α) ξ = 0)
    {A₀ : Finset ℕ} {A : Fin r → Finset ℕ} (hA : ∀ i, A i ⊆ S \ A₀)
    (hdisj : ∀ i j, i ≠ j → Disjoint (A i) (A j)) (hcard : ∀ i, #(A₀ ∪ A i) ≤ k)
    {t t' : Fin r → Fin n → ZMod (blockProd S)} (ht : ∀ i, t i ∈ sigmaBlock S (A i))
    (ht' : ∀ i, t' i ∈ sigmaBlock S (A i)) (htt' : t ≠ t') :
    ∑' x, (∏ i, cosetFun S f A₀ (t i) x) * conj (∏ i, cosetFun S f A₀ (t' i) x) = 0 := by
  have hd : ∀ i, Disjoint (A i) A₀ := fun i =>
    Finset.disjoint_of_subset_left (hA i) Finset.sdiff_disjoint
  have hmem : ∀ s : Fin r → Fin n → ZMod (blockProd S), (∀ i, s i ∈ sigmaBlock S (A i)) →
      ∀ β ∈ Fintype.piFinset (fun _ : Fin r => sigmaBlock (n := n) S A₀), ∀ i,
        s i + β i ∈ sigmaLe S k := fun s hs β hβ i =>
    sigmaBlock_subset_sigmaLe S (hcard i)
      (add_mem_sigmaBlock_union S (hd i) (hs i) (Fintype.mem_piFinset.1 hβ i))
  -- a block `u` in the petal `A i0` where `t` and `t'` differ
  obtain ⟨i0, hi0⟩ := Function.ne_iff.1 htt'
  obtain ⟨u, huS, hu⟩ : ∃ u ∈ S, blockRed u (t i0) ≠ blockRed u (t' i0) := by
    by_contra h
    push Not at h
    exact hi0 (ext_blockRed hS h)
  have huA : u ∈ A i0 := by
    by_contra h
    refine hu ?_
    rw [blockRed_eq_zero_of_not_mem huS (by rw [mem_sigmaBlock.1 (ht i0)]; exact h),
      blockRed_eq_zero_of_not_mem huS (by rw [mem_sigmaBlock.1 (ht' i0)]; exact h)]
  have huA₀ : u ∉ A₀ := (Finset.mem_sdiff.1 (hA i0 huA)).2
  have hred : ∀ s : Fin r → Fin n → ZMod (blockProd S), (∀ i, s i ∈ sigmaBlock S (A i)) →
      ∀ β ∈ Fintype.piFinset (fun _ : Fin r => sigmaBlock (n := n) S A₀),
        blockRed u (∑ i, (s i + β i)) = blockRed u (s i0) := by
    intro s hs β hβ
    have hβ0 : ∀ i, blockRed u (β i) = 0 := fun i =>
      blockRed_eq_zero_of_not_mem huS
        (by rw [mem_sigmaBlock.1 (Fintype.mem_piFinset.1 hβ i)]; exact huA₀)
    rw [blockRed_sum (dvd_blockProd huS), Finset.sum_eq_single i0]
    · rw [blockRed_add (dvd_blockProd huS), hβ0, add_zero]
    · intro i _ hi
      rw [blockRed_add (dvd_blockProd huS), hβ0, add_zero]
      exact blockRed_eq_zero_of_not_mem huS (by
        rw [mem_sigmaBlock.1 (hs i)]
        exact fun h => Finset.disjoint_left.1 (hdisj i0 i (Ne.symm hi)) huA h)
    · intro h; exact absurd (Finset.mem_univ i0) h
  simp_rw [prod_cosetFun_eq_sum]
  refine tsum_sum_prod_mul_conj_sum_prod_eq_zero hS1 hS hε hεr hf hsupp
    (Fintype.piFinset (fun _ : Fin r => sigmaBlock (n := n) S A₀))
    (Fintype.piFinset (fun _ : Fin r => sigmaBlock (n := n) S A₀))
    (fun β i => t i + β i) (fun β i => t' i + β i) (hmem t ht) (hmem t' ht') ?_
  intro β hβ β' hβ' heq
  have := congrArg (blockRed u) heq
  rw [hred t ht β hβ, hred t' ht' β' hβ'] at this
  exact hu this

/-- Pythagoras for finite orthogonal families in `ℓ¹(ℤⁿ)`:
`∑_x |∑_t F_t(x)|² = ∑_t ∑_x |F_t(x)|²` when `∑_x F_t(x) conj (F_{t'}(x)) = 0` for `t ≠ t'`. -/
theorem tsum_norm_sq_sum_eq_of_orthogonal {κ : Type*} (T : Finset κ)
    (F : κ → (Fin n → ℤ) → ℂ) (hF : ∀ t ∈ T, Summable fun x => ‖F t x‖)
    (horth : ∀ t ∈ T, ∀ t' ∈ T, t ≠ t' → ∑' x, F t x * conj (F t' x) = 0) :
    ∑' x, ‖∑ t ∈ T, F t x‖ ^ 2 = ∑ t ∈ T, ∑' x, ‖F t x‖ ^ 2 := by
  have hsq : ∀ z : ℂ, ((‖z‖ ^ 2 : ℝ) : ℂ) = z * conj z := fun z => by
    rw [Complex.mul_conj']; push_cast; rfl
  have hs : ∀ t ∈ T, ∀ t' ∈ T, Summable fun x => F t x * conj (F t' x) := fun t ht t' ht' =>
    Summable.of_norm (by simpa [norm_mul] using summable_norm_mul (hF t ht) (hF t' ht'))
  apply Complex.ofReal_injective
  rw [Complex.ofReal_tsum, Complex.ofReal_sum]
  simp_rw [Complex.ofReal_tsum, hsq, map_sum, Finset.sum_mul_sum]
  rw [Summable.tsum_finsetSum (fun t ht => summable_sum fun t' ht' => hs t ht t' ht')]
  refine Finset.sum_congr rfl fun t ht => ?_
  rw [Summable.tsum_finsetSum (fun t' ht' => hs t ht t' ht'), Finset.sum_eq_single t]
  · intro t' ht' hne; exact horth t ht t' ht' (Ne.symm hne)
  · intro h; exact absurd ht h

/-- Blueprint Lemma 7.4 (`lem:blockorthog`), consequence of the second assertion (as used in
Blueprint Lemma 7.5 (`lem:normdescription`)): in the setting of `blockorthog_petals`, with the
direct block decomposition `f_{A₀ ∪ A_i} = ∑_{α_i ∈ Σ_{A_i}} f_{A₀,α_i}`,
`‖∏_i f_{A₀ ∪ A_i}‖_2² = ∑_{t : t_i ∈ Σ_{A_i}} ‖∏_i f_{A₀,t_i}‖_2²`. -/
theorem blockorthog_norm_sq {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} {ε : ℝ}
    (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    (f : (Fin n → ZMod (blockProd S)) → (Fin n → ℤ) → ℂ)
    (hf : ∀ α ∈ sigmaLe S k, Summable fun z => ‖f α z‖)
    (hsupp : ∀ α ∈ sigmaLe S k, ∀ ξ ∉ ratNbhd (blockProd S) ε α, latFT (f α) ξ = 0)
    {A₀ : Finset ℕ} {A : Fin r → Finset ℕ} (hA : ∀ i, A i ⊆ S \ A₀)
    (hdisj : ∀ i j, i ≠ j → Disjoint (A i) (A j)) (hcard : ∀ i, #(A₀ ∪ A i) ≤ k) :
    ∑' x, ‖∏ i, blockFun S f (A₀ ∪ A i) x‖ ^ 2 =
      ∑ t ∈ Fintype.piFinset (fun i => sigmaBlock (n := n) S (A i)),
        ∑' x, ‖∏ i, cosetFun S f A₀ (t i) x‖ ^ 2 := by
  have hd : ∀ i, Disjoint (A i) A₀ := fun i =>
    Finset.disjoint_of_subset_left (hA i) Finset.sdiff_disjoint
  have e : ∀ x, ∏ i, blockFun S f (A₀ ∪ A i) x =
      ∑ t ∈ Fintype.piFinset (fun i => sigmaBlock (n := n) S (A i)),
        ∏ i, cosetFun S f A₀ (t i) x := fun x => by
    simp_rw [blockFun_union_eq_sum_cosetFun hS f (hd _)]
    exact Finset.prod_univ_sum (fun i => sigmaBlock S (A i)) (fun i α => cosetFun S f A₀ α x)
  simp_rw [e]
  rcases Nat.eq_zero_or_pos r with rfl | hr
  · simp
  refine tsum_norm_sq_sum_eq_of_orthogonal _ _ (fun t ht => ?_) (fun t ht t' ht' htt' =>
    blockorthog_petals hS1 hS hε hεr f hf hsupp hA hdisj hcard (Fintype.mem_piFinset.1 ht)
      (Fintype.mem_piFinset.1 ht') htt')
  refine summable_norm_prod_fin hr fun i => ?_
  refine Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun x => norm_sum_le _ _)
    (summable_sum fun β hβ => hf _ ?_)
  exact sigmaBlock_subset_sigmaLe S (hcard i)
    (add_mem_sigmaBlock_union S (hd i) (Fintype.mem_piFinset.1 ht i) hβ)

end BlockOrthog

/-! ### Blueprint Lemma 7.5 (`lem:normdescription`): a norm description -/

section NormDescription

open MeasureTheory
open scoped ENNReal

/-- Nonnegative summable sequences have summable powers `u^m`, `m ≥ 1`
(helper for Blueprint Lemma 7.5 (`lem:normdescription`)). -/
lemma summable_pow_of_summable_nonneg {ι : Type*} {u : ι → ℝ} (h0 : ∀ x, 0 ≤ u x)
    (hu : Summable u) {m : ℕ} (hm : 1 ≤ m) : Summable fun x => u x ^ m := by
  obtain ⟨j, rfl⟩ : ∃ j, m = j + 1 := ⟨m - 1, by omega⟩
  refine Summable.of_nonneg_of_le (fun x => pow_nonneg (h0 x) _) (fun x => ?_)
    (hu.mul_left ((∑' y, u y) ^ j))
  rw [pow_succ]
  exact mul_le_mul_of_nonneg_right
    (pow_le_pow_left₀ (h0 x) (hu.le_tsum x fun y _ => h0 y) j) (h0 x)

/-- `‖z‖ₑ ^ m = ofReal (‖z‖ ^ m)` (helper for Blueprint Lemma 7.5 (`lem:normdescription`)). -/
lemma enorm_pow_eq_ofReal {E : Type*} [NormedAddCommGroup E] (z : E) (m : ℕ) :
    ‖z‖ₑ ^ m = ENNReal.ofReal (‖z‖ ^ m) := by
  rw [← ofReal_norm, ENNReal.ofReal_pow (norm_nonneg _)]

/-- `‖√y‖ₑ ^ (2r) = (ofReal y) ^ r` for `y ≥ 0`. -/
lemma enorm_sqrt_pow_two_mul {y : ℝ} (hy : 0 ≤ y) (r : ℕ) :
    ‖Real.sqrt y‖ₑ ^ (2 * r) = ENNReal.ofReal y ^ r := by
  rw [enorm_pow_eq_ofReal, Real.norm_of_nonneg (Real.sqrt_nonneg _), pow_mul,
    Real.sq_sqrt hy, ENNReal.ofReal_pow hy]

/-- For `r ≥ 1`, `‖g‖_{2r}^{2r} = ∑_x ‖g(x)‖^{2r}` on `ℤⁿ` with counting measure. -/
lemma eLpNorm_count_pow_eq_tsum {E : Type*} [NormedAddCommGroup E] {r : ℕ} (hr : 0 < r)
    (g : (Fin n → ℤ) → E) :
    eLpNorm g (ENNReal.ofReal (2 * r)) Measure.count ^ (2 * r) = ∑' x, ‖g x‖ₑ ^ (2 * r) := by
  have hp : (0 : ℝ) < 2 * r := by positivity
  have hc : ((2 * r : ℕ) : ℝ) = 2 * r := by push_cast; ring
  rw [eLpNorm_ofReal_eq_lintegral AEStronglyMeasurable.of_discrete hp, lintegral_count,
    ← ENNReal.rpow_natCast, ← ENNReal.rpow_mul, hc, one_div_mul_cancel hp.ne', ENNReal.rpow_one]
  refine tsum_congr fun x => ?_
  rw [← hc, ENNReal.rpow_natCast]

/-- `∑_x ‖g x‖ₑ ^ m = ofReal (∑_x ‖g x‖ ^ m)` when `‖g‖ ^ m` is summable. -/
lemma tsum_enorm_pow_eq_ofReal {E : Type*} [NormedAddCommGroup E] {g : (Fin n → ℤ) → E}
    {m : ℕ} (hg : Summable fun x => ‖g x‖ ^ m) :
    ∑' x, ‖g x‖ₑ ^ m = ENNReal.ofReal (∑' x, ‖g x‖ ^ m) := by
  rw [ENNReal.ofReal_tsum_of_nonneg (fun x => by positivity) hg]
  exact tsum_congr fun x => enorm_pow_eq_ofReal _ _

/-- Sequences in `ℓ¹(ℤⁿ)` lie in `ℓ^{2r}(ℤⁿ)`. -/
lemma memLp_count_of_summable {E : Type*} [NormedAddCommGroup E] {r : ℕ} (hr : 0 < r)
    {g : (Fin n → ℤ) → E} (hg : Summable fun x => ‖g x‖) :
    MemLp g (ENNReal.ofReal (2 * r)) Measure.count := by
  rw [memLp_iff]
  have h := eLpNorm_count_pow_eq_tsum hr g
  rw [tsum_enorm_pow_eq_ofReal (summable_pow_of_summable_nonneg (fun x => norm_nonneg (g x)) hg
    (m := 2 * r) (by omega))] at h
  by_contra hc
  rw [not_lt, top_le_iff] at hc
  rw [hc, ENNReal.top_pow (by omega)] at h
  exact ENNReal.ofReal_ne_top h.symm
/-- Each `α ∈ Σ^{A₀}` has a unique petal support: sums over `r`-tuples of points of `Σ^{A₀}`
split over the tuples of petals `t_i ⊆ S \ A₀` with `|A₀ ∪ t_i| ≤ k`
(helper for Blueprint Lemma 7.5 (`lem:normdescription`)). -/
lemma sum_piFinset_sigmaUpper {M : Type*} [AddCommMonoid M] (S : Finset ℕ)
    [NeZero (blockProd S)]
    (k r : ℕ) (A₀ : Finset ℕ) (H : (Fin r → Fin n → ZMod (blockProd S)) → M) :
    ∑ t ∈ Fintype.piFinset (fun _ : Fin r => (S \ A₀).powerset) with ∀ i, #(A₀ ∪ t i) ≤ k,
        ∑ s ∈ Fintype.piFinset (fun i => sigmaBlock (n := n) S (t i)), H s =
      ∑ s ∈ Fintype.piFinset (fun _ : Fin r => sigmaUpper (n := n) S k A₀), H s := by
  classical
  rw [← sum_fiberwise_of_maps_to
    (g := fun (s : Fin r → Fin n → ZMod (blockProd S)) (i : Fin r) => blockSupp S (s i))
    (t := (Fintype.piFinset (fun _ : Fin r => (S \ A₀).powerset)).filter
      fun t => ∀ i, #(A₀ ∪ t i) ≤ k)]
  · refine sum_congr rfl fun t ht => ?_
    obtain ⟨ht1, ht2⟩ := mem_filter.1 ht
    have ht1' := Fintype.mem_piFinset.1 ht1
    congr 1
    ext s
    simp only [mem_filter, Fintype.mem_piFinset, mem_sigmaUpper, mem_sigmaBlock]
    refine ⟨fun h => ⟨fun i => ?_, funext h⟩, fun h => congrFun h.2⟩
    · have hd : Disjoint (t i) A₀ :=
        Finset.disjoint_of_subset_left (mem_powerset.1 (ht1' i)) Finset.sdiff_disjoint
      rw [h i]
      refine ⟨hd, ?_⟩
      have := ht2 i
      rw [card_union_of_disjoint hd.symm] at this
      omega
  · intro s hs
    have hs' := Fintype.mem_piFinset.1 hs
    refine mem_filter.2 ⟨Fintype.mem_piFinset.2 fun i => mem_powerset.2 fun q hq => ?_,
      fun i => ?_⟩
    · exact mem_sdiff.2 ⟨blockSupp_subset S _ hq,
        Finset.disjoint_left.1 (mem_sigmaUpper.1 (hs' i)).1 hq⟩
    · have := (mem_sigmaUpper.1 (hs' i)).2
      dsimp only
      exact (card_union_le _ _).trans (by omega)

/-- `∑_{s ∈ U^r} ∑_x ‖∏_i g_{s_i}(x)‖² = ∑_x (∑_{α ∈ U} ‖g_α(x)‖²)^r` (in `ℝ≥0∞`). -/
lemma sum_piFinset_tsum_enorm_prod {κ : Type*} (U : Finset κ) (r : ℕ)
    (g : κ → (Fin n → ℤ) → ℂ) :
    ∑ s ∈ Fintype.piFinset (fun _ : Fin r => U), ∑' x, ‖∏ i, g (s i) x‖ₑ ^ 2 =
      ∑' x, (∑ α ∈ U, ‖g α x‖ₑ ^ 2) ^ r := by
  rw [← Summable.tsum_finsetSum (fun _ _ => ENNReal.summable)]
  refine tsum_congr fun x => ?_
  rw [sum_pow']
  refine sum_congr rfl fun s _ => ?_
  rw [prod_pow, ← ofReal_norm, norm_prod, ENNReal.ofReal_prod_of_nonneg (fun _ _ => norm_nonneg _)]
  simp only [ofReal_norm]
/-- The constant `C_{k,r} = (∑_{l ≤ k} (2rl)^l)^{2r} · sunflowerConst k r` of Blueprint
Lemma 7.5 (`lem:normdescription`): the `2r`-th power of the constant of `superorth_subset`
times the constant of `weighted_sunflower`; it depends only on `k` and `r`. -/
noncomputable def normDescConst (k r : ℕ) : ℝ :=
  (∑ l ∈ range (k + 1), ((2 * r * l : ℕ) : ℝ) ^ l) ^ (2 * r) * sunflowerConst k r

/-- The constant of Blueprint Lemma 7.5 (`lem:normdescription`) is nonnegative. -/
lemma normDescConst_nonneg (k r : ℕ) : 0 ≤ normDescConst k r :=
  mul_nonneg (by positivity) (zero_le_one.trans (one_le_sunflowerConst k r))

/-- `normDescConst k r` in `ℝ≥0∞`, in the form produced by `superorth_subset` and
`weighted_sunflower`. -/
lemma ofReal_normDescConst (k r : ℕ) :
    ENNReal.ofReal (normDescConst k r) =
      (∑ l ∈ range (k + 1), (2 * r * l : ℝ≥0∞) ^ l) ^ (2 * r) *
        ENNReal.ofReal (sunflowerConst k r) := by
  rw [normDescConst, ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_pow (by positivity),
    ENNReal.ofReal_sum_of_nonneg (fun _ _ => by positivity)]
  congr 2
  refine sum_congr rfl fun l _ => ?_
  rw [ENNReal.ofReal_pow (by positivity), ENNReal.ofReal_natCast]
  push_cast
  ring

/-- The block functions `f_A` (`|A| ≤ k`) are in `ℓ¹`. -/
lemma summable_blockFun {S : Finset ℕ} [NeZero (blockProd S)] {k : ℕ}
    {f : (Fin n → ZMod (blockProd S)) → (Fin n → ℤ) → ℂ}
    (hf : ∀ α ∈ sigmaLe S k, Summable fun z => ‖f α z‖) {A : Finset ℕ} (hA : #A ≤ k) :
    Summable fun x => ‖blockFun S f A x‖ :=
  Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun _ => norm_sum_le _ _)
    (summable_sum fun α hα => hf α (sigmaBlock_subset_sigmaLe S hA hα))

/-- The coset functions `f_{A₀,α}` (`α ∈ Σ^{A₀}`) are in `ℓ¹`. -/
lemma summable_cosetFun {S : Finset ℕ} [NeZero (blockProd S)] {k : ℕ}
    {f : (Fin n → ZMod (blockProd S)) → (Fin n → ℤ) → ℂ}
    (hf : ∀ α ∈ sigmaLe S k, Summable fun z => ‖f α z‖) {A₀ : Finset ℕ}
    {α : Fin n → ZMod (blockProd S)} (hα : α ∈ sigmaUpper S k A₀) :
    Summable fun x => ‖cosetFun S f A₀ α x‖ := by
  obtain ⟨hd, hc⟩ := mem_sigmaUpper.1 hα
  refine Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun _ => norm_sum_le _ _)
    (summable_sum fun β hβ => hf _ ?_)
  exact sigmaBlock_subset_sigmaLe S ((card_union_le _ _).trans (by omega))
    (add_mem_sigmaBlock_union S hd (mem_sigmaBlock.2 rfl) hβ)

/-- Blueprint Lemma 7.5 (`lem:normdescription`), eq. (7.3) (`eq:normdescription`), in
`ℝ≥0∞`-valued form. Let `S` be a finite set of pairwise coprime integers `> 1`, `k ∈ ℕ`,
`r ≥ 1`, `0 < ε ≤ (100 r q_*^{2rk})⁻¹`, and for each `α ∈ Σ_{≤k}` let `f_α ∈ ℓ¹(ℤⁿ)` have Fourier
transform vanishing off `α + [-ε,ε]ⁿ + ℤⁿ` (the setting of Blueprint Lemma 7.4
(`lem:blockorthog`)). With `f_{A₀,α} = cosetFun S f A₀ α`,
`∑_x |∑_{α ∈ Σ_{≤k}} f_α(x)|^{2r} ≤
C_{k,r} ∑_{A₀ ⊆ S, |A₀| ≤ k} ∑_x (∑_{α ∈ Σ^{A₀}} |f_{A₀,α}(x)|²)^r`,
with `C_{k,r} = normDescConst k r` depending only on `k` and `r`. -/
theorem normdescription_enorm {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} (hr : 0 < r)
    {ε : ℝ} (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    (f : (Fin n → ZMod (blockProd S)) → (Fin n → ℤ) → ℂ)
    (hf : ∀ α ∈ sigmaLe S k, Summable fun z => ‖f α z‖)
    (hsupp : ∀ α ∈ sigmaLe S k, ∀ ξ ∉ ratNbhd (blockProd S) ε α, latFT (f α) ξ = 0) :
    ∑' x, ‖∑ α ∈ sigmaLe S k, f α x‖ₑ ^ (2 * r) ≤
      ENNReal.ofReal (normDescConst k r) *
        ∑ A₀ ∈ S.powerset with #A₀ ≤ k,
          ∑' x, (∑ α ∈ sigmaUpper S k A₀, ‖cosetFun S f A₀ α x‖ₑ ^ 2) ^ r := by
  classical
  set P := S.powerset.filter fun A => #A ≤ k with hP
  set F := blockFun S f with hF
  set C1 : ℝ≥0∞ := ∑ l ∈ range (k + 1), (2 * r * l : ℝ≥0∞) ^ l with hC1
  set C2 := sunflowerConst k r with hC2
  have hFs : ∀ A, #A ≤ k → Summable fun x => ‖F A x‖ := fun A hA => summable_blockFun hf hA
  have hsq : ∀ {g : (Fin n → ℤ) → ℂ}, (Summable fun x => ‖g x‖) →
      Summable fun x => ‖g x‖ ^ 2 :=
    fun hg => summable_pow_of_summable_nonneg (fun _ => norm_nonneg _) hg (by norm_num)
  -- Step 1: superorthogonality of the `f_A` (Lemmas 7.2 and 7.4)
  have h1 : ∑' x, ‖∑ α ∈ sigmaLe S k, f α x‖ₑ ^ (2 * r) ≤
      C1 ^ (2 * r) * ∑' x, ENNReal.ofReal ((∑ A ∈ P, ‖F A x‖ ^ 2) ^ r) := by
    have h := superorth_subset (μ := Measure.count) (𝕜 := ℂ) (r := r) k S F
      (fun A _ hk => memLp_count_of_summable hr (hFs A hk))
      (blockorthog_superorth hS1 hS hε hεr f hf hsupp)
    have h' := pow_le_pow_left₀ zero_le h (2 * r)
    rw [mul_pow, eLpNorm_count_pow_eq_tsum hr, eLpNorm_count_pow_eq_tsum hr] at h'
    convert h' using 2
    · funext x
      rw [Finset.sum_apply, sum_sigmaLe]
      rfl
    · refine tsum_congr fun x => ?_
      rw [enorm_sqrt_pow_two_mul (sum_nonneg fun _ _ => sq_nonneg _),
        ENNReal.ofReal_pow (sum_nonneg fun _ _ => sq_nonneg _)]
  -- Step 2: the weighted sunflower inequality at each point (Lemma 7.3)
  have h2 : ∀ x, ENNReal.ofReal ((∑ A ∈ P, ‖F A x‖ ^ 2) ^ r) ≤
      ENNReal.ofReal C2 * ∑ A₀ ∈ P,
        ∑ t ∈ Fintype.piFinset (fun _ : Fin r => (S \ A₀).powerset) with
            ((∀ i j, i ≠ j → Disjoint (t i) (t j)) ∧ ∀ i, #(A₀ ∪ t i) ≤ k),
          ‖∏ i, F (A₀ ∪ t i) x‖ₑ ^ 2 := by
    intro x
    have h := weighted_sunflower S k r (fun A => ‖F A x‖ ^ 2) (fun _ _ _ => sq_nonneg _)
    refine (ENNReal.ofReal_le_ofReal h).trans (le_of_eq ?_)
    rw [ENNReal.ofReal_mul (zero_le_one.trans (one_le_sunflowerConst k r)),
      ENNReal.ofReal_sum_of_nonneg fun A₀ _ => sum_nonneg fun t _ =>
        prod_nonneg fun i _ => sq_nonneg _]
    congr 1
    refine sum_congr rfl fun A₀ _ => ?_
    rw [ENNReal.ofReal_sum_of_nonneg fun t _ => prod_nonneg fun i _ => sq_nonneg _]
    refine sum_congr rfl fun t _ => ?_
    rw [enorm_pow_eq_ofReal, norm_prod, prod_pow]
  -- Step 3: sum in `x`
  have h3 : ∑' x, ENNReal.ofReal ((∑ A ∈ P, ‖F A x‖ ^ 2) ^ r) ≤
      ENNReal.ofReal C2 * ∑ A₀ ∈ P,
        ∑ t ∈ Fintype.piFinset (fun _ : Fin r => (S \ A₀).powerset) with
            ((∀ i j, i ≠ j → Disjoint (t i) (t j)) ∧ ∀ i, #(A₀ ∪ t i) ≤ k),
          ∑' x, ‖∏ i, F (A₀ ∪ t i) x‖ₑ ^ 2 := by
    refine (ENNReal.tsum_le_tsum h2).trans (le_of_eq ?_)
    rw [ENNReal.tsum_mul_left, Summable.tsum_finsetSum (fun _ _ => ENNReal.summable)]
    congr 1
    exact sum_congr rfl fun A₀ _ => Summable.tsum_finsetSum (fun _ _ => ENNReal.summable)
  -- Step 4: expansion of `‖∏_i f_{A₀ ∪ A_i}‖₂²` by the second orthogonality (Lemma 7.4)
  have h4 : ∀ A₀ ∈ P, ∀ t ∈ (Fintype.piFinset (fun _ : Fin r => (S \ A₀).powerset)).filter
        (fun t => (∀ i j, i ≠ j → Disjoint (t i) (t j)) ∧ ∀ i, #(A₀ ∪ t i) ≤ k),
      ∑' x, ‖∏ i, F (A₀ ∪ t i) x‖ₑ ^ 2 =
        ∑ s ∈ Fintype.piFinset (fun i => sigmaBlock (n := n) S (t i)),
          ∑' x, ‖∏ i, cosetFun S f A₀ (s i) x‖ₑ ^ 2 := by
    intro A₀ _ t ht
    obtain ⟨ht1, hdisj, hcard⟩ := mem_filter.1 ht
    have hA : ∀ i, t i ⊆ S \ A₀ := fun i => mem_powerset.1 (Fintype.mem_piFinset.1 ht1 i)
    have hd : ∀ i, Disjoint (t i) A₀ := fun i =>
      Finset.disjoint_of_subset_left (hA i) Finset.sdiff_disjoint
    have e := blockorthog_norm_sq hS1 hS hε hεr f hf hsupp hA hdisj hcard
    rw [tsum_enorm_pow_eq_ofReal (hsq (summable_norm_prod_fin hr fun i => hFs _ (hcard i))),
      hF, e, ENNReal.ofReal_sum_of_nonneg fun s _ => tsum_nonneg fun x => sq_nonneg _]
    refine sum_congr rfl fun s hs => ?_
    have hsU : ∀ i, s i ∈ sigmaUpper S k A₀ := fun i =>
      sigmaBlock_subset_sigmaUpper S (hd i)
        (by have := hcard i; rw [card_union_of_disjoint (hd i).symm] at this; omega)
        (Fintype.mem_piFinset.1 hs i)
    rw [tsum_enorm_pow_eq_ofReal
      (hsq (summable_norm_prod_fin hr fun i => summable_cosetFun hf (hsU i)))]
  -- Step 5: drop the disjointness of the petals and regroup by petal supports
  have h5 : ∀ A₀ ∈ P,
      ∑ t ∈ Fintype.piFinset (fun _ : Fin r => (S \ A₀).powerset) with
          ((∀ i j, i ≠ j → Disjoint (t i) (t j)) ∧ ∀ i, #(A₀ ∪ t i) ≤ k),
        ∑' x, ‖∏ i, F (A₀ ∪ t i) x‖ₑ ^ 2 ≤
      ∑' x, (∑ α ∈ sigmaUpper S k A₀, ‖cosetFun S f A₀ α x‖ₑ ^ 2) ^ r := by
    intro A₀ hA₀
    rw [sum_congr rfl (h4 A₀ hA₀), ← sum_piFinset_tsum_enorm_prod,
      ← sum_piFinset_sigmaUpper S k r A₀]
    refine sum_le_sum_of_subset fun t ht => ?_
    obtain ⟨ht1, -, hcard⟩ := mem_filter.1 ht
    exact mem_filter.2 ⟨ht1, hcard⟩
  calc ∑' x, ‖∑ α ∈ sigmaLe S k, f α x‖ₑ ^ (2 * r)
      ≤ C1 ^ (2 * r) * ∑' x, ENNReal.ofReal ((∑ A ∈ P, ‖F A x‖ ^ 2) ^ r) := h1
    _ ≤ C1 ^ (2 * r) * (ENNReal.ofReal C2 * ∑ A₀ ∈ P,
          ∑' x, (∑ α ∈ sigmaUpper S k A₀, ‖cosetFun S f A₀ α x‖ₑ ^ 2) ^ r) := by
        gcongr
        exact h3.trans (mul_le_mul_right (sum_le_sum h5) _)
    _ = _ := by rw [ofReal_normDescConst, mul_assoc]

/-- Blueprint Lemma 7.5 (`lem:normdescription`), eq. (7.3) (`eq:normdescription`): in the
setting of Blueprint Lemma 7.4 (`lem:blockorthog`) (see `blockorthog_superorth`), for `r ≥ 1`,
`‖∑_{α ∈ Σ_{≤k}} f_α‖_{2r}^{2r} ≤ C_{k,r} ∑_{|A₀| ≤ k} ‖(f_{A₀,α})_{α ∈ Σ^{A₀}}‖_{ℓ^{2r}(ℓ²)}^{2r}`,
written out as
`∑_x |∑_{α ∈ Σ_{≤k}} f_α(x)|^{2r} ≤
C_{k,r} ∑_{A₀ ⊆ S, |A₀| ≤ k} ∑_x (∑_{α ∈ Σ^{A₀}} |f_{A₀,α}(x)|²)^r`,
with `C_{k,r} = normDescConst k r = (∑_{l ≤ k} (2rl)^l)^{2r} · sunflowerConst k r`, depending
only on `k` and `r`. (All series converge: every sequence involved is in `ℓ¹`.) -/
theorem normdescription {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} (hr : 0 < r)
    {ε : ℝ} (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    (f : (Fin n → ZMod (blockProd S)) → (Fin n → ℤ) → ℂ)
    (hf : ∀ α ∈ sigmaLe S k, Summable fun z => ‖f α z‖)
    (hsupp : ∀ α ∈ sigmaLe S k, ∀ ξ ∉ ratNbhd (blockProd S) ε α, latFT (f α) ξ = 0) :
    ∑' x, ‖∑ α ∈ sigmaLe S k, f α x‖ ^ (2 * r) ≤
      normDescConst k r *
        ∑ A₀ ∈ S.powerset with #A₀ ≤ k,
          ∑' x, (∑ α ∈ sigmaUpper S k A₀, ‖cosetFun S f A₀ α x‖ ^ 2) ^ r := by
  classical
  have h := normdescription_enorm hS1 hS hr hε hεr f hf hsupp
  have hsq : ∀ {g : (Fin n → ℤ) → ℂ}, (Summable fun x => ‖g x‖) →
      Summable fun x => ‖g x‖ ^ 2 :=
    fun hg => summable_pow_of_summable_nonneg (fun _ => norm_nonneg _) hg (by norm_num)
  have hR : ∀ A₀ : Finset ℕ,
      Summable fun x => (∑ α ∈ sigmaUpper S k A₀, ‖cosetFun S f A₀ α x‖ ^ 2) ^ r := by
    intro A₀
    have e : ∀ x, (∑ α ∈ sigmaUpper S k A₀, ‖cosetFun S f A₀ α x‖ ^ 2) ^ r =
        ∑ s ∈ Fintype.piFinset (fun _ : Fin r => sigmaUpper (n := n) S k A₀),
          ‖∏ i, cosetFun S f A₀ (s i) x‖ ^ 2 := by
      intro x
      rw [sum_pow']
      exact sum_congr rfl fun s _ => by rw [norm_prod, prod_pow]
    simp_rw [e]
    exact summable_sum fun s hs => hsq (summable_norm_prod_fin hr fun i =>
      summable_cosetFun hf (Fintype.mem_piFinset.1 hs i))
  have hL : Summable fun x => ‖∑ α ∈ sigmaLe S k, f α x‖ ^ (2 * r) :=
    summable_pow_of_summable_nonneg (fun _ => norm_nonneg _)
      (Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun _ => norm_sum_le _ _)
        (summable_sum fun α hα => hf α hα)) (by omega)
  have hnn : ∀ A₀ : Finset ℕ,
      0 ≤ ∑' x, (∑ α ∈ sigmaUpper S k A₀, ‖cosetFun S f A₀ α x‖ ^ 2) ^ r := fun A₀ =>
    tsum_nonneg fun x => by positivity
  rw [← ENNReal.ofReal_le_ofReal_iff
      (mul_nonneg (normDescConst_nonneg k r) (sum_nonneg fun A₀ _ => hnn A₀)),
    ENNReal.ofReal_mul (normDescConst_nonneg k r),
    ENNReal.ofReal_sum_of_nonneg (fun A₀ _ => hnn A₀), ← tsum_enorm_pow_eq_ofReal hL]
  refine h.trans (le_of_eq ?_)
  congr 1
  refine sum_congr rfl fun A₀ _ => ?_
  rw [ENNReal.ofReal_tsum_of_nonneg (fun x => by positivity) (hR A₀)]
  refine tsum_congr fun x => ?_
  rw [ENNReal.ofReal_pow (sum_nonneg fun _ _ => sq_nonneg _),
    ENNReal.ofReal_sum_of_nonneg fun _ _ => sq_nonneg _]
  simp_rw [enorm_pow_eq_ofReal]

/-- Blueprint Lemma 7.5 (`lem:normdescription`), eq. (7.3) (`eq:normdescription`), in
`eLpNorm` form on `ℤⁿ` with counting measure: for `r ≥ 1`,
`‖∑_{α ∈ Σ_{≤k}} f_α‖_{2r}^{2r} ≤ C_{k,r} ∑_{A₀ ⊆ S, |A₀| ≤ k}
‖(∑_{α ∈ Σ^{A₀}} |f_{A₀,α}|²)^{1/2}‖_{2r}^{2r}` with `C_{k,r} = normDescConst k r`. -/
theorem normdescription_eLpNorm {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} (hr : 0 < r)
    {ε : ℝ} (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    (f : (Fin n → ZMod (blockProd S)) → (Fin n → ℤ) → ℂ)
    (hf : ∀ α ∈ sigmaLe S k, Summable fun z => ‖f α z‖)
    (hsupp : ∀ α ∈ sigmaLe S k, ∀ ξ ∉ ratNbhd (blockProd S) ε α, latFT (f α) ξ = 0) :
    eLpNorm (∑ α ∈ sigmaLe S k, f α) (ENNReal.ofReal (2 * r)) Measure.count ^ (2 * r) ≤
      ENNReal.ofReal (normDescConst k r) *
        ∑ A₀ ∈ S.powerset with #A₀ ≤ k,
          eLpNorm (fun x => Real.sqrt (∑ α ∈ sigmaUpper S k A₀, ‖cosetFun S f A₀ α x‖ ^ 2))
            (ENNReal.ofReal (2 * r)) Measure.count ^ (2 * r) := by
  rw [eLpNorm_count_pow_eq_tsum hr]
  simp_rw [eLpNorm_count_pow_eq_tsum hr]
  refine (le_of_eq ?_).trans ((normdescription_enorm hS1 hS hr hε hεr f hf hsupp).trans
    (le_of_eq ?_))
  · exact tsum_congr fun x => by rw [Finset.sum_apply]
  · congr 1
    refine sum_congr rfl fun A₀ _ => tsum_congr fun x => ?_
    rw [enorm_sqrt_pow_two_mul (sum_nonneg fun _ _ => sq_nonneg _),
      ENNReal.ofReal_sum_of_nonneg fun _ _ => sq_nonneg _]
    simp_rw [enorm_pow_eq_ofReal]

end NormDescription


/-! ### Blueprint Lemma 7.6 (`lem:companion`): companion projections -/

section Companion

open MeasureTheory Set Real
open scoped ComplexConjugate FourierTransform ContDiff SchwartzMap LineDeriv Laplacian

/-- The one-dimensional profile of the companion cutoff: a smooth bump on `ℝ` equal to `1` on
`[-1,1]` and vanishing outside `(-2,2)`. -/
noncomputable def companionBump : ContDiffBump (0 : ℝ) := ⟨1, 2, one_pos, one_lt_two⟩

/-- The fixed smooth product cutoff `θ(ξ) = ∏ᵢ ψ(ξᵢ)` of Blueprint Lemma 7.6 (`lem:companion`). -/
noncomputable def companionCutoff (n : ℕ) (ξ : EuclideanSpace ℝ (Fin n)) : ℝ :=
  ∏ i, companionBump (ξ i)

lemma companionCutoff_nonneg (ξ : EuclideanSpace ℝ (Fin n)) : 0 ≤ companionCutoff n ξ :=
  Finset.prod_nonneg fun _ _ => companionBump.nonneg

lemma companionCutoff_le_one (ξ : EuclideanSpace ℝ (Fin n)) : companionCutoff n ξ ≤ 1 :=
  Finset.prod_le_one₀ (fun _ _ => companionBump.nonneg) fun _ _ => companionBump.le_one

lemma companionCutoff_eq_one {ξ : EuclideanSpace ℝ (Fin n)} (h : ∀ i, |ξ i| ≤ 1) :
    companionCutoff n ξ = 1 :=
  Finset.prod_eq_one fun i _ => companionBump.one_of_mem_closedBall (by
    rw [Metric.mem_closedBall, dist_zero_right, Real.norm_eq_abs]; exact h i)

lemma companionCutoff_eq_zero {ξ : EuclideanSpace ℝ (Fin n)} (h : ¬ ∀ i, |ξ i| < 2) :
    companionCutoff n ξ = 0 := by
  push Not at h
  obtain ⟨i, hi⟩ := h
  refine Finset.prod_eq_zero (Finset.mem_univ i) ?_
  rw [← Function.notMem_support, companionBump.support_eq]
  simp only [Metric.mem_ball, dist_zero_right, Real.norm_eq_abs, not_lt]
  exact hi

lemma contDiff_companionCutoff : ContDiff ℝ ∞ (companionCutoff n) := by
  unfold companionCutoff
  refine contDiff_prod fun i _ => companionBump.contDiff.comp ?_
  exact (EuclideanSpace.proj (𝕜 := ℝ) i).contDiff

lemma isCompact_box (c : ℝ) : IsCompact {ξ : EuclideanSpace ℝ (Fin n) | ∀ i, |ξ i| ≤ c} := by
  have : {ξ : EuclideanSpace ℝ (Fin n) | ∀ i, |ξ i| ≤ c} =
      (EuclideanSpace.equiv (Fin n) ℝ) ⁻¹' Set.pi Set.univ fun _ => Set.Icc (-c) c := by
    ext ξ; simp [abs_le, Pi.le_def, forall_and]
  rw [this]
  exact (EuclideanSpace.equiv (Fin n) ℝ).toHomeomorph.isCompact_preimage.2
    (isCompact_univ_pi fun _ => isCompact_Icc)

lemma hasCompactSupport_companionCutoff : HasCompactSupport (companionCutoff n) := by
  refine HasCompactSupport.intro (isCompact_box 2) fun ξ hξ => companionCutoff_eq_zero ?_
  intro h; exact hξ fun i => (h i).le

/-- The cutoff `θ` as a (complex-valued) Schwartz function. -/
noncomputable def cutoffSchwartz (n : ℕ) : 𝓢(EuclideanSpace ℝ (Fin n), ℂ) :=
  (hasCompactSupport_companionCutoff (n := n)).comp_left (g := Complex.ofReal) Complex.ofReal_zero
    |>.toSchwartzMap (Complex.ofRealCLM.contDiff.comp contDiff_companionCutoff)

@[simp] lemma cutoffSchwartz_apply (ξ : EuclideanSpace ℝ (Fin n)) :
    cutoffSchwartz n ξ = (companionCutoff n ξ : ℂ) := rfl

/-- One step `L f = f - (4π²)⁻¹ Δ f` of the operator whose `(n+1)`-th power multiplies the inverse
Fourier transform by `(1 + |y|²)^{n+1}`. -/
noncomputable def lapStep (f : 𝓢(EuclideanSpace ℝ (Fin n), ℂ)) :
    𝓢(EuclideanSpace ℝ (Fin n), ℂ) :=
  f - ((4 * π ^ 2 : ℝ)⁻¹ : ℂ) • Δ f

lemma fourierInv_lineDeriv_apply (f : 𝓢(EuclideanSpace ℝ (Fin n), ℂ))
    (m y : EuclideanSpace ℝ (Fin n)) :
    𝓕⁻ (∂_{m} f) y = -(2 * π * Complex.I) * (inner ℝ y m : ℂ) * 𝓕⁻ f y := by
  rw [SchwartzMap.fourierInv_lineDerivOp_eq]
  have : (inner ℝ · m).HasTemperateGrowth := by fun_prop
  simp [SchwartzMap.smulLeftCLM_apply_apply this]
  ring

lemma fourierInv_laplacian_apply (f : 𝓢(EuclideanSpace ℝ (Fin n), ℂ))
    (y : EuclideanSpace ℝ (Fin n)) :
    𝓕⁻ (Δ f) y = -(4 * π ^ 2 * ‖y‖ ^ 2 : ℝ) * 𝓕⁻ f y := by
  set b := EuclideanSpace.basisFun (Fin n) ℝ
  rw [SchwartzMap.laplacian_eq_sum b, FourierTransform.fourierInv_sum, _root_.sum_apply]
  simp_rw [fourierInv_lineDeriv_apply]
  rw [← b.sum_sq_inner_left y]
  push_cast
  rw [Finset.mul_sum, ← Finset.sum_neg_distrib, Finset.sum_mul]
  refine Finset.sum_congr rfl fun i _ => ?_
  have : (2 * π * Complex.I) ^ 2 = -(4 * π ^ 2) := by
    rw [mul_pow, Complex.I_sq]; ring
  linear_combination (inner ℝ y (b i) : ℂ) ^ 2 * 𝓕⁻ f y * this

lemma fourierInv_lapStep_apply (f : 𝓢(EuclideanSpace ℝ (Fin n), ℂ))
    (y : EuclideanSpace ℝ (Fin n)) :
    𝓕⁻ (lapStep f) y = (1 + ‖y‖ ^ 2 : ℝ) * 𝓕⁻ f y := by
  rw [lapStep, sub_eq_add_neg, FourierTransform.fourierInv_add,
    FourierTransform.fourierInv_neg, FourierTransform.fourierInv_smul]
  simp only [add_apply, neg_apply, smul_apply,
    fourierInv_laplacian_apply, smul_eq_mul]
  have : (π : ℂ) ≠ 0 := by exact_mod_cast Real.pi_ne_zero
  push_cast
  field_simp

lemma tsupport_lineDeriv_subset (g : 𝓢(EuclideanSpace ℝ (Fin n), ℂ))
    (m : EuclideanSpace ℝ (Fin n)) :
    tsupport ⇑(∂_{m} g : 𝓢(EuclideanSpace ℝ (Fin n), ℂ)) ⊆ tsupport g :=
  closure_minimal (fun x hx => support_fderiv_subset (𝕜 := ℝ) (f := ⇑g)
    (show fderiv ℝ g x ≠ 0 from fun h => hx (by
      rw [SchwartzMap.lineDerivOp_apply_eq_fderiv, h]; rfl))) (isClosed_tsupport _)

lemma support_laplacian_subset (f : 𝓢(EuclideanSpace ℝ (Fin n), ℂ)) :
    Function.support ⇑(Δ f : 𝓢(EuclideanSpace ℝ (Fin n), ℂ)) ⊆ tsupport f := by
  set b := EuclideanSpace.basisFun (Fin n) ℝ
  intro x hx
  rw [SchwartzMap.laplacian_eq_sum b, Function.mem_support, _root_.sum_apply] at hx
  obtain ⟨i, -, hi⟩ := Finset.exists_ne_zero_of_sum_ne_zero hx
  exact tsupport_lineDeriv_subset f (b i) (tsupport_lineDeriv_subset _ (b i)
    (subset_tsupport _ hi))

lemma support_lapStep_subset (f : 𝓢(EuclideanSpace ℝ (Fin n), ℂ)) :
    Function.support (lapStep f) ⊆ tsupport f := by
  intro x hx
  by_contra h
  apply hx
  have h1 : f x = 0 := image_eq_zero_of_notMem_tsupport h
  have h2 : (Δ f) x = 0 := by
    by_contra h2; exact h (support_laplacian_subset f h2)
  simp [lapStep, h1, h2]

/-- The Schwartz function `Φ = L^{n+1} θ`, whose inverse Fourier transform is
`(1 + |y|²)^{n+1} θ̌(y)` and whose support lies in `[-2,2]ⁿ` (the weighted bump of the proof of
Blueprint Lemma 7.6 (`lem:companion`)). -/
noncomputable def companionPhi (n : ℕ) : 𝓢(EuclideanSpace ℝ (Fin n), ℂ) :=
  lapStep^[n + 1] (cutoffSchwartz n)

lemma fourierInv_lapStep_iterate (f : 𝓢(EuclideanSpace ℝ (Fin n), ℂ)) (j : ℕ)
    (y : EuclideanSpace ℝ (Fin n)) :
    𝓕⁻ (lapStep^[j] f) y = ((1 + ‖y‖ ^ 2) ^ j : ℝ) * 𝓕⁻ f y := by
  induction j with
  | zero => simp
  | succ j ih =>
    rw [Function.iterate_succ_apply', fourierInv_lapStep_apply, ih]
    push_cast; ring

lemma fourierInv_companionPhi (y : EuclideanSpace ℝ (Fin n)) :
    𝓕⁻ (companionPhi n) y = ((1 + ‖y‖ ^ 2) ^ (n + 1) : ℝ) * 𝓕⁻ (cutoffSchwartz n) y :=
  fourierInv_lapStep_iterate _ _ _

lemma isClosed_box (c : ℝ) : IsClosed {ξ : EuclideanSpace ℝ (Fin n) | ∀ i, |ξ i| ≤ c} :=
  (isCompact_box c).isClosed

lemma tsupport_cutoffSchwartz_subset :
    tsupport ⇑(cutoffSchwartz n) ⊆ {ξ : EuclideanSpace ℝ (Fin n) | ∀ i, |ξ i| ≤ 2} := by
  refine closure_minimal (fun ξ hξ => ?_) (isClosed_box 2)
  by_contra h
  apply hξ
  rw [cutoffSchwartz_apply, companionCutoff_eq_zero, Complex.ofReal_zero]
  intro h'; exact h fun i => (h' i).le

lemma tsupport_lapStep_iterate_subset (j : ℕ) :
    tsupport ⇑(lapStep^[j] (cutoffSchwartz n)) ⊆
      {ξ : EuclideanSpace ℝ (Fin n) | ∀ i, |ξ i| ≤ 2} := by
  induction j with
  | zero => exact tsupport_cutoffSchwartz_subset
  | succ j ih =>
    rw [Function.iterate_succ_apply']
    exact closure_minimal ((support_lapStep_subset _).trans ih) (isClosed_box 2)

lemma companionPhi_eq_zero {ξ : EuclideanSpace ℝ (Fin n)} (h : ¬ ∀ i, |ξ i| ≤ 2) :
    companionPhi n ξ = 0 :=
  image_eq_zero_of_notMem_tsupport fun h' => h (tsupport_lapStep_iterate_subset _ h')

/-- `θ_ε(ξ) = θ(ξ/ε)` (Blueprint Lemma 7.6 (`lem:companion`)). -/
noncomputable def cutoffEps (n : ℕ) (ε : ℝ) (ξ : EuclideanSpace ℝ (Fin n)) : ℂ :=
  (companionCutoff n (ε⁻¹ • ξ) : ℂ)

/-- `φ_ε(ξ) = Φ(ξ/ε)`: its inverse Fourier transform is `(1 + ε²|y|²)^{n+1} θ̌_ε(y)`. -/
noncomputable def phiEps (n : ℕ) (ε : ℝ) (ξ : EuclideanSpace ℝ (Fin n)) : ℂ :=
  companionPhi n (ε⁻¹ • ξ)

lemma norm_cutoffEps_le (ε : ℝ) (ξ : EuclideanSpace ℝ (Fin n)) : ‖cutoffEps n ε ξ‖ ≤ 1 := by
  rw [cutoffEps, Complex.norm_real, Real.norm_of_nonneg (companionCutoff_nonneg _)]
  exact companionCutoff_le_one _

lemma cutoffEps_eq_one {ε : ℝ} (hε : 0 < ε) {ξ : EuclideanSpace ℝ (Fin n)}
    (h : ∀ i, |ξ i| ≤ ε) : cutoffEps n ε ξ = 1 := by
  rw [cutoffEps, companionCutoff_eq_one, Complex.ofReal_one]
  intro i
  simp only [PiLp.smul_apply, smul_eq_mul, abs_mul, abs_inv, abs_of_pos hε]
  rw [inv_mul_le_iff₀ hε, mul_one]; exact h i

lemma abs_le_of_smul_box {ε : ℝ} (hε : 0 < ε) {ξ : EuclideanSpace ℝ (Fin n)}
    (h : ∀ i, |(ε⁻¹ • ξ) i| ≤ 2) (i : Fin n) : |ξ i| ≤ 2 * ε := by
  have := h i
  simp only [PiLp.smul_apply, smul_eq_mul, abs_mul, abs_inv, abs_of_pos hε] at this
  rwa [inv_mul_le_iff₀ hε, mul_comm] at this

lemma cutoffEps_eq_zero {ε : ℝ} (hε : 0 < ε) {ξ : EuclideanSpace ℝ (Fin n)}
    (h : ¬ ∀ i, |ξ i| ≤ 2 * ε) : cutoffEps n ε ξ = 0 := by
  rw [cutoffEps, companionCutoff_eq_zero, Complex.ofReal_zero]
  intro h'; exact h (abs_le_of_smul_box hε fun i => (h' i).le)

lemma phiEps_eq_zero {ε : ℝ} (hε : 0 < ε) {ξ : EuclideanSpace ℝ (Fin n)}
    (h : ¬ ∀ i, |ξ i| ≤ 2 * ε) : phiEps n ε ξ = 0 := by
  rw [phiEps, companionPhi_eq_zero]
  intro h'; exact h (abs_le_of_smul_box hε h')

lemma continuous_cutoffEps (ε : ℝ) : Continuous (cutoffEps n ε) :=
  Complex.continuous_ofReal.comp (contDiff_companionCutoff.continuous.comp
    (continuous_const_smul _))

lemma continuous_phiEps (ε : ℝ) : Continuous (phiEps n ε) :=
  (companionPhi n).continuous.comp (continuous_const_smul _)

lemma integrable_cutoffEps {ε : ℝ} (hε : 0 < ε) : Integrable (cutoffEps n ε) :=
  (continuous_cutoffEps ε).integrable_of_hasCompactSupport
    (HasCompactSupport.intro (isCompact_box (2 * ε)) fun _ h => cutoffEps_eq_zero hε h)

lemma integrable_phiEps {ε : ℝ} (hε : 0 < ε) : Integrable (phiEps n ε) :=
  (continuous_phiEps ε).integrable_of_hasCompactSupport
    (HasCompactSupport.intro (isCompact_box (2 * ε)) fun _ h => phiEps_eq_zero hε h)

lemma fourierInv_cutoffEps {ε : ℝ} (hε : 0 < ε) (y : EuclideanSpace ℝ (Fin n)) :
    𝓕⁻ (cutoffEps n ε) y = (ε ^ n : ℝ) * 𝓕⁻ (cutoffSchwartz n) (ε • y) := by
  have := fourierInv_comp_inv_smul (⇑(cutoffSchwartz n)) hε y
  rw [SchwartzMap.fourierInv_coe]
  exact this

lemma fourierInv_phiEps {ε : ℝ} (hε : 0 < ε) (y : EuclideanSpace ℝ (Fin n)) :
    𝓕⁻ (phiEps n ε) y = ((1 + ε ^ 2 * ‖y‖ ^ 2) ^ (n + 1) : ℝ) * 𝓕⁻ (cutoffEps n ε) y := by
  have := fourierInv_comp_inv_smul (⇑(companionPhi n)) hε y
  change 𝓕⁻ (fun ξ => companionPhi n (ε⁻¹ • ξ)) y = _
  rw [this, fourierInv_cutoffEps hε, ← SchwartzMap.fourierInv_coe,
    fourierInv_companionPhi, norm_smul, Real.norm_of_nonneg hε.le]
  push_cast; ring

/-- The constant `∫ |Φ|²`. -/
noncomputable def companionPhiL2 (n : ℕ) : ℝ := ∫ ξ, ‖companionPhi n ξ‖ ^ 2

lemma integral_norm_sq_phiEps {ε : ℝ} (hε : 0 < ε) :
    ∫ ξ, ‖phiEps n ε ξ‖ ^ 2 = ε ^ n * companionPhiL2 n := by
  have := Measure.integral_comp_inv_smul_of_nonneg (μ := volume)
    (fun ξ : EuclideanSpace ℝ (Fin n) => ‖companionPhi n ξ‖ ^ 2) hε.le
  rw [finrank_euclideanSpace_fin, smul_eq_mul] at this
  exact this

/-! ### Bessel's inequality with the symbol in `L²` -/

/-- Bessel's inequality for lattice multipliers with the exact `L²` bound: for `m` bounded and
a.e. strongly measurable on `[0,1)ⁿ` and `f ∈ ℓ¹`,
`∑_x |m(D) f(x)|² ≤ ∫_{[0,1)ⁿ} |m|² |f̂|²`. -/
theorem summable_and_tsum_norm_sq_latMult_le_integral {m : EuclideanSpace ℝ (Fin n) → ℂ} {A : ℝ}
    (hm : AEStronglyMeasurable m (volume.restrict (torusCube n)))
    (hA : ∀ ξ ∈ torusCube n, ‖m ξ‖ ≤ A) {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) :
    Summable (fun x => ‖latMult m f x‖ ^ 2) ∧
      ∑' x, ‖latMult m f x‖ ^ 2 ≤ ∫ ξ in torusCube n, ‖m ξ‖ ^ 2 * ‖latFT f ξ‖ ^ 2 := by
  set μ := volume.restrict (torusCube n)
  set B := ∑' z, ‖f z‖
  have hg_meas : AEStronglyMeasurable (fun ξ => m ξ * latFT f ξ) μ :=
    hm.mul (continuous_latFT hf).aestronglyMeasurable
  have hbound : ∀ ξ ∈ torusCube n, ‖m ξ * latFT f ξ‖ ≤ A * ‖latFT f ξ‖ := fun ξ hξ => by
    rw [norm_mul]; exact mul_le_mul_of_nonneg_right (hA ξ hξ) (norm_nonneg _)
  have hgL : MemLp (fun ξ => m ξ * latFT f ξ) 2 μ :=
    MemLp.of_bound hg_meas (|A| * B) (ae_restrict_of_forall_mem measurableSet_torusCube
      fun ξ hξ => (hbound ξ hξ).trans (mul_le_mul (le_abs_self A) (norm_latFT_le hf ξ)
        (norm_nonneg _) (abs_nonneg A)))
  set g := hgL.toLp
  have hcoe := hgL.coeFn_toLp
  have hinner : ∀ y, inner ℂ (torusChar n y) g = latMult m f (-y) := by
    intro y
    rw [L2.inner_def, latMult]
    refine integral_congr_ae ?_
    filter_upwards [hcoe, MemLp.coeFn_toLp (μ := μ) (p := 2)
      (f := fun ξ => eC (inner ℝ (latEmbed y) ξ)) (MemLp.of_bound (by fun_prop) 1
        (Filter.Eventually.of_forall fun ξ => le_of_eq (norm_eC _)))] with ξ hg hy
    simp only [torusChar] at *
    rw [hg, hy, RCLike.inner_apply', conj_eC, latEmbed_neg, inner_neg_left]
    ring
  have hnorm : ‖g‖ ^ 2 = ∫ ξ in torusCube n, ‖m ξ * latFT f ξ‖ ^ 2 := by
    rw [@norm_sq_eq_re_inner ℂ, L2.inner_def]
    have : ∫ ξ, (inner ℂ (g ξ) (g ξ) : ℂ) ∂μ =
        ((∫ ξ in torusCube n, ‖m ξ * latFT f ξ‖ ^ 2 : ℝ) : ℂ) := by
      rw [← integral_complex_ofReal]
      refine integral_congr_ae ?_
      filter_upwards [hcoe] with ξ hξ
      rw [hξ, inner_self_eq_norm_sq_to_K]; push_cast; rfl
    rw [this]; exact Complex.ofReal_re _
  have hsum := (orthonormal_torusChar (n := n)).inner_products_summable g
  have htsum := (orthonormal_torusChar (n := n)).tsum_inner_products_le g
  simp_rw [hinner] at hsum htsum
  refine ⟨(Equiv.neg _).summable_iff.1 hsum, ?_⟩
  rw [← (Equiv.neg (Fin n → ℤ)).tsum_eq]
  refine htsum.trans (le_of_eq ?_)
  rw [hnorm]
  congr 1; funext ξ; rw [norm_mul, mul_pow]

/-- The unit impulse `δ₀` on `ℤⁿ`. -/
def latDelta (n : ℕ) (z : Fin n → ℤ) : ℂ := if z = 0 then 1 else 0

lemma summable_latDelta : Summable fun z => ‖latDelta n z‖ :=
  summable_of_ne_finset_zero (s := {0}) fun z hz => by
    simp only [Finset.mem_singleton] at hz; simp [latDelta, hz]

lemma latFT_latDelta (ξ : EuclideanSpace ℝ (Fin n)) : latFT (latDelta n) ξ = 1 := by
  unfold latFT latDelta
  rw [tsum_eq_single 0 fun z hz => by simp [hz]]
  simp [latEmbed_zero, eC_zero]

lemma latMult_latDelta (m : EuclideanSpace ℝ (Fin n) → ℂ) :
    latMult m (latDelta n) = latKernel m := by
  funext y; simp [latMult, latKernel, latFT_latDelta]

/-- Bessel's inequality for inverse Fourier coefficients: for `m` bounded and a.e. strongly
measurable on `[0,1)ⁿ`, `∑_y |m̌(y)|² ≤ ∫_{[0,1)ⁿ} |m|²`. -/
theorem summable_and_tsum_norm_sq_latKernel_le {m : EuclideanSpace ℝ (Fin n) → ℂ} {A : ℝ}
    (hm : AEStronglyMeasurable m (volume.restrict (torusCube n)))
    (hA : ∀ ξ ∈ torusCube n, ‖m ξ‖ ≤ A) :
    Summable (fun y => ‖latKernel m y‖ ^ 2) ∧
      ∑' y, ‖latKernel m y‖ ^ 2 ≤ ∫ ξ in torusCube n, ‖m ξ‖ ^ 2 := by
  have h := summable_and_tsum_norm_sq_latMult_le_integral hm hA (summable_latDelta (n := n))
  simp only [latMult_latDelta, latFT_latDelta, norm_one, one_pow, mul_one] at h
  exact h

/-! ### Disjointness of the bumps at the centers of `Σ_{≤k}` -/

lemma one_le_of_le_eps {r m q : ℕ} {ε : ℝ} (hε : 0 < ε)
    (hεr : ε ≤ (100 * r * (q : ℝ) ^ m)⁻¹) : 1 ≤ r := by
  rcases Nat.eq_zero_or_pos r with rfl | hr
  · simp at hεr; linarith
  · exact hr

lemma four_mul_lt_one_of_le_eps {r m q : ℕ} (hq : 1 ≤ q) {ε : ℝ} (hε : 0 < ε)
    (hεr : ε ≤ (100 * r * (q : ℝ) ^ m)⁻¹) : 4 * ε < 1 := by
  have h1 := four_mul_lt_of_le_eps hq hεr
  have hr : (1 : ℝ) ≤ r := by exact_mod_cast one_le_of_le_eps hε hεr
  have h2 : ((q : ℝ) ^ m)⁻¹ ≤ 1 := inv_le_one_of_one_le₀ (one_le_pow₀ (by exact_mod_cast hq))
  nlinarith

/-- Two lattice points within `2ε < 1/2` of the same point coincide. -/
lemma eq_of_abs_sub_intCast_le {ε : ℝ} (hε4 : 4 * ε < 1) {η : EuclideanSpace ℝ (Fin n)}
    {z z' : Fin n → ℤ} (h : ∀ i, |η i - z i| ≤ 2 * ε) (h' : ∀ i, |η i - z' i| ≤ 2 * ε) :
    z = z' := by
  funext i
  have h1 := h i
  have h2 := h' i
  have h3 : |((z i - z' i : ℤ) : ℝ)| < 1 := by
    push_cast
    calc |(z i : ℝ) - z' i| = |(η i - z' i) - (η i - z i)| := by ring_nf
      _ ≤ |η i - z' i| + |η i - z i| := abs_sub _ _
      _ < 1 := by linarith
  have := Int.abs_lt_one_iff.1 (by exact_mod_cast h3)
  omega

/-- The separation property (7.1) for two centers: if `ξ` is within `2ε` (in each coordinate,
modulo `ℤⁿ`) of two centers `γ, γ' ∈ Σ_{≤k}`, then `γ = γ'`. -/
theorem eq_of_near_ratPt {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} {ε : ℝ}
    (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    {γ γ' : Fin n → ZMod (blockProd S)} (hγ : γ ∈ sigmaLe S k) (hγ' : γ' ∈ sigmaLe S k)
    {ξ : EuclideanSpace ℝ (Fin n)} {z z' : Fin n → ℤ}
    (h : ∀ i, |ξ i - ratPt (blockProd S) γ i - z i| ≤ 2 * ε)
    (h' : ∀ i, |ξ i - ratPt (blockProd S) γ' i - z' i| ≤ 2 * ε) : γ = γ' := by
  by_contra hne
  have hr := one_le_of_le_eps hε hεr
  have hsep := separation hS1 hS hε hεr (Finset.univ : Finset (Fin 2)) (by simp; omega)
    ![γ, γ'] (by intro j _; fin_cases j <;> simpa) ![1, -1]
    (by intro j _; fin_cases j <;> simp)
    (by simp [Fin.sum_univ_two, ← sub_eq_add_neg, sub_eq_zero, hne])
    ![ξ - ratPt (blockProd S) γ - latEmbed z, ξ - ratPt (blockProd S) γ' - latEmbed z']
    (by
      intro j _ i
      fin_cases j
      · simpa [latEmbed_apply] using h i
      · simpa [latEmbed_apply] using h' i)
  apply hsep
  refine ⟨z' - z, ?_⟩
  simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one, one_smul,
    neg_smul, latEmbed_sub]
  abel

/-- Among the members of a family at most one of which is nonzero, the square of the norm of the
sum is the sum of the squares of the norms. -/
lemma norm_sq_tsum_of_atMostOne {ι : Type*} (a : ι → ℂ)
    (h : ∀ i j, a i ≠ 0 → a j ≠ 0 → i = j) : ‖∑' i, a i‖ ^ 2 = ∑' i, ‖a i‖ ^ 2 := by
  by_cases hex : ∃ i, a i ≠ 0
  · obtain ⟨i, hi⟩ := hex
    rw [tsum_eq_single i fun j hj => by by_contra h'; exact hj (h j i h' hi),
      tsum_eq_single i fun j hj => by
        have : a j = 0 := by by_contra h'; exact hj (h j i h' hi)
        simp [this]]
  · push Not at hex
    simp [hex]

lemma norm_sq_sum_of_atMostOne {ι : Type*} (s : Finset ι) (a : ι → ℂ)
    (h : ∀ i ∈ s, ∀ j ∈ s, a i ≠ 0 → a j ≠ 0 → i = j) :
    ‖∑ i ∈ s, a i‖ ^ 2 = ∑ i ∈ s, ‖a i‖ ^ 2 := by
  by_cases hex : ∃ i ∈ s, a i ≠ 0
  · obtain ⟨i, his, hi⟩ := hex
    rw [Finset.sum_eq_single_of_mem i his fun j hjs hj => by
        by_contra h'; exact hj (h j hjs i his h' hi),
      Finset.sum_eq_single_of_mem i his fun j hjs hj => by
        have : a j = 0 := by by_contra h'; exact hj (h j hjs i his h' hi)
        simp [this]]
  · push Not at hex
    rw [Finset.sum_eq_zero hex, Finset.sum_eq_zero fun i hi => by simp [hex i hi]]
    simp

lemma sum_le_of_atMostOne {ι : Type*} (s : Finset ι) (a : ι → ℝ) {B : ℝ} (hB0 : 0 ≤ B)
    (hB : ∀ i ∈ s, a i ≤ B) (h : ∀ i ∈ s, ∀ j ∈ s, a i ≠ 0 → a j ≠ 0 → i = j) :
    ∑ i ∈ s, a i ≤ B := by
  by_cases hex : ∃ i ∈ s, a i ≠ 0
  · obtain ⟨i, his, hi⟩ := hex
    rw [Finset.sum_eq_single_of_mem i his fun j hjs hj => by
        by_contra h'; exact hj (h j hjs i his h' hi)]
    exact hB i his
  · push Not at hex
    rw [Finset.sum_eq_zero hex]; exact hB0

lemma exists_ne_zero_of_periodize_ne_zero {m : EuclideanSpace ℝ (Fin n) → ℂ}
    {η : EuclideanSpace ℝ (Fin n)} (h : periodize m η ≠ 0) :
    ∃ z : Fin n → ℤ, m (η - latEmbed z) ≠ 0 := by
  by_contra h'
  push Not at h'
  exact h (by simp [periodize, h'])

section Bumps

variable {m : EuclideanSpace ℝ (Fin n) → ℂ} {ε : ℝ}
  (hmε : ∀ η, m η ≠ 0 → ∀ i, |η i| ≤ 2 * ε)
include hmε

/-- For a symbol supported in `[-2ε, 2ε]ⁿ` with `4ε < 1`, at most one lattice translate is
nonzero at any point. -/
lemma periodize_atMostOne (hε4 : 4 * ε < 1) (η : EuclideanSpace ℝ (Fin n)) (z z' : Fin n → ℤ)
    (hz : m (η - latEmbed z) ≠ 0) (hz' : m (η - latEmbed z') ≠ 0) : z = z' :=
  eq_of_abs_sub_intCast_le hε4 (fun i => by simpa using hmε _ hz i)
    (fun i => by simpa using hmε _ hz' i)

lemma norm_periodize_le (hε4 : 4 * ε < 1) {M : ℝ} (hM0 : 0 ≤ M) (hM : ∀ η, ‖m η‖ ≤ M)
    (η : EuclideanSpace ℝ (Fin n)) : ‖periodize m η‖ ≤ M := by
  by_cases hex : ∃ z : Fin n → ℤ, m (η - latEmbed z) ≠ 0
  · obtain ⟨z, hz⟩ := hex
    rw [periodize, tsum_eq_single z fun z' hz' => by
      by_contra h; exact hz' (periodize_atMostOne hmε hε4 η z' z h hz)]
    exact hM _
  · push Not at hex
    simp [periodize, hex, hM0]

lemma norm_sq_periodize (hε4 : 4 * ε < 1) (η : EuclideanSpace ℝ (Fin n)) :
    ‖periodize m η‖ ^ 2 = ∑' z : Fin n → ℤ, ‖m (η - latEmbed z)‖ ^ 2 :=
  norm_sq_tsum_of_atMostOne _ fun z z' hz hz' => periodize_atMostOne hmε hε4 η z z' hz hz'

/-- At most one center `γ ∈ Σ_{≤k}` has `m_per(ξ - γ) ≠ 0`. -/
lemma periodize_center_atMostOne {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ}
    (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    {γ γ' : Fin n → ZMod (blockProd S)} (hγ : γ ∈ sigmaLe S k) (hγ' : γ' ∈ sigmaLe S k)
    (ξ : EuclideanSpace ℝ (Fin n))
    (h : periodize m (ξ - ratPt (blockProd S) γ) ≠ 0)
    (h' : periodize m (ξ - ratPt (blockProd S) γ') ≠ 0) : γ = γ' := by
  obtain ⟨z, hz⟩ := exists_ne_zero_of_periodize_ne_zero h
  obtain ⟨z', hz'⟩ := exists_ne_zero_of_periodize_ne_zero h'
  exact eq_of_near_ratPt hS1 hS hε hεr hγ hγ' (z := z) (z' := z')
    (fun i => by simpa [latEmbed_apply] using hmε _ hz i)
    (fun i => by simpa [latEmbed_apply] using hmε _ hz' i)

end Bumps

/-! ### The operators `T_{m;Λ}` and the companion projections -/

/-- The symbol `∑_{β ∈ Λ} m_per(ξ - β)` of `T_{m;Λ}` for a finite set `Λ ⊆ T[Q]` of torus points
(Blueprint Definition 7.1 (`def:blocks`)). -/
noncomputable def cosetSymbol (Q : ℕ) (m : EuclideanSpace ℝ (Fin n) → ℂ)
    (Λ : Finset (Fin n → ZMod Q)) (ξ : EuclideanSpace ℝ (Fin n)) : ℂ :=
  ∑ β ∈ Λ, periodize m (ξ - ratPt Q β)

/-- The lattice multiplier `T_{m;Λ} f` with symbol `∑_{β ∈ Λ} m_per(ξ - β)`. -/
noncomputable def cosetMult (Q : ℕ) (m : EuclideanSpace ℝ (Fin n) → ℂ)
    (Λ : Finset (Fin n → ZMod Q)) (f : (Fin n → ℤ) → ℂ) : (Fin n → ℤ) → ℂ :=
  latMult (cosetSymbol Q m Λ) f

/-- The coset `α + Σ_{A₀}` as a finite set of torus points. -/
def cosetSet (S : Finset ℕ) [NeZero (blockProd S)] (A₀ : Finset ℕ)
    (α : Fin n → ZMod (blockProd S)) : Finset (Fin n → ZMod (blockProd S)) :=
  (sigmaBlock S A₀).map (addLeftEmbedding α)

/-- The companion projection `P_{A₀,α} f = T_{θ_ε; α + Σ_{A₀}} f` of Blueprint Lemma 7.6
(`lem:companion`). -/
noncomputable def companionProj (S : Finset ℕ) [NeZero (blockProd S)] (ε : ℝ) (A₀ : Finset ℕ)
    (α : Fin n → ZMod (blockProd S)) (f : (Fin n → ℤ) → ℂ) : (Fin n → ℤ) → ℂ :=
  cosetMult (blockProd S) (cutoffEps n ε) (cosetSet S A₀ α) f

lemma cosetSymbol_cosetSet (S : Finset ℕ) [NeZero (blockProd S)] (m : EuclideanSpace ℝ (Fin n) → ℂ)
    (A₀ : Finset ℕ) (α : Fin n → ZMod (blockProd S)) (ξ : EuclideanSpace ℝ (Fin n)) :
    cosetSymbol (blockProd S) m (cosetSet S A₀ α) ξ =
      ∑ β ∈ sigmaBlock S A₀, periodize m (ξ - ratPt (blockProd S) (α + β)) := by
  simp [cosetSymbol, cosetSet]

lemma integrableOn_periodize_sub {m : EuclideanSpace ℝ (Fin n) → ℂ} (hm : Integrable m)
    (c : EuclideanSpace ℝ (Fin n)) :
    IntegrableOn (fun ξ => periodize m (ξ - c)) (torusCube n) := by
  simp_rw [periodize_comp_sub]
  exact integrableOn_periodize (hm.comp_sub_right c)

lemma integrableOn_cosetSymbol {Q : ℕ} {m : EuclideanSpace ℝ (Fin n) → ℂ} (hm : Integrable m)
    (Λ : Finset (Fin n → ZMod Q)) : IntegrableOn (cosetSymbol Q m Λ) (torusCube n) := by
  unfold cosetSymbol
  exact integrable_finsetSum _ fun β _ => integrableOn_periodize_sub hm _

lemma ratPt_add_eq (Q : ℕ) [NeZero Q] (α β : Fin n → ZMod Q) :
    ∃ z : Fin n → ℤ, ratPt Q (α + β) = ratPt Q α + ratPt Q β + latEmbed z := by
  obtain ⟨z, hz⟩ := ratPt_sum_zsmul_sub_mem (Finset.univ : Finset (Fin 2)) (fun _ => 1) ![α, β]
  refine ⟨z, ?_⟩
  simpa [Fin.sum_univ_two] using hz

lemma periodize_sub_ratPt_add (m : EuclideanSpace ℝ (Fin n) → ℂ) (Q : ℕ) [NeZero Q]
    (α β : Fin n → ZMod Q) (ξ : EuclideanSpace ℝ (Fin n)) :
    periodize m (ξ - ratPt Q (α + β)) =
      periodize (fun η => m (η - ratPt Q α)) (ξ - ratPt Q β) := by
  obtain ⟨z, hz⟩ := ratPt_add_eq Q α β
  rw [hz, ← periodize_comp_sub]
  have : ξ - (ratPt Q α + ratPt Q β + latEmbed z) = ξ - ratPt Q β - ratPt Q α + latEmbed (-z) := by
    rw [latEmbed_neg]; abel
  rw [this, periodize_add_latEmbed]

/-- The shifted full-grid symbol `∑_{β ∈ T[d]} m_per(ξ - (α + β))` is `Δ_d (m(· - α))`. -/
lemma sum_blockGrid_periodize_add {Q d : ℕ} [NeZero Q] (hd : d ∣ Q)
    (m : EuclideanSpace ℝ (Fin n) → ℂ) (α : Fin n → ZMod Q) (ξ : EuclideanSpace ℝ (Fin n)) :
    ∑ β ∈ blockGrid Q d, periodize m (ξ - ratPt Q (α + β)) =
      gridSym d (fun η => m (η - ratPt Q α)) ξ := by
  simp_rw [periodize_sub_ratPt_add]
  exact sum_blockGrid_periodize_eq_gridSym hd _ ξ

/-- The kernel of `T_{m; α + T[d]}`: `d^n 𝟙_{d ∣ y} e(α · y) 𝓕⁻ m (y)`. -/
lemma latKernel_sum_blockGrid_periodize_add {Q d : ℕ} [NeZero Q] (hd : d ∣ Q)
    {m : EuclideanSpace ℝ (Fin n) → ℂ} (hm : Integrable m) (α : Fin n → ZMod Q)
    (y : Fin n → ℤ) :
    latKernel (fun ξ => ∑ β ∈ blockGrid Q d, periodize m (ξ - ratPt Q (α + β))) y =
      (if ∀ i, (d : ℤ) ∣ y i then (d : ℂ) ^ n else 0) *
        (eC (inner ℝ (ratPt Q α) (latEmbed y)) * 𝓕⁻ m (latEmbed y)) := by
  have hd1 : 1 ≤ d := Nat.pos_of_ne_zero fun h => NeZero.ne Q (Nat.eq_zero_of_zero_dvd (h ▸ hd))
  have e : (fun ξ => ∑ β ∈ blockGrid Q d, periodize m (ξ - ratPt Q (α + β))) =
      gridSym d (fun η => m (η - ratPt Q α)) := funext (sum_blockGrid_periodize_add hd m α)
  rw [e, latKernel_gridSym (hm.comp_sub_right _) hd1, fourierInv_comp_sub]

/-! ### Counting cores -/

lemma add_mem_sigmaLe_of_coset {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {k : ℕ} {A₀ : Finset ℕ} {α β : Fin n → ZMod (blockProd S)}
    (hα : α ∈ sigmaUpper S k A₀) (hβ : β ∈ sigmaBlock S A₀) : α + β ∈ sigmaLe S k := by
  have := (mem_coset_iff hS (α + β) α).1 ⟨hα, by rwa [add_sub_cancel_left]⟩
  exact mem_sigmaLe.2 this.2.1

/-- Reindexing `(α, β) ↦ α + β`, `α ∈ Σ^{A₀}`, `β ∈ Σ_{A₀}`, onto the centers `γ ∈ Σ_{≤k}` with
`A₀ ⊆ supp γ` (via `mem_coset_iff`). -/
lemma sum_sigmaUpper_sum_sigmaBlock_add {M : Type*} [AddCommMonoid M] {S : Finset ℕ}
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] (k : ℕ) (A₀ : Finset ℕ)
    (g : (Fin n → ZMod (blockProd S)) → M) :
    ∑ α ∈ sigmaUpper S k A₀, ∑ β ∈ sigmaBlock S A₀, g (α + β) =
      ∑ γ ∈ (sigmaLe S k).filter (fun γ => A₀ ⊆ blockSupp S γ), g γ := by
  rw [← Finset.sum_product' (f := fun α β => g (α + β))]
  refine Finset.sum_nbij' (fun p => p.1 + p.2)
    (fun γ => (blockProj S (S \ A₀) γ, γ - blockProj S (S \ A₀) γ)) ?_ ?_ ?_ ?_ ?_
  · rintro ⟨α, β⟩ hp
    simp only [Finset.mem_product] at hp
    have := (mem_coset_iff hS (α + β) α).1 ⟨hp.1, by rw [add_sub_cancel_left]; exact hp.2⟩
    simp only [Finset.mem_filter]
    exact ⟨mem_sigmaLe.2 this.2.1, this.1⟩
  · intro γ hγ
    simp only [Finset.mem_filter] at hγ
    have := (mem_coset_iff hS (k := k) (A₀ := A₀) γ (blockProj S (S \ A₀) γ)).2
      ⟨hγ.2, mem_sigmaLe.1 hγ.1, rfl⟩
    simp only [Finset.mem_product]
    exact this
  · rintro ⟨α, β⟩ hp
    simp only [Finset.mem_product] at hp
    have := (mem_coset_iff hS (α + β) α).1 ⟨hp.1, by rw [add_sub_cancel_left]; exact hp.2⟩
    simp only [← this.2.2, add_sub_cancel_left]
  · intro γ _
    simp
  · intro p _; rfl

/-- `∑_{|A₀| ≤ k} ∑_{α ∈ Σ^{A₀}} ∑_{β ∈ Σ_{A₀}} g(α + β) ≤ 2^k ∑_{γ ∈ Σ_{≤k}} g(γ)` for `g ≥ 0`:
a center with support `A` occurs for at most `2^{|A|} ≤ 2^k` cores. -/
lemma sum_cores_sum_sigmaUpper_le {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] (k : ℕ) (g : (Fin n → ZMod (blockProd S)) → ℝ)
    (hg : ∀ γ, 0 ≤ g γ) :
    ∑ A₀ ∈ S.powerset with #A₀ ≤ k, ∑ α ∈ sigmaUpper S k A₀, ∑ β ∈ sigmaBlock S A₀, g (α + β)
      ≤ 2 ^ k * ∑ γ ∈ sigmaLe S k, g γ := by
  simp_rw [sum_sigmaUpper_sum_sigmaBlock_add hS k]
  rw [Finset.sum_comm' (t' := sigmaLe S k)
    (s' := fun γ => (S.powerset.filter fun A₀ => #A₀ ≤ k).filter (· ⊆ blockSupp S γ))
    (h := fun A₀ γ => by simp only [Finset.mem_filter]; tauto)]
  rw [Finset.mul_sum]
  refine Finset.sum_le_sum fun γ hγ => ?_
  rw [Finset.sum_const, nsmul_eq_mul]
  refine mul_le_mul_of_nonneg_right ?_ (hg γ)
  have h1 : ((S.powerset.filter fun A₀ => #A₀ ≤ k).filter (· ⊆ blockSupp S γ)).card ≤
      (blockSupp S γ).powerset.card :=
    Finset.card_le_card fun A₀ hA₀ => Finset.mem_powerset.2 (Finset.mem_filter.1 hA₀).2
  rw [Finset.card_powerset] at h1
  have h2 : 2 ^ (blockSupp S γ).card ≤ 2 ^ k :=
    Nat.pow_le_pow_right (by norm_num) (mem_sigmaLe.1 hγ)
  exact_mod_cast h1.trans h2

/-! ### Blueprint Lemma 7.6 (`lem:companion`), the case `t = 2` -/

lemma cutoffEps_support {ε : ℝ} (hε : 0 < ε) :
    ∀ η, cutoffEps n ε η ≠ 0 → ∀ i, |η i| ≤ 2 * ε :=
  fun _ h => by by_contra h'; exact h (cutoffEps_eq_zero hε h')

lemma phiEps_support {ε : ℝ} (hε : 0 < ε) :
    ∀ η, phiEps n ε η ≠ 0 → ∀ i, |η i| ≤ 2 * ε :=
  fun _ h => by by_contra h'; exact h (phiEps_eq_zero hε h')

lemma four_eps_lt_one (S : Finset ℕ) {k r : ℕ} {ε : ℝ} (hε : 0 < ε)
    (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹) : 4 * ε < 1 :=
  four_mul_lt_one_of_le_eps (le_trans (by norm_num) (two_le_blockStar S)) hε hεr

/-- The pointwise bound behind the case `t = 2`: `∑_{|A₀| ≤ k} ∑_{α ∈ Σ^{A₀}} |M_{A₀,α}(ξ)|² ≤ 2^k`
for the symbols `M_{A₀,α} = ∑_{β ∈ α + Σ_{A₀}} (θ_ε)_per(· - β)`. -/
lemma sum_cores_norm_sq_cosetSymbol_le {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} {ε : ℝ}
    (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    (ξ : EuclideanSpace ℝ (Fin n)) :
    ∑ A₀ ∈ S.powerset with #A₀ ≤ k, ∑ α ∈ sigmaUpper S k A₀,
      ‖cosetSymbol (blockProd S) (cutoffEps n ε) (cosetSet S A₀ α) ξ‖ ^ 2 ≤ 2 ^ k := by
  have hsupp := cutoffEps_support (n := n) hε
  have hε4 := four_eps_lt_one S hε hεr
  have hAMO : ∀ γ ∈ sigmaLe S k, ∀ γ' ∈ sigmaLe S k,
      periodize (cutoffEps n ε) (ξ - ratPt (blockProd S) γ) ≠ 0 →
      periodize (cutoffEps n ε) (ξ - ratPt (blockProd S) γ') ≠ 0 → γ = γ' :=
    fun γ hγ γ' hγ' h h' => periodize_center_atMostOne hsupp hS1 hS hε hεr hγ hγ' ξ h h'
  have e : ∀ A₀, ∀ α ∈ sigmaUpper S k A₀,
      ‖cosetSymbol (blockProd S) (cutoffEps n ε) (cosetSet S A₀ α) ξ‖ ^ 2 =
        ∑ β ∈ sigmaBlock S A₀,
          ‖periodize (cutoffEps n ε) (ξ - ratPt (blockProd S) (α + β))‖ ^ 2 := by
    intro A₀ α hα
    rw [cosetSymbol_cosetSet]
    exact norm_sq_sum_of_atMostOne _ _ fun β hβ β' hβ' h h' => add_left_cancel
      (hAMO _ (add_mem_sigmaLe_of_coset hS hα hβ) _ (add_mem_sigmaLe_of_coset hS hα hβ') h h')
  have hp1 : ∀ γ, ‖periodize (cutoffEps n ε) (ξ - ratPt (blockProd S) γ)‖ ≤ 1 := fun γ =>
    norm_periodize_le hsupp hε4 zero_le_one (norm_cutoffEps_le ε) _
  rw [Finset.sum_congr rfl fun A₀ _ => Finset.sum_congr rfl fun α hα => e A₀ α hα]
  refine (sum_cores_sum_sigmaUpper_le hS k
    (fun γ => ‖periodize (cutoffEps n ε) (ξ - ratPt (blockProd S) γ)‖ ^ 2)
    fun _ => sq_nonneg _).trans ?_
  have h1 : ∑ γ ∈ sigmaLe S k, ‖periodize (cutoffEps n ε) (ξ - ratPt (blockProd S) γ)‖ ^ 2
      ≤ 1 := by
    refine sum_le_of_atMostOne _ _ zero_le_one
      (fun γ _ => pow_le_one₀ (norm_nonneg _) (hp1 γ)) fun γ hγ γ' hγ' h h' => ?_
    exact hAMO γ hγ γ' hγ' (fun h0 => h (by simp [h0])) (fun h0 => h' (by simp [h0]))
  calc (2 : ℝ) ^ k * ∑ γ ∈ sigmaLe S k,
        ‖periodize (cutoffEps n ε) (ξ - ratPt (blockProd S) γ)‖ ^ 2 ≤ 2 ^ k * 1 := by gcongr
    _ = 2 ^ k := mul_one _

lemma norm_cosetSymbol_cutoffEps_le {Q : ℕ} {ε : ℝ} (hε : 0 < ε) (hε4 : 4 * ε < 1)
    (Λ : Finset (Fin n → ZMod Q)) (ξ : EuclideanSpace ℝ (Fin n)) :
    ‖cosetSymbol Q (cutoffEps n ε) Λ ξ‖ ≤ Λ.card := by
  unfold cosetSymbol
  refine (norm_sum_le _ _).trans ?_
  have := Finset.sum_le_sum (s := Λ) fun β _ =>
    norm_periodize_le (cutoffEps_support hε) hε4 zero_le_one (norm_cutoffEps_le ε)
      (ξ - ratPt Q β)
  simpa using this

/-- Blueprint Lemma 7.6 (`lem:companion`), the case `t = 2`: under the separation hypothesis
(7.1) `0 < ε ≤ (100 r q_*^{2rk})⁻¹`, for every `f ∈ ℓ¹(ℤⁿ)` (in particular finitely supported
`f`), each `x ↦ P_{A₀,α} f(x) = T_{θ_ε; α + Σ_{A₀}} f(x)` is square summable and
`∑_{A₀ ⊆ S, |A₀| ≤ k} ∑_x ∑_{α ∈ Σ^{A₀}} |P_{A₀,α} f(x)|² ≤ 2^k ∑_x |f(x)|²`
(the constant is `2^k (sup θ)²` with `sup θ = 1`). -/
theorem companion_two {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} {ε : ℝ}
    (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) :
    (∀ A₀ α, Summable fun x => ‖companionProj S ε A₀ α f x‖ ^ 2) ∧
      ∑ A₀ ∈ S.powerset with #A₀ ≤ k, ∑' x, ∑ α ∈ sigmaUpper S k A₀,
          ‖companionProj S ε A₀ α f x‖ ^ 2 ≤ 2 ^ k * ∑' x, ‖f x‖ ^ 2 := by
  have hε4 := four_eps_lt_one S hε hεr
  set M : Finset ℕ → (Fin n → ZMod (blockProd S)) → EuclideanSpace ℝ (Fin n) → ℂ :=
    fun A₀ α => cosetSymbol (blockProd S) (cutoffEps n ε) (cosetSet S A₀ α) with hM
  have hmeas : ∀ A₀ α, AEStronglyMeasurable (M A₀ α) (volume.restrict (torusCube n)) :=
    fun A₀ α => (integrableOn_cosetSymbol (integrable_cutoffEps hε) _).1
  have hB := fun A₀ α => summable_and_tsum_norm_sq_latMult_le_integral (hmeas A₀ α)
    (fun ξ _ => norm_cosetSymbol_cutoffEps_le hε hε4 (cosetSet S A₀ α) ξ) hf
  refine ⟨fun A₀ α => (hB A₀ α).1, ?_⟩
  set F : EuclideanSpace ℝ (Fin n) → ℝ := fun ξ => ‖latFT f ξ‖ ^ 2 with hF
  have hFc : Continuous F := (continuous_latFT hf).norm.pow 2
  have hint : ∀ A₀ α, IntegrableOn (fun ξ => ‖M A₀ α ξ‖ ^ 2 * F ξ) (torusCube n) := by
    intro A₀ α
    refine integrableOn_torusCube_of_bound (((hmeas A₀ α).norm.pow 2).mul
      hFc.aestronglyMeasurable) (((cosetSet S A₀ α).card : ℝ) ^ 2 * (∑' z, ‖f z‖) ^ 2)
      fun ξ _ => ?_
    rw [Real.norm_of_nonneg (by positivity)]
    exact mul_le_mul (pow_le_pow_left₀ (norm_nonneg _)
      (norm_cosetSymbol_cutoffEps_le hε hε4 _ ξ) 2)
      (pow_le_pow_left₀ (norm_nonneg _) (norm_latFT_le hf ξ) 2) (by positivity) (by positivity)
  have hFint : IntegrableOn F (torusCube n) :=
    integrableOn_torusCube_of_bound hFc.aestronglyMeasurable ((∑' z, ‖f z‖) ^ 2) fun ξ _ => by
      rw [Real.norm_of_nonneg (by positivity)]
      exact pow_le_pow_left₀ (norm_nonneg _) (norm_latFT_le hf ξ) 2
  calc ∑ A₀ ∈ S.powerset with #A₀ ≤ k, ∑' x, ∑ α ∈ sigmaUpper S k A₀,
          ‖companionProj S ε A₀ α f x‖ ^ 2
      = ∑ A₀ ∈ S.powerset with #A₀ ≤ k, ∑ α ∈ sigmaUpper S k A₀,
          ∑' x, ‖companionProj S ε A₀ α f x‖ ^ 2 :=
        Finset.sum_congr rfl fun A₀ _ => Summable.tsum_finsetSum fun α _ => (hB A₀ α).1
    _ ≤ ∑ A₀ ∈ S.powerset with #A₀ ≤ k, ∑ α ∈ sigmaUpper S k A₀,
          ∫ ξ in torusCube n, ‖M A₀ α ξ‖ ^ 2 * F ξ :=
        Finset.sum_le_sum fun A₀ _ => Finset.sum_le_sum fun α _ => (hB A₀ α).2
    _ = ∫ ξ in torusCube n, ∑ A₀ ∈ S.powerset with #A₀ ≤ k, ∑ α ∈ sigmaUpper S k A₀,
          ‖M A₀ α ξ‖ ^ 2 * F ξ := by
        rw [integral_finsetSum _ fun A₀ _ => integrable_finsetSum _ fun α _ => hint A₀ α]
        exact Finset.sum_congr rfl fun A₀ _ =>
          (integral_finsetSum _ fun α _ => hint A₀ α).symm
    _ ≤ ∫ ξ in torusCube n, 2 ^ k * F ξ := by
        refine integral_mono_of_nonneg (Filter.Eventually.of_forall fun ξ => by positivity)
          (hFint.const_mul _) (Filter.Eventually.of_forall fun ξ => ?_)
        simp only
        simp_rw [← Finset.sum_mul]
        exact mul_le_mul_of_nonneg_right (sum_cores_norm_sq_cosetSymbol_le hS1 hS hε hεr ξ)
          (by positivity)
    _ = 2 ^ k * ∑' x, ‖f x‖ ^ 2 := by
        rw [integral_const_mul, integral_norm_sq_latFT hf]

/-! ### Blueprint Lemma 7.6 (`lem:companion`), the case `t = ∞`: auxiliary facts -/

/-- Linearity of `m ↦ m(D) f` for finite combinations of symbols integrable on the torus. -/
lemma latMult_sum_mul {ι : Type*} (s : Finset ι) (c : ι → ℂ)
    {m : ι → EuclideanSpace ℝ (Fin n) → ℂ} (hm : ∀ i ∈ s, IntegrableOn (m i) (torusCube n))
    {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) (x : Fin n → ℤ) :
    latMult (fun ξ => ∑ i ∈ s, c i * m i ξ) f x = ∑ i ∈ s, c i * latMult (m i) f x := by
  have hint : ∀ i ∈ s, IntegrableOn
      (fun ξ => m i ξ * (latFT f ξ * eC (inner ℝ (latEmbed x) ξ))) (torusCube n) := by
    intro i hi
    refine (hm i hi).mul_bdd (c := ∑' z, ‖f z‖)
      (((continuous_latFT hf).mul (by fun_prop [continuous_eC])).aestronglyMeasurable)
      (Filter.Eventually.of_forall fun ξ => ?_)
    rw [norm_mul, norm_eC, mul_one]; exact norm_latFT_le hf ξ
  unfold latMult
  have e : ∀ ξ, (∑ i ∈ s, c i * m i ξ) * latFT f ξ * eC (inner ℝ (latEmbed x) ξ) =
      ∑ i ∈ s, c i * (m i ξ * (latFT f ξ * eC (inner ℝ (latEmbed x) ξ))) := fun ξ => by
    rw [Finset.sum_mul, Finset.sum_mul]
    exact Finset.sum_congr rfl fun i _ => by ring
  simp_rw [e]
  rw [integral_finsetSum _ fun i hi => (hint i hi).const_mul (c i)]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [integral_const_mul]
  congr 1
  exact integral_congr_ae (Filter.Eventually.of_forall fun ξ => by ring)

/-- Linearity of `m ↦ m̌` for finite combinations of symbols integrable on the torus. -/
lemma latKernel_sum_mul {ι : Type*} (s : Finset ι) (c : ι → ℂ)
    {m : ι → EuclideanSpace ℝ (Fin n) → ℂ} (hm : ∀ i ∈ s, IntegrableOn (m i) (torusCube n))
    (y : Fin n → ℤ) :
    latKernel (fun ξ => ∑ i ∈ s, c i * m i ξ) y = ∑ i ∈ s, c i * latKernel (m i) y := by
  simp_rw [← latMult_latDelta]
  exact latMult_sum_mul s c hm summable_latDelta y

/-- For `α ∈ Σ^{A₀}` and `β ∈ T[Q_B]` with `B ⊆ A₀ ⊆ S`, the point `α + β` lies in `Σ_{≤k}`. -/
lemma add_mem_sigmaLe_of_grid {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {k : ℕ} {A₀ B : Finset ℕ} (hB : B ⊆ A₀) (hA₀ : A₀ ⊆ S)
    {α β : Fin n → ZMod (blockProd S)} (hα : α ∈ sigmaUpper S k A₀)
    (hβ : β ∈ blockGrid (blockProd S) (blockProd B)) : α + β ∈ sigmaLe S k := by
  rw [mem_blockGrid_blockProd_iff hS (hB.trans hA₀)] at hβ
  obtain ⟨_, hc⟩ := mem_sigmaUpper.1 hα
  rw [mem_sigmaLe]
  calc #(blockSupp S (α + β)) ≤ #(blockSupp S α ∪ blockSupp S β) :=
        Finset.card_le_card (blockSupp_add_subset S α β)
    _ ≤ #(blockSupp S α) + #(blockSupp S β) := Finset.card_union_le _ _
    _ ≤ #(blockSupp S α) + #A₀ := by gcongr; exact hβ.trans hB
    _ ≤ k := hc

/-- The outside component of `α + β` (`α ∈ Σ^{A₀}`, `β ∈ T[Q_B]`, `B ⊆ A₀ ⊆ S`) is `α`. -/
lemma blockProj_add_of_grid {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {k : ℕ} {A₀ B : Finset ℕ} (hB : B ⊆ A₀) (hA₀ : A₀ ⊆ S)
    {α β : Fin n → ZMod (blockProd S)} (hα : α ∈ sigmaUpper S k A₀)
    (hβ : β ∈ blockGrid (blockProd S) (blockProd B)) :
    blockProj S (S \ A₀) (α + β) = α := by
  rw [mem_blockGrid_blockProd_iff hS (hB.trans hA₀)] at hβ
  obtain ⟨hd, _⟩ := mem_sigmaUpper.1 hα
  rw [blockProj_add, blockProj_eq_self hS (fun q hq => Finset.mem_sdiff.2
      ⟨blockSupp_subset S α hq, Finset.disjoint_left.1 hd hq⟩),
    blockProj_eq_zero hS (Finset.disjoint_of_subset_left (hβ.trans hB) Finset.disjoint_sdiff),
    add_zero]

/-- `∫_{[0,1)ⁿ} |φ_per(ξ - c)|² dξ = ∫_E |φ|²` for `φ` supported in `[-2ε, 2ε]ⁿ`, `4ε < 1`. -/
lemma setIntegral_norm_sq_periodize_sub {φ : EuclideanSpace ℝ (Fin n) → ℂ} {ε : ℝ}
    (hφε : ∀ η, φ η ≠ 0 → ∀ i, |η i| ≤ 2 * ε) (hε4 : 4 * ε < 1)
    (hφ2 : Integrable fun ξ => ‖φ ξ‖ ^ 2) (c : EuclideanSpace ℝ (Fin n)) :
    ∫ ξ in torusCube n, ‖periodize φ (ξ - c)‖ ^ 2 = ∫ ξ, ‖φ ξ‖ ^ 2 := by
  set g : EuclideanSpace ℝ (Fin n) → ℝ := fun η => ‖φ (η - c)‖ ^ 2 with hg
  have hgi : Integrable g := hφ2.comp_sub_right c
  have hpt : ∀ ξ, ‖periodize φ (ξ - c)‖ ^ 2 = ∑' z : Fin n → ℤ, g (ξ - latEmbed z) := by
    intro ξ
    rw [norm_sq_periodize hφε hε4]
    congr 1; funext z; simp only [hg]; congr 3; abel
  have hint : ∀ z : Fin n → ℤ, Integrable (fun ξ => g (ξ - latEmbed z))
      (volume.restrict (torusCube n)) := fun z => (hgi.comp_sub_right (latEmbed z)).integrableOn
  have hsum : Summable fun z : Fin n → ℤ => ∫ ξ in torusCube n, ‖g (ξ - latEmbed z)‖ :=
    (hasSum_setIntegral_torusCube_sub hgi.norm).summable
  simp_rw [hpt]
  rw [← integral_tsum_of_summable_integral_norm hint hsum,
    (hasSum_setIntegral_torusCube_sub hgi).tsum_eq]
  exact integral_sub_right_eq_self (fun η => ‖φ η‖ ^ 2) c

/-- The weight `w(y) = (1 + ε²|y|²)^{n+1}` of the proof of Blueprint Lemma 7.6
(`lem:companion`). -/
noncomputable def companionWeight (n : ℕ) (ε : ℝ) (y : Fin n → ℤ) : ℝ :=
  (1 + ε ^ 2 * ‖latEmbed y‖ ^ 2) ^ (n + 1)

lemma one_le_companionWeight (ε : ℝ) (y : Fin n → ℤ) : 1 ≤ companionWeight n ε y :=
  one_le_pow₀ (le_add_of_nonneg_right (by positivity))

/-- `(1 + u)^{n+1} ≤ 2^{n+1} ((1 + u²)^{n+1})²` for `u ≥ 0`. -/
lemma one_add_pow_le_two_pow_mul {u : ℝ} (hu : 0 ≤ u) :
    (1 + u) ^ (n + 1) ≤ 2 ^ (n + 1) * ((1 + u ^ 2) ^ (n + 1)) ^ 2 := by
  have h1 : 1 + u ≤ 2 * (1 + u ^ 2) := by nlinarith [sq_nonneg (u - 1)]
  have h2 : (1 : ℝ) ≤ (1 + u ^ 2) ^ (n + 1) := one_le_pow₀ (by nlinarith)
  calc (1 + u) ^ (n + 1) ≤ (2 * (1 + u ^ 2)) ^ (n + 1) :=
        pow_le_pow_left₀ (by positivity) h1 _
    _ = 2 ^ (n + 1) * (1 + u ^ 2) ^ (n + 1) := mul_pow _ _ _
    _ ≤ 2 ^ (n + 1) * ((1 + u ^ 2) ^ (n + 1)) ^ 2 := by
        gcongr; nlinarith

/-- The sublattice sum `∑_{y ∈ QG} w(y)^{-2} ≤ 2^{n+1} C_n (εQ)^{-n}` for `0 < εQ ≤ 1`, in the
form of a finite partial sum. -/
lemma sum_weight_inv_sq_le {Q : ℕ} (hQ : 1 ≤ Q) {ε : ℝ} (hε : 0 < ε) (hεQ : ε * Q ≤ 1)
    (T : Finset (Fin n → ℤ)) :
    ∑ y ∈ T, (if ∀ i, (Q : ℤ) ∣ y i then ((companionWeight n ε y)⁻¹) ^ 2 else 0) ≤
      2 ^ (n + 1) * ((ε * Q)⁻¹) ^ n * envelopeConst n := by
  set R : ℝ := (ε * Q)⁻¹ with hR
  have hQr : (0 : ℝ) < Q := by exact_mod_cast hQ
  have haQ : 0 < ε * Q := mul_pos hε hQr
  have hR1 : 1 ≤ R := by rw [hR]; exact (one_le_inv₀ haQ).2 hεQ
  have hR0 : 0 < R := by linarith
  obtain ⟨hsum, htsum⟩ := summable_latEnvelope_and_tsum_le (n := n) hR1
  set h : (Fin n → ℤ) → ℝ := fun z => 2 ^ (n + 1) * R ^ n * latEnvelope n R z with hh
  have hh0 : ∀ z, 0 ≤ h z := fun z => by
    simp only [hh, latEnvelope]; exact mul_nonneg (by positivity) (envelope_nonneg hR0 _)
  set dv : (Fin n → ℤ) → (Fin n → ℤ) := fun y i => y i / Q with hdv
  have key : ∀ y : Fin n → ℤ, (∀ i, (Q : ℤ) ∣ y i) →
      ((companionWeight n ε y)⁻¹) ^ 2 ≤ h (dv y) := by
    intro y hy
    have hyz : latEmbed y = (Q : ℝ) • latEmbed (dv y) := by
      ext i
      simp only [latEmbed_apply, PiLp.smul_apply, smul_eq_mul, hdv]
      rw [← Int.cast_natCast, ← Int.cast_mul, mul_comm, Int.ediv_mul_cancel (hy i)]
    set u := ε * Q * ‖latEmbed (dv y)‖ with hu
    have hu0 : 0 ≤ u := by positivity
    have hw : companionWeight n ε y = (1 + u ^ 2) ^ (n + 1) := by
      rw [companionWeight, hyz, norm_smul, Real.norm_of_nonneg hQr.le, hu]; ring
    have he : R ^ n * latEnvelope n R (dv y) = ((1 + u) ^ (n + 1))⁻¹ := by
      rw [latEnvelope, envelope, ← mul_assoc, mul_inv_cancel₀ (by positivity), one_mul, hu,
        hR, div_inv_eq_mul, mul_comm (ε * Q)]
    simp only [hh]
    rw [mul_assoc, he, hw]
    have hp : 0 < (1 + u) ^ (n + 1) := by positivity
    have hq : 0 < ((1 + u ^ 2) ^ (n + 1)) ^ 2 := by positivity
    rw [inv_pow, ← div_eq_mul_inv, le_div_iff₀ hp, inv_mul_le_iff₀ hq]
    rw [mul_comm]; exact one_add_pow_le_two_pow_mul (n := n) hu0
  have hinj : Set.InjOn dv {y | ∀ i, (Q : ℤ) ∣ y i} := by
    intro y hy y' hy' e
    funext i
    have := congrFun e i
    simp only [hdv] at this
    rw [← Int.ediv_mul_cancel (hy i), ← Int.ediv_mul_cancel (hy' i), this]
  calc ∑ y ∈ T, (if ∀ i, (Q : ℤ) ∣ y i then ((companionWeight n ε y)⁻¹) ^ 2 else 0)
      = ∑ y ∈ T.filter (fun y => ∀ i, (Q : ℤ) ∣ y i), ((companionWeight n ε y)⁻¹) ^ 2 :=
        (Finset.sum_filter _ _).symm
    _ ≤ ∑ y ∈ T.filter (fun y => ∀ i, (Q : ℤ) ∣ y i), h (dv y) :=
        Finset.sum_le_sum fun y hy => key y (Finset.mem_filter.1 hy).2
    _ = ∑ z ∈ (T.filter (fun y => ∀ i, (Q : ℤ) ∣ y i)).image dv, h z :=
        (Finset.sum_image fun y hy y' hy' e =>
          hinj (Finset.mem_filter.1 hy).2 (Finset.mem_filter.1 hy').2 e).symm
    _ ≤ ∑' z, h z := (hsum.mul_left _).sum_le_tsum _ fun z _ => hh0 z
    _ = 2 ^ (n + 1) * R ^ n * ∑' z, latEnvelope n R z := tsum_mul_left
    _ ≤ 2 ^ (n + 1) * R ^ n * envelopeConst n := by gcongr

/-- `εQ_B ≤ 1` for `B ⊆ S`, `|B| ≤ k`, under the separation hypothesis (7.1). -/
lemma eps_mul_blockProd_le {S B : Finset ℕ} (hBS : B ⊆ S) {k r : ℕ} (hBk : #B ≤ k) {ε : ℝ}
    (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹) :
    ε * blockProd B ≤ 1 := by
  have hr := one_le_of_le_eps hε hεr
  have hq1 : 1 ≤ blockStar S := le_trans (by norm_num) (two_le_blockStar S)
  have hQ : (blockProd B : ℝ) ≤ (blockStar S : ℝ) ^ k := by
    exact_mod_cast (blockProd_le_pow hBS).trans (Nat.pow_le_pow_right hq1 hBk)
  have hqk : (0 : ℝ) < (blockStar S : ℝ) ^ k := by positivity
  have h2 : (blockStar S : ℝ) ^ k ≤ 100 * r * (blockStar S : ℝ) ^ (2 * r * k) := by
    have h3 : (blockStar S : ℝ) ^ k ≤ (blockStar S : ℝ) ^ (2 * r * k) :=
      pow_le_pow_right₀ (by exact_mod_cast hq1) (by nlinarith)
    have h4 : (1 : ℝ) ≤ 100 * r := by
      have : (1 : ℝ) ≤ r := by exact_mod_cast hr
      linarith
    nlinarith
  have hε' : ε ≤ ((blockStar S : ℝ) ^ k)⁻¹ := hεr.trans (inv_anti₀ hqk h2)
  calc ε * blockProd B ≤ ((blockStar S : ℝ) ^ k)⁻¹ * (blockStar S : ℝ) ^ k :=
        mul_le_mul hε' hQ (by positivity) (by positivity)
    _ = 1 := inv_mul_cancel₀ hqk.ne'

lemma exists_norm_phiEps_le (ε : ℝ) : ∃ M, 0 ≤ M ∧ ∀ η, ‖phiEps n ε η‖ ≤ M := by
  obtain ⟨C, hC⟩ := (companionPhi n).continuous.bounded_above_of_compact_support
    (HasCompactSupport.intro (isCompact_box 2) fun _ h => companionPhi_eq_zero h)
  exact ⟨max C 0, le_max_right _ _, fun η => (hC _).trans (le_max_left _ _)⟩

lemma integrable_norm_sq_phiEps {ε : ℝ} (hε : 0 < ε) :
    Integrable fun ξ => ‖phiEps n ε ξ‖ ^ 2 :=
  ((continuous_phiEps ε).norm.pow 2).integrable_of_hasCompactSupport
    (HasCompactSupport.intro (isCompact_box (2 * ε)) fun _ h => by
      simp [phiEps_eq_zero hε h])

/-- The shifted full-grid symbol `∑_{β ∈ T[Q_B]} m_per(ξ - (α + β))` of `T_{m; α + T[Q_B]}`. -/
noncomputable def gridSymbol (S : Finset ℕ) [NeZero (blockProd S)] (B : Finset ℕ)
    (m : EuclideanSpace ℝ (Fin n) → ℂ) (α : Fin n → ZMod (blockProd S))
    (ξ : EuclideanSpace ℝ (Fin n)) : ℂ :=
  ∑ β ∈ blockGrid (blockProd S) (blockProd B), periodize m (ξ - ratPt (blockProd S) (α + β))

lemma integrableOn_gridSymbol {S : Finset ℕ} [NeZero (blockProd S)] (B : Finset ℕ)
    {m : EuclideanSpace ℝ (Fin n) → ℂ} (hm : Integrable m) (α : Fin n → ZMod (blockProd S)) :
    IntegrableOn (gridSymbol S B m α) (torusCube n) := by
  unfold gridSymbol
  exact integrable_finsetSum _ fun β _ => integrableOn_periodize_sub hm _

lemma latKernel_gridSymbol {S : Finset ℕ} [NeZero (blockProd S)] {B : Finset ℕ}
    (hd : blockProd B ∣ blockProd S) {m : EuclideanSpace ℝ (Fin n) → ℂ} (hm : Integrable m)
    (α : Fin n → ZMod (blockProd S)) (y : Fin n → ℤ) :
    latKernel (gridSymbol S B m α) y =
      (if ∀ i, ((blockProd B : ℕ) : ℤ) ∣ y i then ((blockProd B : ℕ) : ℂ) ^ n else 0) *
        (eC (inner ℝ (ratPt (blockProd S) α) (latEmbed y)) * 𝓕⁻ m (latEmbed y)) :=
  latKernel_sum_blockGrid_periodize_add hd hm α y

/-- The constant `2^{n+1} C_n ∫|Φ|²` of the `t = ∞` estimate for one full-grid coset family. -/
noncomputable def companionGridConst (n : ℕ) : ℝ :=
  2 ^ (n + 1) * envelopeConst n * companionPhiL2 n

lemma companionPhiL2_nonneg : 0 ≤ companionPhiL2 n :=
  integral_nonneg fun _ => sq_nonneg _

lemma companionGridConst_nonneg : 0 ≤ companionGridConst n :=
  mul_nonneg (mul_nonneg (by positivity) (envelopeConst_nonneg n)) companionPhiL2_nonneg

lemma summable_of_finite_support {f : (Fin n → ℤ) → ℂ} (hf : (Function.support f).Finite) :
    Summable fun z => ‖f z‖ :=
  summable_of_ne_finset_zero (s := hf.toFinset) fun z hz => by
    simp only [Set.Finite.mem_toFinset, Function.mem_support, not_not] at hz; simp [hz]

/-- The core `ℓ^∞ → ℓ^∞(ℓ²)` estimate of Blueprint Lemma 7.6 (`lem:companion`) for one full-grid
family: for `B ⊆ A₀ ⊆ S`, `|A₀| ≤ k`, `Q = Q_B`, finitely supported `f` with `|f| ≤ s` and every
`x`, `∑_{α ∈ Σ^{A₀}} |T_{θ_ε; α + T[Q]} f(x)|² ≤ C s²` with `C = 2^{n+1} C_n ∫|Φ|²`
(kernel `h_α(y) = Qⁿ 𝟙_{Q ∣ y} e(α · y) θ̌_ε(y)`, weight `w(y) = (1 + ε²|y|²)^{n+1}`, orthogonality
of the `w h_α` through Bessel's inequality, Cauchy–Schwarz and duality). -/
theorem sum_norm_sq_latMult_gridSymbol_le {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} {ε : ℝ}
    (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    {A₀ B : Finset ℕ} (hB : B ⊆ A₀) (hA₀ : A₀ ⊆ S) (hA₀k : #A₀ ≤ k)
    {f : (Fin n → ℤ) → ℂ} (hf : (Function.support f).Finite) {s : ℝ}
    (hs : ∀ y, ‖f y‖ ≤ s) (x : Fin n → ℤ) :
    ∑ α ∈ sigmaUpper S k A₀, ‖latMult (gridSymbol S B (cutoffEps n ε) α) f x‖ ^ 2 ≤
      companionGridConst n * s ^ 2 := by
  classical
  have hd : blockProd B ∣ blockProd S := blockProd_dvd_blockProd (hB.trans hA₀)
  have hQ1 : 1 ≤ blockProd B := blockProd_pos fun q hq => hS1 q (hB.trans hA₀ hq)
  have hQr : (0 : ℝ) < blockProd B := by exact_mod_cast hQ1
  have hε4 := four_eps_lt_one S hε hεr
  have hεQ : ε * blockProd B ≤ 1 :=
    eps_mul_blockProd_le (hB.trans hA₀) ((Finset.card_le_card hB).trans hA₀k) hε hεr
  have hfs := summable_of_finite_support hf
  have hs0 : 0 ≤ s := (norm_nonneg _).trans (hs 0)
  set V := sigmaUpper S k A₀ with hV
  set Gr := blockGrid (n := n) (blockProd S) (blockProd B) with hGr
  set u : (Fin n → ZMod (blockProd S)) → ℂ :=
    fun α => latMult (gridSymbol S B (cutoffEps n ε) α) f x with hu
  set K : (Fin n → ZMod (blockProd S)) → (Fin n → ℤ) → ℂ :=
    fun α => latKernel (gridSymbol S B (cutoffEps n ε) α) with hK
  -- the finite set of relevant `y`
  set T : Finset (Fin n → ℤ) := hf.toFinset.image (fun z => x - z) with hT
  have hTz : ∀ y ∉ T, f (x - y) = 0 := by
    intro y hy
    by_contra h
    exact hy (Finset.mem_image.2 ⟨x - y, by simpa using h, by abel⟩)
  have hu' : ∀ α, u α = ∑ y ∈ T, K α y * f (x - y) := by
    intro α
    simp only [hu, hK]
    rw [latMult_eq_latConv (integrableOn_gridSymbol B (integrable_cutoffEps hε) α) hfs, latConv,
      tsum_eq_sum fun y hy => by rw [hTz y hy, mul_zero]]
  set S2 := ∑ α ∈ V, ‖u α‖ ^ 2 with hS2
  have hS2nn : 0 ≤ S2 := Finset.sum_nonneg fun _ _ => sq_nonneg _
  set c : (Fin n → ZMod (blockProd S)) → ℂ := fun α => conj (u α) with hc
  set F : (Fin n → ℤ) → ℂ := fun y => ∑ α ∈ V, c α * K α y with hF
  -- duality
  have hS2c : (S2 : ℂ) = ∑ y ∈ T, F y * f (x - y) := by
    have e1 : (S2 : ℂ) = ∑ α ∈ V, c α * u α := by
      rw [hS2]; push_cast
      exact Finset.sum_congr rfl fun α _ => (Complex.conj_mul' (u α)).symm
    rw [e1]
    simp_rw [hF, Finset.sum_mul]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun α _ => ?_
    rw [hu' α, Finset.mul_sum]
    exact Finset.sum_congr rfl fun y _ => by ring
  have hS2le : S2 ≤ s * ∑ y ∈ T, ‖F y‖ := by
    have h1 : S2 = ‖(S2 : ℂ)‖ := by rw [Complex.norm_real, Real.norm_of_nonneg hS2nn]
    rw [h1, hS2c, Finset.mul_sum]
    refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun y _ => ?_)
    rw [norm_mul, mul_comm]
    exact mul_le_mul_of_nonneg_right (hs _) (norm_nonneg _)
  -- the weighted kernels
  set N : EuclideanSpace ℝ (Fin n) → ℂ :=
    fun ξ => ∑ α ∈ V, c α * gridSymbol S B (phiEps n ε) α ξ with hN
  have hwF : ∀ y, ((companionWeight n ε y : ℝ) : ℂ) * F y = latKernel N y := by
    intro y
    rw [hN, latKernel_sum_mul V c (fun α _ => integrableOn_gridSymbol B (integrable_phiEps hε) α)
      y, hF, Finset.mul_sum]
    refine Finset.sum_congr rfl fun α _ => ?_
    simp only [hK]
    rw [latKernel_gridSymbol hd (integrable_phiEps hε), latKernel_gridSymbol hd
      (integrable_cutoffEps hε), fourierInv_phiEps hε, companionWeight]
    push_cast
    ring
  -- Cauchy–Schwarz on `Q ℤⁿ`
  set a : (Fin n → ℤ) → ℝ :=
    fun y => if ∀ i, ((blockProd B : ℕ) : ℤ) ∣ y i then (companionWeight n ε y)⁻¹ else 0 with ha
  set b : (Fin n → ℤ) → ℝ := fun y => ‖latKernel N y‖ with hb
  have hab : ∀ y, ‖F y‖ = a y * b y := by
    intro y
    have hw0 : 0 < companionWeight n ε y := lt_of_lt_of_le one_pos (one_le_companionWeight ε y)
    by_cases hy : ∀ i, ((blockProd B : ℕ) : ℤ) ∣ y i
    · simp only [ha, hb, ite_eq_left hy]
      rw [← hwF, norm_mul, Complex.norm_real, Real.norm_of_nonneg hw0.le, ← mul_assoc,
        inv_mul_cancel₀ hw0.ne', one_mul]
    · have : F y = 0 := Finset.sum_eq_zero fun α _ => by
        simp only [hK]; rw [latKernel_gridSymbol hd (integrable_cutoffEps hε), ite_eq_right hy]; simp
      simp [ha, ite_eq_right hy, this]
  have hCS : (∑ y ∈ T, ‖F y‖) ^ 2 ≤ (∑ y ∈ T, a y ^ 2) * (∑ y ∈ T, b y ^ 2) := by
    simp_rw [hab]; exact Finset.sum_mul_sq_le_sq_mul_sq T a b
  have ha2 : ∑ y ∈ T, a y ^ 2 ≤
      2 ^ (n + 1) * ((ε * blockProd B)⁻¹) ^ n * envelopeConst n := by
    refine le_trans (le_of_eq ?_) (sum_weight_inv_sq_le hQ1 hε hεQ T)
    refine Finset.sum_congr rfl fun y _ => ?_
    simp only [ha]; split_ifs <;> simp
  -- Bessel's inequality for the weighted kernels
  obtain ⟨Mφ, hMφ0, hMφ⟩ := exists_norm_phiEps_le (n := n) ε
  have hPb : ∀ η, ‖periodize (phiEps n ε) η‖ ≤ Mφ :=
    norm_periodize_le (phiEps_support hε) hε4 hMφ0 hMφ
  have hNmeas : AEStronglyMeasurable N (volume.restrict (torusCube n)) :=
    (integrable_finsetSum V fun α _ =>
      (integrableOn_gridSymbol B (integrable_phiEps hε) α).const_mul (c α)).1
  have hNb : ∀ ξ, ‖N ξ‖ ≤ ∑ α ∈ V, ‖c α‖ * (Gr.card * Mφ) := by
    intro ξ
    refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun α _ => ?_)
    rw [norm_mul]
    refine mul_le_mul_of_nonneg_left ((norm_sum_le _ _).trans ?_) (norm_nonneg _)
    have := Finset.sum_le_sum (s := Gr) fun β _ => hPb (ξ - ratPt (blockProd S) (α + β))
    simpa using this
  have hBes := summable_and_tsum_norm_sq_latKernel_le hNmeas (fun ξ _ => hNb ξ)
  have hb2 : ∑ y ∈ T, b y ^ 2 ≤ ∫ ξ in torusCube n, ‖N ξ‖ ^ 2 :=
    (hBes.1.sum_le_tsum T fun _ _ => sq_nonneg _).trans hBes.2
  -- `∫ |N|² = S2 · Qⁿ εⁿ ∫|Φ|²` by disjointness of the bumps
  have hptN : ∀ ξ, ‖N ξ‖ ^ 2 = ∑ p ∈ V ×ˢ Gr,
      ‖c p.1‖ ^ 2 * ‖periodize (phiEps n ε) (ξ - ratPt (blockProd S) (p.1 + p.2))‖ ^ 2 := by
    intro ξ
    have e : N ξ = ∑ p ∈ V ×ˢ Gr,
        c p.1 * periodize (phiEps n ε) (ξ - ratPt (blockProd S) (p.1 + p.2)) := by
      rw [hN, Finset.sum_product]
      exact Finset.sum_congr rfl fun α _ => by rw [gridSymbol, Finset.mul_sum]
    rw [e, norm_sq_sum_of_atMostOne]
    · exact Finset.sum_congr rfl fun p _ => by rw [norm_mul, mul_pow]
    · rintro ⟨α, β⟩ hp ⟨α', β'⟩ hp' h h'
      simp only [Finset.mem_product] at hp hp'
      dsimp only at h h' ⊢
      have hγ := periodize_center_atMostOne (phiEps_support hε) hS1 hS hε hεr
        (add_mem_sigmaLe_of_grid hS hB hA₀ hp.1 hp.2)
        (add_mem_sigmaLe_of_grid hS hB hA₀ hp'.1 hp'.2) ξ (right_ne_zero_of_mul h)
        (right_ne_zero_of_mul h')
      have hα : α = α' := by
        rw [← blockProj_add_of_grid hS hB hA₀ hp.1 hp.2, hγ,
          blockProj_add_of_grid hS hB hA₀ hp'.1 hp'.2]
      subst hα
      simp only [Prod.mk.injEq, true_and]
      exact add_left_cancel hγ
  have hintP : ∀ γ : Fin n → ZMod (blockProd S), IntegrableOn
      (fun ξ => ‖periodize (phiEps n ε) (ξ - ratPt (blockProd S) γ)‖ ^ 2) (torusCube n) := by
    intro γ
    refine integrableOn_torusCube_of_bound
      ((integrableOn_periodize_sub (integrable_phiEps hε) _).1.norm.pow 2) (Mφ ^ 2)
      fun ξ _ => ?_
    rw [Real.norm_of_nonneg (sq_nonneg _)]
    exact pow_le_pow_left₀ (norm_nonneg _) (hPb _) 2
  have hNint : ∫ ξ in torusCube n, ‖N ξ‖ ^ 2 =
      S2 * ((blockProd B : ℝ) ^ n * (ε ^ n * companionPhiL2 n)) := by
    simp_rw [hptN]
    rw [integral_finsetSum _ fun p _ => (hintP _).const_mul _]
    simp_rw [integral_const_mul, setIntegral_norm_sq_periodize_sub (phiEps_support hε) hε4
      (integrable_norm_sq_phiEps hε), integral_norm_sq_phiEps hε]
    rw [Finset.sum_product, hS2, Finset.sum_mul]
    refine Finset.sum_congr rfl fun α _ => ?_
    dsimp only
    rw [Finset.sum_const, nsmul_eq_mul, hGr, card_blockGrid hd, hc, Complex.norm_conj]
    push_cast; ring
  -- conclusion
  set X := ∑ y ∈ T, ‖F y‖ with hX
  have hX0 : 0 ≤ X := Finset.sum_nonneg fun _ _ => norm_nonneg _
  have hX2 : X ^ 2 ≤ companionGridConst n * S2 := by
    refine hCS.trans ((mul_le_mul ha2 (hb2.trans (le_of_eq hNint))
      (Finset.sum_nonneg fun _ _ => sq_nonneg _) (by
        have := envelopeConst_nonneg n; positivity)).trans (le_of_eq ?_))
    have hεQ0 : ε * blockProd B ≠ 0 := (mul_pos hε hQr).ne'
    rw [companionGridConst]
    have key : ((ε * (blockProd B : ℝ))⁻¹) ^ n * ((blockProd B : ℝ) ^ n * ε ^ n) = 1 := by
      rw [← mul_pow, ← mul_pow, mul_comm (blockProd B : ℝ) ε, inv_mul_cancel₀ hεQ0, one_pow]
    calc _ = 2 ^ (n + 1) * envelopeConst n * companionPhiL2 n * S2 *
          (((ε * (blockProd B : ℝ))⁻¹) ^ n * ((blockProd B : ℝ) ^ n * ε ^ n)) := by ring
      _ = _ := by rw [key, mul_one]
  have h1 : S2 ^ 2 ≤ s ^ 2 * (companionGridConst n * S2) := by
    calc S2 ^ 2 ≤ (s * X) ^ 2 := pow_le_pow_left₀ hS2nn hS2le 2
      _ = s ^ 2 * X ^ 2 := by ring
      _ ≤ s ^ 2 * (companionGridConst n * S2) := by gcongr
  rcases hS2nn.eq_or_lt with h0 | hpos
  · rw [← h0]; exact mul_nonneg companionGridConst_nonneg (sq_nonneg _)
  · have : S2 * S2 ≤ (companionGridConst n * s ^ 2) * S2 := by nlinarith
    exact le_of_mul_le_mul_right this hpos

/-! ### Blueprint Lemma 7.6 (`lem:companion`), the case `t = ∞` -/

/-- Inclusion–exclusion (eq. `inclusionexclusion`) for the symbols:
`T_{m; α + Σ_{A₀}} = ∑_{B ⊆ A₀} (-1)^{|A₀| - |B|} T_{m; α + T[Q_B]}`. -/
lemma cosetSymbol_cosetSet_eq_sum_gridSymbol {S : Finset ℕ}
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {A₀ : Finset ℕ}
    (hA₀ : A₀ ⊆ S) (m : EuclideanSpace ℝ (Fin n) → ℂ) (α : Fin n → ZMod (blockProd S))
    (ξ : EuclideanSpace ℝ (Fin n)) :
    cosetSymbol (blockProd S) m (cosetSet S A₀ α) ξ =
      ∑ B ∈ A₀.powerset, (-1 : ℂ) ^ (#A₀ - #B) * gridSymbol S B m α ξ := by
  rw [cosetSymbol_cosetSet, sum_sigmaBlock_inclusion_exclusion hS hA₀]
  refine Finset.sum_congr rfl fun B _ => ?_
  rw [zsmul_eq_mul, gridSymbol]
  push_cast; rfl

/-- `P_{A₀,α} f = ∑_{B ⊆ A₀} (-1)^{|A₀| - |B|} T_{θ_ε; α + T[Q_B]} f`. -/
lemma companionProj_eq_sum {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {A₀ : Finset ℕ} (hA₀ : A₀ ⊆ S) {ε : ℝ} (hε : 0 < ε)
    {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) (α : Fin n → ZMod (blockProd S))
    (x : Fin n → ℤ) :
    companionProj S ε A₀ α f x = ∑ B ∈ A₀.powerset,
      (-1 : ℂ) ^ (#A₀ - #B) * latMult (gridSymbol S B (cutoffEps n ε) α) f x := by
  unfold companionProj cosetMult
  rw [show cosetSymbol (blockProd S) (cutoffEps n ε) (cosetSet S A₀ α) = fun ξ =>
      ∑ B ∈ A₀.powerset, (-1 : ℂ) ^ (#A₀ - #B) * gridSymbol S B (cutoffEps n ε) α ξ from
    funext (cosetSymbol_cosetSet_eq_sum_gridSymbol hS hA₀ _ α)]
  exact latMult_sum_mul _ _ (fun B _ => integrableOn_gridSymbol B (integrable_cutoffEps hε) α)
    hf x

/-- The vector `(P_{A₀,α} f(x))_{α ∈ Σ^{A₀}}` in the finite-dimensional Hilbert space `ℓ²_α`
(coordinates outside `Σ^{A₀}` are zero). -/
noncomputable def companionVec (S : Finset ℕ) [NeZero (blockProd S)] (k : ℕ) (ε : ℝ)
    (f : (Fin n → ℤ) → ℂ) (A₀ : Finset ℕ) (x : Fin n → ℤ) :
    EuclideanSpace ℂ (Fin n → ZMod (blockProd S)) :=
  WithLp.toLp 2 fun α => if α ∈ sigmaUpper S k A₀ then companionProj S ε A₀ α f x else 0

lemma norm_sq_toLp_ite {ι : Type*} [Fintype ι] [DecidableEq ι] (V : Finset ι) (g : ι → ℂ) :
    ‖(WithLp.toLp 2 fun α => if α ∈ V then g α else 0 : EuclideanSpace ℂ ι)‖ ^ 2 =
      ∑ α ∈ V, ‖g α‖ ^ 2 := by
  rw [EuclideanSpace.norm_sq_eq]
  have h : ∀ α, ‖(if α ∈ V then g α else 0)‖ ^ 2 = if α ∈ V then ‖g α‖ ^ 2 else 0 :=
    fun α => by split_ifs <;> simp
  rw [Finset.sum_congr rfl fun α _ => h α, Finset.sum_ite_mem, Finset.univ_inter]

/-- `‖(P_{A₀,α} f(x))_α‖_{ℓ²_α}² = ∑_{α ∈ Σ^{A₀}} |P_{A₀,α} f(x)|²`. -/
lemma norm_sq_companionVec (S : Finset ℕ) [NeZero (blockProd S)] (k : ℕ) (ε : ℝ)
    (f : (Fin n → ℤ) → ℂ) (A₀ : Finset ℕ) (x : Fin n → ℤ) :
    ‖companionVec S k ε f A₀ x‖ ^ 2 =
      ∑ α ∈ sigmaUpper S k A₀, ‖companionProj S ε A₀ α f x‖ ^ 2 := by
  classical
  unfold companionVec
  convert norm_sq_toLp_ite (sigmaUpper S k A₀) (fun α => companionProj S ε A₀ α f x)

/-- The constant `C_{n,k} = 2^k (2^{n+1} C_n ∫|Φ|²)^{1/2}` of the case `t = ∞`. -/
noncomputable def companionInftyConst (n k : ℕ) : ℝ :=
  2 ^ k * Real.sqrt (companionGridConst n)

lemma companionInftyConst_nonneg (n k : ℕ) : 0 ≤ companionInftyConst n k := by
  unfold companionInftyConst; positivity

/-- Blueprint Lemma 7.6 (`lem:companion`), the case `t = ∞`: under the separation hypothesis
(7.1), for every core `A₀ ⊆ S` with `|A₀| ≤ k`, every finitely supported `f` with `|f| ≤ s` and
every `x ∈ ℤⁿ`, `‖(P_{A₀,α} f(x))_{α ∈ Σ^{A₀}}‖_{ℓ²_α} ≤ C_{n,k} s`, i.e.
`(∑_{α ∈ Σ^{A₀}} |P_{A₀,α} f(x)|²)^{1/2} ≤ C_{n,k} sup |f|`, uniformly in the core, with
`C_{n,k} = companionInftyConst n k` depending only on `n` and `k`. -/
theorem companion_infty {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} {ε : ℝ}
    (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    {A₀ : Finset ℕ} (hA₀ : A₀ ⊆ S) (hA₀k : #A₀ ≤ k)
    {f : (Fin n → ℤ) → ℂ} (hf : (Function.support f).Finite) {s : ℝ}
    (hs : ∀ y, ‖f y‖ ≤ s) (x : Fin n → ℤ) :
    ‖companionVec S k ε f A₀ x‖ ≤ companionInftyConst n k * s := by
  classical
  have hfs := summable_of_finite_support hf
  have hs0 : 0 ≤ s := (norm_nonneg _).trans (hs 0)
  set gv : Finset ℕ → EuclideanSpace ℂ (Fin n → ZMod (blockProd S)) := fun B =>
    WithLp.toLp 2 fun α => if α ∈ sigmaUpper S k A₀ then
      latMult (gridSymbol S B (cutoffEps n ε) α) f x else 0 with hgv
  have hv : companionVec S k ε f A₀ x =
      ∑ B ∈ A₀.powerset, ((-1 : ℂ) ^ (#A₀ - #B)) • gv B := by
    ext α
    simp only [companionVec, hgv, WithLp.ofLp_sum, WithLp.ofLp_smul, Finset.sum_apply,
      Pi.smul_apply, smul_eq_mul]
    split_ifs
    · exact companionProj_eq_sum hS hA₀ hε hfs α x
    · simp
  have hgvb : ∀ B ∈ A₀.powerset, ‖gv B‖ ≤ Real.sqrt (companionGridConst n) * s := by
    intro B hB
    have h2 : ‖gv B‖ ^ 2 ≤ companionGridConst n * s ^ 2 := by
      rw [hgv, norm_sq_toLp_ite]
      exact sum_norm_sq_latMult_gridSymbol_le hS1 hS hε hεr (Finset.mem_powerset.1 hB) hA₀
        hA₀k hf hs x
    rw [← Real.sqrt_sq hs0, ← Real.sqrt_mul companionGridConst_nonneg]
    exact Real.le_sqrt_of_sq_le h2
  rw [hv]
  refine (norm_sum_le _ _).trans ?_
  calc ∑ B ∈ A₀.powerset, ‖((-1 : ℂ) ^ (#A₀ - #B)) • gv B‖
      ≤ ∑ _B ∈ A₀.powerset, Real.sqrt (companionGridConst n) * s := by
        refine Finset.sum_le_sum fun B hB => ?_
        rw [norm_smul, norm_pow, norm_neg, norm_one, one_pow, one_mul]
        exact hgvb B hB
    _ = 2 ^ #A₀ * (Real.sqrt (companionGridConst n) * s) := by
        rw [Finset.sum_const, Finset.card_powerset, nsmul_eq_mul]; push_cast; ring
    _ ≤ 2 ^ k * (Real.sqrt (companionGridConst n) * s) := by
        gcongr
        · norm_num
    _ = companionInftyConst n k * s := by rw [companionInftyConst]; ring

/-- Blueprint Lemma 7.6 (`lem:companion`), the case `t = ∞`, in square-sum form:
`∑_{α ∈ Σ^{A₀}} |P_{A₀,α} f(x)|² ≤ (C_{n,k} s)²` whenever `|f| ≤ s`. -/
theorem companion_infty_sq {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} {ε : ℝ}
    (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    {A₀ : Finset ℕ} (hA₀ : A₀ ⊆ S) (hA₀k : #A₀ ≤ k)
    {f : (Fin n → ℤ) → ℂ} (hf : (Function.support f).Finite) {s : ℝ}
    (hs : ∀ y, ‖f y‖ ≤ s) (x : Fin n → ℤ) :
    ∑ α ∈ sigmaUpper S k A₀, ‖companionProj S ε A₀ α f x‖ ^ 2 ≤
      (companionInftyConst n k * s) ^ 2 := by
  rw [← norm_sq_companionVec]
  exact pow_le_pow_left₀ (norm_nonneg _) (companion_infty hS1 hS hε hεr hA₀ hA₀k hf hs x) 2

/-! ### Blueprint Lemma 7.6 (`lem:companion`), `2 ≤ t < ∞`: interpolation -/

section CompanionInterpolation

open scoped ENNReal NNReal

lemma latFT_add {f g : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖)
    (hg : Summable fun z => ‖g z‖) : latFT (f + g) = latFT f + latFT g := by
  funext ξ
  simp only [latFT, Pi.add_apply, add_mul]
  exact (summable_latFT_term hf ξ).tsum_add (summable_latFT_term hg ξ)

/-- `m(D)` is additive on `ℓ¹` for symbols integrable on the torus. -/
lemma latMult_add {m : EuclideanSpace ℝ (Fin n) → ℂ} (hm : IntegrableOn m (torusCube n))
    {f g : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) (hg : Summable fun z => ‖g z‖) :
    latMult m (f + g) = latMult m f + latMult m g := by
  have hint : ∀ {h : (Fin n → ℤ) → ℂ}, (Summable fun z => ‖h z‖) → ∀ x : Fin n → ℤ,
      IntegrableOn (fun ξ => m ξ * latFT h ξ * eC (inner ℝ (latEmbed x) ξ)) (torusCube n) := by
    intro h hh x
    have : IntegrableOn (fun ξ => m ξ * (latFT h ξ * eC (inner ℝ (latEmbed x) ξ)))
        (torusCube n) := hm.mul_bdd (c := ∑' z, ‖h z‖)
      (((continuous_latFT hh).mul (by fun_prop [continuous_eC])).aestronglyMeasurable)
      (Filter.Eventually.of_forall fun ξ => by
        rw [norm_mul, norm_eC, mul_one]; exact norm_latFT_le hh ξ)
    refine this.congr (Filter.Eventually.of_forall fun ξ => ?_)
    simp only; ring
  funext x
  simp only [latMult, Pi.add_apply, latFT_add hf hg, mul_add, add_mul]
  exact integral_add (hint hf x) (hint hg x)

lemma companionProj_add {S : Finset ℕ} [NeZero (blockProd S)] {ε : ℝ} (hε : 0 < ε)
    (A₀ : Finset ℕ) (α : Fin n → ZMod (blockProd S)) {f g : (Fin n → ℤ) → ℂ}
    (hf : Summable fun z => ‖f z‖) (hg : Summable fun z => ‖g z‖) :
    companionProj S ε A₀ α (f + g) = companionProj S ε A₀ α f + companionProj S ε A₀ α g :=
  latMult_add (integrableOn_cosetSymbol (integrable_cutoffEps hε) _) hf hg

/-- The companion operator `f ↦ ((P_{A₀,α} f(x))_{α})_{(x, A₀)}` from `ℓ^t(G)` to
`ℓ^t(G × {A₀ : |A₀| ≤ k}; ℓ²_α)` (zero off the cores). -/
noncomputable def companionOp (S : Finset ℕ) [NeZero (blockProd S)] (k : ℕ) (ε : ℝ)
    (f : (Fin n → ℤ) → ℂ) (p : (Fin n → ℤ) × Finset ℕ) :
    EuclideanSpace ℂ (Fin n → ZMod (blockProd S)) :=
  if p.2 ∈ S.powerset.filter (fun A₀ => #A₀ ≤ k) then companionVec S k ε f p.2 p.1 else 0

lemma companionOp_add {S : Finset ℕ} [NeZero (blockProd S)] (k : ℕ) {ε : ℝ} (hε : 0 < ε)
    {f g : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) (hg : Summable fun z => ‖g z‖)
    (p : (Fin n → ℤ) × Finset ℕ) :
    companionOp S k ε (f + g) p = companionOp S k ε f p + companionOp S k ε g p := by
  unfold companionOp
  split_ifs
  · ext α
    simp only [companionVec, WithLp.ofLp_add, Pi.add_apply]
    split_ifs
    · rw [companionProj_add hε _ _ hf hg, Pi.add_apply]
    · simp
  · simp

/-- Sums over `G × {cores}` of a function vanishing at `0` split over the cores. -/
lemma tsum_companionOp (S : Finset ℕ) [NeZero (blockProd S)] (k : ℕ) (ε : ℝ)
    (f : (Fin n → ℤ) → ℂ) (g : EuclideanSpace ℂ (Fin n → ZMod (blockProd S)) → ℝ≥0∞)
    (hg : g 0 = 0) :
    ∑' p, g (companionOp S k ε f p) =
      ∑ A₀ ∈ S.powerset with #A₀ ≤ k, ∑' x, g (companionVec S k ε f A₀ x) := by
  have e := ENNReal.tsum_prod (f := fun x A₀ => g (companionOp S k ε f (x, A₀)))
  simp only [Prod.mk.eta] at e
  rw [e, ← Summable.tsum_finsetSum (fun _ _ => ENNReal.summable)]
  refine tsum_congr fun x => ?_
  rw [tsum_eq_sum (s := S.powerset.filter fun A₀ => #A₀ ≤ k) fun A₀ hA₀ => by
    simp only [companionOp]; rw [ite_eq_right hA₀, hg]]
  exact Finset.sum_congr rfl fun A₀ hA₀ => by simp only [companionOp]; rw [ite_eq_left hA₀]

lemma enorm_sq_companionVec (S : Finset ℕ) [NeZero (blockProd S)] (k : ℕ) (ε : ℝ)
    (f : (Fin n → ℤ) → ℂ) (A₀ : Finset ℕ) (x : Fin n → ℤ) :
    ‖companionVec S k ε f A₀ x‖ₑ ^ 2 =
      ∑ α ∈ sigmaUpper S k A₀, ‖companionProj S ε A₀ α f x‖ₑ ^ 2 := by
  rw [enorm_pow_eq_ofReal, norm_sq_companionVec,
    ENNReal.ofReal_sum_of_nonneg fun _ _ => sq_nonneg _]
  simp_rw [enorm_pow_eq_ofReal]

lemma enorm_rpow_companionVec (S : Finset ℕ) [NeZero (blockProd S)] (k : ℕ) (ε : ℝ)
    (f : (Fin n → ℤ) → ℂ) (A₀ : Finset ℕ) (x : Fin n → ℤ) {t : ℝ} :
    ‖companionVec S k ε f A₀ x‖ₑ ^ t =
      (∑ α ∈ sigmaUpper S k A₀, ‖companionProj S ε A₀ α f x‖ₑ ^ 2) ^ (t / 2) := by
  rw [← enorm_sq_companionVec, ← ENNReal.rpow_natCast, ← ENNReal.rpow_mul]
  congr 1; push_cast; ring

/-- Blueprint Lemma 7.6 (`lem:companion`), the case `t = 2`, in `ℝ≥0∞` form:
`∑_{|A₀| ≤ k} ∑_x ∑_{α ∈ Σ^{A₀}} |P_{A₀,α} f(x)|² ≤ 2^k ∑_x |f(x)|²` for `f ∈ ℓ¹`. -/
theorem companion_two_enorm {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} {ε : ℝ}
    (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) :
    ∑ A₀ ∈ S.powerset with #A₀ ≤ k, ∑' x,
        ∑ α ∈ sigmaUpper S k A₀, ‖companionProj S ε A₀ α f x‖ₑ ^ 2 ≤
      ENNReal.ofReal (2 ^ k) * ∑' x, ‖f x‖ₑ ^ 2 := by
  obtain ⟨hsum, hle⟩ := companion_two hS1 hS hε hεr hf
  have hs : ∀ A₀, Summable fun x => ∑ α ∈ sigmaUpper S k A₀, ‖companionProj S ε A₀ α f x‖ ^ 2 :=
    fun A₀ => summable_sum fun α _ => hsum A₀ α
  have hf2 : Summable fun x => ‖f x‖ ^ 2 :=
    summable_pow_of_summable_nonneg (fun _ => norm_nonneg _) hf (by norm_num)
  have e : ∀ A₀ x, ∑ α ∈ sigmaUpper S k A₀, ‖companionProj S ε A₀ α f x‖ₑ ^ 2 =
      ENNReal.ofReal (∑ α ∈ sigmaUpper S k A₀, ‖companionProj S ε A₀ α f x‖ ^ 2) := by
    intro A₀ x
    rw [ENNReal.ofReal_sum_of_nonneg fun _ _ => sq_nonneg _]
    simp_rw [enorm_pow_eq_ofReal]
  simp_rw [e]
  rw [tsum_enorm_pow_eq_ofReal hf2, ← ENNReal.ofReal_mul (by positivity)]
  rw [Finset.sum_congr rfl fun A₀ _ => (ENNReal.ofReal_tsum_of_nonneg
    (fun x => Finset.sum_nonneg fun _ _ => sq_nonneg _) (hs A₀)).symm,
    ← ENNReal.ofReal_sum_of_nonneg fun A₀ _ => tsum_nonneg fun x =>
      Finset.sum_nonneg fun _ _ => sq_nonneg _]
  exact ENNReal.ofReal_le_ofReal hle

/-- The constant of Blueprint Lemma 7.6 (`lem:companion`) for `2 ≤ t < ∞`: `2^k` for `t = 2`,
and `t 2² (2^k)² c^{2-t}/(t-2)` with `c = (2 (C_{n,k} + 1))⁻¹` (Marcinkiewicz with the
`L^∞` endpoint) for `t > 2`; it depends only on `n`, `k` and `t`. -/
noncomputable def companionConst (n k : ℕ) (t : ℝ) : ℝ :=
  if t = 2 then 2 ^ k else
    t * (2 ^ (2 : ℝ) * ((2 : ℝ) ^ k) ^ (2 : ℝ) *
      ((2 * (companionInftyConst n k + 1))⁻¹) ^ (2 - t) / (t - 2))

lemma companionConst_nonneg (n k : ℕ) {t : ℝ} (ht : 2 ≤ t) : 0 ≤ companionConst n k t := by
  unfold companionConst
  split_ifs with h
  · positivity
  · have ht' : 0 < t - 2 := by
      rcases ht.lt_or_eq with h' | h'
      · linarith
      · exact absurd h'.symm h
    have := companionInftyConst_nonneg n k
    positivity

/-- Blueprint Lemma 7.6 (`lem:companion`), eq. (`eq:companion`) for `2 ≤ t < ∞`: under the
separation hypothesis (7.1), for every finitely supported `f` on `G = ℤⁿ`,
`‖(P_{A₀,α} f)_{A₀,α ∈ Σ^{A₀}}‖_{ℓ^t(G × {A₀ : |A₀| ≤ k}; ℓ²_α)}^t ≤ C_{n,k,t} ‖f‖_{ℓ^t(G)}^t`,
written out as
`∑_{A₀ ⊆ S, |A₀| ≤ k} ∑_x (∑_{α ∈ Σ^{A₀}} |P_{A₀,α} f(x)|²)^{t/2} ≤ C_{n,k,t} ∑_x |f(x)|^t`
(in `ℝ≥0∞`), with `C_{n,k,t} = companionConst n k t` depending only on `n`, `k`, `t`. The proof
interpolates (Marcinkiewicz, Blueprint Lemma 2.3, with input space `(G, count)` and output space
`(G × {cores}, count)` valued in `ℓ²_α`) between `companion_two` and `companion_infty`. -/
theorem companion_estimate {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} {ε : ℝ}
    (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    {t : ℝ} (ht : 2 ≤ t) {f : (Fin n → ℤ) → ℂ} (hf : (Function.support f).Finite) :
    ∑ A₀ ∈ S.powerset with #A₀ ≤ k, ∑' x,
        (∑ α ∈ sigmaUpper S k A₀, ‖companionProj S ε A₀ α f x‖ₑ ^ 2) ^ (t / 2) ≤
      ENNReal.ofReal (companionConst n k t) * ∑' x, ‖f x‖ₑ ^ t := by
  classical
  rcases ht.lt_or_eq with ht2 | rfl
  swap
  · -- `t = 2`
    simp only [div_self (two_ne_zero' ℝ), ENNReal.rpow_one, companionConst, ite_true]
    rw [show (2 : ℝ) = ((2 : ℕ) : ℝ) by norm_num]
    simp only [ENNReal.rpow_natCast]
    exact companion_two_enorm hS1 hS hε hεr (summable_of_finite_support hf)
  -- `t > 2`: Marcinkiewicz interpolation
  set D : Set ((Fin n → ℤ) → ℂ) := {g | (Function.support g).Finite} with hD
  set T := companionOp (n := n) S k ε with hT
  set A : ℝ≥0 := 2 ^ k with hA
  set B : ℝ≥0 := ⟨companionInftyConst n k + 1, by
    have := companionInftyConst_nonneg n k; positivity⟩ with hB
  have hB0 : (0 : ℝ) < B := by
    show (0 : ℝ) < companionInftyConst n k + 1; linarith [companionInftyConst_nonneg n k]
  set c : ℝ := (2 * (companionInftyConst n k + 1))⁻¹ with hc
  have hc0 : 0 < c := by rw [hc]; have := companionInftyConst_nonneg n k; positivity
  have hBc : (B : ℝ) * c ≤ 1 / 2 := by
    show (companionInftyConst n k + 1) * c ≤ 1 / 2
    rw [hc]
    have : companionInftyConst n k + 1 ≠ 0 := by
      have := companionInftyConst_nonneg n k; positivity
    field_simp; norm_num
  -- strong type `(2,2)`
  have hstrong : HasStrongTypeOn T D 2 A Measure.count Measure.count := by
    intro g hg
    have hgs := summable_of_finite_support hg
    have h2 : ∫⁻ p, ‖T g p‖ₑ ^ (2 : ℝ) ∂Measure.count ≤
        ENNReal.ofReal (2 ^ k) * ∫⁻ x, ‖g x‖ₑ ^ (2 : ℝ) ∂Measure.count := by
      rw [lintegral_count, lintegral_count, hT,
        tsum_companionOp S k ε g (fun v => ‖v‖ₑ ^ (2 : ℝ)) (by simp)]
      simp_rw [show (2 : ℝ) = ((2 : ℕ) : ℝ) by norm_num, ENNReal.rpow_natCast,
        enorm_sq_companionVec]
      exact companion_two_enorm hS1 hS hε hεr hgs
    refine (eLpNorm_le_of_lintegral_rpow_le AEStronglyMeasurable.of_discrete
      AEStronglyMeasurable.of_discrete (by norm_num) h2).trans ?_
    gcongr
    have h1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal (2 ^ k) := by
      rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal (one_le_pow₀ (by norm_num))
    calc ENNReal.ofReal (2 ^ k) ^ (1 / 2 : ℝ) ≤ ENNReal.ofReal (2 ^ k) ^ (1 : ℝ) :=
          ENNReal.rpow_le_rpow_of_exponent_le h1 (by norm_num)
      _ = (A : ℝ≥0∞) := by
          rw [ENNReal.rpow_one, hA, ENNReal.ofReal_pow (by norm_num)]; simp
  have hweak := hstrong.hasWeakTypeOn (by norm_num : (0 : ℝ) < 2)
  -- the `L^∞` endpoint
  have hlinf : HasLinftyBoundOn T D B Measure.count := by
    intro g hg s hs
    refine Filter.Eventually.of_forall fun p => ?_
    have hs0 : 0 ≤ s := (norm_nonneg _).trans (hs 0)
    simp only [hT, companionOp]
    split_ifs with hp
    · obtain ⟨hp1, hp2⟩ := Finset.mem_filter.1 hp
      refine (companion_infty hS1 hS hε hεr (Finset.mem_powerset.1 hp1) hp2 hg hs p.1).trans ?_
      show _ ≤ (companionInftyConst n k + 1) * s
      have := companionInftyConst_nonneg n k
      nlinarith
    · simp only [norm_zero]; exact mul_nonneg B.2 hs0
  -- sublinearity and truncations
  have hsub : IsSublinearOn T D Measure.count := by
    intro g hg h hh
    refine Filter.Eventually.of_forall fun p => ?_
    rw [hT, companionOp_add k hε (summable_of_finite_support hg) (summable_of_finite_support hh)]
    exact norm_add_le _ _
  have htr : IsTruncationClosed D := by
    intro g hg s _
    have hsub' : ∀ s' : Set (Fin n → ℤ), Function.support (s'.indicator g) ⊆ Function.support g :=
      fun s' x hx => by
        rw [Function.mem_support] at hx ⊢; intro h0; exact hx (by simp [Set.indicator_apply, h0])
    exact ⟨hg.subset (hsub' _), hg.subset (hsub' _)⟩
  have key := lintegral_rpow_le_of_hasWeakTypeOn_of_linfty (μ := Measure.count)
    (ν := Measure.count) (by norm_num : (0 : ℝ) < 2) ht2 hc0 hBc hweak hlinf hsub htr
    (show f ∈ D from hf) AEStronglyMeasurable.of_discrete AEStronglyMeasurable.of_discrete
  rw [lintegral_count, lintegral_count, hT, tsum_companionOp S k ε f (fun v => ‖v‖ₑ ^ t)
    (by simp [ENNReal.zero_rpow_of_pos (by linarith : (0 : ℝ) < t)])] at key
  simp_rw [enorm_rpow_companionVec] at key
  refine key.trans (le_of_eq ?_)
  congr 1
  rw [marcinkiewiczBoundTop, companionConst, ite_eq_right ht2.ne']
  simp only [hA, hc]
  push_cast
  ring_nf

/-- Blueprint Lemma 7.6 (`lem:companion`) for the even exponents `t = 2p` used in Theorem 7.7:
`∑_{A₀ ⊆ S, |A₀| ≤ k} ∑_x (∑_{α ∈ Σ^{A₀}} |P_{A₀,α} f(x)|²)^p ≤ C_{n,k,2p} ∑_x |f(x)|^{2p}` for
`p ≥ 1` and finitely supported `f`. -/
theorem companion_estimate_nat {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} {ε : ℝ}
    (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    {p : ℕ} (hp : 1 ≤ p) {f : (Fin n → ℤ) → ℂ} (hf : (Function.support f).Finite) :
    ∑ A₀ ∈ S.powerset with #A₀ ≤ k, ∑' x,
        (∑ α ∈ sigmaUpper S k A₀, ‖companionProj S ε A₀ α f x‖ₑ ^ 2) ^ p ≤
      ENNReal.ofReal (companionConst n k (2 * p)) * ∑' x, ‖f x‖ₑ ^ (2 * p) := by
  have h := companion_estimate hS1 hS hε hεr (t := 2 * p)
    (by have : (1 : ℝ) ≤ p := by exact_mod_cast hp
        linarith) hf
  have e1 : ((2 * p : ℝ) / 2) = (p : ℝ) := by ring
  rw [e1] at h
  simp_rw [ENNReal.rpow_natCast] at h
  convert h using 3
  rw [show (2 * p : ℝ) = ((2 * p : ℕ) : ℝ) by push_cast; ring]
  funext x
  rw [ENNReal.rpow_natCast]

end CompanionInterpolation

end Companion

/-! ## Blueprint Theorem 7.7 (`thm:IW`): rational-frequency transference -/

section RationalTransference

open MeasureTheory Set Real
open scoped ComplexConjugate FourierTransform ContDiff ENNReal NNReal SchwartzMap

/-! ### Fourier inversion on the torus -/


/-- The quotient map `ℝⁿ → (ℝ/ℤ)ⁿ`. -/
noncomputable def torusQuot (n : ℕ) (x : Fin n → ℝ) : UnitAddTorus (Fin n) :=
  fun i => (x i : UnitAddCircle)

/-- The quotient map `ℝⁿ → (ℝ/ℤ)ⁿ` is an open quotient map. -/
lemma isOpenQuotientMap_torusQuot : IsOpenQuotientMap (torusQuot n) :=
  IsOpenQuotientMap.piMap fun _ => QuotientAddGroup.isOpenQuotientMap_mk

/-- Two points of `ℝⁿ` have the same image in `(ℝ/ℤ)ⁿ` iff they differ by a lattice point. -/
lemma torusQuot_eq_iff {x y : Fin n → ℝ} :
    torusQuot n x = torusQuot n y ↔ ∃ k : Fin n → ℤ, WithLp.toLp 2 y = WithLp.toLp 2 x + latEmbed k := by
  constructor
  · intro h
    have : ∀ i, ∃ k : ℤ, y i = x i + k := by
      intro i
      have hi := congrFun h i
      simp only [torusQuot] at hi
      obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.1 (QuotientAddGroup.eq.1 hi)
      exact ⟨k, by simp at hk; linarith⟩
    choose k hk using this
    exact ⟨k, by ext i; simp [hk i]⟩
  · rintro ⟨k, hk⟩
    funext i
    have hi := congrArg (fun v : EuclideanSpace ℝ (Fin n) => v i) hk
    simp only [PiLp.add_apply, latEmbed_apply] at hi
    simp only [torusQuot]
    rw [show (y i : ℝ) = x i + (k i : ℤ) by simpa using hi]
    simp

/-- The multivariate characters pulled back to `ℝⁿ`: `mFourier j (x mod ℤⁿ) = e(j · x)`. -/
lemma mFourier_torusQuot (j : Fin n → ℤ) (x : Fin n → ℝ) :
    UnitAddTorus.mFourier j (torusQuot n x) = eC (inner ℝ (latEmbed j) (WithLp.toLp 2 x)) := by
  simp only [UnitAddTorus.mFourier, ContinuousMap.coe_mk, torusQuot, fourier_coe_apply]
  rw [PiLp.inner_apply, eC, ← Complex.exp_sum]
  congr 1
  simp only [latEmbed_apply, RCLike.inner_apply, conj_trivial]
  push_cast
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  ring

/-- Torus integrals over `[0,1)ⁿ ⊂ E` as integrals over the box `(0,1]ⁿ ⊂ ℝⁿ`. -/
lemma setIntegral_torusCube_eq_pi_Ioc (h : EuclideanSpace ℝ (Fin n) → ℂ) :
    ∫ ξ in torusCube n, h ξ =
      ∫ x in {x : Fin n → ℝ | ∀ i, x i ∈ Ioc (0 : ℝ) (0 + 1)}, h (WithLp.toLp 2 x) := by
  have hpre : (WithLp.toLp 2 : (Fin n → ℝ) → EuclideanSpace ℝ (Fin n)) ⁻¹' torusCube n =
      Set.pi univ fun _ => Ico (0 : ℝ) 1 := by
    ext x; simp [torusCube]
  have e1 := (PiLp.volume_preserving_toLp (Fin n)).setIntegral_preimage_emb
    (MeasurableEquiv.toLp 2 (Fin n → ℝ)).measurableEmbedding h (torusCube n)
  rw [← e1, hpre]
  have hset : {x : Fin n → ℝ | ∀ i, x i ∈ Ioc (0 : ℝ) (0 + 1)} = Set.pi univ fun _ => Ioc 0 1 := by
    ext x; simp
  rw [hset]
  refine setIntegral_congr_set ?_
  exact Measure.univ_pi_Ico_ae_eq_Icc.trans Measure.univ_pi_Ioc_ae_eq_Icc.symm

/-- Fourier inversion on the torus: a continuous `ℤⁿ`-periodic `g : E → ℂ` whose inverse Fourier
coefficients `ǧ` are absolutely summable is the sum of its Fourier series, `(ǧ)^ = g`
(via Mathlib's multivariate Fourier series on `UnitAddTorus`). -/
theorem latFT_latKernel_of_continuous {g : EuclideanSpace ℝ (Fin n) → ℂ} (hg : Continuous g)
    (hper : ∀ ξ (k : Fin n → ℤ), g (ξ + latEmbed k) = g ξ)
    (hs : Summable fun y => ‖latKernel g y‖) (ξ : EuclideanSpace ℝ (Fin n)) :
    latFT (latKernel g) ξ = g ξ := by
  set q := torusQuot n
  have hq := isOpenQuotientMap_torusQuot (n := n)
  set g₀ : (Fin n → ℝ) → ℂ := fun x => g (WithLp.toLp 2 x) with hg₀
  have hfib : ∀ x y, q x = q y → g₀ x = g₀ y := by
    intro x y hxy
    obtain ⟨k, hk⟩ := torusQuot_eq_iff.1 hxy
    simp only [hg₀, hk, hper]
  set G : UnitAddTorus (Fin n) → ℂ := fun t => g₀ (Function.surjInv hq.surjective t) with hG
  have hGq : G ∘ q = g₀ := by
    funext x
    exact hfib _ _ (Function.surjInv_eq hq.surjective (q x))
  have hGc : Continuous G := by
    rw [← hq.continuous_comp_iff, hGq]
    exact hg.comp (PiLp.continuous_toLp 2 _)
  set Gc : C(UnitAddTorus (Fin n), ℂ) := ⟨G, hGc⟩
  have hcoef : ∀ j, UnitAddTorus.mFourierCoeff (⇑Gc) j = latKernel g (-j) := by
    intro j
    rw [UnitAddTorus.mFourierCoeff_eq_integral _ j 0, latKernel, setIntegral_torusCube_eq_pi_Ioc]
    refine setIntegral_congr_fun ?_ fun x _ => ?_
    · exact MeasurableSet.univ_pi' fun _ => measurableSet_Ioc
    · change UnitAddTorus.mFourier (-j) (q x) • G (q x) = _
      have : G (q x) = g₀ x := congrFun hGq x
      rw [this, mFourier_torusQuot, smul_eq_mul, mul_comm]
  have hsum : Summable (UnitAddTorus.mFourierCoeff (⇑Gc)) := by
    refine Summable.of_norm ?_
    simp_rw [hcoef]
    exact (Equiv.neg (Fin n → ℤ)).summable_iff.2 hs
  have h := UnitAddTorus.hasSum_mFourier_series_apply_of_summable hsum (q (WithLp.ofLp ξ))
  have hval : Gc (q (WithLp.ofLp ξ)) = g ξ := by
    change G (q (WithLp.ofLp ξ)) = g ξ
    rw [show G (q (WithLp.ofLp ξ)) = g₀ (WithLp.ofLp ξ) from congrFun hGq _]
  rw [hval] at h
  rw [← h.tsum_eq, latFT, ← (Equiv.neg (Fin n → ℤ)).tsum_eq]
  refine tsum_congr fun j => ?_
  rw [hcoef, mFourier_torusQuot, smul_eq_mul]
  simp [latEmbed_neg, inner_neg_left]

/-- The periodization of a continuous function supported in `[-c, c]ⁿ`, `c < 1/2`, is continuous
(locally it is a finite sum of translates). -/
lemma continuous_periodize_of_support {φ : EuclideanSpace ℝ (Fin n) → ℂ} (hφ : Continuous φ)
    {c : ℝ} (hc : c < 1 / 2) (hsupp : ∀ η, φ η ≠ 0 → ∀ i, |η i| ≤ c) :
    Continuous (periodize φ) := by
  rw [continuous_iff_continuousAt]
  intro ξ₀
  set F : Finset (Fin n → ℤ) :=
    Fintype.piFinset fun i => Finset.Icc (⌊ξ₀ i⌋ - 1) (⌊ξ₀ i⌋ + 1) with hF
  have hloc : ∀ ξ ∈ Metric.ball ξ₀ (1 / 2), periodize φ ξ = ∑ k ∈ F, φ (ξ - latEmbed k) := by
    intro ξ hξ
    rw [periodize]
    refine tsum_eq_sum fun k hk => ?_
    by_contra hne
    apply hk
    rw [hF, Fintype.mem_piFinset]
    intro i
    have h1 := hsupp _ hne i
    simp only [PiLp.sub_apply, latEmbed_apply] at h1
    have h2 : |ξ i - ξ₀ i| < 1 / 2 := by
      have := PiLp.norm_apply_le (ξ - ξ₀) i
      rw [Metric.mem_ball, dist_eq_norm] at hξ
      simp only [PiLp.sub_apply, Real.norm_eq_abs] at this
      linarith
    have hl := Int.floor_le (ξ₀ i)
    have hu := Int.lt_floor_add_one (ξ₀ i)
    rw [abs_le] at h1
    rw [abs_lt] at h2
    rw [Finset.mem_Icc]
    constructor
    · have : ((⌊ξ₀ i⌋ - 1 : ℤ) : ℝ) < k i + 1 := by push_cast; linarith
      exact_mod_cast (Int.lt_add_one_iff.1 (by exact_mod_cast this))
    · have : (k i : ℝ) < ((⌊ξ₀ i⌋ + 1 : ℤ) : ℝ) + 1 := by push_cast; linarith
      exact Int.lt_add_one_iff.1 (by exact_mod_cast this)
  have hcont : ContinuousAt (fun ξ => ∑ k ∈ F, φ (ξ - latEmbed k)) ξ₀ :=
    (continuous_finsetSum _ fun k _ => hφ.comp (continuous_sub_right _)).continuousAt
  refine hcont.congr ?_
  filter_upwards [Metric.ball_mem_nhds ξ₀ (by norm_num : (0 : ℝ) < 1 / 2)] with ξ hξ
  exact (hloc ξ hξ).symm

/-- Continuous functions are integrable on the torus `[0,1)ⁿ`. -/
lemma integrableOn_torusCube_of_continuous {g : EuclideanSpace ℝ (Fin n) → ℂ}
    (hg : Continuous g) : IntegrableOn g (torusCube n) :=
  (hg.continuousOn.integrableOn_compact (isCompact_box 1)).mono_set fun ξ hξ i => by
    obtain ⟨h0, h1⟩ := hξ i; rw [abs_le]; constructor <;> linarith

/-- Convolutions of `ℓ¹` sequences on `ℤⁿ` are in `ℓ¹`. -/
lemma summable_norm_latConv {K f : (Fin n → ℤ) → ℂ} (hK : Summable fun z => ‖K z‖)
    (hf : Summable fun z => ‖f z‖) : Summable fun x => ‖latConv K f x‖ := by
  have h := (young_latConv (p := 1) le_rfl
    (memLp_one_iff_integrable.2 (integrable_count_iff.2 hK))
    (memLp_one_iff_integrable.2 (integrable_count_iff.2 hf))).2.2
  exact integrable_count_iff.1 (memLp_one_iff_integrable.1 h)

/-- For a continuous `ℤⁿ`-periodic symbol `M` with `ℓ¹` kernel and `f ∈ ℓ¹`, `M(D) f ∈ ℓ¹` and
`(M(D) f)^ = M f̂` (Fourier inversion on the torus). -/
theorem latFT_latMult_of_continuous {M : EuclideanSpace ℝ (Fin n) → ℂ} (hM : Continuous M)
    (hper : ∀ ξ (k : Fin n → ℤ), M (ξ + latEmbed k) = M ξ)
    (hK : Summable fun y => ‖latKernel M y‖) {f : (Fin n → ℤ) → ℂ}
    (hf : Summable fun z => ‖f z‖) :
    (Summable fun x => ‖latMult M f x‖) ∧ ∀ ξ, latFT (latMult M f) ξ = M ξ * latFT f ξ := by
  have hs : Summable fun x => ‖latMult M f x‖ := by
    rw [latMult_eq_latConv (integrableOn_torusCube_of_continuous hM) hf]
    exact summable_norm_latConv hK hf
  refine ⟨hs, fun ξ => ?_⟩
  have e : latMult M f = latKernel (fun ξ => M ξ * latFT f ξ) := rfl
  rw [e]
  refine latFT_latKernel_of_continuous (g := fun ξ => M ξ * latFT f ξ)
    (hM.mul (continuous_latFT hf)) (fun η k => ?_) ?_ ξ
  · simp only [hper, latFT_add_latEmbed]
  · rw [← e]; exact hs

/-- Composition of lattice multipliers: `M₂(D) (M₃(D) f) = (M₂ M₃)(D) f` for `M₃` continuous,
periodic, with `ℓ¹` kernel, and `f ∈ ℓ¹`. -/
theorem latMult_latMult_of_continuous {M₂ M₃ : EuclideanSpace ℝ (Fin n) → ℂ}
    (hM₃ : Continuous M₃) (hper : ∀ ξ (k : Fin n → ℤ), M₃ (ξ + latEmbed k) = M₃ ξ)
    (hK : Summable fun y => ‖latKernel M₃ y‖) {f : (Fin n → ℤ) → ℂ}
    (hf : Summable fun z => ‖f z‖) :
    latMult M₂ (latMult M₃ f) = latMult (fun ξ => M₂ ξ * M₃ ξ) f := by
  funext x
  have h := (latFT_latMult_of_continuous hM₃ hper hK hf).2
  simp only [latMult, h]
  congr 1; funext ξ; ring

/-! ### Spatial windows with small Fourier support -/

/-- The bump `b_N` of radius `1/(N+3)` around `0` used for the spatial windows. -/
noncomputable def windowBump (n N : ℕ) : ContDiffBump (0 : EuclideanSpace ℝ (Fin n)) :=
  ⟨1 / (2 * (N + 3)), 1 / (N + 3), by positivity,
    one_div_lt_one_div_of_lt (by positivity) (by linarith)⟩

/-- The normalized bump `φ_N = b_N / ∫ b_N` (nonnegative, mass one, supported in the ball of
radius `1/(N+3)`), as a complex-valued function. -/
noncomputable def windowPhi (n N : ℕ) (ξ : EuclideanSpace ℝ (Fin n)) : ℂ :=
  ((windowBump n N).normed volume ξ : ℂ)

/-- The window `w_N(x) = 𝓕⁻ φ_N (x)` on `ℤⁿ`: `|w_N| ≤ 1`, `w_N → 1` pointwise, `w_N ∈ ℓ¹`, and
`ŵ_N = (φ_N)_per` is supported in `[-1/(N+3), 1/(N+3)]ⁿ + ℤⁿ`. -/
noncomputable def windowFun (n N : ℕ) (x : Fin n → ℤ) : ℂ :=
  𝓕⁻ (windowPhi n N) (latEmbed x)

/-- `φ_N` is supported in the cube `[-1/(N+3), 1/(N+3)]ⁿ`. -/
lemma windowPhi_support {N : ℕ} {ξ : EuclideanSpace ℝ (Fin n)} (h : windowPhi n N ξ ≠ 0)
    (i : Fin n) : |ξ i| ≤ 1 / (N + 3) := by
  have h1 : (windowBump n N).normed volume ξ ≠ 0 := fun h0 => h (by simp [windowPhi, h0])
  have h2 : ξ ∈ Function.support ((windowBump n N).normed volume) := h1
  rw [ContDiffBump.support_normed_eq, Metric.mem_ball, dist_zero_right] at h2
  have := PiLp.norm_apply_le ξ i
  rw [Real.norm_eq_abs] at this
  exact this.trans (le_of_lt (by simpa [windowBump] using h2))

/-- `φ_N` is smooth. -/
lemma contDiff_windowPhi (N : ℕ) : ContDiff ℝ ∞ (windowPhi n N) :=
  Complex.ofRealCLM.contDiff.comp (windowBump n N).contDiff_normed

/-- `φ_N` has compact support. -/
lemma hasCompactSupport_windowPhi (N : ℕ) : HasCompactSupport (windowPhi n N) :=
  (windowBump n N).hasCompactSupport_normed.comp_left Complex.ofReal_zero

/-- `φ_N` is integrable. -/
lemma integrable_windowPhi (N : ℕ) : Integrable (windowPhi n N) :=
  (contDiff_windowPhi N).continuous.integrable_of_hasCompactSupport (hasCompactSupport_windowPhi N)

/-- The window `w_N` is in `ℓ¹` (rapid decay of `𝓕⁻ φ_N` on the lattice). -/
lemma summable_windowFun (N : ℕ) : Summable fun x => ‖windowFun n N x‖ :=
  (fourierInv_latEmbed_rapidDecay_of_hasCompactSupport (contDiff_windowPhi N)
    (hasCompactSupport_windowPhi N)).2

/-- `∫ φ_N = 1`. -/
lemma integral_windowPhi (N : ℕ) : ∫ ξ, windowPhi n N ξ = 1 := by
  simp only [windowPhi]
  rw [integral_complex_ofReal, ContDiffBump.integral_normed, Complex.ofReal_one]

/-- `|w_N| ≤ ∫ φ_N = 1`. -/
lemma norm_windowFun_le (N : ℕ) (x : Fin n → ℤ) : ‖windowFun n N x‖ ≤ 1 := by
  rw [windowFun, fourierInv_eq_integral_eC]
  refine (norm_integral_le_integral_norm _).trans (le_of_eq ?_)
  have : ∀ ξ, ‖eC (inner ℝ ξ (latEmbed x)) * windowPhi n N ξ‖ =
      (windowBump n N).normed volume ξ := fun ξ => by
    rw [norm_mul, norm_eC, one_mul, windowPhi, Complex.norm_real, Real.norm_of_nonneg
      ((windowBump n N).nonneg_normed ξ)]
  simp_rw [this]
  exact ContDiffBump.integral_normed _

/-- `w_N(x) → 1` as `N → ∞`, since `|w_N(x) - 1| ≤ 2π |x|/(N+3)`. -/
lemma tendsto_windowFun (x : Fin n → ℤ) :
    Filter.Tendsto (fun N => windowFun n N x) Filter.atTop (nhds 1) := by
  set y := latEmbed x
  have hbound : ∀ N : ℕ, ‖windowFun n N x - 1‖ ≤ 2 * π * ‖y‖ * (1 / (N + 3)) := by
    intro N
    have e : windowFun n N x - 1 = ∫ ξ, (eC (inner ℝ ξ y) - 1) * windowPhi n N ξ := by
      have hsub : ∫ ξ, (eC (inner ℝ ξ y) - 1) * windowPhi n N ξ =
          (∫ ξ, eC (inner ℝ ξ y) * windowPhi n N ξ) - ∫ ξ, windowPhi n N ξ := by
        rw [← integral_sub]
        · congr 1; funext ξ; ring
        · exact (integrable_windowPhi N).bdd_mul (c := 1) (by fun_prop)
            (Filter.Eventually.of_forall fun ξ => le_of_eq (norm_eC _))
        · exact integrable_windowPhi N
      rw [hsub, integral_windowPhi, windowFun, fourierInv_eq_integral_eC]
    rw [e]
    refine (norm_integral_le_integral_norm _).trans ?_
    have hpt : ∀ ξ, ‖(eC (inner ℝ ξ y) - 1) * windowPhi n N ξ‖ ≤
        (2 * π * ‖y‖ * (1 / (N + 3))) * (windowBump n N).normed volume ξ := by
      intro ξ
      have hφ : ‖windowPhi n N ξ‖ = (windowBump n N).normed volume ξ := by
        rw [windowPhi, Complex.norm_real, Real.norm_of_nonneg ((windowBump n N).nonneg_normed ξ)]
      rw [norm_mul, hφ]
      by_cases h0 : (windowBump n N).normed volume ξ = 0
      · simp [h0]
      refine mul_le_mul_of_nonneg_right ?_ ((windowBump n N).nonneg_normed ξ)
      have h2 : ξ ∈ Function.support ((windowBump n N).normed volume) := h0
      rw [ContDiffBump.support_normed_eq, Metric.mem_ball, dist_zero_right] at h2
      have h3 : ‖ξ‖ ≤ 1 / (N + 3) := le_of_lt (by simpa [windowBump] using h2)
      have h4 := norm_eC_sub_eC_le (inner ℝ ξ y) 0
      rw [eC_zero, sub_zero] at h4
      refine h4.trans ?_
      have h5 : |inner ℝ ξ y| ≤ ‖ξ‖ * ‖y‖ := abs_real_inner_le_norm ξ y
      have : ‖ξ‖ * ‖y‖ ≤ 1 / (N + 3) * ‖y‖ := mul_le_mul_of_nonneg_right h3 (norm_nonneg _)
      nlinarith [Real.pi_pos]
    refine (integral_mono_of_nonneg (Filter.Eventually.of_forall fun _ => norm_nonneg _)
      (((windowBump n N).integrable_normed).const_mul _)
      (Filter.Eventually.of_forall hpt)).trans (le_of_eq ?_)
    rw [integral_const_mul, ContDiffBump.integral_normed, mul_one]
  rw [tendsto_iff_norm_sub_tendsto_zero]
  refine squeeze_zero (fun _ => norm_nonneg _) hbound ?_
  have : Filter.Tendsto (fun N : ℕ => (1 : ℝ) / ((N : ℝ) + 3)) Filter.atTop (nhds 0) := by
    have := tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ)
    refine squeeze_zero (fun _ => by positivity) (fun N => ?_) this
    exact one_div_le_one_div_of_le (by positivity) (by linarith)
  simpa using this.const_mul (2 * π * ‖y‖)

/-- `(φ_N)_perˇ = w_N`. -/
lemma latKernel_periodize_windowPhi (N : ℕ) :
    latKernel (periodize (windowPhi n N)) = windowFun n N :=
  funext fun y => latKernel_periodize (integrable_windowPhi N) y

/-- `ŵ_N = (φ_N)_per` (Fourier inversion on the torus). -/
lemma latFT_windowFun (N : ℕ) (ξ : EuclideanSpace ℝ (Fin n)) :
    latFT (windowFun n N) ξ = periodize (windowPhi n N) ξ := by
  rw [← latKernel_periodize_windowPhi]
  refine latFT_latKernel_of_continuous ?_ (fun η k => periodize_add_latEmbed _ η k) ?_ ξ
  · refine continuous_periodize_of_support (contDiff_windowPhi N).continuous (c := 1 / 3) ?_
      fun η h i => (windowPhi_support h i).trans ?_
    · norm_num
    · exact one_div_le_one_div_of_le (by norm_num) (by linarith [N.cast_nonneg (α := ℝ)])
  · rw [latKernel_periodize_windowPhi]; exact summable_windowFun N

/-- The Fourier transform of a product `m̌ · w` with `w ∈ ℓ¹` is the torus convolution
`∫ ŵ(ξ - η) m(η) dη`. -/
lemma latFT_latKernel_mul {M : EuclideanSpace ℝ (Fin n) → ℂ} (hM : IntegrableOn M (torusCube n))
    {w : (Fin n → ℤ) → ℂ} (hw : Summable fun z => ‖w z‖) (ξ : EuclideanSpace ℝ (Fin n)) :
    latFT (fun x => latKernel M x * w x) ξ = ∫ η in torusCube n, latFT w (ξ - η) * M η := by
  set u : (Fin n → ℤ) → ℂ := fun z => w (-z) * eC (inner ℝ (latEmbed z) ξ) with hu_def
  have hu : Summable fun z => ‖u z‖ := by
    simp only [hu_def, norm_mul, norm_eC, mul_one]
    exact (Equiv.neg (Fin n → ℤ)).summable_iff.2 hw
  have hlat : ∀ η, latFT u η = latFT w (ξ - η) := by
    intro η
    unfold latFT
    rw [← (Equiv.neg (Fin n → ℤ)).tsum_eq]
    refine tsum_congr fun z => ?_
    simp only [hu_def, Equiv.neg_apply, neg_neg, latEmbed_neg, inner_neg_left, inner_sub_right]
    rw [mul_assoc, ← eC_add]
    congr 2; ring
  have e1 : ∫ η in torusCube n, latFT w (ξ - η) * M η = ∫ η in torusCube n, latFT u η * M η := by
    congr 1; funext η; rw [hlat]
  rw [e1, integral_latFT_mul hu hM, latFT, ← (Equiv.neg (Fin n → ℤ)).tsum_eq]
  refine tsum_congr fun z => ?_
  simp only [hu_def, Equiv.neg_apply, neg_neg, latKernel, latEmbed_neg, inner_neg_left]
  have : ∫ ξ in torusCube n, M ξ * eC (-inner ℝ (latEmbed z) ξ) =
      ∫ ξ in torusCube n, eC (-inner ℝ (latEmbed z) ξ) * M ξ := by
    congr 1; funext η; ring
  rw [this]
  ring

/-- The windowed pieces `(m_per(· - α))(D) f · w_N` have Fourier support in `α + [-ε,ε]ⁿ + ℤⁿ`
when `m` is supported in `[-ε/2, ε/2]ⁿ` and `1/(N+3) ≤ ε/2`. -/
lemma latFT_latMult_mul_windowFun_eq_zero {m : EuclideanSpace ℝ (Fin n) → ℂ} (hm : Integrable m)
    {ε : ℝ} (hmε : ∀ η, m η ≠ 0 → ∀ i, |η i| ≤ ε / 2) {N : ℕ} (hN : 1 / ((N : ℝ) + 3) ≤ ε / 2)
    {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) {Q : ℕ} (α : Fin n → ZMod Q)
    {ξ : EuclideanSpace ℝ (Fin n)} (hξ : ξ ∉ ratNbhd Q ε α) :
    latFT (fun x => latMult (fun η => periodize m (η - ratPt Q α)) f x * windowFun n N x) ξ =
      0 := by
  have hint : IntegrableOn (fun η => periodize m (η - ratPt Q α) * latFT f η) (torusCube n) :=
    (integrableOn_periodize_sub hm (ratPt Q α)).mul_bdd (c := ∑' z, ‖f z‖)
      (continuous_latFT hf).aestronglyMeasurable
      (Filter.Eventually.of_forall fun η => norm_latFT_le hf η)
  have e : (fun x => latMult (fun η => periodize m (η - ratPt Q α)) f x * windowFun n N x) =
      fun x => latKernel (fun η => periodize m (η - ratPt Q α) * latFT f η) x * windowFun n N x := rfl
  rw [e, latFT_latKernel_mul hint (summable_windowFun N)]
  have hz : ∀ η, latFT (windowFun n N) (ξ - η) * (periodize m (η - ratPt Q α) * latFT f η) = 0 := by
    intro η
    by_contra h
    obtain ⟨h1, h2⟩ := mul_ne_zero_iff.1 h
    have h2' := left_ne_zero_of_mul h2
    rw [latFT_windowFun] at h1
    obtain ⟨z', hz'⟩ := exists_ne_zero_of_periodize_ne_zero h1
    obtain ⟨z, hz⟩ := exists_ne_zero_of_periodize_ne_zero h2'
    apply hξ
    refine ⟨z + z', fun i => ?_⟩
    have a1 := windowPhi_support hz' i
    have a2 := hmε _ hz i
    simp only [PiLp.sub_apply, latEmbed_apply] at a1 a2
    rw [abs_le] at a1 a2 ⊢
    simp only [Pi.add_apply, Int.cast_add]
    obtain ⟨a1l, a1r⟩ := a1
    obtain ⟨a2l, a2r⟩ := a2
    constructor <;> linarith
  refine (setIntegral_congr_fun measurableSet_torusCube fun η _ => hz η).trans ?_
  simp

/-- `|M(D) f(x)| ≤ ‖M‖_{L¹(𝕋ⁿ)} ‖f‖_{ℓ¹}`. -/
lemma norm_latMult_le {M : EuclideanSpace ℝ (Fin n) → ℂ} (hM : IntegrableOn M (torusCube n))
    {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) (x : Fin n → ℤ) :
    ‖latMult M f x‖ ≤ (∫ η in torusCube n, ‖M η‖) * ∑' z, ‖f z‖ := by
  refine (norm_integral_le_integral_norm _).trans ?_
  rw [← integral_mul_const]
  refine integral_mono_of_nonneg (Filter.Eventually.of_forall fun _ => norm_nonneg _)
    (hM.norm.mul_const _) (Filter.Eventually.of_forall fun η => ?_)
  simp only [norm_mul, norm_eC, mul_one]
  exact mul_le_mul_of_nonneg_left (norm_latFT_le hf η) (norm_nonneg _)

/-- `T_{m;Λ} f = ∑_{α ∈ Λ} (m_per(· - α))(D) f` for `m` integrable and `f ∈ ℓ¹`. -/
lemma cosetMult_eq_sum {Q : ℕ} {m : EuclideanSpace ℝ (Fin n) → ℂ} (hm : Integrable m)
    (Λ : Finset (Fin n → ZMod Q)) {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖)
    (x : Fin n → ℤ) :
    cosetMult Q m Λ f x = ∑ α ∈ Λ, latMult (fun η => periodize m (η - ratPt Q α)) f x := by
  have h := latMult_sum_mul Λ (fun _ => 1) (m := fun α η => periodize m (η - ratPt Q α))
    (fun α _ => integrableOn_periodize_sub hm _) hf x
  simp only [one_mul] at h
  exact h

/-- Blueprint Lemma 7.5 (`lem:normdescription`) for the pieces `f_α = T_{m;{α}} f` of a bounded
symbol `m` (integrable and supported in `[-ε/2, ε/2]ⁿ`) and `f ∈ ℓ¹`, which need not be in `ℓ¹`
themselves: `∑_x |T_{m;Σ_{≤k}} f(x)|^{2r} ≤ C_{k,r} ∑_{|A₀| ≤ k} ∑_x
(∑_{α ∈ Σ^{A₀}} |T_{m; α + Σ_{A₀}} f(x)|²)^r`. Proof: apply `normdescription_enorm` to the
windowed pieces `f_α w_N` (in `ℓ¹`, with Fourier support in `α + [-ε,ε]ⁿ + ℤⁿ`), use `|w_N| ≤ 1`,
and let `N → ∞` (`w_N → 1` pointwise). -/
theorem normdescription_cosetMult {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} (hr : 0 < r)
    {ε : ℝ} (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    {m : EuclideanSpace ℝ (Fin n) → ℂ} (hm : Integrable m)
    (hmε : ∀ η, m η ≠ 0 → ∀ i, |η i| ≤ ε / 2)
    {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) :
    ∑' x, ‖cosetMult (blockProd S) m (sigmaLe S k) f x‖ₑ ^ (2 * r) ≤
      ENNReal.ofReal (normDescConst k r) *
        ∑ A₀ ∈ S.powerset with #A₀ ≤ k, ∑' x, (∑ α ∈ sigmaUpper S k A₀,
          ‖cosetMult (blockProd S) m (cosetSet S A₀ α) f x‖ₑ ^ 2) ^ r := by
  set Q := blockProd S
  set F : (Fin n → ZMod Q) → (Fin n → ℤ) → ℂ :=
    fun α => latMult (fun η => periodize m (η - ratPt Q α)) f with hF
  set R := ENNReal.ofReal (normDescConst k r) *
        ∑ A₀ ∈ S.powerset with #A₀ ≤ k, ∑' x, (∑ α ∈ sigmaUpper S k A₀,
          ‖cosetMult (blockProd S) m (cosetSet S A₀ α) f x‖ₑ ^ 2) ^ r with hR
  set T := cosetMult Q m (sigmaLe S k) f with hT
  have hTsum : ∀ x, T x = ∑ α ∈ sigmaLe S k, F α x := fun x => cosetMult_eq_sum hm _ hf x
  have hcoset : ∀ A₀ α x, cosetFun S F A₀ α x = cosetMult Q m (cosetSet S A₀ α) f x := by
    intro A₀ α x
    rw [cosetMult_eq_sum hm _ hf x, cosetSet, Finset.sum_map]
    rfl
  -- boundedness of the pieces
  have hFb : ∀ α x, ‖F α x‖ ≤ (∫ η in torusCube n, ‖periodize m (η - ratPt Q α)‖) * ∑' z, ‖f z‖ :=
    fun α x => norm_latMult_le (integrableOn_periodize_sub hm _) hf x
  -- the windowed estimate
  have hwin : ∀ N : ℕ, 1 / ((N : ℝ) + 3) ≤ ε / 2 →
      ∑' x, ‖T x * windowFun n N x‖ₑ ^ (2 * r) ≤ R := by
    intro N hN
    set G : (Fin n → ZMod Q) → (Fin n → ℤ) → ℂ := fun α x => F α x * windowFun n N x with hG
    have hGs : ∀ α ∈ sigmaLe S k, Summable fun z => ‖G α z‖ := by
      intro α _
      refine Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun z => ?_)
        ((summable_windowFun N).mul_left
          ((∫ η in torusCube n, ‖periodize m (η - ratPt Q α)‖) * ∑' z, ‖f z‖))
      rw [hG, norm_mul]
      exact mul_le_mul_of_nonneg_right (hFb α z) (norm_nonneg _)
    have hGsupp : ∀ α ∈ sigmaLe S k, ∀ ξ ∉ ratNbhd Q ε α, latFT (G α) ξ = 0 :=
      fun α _ ξ hξ => latFT_latMult_mul_windowFun_eq_zero hm hmε hN hf α hξ
    have h := normdescription_enorm hS1 hS hr hε hεr G hGs hGsupp
    have hL : ∀ x, ∑ α ∈ sigmaLe S k, G α x = T x * windowFun n N x := by
      intro x; rw [hTsum, Finset.sum_mul]
    simp_rw [hL] at h
    refine h.trans ?_
    rw [hR]
    gcongr with A₀ _ x α _
    have : cosetFun S G A₀ α x = cosetFun S F A₀ α x * windowFun n N x := by
      simp only [cosetFun, hG, Finset.sum_mul]
    rw [this, hcoset, enorm_mul]
    have hw : ‖windowFun n N x‖ₑ ≤ 1 := by
      rw [← ofReal_norm, ← ENNReal.ofReal_one]
      exact ENNReal.ofReal_le_ofReal (norm_windowFun_le N x)
    calc ‖cosetMult Q m (cosetSet S A₀ α) f x‖ₑ * ‖windowFun n N x‖ₑ
        ≤ ‖cosetMult Q m (cosetSet S A₀ α) f x‖ₑ * 1 := by gcongr
      _ = _ := mul_one _
  -- the limit `N → ∞`
  obtain ⟨N₀, hN₀⟩ : ∃ N₀ : ℕ, ∀ N ≥ N₀, 1 / ((N : ℝ) + 3) ≤ ε / 2 := by
    refine ⟨⌈2 / ε⌉₊, fun N hN => ?_⟩
    have h1 : 2 / ε ≤ N := (Nat.le_ceil _).trans (by exact_mod_cast hN)
    rw [div_le_div_iff₀ (by positivity) (by norm_num), one_mul]
    rw [div_le_iff₀ hε] at h1
    nlinarith
  rw [ENNReal.tsum_eq_iSup_sum]
  refine iSup_le fun s => ?_
  have hlim : Filter.Tendsto (fun N => ∑ x ∈ s, ‖T x * windowFun n N x‖ₑ ^ (2 * r))
      Filter.atTop (nhds (∑ x ∈ s, ‖T x‖ₑ ^ (2 * r))) := by
    refine tendsto_finsetSum _ fun x _ => ?_
    have h1 : Filter.Tendsto (fun N => T x * windowFun n N x) Filter.atTop (nhds (T x * 1)) :=
      tendsto_const_nhds.mul (tendsto_windowFun x)
    rw [mul_one] at h1
    exact ENNReal.Tendsto.pow ((continuous_enorm.tendsto _).comp h1)
  refine le_of_tendsto hlim (Filter.eventually_atTop.2 ⟨N₀, fun N hN => ?_⟩)
  exact (ENNReal.sum_le_tsum s).trans (hwin N (hN₀ N hN))

/-! ### The factorization `f_{A₀,α} = M_α T_{m;Σ_{A₀}} M_{-α} P_{A₀,α} f` -/

/-- `θ_ε` is smooth. -/
lemma contDiff_cutoffEps (ε : ℝ) : ContDiff ℝ ∞ (cutoffEps n ε) :=
  Complex.ofRealCLM.contDiff.comp (contDiff_companionCutoff.comp (contDiff_const_smul _))

/-- `θ_ε` has compact support. -/
lemma hasCompactSupport_cutoffEps {ε : ℝ} (hε : 0 < ε) : HasCompactSupport (cutoffEps n ε) :=
  HasCompactSupport.intro (isCompact_box (2 * ε)) fun _ h => cutoffEps_eq_zero hε h

/-- The kernel of `T_{φ;Λ}` is in `ℓ¹` for smooth compactly supported `φ`. -/
lemma summable_latKernel_cosetSymbol {Q : ℕ} {φ : EuclideanSpace ℝ (Fin n) → ℂ}
    (hφs : ContDiff ℝ ∞ φ) (hφc : HasCompactSupport φ) (Λ : Finset (Fin n → ZMod Q)) :
    Summable fun y => ‖latKernel (cosetSymbol Q φ Λ) y‖ := by
  have hφi : Integrable φ := hφs.continuous.integrable_of_hasCompactSupport hφc
  have hs := (fourierInv_latEmbed_rapidDecay_of_hasCompactSupport hφs hφc).2
  have e : ∀ y, latKernel (cosetSymbol Q φ Λ) y =
      ∑ β ∈ Λ, eC (inner ℝ (ratPt Q β) (latEmbed y)) * 𝓕⁻ φ (latEmbed y) := by
    intro y
    have h := latKernel_sum_mul Λ (fun _ => 1) (m := fun β ξ => periodize φ (ξ - ratPt Q β))
      (fun β _ => integrableOn_periodize_sub hφi _) y
    simp only [one_mul] at h
    rw [show cosetSymbol Q φ Λ = fun ξ => ∑ β ∈ Λ, periodize φ (ξ - ratPt Q β) from rfl, h]
    refine Finset.sum_congr rfl fun β _ => ?_
    simp_rw [periodize_comp_sub]
    rw [latKernel_periodize (hφi.comp_sub_right _), fourierInv_comp_sub]
  simp_rw [e]
  refine Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun y => norm_sum_le _ _) ?_
  refine summable_sum fun β _ => ?_
  simp only [norm_mul, norm_eC, one_mul]
  exact hs

/-- `T_{φ;Λ}` has a continuous periodic symbol for continuous `φ` supported in `[-c,c]ⁿ`,
`c < 1/2`. -/
lemma continuous_cosetSymbol {Q : ℕ} {φ : EuclideanSpace ℝ (Fin n) → ℂ} (hφ : Continuous φ)
    {c : ℝ} (hc : c < 1 / 2) (hsupp : ∀ η, φ η ≠ 0 → ∀ i, |η i| ≤ c)
    (Λ : Finset (Fin n → ZMod Q)) : Continuous (cosetSymbol Q φ Λ) :=
  continuous_finsetSum _ fun _ _ =>
    (continuous_periodize_of_support hφ hc hsupp).comp (continuous_sub_right _)

/-- The symbols `∑_{β ∈ Λ} φ_per(· - β)` are `ℤⁿ`-periodic. -/
lemma cosetSymbol_add_latEmbed {Q : ℕ} (φ : EuclideanSpace ℝ (Fin n) → ℂ)
    (Λ : Finset (Fin n → ZMod Q)) (ξ : EuclideanSpace ℝ (Fin n)) (k : Fin n → ℤ) :
    cosetSymbol Q φ Λ (ξ + latEmbed k) = cosetSymbol Q φ Λ ξ := by
  unfold cosetSymbol
  refine Finset.sum_congr rfl fun β _ => ?_
  rw [add_sub_right_comm, periodize_add_latEmbed]

/-- `m_per · (θ_ε)_per = m_per` for `m` supported in `[-ε/2, ε/2]ⁿ`, `4ε < 1`. -/
lemma periodize_mul_periodize_cutoffEps {m : EuclideanSpace ℝ (Fin n) → ℂ} {ε : ℝ}
    (hε : 0 < ε) (hε4 : 4 * ε < 1) (hmε : ∀ η, m η ≠ 0 → ∀ i, |η i| ≤ ε / 2)
    (ζ : EuclideanSpace ℝ (Fin n)) :
    periodize m ζ * periodize (cutoffEps n ε) ζ = periodize m ζ := by
  by_cases h : periodize m ζ = 0
  · rw [h, zero_mul]
  obtain ⟨z, hz⟩ := exists_ne_zero_of_periodize_ne_zero h
  have hz1 : ∀ i, |ζ i - z i| ≤ ε / 2 := fun i => by simpa using hmε _ hz i
  have hθ : periodize (cutoffEps n ε) ζ = 1 := by
    rw [periodize, tsum_eq_single z]
    · refine cutoffEps_eq_one hε fun i => ?_
      simpa using (hz1 i).trans (by linarith)
    · intro z' hz'
      by_contra h'
      apply hz'
      refine eq_of_abs_sub_intCast_le hε4 (η := ζ) (fun i => ?_) (fun i => ?_)
      · simpa using cutoffEps_support hε _ h' i
      · exact (hz1 i).trans (by linarith)
  rw [hθ, mul_one]

/-- `T_{m;Λ}` and `T_{θ_ε;Λ}` multiply to `T_{m;Λ}` for `Λ ⊆ Σ_{≤k}` and `m` supported in
`[-ε/2, ε/2]ⁿ` (different center bumps are disjoint and `θ_ε = 1` on the support of `m`). -/
lemma cosetSymbol_mul_cosetSymbol_cutoffEps {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} {ε : ℝ}
    (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    {m : EuclideanSpace ℝ (Fin n) → ℂ} (hmε : ∀ η, m η ≠ 0 → ∀ i, |η i| ≤ ε / 2)
    {Λ : Finset (Fin n → ZMod (blockProd S))} (hΛ : Λ ⊆ sigmaLe S k)
    (ξ : EuclideanSpace ℝ (Fin n)) :
    cosetSymbol (blockProd S) m Λ ξ * cosetSymbol (blockProd S) (cutoffEps n ε) Λ ξ =
      cosetSymbol (blockProd S) m Λ ξ := by
  have hε4 := four_eps_lt_one S hε hεr
  unfold cosetSymbol
  rw [Finset.sum_mul_sum]
  refine Finset.sum_congr rfl fun γ hγ => ?_
  rw [Finset.sum_eq_single γ]
  · exact periodize_mul_periodize_cutoffEps hε hε4 hmε _
  · intro γ' hγ' hne
    by_contra h
    obtain ⟨h1, h2⟩ := mul_ne_zero_iff.1 h
    obtain ⟨z, hz⟩ := exists_ne_zero_of_periodize_ne_zero h1
    obtain ⟨z', hz'⟩ := exists_ne_zero_of_periodize_ne_zero h2
    apply hne
    refine (eq_of_near_ratPt hS1 hS hε hεr (hΛ hγ) (hΛ hγ') (z := z) (z' := z') (ξ := ξ)
      (fun i => ?_) (fun i => ?_)).symm
    · have := hmε _ hz i
      simp only [PiLp.sub_apply, latEmbed_apply] at this
      exact this.trans (by linarith)
    · have := cutoffEps_support hε _ hz' i
      simpa using this
  · intro h; exact absurd hγ h

/-- The coset `α + Σ_{A₀}`, `α ∈ Σ^{A₀}`, lies in `Σ_{≤k}`. -/
lemma cosetSet_subset_sigmaLe {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {k : ℕ} {A₀ : Finset ℕ} {α : Fin n → ZMod (blockProd S)}
    (hα : α ∈ sigmaUpper S k A₀) : cosetSet S A₀ α ⊆ sigmaLe S k := by
  intro γ hγ
  simp only [cosetSet, Finset.mem_map, addLeftEmbedding_apply] at hγ
  obtain ⟨β, hβ, rfl⟩ := hγ
  exact add_mem_sigmaLe_of_coset hS hα hβ

/-- Modulation: the symbol of `T_{m; α + Σ_{A₀}}` is that of `T_{m;Σ_{A₀}}` translated by `α`. -/
lemma cosetSymbol_cosetSet_eq_sub {S : Finset ℕ} [NeZero (blockProd S)]
    (m : EuclideanSpace ℝ (Fin n) → ℂ) (A₀ : Finset ℕ) (α : Fin n → ZMod (blockProd S))
    (ξ : EuclideanSpace ℝ (Fin n)) :
    cosetSymbol (blockProd S) m (cosetSet S A₀ α) ξ =
      cosetSymbol (blockProd S) m (sigmaBlock S A₀) (ξ - ratPt (blockProd S) α) := by
  rw [cosetSymbol_cosetSet, cosetSymbol]
  refine Finset.sum_congr rfl fun β _ => ?_
  rw [periodize_sub_ratPt_add, sub_right_comm,
    periodize_comp_sub m (ratPt (blockProd S) α) (ξ - ratPt (blockProd S) β)]
/-- The factorization of Theorem 7.7:
`T_{m; α + Σ_{A₀}} f = M_α T_{m; Σ_{A₀}} M_{-α} T_{θ_ε; α + Σ_{A₀}} f` for `α ∈ Σ^{A₀}`, `m`
integrable and supported in `[-ε/2, ε/2]ⁿ`, and `f ∈ ℓ¹` (`M_β = latModulate β`). -/
theorem cosetMult_cosetSet_eq_modulate {S : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q)
    (hS : (S : Set ℕ).Pairwise Nat.Coprime) [NeZero (blockProd S)] {k r : ℕ} {ε : ℝ}
    (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    {m : EuclideanSpace ℝ (Fin n) → ℂ} (hmε : ∀ η, m η ≠ 0 → ∀ i, |η i| ≤ ε / 2)
    {A₀ : Finset ℕ} {α : Fin n → ZMod (blockProd S)} (hα : α ∈ sigmaUpper S k A₀)
    {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) :
    cosetMult (blockProd S) m (cosetSet S A₀ α) f =
      latModulate (ratPt (blockProd S) α) (cosetMult (blockProd S) m (sigmaBlock S A₀)
        (latModulate (-ratPt (blockProd S) α) (companionProj S ε A₀ α f))) := by
  have hε4 := four_eps_lt_one S hε hεr
  set M₃ := cosetSymbol (blockProd S) (cutoffEps n ε) (cosetSet S A₀ α) with hM₃
  have hM₃c : Continuous M₃ := continuous_cosetSymbol (continuous_cutoffEps ε) (c := 2 * ε)
    (by linarith) (cutoffEps_support hε) _
  have hM₃k := summable_latKernel_cosetSymbol (Q := blockProd S) (contDiff_cutoffEps (n := n) ε)
    (hasCompactSupport_cutoffEps hε) (cosetSet S A₀ α)
  calc cosetMult (blockProd S) m (cosetSet S A₀ α) f
      = latMult (fun ξ => cosetSymbol (blockProd S) m (cosetSet S A₀ α) ξ * M₃ ξ) f := by
        unfold cosetMult; congr 1; funext ξ
        exact (cosetSymbol_mul_cosetSymbol_cutoffEps hS1 hS hε hεr hmε
          (cosetSet_subset_sigmaLe hS hα) ξ).symm
    _ = latMult (cosetSymbol (blockProd S) m (cosetSet S A₀ α)) (latMult M₃ f) :=
        (latMult_latMult_of_continuous hM₃c (cosetSymbol_add_latEmbed _ _) hM₃k hf).symm
    _ = latMult (fun ξ => cosetSymbol (blockProd S) m (sigmaBlock S A₀)
          (ξ - ratPt (blockProd S) α)) (companionProj S ε A₀ α f) := by
        congr 1; funext ξ; exact cosetSymbol_cosetSet_eq_sub m A₀ α ξ
    _ = _ := latMult_comp_sub (cosetSymbol_add_latEmbed _ _) _ _
/-! ### `ℓ^p` bounds for `T_{m;Σ_{A₀}}` -/


/-- Extension of an `ℓ^P` bound for a lattice multiplier from finitely supported inputs to `ℓ¹`
inputs (truncation, pointwise convergence and Fatou). -/
lemma eLpNorm_latMult_le_of_finite {M : EuclideanSpace ℝ (Fin n) → ℂ}
    (hM : IntegrableOn M (torusCube n)) {P K : ℝ≥0∞}
    (h : ∀ g : (Fin n → ℤ) → ℂ, (Function.support g).Finite →
      eLpNorm (latMult M g) P Measure.count ≤ K * eLpNorm g P Measure.count)
    {g : (Fin n → ℤ) → ℂ} (hg : Summable fun z => ‖g z‖) :
    eLpNorm (latMult M g) P Measure.count ≤ K * eLpNorm g P Measure.count := by
  set gR : ℕ → (Fin n → ℤ) → ℂ := fun R => (latBox n R).indicator g with hgR
  have hgRfin : ∀ R, (Function.support (gR R)).Finite := fun R =>
    support_indicator_latBox_finite n R g
  have hgRs : ∀ R, Summable fun z => ‖gR R z‖ := fun R => summable_of_finite_support (hgRfin R)
  have hcompl : ∀ R, g - gR R = (latBox n R)ᶜ.indicator g := fun R =>
    (Set.indicator_compl _ _).symm
  have hdiff : ∀ R, Summable fun z => ‖(g - gR R) z‖ := by
    intro R
    rw [hcompl]
    exact Summable.of_nonneg_of_le (fun _ => norm_nonneg _)
      (fun z => norm_indicator_le_norm_self _ _) hg
  set dR : ℕ → ℝ := fun R => ∑' z, ‖(g - gR R) z‖ with hdR
  have hdR : Filter.Tendsto dR Filter.atTop (nhds 0) := by
    have h1 := eLpNorm_sub_indicator_latBox_tendsto (p := 1) ENNReal.one_ne_top
      (memLp_one_iff_integrable.2 (integrable_count_iff.2 hg))
    have e : ∀ R, eLpNorm (g - (latBox n R).indicator g) 1 Measure.count =
        ENNReal.ofReal (dR R) := by
      intro R
      rw [eLpNorm_one_eq_lintegral_enorm AEStronglyMeasurable.of_discrete, lintegral_count,
        hdR, ENNReal.ofReal_tsum_of_nonneg (fun _ => norm_nonneg _) (hdiff R)]
      simp only [ofReal_norm]
      rfl
    simp_rw [e] at h1
    have h2 := (ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp h1
    simp only [Function.comp_def, ENNReal.toReal_zero] at h2
    refine h2.congr fun R => ?_
    exact ENNReal.toReal_ofReal (tsum_nonneg fun _ => norm_nonneg _)
  have hlim : ∀ x, Filter.Tendsto (fun R => latMult M (gR R) x) Filter.atTop
      (nhds (latMult M g x)) := by
    intro x
    rw [tendsto_iff_norm_sub_tendsto_zero]
    refine squeeze_zero (fun _ => norm_nonneg _) (fun R => ?_)
      (by simpa using hdR.const_mul (∫ η in torusCube n, ‖M η‖))
    have e : latMult M g = latMult M (gR R) + latMult M (g - gR R) := by
      rw [← latMult_add hM (hgRs R) (hdiff R), add_sub_cancel]
    rw [e, Pi.add_apply, sub_add_cancel_left, norm_neg]
    exact norm_latMult_le hM (hdiff R) x
  refine eLpNorm_le_of_tendsto_of_eLpNorm_le (u := fun R => latMult M (gR R))
    (fun _ => AEStronglyMeasurable.of_discrete) (Filter.Eventually.of_forall hlim) fun R => ?_
  refine (h _ (hgRfin R)).trans ?_
  gcongr
  exact eLpNorm_indicator_le _ (MeasurableSet.of_discrete)
/-- The coset `0 + Σ_{A₀}` is `Σ_{A₀}`. -/
lemma cosetSet_zero (S : Finset ℕ) [NeZero (blockProd S)] (A₀ : Finset ℕ) :
    cosetSet (n := n) S A₀ 0 = sigmaBlock S A₀ := by
  ext x; simp [cosetSet]

/-- The shifted full-grid symbol with shift `0` is `Δ_{Q_B} m`. -/
lemma gridSymbol_zero {S : Finset ℕ} [NeZero (blockProd S)] {B : Finset ℕ}
    (hBS : B ⊆ S) (m : EuclideanSpace ℝ (Fin n) → ℂ) (ξ : EuclideanSpace ℝ (Fin n)) :
    gridSymbol S B m 0 ξ = gridSym (blockProd B) m ξ := by
  rw [gridSymbol]
  simp_rw [zero_add]
  exact sum_blockGrid_periodize_eq_gridSym (blockProd_dvd_blockProd hBS) m ξ

/-- `T_{m;Σ_{A₀}}` is a signed sum of the `2^{|A₀|}` full-grid operators `Δ_{Q_B}`, `B ⊆ A₀`
(eq. (7.4)); hence an `ℓ^P` bound `K` for each of them gives the bound `2^{|A₀|} K`. -/
lemma eLpNorm_cosetMult_sigmaBlock_le {S : Finset ℕ} (hS : (S : Set ℕ).Pairwise Nat.Coprime)
    [NeZero (blockProd S)] {A₀ : Finset ℕ} (hA₀ : A₀ ⊆ S) {m : EuclideanSpace ℝ (Fin n) → ℂ}
    (hm : Integrable m) {P K : ℝ≥0∞} (hP : 1 ≤ P)
    (hgrid : ∀ B ⊆ A₀, ∀ g : (Fin n → ℤ) → ℂ, (Function.support g).Finite →
      eLpNorm (latMult (gridSym (blockProd B) m) g) P Measure.count ≤
        K * eLpNorm g P Measure.count)
    {g : (Fin n → ℤ) → ℂ} (hg : (Function.support g).Finite) :
    eLpNorm (cosetMult (blockProd S) m (sigmaBlock S A₀) g) P Measure.count ≤
      2 ^ #A₀ * K * eLpNorm g P Measure.count := by
  have hsym : cosetSymbol (blockProd S) m (sigmaBlock S A₀) = fun ξ =>
      ∑ B ∈ A₀.powerset, (-1 : ℂ) ^ (#A₀ - #B) * gridSym (blockProd B) m ξ := by
    funext ξ
    rw [← cosetSet_zero, cosetSymbol_cosetSet_eq_sum_gridSymbol hS hA₀ m 0 ξ]
    refine Finset.sum_congr rfl fun B hB => ?_
    rw [gridSymbol_zero ((Finset.mem_powerset.1 hB).trans hA₀)]
  have hfun : cosetMult (blockProd S) m (sigmaBlock S A₀) g = ∑ B ∈ A₀.powerset,
      ((-1 : ℂ) ^ (#A₀ - #B)) • latMult (gridSym (blockProd B) m) g := by
    funext x
    rw [cosetMult, hsym, latMult_sum_mul _ _ (fun B _ => integrableOn_gridSym hm _)
      (summable_of_finite_support hg), Finset.sum_apply]
    rfl
  rw [hfun]
  refine (eLpNorm_sum_le hP).trans ?_
  calc ∑ B ∈ A₀.powerset, eLpNorm (((-1 : ℂ) ^ (#A₀ - #B)) •
          latMult (gridSym (blockProd B) m) g) P Measure.count
      ≤ ∑ B ∈ A₀.powerset, K * eLpNorm g P Measure.count := by
        refine Finset.sum_le_sum fun B hB => ?_
        rw [eLpNorm_const_smul]
        simp only [enorm_pow, enorm_neg, enorm_one, one_pow, one_mul]
        exact hgrid B (Finset.mem_powerset.1 hB) g hg
    _ = 2 ^ #A₀ * K * eLpNorm g P Measure.count := by
        rw [Finset.sum_const, Finset.card_powerset, nsmul_eq_mul, mul_assoc]
        push_cast; rfl
/-- `100 ε Q_B ≤ 1` for `B ⊆ S`, `|B| ≤ k`, under the separation hypothesis (7.1); in particular
`ε/2 ≤ 1/(8 Q_B)`. -/
lemma hundred_eps_mul_blockProd_le {S B : Finset ℕ} (hBS : B ⊆ S) {k r : ℕ} (hBk : #B ≤ k)
    {ε : ℝ} (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹) :
    100 * ε * blockProd B ≤ 1 := by
  have hr := one_le_of_le_eps hε hεr
  have hq1 : 1 ≤ blockStar S := le_trans (by norm_num) (two_le_blockStar S)
  have hQ : (blockProd B : ℝ) ≤ (blockStar S : ℝ) ^ k := by
    exact_mod_cast (blockProd_le_pow hBS).trans (Nat.pow_le_pow_right hq1 hBk)
  have hqk : (0 : ℝ) < (blockStar S : ℝ) ^ k := by positivity
  have h3 : (blockStar S : ℝ) ^ k ≤ (blockStar S : ℝ) ^ (2 * r * k) :=
    pow_le_pow_right₀ (by exact_mod_cast hq1) (by nlinarith)
  have hr1 : (1 : ℝ) ≤ r := by exact_mod_cast hr
  have h2 : 100 * (blockStar S : ℝ) ^ k ≤ 100 * r * (blockStar S : ℝ) ^ (2 * r * k) := by
    nlinarith
  have hε' : ε ≤ (100 * (blockStar S : ℝ) ^ k)⁻¹ := hεr.trans (inv_anti₀ (by positivity) h2)
  calc 100 * ε * blockProd B ≤ 100 * (100 * (blockStar S : ℝ) ^ k)⁻¹ * (blockStar S : ℝ) ^ k := by
        gcongr
    _ = 1 := by field_simp

/-- A symbol supported in `[-ε/2, ε/2]ⁿ` is supported in `[-1/(8Q_B), 1/(8Q_B)]ⁿ` under (7.1),
as required by Blueprint Lemma 6.2 (`sampling_gridSym`). -/
lemma support_subset_gridBox {S B : Finset ℕ} (hS1 : ∀ q ∈ S, 1 < q) (hBS : B ⊆ S) {k r : ℕ}
    (hBk : #B ≤ k)
    {ε : ℝ} (hε : 0 < ε) (hεr : ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹)
    {m : EuclideanSpace ℝ (Fin n) → ℂ} (hsupp : Function.support m ⊆ {ξ | ∀ i, |ξ i| ≤ ε / 2}) :
    Function.support m ⊆ {ξ | ∀ i, |ξ i| ≤ 1 / (8 * (blockProd B : ℕ))} := by
  intro ξ hξ i
  have h := hundred_eps_mul_blockProd_le hBS hBk hε hεr
  have hQ : (0 : ℝ) < blockProd B := by
    have : 0 < blockProd B := blockProd_pos fun q hq => hS1 q (hBS hq)
    exact_mod_cast this
  refine (hsupp hξ i).trans ?_
  rw [le_div_iff₀ (by positivity)]
  nlinarith
/-! ### Vector-valued extension -/

/-- The additive subgroup `ℓ¹(ℤⁿ)` of `ℤⁿ → ℂ`. -/
def l1Subgroup (n : ℕ) : AddSubgroup ((Fin n → ℤ) → ℂ) where
  carrier := {g | Summable fun z => ‖g z‖}
  add_mem' {g h} hg hh := Summable.of_nonneg_of_le (fun _ => norm_nonneg _)
    (fun z => norm_add_le _ _) (Summable.add hg hh)
  zero_mem' := by simp only [Set.mem_ofPred_eq, Pi.zero_apply, norm_zero]; exact summable_zero
  neg_mem' {g} hg := by simpa only [Set.mem_ofPred_eq, Pi.neg_apply, norm_neg] using hg

/-- `M(D) 0 = 0`. -/
lemma latMult_zero (M : EuclideanSpace ℝ (Fin n) → ℂ) : latMult M 0 = 0 := by
  funext x; simp [latMult, latFT]

/-- A lattice multiplier with symbol integrable on the torus as an additive map on `ℓ¹`. -/
noncomputable def latMultHom {M : EuclideanSpace ℝ (Fin n) → ℂ}
    (hM : IntegrableOn M (torusCube n)) : l1Subgroup n →+ ((Fin n → ℤ) → ℂ) where
  toFun g := latMult M g
  map_zero' := latMult_zero M
  map_add' g h := latMult_add hM g.2 h.2

/-- Modulations preserve absolute values. -/
lemma norm_latModulate (β : EuclideanSpace ℝ (Fin n)) (g : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) :
    ‖latModulate β g x‖ = ‖g x‖ := by
  rw [latModulate, norm_mul, norm_eC, one_mul]

/-- The companion projections `P_{A₀,α} f` of `f ∈ ℓ¹` are in `ℓ¹`. -/
lemma summable_companionProj {S : Finset ℕ} [NeZero (blockProd S)] {ε : ℝ} (hε : 0 < ε)
    (hε4 : 4 * ε < 1) (A₀ : Finset ℕ) (α : Fin n → ZMod (blockProd S))
    {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) :
    Summable fun x => ‖companionProj S ε A₀ α f x‖ :=
  (latFT_latMult_of_continuous
    (continuous_cosetSymbol (continuous_cutoffEps ε) (c := 2 * ε) (by linarith)
      (cutoffEps_support hε) _)
    (cosetSymbol_add_latEmbed _ _)
    (summable_latKernel_cosetSymbol (contDiff_cutoffEps ε) (hasCompactSupport_cutoffEps hε) _)
    hf).1

/-- `‖(∑_{i ∈ s} |u_i|²)^{1/2}‖_{ℓ^{2r}}^{2r} = ∑_x (∑_{i ∈ s} |u_i(x)|²)^r`. -/
lemma eLpNorm_sqrt_sum_pow {ι : Type*} {r : ℕ} (hr : 0 < r) (s : Finset ι)
    (u : ι → (Fin n → ℤ) → ℂ) :
    eLpNorm (fun y => Real.sqrt (∑ i ∈ s, ‖u i y‖ ^ 2)) (ENNReal.ofReal (2 * r))
        Measure.count ^ (2 * r) = ∑' y, (∑ i ∈ s, ‖u i y‖ₑ ^ 2) ^ r := by
  rw [eLpNorm_count_pow_eq_tsum hr]
  refine tsum_congr fun y => ?_
  rw [enorm_sqrt_pow_two_mul (Finset.sum_nonneg fun _ _ => sq_nonneg _),
    ENNReal.ofReal_sum_of_nonneg fun _ _ => sq_nonneg _]
  simp_rw [enorm_pow_eq_ofReal]

/-- Blueprint Theorem 7.7 (`thm:IW`) at the endpoint `p = 2r`, with the constant written as
`ofReal C * ofReal A`. -/
theorem cosetMult_sigmaLe_bound_two_mul (n k : ℕ) {r : ℕ} (hr : 0 < r) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (S : Finset ℕ), (∀ q ∈ S, 1 < q) → (S : Set ℕ).Pairwise Nat.Coprime →
      ∀ [NeZero (blockProd S)] (ε : ℝ), 0 < ε →
      ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹ →
      ∀ (m : EuclideanSpace ℝ (Fin n) → ℂ) (B A : ℝ), AEStronglyMeasurable m volume →
      (∀ ξ, ‖m ξ‖ ≤ B) → Function.support m ⊆ {ξ | ∀ i, |ξ i| ≤ ε / 2} →
      (∀ F : 𝓢(EuclideanSpace ℝ (Fin n), ℂ),
        eLpNorm (𝓕⁻ (fun ξ => m ξ * 𝓕 (F : EuclideanSpace ℝ (Fin n) → ℂ) ξ))
          (ENNReal.ofReal (2 * r)) volume ≤
            ENNReal.ofReal A * eLpNorm F (ENNReal.ofReal (2 * r)) volume) →
      ∀ f : (Fin n → ℤ) → ℂ, (Function.support f).Finite →
        eLpNorm (cosetMult (blockProd S) m (sigmaLe S k) f) (ENNReal.ofReal (2 * r))
            Measure.count ≤
          ENNReal.ofReal C * ENNReal.ofReal A *
            eLpNorm f (ENNReal.ofReal (2 * r)) Measure.count := by
  obtain ⟨Cs, hCs, hsamp⟩ := sampling_gridSym n
  set KMZ := khintchineUpperConst (2 * r) / khintchineLowerConst (2 * r) with hKMZ_def
  have hKMZ : 0 ≤ KMZ := div_nonneg (khintchineUpperConst_pos (by positivity)).le
    (khintchineLowerConst_pos _).le
  set L : ℝ := KMZ * 2 ^ k * Cs with hL_def
  have hL : 0 ≤ L := by positivity
  set Cenn : ℝ≥0∞ := ENNReal.ofReal (normDescConst k r) ^ (1 / (2 * r : ℝ)) * ENNReal.ofReal L *
      ENNReal.ofReal (companionConst n k (2 * r)) ^ (1 / (2 * r : ℝ)) with hCenn_def
  have hCenn : Cenn ≠ ⊤ := by
    refine ENNReal.mul_ne_top (ENNReal.mul_ne_top ?_ ENNReal.ofReal_ne_top) ?_ <;>
      exact ENNReal.rpow_ne_top_of_nonneg (by positivity) ENNReal.ofReal_ne_top
  refine ⟨Cenn.toReal, ENNReal.toReal_nonneg, ?_⟩
  intro S hS1 hS _ ε hε hεr m Bm A hm hBm hsupp hA f hf
  rw [ENNReal.ofReal_toReal hCenn]
  have hr2 : (1 : ℝ) ≤ 2 * r := by
    have : (1 : ℝ) ≤ r := by exact_mod_cast hr
    linarith
  have hmi : Integrable m := integrable_of_bound_of_support_subset hm hBm (by positivity) hsupp
  have hmε : ∀ η, m η ≠ 0 → ∀ i, |η i| ≤ ε / 2 := fun η h => hsupp h
  have hε4 := four_eps_lt_one S hε hεr
  have hfs := summable_of_finite_support hf
  have hP1 : 1 ≤ ENNReal.ofReal (2 * r) := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hr2
  -- the full-grid operators (Lemma 6.2)
  have hgrid : ∀ A₀ ∈ S.powerset.filter (fun A₀ => #A₀ ≤ k), ∀ B ⊆ A₀,
      ∀ g : (Fin n → ℤ) → ℂ, (Function.support g).Finite →
        eLpNorm (latMult (gridSym (blockProd B) m) g) (ENNReal.ofReal (2 * r)) Measure.count ≤
          ENNReal.ofReal (Cs * A) * eLpNorm g (ENNReal.ofReal (2 * r)) Measure.count := by
    intro A₀ hA₀ B hB g hg
    obtain ⟨h1, h2⟩ := Finset.mem_filter.1 hA₀
    have hBS := hB.trans (Finset.mem_powerset.1 h1)
    exact hsamp (2 * r) hr2 (blockProd B) (blockProd_pos fun q hq => hS1 q (hBS hq)) m Bm A hm
      hBm (support_subset_gridBox hS1 hBS ((Finset.card_le_card hB).trans h2) hε hεr hsupp) hA g hg
  -- `T_{m;Σ_{A₀}}` on `ℓ¹` inputs
  have hTA : ∀ A₀ ∈ S.powerset.filter (fun A₀ => #A₀ ≤ k), ∀ g : l1Subgroup n,
      eLpNorm (cosetMult (blockProd S) m (sigmaBlock S A₀) g) (ENNReal.ofReal (2 * r))
          Measure.count ≤
        (2 ^ k * ENNReal.ofReal (Cs * A)) *
          eLpNorm (g : (Fin n → ℤ) → ℂ) (ENNReal.ofReal (2 * r)) Measure.count := by
    intro A₀ hA₀ g
    obtain ⟨h1, h2⟩ := Finset.mem_filter.1 hA₀
    refine eLpNorm_latMult_le_of_finite (integrableOn_cosetSymbol hmi _) (fun g' hg' => ?_) g.2
    refine (eLpNorm_cosetMult_sigmaBlock_le hS (Finset.mem_powerset.1 h1) hmi hP1
      (hgrid A₀ hA₀) hg').trans ?_
    gcongr
    norm_num
  -- the vector-valued extension (Lemma 2.6) for each core
  have hconst : ∀ A' : ℝ≥0, (A' : ℝ≥0∞) = 2 ^ k * ENNReal.ofReal (Cs * A) →
      ENNReal.ofReal KMZ * A' = ENNReal.ofReal L * ENNReal.ofReal A := by
    intro A' hA'
    rw [hA', hL_def, ENNReal.ofReal_mul (p := Cs) (q := A) hCs.le,
      ENNReal.ofReal_mul (p := KMZ * 2 ^ k) (q := Cs) (by positivity),
      ENNReal.ofReal_mul (p := KMZ) (q := 2 ^ k) hKMZ, ENNReal.ofReal_pow (by norm_num),
      ENNReal.ofReal_ofNat]
    ring
  have hcore : ∀ A₀ ∈ S.powerset.filter (fun A₀ => #A₀ ≤ k),
      ∑' x, (∑ α ∈ sigmaUpper S k A₀, ‖cosetMult (blockProd S) m (cosetSet S A₀ α) f x‖ₑ ^ 2) ^ r
        ≤ (ENNReal.ofReal L * ENNReal.ofReal A) ^ (2 * r) *
          ∑' x, (∑ α ∈ sigmaUpper S k A₀, ‖companionProj S ε A₀ α f x‖ₑ ^ 2) ^ r := by
    intro A₀ hA₀
    set A' : ℝ≥0 := Real.toNNReal (2 ^ k * (Cs * A)) with hA'_def
    have hA' : (A' : ℝ≥0∞) = 2 ^ k * ENNReal.ofReal (Cs * A) := by
      rw [show (A' : ℝ≥0∞) = ENNReal.ofReal (2 ^ k * (Cs * A)) from rfl,
        ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_pow (by norm_num), ENNReal.ofReal_ofNat]
    set T := latMultHom (integrableOn_cosetSymbol hmi (sigmaBlock S A₀) (Q := blockProd S))
      with hT
    set u : (Fin n → ZMod (blockProd S)) → l1Subgroup n := fun α =>
      ⟨latModulate (-ratPt (blockProd S) α) (companionProj S ε A₀ α f), by
        show Summable _
        simpa only [norm_latModulate] using summable_companionProj hε hε4 A₀ α hfs⟩ with hu_def
    have hmz := marcinkiewicz_zygmund_square_function ℂ ℂ (l1Subgroup n) T (p := 2 * r)
      (by positivity) A' (fun g => by rw [hA']; exact hTA A₀ hA₀ g) (sigmaUpper S k A₀) u
      (fun _ _ => AEStronglyMeasurable.of_discrete) (fun _ _ => AEStronglyMeasurable.of_discrete)
    have hTu : ∀ α ∈ sigmaUpper S k A₀, ∀ y,
        ‖T (u α) y‖ = ‖cosetMult (blockProd S) m (cosetSet S A₀ α) f y‖ := by
      intro α hα y
      rw [cosetMult_cosetSet_eq_modulate hS1 hS hε hεr hmε hα hfs, norm_latModulate]
      rfl
    have hu : ∀ α x, ‖(u α : (Fin n → ℤ) → ℂ) x‖ = ‖companionProj S ε A₀ α f x‖ :=
      fun α x => norm_latModulate _ _ _
    have e1 : (fun y => Real.sqrt (∑ α ∈ sigmaUpper S k A₀, ‖T (u α) y‖ ^ 2)) =
        fun y => Real.sqrt (∑ α ∈ sigmaUpper S k A₀,
          ‖cosetMult (blockProd S) m (cosetSet S A₀ α) f y‖ ^ 2) :=
      funext fun y => by
        congr 1; exact Finset.sum_congr rfl fun α hα => by rw [hTu α hα y]
    have e2 : (fun x => Real.sqrt (∑ α ∈ sigmaUpper S k A₀,
          ‖(u α : (Fin n → ℤ) → ℂ) x‖ ^ 2)) =
        fun x => Real.sqrt (∑ α ∈ sigmaUpper S k A₀, ‖companionProj S ε A₀ α f x‖ ^ 2) :=
      funext fun x => by
        congr 1; exact Finset.sum_congr rfl fun α _ => by rw [hu α x]
    rw [e1, e2, <- hKMZ_def, hconst A' hA'] at hmz
    have h2 := pow_le_pow_left₀ zero_le hmz (2 * r)
    rw [mul_pow, eLpNorm_sqrt_sum_pow hr (sigmaUpper S k A₀)
        (fun α => cosetMult (blockProd S) m (cosetSet S A₀ α) f),
      eLpNorm_sqrt_sum_pow hr (sigmaUpper S k A₀) (fun α => companionProj S ε A₀ α f)] at h2
    exact h2
  -- combine: Lemma 7.5, the vector-valued bound, and Lemma 7.6
  have hmain : ∑' x, ‖cosetMult (blockProd S) m (sigmaLe S k) f x‖ₑ ^ (2 * r) ≤
      ENNReal.ofReal (normDescConst k r) * ((ENNReal.ofReal L * ENNReal.ofReal A) ^ (2 * r) *
        (ENNReal.ofReal (companionConst n k (2 * r)) * ∑' x, ‖f x‖ₑ ^ (2 * r))) := by
    refine (normdescription_cosetMult hS1 hS hr hε hεr hmi hmε hfs).trans ?_
    gcongr
    calc ∑ A₀ ∈ S.powerset with #A₀ ≤ k, ∑' x, (∑ α ∈ sigmaUpper S k A₀,
            ‖cosetMult (blockProd S) m (cosetSet S A₀ α) f x‖ₑ ^ 2) ^ r
        ≤ ∑ A₀ ∈ S.powerset with #A₀ ≤ k, (ENNReal.ofReal L * ENNReal.ofReal A) ^ (2 * r) *
            ∑' x, (∑ α ∈ sigmaUpper S k A₀, ‖companionProj S ε A₀ α f x‖ₑ ^ 2) ^ r :=
          Finset.sum_le_sum hcore
      _ = (ENNReal.ofReal L * ENNReal.ofReal A) ^ (2 * r) * ∑ A₀ ∈ S.powerset with #A₀ ≤ k,
            ∑' x, (∑ α ∈ sigmaUpper S k A₀, ‖companionProj S ε A₀ α f x‖ₑ ^ 2) ^ r :=
          (Finset.mul_sum _ _ _).symm
      _ ≤ _ := by
          gcongr
          exact companion_estimate_nat hS1 hS hε hεr hr hf
  have hroot : ∀ x : ℝ≥0∞, (x ^ (1 / (2 * r : ℝ))) ^ (2 * r) = x := fun x => by
    rw [← ENNReal.rpow_natCast, ← ENNReal.rpow_mul]
    push_cast
    rw [one_div_mul_cancel (by positivity), ENNReal.rpow_one]
  rw [← ENNReal.pow_le_pow_left_iff (n := 2 * r) (by omega), eLpNorm_count_pow_eq_tsum hr,
    mul_pow, mul_pow, eLpNorm_count_pow_eq_tsum hr]
  refine hmain.trans (le_of_eq ?_)
  simp only [hCenn_def, mul_pow, hroot]
  ring
/-! ### Duality -/

/-- The reflection-conjugation `g ↦ ḡ(-·)` on `ℤⁿ`. -/
noncomputable def latReflect (g : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) : ℂ := conj (g (-x))

/-- `(R g)^ = conj ĝ` for `R g = ḡ(-·)`. -/
lemma latFT_latReflect (g : (Fin n → ℤ) → ℂ) (ξ : EuclideanSpace ℝ (Fin n)) :
    latFT (latReflect g) ξ = conj (latFT g ξ) := by
  unfold latFT latReflect
  rw [Complex.conj_tsum, ← (Equiv.neg (Fin n → ℤ)).tsum_eq]
  refine tsum_congr fun z => ?_
  simp only [Equiv.neg_apply, neg_neg, map_mul, conj_eC, latEmbed_neg, inner_neg_left]

/-- `R` preserves finite support. -/
lemma support_latReflect_finite {g : (Fin n → ℤ) → ℂ} (hg : (Function.support g).Finite) :
    (Function.support (latReflect g)).Finite := by
  refine (hg.preimage (f := fun x : Fin n → ℤ => -x) neg_injective.injOn).subset fun x hx => ?_
  simp only [Function.mem_support, latReflect, ne_eq, map_eq_zero] at hx
  exact hx

/-- `(M̄)(D) g = R (M(D) (R g))` with `R g = ḡ(-·)`. -/
lemma latMult_conj_eq_latReflect (M : EuclideanSpace ℝ (Fin n) → ℂ) (g : (Fin n → ℤ) → ℂ) :
    latMult (fun ξ => conj (M ξ)) g = latReflect (latMult M (latReflect g)) := by
  funext x
  simp only [latReflect, latMult, latFT_latReflect]
  rw [← integral_conj]
  congr 1; funext ξ
  simp only [map_mul, Complex.conj_conj, conj_eC, latEmbed_neg, inner_neg_left, neg_neg]

/-- `R` is an isometry of `ℓ^p(ℤⁿ)`. -/
lemma eLpNorm_latReflect (g : (Fin n → ℤ) → ℂ) {p : ℝ} (hp : 0 < p) :
    eLpNorm (latReflect g) (ENNReal.ofReal p) Measure.count =
      eLpNorm g (ENNReal.ofReal p) Measure.count := by
  rw [eLpNorm_ofReal_eq_lintegral AEStronglyMeasurable.of_discrete hp,
    eLpNorm_ofReal_eq_lintegral AEStronglyMeasurable.of_discrete hp, lintegral_count,
    lintegral_count, ← (Equiv.neg (Fin n → ℤ)).tsum_eq]
  congr 1
  refine tsum_congr fun x => ?_
  simp [latReflect]

/-- The pairing `∑_x M(D) f(x) ḡ(x) = ∫_{𝕋ⁿ} M f̂ ĝ̄` for `f ∈ ℓ¹` and finitely supported `g`. -/
lemma tsum_latMult_mul_conj {M : EuclideanSpace ℝ (Fin n) → ℂ}
    (hM : IntegrableOn M (torusCube n)) {f g : (Fin n → ℤ) → ℂ}
    (hf : Summable fun z => ‖f z‖) (hg : (Function.support g).Finite) :
    ∑' x, latMult M f x * conj (g x) =
      ∫ ξ in torusCube n, M ξ * latFT f ξ * conj (latFT g ξ) := by
  set T := hg.toFinset
  have hT : ∀ z ∉ T, g z = 0 := fun z hz => by
    simpa [T] using hz
  rw [tsum_eq_sum (s := T) fun x hx => by rw [hT x hx, map_zero, mul_zero]]
  have hint : ∀ x ∈ T, IntegrableOn
      (fun ξ => M ξ * latFT f ξ * eC (inner ℝ (latEmbed x) ξ) * conj (g x)) (torusCube n) := by
    intro x _
    have : IntegrableOn (fun ξ => M ξ * (latFT f ξ * eC (inner ℝ (latEmbed x) ξ) * conj (g x)))
        (torusCube n) := hM.mul_bdd (c := (∑' z, ‖f z‖) * ‖g x‖)
      ((((continuous_latFT hf).mul (by fun_prop [continuous_eC])).mul
        continuous_const).aestronglyMeasurable)
      (Filter.Eventually.of_forall fun ξ => by
        rw [norm_mul, norm_mul, norm_eC, mul_one, Complex.norm_conj]
        exact mul_le_mul_of_nonneg_right (norm_latFT_le hf ξ) (norm_nonneg _))
    refine this.congr (Filter.Eventually.of_forall fun ξ => ?_)
    simp only; ring
  have e1 : ∀ x ∈ T, latMult M f x * conj (g x) =
      ∫ ξ in torusCube n, M ξ * latFT f ξ * eC (inner ℝ (latEmbed x) ξ) * conj (g x) := by
    intro x _
    rw [latMult, integral_mul_const]
  rw [Finset.sum_congr rfl e1, ← integral_finsetSum _ hint]
  congr 1; funext ξ
  rw [latFT_eq_sum hT, map_sum, Finset.mul_sum]
  refine Finset.sum_congr rfl fun x _ => ?_
  rw [map_mul, conj_eC]
  simp only [neg_neg]
  ring
/-- The adjoint of `M(D)` on finitely supported sequences is `M̄(D)`. -/
lemma tsum_latMult_mul_conj_eq {M : EuclideanSpace ℝ (Fin n) → ℂ}
    (hM : IntegrableOn M (torusCube n)) {f g : (Fin n → ℤ) → ℂ}
    (hf : (Function.support f).Finite) (hg : (Function.support g).Finite) :
    ∑' x, latMult M f x * conj (g x) =
      ∑' x, f x * conj (latMult (fun ξ => conj (M ξ)) g x) := by
  have hMc : IntegrableOn (fun ξ => conj (M ξ)) (torusCube n) :=
    Complex.conjCLE.toContinuousLinearMap.integrable_comp hM
  have h1 := tsum_latMult_mul_conj hMc (summable_of_finite_support hg) hf
  have h2 : ∑' x, f x * conj (latMult (fun ξ => conj (M ξ)) g x) =
      conj (∑' x, latMult (fun ξ => conj (M ξ)) g x * conj (f x)) := by
    rw [Complex.conj_tsum]
    refine tsum_congr fun x => ?_
    rw [map_mul, Complex.conj_conj, mul_comm]
  rw [h2, h1, ← integral_conj, tsum_latMult_mul_conj hM (summable_of_finite_support hf) hg]
  congr 1; funext ξ
  simp only [map_mul, Complex.conj_conj]
  ring

/-- `∫ h dcount = ∑' h` on `ℤⁿ` for integrable `h`. -/
lemma integral_count_eq_tsum {h : (Fin n → ℤ) → ℂ} (hh : Integrable h Measure.count) :
    ∫ x, h x ∂Measure.count = ∑' x, h x := by
  rw [integral_countable hh]
  simp

/-- Duality: an `ℓ^q` bound `K` for `M(D)` on finitely supported inputs gives the same bound for
`M(D)` on `ℓ^p`, `1/p + 1/q = 1`, on finitely supported inputs (the adjoint is
`M̄(D) = R M(D) R` with the isometry `R g = ḡ(-·)`). -/
lemma eLpNorm_latMult_le_of_dual {M : EuclideanSpace ℝ (Fin n) → ℂ}
    (hM : IntegrableOn M (torusCube n)) {p q : ℝ} (hpq : p.HolderConjugate q) {K : ℝ≥0∞}
    (hK : ∀ g : (Fin n → ℤ) → ℂ, (Function.support g).Finite →
      eLpNorm (latMult M g) (ENNReal.ofReal q) Measure.count ≤
        K * eLpNorm g (ENNReal.ofReal q) Measure.count)
    {f : (Fin n → ℤ) → ℂ} (hf : (Function.support f).Finite) :
    eLpNorm (latMult M f) (ENNReal.ofReal p) Measure.count ≤
      K * eLpNorm f (ENNReal.ofReal p) Measure.count := by
  refine eLpNorm_le_of_dual_test hpq AEStronglyMeasurable.of_discrete
    fun g _ _ hgs hgq hgi => ?_
  have hg : (Function.support g).Finite := Measure.count_apply_lt_top.1 hgs
  have hfi : Integrable (fun x => f x * conj (latMult (fun ξ => conj (M ξ)) g x))
      Measure.count := by
    refine integrable_count_iff.2 (summable_of_finite_support (hf.subset fun x hx => ?_))
    simp only [Function.mem_support, ne_eq] at hx ⊢
    exact left_ne_zero_of_mul hx
  rw [integral_count_eq_tsum hgi, tsum_latMult_mul_conj_eq hM hf hg,
    ← integral_count_eq_tsum hfi]
  refine (enorm_integral_mul_conj_le hpq AEStronglyMeasurable.of_discrete
    AEStronglyMeasurable.of_discrete).trans ?_
  rw [latMult_conj_eq_latReflect, eLpNorm_latReflect _ hpq.symm.pos, mul_comm]
  gcongr
  refine (hK _ (support_latReflect_finite hg)).trans ?_
  rw [eLpNorm_latReflect _ hpq.symm.pos]
  calc K * eLpNorm g (ENNReal.ofReal q) Measure.count ≤ K * 1 := by gcongr
    _ = K := mul_one K
/-- Blueprint Theorem 7.7 (`thm:IW`, "Rational-frequency transference"). Let `n, k ∈ ℕ`,
`r ≥ 1` and `(2r)' = 2r/(2r-1) ≤ p ≤ 2r`. There is a constant `C = C(n,k,r,p) ≥ 0` such that the
following holds. Let `S` be a finite set of pairwise coprime integers `> 1`, let
`0 < ε ≤ (100 r q_*^{2rk})⁻¹` (eq. (7.1)), and let `m : E → ℂ` be a bounded (`|m| ≤ B`)
measurable symbol supported in `[-ε/2, ε/2]ⁿ` whose Euclidean `L^{2r}` multiplier norm is at
most `A` (tested on Schwartz functions). Then for every finitely supported `f : ℤⁿ → ℂ`,
`‖T_{m;Σ_{≤k}} f‖_{ℓ^p} ≤ C A ‖f‖_{ℓ^p}`, where `T_{m;Σ_{≤k}} = cosetMult Q_S m Σ_{≤k}` is the
lattice multiplier with symbol `∑_{β ∈ Σ_{≤k}} m_per(ξ - β)`. The constant does not depend on
`S`, `ε`, `m`, `B`, `A` or `f`. -/
theorem coprime_block_multiplier_transference (n k r : ℕ) (hr : 1 ≤ r) {p : ℝ}
    (hp1 : (2 * r : ℝ) / (2 * r - 1) ≤ p) (hp2 : p ≤ 2 * r) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (S : Finset ℕ), (∀ q ∈ S, 1 < q) → (S : Set ℕ).Pairwise Nat.Coprime →
      ∀ [NeZero (blockProd S)] (ε : ℝ), 0 < ε →
      ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹ →
      ∀ (m : EuclideanSpace ℝ (Fin n) → ℂ) (B A : ℝ), AEStronglyMeasurable m volume →
      (∀ ξ, ‖m ξ‖ ≤ B) → Function.support m ⊆ {ξ | ∀ i, |ξ i| ≤ ε / 2} →
      (∀ F : 𝓢(EuclideanSpace ℝ (Fin n), ℂ),
        eLpNorm (𝓕⁻ (fun ξ => m ξ * 𝓕 (F : EuclideanSpace ℝ (Fin n) → ℂ) ξ))
          (ENNReal.ofReal (2 * r)) volume ≤
            ENNReal.ofReal A * eLpNorm F (ENNReal.ofReal (2 * r)) volume) →
      ∀ f : (Fin n → ℤ) → ℂ, (Function.support f).Finite →
        eLpNorm (cosetMult (blockProd S) m (sigmaLe S k) f) (ENNReal.ofReal p) Measure.count ≤
          ENNReal.ofReal (C * A) * eLpNorm f (ENNReal.ofReal p) Measure.count := by
  obtain ⟨C₁, hC₁, h2r⟩ := cosetMult_sigmaLe_bound_two_mul n k (r := r) hr
  have hb1 : (1 : ℝ) < 2 * r := by
    have : (1 : ℝ) ≤ r := by exact_mod_cast hr
    linarith
  set a : ℝ := (2 * r : ℝ) / (2 * r - 1) with ha_def
  have hconj : a.HolderConjugate (2 * r) := (Real.HolderConjugate.conjExponent hb1).symm
  have ha0 : 0 < a := hconj.pos
  -- the two endpoint bounds, for fixed data
  have hend : ∀ (S : Finset ℕ), (∀ q ∈ S, 1 < q) → (S : Set ℕ).Pairwise Nat.Coprime →
      ∀ [NeZero (blockProd S)] (ε : ℝ), 0 < ε →
      ε ≤ (100 * r * (blockStar S : ℝ) ^ (2 * r * k))⁻¹ →
      ∀ (m : EuclideanSpace ℝ (Fin n) → ℂ) (B A : ℝ), AEStronglyMeasurable m volume →
      (∀ ξ, ‖m ξ‖ ≤ B) → Function.support m ⊆ {ξ | ∀ i, |ξ i| ≤ ε / 2} →
      (∀ F : 𝓢(EuclideanSpace ℝ (Fin n), ℂ),
        eLpNorm (𝓕⁻ (fun ξ => m ξ * 𝓕 (F : EuclideanSpace ℝ (Fin n) → ℂ) ξ))
          (ENNReal.ofReal (2 * r)) volume ≤
            ENNReal.ofReal A * eLpNorm F (ENNReal.ofReal (2 * r)) volume) →
      ∀ t ∈ ({a, (2 * r : ℝ)} : Set ℝ), ∀ f : (Fin n → ℤ) → ℂ, (Function.support f).Finite →
        eLpNorm (cosetMult (blockProd S) m (sigmaLe S k) f) (ENNReal.ofReal t) Measure.count ≤
          ENNReal.ofReal C₁ * ENNReal.ofReal A * eLpNorm f (ENNReal.ofReal t) Measure.count := by
    intro S hS1 hS _ ε hε hεr m B A hm hB hsupp hA t ht f hf
    rcases ht with rfl | rfl
    · have hmi : Integrable m := integrable_of_bound_of_support_subset hm hB (by positivity) hsupp
      exact eLpNorm_latMult_le_of_dual (integrableOn_cosetSymbol hmi _) hconj
        (fun g hg => h2r S hS1 hS ε hε hεr m B A hm hB hsupp hA g hg) hf
    · exact h2r S hS1 hS ε hε hεr m B A hm hB hsupp hA f hf
  rcases eq_or_lt_of_le hp2 with rfl | hpb
  · refine ⟨C₁, hC₁, fun S hS1 hS _ ε hε hεr m B A hm hB hsupp hA f hf => ?_⟩
    rw [ENNReal.ofReal_mul hC₁]
    exact hend S hS1 hS ε hε hεr m B A hm hB hsupp hA _ (by simp) f hf
  rcases eq_or_lt_of_le hp1 with rfl | hap
  · refine ⟨C₁, hC₁, fun S hS1 hS _ ε hε hεr m B A hm hB hsupp hA f hf => ?_⟩
    rw [ENNReal.ofReal_mul hC₁]
    exact hend S hS1 hS ε hε hεr m B A hm hB hsupp hA _ (by simp) f hf
  -- interior exponents: Marcinkiewicz interpolation
  set θ : ℝ := (1 / a - 1 / p) / (1 / a - 1 / (2 * r)) with hθ_def
  have hp0 : 0 < p := ha0.trans hap
  have hab : 1 / (2 * r : ℝ) < 1 / a := one_div_lt_one_div_of_lt ha0 (hap.trans hpb)
  have hθ0 : 0 ≤ θ := by
    refine div_nonneg (sub_nonneg.2 (one_div_le_one_div_of_le ha0 hap.le)) (by linarith)
  have hθ1 : θ ≤ 1 := by
    rw [hθ_def, div_le_one (by linarith)]
    have : 1 / (2 * r : ℝ) ≤ 1 / p := one_div_le_one_div_of_le hp0 hpb.le
    linarith
  have hθ : 1 / p = (1 - θ) / a + θ / (2 * r) := by
    have h1 : 1 / a - 1 / (2 * r : ℝ) ≠ 0 := by linarith
    have e : (1 - θ) / a + θ / (2 * r) = 1 / a - θ * (1 / a - 1 / (2 * r : ℝ)) := by ring
    rw [e, hθ_def, div_mul_cancel₀ _ h1]
    ring
  set Cm : ℝ := (marcinkiewiczConst a (2 * r) p : ℝ) with hCm
  refine ⟨Cm * C₁, mul_nonneg (NNReal.coe_nonneg _) hC₁,
    fun S hS1 hS _ ε hε hεr m B A hm hB hsupp hA f hf => ?_⟩
  have hmi : Integrable m := integrable_of_bound_of_support_subset hm hB (by positivity) hsupp
  have hMi := integrableOn_cosetSymbol hmi (sigmaLe S k) (Q := blockProd S)
  set D : Set ((Fin n → ℤ) → ℂ) := {g | (Function.support g).Finite} with hD
  set T := cosetMult (n := n) (blockProd S) m (sigmaLe S k) with hT
  set A' : ℝ≥0 := Real.toNNReal (C₁ * A) with hA'
  have hA'e : (A' : ℝ≥0∞) = ENNReal.ofReal C₁ * ENNReal.ofReal A := by
    rw [show (A' : ℝ≥0∞) = ENNReal.ofReal (C₁ * A) from rfl, ENNReal.ofReal_mul hC₁]
  have hstrong : ∀ t ∈ ({a, (2 * r : ℝ)} : Set ℝ), HasStrongTypeOn T D t A' Measure.count
      Measure.count := by
    intro t ht g hg
    rw [hA'e]
    exact hend S hS1 hS ε hε hεr m B A hm hB hsupp hA t ht g hg
  have hsub : IsSublinearOn T D Measure.count := by
    intro g hg h hh
    refine Filter.Eventually.of_forall fun x => ?_
    rw [hT, cosetMult, latMult_add hMi (summable_of_finite_support hg)
      (summable_of_finite_support hh)]
    exact norm_add_le _ _
  have htr : IsTruncationClosed D := by
    intro g hg s _
    have hsub' : ∀ s' : Set (Fin n → ℤ), Function.support (s'.indicator g) ⊆ Function.support g :=
      fun s' x hx => by
        rw [Function.mem_support] at hx ⊢; intro h0; exact hx (by simp [h0])
    exact ⟨hg.subset (hsub' _), hg.subset (hsub' _)⟩
  have key := eLpNorm_le_of_hasWeakTypeOn (μ := Measure.count) (ν := Measure.count) ha0 hap hpb
    hθ ((hstrong a (by simp)).hasWeakTypeOn ha0)
    ((hstrong (2 * r : ℝ) (by simp)).hasWeakTypeOn (by linarith)) hsub htr (show f ∈ D from hf)
    AEStronglyMeasurable.of_discrete AEStronglyMeasurable.of_discrete
  refine key.trans (le_of_eq ?_)
  rw [mul_assoc (marcinkiewiczConst a (2 * r) p : ℝ≥0∞), ← ENNReal.rpow_add_of_nonneg _ _
    (by linarith) hθ0, sub_add_cancel, ENNReal.rpow_one, hA'e, hCm,
    ENNReal.ofReal_mul (mul_nonneg (NNReal.coe_nonneg _) hC₁),
    ENNReal.ofReal_mul (NNReal.coe_nonneg _), ENNReal.ofReal_coe_nnreal]
  ring


end RationalTransference

section GoodSet

/-! ### Blueprint Construction 7.8 (`con:goodset`) -/

/-- `N₀ = ⌈N^{ρ/4}⌉` of Blueprint Construction 7.8 (`con:goodset`). -/
noncomputable def goodN0 (ρ : ℝ) (N : ℕ) : ℕ := ⌈(N : ℝ) ^ (ρ / 4)⌉₊

/-- `Q₀ = ∏_{p ≤ N₀ prime} p^{⌊log_p N⌋}` of Blueprint Construction 7.8 (`con:goodset`). -/
noncomputable def goodQ0 (ρ : ℝ) (N : ℕ) : ℕ :=
  ∏ p ∈ (range (goodN0 ρ N + 1)).filter Nat.Prime, p ^ Nat.log p N

/-- The large primes `N₀ < p ≤ N` of Blueprint Construction 7.8 (`con:goodset`). -/
noncomputable def goodLargePrimes (ρ : ℝ) (N : ℕ) : Finset ℕ :=
  (Ioc (goodN0 ρ N) N).filter Nat.Prime

/-- The blocks of Blueprint Construction 7.8 (`con:goodset`): `Q₀` (when `Q₀ > 1`) and
`p^{⌊log_p N⌋}` for every prime `N₀ < p ≤ N`. -/
noncomputable def goodBlocks (ρ : ℝ) (N : ℕ) : Finset ℕ :=
  (if 1 < goodQ0 ρ N then {goodQ0 ρ N} else ∅) ∪
    (goodLargePrimes ρ N).image fun p => p ^ Nat.log p N

/-- `k = ⌈4/ρ⌉ + 1` of Blueprint Construction 7.8 (`con:goodset`). -/
noncomputable def goodK (ρ : ℝ) : ℕ := ⌈4 / ρ⌉₊ + 1

lemma mem_goodLargePrimes {ρ : ℝ} {N p : ℕ} :
    p ∈ goodLargePrimes ρ N ↔ (goodN0 ρ N < p ∧ p ≤ N) ∧ p.Prime := by
  simp [goodLargePrimes]

lemma mem_goodBlocks {ρ : ℝ} {N b : ℕ} :
    b ∈ goodBlocks ρ N ↔ (b = goodQ0 ρ N ∧ 1 < goodQ0 ρ N) ∨
      ∃ p ∈ goodLargePrimes ρ N, p ^ Nat.log p N = b := by
  unfold goodBlocks
  split_ifs with h <;> simp [h]

/-- For a prime `p ≤ N`, the block `p^{⌊log_p N⌋}` is `> 1`. -/
lemma one_lt_pow_log_of_prime {p N : ℕ} (hp : p.Prime) (hpN : p ≤ N) :
    1 < p ^ Nat.log p N := by
  have h1 : 1 ≤ Nat.log p N := Nat.le_log_of_pow_le hp.one_lt (by simpa using hpN)
  exact Nat.one_lt_pow (by omega) hp.one_lt

lemma goodQ0_pos (ρ : ℝ) (N : ℕ) : 0 < goodQ0 ρ N :=
  Finset.prod_pos fun _ hp => pow_pos (Finset.mem_filter.1 hp).2.pos _

/-- Blueprint Construction 7.8 (`con:goodset`): the blocks are integers `> 1`. -/
theorem goodBlocks_one_lt {ρ : ℝ} {N : ℕ} : ∀ b ∈ goodBlocks ρ N, 1 < b := by
  intro b hb
  rcases mem_goodBlocks.1 hb with ⟨rfl, h⟩ | ⟨p, hp, rfl⟩
  · exact h
  · obtain ⟨⟨_, hpN⟩, hpp⟩ := mem_goodLargePrimes.1 hp
    exact one_lt_pow_log_of_prime hpp hpN

/-- A prime `p > N₀` gives a block coprime to `Q₀`. -/
lemma coprime_pow_goodQ0 {ρ : ℝ} {N p e : ℕ} (hp : p.Prime) (hpN0 : goodN0 ρ N < p) :
    Nat.Coprime (p ^ e) (goodQ0 ρ N) := by
  refine Nat.Coprime.prod_right fun p' hp' => ?_
  obtain ⟨hp'r, hp'p⟩ := Finset.mem_filter.1 hp'
  have hne : p ≠ p' := by
    have := Finset.mem_range.1 hp'r
    omega
  exact Nat.Coprime.pow _ _ ((Nat.coprime_primes hp hp'p).2 hne)

/-- Blueprint Construction 7.8 (`con:goodset`): the blocks are pairwise coprime. -/
theorem goodBlocks_pairwise_coprime {ρ : ℝ} {N : ℕ} :
    ((goodBlocks ρ N : Finset ℕ) : Set ℕ).Pairwise Nat.Coprime := by
  intro x hx y hy hxy
  rcases mem_goodBlocks.1 hx with ⟨rfl, _⟩ | ⟨p, hp, rfl⟩ <;>
    rcases mem_goodBlocks.1 hy with ⟨rfl, _⟩ | ⟨p', hp', rfl⟩
  · exact absurd rfl hxy
  · obtain ⟨⟨h1, _⟩, hpp⟩ := mem_goodLargePrimes.1 hp'
    exact (coprime_pow_goodQ0 hpp h1).symm
  · obtain ⟨⟨h1, _⟩, hpp⟩ := mem_goodLargePrimes.1 hp
    exact coprime_pow_goodQ0 hpp h1
  · obtain ⟨_, hpp⟩ := mem_goodLargePrimes.1 hp
    obtain ⟨_, hpp'⟩ := mem_goodLargePrimes.1 hp'
    have hne : p ≠ p' := fun h => hxy (h ▸ rfl)
    exact Nat.Coprime.pow _ _ ((Nat.coprime_primes hpp hpp').2 hne)

instance neZero_blockProd_goodBlocks (ρ : ℝ) (N : ℕ) : NeZero (blockProd (goodBlocks ρ N)) :=
  neZero_blockProd goodBlocks_one_lt

/-- `𝒰_N = Σ_{≤k}` for the blocks of Blueprint Construction 7.8 (`con:goodset`). -/
noncomputable def goodSet (ρ : ℝ) (N : ℕ) : Finset (Fin n → ZMod (blockProd (goodBlocks ρ N))) :=
  sigmaLe (goodBlocks ρ N) (goodK ρ)

/-- Blueprint Construction 7.8 (`con:goodset`): every `1 ≤ q ≤ N` divides `Q_S`, the product of
all blocks (so `T[q] ⊆ T[Q_S]`). -/
theorem dvd_blockProd_goodBlocks (ρ : ℝ) {N q : ℕ} (hq1 : 1 ≤ q) (hqN : q ≤ N) :
    q ∣ blockProd (goodBlocks ρ N) := by
  rw [Nat.dvd_iff_prime_pow_dvd_dvd]
  intro p a hp hpa
  rcases Nat.eq_zero_or_pos a with rfl | ha
  · simp
  have hle : p ^ a ≤ N := (Nat.le_of_dvd hq1 hpa).trans hqN
  have hal : a ≤ Nat.log p N := Nat.le_log_of_pow_le hp.one_lt hle
  have hpN : p ≤ N := (Nat.le_self_pow ha.ne' p).trans hle
  refine (pow_dvd_pow p hal).trans ?_
  by_cases hp0 : p ≤ goodN0 ρ N
  · have hdQ : p ^ Nat.log p N ∣ goodQ0 ρ N :=
      Finset.dvd_prod_of_mem (fun p => p ^ Nat.log p N)
        (Finset.mem_filter.2 ⟨Finset.mem_range.2 (by omega), hp⟩)
    have hQ1 : 1 < goodQ0 ρ N :=
      lt_of_lt_of_le (one_lt_pow_log_of_prime hp hpN) (Nat.le_of_dvd (goodQ0_pos ρ N) hdQ)
    exact hdQ.trans (dvd_blockProd (mem_goodBlocks.2 (Or.inl ⟨rfl, hQ1⟩)))
  · exact dvd_blockProd (mem_goodBlocks.2 (Or.inr ⟨p,
      mem_goodLargePrimes.2 ⟨⟨by omega, hpN⟩, hp⟩, rfl⟩))

/-- The counting step of Blueprint Construction 7.8 (`con:goodset`): at most `4/ρ` distinct
primes `p > N₀ ≥ N^{ρ/4}` divide `q ≤ N`. -/
lemma card_largePrimes_dvd_le {ρ : ℝ} (hρ : 0 < ρ) {N q : ℕ} (hN : 2 ≤ N) (hq1 : 1 ≤ q)
    (hqN : q ≤ N) : ((goodLargePrimes ρ N).filter (· ∣ q)).card ≤ ⌈4 / ρ⌉₊ := by
  set P := (goodLargePrimes ρ N).filter (· ∣ q) with hP
  have hPmem : ∀ p ∈ P, (goodN0 ρ N < p ∧ p ≤ N) ∧ p.Prime ∧ p ∣ q := fun p hp => by
    obtain ⟨h1, h2⟩ := Finset.mem_filter.1 hp
    exact ⟨(mem_goodLargePrimes.1 h1).1, (mem_goodLargePrimes.1 h1).2, h2⟩
  have hdvd : ∏ p ∈ P, p ∣ q :=
    Finset.prod_primes_dvd q (fun p hp => Nat.prime_iff.1 (hPmem p hp).2.1)
      fun p hp => (hPmem p hp).2.2
  have hprod : (∏ p ∈ P, p : ℕ) ≤ N := (Nat.le_of_dvd hq1 hdvd).trans hqN
  have hNr : (1 : ℝ) < N := by exact_mod_cast hN
  have hN0 : (0 : ℝ) ≤ (N : ℝ) ^ (ρ / 4) := Real.rpow_nonneg (by positivity) _
  have hlow : ((N : ℝ) ^ (ρ / 4)) ^ P.card ≤ (N : ℝ) := by
    calc ((N : ℝ) ^ (ρ / 4)) ^ P.card = ∏ _p ∈ P, (N : ℝ) ^ (ρ / 4) := by
          rw [Finset.prod_const]
      _ ≤ ∏ p ∈ P, (p : ℝ) := by
          refine Finset.prod_le_prod₀ (fun _ _ => hN0) fun p hp => ?_
          have h1 : (N : ℝ) ^ (ρ / 4) ≤ goodN0 ρ N := Nat.le_ceil _
          have h2 : (goodN0 ρ N : ℝ) ≤ p := by exact_mod_cast (hPmem p hp).1.1.le
          linarith
      _ = ((∏ p ∈ P, p : ℕ) : ℝ) := by push_cast; rfl
      _ ≤ N := by exact_mod_cast hprod
  rw [← Real.rpow_natCast, ← Real.rpow_mul (by positivity)] at hlow
  have hexp : ρ / 4 * P.card ≤ 1 := by
    have := (Real.rpow_le_rpow_left_iff hNr).1 (hlow.trans (Real.rpow_one _).symm.le)
    exact this
  have hc : (P.card : ℝ) ≤ 4 / ρ := by
    rw [le_div_iff₀ hρ]; linarith
  exact_mod_cast hc.trans (Nat.le_ceil _)

/-- The blocks not coprime to `q ≤ N` are at most `k` in number. -/
lemma card_goodBlocks_not_coprime_le {ρ : ℝ} (hρ : 0 < ρ) {N q : ℕ} (hN : 2 ≤ N)
    (hq1 : 1 ≤ q) (hqN : q ≤ N) :
    ((goodBlocks ρ N).filter fun b => ¬ Nat.Coprime b q).card ≤ goodK ρ := by
  have hsub : (goodBlocks ρ N).filter (fun b => ¬ Nat.Coprime b q) ⊆
      {goodQ0 ρ N} ∪ ((goodLargePrimes ρ N).filter (· ∣ q)).image fun p => p ^ Nat.log p N := by
    intro b hb
    obtain ⟨hbS, hnc⟩ := Finset.mem_filter.1 hb
    rcases mem_goodBlocks.1 hbS with ⟨rfl, _⟩ | ⟨p, hp, rfl⟩
    · exact Finset.mem_union_left _ (Finset.mem_singleton_self _)
    · refine Finset.mem_union_right _ (Finset.mem_image.2 ⟨p, Finset.mem_filter.2 ⟨hp, ?_⟩, rfl⟩)
      by_contra h
      exact hnc (Nat.Coprime.pow_left _
        ((Nat.Prime.coprime_iff_not_dvd (mem_goodLargePrimes.1 hp).2).2 h))
  have h1 := Finset.card_le_card hsub
  have h2 := Finset.card_union_le ({goodQ0 ρ N} : Finset ℕ)
    (((goodLargePrimes ρ N).filter (· ∣ q)).image fun p => p ^ Nat.log p N)
  have h3 : (((goodLargePrimes ρ N).filter (· ∣ q)).image fun p => p ^ Nat.log p N).card ≤
      ((goodLargePrimes ρ N).filter (· ∣ q)).card := Finset.card_image_le
  have h4 := card_largePrimes_dvd_le hρ hN hq1 hqN
  rw [Finset.card_singleton] at h2
  unfold goodK; omega

/-- Blueprint Construction 7.8 (`con:goodset`): every rational point of denominator `q ≤ N`
belongs to `𝒰_N`, i.e. `T[q] ⊆ Σ_{≤k}` inside `T[Q_S]` for all `1 ≤ q ≤ N` (its block support
consists of blocks not coprime to `q`: the block `Q₀` and at most `4/ρ` large prime powers). -/
theorem blockGrid_subset_goodSet {ρ : ℝ} (hρ : 0 < ρ) {N q : ℕ} (hN : 2 ≤ N) (hq1 : 1 ≤ q)
    (hqN : q ≤ N) :
    (blockGrid (blockProd (goodBlocks ρ N)) q : Finset (Fin n → ZMod _)) ⊆
      goodSet ρ N := by
  intro x hx
  rw [mem_blockGrid] at hx
  rw [goodSet, mem_sigmaLe]
  have hsub : blockSupp (goodBlocks ρ N) x ⊆
      (goodBlocks ρ N).filter fun b => ¬ Nat.Coprime b q := by
    intro b hb
    obtain ⟨hbS, hne⟩ := mem_blockSupp.1 hb
    refine Finset.mem_filter.2 ⟨hbS, fun hc => hne ?_⟩
    have h := congrArg (blockRed b) hx
    rw [blockRed_nsmul (dvd_blockProd hbS), blockRed_zero (dvd_blockProd hbS)] at h
    exact eq_zero_of_nsmul_eq_zero_of_coprime hc.symm h
  exact (Finset.card_le_card hsub).trans (card_goodBlocks_not_coprime_le hρ hN hq1 hqN)

/-- Blueprint Construction 7.8 (`con:goodset`), in terms of points of `E`: for `1 ≤ q ≤ N`, every
rational point `b/q` (`b ∈ {0,…,q-1}ⁿ`) is the point `ratPt Q_S x` of a center `x ∈ 𝒰_N`. -/
theorem gridEmb_mem_goodSet {ρ : ℝ} (hρ : 0 < ρ) {N q : ℕ} (hN : 2 ≤ N) (hq1 : 1 ≤ q)
    (hqN : q ≤ N) (b : Fin n → Fin q) :
    gridEmb (blockProd (goodBlocks ρ N)) q b ∈ goodSet ρ N ∧
      ratPt (blockProd (goodBlocks ρ N)) (gridEmb (blockProd (goodBlocks ρ N)) q b) =
        gridPt q b :=
  ⟨blockGrid_subset_goodSet hρ hN hq1 hqN
      (gridEmb_mem_blockGrid (dvd_blockProd_goodBlocks ρ hq1 hqN) b),
    ratPt_gridEmb (dvd_blockProd_goodBlocks ρ hq1 hqN) b⟩

/-- Blueprint Construction 7.8 (`con:goodset`), the case `N₀ ≥ N`: then the only block is
`Q₀`, and every `1 ≤ q ≤ N` divides `Q₀`. -/
theorem goodBlocks_of_le_goodN0 (ρ : ℝ) {N : ℕ} (hN : 2 ≤ N) (h : N ≤ goodN0 ρ N) :
    goodBlocks ρ N = {goodQ0 ρ N} ∧ 1 < goodQ0 ρ N ∧
      ∀ q, 1 ≤ q → q ≤ N → q ∣ goodQ0 ρ N := by
  have hL : goodLargePrimes ρ N = ∅ := by
    ext p; simp only [mem_goodLargePrimes, Finset.notMem_empty, iff_false]; omega
  have h2 : 2 ^ Nat.log 2 N ∣ goodQ0 ρ N :=
    Finset.dvd_prod_of_mem (fun p => p ^ Nat.log p N)
      (Finset.mem_filter.2 ⟨Finset.mem_range.2 (by omega), Nat.prime_two⟩)
  have hQ1 : 1 < goodQ0 ρ N :=
    lt_of_lt_of_le (one_lt_pow_log_of_prime Nat.prime_two hN)
      (Nat.le_of_dvd (goodQ0_pos ρ N) h2)
  have hB : goodBlocks ρ N = {goodQ0 ρ N} := by
    simp [goodBlocks, hL, hQ1]
  refine ⟨hB, hQ1, fun q hq1 hqN => ?_⟩
  have := dvd_blockProd_goodBlocks ρ hq1 hqN
  rwa [hB, blockProd, Finset.prod_singleton] at this

/-! ### Size bounds -/

lemma card_smallPrimes_le (N₀ : ℕ) : ((range (N₀ + 1)).filter Nat.Prime).card ≤ N₀ := by
  have hsub : (range (N₀ + 1)).filter Nat.Prime ⊆ Icc 1 N₀ := by
    intro p hp
    obtain ⟨h1, h2⟩ := Finset.mem_filter.1 hp
    have := Finset.mem_range.1 h1
    have := h2.pos
    exact Finset.mem_Icc.2 ⟨by omega, by omega⟩
  simpa using Finset.card_le_card hsub

/-- Blueprint Construction 7.8 (`con:goodset`): `Q₀ ≤ N^{N₀}` (at most `N₀` small primes, each
factor `≤ N`). -/
theorem goodQ0_le_pow (ρ : ℝ) {N : ℕ} (hN : 1 ≤ N) : goodQ0 ρ N ≤ N ^ goodN0 ρ N :=
  (Finset.prod_le_pow_card _ _ _ fun p _ => Nat.pow_log_le_self p (by omega)).trans
    (Nat.pow_le_pow_right hN (card_smallPrimes_le _))

lemma one_le_goodN0 (ρ : ℝ) {N : ℕ} (hN : 1 ≤ N) : 1 ≤ goodN0 ρ N :=
  Nat.one_le_iff_ne_zero.2 (Nat.ceil_pos.2 (Real.rpow_pos_of_pos (by exact_mod_cast hN) _)).ne'

/-- Blueprint Construction 7.8 (`con:goodset`): `log Q₀ ≤ N₀ log N`. -/
theorem log_goodQ0_le (ρ : ℝ) {N : ℕ} (hN : 1 ≤ N) :
    Real.log (goodQ0 ρ N) ≤ goodN0 ρ N * Real.log N := by
  rw [← Real.log_pow]
  refine Real.log_le_log (by exact_mod_cast goodQ0_pos ρ N) ?_
  exact_mod_cast goodQ0_le_pow ρ hN

/-- Blueprint Construction 7.8 (`con:goodset`): `N₀ log N ≤ C_ρ N^{ρ/2}` with `C_ρ = 8/ρ`. -/
theorem goodN0_mul_log_le {ρ : ℝ} (hρ : 0 < ρ) {N : ℕ} (hN : 1 ≤ N) :
    (goodN0 ρ N : ℝ) * Real.log N ≤ 8 / ρ * (N : ℝ) ^ (ρ / 2) := by
  have hN' : (1 : ℝ) ≤ N := by exact_mod_cast hN
  set t := (N : ℝ) ^ (ρ / 4) with ht
  have ht1 : 1 ≤ t := Real.one_le_rpow hN' (by positivity)
  have hN0 : (goodN0 ρ N : ℝ) ≤ 2 * t := by
    have := Nat.ceil_lt_add_one (show 0 ≤ t by linarith)
    rw [goodN0]; linarith
  have hlog : Real.log N ≤ t / (ρ / 4) := Real.log_le_rpow_div (by positivity) (by positivity)
  have hlog0 : 0 ≤ Real.log N := Real.log_nonneg hN'
  have htt : (N : ℝ) ^ (ρ / 2) = t * t := by
    rw [ht, ← Real.rpow_add (by linarith)]; ring_nf
  calc (goodN0 ρ N : ℝ) * Real.log N ≤ (2 * t) * (t / (ρ / 4)) :=
        mul_le_mul hN0 hlog hlog0 (by linarith)
    _ = 8 / ρ * (N : ℝ) ^ (ρ / 2) := by rw [htt]; field_simp; ring

/-- Blueprint Construction 7.8 (`con:goodset`): every block is at most `max(Q₀, N)`. -/
theorem le_max_of_mem_goodBlocks {ρ : ℝ} {N b : ℕ} (hN : 1 ≤ N) (hb : b ∈ goodBlocks ρ N) :
    b ≤ max (goodQ0 ρ N) N := by
  rcases mem_goodBlocks.1 hb with ⟨rfl, _⟩ | ⟨p, _, rfl⟩
  · exact le_max_left _ _
  · exact (Nat.pow_log_le_self p (by omega)).trans (le_max_right _ _)

/-- Blueprint Construction 7.8 (`con:goodset`): `q_* ≤ max(Q₀, N)`. -/
theorem blockStar_goodBlocks_le {ρ : ℝ} {N : ℕ} (hN : 2 ≤ N) :
    blockStar (goodBlocks ρ N) ≤ max (goodQ0 ρ N) N :=
  max_le (hN.trans (le_max_right _ _))
    (Finset.sup_le fun b hb => le_max_of_mem_goodBlocks (by omega) hb)

/-- Blueprint Construction 7.8 (`con:goodset`): `q_* ≤ exp(N₀ log N) ≤ exp(C_ρ N^{ρ/2})` with
`C_ρ = 8/ρ`. -/
theorem blockStar_goodBlocks_le_exp {ρ : ℝ} (hρ : 0 < ρ) {N : ℕ} (hN : 2 ≤ N) :
    (blockStar (goodBlocks ρ N) : ℝ) ≤ Real.exp (goodN0 ρ N * Real.log N) ∧
      (blockStar (goodBlocks ρ N) : ℝ) ≤ Real.exp (8 / ρ * (N : ℝ) ^ (ρ / 2)) := by
  have hN1 : 1 ≤ N := by omega
  have h1 : (blockStar (goodBlocks ρ N) : ℝ) ≤ Real.exp (goodN0 ρ N * Real.log N) := by
    have hle : (blockStar (goodBlocks ρ N) : ℝ) ≤ max (goodQ0 ρ N : ℝ) (N : ℝ) := by
      exact_mod_cast blockStar_goodBlocks_le hN
    refine hle.trans (max_le ?_ ?_)
    · rw [← Real.exp_log (by exact_mod_cast goodQ0_pos ρ N : (0 : ℝ) < goodQ0 ρ N)]
      exact Real.exp_le_exp.2 (log_goodQ0_le ρ hN1)
    · refine (Real.exp_log (by positivity : (0 : ℝ) < N)).symm.le.trans (Real.exp_le_exp.2 ?_)
      have : (1 : ℝ) ≤ goodN0 ρ N := by exact_mod_cast one_le_goodN0 ρ hN1
      have h0 : 0 ≤ Real.log N := Real.log_nonneg (by exact_mod_cast hN1)
      nlinarith
  exact ⟨h1, h1.trans (Real.exp_le_exp.2 (goodN0_mul_log_le hρ hN1))⟩

/-- Blueprint Construction 7.8 (`con:goodset`), the threshold: for every `r ≥ 1` there is
`C_{ρ,r} > 0` such that for all `N ≥ 2` and `0 < ε ≤ exp(-C_{ρ,r} N^{2ρ})`, hypothesis (7.1) of
Theorem 7.7 holds for the blocks of `𝒰_N`: `ε ≤ (100 r q_*^{2rk})⁻¹`. -/
theorem goodBlocks_eps_threshold {ρ : ℝ} (hρ : 0 < ρ) (r : ℕ) (hr : 1 ≤ r) :
    ∃ C : ℝ, 0 < C ∧ ∀ N : ℕ, 2 ≤ N → ∀ ε : ℝ, 0 < ε →
      ε ≤ Real.exp (-(C * (N : ℝ) ^ (2 * ρ))) →
      ε ≤ (100 * r * (blockStar (goodBlocks ρ N) : ℝ) ^ (2 * r * goodK ρ))⁻¹ := by
  set K : ℕ := 2 * r * goodK ρ
  have hr' : (1 : ℝ) ≤ r := by exact_mod_cast hr
  have hL0 : 0 ≤ Real.log (100 * r) := Real.log_nonneg (by linarith)
  refine ⟨Real.log (100 * r) + K * (8 / ρ) + 1, by positivity, fun N hN ε _ hε => ?_⟩
  refine hε.trans ?_
  have hN' : (1 : ℝ) ≤ N := by exact_mod_cast (show 1 ≤ N by omega)
  have hq := (blockStar_goodBlocks_le_exp (ρ := ρ) hρ hN).2
  have hq0 : (0 : ℝ) ≤ blockStar (goodBlocks ρ N) := by positivity
  set u := (N : ℝ) ^ (ρ / 2)
  set T := (N : ℝ) ^ (2 * ρ)
  have hT1 : 1 ≤ T := Real.one_le_rpow hN' (by positivity)
  have huT : u ≤ T := Real.rpow_le_rpow_of_exponent_le hN' (by linarith)
  have hu0 : 0 ≤ u := by positivity
  have hX : 100 * r * (blockStar (goodBlocks ρ N) : ℝ) ^ K ≤
      Real.exp ((Real.log (100 * r) + K * (8 / ρ) + 1) * T) := by
    calc 100 * r * (blockStar (goodBlocks ρ N) : ℝ) ^ K
        ≤ Real.exp (Real.log (100 * r)) * Real.exp (8 / ρ * u) ^ K := by
          rw [Real.exp_log (by positivity)]
          gcongr
      _ = Real.exp (Real.log (100 * r) + K * (8 / ρ * u)) := by
          rw [← Real.exp_nat_mul, ← Real.exp_add]
      _ ≤ _ := by
          refine Real.exp_le_exp.2 ?_
          have hK0 : (0 : ℝ) ≤ K * (8 / ρ) := by positivity
          nlinarith [mul_le_mul_of_nonneg_left huT hK0]
  have hXpos : 0 < 100 * r * (blockStar (goodBlocks ρ N) : ℝ) ^ K := by
    have : (0 : ℝ) < blockStar (goodBlocks ρ N) := by
      exact_mod_cast (lt_of_lt_of_le two_pos (two_le_blockStar _))
    positivity
  rw [Real.exp_neg]
  exact inv_anti₀ hXpos hX

end GoodSet

section GoodSetTransference

open MeasureTheory
open scoped FourierTransform SchwartzMap

/-- Blueprint Construction 7.8 (`con:goodset`), consequence: the conclusion of Theorem 7.7
(`thm:IW`) for `𝒰_N`, with constants independent of `N`. For `r ≥ 1` and `(2r)' ≤ p ≤ 2r` there
are `C ≥ 0` and `C_{ρ,r} > 0` such that for every `N ≥ 2`, every `0 < ε ≤ exp(-C_{ρ,r} N^{2ρ})`,
every bounded measurable `m` supported in `[-ε/2, ε/2]ⁿ` with Euclidean `L^{2r}` multiplier norm
`≤ A`, and every finitely supported `f`, `‖T_{m;𝒰_N} f‖_{ℓ^p} ≤ C A ‖f‖_{ℓ^p}`. -/
theorem goodSet_transference (n : ℕ) {ρ : ℝ} (hρ : 0 < ρ) (r : ℕ) (hr : 1 ≤ r) {p : ℝ}
    (hp1 : (2 * r : ℝ) / (2 * r - 1) ≤ p) (hp2 : p ≤ 2 * r) :
    ∃ C : ℝ, 0 ≤ C ∧ ∃ Cρr : ℝ, 0 < Cρr ∧ ∀ N : ℕ, 2 ≤ N → ∀ ε : ℝ, 0 < ε →
      ε ≤ Real.exp (-(Cρr * (N : ℝ) ^ (2 * ρ))) →
      ∀ (m : EuclideanSpace ℝ (Fin n) → ℂ) (B A : ℝ), AEStronglyMeasurable m volume →
      (∀ ξ, ‖m ξ‖ ≤ B) → Function.support m ⊆ {ξ | ∀ i, |ξ i| ≤ ε / 2} →
      (∀ F : 𝓢(EuclideanSpace ℝ (Fin n), ℂ),
        eLpNorm (𝓕⁻ (fun ξ => m ξ * 𝓕 (F : EuclideanSpace ℝ (Fin n) → ℂ) ξ))
          (ENNReal.ofReal (2 * r)) volume ≤
            ENNReal.ofReal A * eLpNorm F (ENNReal.ofReal (2 * r)) volume) →
      ∀ f : (Fin n → ℤ) → ℂ, (Function.support f).Finite →
        eLpNorm (cosetMult (blockProd (goodBlocks ρ N)) m (goodSet ρ N) f) (ENNReal.ofReal p)
            Measure.count ≤
          ENNReal.ofReal (C * A) * eLpNorm f (ENNReal.ofReal p) Measure.count := by
  obtain ⟨C, hC, hT⟩ := coprime_block_multiplier_transference n (goodK ρ) r hr hp1 hp2
  obtain ⟨Cρr, hCρr, hth⟩ := goodBlocks_eps_threshold hρ r hr
  exact ⟨C, hC, Cρr, hCρr, fun N hN ε hε hεN m B A hm hB hsupp hA f hf =>
    hT (goodBlocks ρ N) goodBlocks_one_lt goodBlocks_pairwise_coprime ε hε
      (hth N hN ε hε hεN) m B A hm hB hsupp hA f hf⟩

end GoodSetTransference

