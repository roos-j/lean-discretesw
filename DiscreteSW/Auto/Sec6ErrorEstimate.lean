/-!
## Kernel-side major-arc approximation: the smoothing error

Results from §12 ("Kernel-side major-arc approximation and coherent grouping") of
`blueprints/discrete-sw.tex`, first part (Lemma 12.1). The rest of §12 (Lemma 12.2 and
Proposition 12.3) is in `DiscreteSW/Auto/DiscreteSteinWainger.lean`.

### Definitions

* `majorH Ω d j μ = h_{j,μ} = e(μ P) K_j` (so `radialOscPhi Ω d j μ = 𝓕 h_{j,μ}`).

### Main results

* `major_kernel_error`: Blueprint Lemma 12.1 (`lem:kernelerror`), eq. (12.1);
* `latKernel_liftSym_radialOscPhi`, `major_kernel_formula`: Lemma 12.1, the lattice kernel formula.

### Proof notes (deviations from the blueprint)

* Lemma 12.1 is proved without the hypotheses `j ≥ 1` and `L_s ≤ R` (they are not needed), and
  the kernel formula holds for every `α = a/q` with `q ≥ 1` (not only `α ∈ 𝓡_s`). The gradient
  bound is replaced by the equivalent Lipschitz bound `|h(y) - h(y - z)| ≤ C (1 + U) R^{-n-1}|z|`
  (`exists_majorH_bounds`), and the first moment bound `∫ |z| |φ_s(z)| ≤ C L_s` is used in the
  pointwise form `|z| |φ_s(z)| ≤ C L_s B_{L_s}(z)` (`norm_mul_norm_liftPhi_le`).
-/

open MeasureTheory Set Real Finset
open scoped FourierTransform ContDiff SchwartzMap Convolution

variable {n d : ℕ} {Ω : EuclideanSpace ℝ (Fin n) → ℂ} {p : ℝ}

/-! ### Blueprint Lemma 12.1 (`lem:kernelerror`) -/

/-- `h_{j,μ}(x) = e(μ P(x)) K_j(x)` of Blueprint Lemma 12.1 (`lem:kernelerror`). -/
noncomputable def majorH (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (d : ℕ) (j : ℤ) (μ : ℝ)
    (x : EuclideanSpace ℝ (Fin n)) : ℂ :=
  eC (μ * radialPoly n d x) * dyadicKernel Ω j x

/-- `Φ_{j,μ} = 𝓕 h_{j,μ}`. -/
lemma radialOscPhi_eq_fourier_majorH (j : ℤ) (μ : ℝ) :
    radialOscPhi Ω d j μ = 𝓕 (majorH Ω d j μ) := rfl

/-- `φ_s` is the Schwartz function `𝓕⁻ χ_s`. -/
lemma coe_fourierInv_liftChiSchwartz (s : ℕ) :
    ((𝓕⁻ (liftChiSchwartz n d Ω p s) : 𝓢(EuclideanSpace ℝ (Fin n), ℂ)) :
      EuclideanSpace ℝ (Fin n) → ℂ) = liftPhi n d Ω p s := by
  rw [SchwartzMap.fourierInv_coe]; rfl

/-- `φ_s` is integrable. -/
lemma integrable_liftPhi (s : ℕ) : Integrable (liftPhi n d Ω p s) := by
  rw [← coe_fourierInv_liftChiSchwartz]; exact SchwartzMap.integrable _

/-- `∫ φ_s = χ_s(0) = 1` (Fourier inversion). -/
lemma integral_liftPhi (s : ℕ) : ∫ x, liftPhi n d Ω p s x = 1 := by
  have key : 𝓕 (liftPhi n d Ω p s) = fun ξ => (liftChi n d Ω p s ξ : ℂ) := by
    rw [← coe_fourierInv_liftChiSchwartz, ← SchwartzMap.fourier_coe,
      FourierTransform.fourier_fourierInv_eq]; rfl
  have h := congrFun key 0
  rw [fourier_eq_integral_eC] at h
  simp only [inner_zero_right, neg_zero, eC_zero, one_mul] at h
  rw [h, liftChi, smul_zero, liftCutoff_eq_one (fun i => by simp)]
  simp

/-- First-moment decay of `φ_s`: `|z| |φ_s(z)| ≤ K L_s B_{L_s}(z)` with `K` depending only on
`n` (from the Schwartz decay of `𝓕⁻ χ` of order `n + 2` and scaling). -/
lemma norm_mul_norm_liftPhi_le (n : ℕ) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ (d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ)
      (z : EuclideanSpace ℝ (Fin n)),
      ‖z‖ * ‖liftPhi n d Ω p s z‖ ≤ K * (liftL n d Ω p s : ℝ) * envelope n (liftL n d Ω p s) z := by
  obtain ⟨K, hK, hKb⟩ := exists_schwartz_decay (arithPhiS n) (n + 2)
  refine ⟨K, hK, fun d Ω p s z => ?_⟩
  have hL := liftL_pos (n := n) (d := d) (Ω := Ω) (p := p) s
  set L : ℝ := (liftL n d Ω p s : ℝ)
  rw [arith_liftPhi_eq_dilateL]
  have h1 := norm_dilateL_le (fun x => (hKb x).1) hL z
  set t : ℝ := ‖z‖ / L with ht
  have ht0 : 0 ≤ t := by positivity
  have hz : ‖z‖ = L * t := by rw [ht]; field_simp
  rw [envelope, hz]
  calc L * t * ‖dilateL (⇑(arithPhiS n)) L z‖
      ≤ L * t * (K * ((L ^ n)⁻¹ * ((1 + t) ^ (n + 2))⁻¹)) := by
        gcongr
    _ = K * L * ((L ^ n)⁻¹ * ((1 + t) ^ (n + 1))⁻¹) * (t / (1 + t)) := by
        field_simp; ring
    _ ≤ K * L * ((L ^ n)⁻¹ * ((1 + t) ^ (n + 1))⁻¹) * 1 := by
        gcongr
        rw [div_le_one (by positivity)]; linarith
    _ = _ := by rw [mul_one, ← hz, ← ht]

/-- The scalar inequality `|μ| D (3R)^{D-1} R ≤ D 3^D U` from `|μ| R^D ≤ U`. -/
lemma major_phase_scalar {D : ℕ} {μ R U : ℝ} (hR : 0 < R) (hU : |μ| * R ^ D ≤ U) :
    |μ| * D * (3 * R) ^ (D - 1) * R ≤ D * 3 ^ D * U := by
  rcases D with _ | k
  · simp
  · have hU0 : 0 ≤ U := le_trans (by positivity) hU
    rw [Nat.add_sub_cancel, mul_pow]
    have e : |μ| * ((k + 1 : ℕ) : ℝ) * (3 ^ k * R ^ k) * R =
        ((k + 1 : ℕ) : ℝ) * 3 ^ k * (|μ| * R ^ (k + 1)) := by ring
    rw [e, pow_succ 3 k]
    have h3 : (3 : ℝ) ^ k * U ≤ 3 ^ k * 3 * U := by nlinarith [pow_pos (by norm_num : (0:ℝ) < 3) k]
    calc ((k + 1 : ℕ) : ℝ) * 3 ^ k * (|μ| * R ^ (k + 1)) ≤ ((k + 1 : ℕ) : ℝ) * 3 ^ k * U := by
          gcongr
      _ ≤ ((k + 1 : ℕ) : ℝ) * (3 ^ k * 3) * U := by
          rw [mul_assoc, mul_assoc]; gcongr

/-- Size and Lipschitz bounds for `h_{j,μ} = e(μP) K_j` with `|μ| R^D ≤ U`, `R = 2^j`:
`|h| ≤ C₀ R^{-n}` and `|h(y) - h(y - z)| ≤ A (1 + U) R^{-n-1} |z|`. -/
lemma exists_majorH_bounds (hΩ : IsSWProfile Ω) (d : ℕ) :
    ∃ C₀ A : ℝ, 0 ≤ C₀ ∧ 0 ≤ A ∧ ∀ (j : ℕ) (μ U : ℝ), |μ| * ((2 : ℝ) ^ j) ^ (2 * d) ≤ U →
      (∀ x, ‖majorH Ω d j μ x‖ ≤ C₀ / ((2 : ℝ) ^ j) ^ n) ∧
      ∀ y z, ‖majorH Ω d j μ y - majorH Ω d j μ (y - z)‖ ≤
        A * (1 + U) * ‖z‖ / ((2 : ℝ) ^ j) ^ (n + 1) := by
  obtain ⟨C₀, C₁, hC₀, hC₁, hK⟩ := minor_kernel_bounds (Ω := Ω) hΩ
  set D := 2 * d with hD
  refine ⟨C₀, 2 * π * D * 3 ^ D * C₀ + C₁ + 2 * C₀, hC₀, by positivity, fun j μ U hU => ?_⟩
  set R : ℝ := 2 ^ j with hRdef
  have hR : 0 < R := by positivity
  have hU0 : 0 ≤ U := le_trans (by positivity) hU
  have hnorm : ∀ x, ‖majorH Ω d j μ x‖ ≤ C₀ / R ^ n := fun x => by
    rw [majorH, norm_mul, norm_eC, one_mul]; exact (hK j).1 x
  refine ⟨hnorm, fun y z => ?_⟩
  have hRn : 0 < R ^ (n + 1) := by positivity
  have hz0 : 0 ≤ ‖z‖ := norm_nonneg z
  rw [le_div_iff₀ hRn]
  by_cases hz : R ≤ ‖z‖
  · calc ‖majorH Ω d j μ y - majorH Ω d j μ (y - z)‖ * R ^ (n + 1)
        ≤ (C₀ / R ^ n + C₀ / R ^ n) * R ^ (n + 1) := by
          gcongr; exact (norm_sub_le _ _).trans (add_le_add (hnorm _) (hnorm _))
      _ = 2 * C₀ * R := by rw [pow_succ]; field_simp; ring
      _ ≤ 2 * C₀ * ‖z‖ := by gcongr
      _ ≤ (2 * π * D * 3 ^ D * C₀ + C₁ + 2 * C₀) * (1 + U) * ‖z‖ := by
          have : 0 ≤ 2 * π * D * 3 ^ D * C₀ := by positivity
          nlinarith [mul_nonneg hC₀ hU0, mul_nonneg (mul_nonneg this hU0) hz0,
            mul_nonneg (mul_nonneg hC₁ hU0) hz0, mul_nonneg hC₁ hz0, mul_nonneg this hz0,
            mul_nonneg (mul_nonneg hC₀ hU0) hz0]
  push Not at hz
  set e1 := eC (μ * radialPoly n d y)
  set e2 := eC (μ * radialPoly n d (y - z))
  have hsplit : majorH Ω d j μ y - majorH Ω d j μ (y - z) =
      (e1 - e2) * dyadicKernel Ω j y + e2 * (dyadicKernel Ω j y - dyadicKernel Ω j (y - z)) := by
    simp only [majorH, e1, e2]; ring
  have hsecond : ‖e2 * (dyadicKernel Ω j y - dyadicKernel Ω j (y - z))‖ ≤
      C₁ / R ^ (n + 1) * ‖z‖ := by
    rw [norm_mul, norm_eC, one_mul]
    have := (hK j).2 y (y - z)
    rwa [sub_sub_cancel] at this
  have hfirst : ‖(e1 - e2) * dyadicKernel Ω j y‖ * R ^ (n + 1) ≤
      2 * π * D * 3 ^ D * C₀ * U * ‖z‖ := by
    by_cases hKy : dyadicKernel Ω j y = 0
    · rw [hKy, mul_zero, norm_zero, zero_mul]; positivity
    have hy : ‖y‖ < 2 * R := by
      have := (support_dyadicKernel (Ω := Ω) (j : ℤ) hKy).2
      rwa [zpow_add_one₀ two_ne_zero, zpow_natCast, mul_comm] at this
    have hyz : ‖y - z‖ ≤ 3 * R := by
      have := norm_sub_le y z; linarith
    have hP : |radialPoly n d y - radialPoly n d (y - z)| ≤ ‖z‖ * D * (3 * R) ^ (D - 1) := by
      rw [radialPoly_eq_norm_pow, radialPoly_eq_norm_pow]
      refine (abs_pow_sub_pow_le _ _ _).trans ?_
      have h1 : |‖y‖ - ‖y - z‖| ≤ ‖z‖ := by
        have := abs_norm_sub_norm_le y (y - z); rwa [sub_sub_cancel] at this
      have h2 : max |‖y‖| |‖y - z‖| ≤ 3 * R := by
        rw [abs_norm, abs_norm]; exact max_le (by linarith) hyz
      gcongr
    have he : ‖e1 - e2‖ ≤ 2 * π * (|μ| * (‖z‖ * D * (3 * R) ^ (D - 1))) := by
      refine (norm_eC_sub_eC_le _ _).trans ?_
      rw [← mul_sub, abs_mul]
      gcongr
    have hKb := (hK j).1 y
    have hsc := major_phase_scalar (D := D) hR hU
    calc ‖(e1 - e2) * dyadicKernel Ω j y‖ * R ^ (n + 1)
        ≤ 2 * π * (|μ| * (‖z‖ * D * (3 * R) ^ (D - 1))) * (C₀ / R ^ n) * R ^ (n + 1) := by
          rw [norm_mul]; gcongr
      _ = 2 * π * C₀ * ‖z‖ * (|μ| * D * (3 * R) ^ (D - 1) * R) := by
          rw [pow_succ]; field_simp
      _ ≤ 2 * π * C₀ * ‖z‖ * (D * 3 ^ D * U) := by gcongr
      _ = 2 * π * D * 3 ^ D * C₀ * U * ‖z‖ := by ring
  rw [hsplit]
  have hs2 : ‖e2 * (dyadicKernel Ω j y - dyadicKernel Ω j (y - z))‖ * R ^ (n + 1) ≤ C₁ * ‖z‖ := by
    have := mul_le_mul_of_nonneg_right hsecond hRn.le
    rwa [div_mul_eq_mul_div, div_mul_eq_mul_div, mul_div_assoc, div_self hRn.ne', mul_one] at this
  calc ‖(e1 - e2) * dyadicKernel Ω j y + e2 * (dyadicKernel Ω j y - dyadicKernel Ω j (y - z))‖ *
        R ^ (n + 1)
      ≤ (‖(e1 - e2) * dyadicKernel Ω j y‖ +
          ‖e2 * (dyadicKernel Ω j y - dyadicKernel Ω j (y - z))‖) * R ^ (n + 1) := by
        gcongr; exact norm_add_le _ _
    _ ≤ 2 * π * D * 3 ^ D * C₀ * U * ‖z‖ + C₁ * ‖z‖ := by rw [add_mul]; exact add_le_add hfirst hs2
    _ ≤ (2 * π * D * 3 ^ D * C₀ + C₁ + 2 * C₀) * (1 + U) * ‖z‖ := by
        have : 0 ≤ 2 * π * D * 3 ^ D * C₀ := by positivity
        nlinarith [mul_nonneg (mul_nonneg this hU0) hz0, mul_nonneg (mul_nonneg hC₁ hU0) hz0,
          mul_nonneg hC₁ hz0, mul_nonneg this hz0, mul_nonneg (mul_nonneg hC₀ hU0) hz0,
          mul_nonneg hC₀ hz0]

/-- `B_R(y) ≥ R^{-n} 5^{-n-1}` for `|y| ≤ 4R`. -/
lemma envelope_ge_of_le_four_mul {R : ℝ} (hR : 0 < R) {y : EuclideanSpace ℝ (Fin n)}
    (hy : ‖y‖ ≤ 4 * R) : (R ^ n)⁻¹ * ((5 : ℝ) ^ (n + 1))⁻¹ ≤ envelope n R y := by
  unfold envelope
  have h1 : ‖y‖ / R ≤ 4 := by rw [div_le_iff₀ hR]; linarith
  gcongr
  linarith

/-- `B_R(y) ≥ R 2^{-n-1} |y|^{-n-1}` for `|y| ≥ R`. -/
lemma envelope_ge_of_le_norm {R : ℝ} (hR : 0 < R) {y : EuclideanSpace ℝ (Fin n)}
    (hy : R ≤ ‖y‖) : R / (2 ^ (n + 1) * ‖y‖ ^ (n + 1)) ≤ envelope n R y := by
  have hy0 : 0 < ‖y‖ := lt_of_lt_of_le hR hy
  have e : envelope n R y = R / (R + ‖y‖) ^ (n + 1) := by
    unfold envelope
    rw [show 1 + ‖y‖ / R = (R + ‖y‖) / R by field_simp, div_pow, pow_succ R n]
    field_simp
  rw [e, ← mul_pow]
  gcongr
  linarith

/-- `B_L(w) ≤ L |w|^{-n-1}` for `w ≠ 0`. -/
lemma envelope_le_div_norm_pow {L : ℝ} (hL : 0 < L) {w : EuclideanSpace ℝ (Fin n)}
    (hw : 0 < ‖w‖) : envelope n L w ≤ L / ‖w‖ ^ (n + 1) := by
  have e : envelope n L w = L / (L + ‖w‖) ^ (n + 1) := by
    unfold envelope
    rw [show 1 + ‖w‖ / L = (L + ‖w‖) / L by field_simp, div_pow, pow_succ L n]
    field_simp
  rw [e]
  gcongr
  linarith

/-- **Blueprint Lemma 12.1 (`lem:kernelerror`)**, eq. (12.1): for a Stein–Wainger profile `Ω`
and `d`, there is `C ≥ 0` (independent of `p`, `s`, `j`, `μ`, `U`) such that, with `R = 2^j`,
`h_{j,μ} = e(μ P) K_j` and `φ_s = 𝓕⁻ χ_s`, whenever `|μ| R^D ≤ U` (`D = 2d`),
`|h_{j,μ}(y) - (h_{j,μ} *_E φ_s)(y)| ≤ C (1 + U) (L_s / R) B_R(y)` for all `y ∈ E` (hence on `G`).
(The blueprint's hypotheses `j ≥ 1`, `1 ≤ L_s ≤ R` are not needed; `L_s ≥ 1` always holds.) -/
theorem major_kernel_error (hΩ : IsSWProfile Ω) (d : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (p : ℝ) (s j : ℕ) (μ U : ℝ), |μ| * ((2 : ℝ) ^ j) ^ (2 * d) ≤ U →
      ∀ y : EuclideanSpace ℝ (Fin n),
        ‖majorH Ω d j μ y -
            (majorH Ω d j μ ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] liftPhi n d Ω p s) y‖ ≤
          C * (1 + U) * ((liftL n d Ω p s : ℝ) / 2 ^ j) * envelope n (2 ^ j) y := by
  obtain ⟨C₀, A, hC₀, hA, hH⟩ := exists_majorH_bounds hΩ d
  obtain ⟨Kφ, hKφ, hmom⟩ := norm_mul_norm_liftPhi_le n
  obtain ⟨Cφ, hCφ, hφ⟩ := norm_liftPhi_le n
  obtain ⟨CL1, hCL1⟩ := dyadicKernel_L1 hΩ
  have hCn : 0 ≤ envelopeConst n := by unfold envelopeConst; positivity
  have hCL0 : 0 ≤ CL1 := (integral_nonneg fun _ => norm_nonneg _).trans (hCL1 0).2.1
  refine ⟨A * Kφ * envelopeConst n * 5 ^ (n + 1) + CL1 * Cφ * 4 ^ (n + 1), by positivity,
    fun p s j μ U hU y => ?_⟩
  obtain ⟨hHb, hHl⟩ := hH j μ U hU
  set R : ℝ := 2 ^ j with hRdef
  set L : ℝ := (liftL n d Ω p s : ℝ) with hLdef
  set h := majorH Ω d j μ with hhdef
  set φ := liftPhi n d Ω p s with hφdef
  have hR : 0 < R := by positivity
  have hL : 0 < L := liftL_pos s
  have hU0 : 0 ≤ U := le_trans (by positivity) hU
  have hconv : (h ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] φ) y = ∫ t, h t * φ (y - t) := by
    rw [convolution_def]; rfl
  have hhc : Continuous h := by
    have : Continuous fun x : EuclideanSpace ℝ (Fin n) => eC (μ * radialPoly n d x) := by
      unfold radialPoly eC; fun_prop
    exact this.mul (contDiff_dyadicKernel hΩ j).continuous
  have hCpos : 0 ≤ A * Kφ * envelopeConst n * 5 ^ (n + 1) := by positivity
  have hCpos' : 0 ≤ CL1 * Cφ * 4 ^ (n + 1) := by positivity
  have hE0 : 0 ≤ envelope n R y := envelope_nonneg hR y
  by_cases hy : ‖y‖ ≤ 4 * R
  · have hconv' : (h ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] φ) y = ∫ z, h (y - z) * φ z := by
      rw [hconv, ← integral_sub_left_eq_self (fun t => h t * φ (y - t)) volume y]
      simp_rw [sub_sub_cancel]
    have hint1 : Integrable fun z => h (y - z) * φ z :=
      (integrable_liftPhi s).bdd_mul
        (hhc.comp (continuous_const.sub continuous_id)).aestronglyMeasurable
        (ae_of_all _ fun z => hHb _)
    have hint2 : Integrable fun z => h y * φ z := (integrable_liftPhi s).const_mul _
    have hrep : h y - (h ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] φ) y =
        ∫ z, (h y - h (y - z)) * φ z := by
      simp_rw [sub_mul]
      rw [hconv', integral_sub hint2 hint1, integral_const_mul, hφdef, integral_liftPhi, mul_one]
    obtain ⟨hEi, hEI⟩ := integrable_envelope_and_integral_le (n := n) hL
    have hbound : ∀ z, ‖(h y - h (y - z)) * φ z‖ ≤
        A * (1 + U) / R ^ (n + 1) * (Kφ * L * envelope n L z) := by
      intro z; rw [norm_mul]
      calc ‖h y - h (y - z)‖ * ‖φ z‖ ≤ (A * (1 + U) * ‖z‖ / R ^ (n + 1)) * ‖φ z‖ := by
            gcongr; exact hHl y z
        _ = A * (1 + U) / R ^ (n + 1) * (‖z‖ * ‖φ z‖) := by ring
        _ ≤ _ := mul_le_mul_of_nonneg_left (hmom d Ω p s z) (by positivity)
    have hI : ‖h y - (h ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] φ) y‖ ≤
        A * (1 + U) / R ^ (n + 1) * (Kφ * L * envelopeConst n) := by
      rw [hrep]
      refine (norm_integral_le_of_norm_le ((hEi.const_mul (Kφ * L)).const_mul _)
        (ae_of_all _ hbound)).trans ?_
      rw [integral_const_mul, integral_const_mul]
      gcongr
    have hE := envelope_ge_of_le_four_mul hR hy
    calc ‖h y - (h ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] φ) y‖
        ≤ A * (1 + U) / R ^ (n + 1) * (Kφ * L * envelopeConst n) := hI
      _ = A * Kφ * envelopeConst n * 5 ^ (n + 1) * (1 + U) * (L / R) *
            ((R ^ n)⁻¹ * ((5 : ℝ) ^ (n + 1))⁻¹) := by
          rw [pow_succ R n]; field_simp
      _ ≤ A * Kφ * envelopeConst n * 5 ^ (n + 1) * (1 + U) * (L / R) * envelope n R y := by
          gcongr
      _ ≤ _ := by gcongr; exact le_add_of_nonneg_right hCpos'
  · push Not at hy
    have hy0 : 0 < ‖y‖ := by linarith
    have hhy : h y = 0 := by
      simp only [hhdef, majorH]
      rw [dyadicKernel_eq_zero_of_le, mul_zero]
      rw [zpow_add_one₀ two_ne_zero, zpow_natCast]; linarith
    rw [hhy, zero_sub, norm_neg, hconv]
    set B : ℝ := Cφ * L * 2 ^ (n + 1) / ‖y‖ ^ (n + 1) with hB
    have hbound : ∀ t, ‖h t * φ (y - t)‖ ≤ ‖h t‖ * B := by
      intro t; rw [norm_mul]
      by_cases ht : dyadicKernel Ω j t = 0
      · have : h t = 0 := by simp [hhdef, majorH, ht]
        rw [this, norm_zero, zero_mul, zero_mul]
      have htR : ‖t‖ < 2 * R := by
        have := (support_dyadicKernel (Ω := Ω) (j : ℤ) ht).2
        rwa [zpow_add_one₀ two_ne_zero, zpow_natCast, mul_comm] at this
      have hyt : ‖y‖ / 2 ≤ ‖y - t‖ := by have := norm_sub_norm_le y t; linarith
      have hyt0 : 0 < ‖y - t‖ := by linarith
      gcongr
      calc ‖φ (y - t)‖ ≤ Cφ * envelope n L (y - t) := (hφ d Ω p s).1 _
        _ ≤ Cφ * (L / ‖y - t‖ ^ (n + 1)) := by gcongr; exact envelope_le_div_norm_pow hL hyt0
        _ ≤ Cφ * (L / (‖y‖ / 2) ^ (n + 1)) := by gcongr
        _ = B := by rw [div_pow, hB]; field_simp
    have hhi : Integrable fun t => ‖h t‖ := (integrable_oscKernel hΩ d j μ).norm
    refine (norm_integral_le_of_norm_le (hhi.mul_const B) (ae_of_all _ hbound)).trans ?_
    rw [integral_mul_const]
    have hnorm_int : ∫ t, ‖h t‖ = ∫ t, ‖dyadicKernel Ω j t‖ := by
      congr 1; funext t; simp [hhdef, majorH, norm_eC]
    have hL1 : ∫ t, ‖h t‖ ≤ CL1 := hnorm_int ▸ (hCL1 j).2.1
    have hE := envelope_ge_of_le_norm (n := n) hR (by linarith : R ≤ ‖y‖)
    have hB0 : 0 ≤ B := by positivity
    calc (∫ t, ‖h t‖) * B ≤ CL1 * B := by gcongr
      _ = CL1 * Cφ * 4 ^ (n + 1) * (L / R) * (R / (2 ^ (n + 1) * ‖y‖ ^ (n + 1))) := by
          rw [hB, show (4 : ℝ) = 2 * 2 by norm_num, mul_pow]; field_simp
      _ ≤ CL1 * Cφ * 4 ^ (n + 1) * (L / R) * envelope n R y := by gcongr
      _ ≤ CL1 * Cφ * 4 ^ (n + 1) * (1 + U) * (L / R) * envelope n R y := by
          have : 0 ≤ CL1 * Cφ * 4 ^ (n + 1) * (L / R) * envelope n R y := by positivity
          nlinarith [mul_nonneg this hU0]
      _ ≤ _ := by gcongr; exact le_add_of_nonneg_left hCpos

/-- `|m̌(y)| ≤ ∫_{[0,1)ⁿ} |m|`. -/
lemma norm_latKernel_le_integral (m : EuclideanSpace ℝ (Fin n) → ℂ) (y : Fin n → ℤ) :
    ‖latKernel m y‖ ≤ ∫ ξ in torusCube n, ‖m ξ‖ := by
  unfold latKernel
  refine (norm_integral_le_integral_norm _).trans (le_of_eq ?_)
  congr 1; funext ξ; rw [norm_mul, norm_eC, mul_one]

/-- If `λ = α + μ` modulo `ℤ`, then `e(λ P(y)) = e(α P(y)) e(μ P(y))` for `y ∈ G` (since
`P(y) ∈ ℤ`). -/
lemma eC_mul_radialPolyZ_of_eq_add (d : ℕ) {α μ lam : ℝ} (hlam : ∃ k : ℤ, lam = α + μ + k)
    (y : Fin n → ℤ) :
    eC (lam * (radialPolyZ n d y : ℝ)) =
      eC (α * (radialPolyZ n d y : ℝ)) * eC (μ * radialPoly n d (latEmbed y)) := by
  obtain ⟨k, rfl⟩ := hlam
  rw [radialPoly_latEmbed, ← eC_add]
  have : (α + μ + k) * (radialPolyZ n d y : ℝ) =
      α * (radialPolyZ n d y : ℝ) + μ * (radialPolyZ n d y : ℝ) +
        ((k * radialPolyZ n d y : ℤ) : ℝ) := by
    push_cast; ring
  rw [this, eC_add, eC_intCast, mul_one]

/-- Blueprint Lemma 12.1 (`lem:kernelerror`), via eq. (`eq:liftkernel`): for `α = a/q`, `q ≥ 1`,
the kernel of `Lift_{s,α}[Φ_{j,μ}]` is `e(α P(y)) (h_{j,μ} *_E φ_s)(y)` for every `y ∈ G`. -/
theorem latKernel_liftSym_radialOscPhi (hΩ : IsSWProfile Ω) (p : ℝ) (s a : ℕ) {q : ℕ}
    (hq : 1 ≤ q) (j : ℤ) (μ : ℝ) (y : Fin n → ℤ) :
    latKernel (liftSym n d Ω p s a q (radialOscPhi Ω d j μ)) y =
      eC ((a : ℝ) / q * (radialPolyZ n d y : ℝ)) *
        (majorH Ω d j μ ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] liftPhi n d Ω p s)
          (latEmbed y) := by
  have hH : Integrable (majorH Ω d j μ) := integrable_oscKernel hΩ d j μ
  obtain ⟨hFc, hFb⟩ := continuous_fourier_and_norm_le hH
  rw [radialOscPhi_eq_fourier_majorH,
    latKernel_liftSym_of_bdd s a hq hFc.aestronglyMeasurable (fun ξ _ => hFb ξ) y,
    fourierInv_fourier_mul_liftChi hH]

/-- **Blueprint Lemma 12.1 (`lem:kernelerror`)**, lattice kernel formula: if `λ = α + μ` in `𝕋`
(`λ - a/q - μ ∈ ℤ`), with `α = a/q`, `q ≥ 1` (in particular `α ∈ 𝓡_s`), then for every
`f ∈ ℓ¹(G)` (e.g. finitely supported) and `x ∈ G`,
`T_{j,λ} f(x) - Lift_{s,α}[Φ_{j,μ}](D) f(x) =
  ∑_y e(α P(y)) [h_{j,μ}(y) - (h_{j,μ} *_E φ_s)(y)] f(x - y)`,
i.e. the lattice convolution kernel of `T_{j,λ} - Lift_{s,α}[Φ_{j,μ}](D)` is
`e(α P(y)) [h_{j,μ}(y) - (h_{j,μ} *_E φ_s)(y)]`, including its value at `y = 0`. -/
theorem major_kernel_formula (hΩ : IsSWProfile Ω) (p : ℝ) (s a : ℕ) {q : ℕ} (hq : 1 ≤ q)
    (j : ℕ) {lam μ : ℝ} (hlam : ∃ k : ℤ, lam = a / q + μ + k) {f : (Fin n → ℤ) → ℂ}
    (hf : Summable fun z => ‖f z‖) (x : Fin n → ℤ) :
    minorOp Ω d j lam f x - latMult (liftSym n d Ω p s a q (radialOscPhi Ω d j μ)) f x =
      ∑' y, eC ((a : ℝ) / q * (radialPolyZ n d y : ℝ)) *
        (majorH Ω d j μ (latEmbed y) -
          (majorH Ω d j μ ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] liftPhi n d Ω p s)
            (latEmbed y)) * f (x - y) := by
  set H := majorH Ω d j μ with hHdef
  have hH : Integrable H := integrable_oscKernel hΩ d j μ
  obtain ⟨hFc, hFb⟩ := continuous_fourier_and_norm_le hH
  have hint : IntegrableOn (liftSym n d Ω p s a q (𝓕 H)) (torusCube n) :=
    integrableOn_liftSym (integrable_mul_liftChi hFc.aestronglyMeasurable (fun ξ _ => hFb ξ))
  have hker : ∀ y, latKernel (liftSym n d Ω p s a q (𝓕 H)) y =
      eC ((a : ℝ) / q * (radialPolyZ n d y : ℝ)) *
        (H ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] liftPhi n d Ω p s) (latEmbed y) := by
    intro y
    rw [← radialOscPhi_eq_fourier_majorH]
    exact latKernel_liftSym_radialOscPhi hΩ p s a hq j μ y
  rw [radialOscPhi_eq_fourier_majorH, latMult_eq_latConv hint hf, latConv, minorOp]
  have hs1 : Summable fun y : Fin n → ℤ =>
      eC (lam * (radialPolyZ n d y : ℝ)) * dyadicKernel Ω j (latEmbed y) * f (x - y) := by
    refine summable_of_ne_finset_zero (s := minorBox n (2 * 2 ^ j)) fun y hy => ?_
    rw [minor_kernel_eq_zero j hy, mul_zero, zero_mul]
  have hfx : Summable fun y => ‖f (x - y)‖ :=
    (Equiv.subLeft x).summable_iff.2 hf
  have hs2 : Summable fun y => latKernel (liftSym n d Ω p s a q (𝓕 H)) y * f (x - y) := by
    refine Summable.of_norm_bounded (hfx.mul_left (∫ ξ in torusCube n,
      ‖liftSym n d Ω p s a q (𝓕 H) ξ‖)) fun y => ?_
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_right (norm_latKernel_le_integral _ y) (norm_nonneg _)
  rw [← hs1.tsum_sub hs2]
  refine tsum_congr fun y => ?_
  rw [hker, eC_mul_radialPolyZ_of_eq_add d hlam y, hHdef, majorH]
  ring

end MajorArcs

