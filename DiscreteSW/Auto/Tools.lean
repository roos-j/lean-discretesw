open scoped Convolution ComplexConjugate

/-! ### Lemma 2.2, first assertion (Young's inequality) -/

/-- Hölder with the weight `K`: `(∫ K v)^p ≤ (∫ K)^(p-1) ∫ K v^p` for `1 ≤ p`. -/
lemma lintegral_mul_rpow_le_young {α : Type*} [MeasurableSpace α] (μ : Measure α) {p : ℝ}
    (hp : 1 ≤ p) {K v : α → ℝ≥0∞} (hK : AEMeasurable K μ) (hv : AEMeasurable v μ) :
    (∫⁻ a, K a * v a ∂μ) ^ p ≤ (∫⁻ a, K a ∂μ) ^ (p - 1) * ∫⁻ a, K a * v a ^ p ∂μ := by
  rcases hp.eq_or_lt with rfl | hp1
  · simp
  set q := p.conjExponent
  have hpq : p.HolderConjugate q := Real.HolderConjugate.conjExponent hp1
  have hp0 : 0 < p := by linarith
  have hq0 : 0 < q := hpq.symm.pos
  have hH := ENNReal.lintegral_mul_le_Lp_mul_Lq μ hpq
    (f := fun a => K a ^ (1 / p) * v a) (g := fun a => K a ^ (1 / q))
    ((hK.pow_const _).mul hv) (hK.pow_const _)
  have e1 : ∀ a, ((fun a => K a ^ (1 / p) * v a) * fun a => K a ^ (1 / q)) a = K a * v a := by
    intro a
    simp only [Pi.mul_apply]
    rw [mul_comm (K a ^ (1 / p)), mul_assoc, ← ENNReal.rpow_add_of_nonneg _ _ (by positivity)
      (by positivity), one_div, one_div, hpq.inv_add_inv_eq_one, ENNReal.rpow_one, mul_comm]
  have e2 : ∀ a, (K a ^ (1 / p) * v a) ^ p = K a * v a ^ p := by
    intro a
    rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le, ← ENNReal.rpow_mul, one_div_mul_cancel hp0.ne',
      ENNReal.rpow_one]
  have e3 : ∀ a, (K a ^ (1 / q)) ^ q = K a := by
    intro a
    rw [← ENNReal.rpow_mul, one_div_mul_cancel hq0.ne', ENNReal.rpow_one]
  simp only [e1, e2, e3] at hH
  calc (∫⁻ a, K a * v a ∂μ) ^ p
      ≤ ((∫⁻ a, K a * v a ^ p ∂μ) ^ (1 / p) * (∫⁻ a, K a ∂μ) ^ (1 / q)) ^ p :=
        ENNReal.rpow_le_rpow hH hp0.le
    _ = (∫⁻ a, K a ∂μ) ^ (p - 1) * ∫⁻ a, K a * v a ^ p ∂μ := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le, ← ENNReal.rpow_mul, ← ENNReal.rpow_mul,
          one_div_mul_cancel hp0.ne', ENNReal.rpow_one, mul_comm]
        congr 2
        rw [← hpq.div_conj_eq_sub_one]; field_simp

/-- Young's inequality for nonnegative functions in `lintegral` form. -/
lemma lintegral_young {G : Type*} [AddCommGroup G] [MeasurableSpace G] [MeasurableAdd₂ G]
    [MeasurableNeg G] {μ : Measure G} [SFinite μ] [μ.IsAddRightInvariant] {p : ℝ} (hp : 1 ≤ p)
    {K u : G → ℝ≥0∞} (hK : Measurable K) (hu : Measurable u) :
    ∫⁻ x, (∫⁻ y, K y * u (x - y) ∂μ) ^ p ∂μ ≤ (∫⁻ y, K y ∂μ) ^ p * ∫⁻ x, u x ^ p ∂μ := by
  have hp0 : 0 < p := by linarith
  have hm : Measurable fun z : G × G => K z.2 * u (z.1 - z.2) ^ p :=
    (hK.comp measurable_snd).mul ((hu.comp measurable_sub).pow_const _)
  calc ∫⁻ x, (∫⁻ y, K y * u (x - y) ∂μ) ^ p ∂μ
      ≤ ∫⁻ x, (∫⁻ y, K y ∂μ) ^ (p - 1) * ∫⁻ y, K y * u (x - y) ^ p ∂μ ∂μ :=
        lintegral_mono fun x => lintegral_mul_rpow_le_young μ hp hK.aemeasurable
          (hu.comp (measurable_const.sub measurable_id)).aemeasurable
    _ = (∫⁻ y, K y ∂μ) ^ (p - 1) * ∫⁻ x, ∫⁻ y, K y * u (x - y) ^ p ∂μ ∂μ :=
        lintegral_const_mul _ hm.lintegral_prod_right'
    _ = (∫⁻ y, K y ∂μ) ^ (p - 1) * ∫⁻ y, ∫⁻ x, K y * u (x - y) ^ p ∂μ ∂μ := by
        rw [lintegral_lintegral_swap hm.aemeasurable]
    _ = (∫⁻ y, K y ∂μ) ^ (p - 1) * ∫⁻ y, K y * ∫⁻ x, u x ^ p ∂μ ∂μ := by
        congr 1
        refine lintegral_congr fun y => ?_
        rw [lintegral_const_mul (f := fun x => u (x - y) ^ p) _
          ((hu.comp (measurable_id.sub_const y)).pow_const p),
          lintegral_sub_right_eq_self (fun x => u x ^ p) y]
    _ = (∫⁻ y, K y ∂μ) ^ p * ∫⁻ x, u x ^ p ∂μ := by
        rw [lintegral_mul_const _ hK, ← mul_assoc]
        congr 1
        conv_rhs => rw [show p = (p - 1) + 1 by ring]
        rw [ENNReal.rpow_add_of_nonneg _ _ (by linarith) zero_le_one, ENNReal.rpow_one]

section YoungGroup

variable {G : Type*} [AddCommGroup G] [MeasurableSpace G] [MeasurableAdd₂ G]
    [MeasurableNeg G] {μ : Measure G} [SFinite μ] [μ.IsAddLeftInvariant]

/-- Replacing `K`, `u` by measurable modifications does not change `∫ K(y) u(x - y) dy`. -/
lemma lintegral_mul_sub_eq_mk {K u : G → ℝ≥0∞} (hK : AEMeasurable K μ) (hu : AEMeasurable u μ)
    (x : G) : ∫⁻ y, K y * u (x - y) ∂μ = ∫⁻ y, hK.mk K y * hu.mk u (x - y) ∂μ :=
  lintegral_congr_ae (hK.ae_eq_mk.mul (hu.ae_eq_mk.comp_tendsto
    (quasiMeasurePreserving_sub_left_of_right_invariant μ x).tendsto_ae))

/-- The nonnegative convolution `x ↦ ∫ K(y) u(x - y) dy` is a.e. measurable. -/
lemma aemeasurable_lintegral_mul_sub {K u : G → ℝ≥0∞} (hK : AEMeasurable K μ)
    (hu : AEMeasurable u μ) : AEMeasurable (fun x => ∫⁻ y, K y * u (x - y) ∂μ) μ := by
  simp_rw [lintegral_mul_sub_eq_mk hK hu]
  exact (((hK.measurable_mk.comp measurable_snd).mul
    (hu.measurable_mk.comp measurable_sub)).lintegral_prod_right').aemeasurable

/-- Young's inequality for a.e.-measurable nonnegative functions in `lintegral` form. -/
lemma lintegral_young' {p : ℝ} (hp : 1 ≤ p) {K u : G → ℝ≥0∞} (hK : AEMeasurable K μ)
    (hu : AEMeasurable u μ) :
    ∫⁻ x, (∫⁻ y, K y * u (x - y) ∂μ) ^ p ∂μ ≤ (∫⁻ y, K y ∂μ) ^ p * ∫⁻ x, u x ^ p ∂μ := by
  simp_rw [lintegral_mul_sub_eq_mk hK hu]
  have h2 : (fun x => u x ^ p) =ᵐ[μ] fun x => hu.mk u x ^ p :=
    hu.ae_eq_mk.mono fun x hx => by simp only [hx]
  rw [lintegral_congr_ae hK.ae_eq_mk, lintegral_congr_ae h2]
  exact lintegral_young hp hK.measurable_mk hu.measurable_mk


/-- For `f ∈ L^∞`, the nonnegative convolution is bounded by `‖k‖₁ ‖f‖_∞` everywhere. -/
lemma lintegral_enorm_mul_sub_le_top {E F : Type*} [NormedAddCommGroup E]
    [NormedAddCommGroup F] {k : G → E} {f : G → F}
    (hk : AEStronglyMeasurable k μ) (hf : AEStronglyMeasurable f μ) (x : G) :
    ∫⁻ y, ‖k y‖ₑ * ‖f (x - y)‖ₑ ∂μ ≤ eLpNorm k 1 μ * eLpNorm f ∞ μ := by
  have h : ∀ᵐ y ∂μ, ‖f (x - y)‖ₑ ≤ eLpNormEssSup f μ :=
    (quasiMeasurePreserving_sub_left_of_right_invariant μ x).tendsto_ae.eventually
      ae_le_eLpNormEssSup
  calc ∫⁻ y, ‖k y‖ₑ * ‖f (x - y)‖ₑ ∂μ ≤ ∫⁻ y, ‖k y‖ₑ * eLpNormEssSup f μ ∂μ :=
        lintegral_mono_ae (h.mono fun y hy => mul_le_mul_right hy _)
    _ = eLpNorm k 1 μ * eLpNorm f ∞ μ := by
        rw [lintegral_mul_const'' _ hk.enorm, eLpNorm_one_eq_lintegral_enorm hk,
          eLpNorm_exponent_top hf]

/-- Blueprint Lemma 2.2 (`lem:young`), first assertion, nonnegative general form: Young's
inequality for the nonnegative convolution `x ↦ ∫ |k(y)| |f(x - y)| dy`:
`‖ ∫ |k(y)| |f(· - y)| dy ‖_p ≤ ‖k‖₁ ‖f‖_p` for `1 ≤ p ≤ ∞`. -/
theorem eLpNorm_lintegral_enorm_mul_sub_le {E F : Type*} [NormedAddCommGroup E]
    [NormedAddCommGroup F] {p : ℝ≥0∞} (hp : 1 ≤ p) {k : G → E} {f : G → F}
    (hk : AEStronglyMeasurable k μ) (hf : AEStronglyMeasurable f μ) :
    eLpNorm (fun x => ∫⁻ y, ‖k y‖ₑ * ‖f (x - y)‖ₑ ∂μ) p μ ≤ eLpNorm k 1 μ * eLpNorm f p μ := by
  rcases eq_or_ne p ∞ with rfl | hpt
  · rw [eLpNorm_exponent_top
      (aemeasurable_lintegral_mul_sub hk.enorm hf.enorm).aestronglyMeasurable]
    exact eLpNormEssSup_le_of_ae_enorm_bound (Eventually.of_forall fun x => by
      rw [enorm_eq_self]; exact lintegral_enorm_mul_sub_le_top hk hf x)
  have hp0 : p ≠ 0 := (lt_of_lt_of_le zero_lt_one hp).ne'
  have hr1 : 1 ≤ p.toReal := by
    rw [← ENNReal.toReal_one]; exact ENNReal.toReal_mono hpt hp
  have hr : 0 < p.toReal := by linarith
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 hpt
      (aemeasurable_lintegral_mul_sub hk.enorm hf.enorm).aestronglyMeasurable,
    eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 hpt hf, eLpNorm_one_eq_lintegral_enorm hk]
  simp only [enorm_eq_self]
  calc (∫⁻ x, (∫⁻ y, ‖k y‖ₑ * ‖f (x - y)‖ₑ ∂μ) ^ p.toReal ∂μ) ^ (1 / p.toReal)
      ≤ ((∫⁻ y, ‖k y‖ₑ ∂μ) ^ p.toReal * ∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂μ) ^ (1 / p.toReal) :=
        ENNReal.rpow_le_rpow (lintegral_young' hr1 hk.enorm hf.enorm) (by positivity)
    _ = (∫⁻ y, ‖k y‖ₑ ∂μ) * (∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂μ) ^ (1 / p.toReal) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul,
          mul_one_div_cancel hr.ne', ENNReal.rpow_one]

/-- The convolution integrand `k(y) f(x - y)` is integrable as soon as its `lintegral` is
finite. -/
lemma convolutionExistsAt_of_lintegral_lt_top {k f : G → ℂ} (hk : AEStronglyMeasurable k μ)
    (hf : AEStronglyMeasurable f μ) {x : G} (h : ∫⁻ y, ‖k y‖ₑ * ‖f (x - y)‖ₑ ∂μ < ∞) :
    ConvolutionExistsAt k f x (ContinuousLinearMap.mul ℂ ℂ) μ := by
  refine ⟨?_, ?_⟩
  · simp only [ContinuousLinearMap.mul_apply']
    exact hk.mul (hf.comp_quasiMeasurePreserving
      (quasiMeasurePreserving_sub_left_of_right_invariant μ x))
  · simpa [HasFiniteIntegral, enorm_mul] using h

omit [MeasurableAdd₂ G] [MeasurableNeg G] [SFinite μ] [μ.IsAddLeftInvariant] in
/-- Pointwise bound `|k * f(x)| ≤ ∫ |k(y)| |f(x - y)| dy`. -/
lemma enorm_convolution_mul_le (k f : G → ℂ) (x : G) :
    ‖(k ⋆[ContinuousLinearMap.mul ℂ ℂ, μ] f) x‖ₑ ≤ ∫⁻ y, ‖k y‖ₑ * ‖f (x - y)‖ₑ ∂μ := by
  rw [convolution_def]
  refine (enorm_integral_le_lintegral_enorm _).trans_eq ?_
  simp [enorm_mul]

/-- Blueprint Lemma 2.2 (`lem:young`), first assertion, general form: Young's inequality
`‖k * f‖_p ≤ ‖k‖₁ ‖f‖_p` (`1 ≤ p ≤ ∞`) on an abelian measurable group
with an invariant s-finite measure; no integrability assumptions are needed (both sides may be
infinite, and the convolution is `0` where the integral does not exist). -/
theorem eLpNorm_convolution_le_mul {p : ℝ≥0∞} (hp : 1 ≤ p) {k f : G → ℂ}
    (hk : AEStronglyMeasurable k μ) (hf : AEStronglyMeasurable f μ) :
    eLpNorm (k ⋆[ContinuousLinearMap.mul ℂ ℂ, μ] f) p μ ≤ eLpNorm k 1 μ * eLpNorm f p μ :=
  (eLpNorm_mono_enorm (AEStronglyMeasurable.convolution (ContinuousLinearMap.mul ℂ ℂ) hk hf)
    fun x => by rw [enorm_eq_self]; exact enorm_convolution_mul_le k f x).trans
    (eLpNorm_lintegral_enorm_mul_sub_le hp hk hf)

/-- Blueprint Lemma 2.2 (`lem:young`), first assertion, general form (existence): for `k ∈ L¹`
and `f ∈ L^p` (`1 ≤ p ≤ ∞`) the convolution integral `∫ k(y) f(x - y) dy`
converges absolutely for almost every `x`. -/
theorem ae_convolutionExistsAt_of_memLp {p : ℝ≥0∞} (hp : 1 ≤ p) {k f : G → ℂ}
    (hk : MemLp k 1 μ) (hf : MemLp f p μ) :
    ∀ᵐ x ∂μ, ConvolutionExistsAt k f x (ContinuousLinearMap.mul ℂ ℂ) μ := by
  have hfin : eLpNorm k 1 μ * eLpNorm f p μ < ∞ := ENNReal.mul_lt_top hk hf
  rcases eq_or_ne p ∞ with rfl | hpt
  · exact Eventually.of_forall fun x => convolutionExistsAt_of_lintegral_lt_top hk.aestronglyMeasurable hf.aestronglyMeasurable
      ((lintegral_enorm_mul_sub_le_top hk.aestronglyMeasurable hf.aestronglyMeasurable x).trans_lt hfin)
  have hp0 : p ≠ 0 := (lt_of_lt_of_le zero_lt_one hp).ne'
  have hr : 0 < p.toReal := ENNReal.toReal_pos hp0 hpt
  have hI := (eLpNorm_lintegral_enorm_mul_sub_le hp hk.aestronglyMeasurable hf.aestronglyMeasurable).trans_lt hfin
  have hint := lintegral_rpow_enorm_lt_top_of_eLpNorm_lt_top hp0 hpt hI
  simp only [enorm_eq_self] at hint
  have hae := ae_lt_top' ((aemeasurable_lintegral_mul_sub hk.aestronglyMeasurable.enorm hf.aestronglyMeasurable.enorm).pow_const
    p.toReal) hint.ne
  filter_upwards [hae] with x hx
  refine convolutionExistsAt_of_lintegral_lt_top hk.aestronglyMeasurable hf.aestronglyMeasurable ?_
  exact (ENNReal.rpow_lt_top_iff_of_pos hr).1 hx

/-- Blueprint Lemma 2.2 (`lem:young`), first assertion, general `MemLp` form: `k ∈ L¹`,
`f ∈ L^p` (`1 ≤ p ≤ ∞`) imply `k * f ∈ L^p`. -/
theorem memLp_convolution_of_memLp {p : ℝ≥0∞} (hp : 1 ≤ p) {k f : G → ℂ}
    (hk : MemLp k 1 μ) (hf : MemLp f p μ) :
    MemLp (k ⋆[ContinuousLinearMap.mul ℂ ℂ, μ] f) p μ :=
  (eLpNorm_convolution_le_mul hp hk.aestronglyMeasurable hf.aestronglyMeasurable).trans_lt
    (ENNReal.mul_lt_top hk hf)

end YoungGroup

/-! ### Young on `E = ℝⁿ` -/

/-- Blueprint Lemma 2.2 (`lem:young`), first assertion on `E`: for `1 ≤ p ≤ ∞`, `k ∈ L¹(ℝⁿ)` and
`f ∈ L^p(ℝⁿ)`, the convolution integral `k * f(x) = ∫ k(y) f(x - y) dy` converges absolutely for
a.e. `x`, and `‖k * f‖_p ≤ ‖k‖₁ ‖f‖_p` (in particular `k * f ∈ L^p`). -/
theorem young_convolution_euclidean {n : ℕ} {p : ℝ≥0∞} (hp : 1 ≤ p)
    {k f : EuclideanSpace ℝ (Fin n) → ℂ} (hk : MemLp k 1 volume) (hf : MemLp f p volume) :
    (∀ᵐ x ∂volume, ConvolutionExistsAt k f x (ContinuousLinearMap.mul ℂ ℂ) volume) ∧
      eLpNorm (k ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] f) p volume ≤
        eLpNorm k 1 volume * eLpNorm f p volume ∧
      MemLp (k ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] f) p volume :=
  ⟨ae_convolutionExistsAt_of_memLp hp hk hf,
    eLpNorm_convolution_le_mul hp hk.aestronglyMeasurable hf.aestronglyMeasurable,
    memLp_convolution_of_memLp hp hk hf⟩

/-! ### Young on `G = ℤⁿ` -/

/-- The lattice convolution `k * f(x) = ∑_{y ∈ ℤⁿ} k(y) f(x - y)` on `G = ℤⁿ`. -/
noncomputable def latConv {n : ℕ} (k f : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) : ℂ :=
  ∑' y, k y * f (x - y)

/-- The lattice convolution is the measure-theoretic convolution for counting measure. -/
theorem latConv_eq_convolution {n : ℕ} (k f : (Fin n → ℤ) → ℂ) :
    latConv k f = k ⋆[ContinuousLinearMap.mul ℂ ℂ, Measure.count] f := by
  funext x
  rw [convolution_def, latConv]
  simp only [ContinuousLinearMap.mul_apply']
  by_cases h : Integrable (fun y => k y * f (x - y)) Measure.count
  · rw [integral_countable h]
    simp
  · rw [integral_undef h, tsum_eq_zero_of_not_summable]
    intro hs
    exact h (integrable_count_iff.2 (summable_norm_iff.2 hs))

/-- Blueprint Lemma 2.2 (`lem:young`), first assertion on `G`, nonnegative form: for
`1 ≤ p ≤ ∞` and arbitrary `k, f : ℤⁿ → ℂ`,
`‖∑_y |k(y)| |f(· - y)|‖_p ≤ ‖k‖₁ ‖f‖_p` (both sides in `[0, ∞]`). -/
theorem eLpNorm_tsum_enorm_mul_sub_le {n : ℕ} {p : ℝ≥0∞} (hp : 1 ≤ p)
    (k f : (Fin n → ℤ) → ℂ) :
    eLpNorm (fun x => ∑' y, ‖k y‖ₑ * ‖f (x - y)‖ₑ) p Measure.count ≤
      eLpNorm k 1 Measure.count * eLpNorm f p Measure.count := by
  simpa only [lintegral_count] using eLpNorm_lintegral_enorm_mul_sub_le (μ := Measure.count) hp
    (AEStronglyMeasurable.of_discrete (f := k)) (AEStronglyMeasurable.of_discrete (f := f))

/-- Blueprint Lemma 2.2 (`lem:young`), first assertion on `G`: for `1 ≤ p ≤ ∞`, `k ∈ ℓ¹(ℤⁿ)` and
`f ∈ ℓ^p(ℤⁿ)`, the series `k * f(x) = ∑_y k(y) f(x - y)` is (absolutely) summable for every
`x`, and `‖k * f‖_p ≤ ‖k‖₁ ‖f‖_p` (in particular `k * f ∈ ℓ^p`). -/
theorem young_latConv {n : ℕ} {p : ℝ≥0∞} (hp : 1 ≤ p) {k f : (Fin n → ℤ) → ℂ}
    (hk : MemLp k 1 Measure.count) (hf : MemLp f p Measure.count) :
    (∀ x, Summable fun y => k y * f (x - y)) ∧
      eLpNorm (latConv k f) p Measure.count ≤
        eLpNorm k 1 Measure.count * eLpNorm f p Measure.count ∧
      MemLp (latConv k f) p Measure.count := by
  refine ⟨fun x => ?_, ?_, ?_⟩
  · have h := Measure.ae_count_iff.1 (ae_convolutionExistsAt_of_memLp hp hk hf) x
    have h' : Integrable (fun y => k y * f (x - y)) Measure.count := by
      simpa only [ConvolutionExistsAt, ContinuousLinearMap.mul_apply'] using h
    exact summable_norm_iff.1 (integrable_count_iff.1 h')
  · rw [latConv_eq_convolution]
    exact eLpNorm_convolution_le_mul hp AEStronglyMeasurable.of_discrete
      AEStronglyMeasurable.of_discrete
  · rw [latConv_eq_convolution]
    exact memLp_convolution_of_memLp hp hk hf

/-! ### Lemma 2.2, second assertion (dual testing) -/

section Duality

variable {α : Type*} [MeasurableSpace α] {μ : Measure α}

/-- `eLpNorm` with a real exponent `p > 0` in `lintegral` form. -/
lemma eLpNorm_ofReal_eq_lintegral {E : Type*} [NormedAddCommGroup E] {f : α → E}
    (hf : AEStronglyMeasurable f μ) {p : ℝ} (hp : 0 < p) :
    eLpNorm f (ENNReal.ofReal p) μ = (∫⁻ x, ‖f x‖ₑ ^ p ∂μ) ^ (1 / p) := by
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simpa using hp) ENNReal.ofReal_ne_top hf,
    ENNReal.toReal_ofReal hp.le]

/-- Blueprint Lemma 2.2 (`lem:young`), second assertion, upper bound (Hölder): for Hölder
conjugate `p, q` and measurable `h, g`, `|∫ h ḡ| ≤ ‖h‖_p ‖g‖_q`. -/
theorem enorm_integral_mul_conj_le {p q : ℝ} (hpq : p.HolderConjugate q) {h g : α → ℂ}
    (hh : AEStronglyMeasurable h μ) (hg : AEStronglyMeasurable g μ) :
    ‖∫ x, h x * conj (g x) ∂μ‖ₑ ≤
      eLpNorm h (ENNReal.ofReal p) μ * eLpNorm g (ENNReal.ofReal q) μ := by
  calc ‖∫ x, h x * conj (g x) ∂μ‖ₑ ≤ ∫⁻ x, ‖h x * conj (g x)‖ₑ ∂μ :=
        enorm_integral_le_lintegral_enorm _
    _ = ∫⁻ x, ((fun x => ‖h x‖ₑ) * fun x => ‖g x‖ₑ) x ∂μ := by
        congr 1; funext x; simp [enorm_mul]
    _ ≤ (∫⁻ x, ‖h x‖ₑ ^ p ∂μ) ^ (1 / p) * (∫⁻ x, ‖g x‖ₑ ^ q ∂μ) ^ (1 / q) :=
        ENNReal.lintegral_mul_le_Lp_mul_Lq μ hpq hh.enorm hg.enorm
    _ = _ := by
        rw [eLpNorm_ofReal_eq_lintegral hh hpq.pos, eLpNorm_ofReal_eq_lintegral hg hpq.symm.pos]

/-- Scaling the dual-testing hypothesis: a bound `A` over normalized tests gives
`|∫ h ḡ| ≤ A ‖g‖_q` for every (not necessarily normalized) test `g` with `‖g‖_q < ∞`. -/
lemma enorm_integral_le_of_dual_test {q : ℝ} (hq : 0 < q) {h : α → ℂ} {A : ℝ≥0∞}
    (hA : ∀ g : α → ℂ, Measurable g → (∃ C, ∀ x, ‖g x‖ ≤ C) → μ (Function.support g) < ∞ →
      eLpNorm g (ENNReal.ofReal q) μ ≤ 1 → Integrable (fun x => h x * conj (g x)) μ →
      ‖∫ x, h x * conj (g x) ∂μ‖ₑ ≤ A)
    {g : α → ℂ} (hgm : Measurable g) (hgb : ∃ C, ∀ x, ‖g x‖ ≤ C)
    (hgs : μ (Function.support g) < ∞) (hgi : Integrable (fun x => h x * conj (g x)) μ)
    (hfin : eLpNorm g (ENNReal.ofReal q) μ < ∞) :
    ‖∫ x, h x * conj (g x) ∂μ‖ₑ ≤ A * eLpNorm g (ENNReal.ofReal q) μ := by
  set s := eLpNorm g (ENNReal.ofReal q) μ with hs
  by_cases hs0 : s = 0
  · have hg0 : g =ᵐ[μ] 0 := (eLpNorm_eq_zero_iff (by simpa using hq)).1 hs0
    have : ∫ x, h x * conj (g x) ∂μ = 0 := by
      rw [integral_eq_zero_of_ae]
      filter_upwards [hg0] with x hx
      simp [hx]
    simp [this]
  set c : ℝ := (s.toReal)⁻¹
  have hspos : 0 < s.toReal := ENNReal.toReal_pos hs0 hfin.ne
  have hc : 0 < c := inv_pos.2 hspos
  have hcs : ENNReal.ofReal c = s⁻¹ := by
    rw [ENNReal.ofReal_inv_of_pos hspos, ENNReal.ofReal_toReal hfin.ne]
  obtain ⟨C, hC⟩ := hgb
  have key := hA (fun x => (c : ℂ) * g x) (measurable_const.mul hgm)
    ⟨c * C, fun x => by
      rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg hc.le]
      exact mul_le_mul_of_nonneg_left (hC x) hc.le⟩
    ((measure_mono (Function.support_mul_subset_right _ _)).trans_lt hgs)
    (by
      have : (fun x => (c : ℂ) * g x) = (c : ℂ) • g := rfl
      rw [this, eLpNorm_const_smul, ← hs, ← ofReal_norm, Complex.norm_real,
        Real.norm_of_nonneg hc.le, hcs, ENNReal.inv_mul_cancel hs0 hfin.ne])
    (by
      simp only [map_mul, Complex.conj_ofReal]
      simpa [mul_left_comm] using hgi.const_mul (c : ℂ))
  have e : ∫ x, h x * conj ((c : ℂ) * g x) ∂μ = (c : ℂ) * ∫ x, h x * conj (g x) ∂μ := by
    simp only [map_mul, Complex.conj_ofReal]
    rw [← integral_const_mul]
    congr 1; funext x; ring
  rw [e, enorm_mul, ← ofReal_norm, Complex.norm_real, Real.norm_of_nonneg hc.le,
    hcs] at key
  calc ‖∫ x, h x * conj (g x) ∂μ‖ₑ = s * (s⁻¹ * ‖∫ x, h x * conj (g x) ∂μ‖ₑ) := by
        rw [← mul_assoc, ENNReal.mul_inv_cancel hs0 hfin.ne, one_mul]
    _ ≤ s * A := mul_le_mul_right key _
    _ = A * s := mul_comm _ _


/-- Arithmetic step of dual testing: `L ≤ A L^{1/q}` with `L < ∞` gives `L^{1/p} ≤ A`. -/
lemma rpow_le_of_le_mul_rpow {p q : ℝ} (hpq : p.HolderConjugate q) {L A : ℝ≥0∞} (hL : L ≠ ∞)
    (h : L ≤ A * L ^ (1 / q)) : L ^ (1 / p) ≤ A := by
  by_cases hL0 : L = 0
  · rw [hL0, ENNReal.zero_rpow_of_pos (by have := hpq.pos; positivity)]; exact zero_le
  have hsplit : L = L ^ (1 / p) * L ^ (1 / q) := by
    rw [← ENNReal.rpow_add _ _ hL0 hL, one_div, one_div, hpq.inv_add_inv_eq_one,
      ENNReal.rpow_one]
  have hne0 : L ^ (1 / q) ≠ 0 := by
    have := hpq.symm.pos
    exact (ENNReal.rpow_pos (pos_iff_ne_zero.2 hL0) hL).ne'
  have hnet : L ^ (1 / q) ≠ ∞ := ENNReal.rpow_ne_top_of_nonneg (by have := hpq.symm.pos; positivity) hL
  have h' : L ^ (1 / p) * L ^ (1 / q) ≤ A * L ^ (1 / q) := hsplit.symm.le.trans h
  exact (ENNReal.mul_le_mul_iff_left hne0 hnet).1 h'

/-- Dual testing on a truncation: if `h` is strongly measurable and `|h| ≤ N` on a measurable
set `S` of finite measure, the dual-testing bound `A` controls `‖h 𝟙_S‖_p`. The test function is
`g = h 𝟙_S |h 𝟙_S|^{p-2}`. -/
lemma eLpNorm_indicator_le_of_dual_test {p q : ℝ} (hpq : p.HolderConjugate q) {h : α → ℂ}
    (hh : StronglyMeasurable h) {S : Set α} (hS : MeasurableSet S) (hμS : μ S < ∞) {N : ℝ}
    (hN : ∀ x ∈ S, ‖h x‖ ≤ N) {A : ℝ≥0∞}
    (hA : ∀ g : α → ℂ, Measurable g → (∃ C, ∀ x, ‖g x‖ ≤ C) → μ (Function.support g) < ∞ →
      eLpNorm g (ENNReal.ofReal q) μ ≤ 1 → Integrable (fun x => h x * conj (g x)) μ →
      ‖∫ x, h x * conj (g x) ∂μ‖ₑ ≤ A) :
    eLpNorm (S.indicator h) (ENNReal.ofReal p) μ ≤ A := by
  have hp := hpq.pos
  have hq := hpq.symm.pos
  have hp1 : 0 < p - 1 := hpq.sub_one_pos
  set u := S.indicator h with hu_def
  have hu : StronglyMeasurable u := hh.indicator hS
  have huN : ∀ x, ‖u x‖ ≤ max N 0 := by
    intro x
    by_cases hx : x ∈ S
    · rw [hu_def, indicator_of_mem hx]; exact (hN x hx).trans (le_max_left _ _)
    · rw [hu_def, indicator_of_notMem hx, norm_zero]; exact le_max_right _ _
  set L := ∫⁻ x, ‖u x‖ₑ ^ p ∂μ with hL_def
  have hLfin : L < ∞ := by
    calc L ≤ ∫⁻ x, S.indicator (fun _ => ENNReal.ofReal (max N 0) ^ p) x ∂μ := by
          refine lintegral_mono fun x => ?_
          by_cases hx : x ∈ S
          · rw [indicator_of_mem hx, ← ofReal_norm]
            exact ENNReal.rpow_le_rpow (ENNReal.ofReal_le_ofReal (huN x)) hp.le
          · rw [indicator_of_notMem hx, hu_def, indicator_of_notMem hx, enorm_zero,
              ENNReal.zero_rpow_of_pos hp]
      _ < ∞ := by
          rw [lintegral_indicator_const hS]
          exact ENNReal.mul_lt_top (ENNReal.rpow_lt_top_of_nonneg hp.le ENNReal.ofReal_ne_top) hμS
  set g : α → ℂ := fun x => u x * ((‖u x‖ ^ (p - 2) : ℝ) : ℂ) with hg_def
  have hgn : ∀ x, ‖g x‖ = ‖u x‖ ^ (p - 1) := by
    intro x
    by_cases hux : u x = 0
    · simp [hg_def, hux, Real.zero_rpow hp1.ne']
    · have hpos : 0 < ‖u x‖ := norm_pos_iff.2 hux
      rw [hg_def, norm_mul, Complex.norm_real, Real.norm_of_nonneg (by positivity)]
      rw [show p - 1 = 1 + (p - 2) by ring, Real.rpow_add hpos, Real.rpow_one]
  have hge : ∀ x, ‖g x‖ₑ = ‖u x‖ₑ ^ (p - 1) := by
    intro x
    rw [← ofReal_norm, hgn, ← ofReal_norm, ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hp1.le]
  have hpair : ∀ x, h x * conj (g x) = ((‖u x‖ ^ p : ℝ) : ℂ) := by
    intro x
    by_cases hx : x ∈ S
    · have hux' : u x = h x := by rw [hu_def, indicator_of_mem hx]
      rw [← hux']
      by_cases hux : u x = 0
      · simp [hg_def, hux, Real.zero_rpow hp.ne']
      · have hpos : 0 < ‖u x‖ := norm_pos_iff.2 hux
        rw [hg_def]
        simp only [map_mul, Complex.conj_ofReal]
        rw [← mul_assoc, Complex.mul_conj']
        have : ‖u x‖ ^ p = ‖u x‖ ^ (2 : ℝ) * ‖u x‖ ^ (p - 2) := by
          rw [← Real.rpow_add hpos]; ring_nf
        rw [this, Real.rpow_two]; push_cast; ring
    · have hux : u x = 0 := by rw [hu_def, indicator_of_notMem hx]
      simp [hg_def, hux, Real.zero_rpow hp.ne']
  have hfun : ∀ x, ‖(‖u x‖ ^ p : ℝ)‖ₑ = ‖u x‖ₑ ^ p := by
    intro x
    rw [Real.enorm_eq_ofReal (by positivity), ← ofReal_norm,
      ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hp.le]
  have hIr : Integrable (fun x => ‖u x‖ ^ p) μ :=
    ⟨(hu.measurable.norm.pow_const p).aestronglyMeasurable, by
      simpa [HasFiniteIntegral, hfun] using hLfin⟩
  have hint : ∫ x, h x * conj (g x) ∂μ = ((∫ x, ‖u x‖ ^ p ∂μ : ℝ) : ℂ) := by
    simp_rw [hpair]; exact integral_complex_ofReal
  have hval : ‖∫ x, h x * conj (g x) ∂μ‖ₑ = L := by
    rw [hint, ← ofReal_norm, Complex.norm_real, Real.norm_of_nonneg (integral_nonneg
      fun x => by positivity), ofReal_integral_eq_lintegral_ofReal hIr
      (Eventually.of_forall fun x => by positivity)]
    refine lintegral_congr fun x => ?_
    rw [← hfun, Real.enorm_eq_ofReal (by positivity)]
  have hgm : Measurable g := hu.measurable.mul
    (Complex.measurable_ofReal.comp (hu.measurable.norm.pow_const _))
  have hgq : eLpNorm g (ENNReal.ofReal q) μ = L ^ (1 / q) := by
    rw [eLpNorm_ofReal_eq_lintegral hgm.aestronglyMeasurable hq]
    congr 1
    refine lintegral_congr fun x => ?_
    rw [hge, ← ENNReal.rpow_mul, hpq.sub_one_mul_conj]
  have hbound := enorm_integral_le_of_dual_test hq hA hgm
    ⟨max N 0 ^ (p - 1), fun x => by
      rw [hgn]; exact Real.rpow_le_rpow (norm_nonneg _) (huN x) hp1.le⟩
    ((measure_mono (s := Function.support g) (t := S) (fun x hx => by
      by_contra hxS
      apply hx
      simp [hg_def, hu_def, indicator_of_notMem hxS])).trans_lt hμS)
    ((integrable_congr (Eventually.of_forall hpair)).2 hIr.ofReal)
    (by rw [hgq]; exact ENNReal.rpow_lt_top_of_nonneg (by positivity) hLfin.ne)
  rw [hval, hgq] at hbound
  rw [eLpNorm_ofReal_eq_lintegral hu.aestronglyMeasurable hp]
  exact rpow_le_of_le_mul_rpow hpq hLfin.ne hbound


/-- Blueprint Lemma 2.2 (`lem:young`), second assertion, lower bound (dual testing with bounded
tests of finite-measure support): on a σ-finite measure space, for Hölder conjugate
`1 < p < ∞`, `q = p'`, and any a.e. strongly measurable `h` (not assumed to lie in `L^p`), if
`|∫ h ḡ| ≤ A` for every measurable bounded `g` with `μ(supp g) < ∞`, `‖g‖_q ≤ 1` and
`h ḡ` integrable, then `‖h‖_p ≤ A`. -/
theorem eLpNorm_le_of_dual_test [SigmaFinite μ] {p q : ℝ} (hpq : p.HolderConjugate q)
    {h : α → ℂ} (hh : AEStronglyMeasurable h μ) {A : ℝ≥0∞}
    (hA : ∀ g : α → ℂ, Measurable g → (∃ C, ∀ x, ‖g x‖ ≤ C) → μ (Function.support g) < ∞ →
      eLpNorm g (ENNReal.ofReal q) μ ≤ 1 → Integrable (fun x => h x * conj (g x)) μ →
      ‖∫ x, h x * conj (g x) ∂μ‖ₑ ≤ A) :
    eLpNorm h (ENNReal.ofReal p) μ ≤ A := by
  set h' := hh.mk h
  have hh' : StronglyMeasurable h' := hh.stronglyMeasurable_mk
  have heq : h =ᵐ[μ] h' := hh.ae_eq_mk
  have hA' : ∀ g : α → ℂ, Measurable g → (∃ C, ∀ x, ‖g x‖ ≤ C) →
      μ (Function.support g) < ∞ → eLpNorm g (ENNReal.ofReal q) μ ≤ 1 →
      Integrable (fun x => h' x * conj (g x)) μ → ‖∫ x, h' x * conj (g x) ∂μ‖ₑ ≤ A := by
    intro g hgm hgb hgs hgq hgi
    have hae : (fun x => h x * conj (g x)) =ᵐ[μ] fun x => h' x * conj (g x) :=
      heq.mono fun x hx => by simp only [hx]
    rw [← integral_congr_ae hae]
    exact hA g hgm hgb hgs hgq ((integrable_congr hae).2 hgi)
  set S : ℕ → Set α := fun N => spanningSets μ N ∩ {x | ‖h' x‖ ≤ N}
  have hS : ∀ N, MeasurableSet (S N) := fun N =>
    (measurableSet_spanningSets μ N).inter (measurableSet_le hh'.measurable.norm measurable_const)
  have hμS : ∀ N, μ (S N) < ∞ := fun N =>
    (measure_mono inter_subset_left).trans_lt (measure_spanningSets_lt_top μ N)
  have hbd : ∀ N, eLpNorm ((S N).indicator h') (ENNReal.ofReal p) μ ≤ A := fun N =>
    eLpNorm_indicator_le_of_dual_test hpq hh' (hS N) (hμS N) (fun x hx => hx.2) hA'
  rw [eLpNorm_congr_ae heq]
  refine eLpNorm_le_of_tendsto_of_eLpNorm_le
    (fun N => (hh'.indicator (hS N)).aestronglyMeasurable) (Eventually.of_forall fun x => ?_) hbd
  refine tendsto_const_nhds.congr' ?_
  rw [EventuallyEq, eventually_atTop]
  refine ⟨max (spanningSetsIndex μ x) ⌈‖h' x‖⌉₊, fun N hN => ?_⟩
  have hx : x ∈ S N := ⟨monotone_spanningSets μ (le_of_max_le_left hN) (mem_spanningSetsIndex μ x),
    show ‖h' x‖ ≤ (N : ℝ) from (Nat.le_ceil (‖h' x‖)).trans
      (by exact_mod_cast le_of_max_le_right hN)⟩
  rw [indicator_of_mem hx]

/-- Blueprint Lemma 2.2 (`lem:young`), second assertion (dual testing, equality form): on a
σ-finite measure space, for Hölder conjugate `1 < p < ∞`, `q = p'`, and any a.e. strongly
measurable `h` (the norm may be infinite), `‖h‖_p` is the supremum of `|∫ h ḡ|` over measurable
bounded `g` with `μ(supp g) < ∞`, `‖g‖_q ≤ 1` and `h ḡ` integrable. -/
theorem eLpNorm_eq_iSup_dual_test [SigmaFinite μ] {p q : ℝ} (hpq : p.HolderConjugate q)
    {h : α → ℂ} (hh : AEStronglyMeasurable h μ) :
    eLpNorm h (ENNReal.ofReal p) μ =
      ⨆ (g : α → ℂ) (_ : Measurable g) (_ : ∃ C, ∀ x, ‖g x‖ ≤ C)
        (_ : μ (Function.support g) < ∞) (_ : eLpNorm g (ENNReal.ofReal q) μ ≤ 1)
        (_ : Integrable (fun x => h x * conj (g x)) μ), ‖∫ x, h x * conj (g x) ∂μ‖ₑ := by
  refine le_antisymm (eLpNorm_le_of_dual_test hpq hh fun g h1 h2 h3 h4 h5 =>
    le_iSup_of_le g <| le_iSup_of_le h1 <| le_iSup_of_le h2 <| le_iSup_of_le h3 <|
      le_iSup_of_le h4 <| le_iSup_of_le h5 le_rfl) ?_
  refine iSup_le fun g => iSup_le fun hgm => iSup_le fun _ => iSup_le fun _ =>
    iSup_le fun hgq => iSup_le fun _ => ?_
  calc ‖∫ x, h x * conj (g x) ∂μ‖ₑ
      ≤ eLpNorm h (ENNReal.ofReal p) μ * eLpNorm g (ENNReal.ofReal q) μ :=
        enorm_integral_mul_conj_le hpq hh hgm.aestronglyMeasurable
    _ ≤ eLpNorm h (ENNReal.ofReal p) μ * 1 := mul_le_mul_right hgq _
    _ = eLpNorm h (ENNReal.ofReal p) μ := mul_one _

/-- Blueprint Lemma 2.2 (`lem:young`), second assertion, smooth-test refinement (used for
duality arguments starting on Schwartz functions): on a finite-dimensional real normed space
with a measure finite on compacts (e.g. Lebesgue measure on `ℝⁿ`), for Hölder conjugate
`1 < p < ∞`, `q = p'`, and `h ∈ L^p`, if `|∫ h ḡ| ≤ A` for every smooth compactly supported `g`
with `‖g‖_q ≤ 1`, then `‖h‖_p ≤ A`. -/
theorem eLpNorm_le_of_smooth_dual_test {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E] {μ : Measure E}
    [IsFiniteMeasureOnCompacts μ] [SigmaFinite μ] {p q : ℝ} (hpq : p.HolderConjugate q)
    {h : E → ℂ} (hh : MemLp h (ENNReal.ofReal p) μ) {A : ℝ≥0∞}
    (hA : ∀ g : E → ℂ, ContDiff ℝ (⊤ : ℕ∞) g → HasCompactSupport g →
      eLpNorm g (ENNReal.ofReal q) μ ≤ 1 → ‖∫ x, h x * conj (g x) ∂μ‖ₑ ≤ A) :
    eLpNorm h (ENNReal.ofReal p) μ ≤ A := by
  refine eLpNorm_le_of_dual_test hpq hh.aestronglyMeasurable
    fun g hgm _ _ hgq hgi => ?_
  rcases eq_or_ne A ∞ with hAt | hAt
  · rw [hAt]; exact le_top
  have hq1 : 1 ≤ ENNReal.ofReal q := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hpq.symm.lt.le
  set H := eLpNorm h (ENNReal.ofReal p) μ with hH
  have hHt : H ≠ ∞ := hh.ne
  refine ENNReal.le_of_forall_pos_le_add fun ε hε _ => ?_
  set a := A.toReal
  set η := H.toReal
  have ha : 0 ≤ a := ENNReal.toReal_nonneg
  have hη : 0 ≤ η := ENNReal.toReal_nonneg
  set δ : ℝ := ε / (a + η + 1) with hδ_def
  have hδ : 0 < δ := div_pos (by exact_mod_cast hε) (by positivity)
  have hgL : MemLp g (ENNReal.ofReal q) μ := hgq.trans_lt ENNReal.one_lt_top
  obtain ⟨φ, hφc, hφs, hφ⟩ := hgL.exist_eLpNorm_sub_le ENNReal.ofReal_ne_top hq1 hδ
  have hφm : AEStronglyMeasurable φ μ := hφs.continuous.aestronglyMeasurable
  have hφL : eLpNorm φ (ENNReal.ofReal q) μ ≤ 1 + ENNReal.ofReal δ := by
    calc eLpNorm φ (ENNReal.ofReal q) μ = eLpNorm (g - (g - φ)) (ENNReal.ofReal q) μ := by
          rw [sub_sub_cancel]
      _ ≤ eLpNorm g (ENNReal.ofReal q) μ + eLpNorm (g - φ) (ENNReal.ofReal q) μ :=
          eLpNorm_sub_le hq1
      _ ≤ 1 + ENNReal.ofReal δ := add_le_add hgq hφ
  -- the normalized smooth test
  set c : ℝ := (1 + δ)⁻¹ with hc_def
  have hc : 0 < c := by positivity
  have hcφ : eLpNorm (fun x => (c : ℂ) * φ x) (ENNReal.ofReal q) μ ≤ 1 := by
    have : (fun x => (c : ℂ) * φ x) = (c : ℂ) • φ := rfl
    rw [this, eLpNorm_const_smul, ← ofReal_norm, Complex.norm_real, Real.norm_of_nonneg hc.le]
    calc ENNReal.ofReal c * eLpNorm φ (ENNReal.ofReal q) μ
        ≤ ENNReal.ofReal c * (1 + ENNReal.ofReal δ) := mul_le_mul_right hφL _
      _ = 1 := by
          rw [← ENNReal.ofReal_one, ← ENNReal.ofReal_add zero_le_one hδ.le,
            ← ENNReal.ofReal_mul hc.le, hc_def, inv_mul_cancel₀ (by positivity)]
  have key := hA _ (contDiff_const.mul hφs) hφc.mul_left hcφ
  have e : ∫ x, h x * conj ((c : ℂ) * φ x) ∂μ = (c : ℂ) * ∫ x, h x * conj (φ x) ∂μ := by
    simp only [map_mul, Complex.conj_ofReal]
    rw [← integral_const_mul]
    congr 1; funext x; ring
  rw [e, enorm_mul, ← ofReal_norm, Complex.norm_real, Real.norm_of_nonneg hc.le] at key
  have hφbd : ‖∫ x, h x * conj (φ x) ∂μ‖ₑ ≤ ENNReal.ofReal (1 + δ) * A := by
    calc ‖∫ x, h x * conj (φ x) ∂μ‖ₑ
        = ENNReal.ofReal (1 + δ) * (ENNReal.ofReal c * ‖∫ x, h x * conj (φ x) ∂μ‖ₑ) := by
          rw [← mul_assoc, ← ENNReal.ofReal_mul (by positivity), hc_def,
            mul_inv_cancel₀ (by positivity), ENNReal.ofReal_one, one_mul]
      _ ≤ ENNReal.ofReal (1 + δ) * A := mul_le_mul_right key _
  -- the approximation error, by Hölder
  have hφM : MemLp φ (ENNReal.ofReal q) μ :=
    hφL.trans_lt (ENNReal.add_lt_top.2 ⟨ENNReal.one_lt_top, ENNReal.ofReal_lt_top⟩)
  have hφconj : MemLp (fun x => conj (φ x)) (ENNReal.ofReal q) μ := by
    have : eLpNorm (fun x => conj (φ x)) (ENNReal.ofReal q) μ =
        eLpNorm φ (ENNReal.ofReal q) μ :=
      eLpNorm_congr_norm_ae
        (Complex.continuous_conj.comp hφs.continuous).aestronglyMeasurable hφm
        (Eventually.of_forall fun x => Complex.norm_conj _)
    exact this.trans_lt hφM
  have := hpq.ennrealOfReal
  have hφi : Integrable (fun x => h x * conj (φ x)) μ := hh.integrable_mul hφconj
  have hdiff : ∫ x, h x * conj (g x) ∂μ - ∫ x, h x * conj (φ x) ∂μ =
      ∫ x, h x * conj ((g - φ) x) ∂μ := by
    rw [← integral_sub hgi hφi]
    congr 1; funext x; simp [mul_sub]
  have herr : ‖∫ x, h x * conj ((g - φ) x) ∂μ‖ₑ ≤ H * ENNReal.ofReal δ :=
    (enorm_integral_mul_conj_le hpq hh.aestronglyMeasurable
      (hgm.aestronglyMeasurable.sub hφm)).trans (mul_le_mul_right hφ _)
  calc ‖∫ x, h x * conj (g x) ∂μ‖ₑ
      = ‖∫ x, h x * conj (φ x) ∂μ +
          (∫ x, h x * conj (g x) ∂μ - ∫ x, h x * conj (φ x) ∂μ)‖ₑ := by
        rw [add_sub_cancel]
    _ ≤ ‖∫ x, h x * conj (φ x) ∂μ‖ₑ +
          ‖∫ x, h x * conj (g x) ∂μ - ∫ x, h x * conj (φ x) ∂μ‖ₑ := enorm_add_le _ _
    _ ≤ ENNReal.ofReal (1 + δ) * A + H * ENNReal.ofReal δ := by
        rw [hdiff]; exact add_le_add hφbd herr
    _ = ENNReal.ofReal ((1 + δ) * a + η * δ) := by
        rw [← ENNReal.ofReal_toReal hAt, ← ENNReal.ofReal_toReal hHt,
          ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul hη,
          ← ENNReal.ofReal_add (by positivity) (by positivity)]
    _ ≤ ENNReal.ofReal (a + ε) := by
        refine ENNReal.ofReal_le_ofReal ?_
        have h1 : δ * (a + η + 1) = ε := by
          rw [hδ_def]; field_simp
        nlinarith
    _ = A + ε := by
        rw [ENNReal.ofReal_add ha (by positivity), ENNReal.ofReal_toReal hAt]
        simp

end Duality

/-! ### Subsequences -/

/-- Blueprint Lemma 2.2 (`lem:young`), third assertion: if `h_k → h` in `L^p` (`p ≠ 0`), i.e.
`‖h_k - h‖_p → 0`, then a subsequence converges to `h` almost everywhere. -/
theorem exists_subseq_ae_tendsto_of_eLpNorm_tendsto {α E : Type*} [MeasurableSpace α]
    {μ : Measure α} [NormedAddCommGroup E] {p : ℝ≥0∞} (hp : p ≠ 0) {h : ℕ → α → E}
    {g : α → E} (hlim : Tendsto (fun k => eLpNorm (h k - g) p μ) atTop (𝓝 0)) :
    ∃ φ : ℕ → ℕ, StrictMono φ ∧ ∀ᵐ x ∂μ, Tendsto (fun j => h (φ j) x) atTop (𝓝 (g x)) :=
  (tendstoInMeasure_of_tendsto_eLpNorm hp hlim).exists_seq_tendsto_ae

/-! ## Lemma 2.4 (`lem:maximal`), second half: the envelope `B_R` -/

/-- The envelope `B_R(x) = R^{-n} (1 + |x|/R)^{-n-1}` of Blueprint Lemma 2.4 (`lem:maximal`) on
`E = EuclideanSpace ℝ (Fin n)` (the blueprint uses `R ≥ 1`; the definition makes sense for all
real `R`). -/
noncomputable def envelope (n : ℕ) (R : ℝ) (x : EuclideanSpace ℝ (Fin n)) : ℝ :=
  (R ^ n)⁻¹ * ((1 + ‖x‖ / R) ^ (n + 1))⁻¹

/-- The lattice envelope `B_R(y)`, `y ∈ ℤⁿ`, of Blueprint Lemma 2.4 (`lem:maximal`): the
envelope evaluated at the embedded point `latEmbed y` (Euclidean norm). -/
noncomputable def latEnvelope (n : ℕ) (R : ℝ) (y : Fin n → ℤ) : ℝ := envelope n R (latEmbed y)

/-- The coefficient `2^{n+1} R^{-n} 2^{-k(n+1)}` bounding `B_R` on the dyadic annulus
`2^{k-1} R < |x| ≤ 2^k R` (`k ≥ 1`) and on `|x| ≤ R` (`k = 0`). -/
noncomputable def envelopeCoeff (n : ℕ) (R : ℝ) (k : ℕ) : ℝ :=
  2 ^ (n + 1) * (R ^ n)⁻¹ * ((2 ^ k) ^ (n + 1))⁻¹

/-- The constant `C_n = 2^{n+2} 5^n` of Blueprint Lemma 2.4 (`lem:maximal`) for the envelope
integral, lattice sum, and the bound `B_R * |f| ≤ C_n 𝖬 f`. -/
noncomputable def envelopeConst (n : ℕ) : ℝ := 2 ^ (n + 2) * 5 ^ n

/-- The envelope is nonnegative. -/
lemma envelope_nonneg {n : ℕ} {R : ℝ} (hR : 0 < R) (x : EuclideanSpace ℝ (Fin n)) :
    0 ≤ envelope n R x := by
  unfold envelope; positivity

/-- For `R > 0`, `B_R(x) = R / (R + |x|)^{n+1}`. -/
lemma envelope_eq_div {n : ℕ} {R : ℝ} (hR : 0 < R) (x : EuclideanSpace ℝ (Fin n)) :
    envelope n R x = R / (R + ‖x‖) ^ (n + 1) := by
  have h1 : 0 < R + ‖x‖ := by positivity
  unfold envelope
  rw [show 1 + ‖x‖ / R = (R + ‖x‖) / R by field_simp, div_pow]
  field_simp
  ring

/-- For `R > 0`, the envelope is continuous. -/
lemma continuous_envelope (n : ℕ) {R : ℝ} (hR : 0 < R) : Continuous (envelope n R) := by
  unfold envelope
  refine continuous_const.mul (Continuous.inv₀ (by fun_prop) fun x => by positivity)

/-- Dyadic decomposition: every `x` lies in some ball `|x| ≤ 2^k R` on which (as the smallest
such `k` shows) `B_R(x)` is at most the `k`th coefficient. -/
lemma exists_envelope_le_coeff {n : ℕ} {R : ℝ} (hR : 0 < R) (x : EuclideanSpace ℝ (Fin n)) :
    ∃ k : ℕ, ‖x‖ ≤ 2 ^ k * R ∧ envelope n R x ≤ envelopeCoeff n R k := by
  rcases le_or_gt ‖x‖ R with hx | hx
  · refine ⟨0, by simpa using hx, ?_⟩
    unfold envelope envelopeCoeff
    have h1 : ((1 + ‖x‖ / R) ^ (n + 1))⁻¹ ≤ 1 := inv_le_one_of_one_le₀ (one_le_pow₀ (by
      have : 0 ≤ ‖x‖ / R := by positivity
      linarith))
    have h2 : (1 : ℝ) ≤ 2 ^ (n + 1) := one_le_pow₀ (by norm_num)
    have h3 : 0 < (R ^ n)⁻¹ := by positivity
    simp only [pow_zero, one_pow, inv_one, mul_one]
    nlinarith
  · obtain ⟨j, hj1, hj2⟩ := exists_nat_pow_near (x := ‖x‖ / R) (y := (2 : ℝ))
      (by rw [le_div_iff₀ hR]; linarith) one_lt_two
    refine ⟨j + 1, by rw [div_lt_iff₀ hR] at hj2; linarith, ?_⟩
    unfold envelope envelopeCoeff
    have h4 : ((1 + ‖x‖ / R) ^ (n + 1))⁻¹ ≤ ((2 ^ j) ^ (n + 1))⁻¹ := by
      apply inv_anti₀ (by positivity)
      apply pow_le_pow_left₀ (by positivity)
      linarith
    have h5 : 2 ^ (n + 1) * (R ^ n)⁻¹ * (((2:ℝ) ^ (j + 1)) ^ (n + 1))⁻¹ =
        (R ^ n)⁻¹ * ((2 ^ j) ^ (n + 1))⁻¹ := by
      rw [show ((2:ℝ) ^ (j + 1)) ^ (n + 1) = (2 ^ j) ^ (n + 1) * 2 ^ (n + 1) by ring]
      field_simp
    rw [h5]
    exact mul_le_mul_of_nonneg_left h4 (by positivity)

/-- The `k`th coefficient times the cube size `(5 · 2^k R)^n` is `2^{n+1} 5^n 2^{-k}`. -/
lemma envelopeCoeff_mul (n : ℕ) {R : ℝ} (hR : 0 < R) (k : ℕ) :
    envelopeCoeff n R k * (5 * (2 ^ k * R)) ^ n = 2 ^ (n + 1) * 5 ^ n * (2⁻¹) ^ k := by
  unfold envelopeCoeff
  rw [inv_pow, mul_pow, mul_pow, pow_succ (2 ^ k)]
  field_simp

/-- Summing the dyadic contributions: `∑_k a_k (5 · 2^k R)^n M = C_n M`. -/
lemma tsum_envelopeCoeff_mul (n : ℕ) {R : ℝ} (hR : 0 < R) (M : ℝ≥0∞) :
    ∑' k, ENNReal.ofReal (envelopeCoeff n R k) * (ENNReal.ofReal ((5 * (2 ^ k * R)) ^ n) * M) =
      ENNReal.ofReal (envelopeConst n) * M := by
  have h : ∀ k, ENNReal.ofReal (envelopeCoeff n R k) *
      (ENNReal.ofReal ((5 * (2 ^ k * R)) ^ n) * M) =
      ENNReal.ofReal (2 ^ (n + 1) * 5 ^ n) * 2⁻¹ ^ k * M := by
    intro k
    have h0 : 0 ≤ envelopeCoeff n R k := by unfold envelopeCoeff; positivity
    rw [← mul_assoc, ← ENNReal.ofReal_mul h0, envelopeCoeff_mul n hR,
      ENNReal.ofReal_mul (by positivity : (0:ℝ) ≤ 2 ^ (n + 1) * 5 ^ n),
      ENNReal.ofReal_pow (by norm_num : (0:ℝ) ≤ 2⁻¹), ENNReal.ofReal_inv_of_pos two_pos,
      ENNReal.ofReal_ofNat]
  simp_rw [h]
  rw [ENNReal.tsum_mul_right, ENNReal.tsum_mul_left, ENNReal.tsum_geometric_two,
    envelopeConst, show (2:ℝ) ^ (n + 2) * 5 ^ n = 2 ^ (n + 1) * 5 ^ n * 2 by ring,
    ENNReal.ofReal_mul (by positivity : (0:ℝ) ≤ 2 ^ (n + 1) * 5 ^ n), ENNReal.ofReal_ofNat]

/-- If `B ≤ ∑_k a_k 𝟙_{S_k}` pointwise, then `∫ B g ≤ ∑_k a_k ∫_{S_k} g` (for a.e.-measurable
`g ≥ 0`). -/
lemma lintegral_mul_le_tsum_setLIntegral {α : Type*} [MeasurableSpace α] (μ : Measure α)
    {B g : α → ℝ≥0∞} (hg : AEMeasurable g μ) {S : ℕ → Set α} (hS : ∀ k, MeasurableSet (S k))
    (a : ℕ → ℝ≥0∞) (hB : ∀ y, B y ≤ ∑' k, (S k).indicator (fun _ => a k) y) :
    ∫⁻ y, B y * g y ∂μ ≤ ∑' k, a k * ∫⁻ y in S k, g y ∂μ := by
  calc ∫⁻ y, B y * g y ∂μ ≤ ∫⁻ y, ∑' k, (S k).indicator (fun _ => a k) y * g y ∂μ :=
        lintegral_mono fun y => by rw [ENNReal.tsum_mul_right]; gcongr; exact hB y
    _ = ∑' k, ∫⁻ y, (S k).indicator (fun _ => a k) y * g y ∂μ :=
        lintegral_tsum fun k => (aemeasurable_const.indicator (hS k)).mul hg
    _ = ∑' k, a k * ∫⁻ y in S k, g y ∂μ := by
        congr 1; funext k
        rw [← lintegral_const_mul'' _ hg.restrict, ← lintegral_indicator (hS k)]
        congr 1; funext y
        by_cases hy : y ∈ S k <;> simp [hy]

/-- Cubes in `E` are measurable. -/
lemma measurableSet_euclideanCube {n : ℕ} (x : EuclideanSpace ℝ (Fin n)) (r : ℝ) :
    MeasurableSet (euclideanCube x r) := by
  have : euclideanCube x r = ⋂ i, (fun y : EuclideanSpace ℝ (Fin n) => |y i - x i|) ⁻¹' Iic r := by
    ext y; simp [euclideanCube]
  rw [this]
  exact MeasurableSet.iInter fun i => measurableSet_Iic.preimage (by fun_prop)

/-- The cube of radius `r ≥ 0` in `E` has volume `(2r)^n`. -/
lemma volume_euclideanCube {n : ℕ} (x : EuclideanSpace ℝ (Fin n)) {r : ℝ} (hr : 0 ≤ r) :
    volume (euclideanCube x r) = ENNReal.ofReal ((2 * r) ^ n) := by
  rw [euclideanCube_eq_preimage n x hr, (measurePreserving_euclideanEquivPi n).measure_preimage
    measurableSet_closedBall.nullMeasurableSet, Real.volume_pi_closedBall _ hr, Fintype.card_fin]

/-- On `E`: `∫_{|y|_∞ ≤ r} |f(x - y)| dy ≤ (2r)^n 𝖬 f(x)` for `r > 0`. -/
lemma setLIntegral_euclideanCube_le {F : Type*} [NormedAddCommGroup F] {n : ℕ}
    (f : EuclideanSpace ℝ (Fin n) → F) (x : EuclideanSpace ℝ (Fin n)) {r : ℝ} (hr : 0 < r) :
    ∫⁻ y in euclideanCube 0 r, ‖f (x - y)‖ₑ ≤
      ENNReal.ofReal ((2 * r) ^ n) * cubeMaximalEuclidean n f x := by
  have e1 : ∫⁻ y in euclideanCube 0 r, ‖f (x - y)‖ₑ =
      ∫⁻ y, (euclideanCube x r).indicator (fun z => ‖f z‖ₑ) (x - y) := by
    rw [← lintegral_indicator (measurableSet_euclideanCube 0 r)]
    congr 1; funext y
    have : y ∈ euclideanCube 0 r ↔ x - y ∈ euclideanCube x r := by
      simp [euclideanCube, abs_sub_comm]
    by_cases hy : y ∈ euclideanCube 0 r
    · rw [indicator_of_mem hy, indicator_of_mem (this.1 hy)]
    · rw [indicator_of_notMem hy, indicator_of_notMem (fun h => hy (this.2 h))]
  rw [e1, lintegral_sub_left_eq_self (fun z => (euclideanCube x r).indicator (fun z => ‖f z‖ₑ) z) x,
    lintegral_indicator (measurableSet_euclideanCube x r)]
  have hv := volume_euclideanCube x hr.le
  have h0 : volume (euclideanCube x r) ≠ 0 := by
    rw [hv]; simp only [ne_eq, ENNReal.ofReal_eq_zero, not_le]; positivity
  have ht : volume (euclideanCube x r) ≠ ∞ := by rw [hv]; exact ENNReal.ofReal_ne_top
  rw [← hv, ← ENNReal.mul_inv_cancel_left (b := ∫⁻ z in euclideanCube x r, ‖f z‖ₑ) h0 ht]
  gcongr
  exact le_iSup₂ (f := fun r (_ : 0 ≤ r) =>
      (volume (euclideanCube x r))⁻¹ * ∫⁻ y in euclideanCube x r, ‖f y‖ₑ) r hr.le

/-- On `E`: `B_R ≤ ∑_k a_k 𝟙_{|y|_∞ ≤ 2^k R}` (the sup norm is at most the Euclidean norm). -/
lemma envelope_le_tsum_indicator_euclidean {n : ℕ} {R : ℝ} (hR : 0 < R)
    (y : EuclideanSpace ℝ (Fin n)) :
    ENNReal.ofReal (envelope n R y) ≤ ∑' k, (euclideanCube 0 (2 ^ k * R)).indicator
      (fun _ => ENNReal.ofReal (envelopeCoeff n R k)) y := by
  obtain ⟨k, hk1, hk2⟩ := exists_envelope_le_coeff hR y
  have hy : y ∈ euclideanCube 0 (2 ^ k * R) := fun i => by
    simpa [Real.norm_eq_abs] using (PiLp.norm_apply_le y i).trans hk1
  refine le_trans ?_ (ENNReal.le_tsum k)
  rw [indicator_of_mem hy]
  exact ENNReal.ofReal_le_ofReal hk2

/-- Blueprint Lemma 2.4 (`lem:maximal`), equation (2.1) (`eq:envelope`), first inequality on
`E`: for `R > 0` (in particular `R ≥ 1`), `x ∈ E` and a.e. strongly measurable `f`,
`(B_R * |f|)(x) = ∫ B_R(y) |f(x - y)| dy ≤ C_n 𝖬 f(x)`, with `𝖬` the centered cube maximal
function `cubeMaximalEuclidean` and `C_n = envelopeConst n`. -/
theorem lintegral_envelope_mul_le_cubeMaximalEuclidean {F : Type*} [NormedAddCommGroup F] {n : ℕ}
    {R : ℝ} (hR : 0 < R) {f : EuclideanSpace ℝ (Fin n) → F} (hf : AEStronglyMeasurable f volume)
    (x : EuclideanSpace ℝ (Fin n)) :
    ∫⁻ y, ENNReal.ofReal (envelope n R y) * ‖f (x - y)‖ₑ ≤
      ENNReal.ofReal (envelopeConst n) * cubeMaximalEuclidean n f x := by
  have hg : AEMeasurable (fun y => ‖f (x - y)‖ₑ) volume :=
    (hf.comp_quasiMeasurePreserving (quasiMeasurePreserving_sub_left_of_right_invariant volume x)).enorm
  refine (lintegral_mul_le_tsum_setLIntegral volume hg
    (fun k => measurableSet_euclideanCube 0 (2 ^ k * R)) _
    (envelope_le_tsum_indicator_euclidean hR)).trans ?_
  rw [← tsum_envelopeCoeff_mul n hR]
  refine ENNReal.tsum_le_tsum fun k => ?_
  gcongr
  refine (setLIntegral_euclideanCube_le f x (by positivity)).trans ?_
  gcongr
  linarith [show (0:ℝ) ≤ 2 ^ k * R by positivity]

/-- The lattice cube of radius `⌈r⌉` has at most `(5r)^n` points when `r ≥ 1`. -/
lemma count_intCube_ceil_le {n : ℕ} (x : Fin n → ℤ) {r : ℝ} (hr : 1 ≤ r) :
    Measure.count (intCube x ⌈r⌉₊) ≤ ENNReal.ofReal ((5 * r) ^ n) := by
  rw [intCube_eq_closedBall, count_closedBall_int n x (Nat.cast_nonneg _), Int.floor_natCast]
  have h1 : (2 * (⌈r⌉₊ : ℤ) + 1).toNat = 2 * ⌈r⌉₊ + 1 := by omega
  rw [h1, ← ENNReal.ofReal_natCast]
  refine ENNReal.ofReal_le_ofReal ?_
  push_cast
  refine pow_le_pow_left₀ (by positivity) ?_ n
  have := Nat.ceil_lt_add_one (show 0 ≤ r by linarith)
  linarith

/-- On `G`: `∑_{|y|_∞ ≤ N} |f(x - y)| ≤ #(cube of radius N) · 𝖬 f(x)`. -/
lemma setLIntegral_intCube_le {F : Type*} [NormedAddCommGroup F] {n : ℕ}
    (f : (Fin n → ℤ) → F) (x : Fin n → ℤ) (N : ℕ) :
    ∫⁻ y in intCube 0 N, ‖f (x - y)‖ₑ ∂Measure.count ≤
      Measure.count (intCube x N) * cubeMaximalInt n f x := by
  have e1 : ∫⁻ y in intCube 0 N, ‖f (x - y)‖ₑ ∂Measure.count =
      ∫⁻ z in intCube x N, ‖f z‖ₑ ∂Measure.count := by
    rw [← lintegral_indicator (MeasurableSet.of_discrete),
      ← lintegral_indicator (MeasurableSet.of_discrete), lintegral_count, lintegral_count]
    conv_rhs => rw [← (Equiv.subLeft x).tsum_eq]
    congr 1; funext y
    have : y ∈ intCube 0 N ↔ x - y ∈ intCube x N := by
      simp [intCube, abs_sub_comm]
    simp only [Equiv.subLeft_apply]
    by_cases hy : y ∈ intCube 0 N
    · rw [indicator_of_mem hy, indicator_of_mem (this.1 hy)]
    · rw [indicator_of_notMem hy, indicator_of_notMem (fun h => hy (this.2 h))]
  rw [e1]
  have h0 : Measure.count (intCube x N) ≠ 0 := by
    rw [Measure.count_ne_zero_iff]; exact ⟨x, fun i => by simp⟩
  have ht : Measure.count (intCube x N) ≠ ∞ := by
    rw [intCube_eq_closedBall, count_closedBall_int n x (Nat.cast_nonneg _)]
    exact ENNReal.natCast_ne_top _
  rw [← ENNReal.mul_inv_cancel_left (b := ∫⁻ z in intCube x N, ‖f z‖ₑ ∂Measure.count) h0 ht]
  gcongr
  exact le_iSup (fun R : ℕ => (Measure.count (intCube x R))⁻¹ *
    ∫⁻ y in intCube x R, ‖f y‖ₑ ∂Measure.count) N

/-- On `G`: `B_R(y) ≤ ∑_k a_k 𝟙_{|y|_∞ ≤ ⌈2^k R⌉}(y)`. -/
lemma envelope_le_tsum_indicator_int {n : ℕ} {R : ℝ} (hR : 0 < R) (y : Fin n → ℤ) :
    ENNReal.ofReal (latEnvelope n R y) ≤ ∑' k, (intCube 0 ⌈2 ^ k * R⌉₊).indicator
      (fun _ => ENNReal.ofReal (envelopeCoeff n R k)) y := by
  obtain ⟨k, hk1, hk2⟩ := exists_envelope_le_coeff hR (latEmbed y)
  have hy : y ∈ intCube 0 ⌈2 ^ k * R⌉₊ := fun i => by
    have h1 : |(y i : ℝ)| ≤ 2 ^ k * R := by
      simpa [Real.norm_eq_abs] using (PiLp.norm_apply_le (latEmbed y) i).trans hk1
    have h2 : |(y i : ℝ)| ≤ (⌈2 ^ k * R⌉₊ : ℝ) := h1.trans (Nat.le_ceil _)
    simp only [Pi.zero_apply, sub_zero]
    exact_mod_cast h2
  refine le_trans ?_ (ENNReal.le_tsum k)
  rw [indicator_of_mem hy]
  exact ENNReal.ofReal_le_ofReal hk2

/-- Blueprint Lemma 2.4 (`lem:maximal`), equation (2.1) (`eq:envelope`), first inequality on
`G`: for `R ≥ 1`, `x ∈ ℤⁿ` and any `f`,
`(B_R * |f|)(x) = ∑_y B_R(y) |f(x - y)| ≤ C_n 𝖬 f(x)`, with `𝖬` the lattice cube maximal
function `cubeMaximalInt` (integer radii) and `C_n = envelopeConst n`. -/
theorem tsum_envelope_mul_le_cubeMaximalInt {F : Type*} [NormedAddCommGroup F] {n : ℕ}
    {R : ℝ} (hR : 1 ≤ R) (f : (Fin n → ℤ) → F) (x : Fin n → ℤ) :
    ∑' y, ENNReal.ofReal (latEnvelope n R y) * ‖f (x - y)‖ₑ ≤
      ENNReal.ofReal (envelopeConst n) * cubeMaximalInt n f x := by
  have hR0 : 0 < R := by linarith
  rw [← lintegral_count]
  refine (lintegral_mul_le_tsum_setLIntegral Measure.count
    (AEMeasurable.of_discrete (f := fun y => ‖f (x - y)‖ₑ))
    (fun k => MeasurableSet.of_discrete (s := intCube 0 ⌈2 ^ k * R⌉₊)) _
    (envelope_le_tsum_indicator_int hR0)).trans ?_
  rw [← tsum_envelopeCoeff_mul n hR0]
  refine ENNReal.tsum_le_tsum fun k => ?_
  gcongr
  refine (setLIntegral_intCube_le f x _).trans ?_
  gcongr
  exact count_intCube_ceil_le x (one_le_mul_of_one_le_of_one_le (one_le_pow₀ one_le_two) hR)


/-- `∫ B_R ≤ C_n` in `ℝ≥0∞` form, for `R > 0`. -/
lemma lintegral_envelope_le {n : ℕ} {R : ℝ} (hR : 0 < R) :
    ∫⁻ y, ENNReal.ofReal (envelope n R y) ≤ ENNReal.ofReal (envelopeConst n) := by
  have h := lintegral_envelope_mul_le_cubeMaximalEuclidean hR
    (f := fun _ : EuclideanSpace ℝ (Fin n) => (1 : ℝ)) aestronglyMeasurable_const 0
  simp only [enorm_one, mul_one] at h
  refine h.trans (mul_le_of_le_one_right zero_le (iSup₂_le fun r _ => ?_))
  simp

/-- Blueprint Lemma 2.4 (`lem:maximal`), bound for the Euclidean integral of `B_R`: for `R > 0`
(in particular `R ≥ 1`), `B_R` is integrable on `E` and `∫ B_R ≤ C_n`, with `C_n = envelopeConst n`
independent of `R`. -/
theorem integrable_envelope_and_integral_le {n : ℕ} {R : ℝ} (hR : 0 < R) :
    Integrable (envelope n R) volume ∧ ∫ x, envelope n R x ≤ envelopeConst n := by
  have hC : 0 ≤ envelopeConst n := by unfold envelopeConst; positivity
  have hnn : 0 ≤ᵐ[volume] envelope n R := Eventually.of_forall (envelope_nonneg hR)
  have hint : Integrable (envelope n R) volume :=
    ⟨(continuous_envelope n hR).aestronglyMeasurable, (hasFiniteIntegral_iff_ofReal hnn).2
      ((lintegral_envelope_le hR).trans_lt ENNReal.ofReal_lt_top)⟩
  refine ⟨hint, ?_⟩
  rw [integral_eq_lintegral_of_nonneg_ae hnn hint.aestronglyMeasurable]
  exact ENNReal.toReal_le_of_le_ofReal hC (lintegral_envelope_le hR)

/-- Blueprint Lemma 2.4 (`lem:maximal`), bound for the lattice sum of `B_R`: for `R ≥ 1`,
`y ↦ B_R(y)` is summable on `ℤⁿ` and `∑_y B_R(y) ≤ C_n`, with `C_n = envelopeConst n`
independent of `R`. -/
theorem summable_latEnvelope_and_tsum_le {n : ℕ} {R : ℝ} (hR : 1 ≤ R) :
    Summable (latEnvelope n R) ∧ ∑' y, latEnvelope n R y ≤ envelopeConst n := by
  have hR0 : 0 < R := by linarith
  have hC : 0 ≤ envelopeConst n := by unfold envelopeConst; positivity
  have h := tsum_envelope_mul_le_cubeMaximalInt hR (fun _ : Fin n → ℤ => (1 : ℝ)) 0
  simp only [enorm_one, mul_one] at h
  have h' : ∑' y : Fin n → ℤ, ENNReal.ofReal (envelope n R (latEmbed y)) ≤
      ENNReal.ofReal (envelopeConst n) := by
    refine h.trans (mul_le_of_le_one_right zero_le (iSup_le fun N => ?_))
    simp
  have hfin : ∑' y : Fin n → ℤ, ENNReal.ofReal (envelope n R (latEmbed y)) ≠ ∞ :=
    (h'.trans_lt ENNReal.ofReal_lt_top).ne
  have heq : latEnvelope n R =
      fun y => (ENNReal.ofReal (envelope n R (latEmbed y))).toReal := by
    funext y; rw [latEnvelope, ENNReal.toReal_ofReal (envelope_nonneg hR0 _)]
  rw [heq]
  refine ⟨ENNReal.summable_toReal hfin, ?_⟩
  rw [← ENNReal.tsum_toReal_eq fun _ => ENNReal.ofReal_ne_top]
  exact ENNReal.toReal_le_of_le_ofReal hC h'

/-- If `R + |x| ≤ c (R + |u|)`, then `B_R(u) ≤ c^{n+1} B_R(x)`. -/
lemma envelope_le_pow_mul {n : ℕ} {R c : ℝ} (hR : 0 < R)
    {x u : EuclideanSpace ℝ (Fin n)} (h : R + ‖x‖ ≤ c * (R + ‖u‖)) :
    envelope n R u ≤ c ^ (n + 1) * envelope n R x := by
  rw [envelope_eq_div hR, envelope_eq_div hR, mul_div_assoc', div_le_div_iff₀ (by positivity)
    (by positivity)]
  have : (R + ‖x‖) ^ (n + 1) ≤ c ^ (n + 1) * (R + ‖u‖) ^ (n + 1) := by
    rw [← mul_pow]; exact pow_le_pow_left₀ (by positivity) h _
  nlinarith

/-- For `L ≤ R`, `|x| > 2R` and `|z| ≥ |x|/2`: `B_L(z) ≤ 4^{n+1} B_R(x)`. -/
lemma envelope_le_of_far {n : ℕ} {R L : ℝ} (hL : 0 < L) (hLR : L ≤ R)
    {x z : EuclideanSpace ℝ (Fin n)} (hx : 2 * R < ‖x‖) (hz : ‖x‖ / 2 ≤ ‖z‖) :
    envelope n L z ≤ 4 ^ (n + 1) * envelope n R x := by
  have hR : 0 < R := hL.trans_le hLR
  have hx0 : 0 < ‖x‖ := by linarith
  rw [envelope_eq_div hL, envelope_eq_div hR]
  calc L / (L + ‖z‖) ^ (n + 1) ≤ R / (‖x‖ / 2) ^ (n + 1) :=
        div_le_div₀ hR.le hLR (by positivity) (pow_le_pow_left₀ (by positivity) (by linarith) _)
    _ = 4 ^ (n + 1) * (R / (2 * ‖x‖) ^ (n + 1)) := by
        rw [div_pow, mul_pow]; field_simp; rw [← pow_mul, mul_comm, pow_mul]; norm_num
    _ ≤ 4 ^ (n + 1) * (R / (R + ‖x‖) ^ (n + 1)) := by
        gcongr; linarith

/-- Pointwise bound for `L ≤ R`:
`B_R(x - z) B_L(z) ≤ 4^{n+1} B_R(x) (B_L(z) + B_R(x - z))`. -/
lemma envelope_mul_le_of_le {n : ℕ} {R L : ℝ} (hL : 0 < L) (hLR : L ≤ R)
    (x z : EuclideanSpace ℝ (Fin n)) :
    envelope n R (x - z) * envelope n L z ≤
      4 ^ (n + 1) * envelope n R x * (envelope n L z + envelope n R (x - z)) := by
  have hR : 0 < R := hL.trans_le hLR
  have e1 := envelope_nonneg hR (x - z)
  have e2 := envelope_nonneg hL z
  have e3 := envelope_nonneg hR x
  by_cases hA : ‖x‖ / 2 ≤ ‖x - z‖ ∨ ‖x‖ ≤ 2 * R
  · have hb : envelope n R (x - z) ≤ 4 ^ (n + 1) * envelope n R x := by
      rcases hA with hA | hA
      · refine (envelope_le_pow_mul (c := 2) (x := x) (u := x - z) hR (by linarith)).trans ?_
        gcongr; norm_num
      · refine (envelope_le_pow_mul (c := 3) (x := x) (u := x - z) hR
          (by linarith [norm_nonneg (x - z)])).trans ?_
        gcongr; norm_num
    calc envelope n R (x - z) * envelope n L z ≤ 4 ^ (n + 1) * envelope n R x * envelope n L z :=
          mul_le_mul_of_nonneg_right hb e2
      _ ≤ _ := mul_le_mul_of_nonneg_left (by linarith) (by positivity)
  · simp only [not_or, not_le] at hA
    have hz : ‖x‖ / 2 ≤ ‖z‖ := by
      have := norm_sub_norm_le x z
      linarith
    have hb := envelope_le_of_far hL hLR hA.2 hz
    calc envelope n R (x - z) * envelope n L z ≤
          envelope n R (x - z) * (4 ^ (n + 1) * envelope n R x) :=
          mul_le_mul_of_nonneg_left hb e1
      _ = 4 ^ (n + 1) * envelope n R x * envelope n R (x - z) := by ring
      _ ≤ _ := mul_le_mul_of_nonneg_left (by linarith) (by positivity)

/-- Pointwise bound for all `R, L > 0`:
`B_R(x - z) B_L(z) ≤ 4^{n+1} B_{max(R,L)}(x) (B_L(z) + B_R(x - z))`. -/
lemma envelope_mul_le {n : ℕ} {R L : ℝ} (hR : 0 < R) (hL : 0 < L)
    (x z : EuclideanSpace ℝ (Fin n)) :
    envelope n R (x - z) * envelope n L z ≤
      4 ^ (n + 1) * envelope n (max R L) x * (envelope n L z + envelope n R (x - z)) := by
  rcases le_total L R with h | h
  · rw [max_eq_left h]; exact envelope_mul_le_of_le hL h x z
  · rw [max_eq_right h]
    have := envelope_mul_le_of_le hR h x (x - z)
    rw [sub_sub_cancel] at this
    linarith [mul_comm (envelope n R (x - z)) (envelope n L z)]

/-- The constant `2 · 4^{n+1} C_n` of Blueprint Lemma 2.4 (`lem:maximal`) in
`B_R *_E B_L ≤ C B_{max(R,L)}`. -/
noncomputable def envelopeConvConst (n : ℕ) : ℝ := 2 * 4 ^ (n + 1) * envelopeConst n

/-- Blueprint Lemma 2.4 (`lem:maximal`), equation (2.1) (`eq:envelope`), second inequality:
for `R, L > 0` (in particular `R, L ≥ 1`) and `x ∈ E`, `z ↦ B_R(x - z) B_L(z)` is integrable and
`(B_R *_E B_L)(x) = ∫ B_R(x - z) B_L(z) dz ≤ C B_{max(R,L)}(x)`, `C = envelopeConvConst n`. -/
theorem envelope_conv_le {n : ℕ} {R L : ℝ} (hR : 0 < R) (hL : 0 < L)
    (x : EuclideanSpace ℝ (Fin n)) :
    Integrable (fun z => envelope n R (x - z) * envelope n L z) volume ∧
      ∫ z, envelope n R (x - z) * envelope n L z ≤
        envelopeConvConst n * envelope n (max R L) x := by
  obtain ⟨hiR, hIR⟩ := integrable_envelope_and_integral_le (n := n) hR
  obtain ⟨hiL, hIL⟩ := integrable_envelope_and_integral_le (n := n) hL
  have hiR' : Integrable (fun z => envelope n R (x - z)) volume := hiR.comp_sub_left x
  have hbd : Integrable (fun z => 4 ^ (n + 1) * envelope n (max R L) x *
      (envelope n L z + envelope n R (x - z))) volume := (hiL.add hiR').const_mul _
  have hcont : Continuous fun z => envelope n R (x - z) * envelope n L z :=
    ((continuous_envelope n hR).comp (continuous_const.sub continuous_id)).mul
      (continuous_envelope n hL)
  have hint : Integrable (fun z => envelope n R (x - z) * envelope n L z) volume :=
    hbd.mono' hcont.aestronglyMeasurable (Eventually.of_forall fun z => by
      rw [Real.norm_of_nonneg (mul_nonneg (envelope_nonneg hR _) (envelope_nonneg hL _))]
      exact envelope_mul_le hR hL x z)
  refine ⟨hint, ?_⟩
  have hM := envelope_nonneg (R := max R L) (lt_max_of_lt_left hR) x
  calc ∫ z, envelope n R (x - z) * envelope n L z
      ≤ ∫ z, 4 ^ (n + 1) * envelope n (max R L) x * (envelope n L z + envelope n R (x - z)) :=
        integral_mono hint hbd (envelope_mul_le hR hL x)
    _ = 4 ^ (n + 1) * envelope n (max R L) x *
          ((∫ z, envelope n L z) + ∫ z, envelope n R z) := by
        rw [integral_const_mul, integral_add hiL hiR',
          integral_sub_left_eq_self (fun z => envelope n R z) volume x]
    _ ≤ 4 ^ (n + 1) * envelope n (max R L) x * (envelopeConst n + envelopeConst n) := by
        gcongr
    _ = envelopeConvConst n * envelope n (max R L) x := by
        unfold envelopeConvConst; ring

/-! ## Lemma 2.5 (`lem:ttstar`): Schur, Hilbert–Schmidt, and linearization -/

section Schur

variable {α β : Type*} [MeasurableSpace α] [MeasurableSpace β] {μ : Measure α} {ν : Measure β}

/-- `‖g‖₂² = ∫ |g|²` (as an identity in `[0, ∞]`). -/
lemma eLpNorm_two_rpow_two {E : Type*} [NormedAddCommGroup E] {g : β → E}
    (hg : AEStronglyMeasurable g ν) :
    eLpNorm g 2 ν ^ (2 : ℝ) = ∫⁻ y, ‖g y‖ₑ ^ (2 : ℝ) ∂ν := by
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by norm_num) (by norm_num) hg, ← ENNReal.rpow_mul]
  norm_num

/-- `((a b)^{1/2} c)^2 = a b c^2` in `[0, ∞]`. -/
lemma sqrt_mul_mul_rpow_two (a c : ℝ≥0∞) : (a ^ (1 / 2 : ℝ) * c) ^ (2 : ℝ) = a * c ^ (2 : ℝ) := by
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), ← ENNReal.rpow_mul]
  norm_num

/-- Blueprint Lemma 2.5 (`lem:ttstar`), first assertion (Schur test), nonnegative majorant form:
on s-finite measure spaces (e.g. σ-finite ones, or counting measure on `ℤⁿ`), for a kernel `H`
that is a.e. strongly measurable on `X × Y`, with row bound `∫ |H(x,y)| dy ≤ A` (a.e. `x`) and
column bound `∫ |H(x,y)| dx ≤ B` (a.e. `y`), and any a.e. strongly measurable `g`,
`‖x ↦ ∫ |H(x,y)| |g(y)| dy‖₂ ≤ √(AB) ‖g‖₂`. -/
theorem eLpNorm_lintegral_kernel_le_schur [SFinite μ] [SFinite ν] {H : α → β → ℂ}
    (hH : AEStronglyMeasurable (Function.uncurry H) (μ.prod ν)) {A B : ℝ≥0∞}
    (hA : ∀ᵐ x ∂μ, ∫⁻ y, ‖H x y‖ₑ ∂ν ≤ A) (hB : ∀ᵐ y ∂ν, ∫⁻ x, ‖H x y‖ₑ ∂μ ≤ B)
    {g : β → ℂ} (hg : AEStronglyMeasurable g ν) :
    eLpNorm (fun x => ∫⁻ y, ‖H x y‖ₑ * ‖g y‖ₑ ∂ν) 2 μ ≤ (A * B) ^ (1 / 2 : ℝ) * eLpNorm g 2 ν := by
  have hHe : AEMeasurable (fun z : α × β => ‖H z.1 z.2‖ₑ) (μ.prod ν) := hH.enorm
  have hge : AEMeasurable (fun z : α × β => ‖g z.2‖ₑ) (μ.prod ν) :=
    (hg.comp_snd (μ := μ)).enorm
  have hM : AEMeasurable (fun x => ∫⁻ y, ‖H x y‖ₑ * ‖g y‖ₑ ∂ν) μ :=
    (hHe.mul hge).lintegral_prod_right'
  have h2 : AEMeasurable (fun z : α × β => ‖H z.1 z.2‖ₑ * ‖g z.2‖ₑ ^ (2 : ℝ)) (μ.prod ν) :=
    hHe.mul (hge.pow_const _)
  rw [eLpNorm_ennreal_le_iff (by norm_num) (by norm_num) _ hM]
  simp only [ENNReal.toReal_ofNat]
  rw [sqrt_mul_mul_rpow_two, eLpNorm_two_rpow_two hg]
  have hrow : ∀ᵐ x ∂μ, AEStronglyMeasurable (fun y => H x y) ν := hH.prodMk_left
  calc ∫⁻ x, (∫⁻ y, ‖H x y‖ₑ * ‖g y‖ₑ ∂ν) ^ (2 : ℝ) ∂μ
      ≤ ∫⁻ x, A * ∫⁻ y, ‖H x y‖ₑ * ‖g y‖ₑ ^ (2 : ℝ) ∂ν ∂μ := by
        refine lintegral_mono_ae ?_
        filter_upwards [hA, hrow] with x hx hxm
        refine (lintegral_mul_rpow_le_young ν (by norm_num) hxm.enorm hg.enorm).trans ?_
        norm_num only [ENNReal.rpow_one]
        exact mul_le_mul_left hx _
    _ = A * ∫⁻ x, ∫⁻ y, ‖H x y‖ₑ * ‖g y‖ₑ ^ (2 : ℝ) ∂ν ∂μ :=
        lintegral_const_mul'' _ h2.lintegral_prod_right'
    _ = A * ∫⁻ y, ∫⁻ x, ‖H x y‖ₑ * ‖g y‖ₑ ^ (2 : ℝ) ∂μ ∂ν := by
        rw [lintegral_lintegral_swap h2]
    _ ≤ A * ∫⁻ y, B * ‖g y‖ₑ ^ (2 : ℝ) ∂ν := by
        refine mul_le_mul_right (lintegral_mono_ae ?_) _
        filter_upwards [hB] with y hy
        rw [lintegral_mul_const' _ _ (ENNReal.rpow_ne_top_of_nonneg (by norm_num) enorm_ne_top)]
        exact mul_le_mul_left hy _
    _ = A * B * ∫⁻ y, ‖g y‖ₑ ^ (2 : ℝ) ∂ν := by
        rw [lintegral_const_mul'' _ (hg.enorm.pow_const _), mul_assoc]

omit [MeasurableSpace α] in
/-- Pointwise bound `|∫ H(x,y) g(y) dy| ≤ ∫ |H(x,y)| |g(y)| dy`. -/
lemma enorm_integral_kernel_le (H : α → β → ℂ) (g : β → ℂ) (x : α) :
    ‖∫ y, H x y * g y ∂ν‖ₑ ≤ ∫⁻ y, ‖H x y‖ₑ * ‖g y‖ₑ ∂ν :=
  (enorm_integral_le_lintegral_enorm _).trans_eq (by simp [enorm_mul])

/-- The kernel operator `x ↦ ∫ H(x,y) g(y) dy` is a.e. strongly measurable. -/
lemma aestronglyMeasurable_integral_kernel [SFinite ν] {H : α → β → ℂ}
    (hH : AEStronglyMeasurable (Function.uncurry H) (μ.prod ν)) {g : β → ℂ}
    (hg : AEStronglyMeasurable g ν) :
    AEStronglyMeasurable (fun x => ∫ y, H x y * g y ∂ν) μ :=
  (hH.mul (hg.comp_snd (μ := μ))).integral_prod_right'

/-- Blueprint Lemma 2.5 (`lem:ttstar`), first assertion (Schur test): on s-finite measure spaces
(e.g. σ-finite ones, or counting measure on `ℤⁿ`), for an a.e. strongly measurable kernel `H`
with row bound `∫ |H(x,y)| dy ≤ A` (a.e. `x`) and column bound `∫ |H(x,y)| dx ≤ B` (a.e. `y`),
the operator `Hg(x) = ∫ H(x,y) g(y) dy` satisfies `‖Hg‖₂ ≤ √(AB) ‖g‖₂` for every a.e. strongly
measurable `g` (so `‖H‖_{2→2} ≤ √(AB)`). -/
theorem eLpNorm_integral_kernel_le_schur [SFinite μ] [SFinite ν] {H : α → β → ℂ}
    (hH : AEStronglyMeasurable (Function.uncurry H) (μ.prod ν)) {A B : ℝ≥0∞}
    (hA : ∀ᵐ x ∂μ, ∫⁻ y, ‖H x y‖ₑ ∂ν ≤ A) (hB : ∀ᵐ y ∂ν, ∫⁻ x, ‖H x y‖ₑ ∂μ ≤ B)
    {g : β → ℂ} (hg : AEStronglyMeasurable g ν) :
    eLpNorm (fun x => ∫ y, H x y * g y ∂ν) 2 μ ≤ (A * B) ^ (1 / 2 : ℝ) * eLpNorm g 2 ν :=
  (eLpNorm_mono_enorm (aestronglyMeasurable_integral_kernel hH hg) fun x => by
    rw [enorm_eq_self]; exact enorm_integral_kernel_le H g x).trans
    (eLpNorm_lintegral_kernel_le_schur hH hA hB hg)

/-- Blueprint Lemma 2.5 (`lem:ttstar`), second assertion (Hilbert–Schmidt), nonnegative majorant
form: on s-finite measure spaces, for an a.e. strongly measurable kernel `H` and a.e. strongly
measurable `g`, `‖x ↦ ∫ |H(x,y)| |g(y)| dy‖₂ ≤ ‖H‖_{L²(X × Y)} ‖g‖₂`. -/
theorem eLpNorm_lintegral_kernel_le_hilbertSchmidt [SFinite μ] [SFinite ν] {H : α → β → ℂ}
    (hH : AEStronglyMeasurable (Function.uncurry H) (μ.prod ν)) {g : β → ℂ}
    (hg : AEStronglyMeasurable g ν) :
    eLpNorm (fun x => ∫⁻ y, ‖H x y‖ₑ * ‖g y‖ₑ ∂ν) 2 μ ≤
      eLpNorm (Function.uncurry H) 2 (μ.prod ν) * eLpNorm g 2 ν := by
  have hHe : AEMeasurable (fun z : α × β => ‖H z.1 z.2‖ₑ) (μ.prod ν) := hH.enorm
  have hge : AEMeasurable (fun z : α × β => ‖g z.2‖ₑ) (μ.prod ν) :=
    (hg.comp_snd (μ := μ)).enorm
  have hM : AEMeasurable (fun x => ∫⁻ y, ‖H x y‖ₑ * ‖g y‖ₑ ∂ν) μ :=
    (hHe.mul hge).lintegral_prod_right'
  have h2 : AEMeasurable (fun z : α × β => ‖H z.1 z.2‖ₑ ^ (2 : ℝ)) (μ.prod ν) :=
    hHe.pow_const _
  rw [eLpNorm_ennreal_le_iff (by norm_num) (by norm_num) _ hM]
  simp only [ENNReal.toReal_ofNat]
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), eLpNorm_two_rpow_two hg,
    eLpNorm_two_rpow_two hH]
  have hrow : ∀ᵐ x ∂μ, AEStronglyMeasurable (fun y => H x y) ν := hH.prodMk_left
  calc ∫⁻ x, (∫⁻ y, ‖H x y‖ₑ * ‖g y‖ₑ ∂ν) ^ (2 : ℝ) ∂μ
      ≤ ∫⁻ x, (∫⁻ y, ‖H x y‖ₑ ^ (2 : ℝ) ∂ν) * ∫⁻ y, ‖g y‖ₑ ^ (2 : ℝ) ∂ν ∂μ := by
        refine lintegral_mono_ae ?_
        filter_upwards [hrow] with x hxm
        have hh := ENNReal.lintegral_mul_le_Lp_mul_Lq ν Real.HolderConjugate.two_two
          hxm.enorm hg.enorm
        refine (ENNReal.rpow_le_rpow hh (by norm_num : (0 : ℝ) ≤ 2)).trans_eq ?_
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), ← ENNReal.rpow_mul,
          ← ENNReal.rpow_mul]
        norm_num
    _ = (∫⁻ x, ∫⁻ y, ‖H x y‖ₑ ^ (2 : ℝ) ∂ν ∂μ) * ∫⁻ y, ‖g y‖ₑ ^ (2 : ℝ) ∂ν :=
        lintegral_mul_const'' _ h2.lintegral_prod_right'
    _ = (∫⁻ z, ‖Function.uncurry H z‖ₑ ^ (2 : ℝ) ∂μ.prod ν) * ∫⁻ y, ‖g y‖ₑ ^ (2 : ℝ) ∂ν := by
        congr 1; exact (lintegral_prod _ h2).symm

/-- Blueprint Lemma 2.5 (`lem:ttstar`), second assertion (Hilbert–Schmidt): on s-finite measure
spaces, for an a.e. strongly measurable kernel `H` and a.e. strongly measurable `g`,
`‖x ↦ ∫ H(x,y) g(y) dy‖₂ ≤ ‖H‖_{L²(X × Y)} ‖g‖₂` (so `‖H‖_{2→2} ≤ ‖H‖_{L²(X × Y)}`). -/
theorem eLpNorm_integral_kernel_le_hilbertSchmidt [SFinite μ] [SFinite ν] {H : α → β → ℂ}
    (hH : AEStronglyMeasurable (Function.uncurry H) (μ.prod ν)) {g : β → ℂ}
    (hg : AEStronglyMeasurable g ν) :
    eLpNorm (fun x => ∫ y, H x y * g y ∂ν) 2 μ ≤
      eLpNorm (Function.uncurry H) 2 (μ.prod ν) * eLpNorm g 2 ν :=
  (eLpNorm_mono_enorm (aestronglyMeasurable_integral_kernel hH hg) fun x => by
    rw [enorm_eq_self]; exact enorm_integral_kernel_le H g x).trans
    (eLpNorm_lintegral_kernel_le_hilbertSchmidt hH hg)

end Schur

/-! ### Lemma 2.5, third assertion (`‖T‖² = ‖TT*‖`) -/

section TTstar

variable {𝕜 E F : Type*} [RCLike 𝕜] [NormedAddCommGroup E] [InnerProductSpace 𝕜 E]
  [CompleteSpace E] [NormedAddCommGroup F] [InnerProductSpace 𝕜 F] [CompleteSpace F]

open ContinuousLinearMap in
/-- Blueprint Lemma 2.5 (`lem:ttstar`), third assertion: for a bounded operator `T : E → F`
between Hilbert spaces, `‖T‖² = ‖T T*‖`, and also `‖T*‖ = ‖T‖` and `‖T‖² = ‖T* T‖`. -/
theorem norm_sq_eq_norm_comp_adjoint (T : E →L[𝕜] F) :
    ‖T‖ ^ 2 = ‖T ∘L adjoint T‖ ∧ ‖adjoint T‖ = ‖T‖ ∧ ‖T‖ ^ 2 = ‖adjoint T ∘L T‖ := by
  have hadj : ‖adjoint T‖ = ‖T‖ := LinearIsometryEquiv.norm_map _ _
  refine ⟨?_, hadj, ?_⟩
  · have h := norm_adjoint_comp_self (adjoint T)
    rw [adjoint_adjoint, hadj] at h
    rw [h, sq]
  · rw [norm_adjoint_comp_self, sq]

end TTstar

/-! ### Lemma 2.5, fourth assertion (linearization) -/

section Linearization

variable {α ι : Type*} [MeasurableSpace α]

/-- Measurable selection of a maximizing index: for a nonempty finite set `F` of indices and
measurable `g a : α → [0, ∞]` (`a ∈ F`), there is `σ : α → F` with measurable level sets such that
`g (σ x) x` is the maximum of `g a x` over `a ∈ F` (ties resolved by the order of insertion). -/
lemma exists_measurable_argmax (g : ι → α → ℝ≥0∞) {F : Finset ι} (hF : F.Nonempty)
    (hg : ∀ a ∈ F, Measurable (g a)) :
    ∃ σ : α → ι, (∀ x, σ x ∈ F) ∧ (∀ a, MeasurableSet (σ ⁻¹' {a})) ∧
      ∀ x, ∀ b ∈ F, g b x ≤ g (σ x) x := by
  classical
  revert hg
  induction hF using Finset.Nonempty.cons_induction with
  | singleton a =>
    intro _
    refine ⟨fun _ => a, fun x => Finset.mem_singleton_self a, fun b => ?_, fun x b hb => ?_⟩
    · rw [Set.preimage_const]; split_ifs <;> simp
    · rw [Finset.mem_singleton.1 hb]
  | cons a s ha hs ih =>
    intro hg
    obtain ⟨σ', hσ'F, hσ'm, hσ'⟩ := ih fun b hb => hg b (Finset.mem_cons_of_mem hb)
    set S : Set α := {x | g (σ' x) x ≤ g a x} with hS_def
    have hga : Measurable (g a) := hg a (Finset.mem_cons_self a s)
    have hS : MeasurableSet S := by
      have : S = ⋃ b ∈ s, (σ' ⁻¹' {b} ∩ {x | g b x ≤ g a x}) := by
        ext x
        simp only [hS_def, Set.mem_ofPred_eq, Set.mem_iUnion, Set.mem_inter_iff,
          Set.mem_preimage, Set.mem_singleton_iff, exists_prop]
        exact ⟨fun h => ⟨σ' x, hσ'F x, rfl, h⟩, fun ⟨b, _, hb, h⟩ => hb ▸ h⟩
      rw [this]
      exact Finset.measurableSet_biUnion _ fun b hb =>
        (hσ'm b).inter (measurableSet_le (hg b (Finset.mem_cons_of_mem hb)) hga)
    refine ⟨fun x => if x ∈ S then a else σ' x, fun x => ?_, fun b => ?_, fun x b hb => ?_⟩
    · dsimp only
      split_ifs
      · exact Finset.mem_cons_self a s
      · exact Finset.mem_cons_of_mem (hσ'F x)
    · have : (fun x => if x ∈ S then a else σ' x) ⁻¹' {b} =
          (S ∩ {_x | a = b}) ∪ (Sᶜ ∩ σ' ⁻¹' {b}) := by
        ext x
        by_cases hx : x ∈ S <;> simp [hx]
      rw [this]
      exact (hS.inter (MeasurableSet.const _)).union (hS.compl.inter (hσ'm b))
    · dsimp only
      rcases Finset.mem_cons.1 hb with rfl | hb
      · split_ifs with hx
        · exact le_rfl
        · exact (not_le.1 hx).le
      · split_ifs with hx
        · exact (hσ' x b hb).trans hx
        · exact hσ' x b hb

/-- Blueprint Lemma 2.5 (`lem:ttstar`), fourth assertion, selection: for a nonempty finite family
of a.e. strongly measurable functions `u a` (think `u a = T_a f`), there is a selection
`σ : α → F` with measurable level sets such that `|u (σ x) x| = max_{a ∈ F} |u a x|` for almost
every `x` (for every `x` if the `u a` are strongly measurable). -/
theorem exists_linearization {E : Type*} [NormedAddCommGroup E] {μ : Measure α}
    (u : ι → α → E) {F : Finset ι} (hF : F.Nonempty)
    (hu : ∀ a ∈ F, AEStronglyMeasurable (u a) μ) :
    ∃ σ : α → ι, (∀ x, σ x ∈ F) ∧ (∀ a, MeasurableSet (σ ⁻¹' {a})) ∧
      ∀ᵐ x ∂μ, ‖u (σ x) x‖ₑ = F.sup fun a => ‖u a x‖ₑ := by
  classical
  set v : ι → α → E := fun a => if h : a ∈ F then (hu a h).mk (u a) else u a
  have hv : ∀ a ∈ F, Measurable fun x => ‖v a x‖ₑ := fun a ha => by
    simp only [v, ha, ↓reduceDIte]
    exact (hu a ha).stronglyMeasurable_mk.enorm
  obtain ⟨σ, hσF, hσm, hσ⟩ := exists_measurable_argmax (fun a x => ‖v a x‖ₑ) hF hv
  refine ⟨σ, hσF, hσm, ?_⟩
  have hae : ∀ᵐ x ∂μ, ∀ a ∈ F, u a x = v a x := by
    rw [Finset.eventually_all]
    intro a ha
    simp only [v, ha, ↓reduceDIte]
    exact (hu a ha).ae_eq_mk
  filter_upwards [hae] with x hx
  rw [hx _ (hσF x)]
  refine le_antisymm ?_ (Finset.sup_le fun b hb => ?_)
  · rw [← hx _ (hσF x)]
    exact Finset.le_sup (f := fun a => ‖u a x‖ₑ) (hσF x)
  · rw [hx b hb]; exact hσ x b hb

/-- The linearized function `x ↦ u (σ x) x` of a selection with measurable level sets is a.e.
strongly measurable. -/
lemma aestronglyMeasurable_linearization {E : Type*} [NormedAddCommGroup E] {μ : Measure α}
    (u : ι → α → E) {F : Finset ι} (hu : ∀ a ∈ F, AEStronglyMeasurable (u a) μ) (σ : α → ι)
    (hσF : ∀ x, σ x ∈ F) (hσm : ∀ a, MeasurableSet (σ ⁻¹' {a})) :
    AEStronglyMeasurable (fun x => u (σ x) x) μ := by
  classical
  have : (fun x => u (σ x) x) = ∑ a ∈ F, (σ ⁻¹' {a}).indicator (u a) := by
    funext x
    rw [Finset.sum_apply, Finset.sum_eq_single (σ x)]
    · rw [Set.indicator_of_mem (by simp)]
    · intro b _ hb
      exact Set.indicator_of_notMem (by simpa [eq_comm] using hb) _
    · intro h; exact absurd (hσF x) h
  rw [this]
  exact Finset.aestronglyMeasurable_sum _ fun a ha => (hu a ha).indicator (hσm a)

/-- Blueprint Lemma 2.5 (`lem:ttstar`), fourth assertion (linearization), general form: for a
finite family of a.e. strongly measurable functions `u a` (`a ∈ F`), any `0 < p ≤ ∞` (indeed any
`p`), if `‖x ↦ u (σ x) x‖_p ≤ C` for every selection `σ : α → F` with measurable level sets, then
`‖max_{a ∈ F} |u a|‖_p ≤ C`. -/
theorem eLpNorm_finset_sup_le_of_linearization {E : Type*} [NormedAddCommGroup E]
    {μ : Measure α} {p : ℝ≥0∞} (u : ι → α → E) (F : Finset ι)
    (hu : ∀ a ∈ F, AEStronglyMeasurable (u a) μ) (C : ℝ≥0∞)
    (hC : ∀ σ : α → ι, (∀ x, σ x ∈ F) → (∀ a, MeasurableSet (σ ⁻¹' {a})) →
      eLpNorm (fun x => u (σ x) x) p μ ≤ C) :
    eLpNorm (fun x => F.sup fun a => ‖u a x‖ₑ) p μ ≤ C := by
  rcases F.eq_empty_or_nonempty with rfl | hF
  · simp
  obtain ⟨σ, hσF, hσm, hσ⟩ := exists_linearization u hF hu
  have hmeas := aestronglyMeasurable_linearization u hu σ hσF hσm
  calc eLpNorm (fun x => F.sup fun a => ‖u a x‖ₑ) p μ
      = eLpNorm (fun x => ‖u (σ x) x‖ₑ) p μ := eLpNorm_congr_ae (hσ.mono fun x hx => hx.symm)
    _ = eLpNorm (fun x => u (σ x) x) p μ := eLpNorm_enorm _ hmeas
    _ ≤ C := hC σ hσF hσm

/-- Blueprint Lemma 2.5 (`lem:ttstar`), fourth assertion (linearization), operator form: for a
finite family `T a` (`a ∈ F`) of operators (e.g. convolution operators) and a fixed `f` with each
`T a f` a.e. strongly measurable (automatic on `ℤⁿ`), a uniform bound `‖T_{σ(·)} f‖_p ≤ C` for all
pointwise selections `σ : α → F` with measurable level sets bounds the maximal function:
`‖max_{a ∈ F} |T a f|‖_p ≤ C`. Combine with `eLpNorm_iSup_le_of_finset_count` or
`eLpNorm_iSup_le_of_finset_countable` (Lemma 2.1) to pass to infinite families. -/
theorem eLpNorm_finset_sup_le_of_linearization_op {β : Type*} {μ : Measure α} {p : ℝ≥0∞}
    (T : ι → (β → ℂ) → α → ℂ) (f : β → ℂ) (F : Finset ι)
    (hT : ∀ a ∈ F, AEStronglyMeasurable (T a f) μ) (C : ℝ≥0∞)
    (hC : ∀ σ : α → ι, (∀ x, σ x ∈ F) → (∀ a, MeasurableSet (σ ⁻¹' {a})) →
      eLpNorm (fun x => T (σ x) f x) p μ ≤ C) :
    eLpNorm (fun x => F.sup fun a => ‖T a f x‖ₑ) p μ ≤ C :=
  eLpNorm_finset_sup_le_of_linearization (fun a => T a f) F hT C hC

end Linearization

/-! ## Lemma 2.7 (`lem:binary`): binary partial sums -/

/-- Blueprint Lemma 2.7 (`lem:binary`, "Binary partial sums"): for `u_1, …, u_{2^L}` in a
(semi)normed group (e.g. `ℂ`) and the dyadic intervals `I_{l,k} = {k 2^l + 1, …, (k+1) 2^l}`,
`0 ≤ l ≤ L`, `0 ≤ k < 2^{L-l}`, every partial sum with `0 ≤ J ≤ 2^L` satisfies
`|∑_{j=1}^J u_j| ≤ ∑_{l=0}^L (∑_{k=0}^{2^{L-l}-1} |∑_{j ∈ I_{l,k}} u_j|²)^{1/2}`
(equivalently, the maximum over `J` is bounded by the right side). -/
theorem binary_maximal_inequality {E : Type*} [SeminormedAddCommGroup E] (L : ℕ) (u : ℕ → E) :
    ∀ J ≤ 2 ^ L, ‖∑ j ∈ Finset.Icc 1 J, u j‖ ≤
      ∑ l ∈ Finset.range (L + 1), Real.sqrt (∑ k ∈ Finset.range (2 ^ (L - l)),
        ‖∑ j ∈ Finset.Icc (k * 2 ^ l + 1) ((k + 1) * 2 ^ l), u j‖ ^ 2) := by
  intro J hJ
  have hIoc : ∀ a b : ℕ, Finset.Icc (a + 1) b = Finset.Ioc a b := by
    intro a b; ext; simp only [Finset.mem_Icc, Finset.mem_Ioc]; omega
  set F : ℕ → E := fun n => ∑ j ∈ Finset.Ioc 0 n, u j with hF
  have hdiff : ∀ a b, a ≤ b → F b - F a = ∑ j ∈ Finset.Ioc a b, u j := by
    intro a b hab
    rw [sub_eq_iff_eq_add', hF]
    exact (Finset.sum_Ioc_consecutive u (Nat.zero_le a) hab).symm
  have tele : ∑ j ∈ Finset.Icc 1 J, u j =
      ∑ l ∈ Finset.range (L + 1), (F (J / 2 ^ l * 2 ^ l) - F (J / 2 ^ (l + 1) * 2 ^ (l + 1))) := by
    rw [Finset.sum_range_sub' (fun l => F (J / 2 ^ l * 2 ^ l))]
    have h0 : J / 2 ^ (L + 1) = 0 :=
      Nat.div_eq_of_lt (lt_of_le_of_lt hJ (Nat.pow_lt_pow_right (by norm_num) (Nat.lt_succ_self L)))
    simp [hF, h0, hIoc]
  rw [tele]
  refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun l hl => ?_)
  have hlL : l ≤ L := Nat.lt_succ_iff.1 (Finset.mem_range.1 hl)
  set a := J / 2 ^ l with ha
  have hdiv : J / 2 ^ (l + 1) = a / 2 := by
    rw [ha, Nat.div_div_eq_div_mul, pow_succ]
  rw [hdiv]
  have hsq0 : 0 ≤ Real.sqrt (∑ k ∈ Finset.range (2 ^ (L - l)),
      ‖∑ j ∈ Finset.Icc (k * 2 ^ l + 1) ((k + 1) * 2 ^ l), u j‖ ^ 2) := Real.sqrt_nonneg _
  rcases Nat.even_or_odd a with he | ho
  · have : a / 2 * 2 ^ (l + 1) = a * 2 ^ l := by
      obtain ⟨m, hm⟩ := he
      rw [hm, pow_succ]
      rw [show m + m = m * 2 by ring, Nat.mul_div_cancel _ (by norm_num)]; ring
    rw [this, sub_self, norm_zero]
    exact hsq0
  · have ha1 : 1 ≤ a := ho.pos
    have : a / 2 * 2 ^ (l + 1) = (a - 1) * 2 ^ l := by
      obtain ⟨m, hm⟩ := ho
      rw [hm, pow_succ, show 2 * m + 1 - 1 = m * 2 by omega,
        show (2 * m + 1) / 2 = m by omega]; ring
    have hle : (a - 1) * 2 ^ l ≤ a * 2 ^ l := Nat.mul_le_mul_right _ (Nat.sub_le a 1)
    rw [this, hdiff _ _ hle]
    have hk : a - 1 ∈ Finset.range (2 ^ (L - l)) := by
      have : a ≤ 2 ^ (L - l) := by
        rw [ha]
        refine Nat.div_le_of_le_mul ?_
        rw [← pow_add, Nat.add_sub_cancel' hlL]; exact hJ
      exact Finset.mem_range.2 (by omega)
    have hk1 : a - 1 + 1 = a := Nat.sub_add_cancel ha1
    have hterm := Finset.single_le_sum (f := fun k =>
      ‖∑ j ∈ Finset.Icc (k * 2 ^ l + 1) ((k + 1) * 2 ^ l), u j‖ ^ 2)
      (fun k _ => sq_nonneg _) hk
    simp only [hk1, hIoc] at hterm
    have := Real.abs_le_sqrt hterm
    rw [abs_of_nonneg (norm_nonneg _)] at this
    simpa only [hIoc] using this

end Auto
