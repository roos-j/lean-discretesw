/-- Blueprint Lemma 2.1 (`lem:finite`), fifth assertion (extension): a linear map `T` on a dense
subspace `S` of a normed space `X`, into a complete normed space, with `‖T s‖ ≤ C ‖s‖`, extends
to a continuous linear map `T'` on `X` with `‖T' x‖ ≤ C ‖x‖`; the extension is unique among all
continuous maps `X → F` agreeing with `T` on `S`. -/
theorem exists_unique_extension_of_dense {𝕜 X F : Type*} [NontriviallyNormedField 𝕜]
    [NormedAddCommGroup X] [NormedSpace 𝕜 X] [NormedAddCommGroup F] [NormedSpace 𝕜 F]
    [CompleteSpace F] {S : Submodule 𝕜 X} (hS : Dense (S : Set X)) (T : S →ₗ[𝕜] F) (C : ℝ)
    (hT : ∀ s, ‖T s‖ ≤ C * ‖s‖) :
    ∃ T' : X →L[𝕜] F, (∀ s : S, T' s = T s) ∧ (∀ x, ‖T' x‖ ≤ C * ‖x‖) ∧
      ∀ g : X → F, Continuous g → (∀ s : S, g s = T s) → g = T' := by
  set T₀ : S →L[𝕜] F := T.mkContinuous C hT
  have hdense : DenseRange (S.subtypeL) := by
    simpa [DenseRange, Submodule.coe_subtype,
      Subtype.range_coe_subtype] using hS
  have hind : IsUniformInducing (S.subtypeL) := isUniformEmbedding_subtype_val.isUniformInducing
  set T' := T₀.extend S.subtypeL
  have hext : ∀ s : S, T' s = T s := fun s => by
    have := ContinuousLinearMap.extend_eq T₀ hdense hind s
    simpa [T₀] using this
  have huniq : ∀ g : X → F, Continuous g → (∀ s : S, g s = T s) → g = T' := by
    intro g hg hgs
    refine Continuous.ext_on hS hg T'.continuous ?_
    intro y hy
    exact (hgs ⟨y, hy⟩).trans (hext ⟨y, hy⟩).symm
  refine ⟨T', hext, fun x => ?_, huniq⟩
  have hcl : IsClosed {x : X | ‖T' x‖ ≤ C * ‖x‖} :=
    isClosed_le (continuous_norm.comp T'.continuous) (continuous_const.mul continuous_norm)
  have hsub : (S : Set X) ⊆ {x : X | ‖T' x‖ ≤ C * ‖x‖} := by
    intro y hy
    have := hext ⟨y, hy⟩
    simp only [Set.mem_ofPred_eq]
    rw [this]
    exact hT ⟨y, hy⟩
  have := closure_minimal hsub hcl
  rw [hS.closure_eq] at this
  exact this (Set.mem_univ x)

