/-- The lattice box `{x ∈ ℤⁿ : |x|_∞ ≤ R}` used for finite-support truncations. -/
def latBox (n R : ℕ) : Set (Fin n → ℤ) := {x | ∀ i, |x i| ≤ (R : ℤ)}

/-- The lattice box `{x ∈ ℤⁿ : |x|_∞ ≤ R}` is finite, so truncations to it have finite support. -/
theorem latBox_finite (n R : ℕ) : (latBox n R).Finite := by
  have : latBox n R = Set.pi Set.univ (fun _ => Set.Icc (-(R : ℤ)) R) := by
    ext x
    simp only [latBox, Set.mem_ofPred_eq, Set.mem_univ_pi, Set.mem_Icc, abs_le]
  rw [this]
  exact Set.Finite.pi fun _ => Set.finite_Icc _ _

/-- Truncations of a function to a lattice box have finite support. -/
theorem support_indicator_latBox_finite {F : Type*} [Zero F] (n R : ℕ) (f : (Fin n → ℤ) → F) :
    (Function.support ((latBox n R).indicator f)).Finite :=
  (latBox_finite n R).subset Set.support_indicator_subset

