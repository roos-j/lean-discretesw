/-- Helper: `a(r) = 1` for `0 ≤ r ≤ 1`. -/
lemma dyadicProfile_eq_one {r : ℝ} (h0 : 0 ≤ r) (h : r ≤ 1) : dyadicProfile r = 1 :=
  smoothTransition.one_of_one_le (by nlinarith)

/-- Helper: `a(r) = 0` for `r ≥ 2`. -/
lemma dyadicProfile_eq_zero {r : ℝ} (h : 2 ≤ r) : dyadicProfile r = 0 :=
  smoothTransition.zero_of_nonpos (by nlinarith)

/-- Helper: `a` is nonincreasing on `[0, ∞)`. -/
lemma dyadicProfile_antitoneOn {r s : ℝ} (h0 : 0 ≤ r) (h : r ≤ s) :
    dyadicProfile s ≤ dyadicProfile r :=
  smoothTransition.monotone (by nlinarith)

/-- The smooth radial cutoff `η(x) = a(|x|)` of Blueprint Lemma 4.1 (`lem:dyadic`). -/
noncomputable def dyadicEta (x : EuclideanSpace ℝ (Fin n)) : ℝ := dyadicProfile ‖x‖

/-- The dyadic bump `ψ(x) = η(x) - η(2x)` of Blueprint Lemma 4.1 (`lem:dyadic`). -/
noncomputable def dyadicPsi (x : EuclideanSpace ℝ (Fin n)) : ℝ :=
  dyadicEta x - dyadicEta ((2 : ℝ) • x)

