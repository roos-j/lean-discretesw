  have h3 : ContDiffAt ℝ ∞ (fun y : EuclideanSpace ℝ (Fin n) => ((((‖y‖ ^ n)⁻¹ : ℝ)) : ℂ)) x :=
    Complex.ofRealCLM.contDiff.contDiffAt.comp x h2
  refine (h1.mul h3).congr_of_eventuallyEq ?_
  filter_upwards [isOpen_compl_singleton.mem_nhds hx] with y hy
  simp [swKernel, show y ≠ 0 from hy, div_eq_mul_inv]

/-- Helper: the scaling identity `K_j(x) = 2^{-jn} K_0(2^{-j} x)`. -/
lemma dyadicKernel_eq_smul
    (hΩ : ∀ x : EuclideanSpace ℝ (Fin n), x ≠ 0 → ∀ t : ℝ, 0 < t → Ω (t • x) = Ω x)
    (j : ℤ) (x : EuclideanSpace ℝ (Fin n)) :
    dyadicKernel Ω j x = ((2 : ℝ) ^ (-j)) ^ n • dyadicKernel Ω 0 ((2 : ℝ) ^ (-j) • x) := by
  have hc : (0 : ℝ) < 2 ^ (-j) := by positivity
  rw [dyadicKernel, dyadicKernel, swKernel_smul hΩ hc, neg_zero, zpow_zero, one_smul,
    Complex.real_smul]
  have : ((2 : ℝ) ^ (-j)) ^ n ≠ 0 := by positivity
  push_cast
  field_simp

/-- Helper: `K_0(x) = 0` for `|x| ≤ 1/2`. -/
lemma dyadicKernel_zero_eq_zero_of_le {x : EuclideanSpace ℝ (Fin n)} (h : ‖x‖ ≤ 1 / 2) :
    dyadicKernel Ω 0 x = 0 := by
  simp [dyadicKernel, dyadicPsi_eq_zero_of_le h]

/-- Helper: `K_0(x) = 0` for `|x| ≥ 2`. -/
lemma dyadicKernel_zero_eq_zero_of_ge {x : EuclideanSpace ℝ (Fin n)} (h : 2 ≤ ‖x‖) :
    dyadicKernel Ω 0 x = 0 := by
  simp [dyadicKernel, dyadicPsi_eq_zero_of_ge h]

/-- Helper: `K_0` is smooth on all of `E` (it vanishes near `0`). -/
lemma contDiff_dyadicKernel_zero (hΩ : ContDiffOn ℝ ∞ Ω {0}ᶜ) :
    ContDiff ℝ ∞ (dyadicKernel Ω 0) := by
  rw [contDiff_iff_contDiffAt]
  intro x
  by_cases hx : x = 0
  · subst hx
    refine (contDiffAt_const (c := (0 : ℂ))).congr_of_eventuallyEq ?_
    filter_upwards [ball_mem_nhds (0 : EuclideanSpace ℝ (Fin n)) (by norm_num : (0 : ℝ) < 1 / 2)]
      with y hy
    rw [mem_ball_zero_iff] at hy
    exact dyadicKernel_zero_eq_zero_of_le hy.le
  · have h2 : ContDiff ℝ ∞ (fun y : EuclideanSpace ℝ (Fin n) =>
        ((dyadicPsi ((2 : ℝ) ^ (-(0 : ℤ)) • y) : ℝ) : ℂ)) :=
      Complex.ofRealCLM.contDiff.comp (contDiff_dyadicPsi.comp (contDiff_const_smul _))
    exact (contDiffAt_swKernel hΩ hx).mul h2.contDiffAt

/-- Helper: `K_0` has compact support. -/
lemma hasCompactSupport_dyadicKernel_zero : HasCompactSupport (dyadicKernel Ω 0) := by
  refine HasCompactSupport.intro (isCompact_closedBall (0 : EuclideanSpace ℝ (Fin n)) 2) ?_
  intro x hx
  rw [mem_closedBall_zero_iff, not_le] at hx
  exact dyadicKernel_zero_eq_zero_of_ge hx.le

/-- Blueprint Lemma 4.1 (`lem:dyadic`): each `K_j` is smooth on all of `E`. -/
theorem contDiff_dyadicKernel (hΩ : IsSWProfile Ω) (j : ℤ) :
    ContDiff ℝ ∞ (dyadicKernel Ω j) := by
  have : dyadicKernel Ω j =
      fun x => ((2 : ℝ) ^ (-j)) ^ n • dyadicKernel Ω 0 ((2 : ℝ) ^ (-j) • x) :=
    funext (dyadicKernel_eq_smul hΩ.2.1 j)
  rw [this]
  exact ((contDiff_dyadicKernel_zero hΩ.1).comp (contDiff_const_smul _)).const_smul _

/-- Blueprint Lemma 4.1 (`lem:dyadic`), (4.1), derivative bounds: for every order `k` there is
`C_k` with `‖D^k K_j(x)‖ ≤ C_k 2^{-j(n+k)}` for all `j ∈ ℤ` and `x ∈ E`. -/
theorem norm_iteratedFDeriv_dyadicKernel_le (hΩ : IsSWProfile Ω) (k : ℕ) :
    ∃ C : ℝ, ∀ (j : ℤ) (x : EuclideanSpace ℝ (Fin n)),
      ‖iteratedFDeriv ℝ k (dyadicKernel Ω j) x‖ ≤ C * (2 : ℝ) ^ (-j * ((n : ℤ) + k)) := by
  have h0 := contDiff_dyadicKernel_zero hΩ.1
  obtain ⟨C, hC⟩ :=
    (h0.continuous_iteratedFDeriv (m := k) (by simp)).bounded_above_of_compact_support
    (hasCompactSupport_dyadicKernel_zero.iteratedFDeriv k)
  refine ⟨C, fun j x => ?_⟩
  set c : ℝ := (2 : ℝ) ^ (-j) with hc_def
  have hc : 0 < c := by positivity
  let L : EuclideanSpace ℝ (Fin n) →L[ℝ] EuclideanSpace ℝ (Fin n) :=
    c • ContinuousLinearMap.id ℝ _
  have hL : ‖L‖ ≤ c := by
    calc ‖L‖ ≤ ‖c‖ * ‖ContinuousLinearMap.id ℝ (EuclideanSpace ℝ (Fin n))‖ :=
          norm_smul_le c (ContinuousLinearMap.id ℝ (EuclideanSpace ℝ (Fin n)))
      _ ≤ ‖c‖ * 1 := by gcongr; exact ContinuousLinearMap.norm_id_le
      _ = c := by rw [mul_one, Real.norm_eq_abs, abs_of_pos hc]
  have hfun : dyadicKernel Ω j = fun x => c ^ n • (dyadicKernel Ω 0 ∘ L) x :=
    funext (dyadicKernel_eq_smul hΩ.2.1 j)
  have hcomp : ContDiff ℝ ∞ (dyadicKernel Ω 0 ∘ L) := h0.comp L.contDiff
  rw [hfun, iteratedFDeriv_const_smul_apply' (hcomp.of_le (by simp)).contDiffAt,
    L.iteratedFDeriv_comp_right h0 x (by simp), norm_smul]
  have hC0 : 0 ≤ C := (norm_nonneg _).trans (hC 0)
  calc ‖c ^ n‖ * ‖(iteratedFDeriv ℝ k (dyadicKernel Ω 0) (L x)).compContinuousLinearMap
        fun _ => L‖
      ≤ c ^ n * (C * ∏ _i : Fin k, ‖L‖) := by
        rw [Real.norm_eq_abs, abs_of_pos (by positivity)]
        gcongr
        exact (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans
          (by gcongr; exact hC _)
    _ ≤ c ^ n * (C * c ^ k) := by
        rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
        gcongr
    _ = C * (2 : ℝ) ^ (-j * ((n : ℤ) + k)) := by
        rw [hc_def, ← zpow_natCast, ← zpow_natCast, ← zpow_mul, ← zpow_mul, mul_left_comm,
          ← zpow_add₀ two_ne_zero, mul_add]

/-- Blueprint Lemma 4.1 (`lem:dyadic`): `K_j` is supported where `2^{j-1} < |x| < 2^{j+1}`. -/
theorem support_dyadicKernel (j : ℤ) :
    Function.support (dyadicKernel Ω j) ⊆
      {x | (2 : ℝ) ^ (j - 1) < ‖x‖ ∧ ‖x‖ < (2 : ℝ) ^ (j + 1)} := by
  intro x hx
  have hψ : dyadicPsi ((2 : ℝ) ^ (-j) • x) ≠ 0 := by
    intro h; apply hx; rw [dyadicKernel, h]; simp
  have h := support_dyadicPsi hψ
  simp only [mem_ofPred_eq, norm_smul, Real.norm_eq_abs,
    zpow_neg] at h
  rw [abs_of_pos (by positivity)] at h
  have h2 : (0 : ℝ) < 2 ^ j := by positivity
  rw [zpow_sub_one₀ two_ne_zero, zpow_add_one₀ two_ne_zero]
  constructor
  · have := h.1
    rw [inv_mul_eq_div, lt_div_iff₀ h2] at this
    nlinarith
  · have := h.2
    rw [inv_mul_eq_div, div_lt_iff₀ h2] at this
    linarith

/-- Helper: `K_j(x) = 0` for `|x| ≥ 2^{j+1}`. -/
lemma dyadicKernel_eq_zero_of_le (j : ℤ) {x : EuclideanSpace ℝ (Fin n)}
    (h : (2 : ℝ) ^ (j + 1) ≤ ‖x‖) : dyadicKernel Ω j x = 0 := by
  by_contra hx
  exact absurd (support_dyadicKernel j hx).2 (not_lt.2 h)

/-- Helper: `K_j` has compact support. -/
theorem hasCompactSupport_dyadicKernel (j : ℤ) : HasCompactSupport (dyadicKernel Ω j) := by
  refine HasCompactSupport.intro
    (isCompact_closedBall (0 : EuclideanSpace ℝ (Fin n)) ((2 : ℝ) ^ (j + 1))) ?_
  intro x hx
  rw [mem_closedBall_zero_iff, not_le] at hx
  exact dyadicKernel_eq_zero_of_le j hx.le

/-- Blueprint Lemma 4.1 (`lem:dyadic`): `K_j ∈ L¹(E)`. -/
theorem integrable_dyadicKernel (hΩ : IsSWProfile Ω) (j : ℤ) :
    Integrable (dyadicKernel Ω j) :=
  (contDiff_dyadicKernel hΩ j).continuous.integrable_of_hasCompactSupport
    (hasCompactSupport_dyadicKernel j)

/-- Helper: `‖K_j‖_{L¹} = ‖K_0‖_{L¹}` (dilation invariance). -/
theorem integral_norm_dyadicKernel (hΩ : IsSWProfile Ω) (j : ℤ) :
    ∫ x, ‖dyadicKernel Ω j x‖ = ∫ x, ‖dyadicKernel Ω 0 x‖ := by
  have hc : (0 : ℝ) < 2 ^ (-j) := by positivity
  simp_rw [dyadicKernel_eq_smul hΩ.2.1 j, norm_smul]
  rw [integral_const_mul, Measure.integral_comp_smul volume (fun y => ‖dyadicKernel Ω 0 y‖),
    finrank_euclideanSpace_fin, smul_eq_mul, Real.norm_eq_abs, abs_of_pos (by positivity),
    abs_of_pos (by positivity), ← mul_assoc, mul_inv_cancel₀ (by positivity), one_mul]


/-- Blueprint Lemma 4.1 (`lem:dyadic`), (4.1), `‖K_j‖_{L¹(E)} ≤ C` uniformly in `j ∈ ℤ`. -/
theorem dyadicKernel_L1 (hΩ : IsSWProfile Ω) :
    ∃ C : ℝ, ∀ j : ℤ, Integrable (dyadicKernel Ω j) ∧ ∫ x, ‖dyadicKernel Ω j x‖ ≤ C ∧
      eLpNorm (dyadicKernel Ω j) 1 volume ≤ ENNReal.ofReal C := by
  refine ⟨∫ x, ‖dyadicKernel Ω 0 x‖, fun j => ⟨integrable_dyadicKernel hΩ j,
    (integral_norm_dyadicKernel hΩ j).le, ?_⟩⟩
  rw [eLpNorm_one_eq_lintegral_enorm, ← integral_norm_dyadicKernel hΩ j,
    ofReal_integral_norm_eq_lintegral_enorm (integrable_dyadicKernel hΩ j)]
  exact (integrable_dyadicKernel hΩ j).1

/-! ### Cancellation (4.1), (4.3) -/

/-- Blueprint Lemma 4.1 (`lem:dyadic`), cancellation for radial factors: for `n ≥ 1`, admissible `Ω`
and every `b : ℝ → ℂ`, `∫_E K(x) b(|x|) dx = 0`. (The blueprint assumes `b` supported away from
zero; this holds for arbitrary `b` since both sides are Bochner integrals.) -/
theorem integral_swKernel_mul_radial_eq_zero (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) (b : ℝ → ℂ) :
    ∫ x, swKernel Ω x * b ‖x‖ = 0 := by
  have : (fun x => swKernel Ω x * b ‖x‖) = fun x => Ω x * b ‖x‖ / ((‖x‖ ^ n : ℝ) : ℂ) := by
    funext x
    by_cases hx : x = 0
    · subst hx
      obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
      simp [swKernel]
    · simp only [swKernel, hx, ite_false]
      ring
  rw [this, integral_homog_mul_radial hn hΩ.2.1, hΩ.2.2, mul_zero]

/-- Helper: the radial profile `r ↦ ψ(2^{-j} r e)` of `ψ(2^{-j} ·)`. -/
noncomputable def dyadicRadial (j : ℤ) (r : ℝ) : ℝ :=
  dyadicProfile ((2 : ℝ) ^ (-j) * r) - dyadicProfile (2 * ((2 : ℝ) ^ (-j) * r))

/-- Helper: `K_j(x) = K(x) b_j(|x|)`. -/
lemma dyadicKernel_eq_radial (j : ℤ) (x : EuclideanSpace ℝ (Fin n)) :
    dyadicKernel Ω j x = swKernel Ω x * (dyadicRadial j ‖x‖ : ℂ) := by
  rw [dyadicKernel, dyadicPsi_eq_profile, norm_smul, Real.norm_eq_abs,
    abs_of_pos (by positivity), dyadicRadial]

/-- Blueprint Lemma 4.1 (`lem:dyadic`), (4.1): `∫_E K_j = 0` for every `j ∈ ℤ` (`n ≥ 1`). -/
theorem integral_dyadicKernel (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) (j : ℤ) :
    ∫ x, dyadicKernel Ω j x = 0 := by
  simp_rw [dyadicKernel_eq_radial j]
  exact integral_swKernel_mul_radial_eq_zero hn hΩ (fun r => (dyadicRadial j r : ℂ))

/-- Blueprint Lemma 4.1 (`lem:dyadic`), (4.3), first identity: for every real `μ` and `j ∈ ℤ`,
`∫_E e(μ P(x)) K_j(x) dx = 0`, where `P = radialPoly n d`. -/
theorem integral_eC_mul_dyadicKernel (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) (d : ℕ) (μ : ℝ)
    (j : ℤ) : ∫ x, eC (μ * radialPoly n d x) * dyadicKernel Ω j x = 0 := by
  have : (fun x => eC (μ * radialPoly n d x) * dyadicKernel Ω j x) = fun x =>
      swKernel Ω x * (fun r : ℝ => (dyadicRadial j r : ℂ) * eC (μ * r ^ (2 * d))) ‖x‖ := by
    funext x
    rw [dyadicKernel_eq_radial, radialPoly_eq_norm_pow]
    ring
  rw [this]
  exact integral_swKernel_mul_radial_eq_zero hn hΩ
    (fun r : ℝ => (dyadicRadial j r : ℂ) * eC (μ * r ^ (2 * d)))

/-- Blueprint Lemma 4.1 (`lem:dyadic`), (4.3), second identity: for every real `μ` and `j ∈ ℤ`,
`∫_E P(x) e(μ P(x)) K_j(x) dx = 0`, where `P = radialPoly n d`. -/
theorem integral_radialPoly_mul_eC_mul_dyadicKernel (hn : 1 ≤ n) (hΩ : IsSWProfile Ω)
    (d : ℕ) (μ : ℝ) (j : ℤ) :
    ∫ x, (radialPoly n d x : ℂ) * eC (μ * radialPoly n d x) * dyadicKernel Ω j x = 0 := by
  have : (fun x => (radialPoly n d x : ℂ) * eC (μ * radialPoly n d x) * dyadicKernel Ω j x) =
      fun x => swKernel Ω x *
        (fun r : ℝ => ((r ^ (2 * d) : ℝ) : ℂ) * (dyadicRadial j r : ℂ) * eC (μ * r ^ (2 * d)))
          ‖x‖ := by
    funext x
    rw [dyadicKernel_eq_radial, radialPoly_eq_norm_pow]
    ring
  rw [this]
  exact integral_swKernel_mul_radial_eq_zero hn hΩ
    (fun r : ℝ => ((r ^ (2 * d) : ℝ) : ℂ) * (dyadicRadial j r : ℂ) * eC (μ * r ^ (2 * d)))

/-! ### The dyadic resolution (4.2) -/

/-- Blueprint Lemma 4.1 (`lem:dyadic`), finite form of (4.2):
`∑_{j=1}^{J} K_j(x) = (η(2^{-J} x) - η(x)) K(x)`. -/
theorem sum_range_dyadicKernel (x : EuclideanSpace ℝ (Fin n)) (J : ℕ) :
    ∑ j ∈ Finset.range J, dyadicKernel Ω ((j : ℤ) + 1) x =
      ((dyadicEta ((2 : ℝ) ^ (-(J : ℤ)) • x) - dyadicEta x : ℝ) : ℂ) * swKernel Ω x := by
  simp only [dyadicKernel]
  rw [← Finset.mul_sum, ← Complex.ofReal_sum, sum_dyadicPsi, mul_comm]

/-- Helper: `2^{-j} = (2^j)⁻¹`. -/
lemma two_zpow_neg_natCast (j : ℕ) : (2 : ℝ) ^ (-(j : ℤ)) = ((2 : ℝ) ^ j)⁻¹ := by
  rw [zpow_neg, zpow_natCast]

/-- Blueprint Lemma 4.1 (`lem:dyadic`), (4.2): for every `x`, `∑_{j ≥ 1} K_j(x) = (1 - η(x)) K(x)`
(the series is indexed by `j + 1`, `j ∈ ℕ`, and has finitely many nonzero terms). -/
theorem hasSum_dyadicKernel (x : EuclideanSpace ℝ (Fin n)) :
    HasSum (fun j : ℕ => dyadicKernel Ω ((j : ℤ) + 1) x)
      ((1 - dyadicEta x : ℝ) * swKernel Ω x) := by
  obtain ⟨N, hN⟩ := pow_unbounded_of_one_lt ‖x‖ (by norm_num : (1 : ℝ) < 2)
  have hz : ∀ j ∉ Finset.range N, dyadicKernel Ω ((j : ℤ) + 1) x = 0 := by
    intro j hj
    rw [Finset.mem_range, not_lt] at hj
    have hj' : ‖x‖ < 2 ^ j := hN.trans_le (pow_le_pow_right₀ (by norm_num) hj)
    rw [dyadicKernel, dyadicPsi_eq_zero_of_le, Complex.ofReal_zero, mul_zero]
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (by positivity),
      show -((j : ℤ) + 1) = -((j + 1 : ℕ) : ℤ) by push_cast; ring, two_zpow_neg_natCast,
      pow_succ, inv_mul_le_iff₀ (by positivity)]
    nlinarith
  have h1 : dyadicEta ((2 : ℝ) ^ (-(N : ℤ)) • x) = 1 := by
    apply dyadicEta_eq_one
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (by positivity), two_zpow_neg_natCast,
      inv_mul_le_iff₀ (by positivity)]
    linarith
  have : HasSum (fun j : ℕ => dyadicKernel Ω ((j : ℤ) + 1) x) _ := hasSum_sum_of_ne_finset_zero hz
  rwa [sum_range_dyadicKernel, h1] at this

/-! ### Lattice sums -/

/-- Helper: the sup bound `|K_j(x)| ≤ C 2^{-jn}` with `C ≥ 0`. -/
theorem norm_dyadicKernel_le (hΩ : IsSWProfile Ω) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (j : ℤ) (x : EuclideanSpace ℝ (Fin n)),
      ‖dyadicKernel Ω j x‖ ≤ C * (2 : ℝ) ^ (-j * n) := by
  obtain ⟨C, hC⟩ := norm_iteratedFDeriv_dyadicKernel_le hΩ 0
  have hC0 : 0 ≤ C := by
    have h := (norm_nonneg _).trans (hC 0 0)
    exact nonneg_of_mul_nonneg_left h (by positivity)
  refine ⟨C, hC0, fun j x => ?_⟩
  have := hC j x
  rwa [norm_iteratedFDeriv_zero, Nat.cast_zero, add_zero] at this

/-- Blueprint Lemma 4.1 (`lem:dyadic`), lattice bound: there is `C` with
`∑_{y ∈ ℤⁿ} |K_j(y)| ≤ C` for all `j ≥ 1` (the sum is summable, having finitely many nonzero
terms). -/
theorem summable_tsum_norm_dyadicKernel_latEmbed_le (hΩ : IsSWProfile Ω) :
    ∃ C : ℝ, ∀ j : ℤ, 1 ≤ j →
      Summable (fun y : Fin n → ℤ => ‖dyadicKernel Ω j (latEmbed y)‖) ∧
        ∑' y : Fin n → ℤ, ‖dyadicKernel Ω j (latEmbed y)‖ ≤ C := by
  obtain ⟨C0, hC0, hK⟩ := norm_dyadicKernel_le hΩ
  refine ⟨C0 * 8 ^ n, fun j hj => ?_⟩
  lift j to ℕ using (by omega)
  set R : ℕ := 2 ^ (j + 1) with hR
  let S : Finset (Fin n → ℤ) := Finset.Icc (fun _ => -(R : ℤ)) (fun _ => (R : ℤ))
  have hzero : ∀ y ∉ S, ‖dyadicKernel Ω j (latEmbed y)‖ = 0 := by
    intro y hy
    rw [norm_eq_zero]
    apply dyadicKernel_eq_zero_of_le
    have : ∃ i, (R : ℤ) < |y i| := by
      by_contra h
      push Not at h
      apply hy
      rw [Finset.mem_Icc]
      exact ⟨fun i => (abs_le.1 (h i)).1, fun i => (abs_le.1 (h i)).2⟩
    obtain ⟨i, hi⟩ := this
    calc (2 : ℝ) ^ ((j : ℤ) + 1) = (R : ℝ) := by
          rw [hR]; push_cast; rw [← zpow_natCast]; push_cast; rfl
      _ ≤ |(y i : ℝ)| := by exact_mod_cast hi.le
      _ = ‖latEmbed y i‖ := by simp
      _ ≤ ‖latEmbed y‖ := PiLp.norm_apply_le _ _
  refine ⟨summable_of_ne_finset_zero hzero, ?_⟩
  rw [tsum_eq_sum hzero]
  have hcard : (S.card : ℝ) = (2 * R + 1 : ℝ) ^ n := by
    simp only [S, Pi.card_Icc, Int.card_Icc, Finset.prod_const, Finset.card_univ,
      Fintype.card_fin]
    have : ((R : ℤ) + 1 - -(R : ℤ)).toNat = 2 * R + 1 := by omega
    rw [this]; push_cast; ring
  have hterm : ∀ y ∈ S, ‖dyadicKernel Ω j (latEmbed y)‖ ≤ C0 * (((2 : ℝ) ^ j) ^ n)⁻¹ := by
    intro y _
    have := hK j (latEmbed y)
    rwa [show -((j : ℤ)) * (n : ℤ) = -((j * n : ℕ) : ℤ) by push_cast; ring,
      two_zpow_neg_natCast, pow_mul] at this
  calc ∑ y ∈ S, ‖dyadicKernel Ω j (latEmbed y)‖ ≤ ∑ _y ∈ S, C0 * (((2 : ℝ) ^ j) ^ n)⁻¹ :=
        Finset.sum_le_sum hterm
    _ = (2 * R + 1 : ℝ) ^ n * (C0 * (((2 : ℝ) ^ j) ^ n)⁻¹) := by
        rw [Finset.sum_const, nsmul_eq_mul, hcard]
    _ ≤ (8 * 2 ^ j : ℝ) ^ n * (C0 * (((2 : ℝ) ^ j) ^ n)⁻¹) := by
        gcongr
        have h1 : (1 : ℝ) ≤ 2 ^ j := one_le_pow₀ (by norm_num)
        rw [hR]; push_cast; rw [pow_succ]; linarith
    _ = C0 * 8 ^ n := by
        rw [mul_pow]; field_simp

/-! ### Lemma 4.3 (`lem:signedK`): uniform signed dyadic multipliers and their limit -/

open scoped FourierTransform RealInnerProductSpace Convolution


/-- Helper: the two-sided geometric weights `2^{-|m|}`, `m ∈ ℤ`, are summable. -/
lemma summable_two_zpow_neg_abs : Summable (fun m : ℤ => (2 : ℝ) ^ (-|m|)) := by
  have h : Summable (fun m : ℕ => ((1 : ℝ) / 2) ^ m) := summable_geometric_two
  apply Summable.of_nat_of_neg
  · refine h.congr fun m => ?_
    rw [Nat.abs_cast, zpow_neg, zpow_natCast, one_div, inv_pow]
  · refine h.congr fun m => ?_
    rw [abs_neg, Nat.abs_cast, zpow_neg, zpow_natCast, one_div, inv_pow]

/-- The constant `∑_{m ∈ ℤ} 2^{-|m|}` bounding the shifted two-sided geometric sums. -/
noncomputable def geomZ : ℝ := ∑' m : ℤ, (2 : ℝ) ^ (-|m|)

/-- Helper: `∑_{j ∈ J} 2^{-|j - k|} ≤ ∑_{m ∈ ℤ} 2^{-|m|}` for every finite `J ⊆ ℤ`. -/
lemma sum_two_zpow_neg_abs_sub_le (J : Finset ℤ) (k : ℤ) :
    ∑ j ∈ J, (2 : ℝ) ^ (-|j - k|) ≤ geomZ := by
  have hs : Summable (fun j : ℤ => (2 : ℝ) ^ (-|j - k|)) :=
    ((Equiv.subRight k).summable_iff (f := fun m : ℤ => (2 : ℝ) ^ (-|m|))).2
      summable_two_zpow_neg_abs
  calc ∑ j ∈ J, (2 : ℝ) ^ (-|j - k|) ≤ ∑' j : ℤ, (2 : ℝ) ^ (-|j - k|) :=
        hs.sum_le_tsum J (fun _ _ => by positivity)
    _ = geomZ := (Equiv.subRight k).tsum_eq (fun m : ℤ => (2 : ℝ) ^ (-|m|))

/-- Helper: `0 ≤ geomZ`. -/
lemma geomZ_nonneg : 0 ≤ geomZ := tsum_nonneg fun _ => by positivity

/-- Helper: if `2^k ≤ t < 2^{k+1}` then `min(2^j t, (2^j t)⁻¹) ≤ 2 ⋅ 2^{-|j + k|}`. -/
lemma min_le_two_zpow {t : ℝ} {k : ℤ} (hk : t ∈ Ico ((2 : ℝ) ^ k) (2 ^ (k + 1))) (j : ℤ) :
    min (2 ^ j * t) (2 ^ j * t)⁻¹ ≤ 2 * (2 : ℝ) ^ (-|j - -k|) := by
  have h2 : (0 : ℝ) < 2 ^ j := by positivity
  have hlo : (2 : ℝ) ^ (j + k) ≤ 2 ^ j * t := by
    rw [zpow_add₀ two_ne_zero]; exact mul_le_mul_of_nonneg_left hk.1 h2.le
  have hhi : 2 ^ j * t < (2 : ℝ) ^ (j + k + 1) := by
    rw [add_assoc, zpow_add₀ two_ne_zero]; exact mul_lt_mul_of_pos_left hk.2 h2
  rw [sub_neg_eq_add]
  rcases le_or_gt 0 (j + k) with hm | hm
  · rw [abs_of_nonneg hm]
    refine (min_le_right _ _).trans ?_
    have : ((2 : ℝ) ^ j * t)⁻¹ ≤ 2 ^ (-(j + k)) := by
      rw [zpow_neg]; exact inv_anti₀ (by positivity) hlo
    have h3 : (0 : ℝ) ≤ 2 ^ (-(j + k)) := by positivity
    linarith
  · rw [abs_of_neg hm, neg_neg]
    refine (min_le_left _ _).trans (hhi.le.trans ?_)
    rw [zpow_add_one₀ two_ne_zero, mul_comm]

/-- Blueprint Lemma 4.3 (`lem:signedK`), the geometric-series step: there is `C₀` with
`∑_{j ∈ J} min(2^j t, (2^j t)⁻¹) ≤ C₀` for every `t > 0` and every finite `J ⊆ ℤ`. -/
theorem sum_min_two_zpow_le :
    ∃ C₀ : ℝ, ∀ t : ℝ, 0 < t → ∀ J : Finset ℤ,
      ∑ j ∈ J, min (2 ^ j * t) (2 ^ j * t)⁻¹ ≤ C₀ := by
  refine ⟨2 * geomZ, fun t ht J => ?_⟩
  obtain ⟨k, hk⟩ := exists_mem_Ico_zpow ht (by norm_num : (1 : ℝ) < 2)
  calc ∑ j ∈ J, min (2 ^ j * t) (2 ^ j * t)⁻¹ ≤ ∑ j ∈ J, 2 * (2 : ℝ) ^ (-|j - -k|) :=
        Finset.sum_le_sum fun j _ => min_le_two_zpow hk j
    _ = 2 * ∑ j ∈ J, (2 : ℝ) ^ (-|j - -k|) := by rw [Finset.mul_sum]
    _ ≤ 2 * geomZ := by gcongr; exact sum_two_zpow_neg_abs_sub_le J (-k)



/-- Helper: `𝓕 K_j (0) = ∫ K_j = 0`. -/
lemma fourier_dyadicKernel_apply_zero (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) (j : ℤ) :
    𝓕 (dyadicKernel Ω j) 0 = 0 := by
  rw [Real.fourier_eq]
  simpa using integral_dyadicKernel hn hΩ j

/-- Helper: `|𝓕 K_0 (ζ)| ≤ C min(|ζ|, |ζ|⁻¹)` (`K_0` is a Schwartz function with mean zero). -/
lemma norm_fourier_dyadicKernel_zero_le (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ ζ : EuclideanSpace ℝ (Fin n),
      ‖𝓕 (dyadicKernel Ω 0) ζ‖ ≤ C * min ‖ζ‖ ‖ζ‖⁻¹ := by
  set S := hasCompactSupport_dyadicKernel_zero.toSchwartzMap (contDiff_dyadicKernel_zero hΩ.1)
    with hS
  have hSe : ((𝓕 S : SchwartzMap _ ℂ) : EuclideanSpace ℝ (Fin n) → ℂ) =
      𝓕 (dyadicKernel Ω 0) := rfl
  set L := SchwartzMap.seminorm ℝ 0 1 (𝓕 S)
  set D := SchwartzMap.seminorm ℝ 1 0 (𝓕 S)
  have hL0 : 0 ≤ L := apply_nonneg _ _
  have hL : ∀ ζ, ‖𝓕 (dyadicKernel Ω 0) ζ‖ ≤ L * ‖ζ‖ := by
    intro ζ
    have h := Convex.norm_image_sub_le_of_norm_fderiv_le (s := univ) (C := L)
      (f := ((𝓕 S : SchwartzMap _ ℂ) : EuclideanSpace ℝ (Fin n) → ℂ))
      (fun x _ => (𝓕 S).differentiableAt) (fun x _ => ?_) convex_univ (mem_univ 0) (mem_univ ζ)
    · rwa [hSe, fourier_dyadicKernel_apply_zero hn hΩ 0, sub_zero, sub_zero] at h
    · rw [← norm_iteratedFDeriv_one]; exact SchwartzMap.norm_iteratedFDeriv_le_seminorm ℝ _ 1 x
  have hD : ∀ ζ, ‖ζ‖ * ‖𝓕 (dyadicKernel Ω 0) ζ‖ ≤ D := fun ζ => by
    have := SchwartzMap.norm_pow_mul_le_seminorm ℝ (𝓕 S) 1 ζ
    rwa [pow_one, hSe] at this
  refine ⟨max L D, le_max_of_le_left hL0, fun ζ => ?_⟩
  rcases eq_or_ne ζ 0 with rfl | hζ
  · simp [fourier_dyadicKernel_apply_zero hn hΩ 0]
  have hζ' : 0 < ‖ζ‖ := norm_pos_iff.2 hζ
  rcases le_total ‖ζ‖ ‖ζ‖⁻¹ with h | h
  · rw [min_eq_left h]
    exact (hL ζ).trans (mul_le_mul_of_nonneg_right (le_max_left _ _) hζ'.le)
  · rw [min_eq_right h]
    have : ‖𝓕 (dyadicKernel Ω 0) ζ‖ ≤ D * ‖ζ‖⁻¹ := by
      rw [le_mul_inv_iff₀ hζ', mul_comm]; exact hD ζ
    exact this.trans (mul_le_mul_of_nonneg_right (le_max_right _ _) (by positivity))

/-- Helper: the scaling identity `𝓕 K_j (ξ) = 𝓕 K_0 (2^j ξ)`. -/
lemma fourier_dyadicKernel_eq (hΩ : IsSWProfile Ω) (j : ℤ) (ξ : EuclideanSpace ℝ (Fin n)) :
    𝓕 (dyadicKernel Ω j) ξ = 𝓕 (dyadicKernel Ω 0) ((2 : ℝ) ^ j • ξ) := by
  set c : ℝ := (2 : ℝ) ^ (-j) with hc_def
  have hc : 0 < c := by positivity
  let g : EuclideanSpace ℝ (Fin n) → ℂ := fun y => 𝐞 (-⟪c⁻¹ • y, ξ⟫) • dyadicKernel Ω 0 y
  have h1 : ∀ x, 𝐞 (-⟪x, ξ⟫) • dyadicKernel Ω j x = c ^ n • g (c • x) := by
    intro x
    simp only [g, dyadicKernel_eq_smul hΩ.2.1 j x, inv_smul_smul₀ hc.ne', ← hc_def]
    simp only [Circle.smul_def, Complex.real_smul]
    ring
  rw [Real.fourier_eq, Real.fourier_eq]
  simp_rw [h1]
  rw [integral_smul, Measure.integral_comp_smul, finrank_euclideanSpace_fin, smul_smul,
    abs_of_pos (by positivity), mul_inv_cancel₀ (by positivity), one_smul]
  refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
  simp only [g, real_inner_smul_left, real_inner_smul_right, hc_def, zpow_neg, inv_inv]

/-- Blueprint Lemma 4.3 (`lem:signedK`), (4.4): there is `C` with
`|𝓕 K_j (ξ)| ≤ C min(2^j |ξ|, (2^j |ξ|)⁻¹)` for all `j ∈ ℤ` and `ξ ∈ E` (at `ξ = 0` the
right side is `0`, and indeed `𝓕 K_j (0) = ∫ K_j = 0`). Here `𝓕` is Mathlib's Fourier
transform `𝓕 f (ξ) = ∫ e(-x·ξ) f(x) dx`. -/
theorem norm_fourier_dyadicKernel_le (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (j : ℤ) (ξ : EuclideanSpace ℝ (Fin n)),
      ‖𝓕 (dyadicKernel Ω j) ξ‖ ≤ C * min (2 ^ j * ‖ξ‖) (2 ^ j * ‖ξ‖)⁻¹ := by
  obtain ⟨C, hC0, hC⟩ := norm_fourier_dyadicKernel_zero_le hn hΩ
  refine ⟨C, hC0, fun j ξ => ?_⟩
  rw [fourier_dyadicKernel_eq hΩ j ξ]
  have := hC ((2 : ℝ) ^ j • ξ)
  rwa [norm_smul, Real.norm_eq_abs, abs_of_pos (by positivity)] at this

/-- Helper: the closed support of `K_j` lies in `2^{j-1} ≤ |x| ≤ 2^{j+1}`. -/
lemma tsupport_dyadicKernel (j : ℤ) :
    tsupport (dyadicKernel Ω j) ⊆
      {x | (2 : ℝ) ^ (j - 1) ≤ ‖x‖ ∧ ‖x‖ ≤ (2 : ℝ) ^ (j + 1)} := by
  refine closure_minimal ((support_dyadicKernel j).trans fun x hx => ⟨hx.1.le, hx.2.le⟩) ?_
  exact (isClosed_le continuous_const continuous_norm).inter
    (isClosed_le continuous_norm continuous_const)

/-- Helper: the pointwise derivative bound with the dyadic weight: if `2^{k₀} ≤ |x| < 2^{k₀+1}`
then `‖D^k K_j(x)‖ ≤ 2 C_k 2^{n+k} 2^{-|j - k₀|} |x|^{-n-k}`. -/
lemma norm_iteratedFDeriv_dyadicKernel_le_weight {k : ℕ} {C : ℝ} (hC0 : 0 ≤ C)
    (hC : ∀ (j : ℤ) (x : EuclideanSpace ℝ (Fin n)),
      ‖iteratedFDeriv ℝ k (dyadicKernel Ω j) x‖ ≤ C * (2 : ℝ) ^ (-j * ((n : ℤ) + k)))
    {x : EuclideanSpace ℝ (Fin n)} {k₀ : ℤ}
    (hk₀ : ‖x‖ ∈ Ico ((2 : ℝ) ^ k₀) (2 ^ (k₀ + 1))) (j : ℤ) :
    ‖iteratedFDeriv ℝ k (dyadicKernel Ω j) x‖ ≤
      2 * C * 2 ^ (n + k) * (2 : ℝ) ^ (-|j - k₀|) / ‖x‖ ^ (n + k) := by
  have hx : 0 < ‖x‖ := lt_of_lt_of_le (by positivity) hk₀.1
  by_cases hs : x ∈ Function.support (iteratedFDeriv ℝ k (dyadicKernel Ω j))
  · obtain ⟨h1, h2⟩ := tsupport_dyadicKernel j (support_iteratedFDeriv_subset k hs)
    have hjk1 : j - 1 < k₀ + 1 :=
      (zpow_lt_zpow_iff_right₀ (by norm_num : (1 : ℝ) < 2)).1 (h1.trans_lt hk₀.2)
    have hjk2 : k₀ ≤ j + 1 :=
      (zpow_le_zpow_iff_right₀ (by norm_num : (1 : ℝ) < 2)).1 (hk₀.1.trans h2)
    have habs : |j - k₀| ≤ 1 := abs_le.2 ⟨by omega, by omega⟩
    have hw : (1 / 2 : ℝ) ≤ 2 ^ (-|j - k₀|) := by
      calc (1 / 2 : ℝ) = 2 ^ (-1 : ℤ) := by norm_num
        _ ≤ 2 ^ (-|j - k₀|) := zpow_le_zpow_right₀ (by norm_num) (by omega)
    have hj : (2 : ℝ) ^ (-j) ≤ 2 / ‖x‖ := by
      rw [le_div_iff₀ hx, zpow_neg, inv_mul_le_iff₀ (by positivity)]
      rw [zpow_add_one₀ two_ne_zero] at h2; linarith
    have hpow : (2 : ℝ) ^ (-j * ((n : ℤ) + k)) ≤ (2 / ‖x‖) ^ (n + k) := by
      rw [zpow_mul, show ((n : ℤ) + k) = ((n + k : ℕ) : ℤ) by push_cast; ring, zpow_natCast]
      exact pow_le_pow_left₀ (by positivity) hj _
    calc ‖iteratedFDeriv ℝ k (dyadicKernel Ω j) x‖ ≤ C * (2 / ‖x‖) ^ (n + k) :=
          (hC j x).trans (mul_le_mul_of_nonneg_left hpow hC0)
      _ = 2 * C * 2 ^ (n + k) * (1 / 2) / ‖x‖ ^ (n + k) := by rw [div_pow]; ring
      _ ≤ 2 * C * 2 ^ (n + k) * (2 : ℝ) ^ (-|j - k₀|) / ‖x‖ ^ (n + k) := by gcongr
  · rw [Function.notMem_support.1 hs, norm_zero]
    positivity

/-- Helper: for every order `k` there is `B_k` with
`∑_{j ∈ J} ‖D^k K_j(x)‖ ≤ B_k |x|^{-n-k}` for every finite `J ⊆ ℤ` and `x ≠ 0` (bounded overlap
of the annular supports). -/
lemma sum_norm_iteratedFDeriv_dyadicKernel_le (hΩ : IsSWProfile Ω) (k : ℕ) :
    ∃ B : ℝ, 0 ≤ B ∧ ∀ (J : Finset ℤ) (x : EuclideanSpace ℝ (Fin n)), x ≠ 0 →
      ∑ j ∈ J, ‖iteratedFDeriv ℝ k (dyadicKernel Ω j) x‖ ≤ B / ‖x‖ ^ (n + k) := by
  obtain ⟨C, hC⟩ := norm_iteratedFDeriv_dyadicKernel_le hΩ k
  have hC0 : 0 ≤ C := by
    have h := (norm_nonneg _).trans (hC 0 0)
    exact nonneg_of_mul_nonneg_left h (by positivity)
  refine ⟨2 * C * 2 ^ (n + k) * geomZ, by have := geomZ_nonneg; positivity,
    fun J x hx => ?_⟩
  obtain ⟨k₀, hk₀⟩ := exists_mem_Ico_zpow (norm_pos_iff.2 hx) (by norm_num : (1 : ℝ) < 2)
  calc ∑ j ∈ J, ‖iteratedFDeriv ℝ k (dyadicKernel Ω j) x‖
      ≤ ∑ j ∈ J, 2 * C * 2 ^ (n + k) * (2 : ℝ) ^ (-|j - k₀|) / ‖x‖ ^ (n + k) :=
        Finset.sum_le_sum fun j _ => norm_iteratedFDeriv_dyadicKernel_le_weight hC0 hC hk₀ j
    _ = 2 * C * 2 ^ (n + k) * (∑ j ∈ J, (2 : ℝ) ^ (-|j - k₀|)) / ‖x‖ ^ (n + k) := by
        rw [Finset.mul_sum, Finset.sum_div]
    _ ≤ 2 * C * 2 ^ (n + k) * geomZ / ‖x‖ ^ (n + k) := by
        gcongr; exact sum_two_zpow_neg_abs_sub_le J k₀

/-- Helper: the Fourier transform of a finite signed dyadic sum,
`𝓕(∑_{j ∈ J} c_j K_j) = ∑_{j ∈ J} c_j 𝓕 K_j`. -/
lemma fourier_sum_smul_dyadicKernel (hΩ : IsSWProfile Ω) (J : Finset ℤ) (c : ℤ → ℂ)
    (ξ : EuclideanSpace ℝ (Fin n)) :
    𝓕 (∑ j ∈ J, c j • dyadicKernel Ω j) ξ = ∑ j ∈ J, c j * 𝓕 (dyadicKernel Ω j) ξ := by
  have hi : ∀ j, Integrable (fun v : EuclideanSpace ℝ (Fin n) =>
      𝐞 (-⟪v, ξ⟫) • dyadicKernel Ω j v) :=
    fun j => (Real.fourierIntegral_convergent_iff ξ).2 (integrable_dyadicKernel hΩ j)
  simp only [Real.fourier_eq, Finset.sum_apply, Pi.smul_apply, Finset.smul_sum]
  rw [integral_finsetSum _ (fun j _ => ?_)]
  · refine Finset.sum_congr rfl fun j _ => ?_
    rw [← integral_const_mul]
    refine integral_congr_ae (Filter.Eventually.of_forall fun v => ?_)
    simp only [Circle.smul_def, smul_eq_mul]
    ring
  · refine ((hi j).const_mul (c j)).congr (Filter.Eventually.of_forall fun v => ?_)
    simp only [Circle.smul_def, smul_eq_mul]
    ring

/-- Helper: `∑_{j ∈ J} |𝓕 K_j(ξ)| ≤ A` uniformly in `ξ` and finite `J ⊆ ℤ`. -/
lemma sum_norm_fourier_dyadicKernel_le (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) :
    ∃ A : ℝ, 0 ≤ A ∧ ∀ (J : Finset ℤ) (ξ : EuclideanSpace ℝ (Fin n)),
      ∑ j ∈ J, ‖𝓕 (dyadicKernel Ω j) ξ‖ ≤ A := by
  obtain ⟨C, hC0, hC⟩ := norm_fourier_dyadicKernel_le hn hΩ
  obtain ⟨C₀, hC₀⟩ := sum_min_two_zpow_le
  refine ⟨C * max C₀ 0, mul_nonneg hC0 (le_max_right _ _), fun J ξ => ?_⟩
  rcases eq_or_ne ξ 0 with rfl | hξ
  · simp only [fourier_dyadicKernel_apply_zero hn hΩ, norm_zero, Finset.sum_const_zero]
    exact mul_nonneg hC0 (le_max_right _ _)
  calc ∑ j ∈ J, ‖𝓕 (dyadicKernel Ω j) ξ‖
      ≤ ∑ j ∈ J, C * min (2 ^ j * ‖ξ‖) (2 ^ j * ‖ξ‖)⁻¹ := Finset.sum_le_sum fun j _ => hC j ξ
    _ = C * ∑ j ∈ J, min (2 ^ j * ‖ξ‖) (2 ^ j * ‖ξ‖)⁻¹ := by rw [Finset.mul_sum]
    _ ≤ C * max C₀ 0 := by
        gcongr; exact (hC₀ ‖ξ‖ (norm_pos_iff.2 hξ) J).trans (le_max_left _ _)

/-- Blueprint Lemma 4.3 (`lem:signedK`), multiplier bound for the finite sums: there is `A`
such that for every finite `J ⊆ ℤ` and all coefficients `|c_j| ≤ 1`,
`|𝓕(∑_{j ∈ J} c_j K_j)(ξ)| ≤ A` for every `ξ`. -/
theorem norm_fourier_sum_smul_dyadicKernel_le (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) :
    ∃ A : ℝ, 0 ≤ A ∧ ∀ (J : Finset ℤ) (c : ℤ → ℂ), (∀ j, ‖c j‖ ≤ 1) →
      ∀ ξ : EuclideanSpace ℝ (Fin n), ‖𝓕 (∑ j ∈ J, c j • dyadicKernel Ω j) ξ‖ ≤ A := by
  obtain ⟨A, hA0, hA⟩ := sum_norm_fourier_dyadicKernel_le hn hΩ
  refine ⟨A, hA0, fun J c hc ξ => ?_⟩
  rw [fourier_sum_smul_dyadicKernel hΩ]
  refine (norm_sum_le _ _).trans ((Finset.sum_le_sum fun j _ => ?_).trans (hA J ξ))
  rw [norm_mul]
  exact mul_le_of_le_one_left (norm_nonneg _) (hc j)

/-- Blueprint Lemma 4.3 (`lem:signedK`), size bound for the finite sums: there is `B` such
that for every finite `J ⊆ ℤ` and all `|c_j| ≤ 1`, `|∑_{j ∈ J} c_j K_j(x)| ≤ B |x|^{-n}` for
`x ≠ 0`. -/
theorem norm_sum_smul_dyadicKernel_le (hΩ : IsSWProfile Ω) :
    ∃ B : ℝ, 0 ≤ B ∧ ∀ (J : Finset ℤ) (c : ℤ → ℂ), (∀ j, ‖c j‖ ≤ 1) →
      ∀ x : EuclideanSpace ℝ (Fin n), x ≠ 0 →
        ‖(∑ j ∈ J, c j • dyadicKernel Ω j) x‖ ≤ B / ‖x‖ ^ n := by
  obtain ⟨B, hB0, hB⟩ := sum_norm_iteratedFDeriv_dyadicKernel_le hΩ 0
  refine ⟨B, hB0, fun J c hc x hx => ?_⟩
  have h := hB J x hx
  simp only [norm_iteratedFDeriv_zero, add_zero] at h
  rw [Finset.sum_apply]
  refine (norm_sum_le _ _).trans ((Finset.sum_le_sum fun j _ => ?_).trans h)
  rw [Pi.smul_apply, norm_smul]
  exact mul_le_of_le_one_left (norm_nonneg _) (hc j)

/-- Blueprint Lemma 4.3 (`lem:signedK`), gradient bound for the finite sums: there is `B` such
that for every finite `J ⊆ ℤ` and all `|c_j| ≤ 1`, `∑_{j ∈ J} c_j K_j` is differentiable and
`|∇(∑_{j ∈ J} c_j K_j)(x)| ≤ B |x|^{-n-1}` for `x ≠ 0`. -/
theorem norm_fderiv_sum_smul_dyadicKernel_le (hΩ : IsSWProfile Ω) :
    ∃ B : ℝ, 0 ≤ B ∧ ∀ (J : Finset ℤ) (c : ℤ → ℂ), (∀ j, ‖c j‖ ≤ 1) →
      ∀ x : EuclideanSpace ℝ (Fin n), x ≠ 0 →
        DifferentiableAt ℝ (∑ j ∈ J, c j • dyadicKernel Ω j) x ∧
        ‖fderiv ℝ (∑ j ∈ J, c j • dyadicKernel Ω j) x‖ ≤ B / ‖x‖ ^ (n + 1) := by
  obtain ⟨B, hB0, hB⟩ := sum_norm_iteratedFDeriv_dyadicKernel_le hΩ 1
  refine ⟨B, hB0, fun J c hc x hx => ?_⟩
  have hd : ∀ j, HasFDerivAt (c j • dyadicKernel Ω j)
      (c j • fderiv ℝ (dyadicKernel Ω j) x) x := fun j =>
    (((contDiff_dyadicKernel hΩ j).differentiable (by simp)) x).hasFDerivAt.const_smul (c j)
  have hs := HasFDerivAt.sum (u := J) fun j _ => hd j
  refine ⟨hs.differentiableAt, ?_⟩
  rw [hs.fderiv]
  refine (norm_sum_le _ _).trans ((Finset.sum_le_sum fun j _ => ?_).trans (hB J x hx))
  rw [norm_smul, norm_iteratedFDeriv_one]
  exact mul_le_of_le_one_left (norm_nonneg _) (hc j)


/-! ### Lemma 4.3: uniform `L^p` bounds for the signed dyadic sums -/

/-- Blueprint Lemma 4.3 (`lem:signedK`), first assertion: for `1 < p < ∞` there is `C_p` such
that for every finite `J ⊆ ℤ` and all coefficients `|c_j| ≤ 1`, convolution with
`∑_{j ∈ J} c_j K_j` satisfies `‖(∑_{j ∈ J} c_j K_j) * f‖_p ≤ C_p ‖f‖_p` for all `f ∈ L^p(E)`. -/
theorem exists_eLpNorm_convolution_sum_smul_dyadicKernel_le (hn : 1 ≤ n) (hΩ : IsSWProfile Ω)
    {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (J : Finset ℤ) (c : ℤ → ℂ), (∀ j, ‖c j‖ ≤ 1) →
      ∀ f : EuclideanSpace ℝ (Fin n) → ℂ, MemLp f (ENNReal.ofReal p) volume →
        eLpNorm ((∑ j ∈ J, c j • dyadicKernel Ω j) ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] f)
            (ENNReal.ofReal p) volume ≤
          ENNReal.ofReal C * eLpNorm f (ENNReal.ofReal p) volume := by
  obtain ⟨Cp, hCp, h⟩ := exists_eLpNorm_convolution_le_of_norm_fourier_le (n := n) (by omega) hp
  obtain ⟨A, hA0, hA⟩ := norm_fourier_sum_smul_dyadicKernel_le hn hΩ
  obtain ⟨B, hB0, hB⟩ := norm_fderiv_sum_smul_dyadicKernel_le hΩ
  refine ⟨Cp * max A B, mul_nonneg hCp.le (le_max_of_le_left hA0), fun J c hc f hf => ?_⟩
  refine h _ (max A B) ?_ (fun x hx => (hB J c hc x hx).1) (fun x hx => ?_) (fun ξ => ?_) f hf
  · exact integrable_finsetSum' _ fun j _ => (integrable_dyadicKernel hΩ j).smul (c j)
  · exact (hB J c hc x hx).2.trans (div_le_div_of_nonneg_right (le_max_right _ _) (by positivity))
  · exact (hA J c hc ξ).trans (le_max_left _ _)

/-! ### Lemma 4.3: the limit symbol `m_K` -/

/-- Helper: the shift `j ↦ j + 1` as an embedding `ℕ ↪ ℤ`. -/
def succIntEmb : ℕ ↪ ℤ := ⟨fun j => (j : ℤ) + 1, fun a b h => by simpa using h⟩

/-- The limit symbol `m_K(ξ) = ∑_{j ≥ 1} 𝓕 K_j(ξ)` of Blueprint Lemma 4.3 (`lem:signedK`)
(the series is indexed by `j + 1`, `j ∈ ℕ`; it converges absolutely by (4.4)). -/
noncomputable def dyadicSymbol (Ω : EuclideanSpace ℝ (Fin n) → ℂ)
    (ξ : EuclideanSpace ℝ (Fin n)) : ℂ :=
  ∑' j : ℕ, 𝓕 (dyadicKernel Ω ((j : ℤ) + 1)) ξ

/-- Blueprint Lemma 4.3 (`lem:signedK`), the limit symbol: there is `A` such that for every `ξ`
the series `∑_{j ≥ 1} 𝓕 K_j(ξ)` converges absolutely with `∑_{j ≥ 1} |𝓕 K_j(ξ)| ≤ A`, its sum
is `m_K(ξ)`, `m_K(0) = 0`, and `|m_K(ξ)| ≤ A`. -/
theorem dyadicSymbol_spec (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) :
    ∃ A : ℝ, 0 ≤ A ∧ (∀ ξ : EuclideanSpace ℝ (Fin n),
      Summable (fun j : ℕ => ‖𝓕 (dyadicKernel Ω ((j : ℤ) + 1)) ξ‖) ∧
      ∑' j : ℕ, ‖𝓕 (dyadicKernel Ω ((j : ℤ) + 1)) ξ‖ ≤ A ∧
      HasSum (fun j : ℕ => 𝓕 (dyadicKernel Ω ((j : ℤ) + 1)) ξ) (dyadicSymbol Ω ξ) ∧
      ‖dyadicSymbol Ω ξ‖ ≤ A) ∧ dyadicSymbol Ω 0 = 0 := by
  obtain ⟨A, hA0, hA⟩ := sum_norm_fourier_dyadicKernel_le hn hΩ
  have hu : ∀ ξ (u : Finset ℕ), ∑ j ∈ u, ‖𝓕 (dyadicKernel Ω ((j : ℤ) + 1)) ξ‖ ≤ A :=
    fun ξ u => by
      have := hA (u.map succIntEmb) ξ
      rw [Finset.sum_map] at this
      exact this
  refine ⟨A, hA0, fun ξ => ?_, ?_⟩
  · have hs : Summable (fun j : ℕ => ‖𝓕 (dyadicKernel Ω ((j : ℤ) + 1)) ξ‖) :=
      summable_of_sum_le (fun _ => norm_nonneg _) (hu ξ)
    have ht : ∑' j : ℕ, ‖𝓕 (dyadicKernel Ω ((j : ℤ) + 1)) ξ‖ ≤ A :=
      Real.tsum_le_of_sum_le (fun _ => norm_nonneg _) (hu ξ)
    exact ⟨hs, ht, hs.of_norm.hasSum, (norm_tsum_le_tsum_norm hs).trans ht⟩
  · simp [dyadicSymbol, fourier_dyadicKernel_apply_zero hn hΩ]

/-- Helper: the partial kernels `∑_{j=1}^{N} K_j`, written as a signed dyadic sum with
coefficients `1`. -/
noncomputable def dyadicPartialKernel (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (N : ℕ) :
    EuclideanSpace ℝ (Fin n) → ℂ :=
  ∑ j ∈ (Finset.range N).map succIntEmb, (fun _ : ℤ => (1 : ℂ)) j • dyadicKernel Ω j

/-- Helper: `(∑_{j=1}^{N} K_j)(y) = ∑_{j < N} K_{j+1}(y)`. -/
lemma dyadicPartialKernel_apply (N : ℕ) (y : EuclideanSpace ℝ (Fin n)) :
    dyadicPartialKernel Ω N y = ∑ j ∈ Finset.range N, dyadicKernel Ω ((j : ℤ) + 1) y := by
  simp only [dyadicPartialKernel, Finset.sum_apply, Finset.sum_map, one_smul]
  rfl

/-- Helper: `𝓕(∑_{j=1}^{N} K_j) = ∑_{j < N} 𝓕 K_{j+1}`. -/
lemma fourier_dyadicPartialKernel (hΩ : IsSWProfile Ω) (N : ℕ) (ξ : EuclideanSpace ℝ (Fin n)) :
    𝓕 (dyadicPartialKernel Ω N) ξ =
      ∑ j ∈ Finset.range N, 𝓕 (dyadicKernel Ω ((j : ℤ) + 1)) ξ := by
  rw [dyadicPartialKernel, fourier_sum_smul_dyadicKernel hΩ, Finset.sum_map]
  simp only [one_mul]
  rfl

/-- Helper: the partial kernels are integrable. -/
lemma integrable_dyadicPartialKernel (hΩ : IsSWProfile Ω) (N : ℕ) :
    Integrable (dyadicPartialKernel Ω N) :=
  integrable_finsetSum' _ fun j _ => (integrable_dyadicKernel hΩ j).smul _

/-- Helper: the partial kernels are continuous. -/
lemma continuous_dyadicPartialKernel (hΩ : IsSWProfile Ω) (N : ℕ) :
    Continuous (dyadicPartialKernel Ω N) := by
  have : dyadicPartialKernel Ω N = fun y => ∑ j ∈ Finset.range N, dyadicKernel Ω ((j : ℤ) + 1) y :=
    funext (dyadicPartialKernel_apply N)
  rw [this]
  exact continuous_finsetSum _ fun j _ => (contDiff_dyadicKernel hΩ _).continuous

/-- Helper: for an integrable kernel `H` with bounded Fourier transform and a Schwartz function
`f`, `𝓕⁻(𝓕H ⋅ 𝓕f) = H * f` (everywhere). -/
lemma fourierInv_fourier_mul_eq_convolution {H : EuclideanSpace ℝ (Fin n) → ℂ}
    (hH : Integrable H) {A : ℝ} (hA : ∀ ξ, ‖𝓕 H ξ‖ ≤ A)
    (f : SchwartzMap (EuclideanSpace ℝ (Fin n)) ℂ) :
    𝓕⁻ (fun ξ => 𝓕 H ξ * 𝓕 (f : EuclideanSpace ℝ (Fin n) → ℂ) ξ) =
      H ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] (f : EuclideanSpace ℝ (Fin n) → ℂ) := by
  have h1 : (fun ξ => 𝓕 H ξ * 𝓕 (f : EuclideanSpace ℝ (Fin n) → ℂ) ξ) =
      𝓕 (H ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] (f : EuclideanSpace ℝ (Fin n) → ℂ)) :=
    funext fun ξ => (Real.fourier_mul_convolution_eq hH f.integrable ξ).symm
  have hcont : Continuous (𝓕 H) :=
    VectorFourier.fourierIntegral_continuous Real.continuous_fourierChar continuous_inner hH
  rw [h1]
  refine Continuous.fourierInv_fourier_eq ?_ ?_ ?_
  · exact BddAbove.continuous_convolution_right_of_integrable _
      ⟨SchwartzMap.seminorm ℝ 0 0 f, fun x ⟨y, hy⟩ => hy ▸ SchwartzMap.norm_le_seminorm ℝ f y⟩
      hH f.continuous
  · exact hH.integrable_convolution _ f.integrable
  · rw [← h1]
    exact (𝓕 f).integrable.bdd_mul hcont.aestronglyMeasurable (ae_of_all _ hA)

/-- Helper: for a Schwartz `f` and every `x`,
`(∑_{j=1}^{N} K_j) * f (x) → 𝓕⁻(m_K ⋅ 𝓕f)(x)` as `N → ∞`. -/
lemma tendsto_convolution_dyadicPartialKernel (hn : 1 ≤ n) (hΩ : IsSWProfile Ω)
    (f : SchwartzMap (EuclideanSpace ℝ (Fin n)) ℂ) (x : EuclideanSpace ℝ (Fin n)) :
    Filter.Tendsto (fun N => (dyadicPartialKernel Ω N ⋆[ContinuousLinearMap.mul ℂ ℂ, volume]
        (f : EuclideanSpace ℝ (Fin n) → ℂ)) x) Filter.atTop
      (nhds (𝓕⁻ (fun ξ => dyadicSymbol Ω ξ * 𝓕 (f : EuclideanSpace ℝ (Fin n) → ℂ) ξ) x)) := by
  obtain ⟨A, hA0, hA⟩ := norm_fourier_sum_smul_dyadicKernel_le hn hΩ
  obtain ⟨A', -, hA', -⟩ := dyadicSymbol_spec hn hΩ
  have hPA : ∀ N ξ, ‖𝓕 (dyadicPartialKernel Ω N) ξ‖ ≤ A := fun N ξ =>
    hA _ (fun _ => (1 : ℂ)) (fun _ => by simp) ξ
  have heq : ∀ N, (dyadicPartialKernel Ω N ⋆[ContinuousLinearMap.mul ℂ ℂ, volume]
      (f : EuclideanSpace ℝ (Fin n) → ℂ)) x = 𝓕⁻ (fun ξ => 𝓕 (dyadicPartialKernel Ω N) ξ *
        𝓕 (f : EuclideanSpace ℝ (Fin n) → ℂ) ξ) x := fun N => by
    rw [fourierInv_fourier_mul_eq_convolution (integrable_dyadicPartialKernel hΩ N) (hPA N) f]
  simp_rw [heq, Real.fourierInv_eq]
  have hfF : Integrable (𝓕 (f : EuclideanSpace ℝ (Fin n) → ℂ)) := (𝓕 f).integrable
  have hfFc : Continuous (𝓕 (f : EuclideanSpace ℝ (Fin n) → ℂ)) := (𝓕 f).continuous
  have hec : Continuous (fun ξ : EuclideanSpace ℝ (Fin n) => 𝐞 ⟪ξ, x⟫) :=
    Real.continuous_fourierChar.comp (continuous_id.inner continuous_const)
  refine MeasureTheory.tendsto_integral_of_dominated_convergence
    (fun ξ => A * ‖𝓕 (f : EuclideanSpace ℝ (Fin n) → ℂ) ξ‖) (fun N => ?_) (hfF.norm.const_mul A)
    (fun N => ae_of_all _ fun ξ => ?_) (ae_of_all _ fun ξ => ?_)
  · have hc : Continuous (𝓕 (dyadicPartialKernel Ω N)) :=
      VectorFourier.fourierIntegral_continuous Real.continuous_fourierChar continuous_inner
        (integrable_dyadicPartialKernel hΩ N)
    exact (hec.smul (hc.mul hfFc)).aestronglyMeasurable
  · rw [Circle.norm_smul, norm_mul]
    exact mul_le_mul_of_nonneg_right (hPA N ξ) (norm_nonneg _)
  · have := (hA' ξ).2.2.1.tendsto_sum_nat
    simp_rw [fourier_dyadicPartialKernel hΩ]
    exact (this.mul_const _).const_smul _

/-- Blueprint Lemma 4.3 (`lem:signedK`), second assertion (multiplier bound): for
`1 < p < ∞` there is `C_p` with `‖𝓕⁻(m_K ⋅ 𝓕f)‖_p ≤ C_p ‖f‖_p` for every Schwartz function
`f` on `E`. -/
theorem exists_eLpNorm_fourierInv_dyadicSymbol_mul_le (hn : 1 ≤ n) (hΩ : IsSWProfile Ω)
    {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ f : SchwartzMap (EuclideanSpace ℝ (Fin n)) ℂ,
      eLpNorm (𝓕⁻ (fun ξ => dyadicSymbol Ω ξ * 𝓕 (f : EuclideanSpace ℝ (Fin n) → ℂ) ξ))
          (ENNReal.ofReal p) volume ≤
        ENNReal.ofReal C * eLpNorm (f : EuclideanSpace ℝ (Fin n) → ℂ) (ENNReal.ofReal p) volume := by
  obtain ⟨C, hC0, hC⟩ := exists_eLpNorm_convolution_sum_smul_dyadicKernel_le hn hΩ hp
  refine ⟨C, hC0, fun f => ?_⟩
  refine eLpNorm_le_of_tendsto_of_eLpNorm_le (fun N => ?_)
    (ae_of_all _ fun x => tendsto_convolution_dyadicPartialKernel hn hΩ f x)
    (fun N => hC _ (fun _ => (1 : ℂ)) (fun _ => by simp) _ (f.memLp _ _))
  exact (BddAbove.continuous_convolution_right_of_integrable _
    ⟨SchwartzMap.seminorm ℝ 0 0 f, fun x ⟨y, hy⟩ => hy ▸ SchwartzMap.norm_le_seminorm ℝ f y⟩
    (integrable_dyadicPartialKernel hΩ N) f.continuous).aestronglyMeasurable

/-- Helper: `|K(y)| ≤ M` for `|y| ≥ 1`. -/
lemma exists_norm_swKernel_le (hΩ : IsSWProfile Ω) :
    ∃ M : ℝ, 0 ≤ M ∧ ∀ y : EuclideanSpace ℝ (Fin n), 1 ≤ ‖y‖ → ‖swKernel Ω y‖ ≤ M := by
  obtain ⟨C, hC⟩ := (isCompact_sphere (0 : EuclideanSpace ℝ (Fin n)) 1).exists_bound_of_continuousOn
    (hΩ.1.continuousOn.mono fun y hy => by
      simp only [mem_sphere_zero_iff_norm] at hy
      simp only [mem_compl_iff, mem_singleton_iff]
      rintro rfl; simp at hy)
  refine ⟨max C 0, le_max_right _ _, fun y hy => ?_⟩
  have hy0 : y ≠ 0 := by rintro rfl; simp at hy; linarith
  have hpos : 0 < ‖y‖ := norm_pos_iff.2 hy0
  have hΩy : Ω y = Ω (‖y‖⁻¹ • y) := (hΩ.2.1 y hy0 _ (inv_pos.2 hpos)).symm
  have hs : ‖y‖⁻¹ • y ∈ sphere (0 : EuclideanSpace ℝ (Fin n)) 1 := by
    rw [mem_sphere_zero_iff_norm, norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hpos.ne']
  have h1 : (1 : ℝ) ≤ ‖y‖ ^ n := one_le_pow₀ hy
  simp only [swKernel, hy0, ite_false, norm_div, Complex.norm_real, Real.norm_eq_abs,
    abs_of_pos (pow_pos hpos n)]
  rw [div_le_iff₀ (by positivity), hΩy]
  calc ‖Ω (‖y‖⁻¹ • y)‖ ≤ max C 0 := (hC _ hs).trans (le_max_left _ _)
    _ = max C 0 * 1 := (mul_one _).symm
    _ ≤ max C 0 * ‖y‖ ^ n := mul_le_mul_of_nonneg_left h1 (le_max_right _ _)

/-- Blueprint Lemma 4.3 (`lem:signedK`), third assertion (identification of the kernel): for
every Schwartz function `f` and every `x ∈ E`, the integral
`∫ (1 - η(y)) K(y) f(x - y) dy` converges absolutely and equals `𝓕⁻(m_K ⋅ 𝓕f)(x)`; i.e. the
kernel of the multiplier `m_K` on Schwartz inputs is `𝒦 = K (1 - η)`. -/
theorem fourierInv_dyadicSymbol_mul_eq_integral (hn : 1 ≤ n) (hΩ : IsSWProfile Ω)
    (f : SchwartzMap (EuclideanSpace ℝ (Fin n)) ℂ) (x : EuclideanSpace ℝ (Fin n)) :
    Integrable (fun y => ((1 - dyadicEta y : ℝ) : ℂ) * swKernel Ω y * f (x - y)) ∧
      𝓕⁻ (fun ξ => dyadicSymbol Ω ξ * 𝓕 (f : EuclideanSpace ℝ (Fin n) → ℂ) ξ) x =
        ∫ y, ((1 - dyadicEta y : ℝ) : ℂ) * swKernel Ω y * f (x - y) := by
  obtain ⟨M, hM0, hM⟩ := exists_norm_swKernel_le hΩ
  set 𝒦 : EuclideanSpace ℝ (Fin n) → ℂ := fun y => ((1 - dyadicEta y : ℝ) : ℂ) * swKernel Ω y
    with h𝒦
  have hlimK : ∀ y, Filter.Tendsto (fun N => dyadicPartialKernel Ω N y) Filter.atTop
      (nhds (𝒦 y)) := fun y => by
    simp_rw [dyadicPartialKernel_apply]
    exact (hasSum_dyadicKernel y).tendsto_sum_nat
  have h𝒦m : AEStronglyMeasurable 𝒦 volume :=
    aestronglyMeasurable_of_tendsto_ae Filter.atTop
      (fun N => (continuous_dyadicPartialKernel hΩ N).aestronglyMeasurable)
      (ae_of_all _ hlimK)
  have h𝒦b : ∀ y, ‖𝒦 y‖ ≤ M := fun y => by
    by_cases hy : ‖y‖ ≤ 1
    · simp [𝒦, dyadicEta_eq_one hy, hM0]
    · have hη := dyadicEta_mem_Icc y
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (by linarith [hη.2])]
      have := hM y (le_of_not_ge hy)
      nlinarith [norm_nonneg (swKernel Ω y), hη.1]
  have hPb : ∀ N y, ‖dyadicPartialKernel Ω N y‖ ≤ ‖𝒦 y‖ := fun N y => by
    have h := sum_range_dyadicKernel (Ω := Ω) y N
    rw [dyadicPartialKernel_apply, h]
    simp only [𝒦, norm_mul, Complex.norm_real, Real.norm_eq_abs]
    refine mul_le_mul_of_nonneg_right ?_ (norm_nonneg _)
    have h1 := dyadicEta_mem_Icc ((2 : ℝ) ^ (-(N : ℤ)) • y)
    have h2 := dyadicEta_mem_Icc y
    have h3 : dyadicEta y ≤ dyadicEta ((2 : ℝ) ^ (-(N : ℤ)) • y) := by
      refine dyadicProfile_antitoneOn (norm_nonneg _) ?_
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos (by positivity)]
      refine mul_le_of_le_one_left (norm_nonneg _) ?_
      exact zpow_le_one_of_nonpos₀ (by norm_num) (by omega)
    rw [abs_of_nonneg (by linarith), abs_of_nonneg (by linarith [h2.2])]
    linarith [h1.2]
  have hfx : Integrable (fun y => f (x - y)) := f.integrable.comp_sub_left x
  have hint : Integrable (fun y => 𝒦 y * f (x - y)) :=
    hfx.bdd_mul h𝒦m (ae_of_all _ h𝒦b)
  refine ⟨hint, ?_⟩
  have hconv : ∀ N, (dyadicPartialKernel Ω N ⋆[ContinuousLinearMap.mul ℂ ℂ, volume]
      (f : EuclideanSpace ℝ (Fin n) → ℂ)) x = ∫ y, dyadicPartialKernel Ω N y * f (x - y) :=
    fun N => by rw [convolution_def]; simp only [ContinuousLinearMap.mul_apply']
  have hlim : Filter.Tendsto (fun N => (dyadicPartialKernel Ω N ⋆[ContinuousLinearMap.mul ℂ ℂ,
      volume] (f : EuclideanSpace ℝ (Fin n) → ℂ)) x) Filter.atTop
      (nhds (∫ y, 𝒦 y * f (x - y))) := by
    simp_rw [hconv]
    refine MeasureTheory.tendsto_integral_of_dominated_convergence
      (fun y => M * ‖f (x - y)‖) (fun N => ?_) (hfx.norm.const_mul M)
      (fun N => ae_of_all _ fun y => ?_) (ae_of_all _ fun y => ?_)
    · exact ((continuous_dyadicPartialKernel hΩ N).mul
        (f.continuous.comp (continuous_const.sub continuous_id))).aestronglyMeasurable
    · rw [norm_mul]
      exact mul_le_mul_of_nonneg_right ((hPb N y).trans (h𝒦b y)) (norm_nonneg _)
    · exact (hlimK y).mul_const _
  exact tendsto_nhds_unique (tendsto_convolution_dyadicPartialKernel hn hΩ f x) hlim


/-! ### Construction 4.4 (`con:phi`): a positive band-limited averaging kernel -/

open scoped SchwartzMap ComplexConjugate

/-- The radii `1/64 < 1/32` of the radial bump `b` of Blueprint Construction 4.4 (`con:phi`). -/
noncomputable def bpBumpData : ContDiffBump (0 : EuclideanSpace ℝ (Fin n)) :=
  ⟨1 / 64, 1 / 32, by norm_num, by norm_num⟩

/-- The bump `b` of Blueprint Construction 4.4 (`con:phi`): a real, even, smooth radial bump
supported in the ball of radius `1/32` (hence in the cube `[-1/32, 1/32]^n`), equal to `1` near
`0`, as a complex Schwartz function. -/
noncomputable def bpBump : 𝓢(EuclideanSpace ℝ (Fin n), ℂ) :=
  HasCompactSupport.toSchwartzMap (f := fun x => ((bpBumpData (n := n) x : ℝ) : ℂ))
    (bpBumpData.hasCompactSupport.comp_left Complex.ofReal_zero)
    (Complex.ofRealCLM.contDiff.comp bpBumpData.contDiff)

/-- Helper: `b` is the complexification of the real bump. -/
lemma bpBump_apply (x : EuclideanSpace ℝ (Fin n)) :
    bpBump x = ((bpBumpData (n := n) x : ℝ) : ℂ) := rfl

/-- Helper: `b(x) = 0` for `|x| ≥ 1/32`. -/
lemma bpBump_eq_zero {x : EuclideanSpace ℝ (Fin n)} (h : 1 / 32 ≤ ‖x‖) : bpBump x = 0 := by
  rw [bpBump_apply, ContDiffBump.zero_of_le_dist]
  · simp
  · simpa [bpBumpData] using h

/-- Helper: `b` is even. -/
lemma bpBump_neg (x : EuclideanSpace ℝ (Fin n)) : bpBump (-x) = bpBump x := by
  simp [bpBump_apply, ContDiffBump.neg]

/-- Blueprint Construction 4.4 (`con:phi`), the choice of `b`: `b` is real-valued, even,
nonzero (`b(0) = 1`), and supported in the cube `[-1/32, 1/32]^n`. -/
theorem bpBump_spec :
    (∀ x : EuclideanSpace ℝ (Fin n), bpBump x = ((bpBump x).re : ℂ)) ∧
    (∀ x : EuclideanSpace ℝ (Fin n), bpBump (-x) = bpBump x) ∧
    bpBump (0 : EuclideanSpace ℝ (Fin n)) = 1 ∧
    (∀ x : EuclideanSpace ℝ (Fin n), (∃ i, 1 / 32 < |x i|) → bpBump x = 0) := by
  refine ⟨fun x => by simp [bpBump_apply], bpBump_neg, ?_, fun x ⟨i, hi⟩ => bpBump_eq_zero ?_⟩
  · rw [bpBump_apply, ContDiffBump.one_of_mem_closedBall]
    · simp
    · simp [bpBumpData]
  · have h1 : |x i| ≤ ‖x‖ := by simpa [Real.norm_eq_abs] using PiLp.norm_apply_le x i
    linarith

/-- The function `ǔ = 𝓕⁻ b` of Blueprint Construction 4.4 (`con:phi`). -/
noncomputable def bpU : 𝓢(EuclideanSpace ℝ (Fin n), ℂ) := 𝓕⁻ bpBump

/-- Helper: `ǔ(x) = ∫ e(v·x) b(v) dv`. -/
lemma bpU_apply (x : EuclideanSpace ℝ (Fin n)) :
    bpU x = ∫ v, 𝐞 ⟪v, x⟫ • bpBump v := by
  rw [bpU, SchwartzMap.fourierInv_coe, Real.fourierInv_eq]

/-- Helper: `ǔ` is even since `b` is. -/
lemma bpU_neg (x : EuclideanSpace ℝ (Fin n)) : bpU (-x) = bpU x := by
  rw [bpU_apply, bpU_apply, ← integral_neg_eq_self]
  congr 1; ext v
  rw [bpBump_neg, inner_neg_neg]

/-- Helper: `ǔ` is real-valued since `b` is real and even. -/
lemma conj_bpU (x : EuclideanSpace ℝ (Fin n)) : conj (bpU x) = bpU x := by
  conv_rhs => rw [← bpU_neg x]
  rw [bpU_apply, bpU_apply, ← integral_conj]
  congr 1; ext v
  simp only [Circle.smul_def, smul_eq_mul, map_mul, bpBump_apply, Complex.conj_ofReal,
    inner_neg_right]
  congr 1
  exact Circle.star_addChar _

/-- The autocorrelation `b ⋆ b` of Blueprint Construction 4.4 (`con:phi`), as a Schwartz
function. -/
noncomputable def bpConv : 𝓢(EuclideanSpace ℝ (Fin n), ℂ) :=
  SchwartzMap.convolution (ContinuousLinearMap.mul ℂ ℂ) bpBump bpBump

/-- Helper: the product-convolution identity `𝓕⁻(b ⋆ b) = ǔ ⋅ ǔ`. -/
lemma fourierInv_bpConv_apply (x : EuclideanSpace ℝ (Fin n)) :
    𝓕⁻ (bpConv (n := n)) x = bpU x * bpU x := by
  rw [SchwartzMap.fourierInv_coe, Real.fourierInv_eq_fourier_neg, ← SchwartzMap.fourier_coe,
    bpConv, SchwartzMap.fourier_convolution, bpU, SchwartzMap.fourierInv_coe,
    Real.fourierInv_eq_fourier_neg, ← SchwartzMap.fourier_coe]
  simp

/-- Helper: `ǔ ⋅ ǔ = |ǔ|²` (as `ǔ` is real). -/
lemma bpU_mul_self (x : EuclideanSpace ℝ (Fin n)) :
    bpU x * bpU x = ((‖bpU (n := n) x‖ ^ 2 : ℝ) : ℂ) := by
  conv_lhs => arg 2; rw [← conj_bpU x]
  rw [Complex.mul_conj, Complex.normSq_eq_norm_sq]

/-- The normalization `∫_E |ǔ|²` of Blueprint Construction 4.4 (`con:phi`). -/
noncomputable def bpNorm : ℝ := ∫ x, ‖(bpU (n := n)) x‖ ^ 2

/-- Helper: `|ǔ|²` is integrable. -/
lemma integrable_norm_bpU_sq : Integrable (fun x => ‖(bpU (n := n)) x‖ ^ 2) := by
  refine ((𝓕⁻ (bpConv (n := n))).integrable.norm).congr (Filter.Eventually.of_forall fun x => ?_)
  simp only [fourierInv_bpConv_apply, bpU_mul_self, Complex.norm_real, Real.norm_eq_abs]
  exact abs_of_nonneg (by positivity)

/-- Helper: `∫ |ǔ|² > 0` (`ǔ ≠ 0` because `𝓕 ǔ = b ≠ 0`). -/
lemma bpNorm_pos : 0 < bpNorm (n := n) := by
  have hb : 𝓕 (bpU (n := n)) = bpBump := by simp [bpU]
  obtain ⟨x, hx⟩ : ∃ x, bpU (n := n) x ≠ 0 := by
    by_contra h
    simp only [not_exists, not_not] at h
    have : bpU (n := n) = 0 := by ext x; simp [h x]
    have h0 := (bpBump_spec (n := n)).2.2.1
    rw [← hb, this, FourierTransform.fourier_zero] at h0
    exact zero_ne_one h0
  exact integral_pos_of_integrable_nonneg_nonzero (x := x) (by fun_prop) integrable_norm_bpU_sq
    (fun _ => by positivity) (by simpa using hx)

/-- The kernel `φ(x) = |ǔ(x)|² / ∫_E |ǔ|²`, `ǔ = 𝓕⁻ b`, of Blueprint Construction 4.4
(`con:phi`), as a real-valued function (its Schwartz version is `bpPhiS`). -/
noncomputable def bpPhi (x : EuclideanSpace ℝ (Fin n)) : ℝ :=
  ‖(bpU (n := n)) x‖ ^ 2 / bpNorm (n := n)

/-- Blueprint Construction 4.4 (`con:phi`), definition of `φ`:
`φ(x) = |𝓕⁻ b (x)|² / ∫_E |𝓕⁻ b|²`. -/
theorem bpPhi_def (x : EuclideanSpace ℝ (Fin n)) :
    bpPhi x = ‖(𝓕⁻ bpBump : 𝓢(EuclideanSpace ℝ (Fin n), ℂ)) x‖ ^ 2 /
      ∫ y, ‖(𝓕⁻ bpBump : 𝓢(EuclideanSpace ℝ (Fin n), ℂ)) y‖ ^ 2 := rfl

/-- The complex Schwartz function `(∫|ǔ|²)⁻¹ 𝓕⁻(b ⋆ b)`, which equals `φ`
(`coe_bpPhiS`). -/
noncomputable def bpPhiS : 𝓢(EuclideanSpace ℝ (Fin n), ℂ) :=
  ((bpNorm (n := n) : ℂ)⁻¹) • 𝓕⁻ (bpConv (n := n))

/-- Helper: pointwise form of `coe_bpPhiS`. -/
lemma bpPhiS_apply (x : EuclideanSpace ℝ (Fin n)) : bpPhiS x = (bpPhi x : ℂ) := by
  simp only [bpPhiS, smul_apply, fourierInv_bpConv_apply, bpU_mul_self, bpPhi,
    smul_eq_mul, Complex.ofReal_div]
  ring

/-- Blueprint Construction 4.4 (`con:phi`): `φ` is a Schwartz function, namely (the
complexification of) `φ` is the Schwartz function `bpPhiS`. -/
theorem coe_bpPhiS : (bpPhiS : EuclideanSpace ℝ (Fin n) → ℂ) = fun x => (bpPhi x : ℂ) :=
  funext bpPhiS_apply

/-- Helper: `𝓕 φ = (∫|ǔ|²)⁻¹ (b ⋆ b)` (Fourier inversion on Schwartz space). -/
lemma fourier_bpPhiS : 𝓕 (bpPhiS (n := n)) = ((bpNorm (n := n) : ℂ)⁻¹) • bpConv := by
  rw [bpPhiS, FourierTransform.fourier_smul, FourierTransform.fourier_fourierInv_eq]

/-- Blueprint Construction 4.4 (`con:phi`): `φ ≥ 0`. -/
theorem bpPhi_nonneg (x : EuclideanSpace ℝ (Fin n)) : 0 ≤ bpPhi x :=
  div_nonneg (by positivity) bpNorm_pos.le

/-- Blueprint Construction 4.4 (`con:phi`): `φ` is even, `φ(-x) = φ(x)`. -/
theorem bpPhi_neg (x : EuclideanSpace ℝ (Fin n)) : bpPhi (-x) = bpPhi x := by
  rw [bpPhi, bpPhi, bpU_neg]

/-- Blueprint Construction 4.4 (`con:phi`): `∫_E φ = 1`. -/
theorem integral_bpPhi : ∫ x, bpPhi (n := n) x = 1 := by
  rw [show (fun x => bpPhi (n := n) x) = fun x => ‖(bpU (n := n)) x‖ ^ 2 / bpNorm (n := n)
    from rfl, integral_div]
  exact div_self bpNorm_pos.ne'

/-- Blueprint Construction 4.4 (`con:phi`): all moments are finite, `|x|^k φ(x)` is integrable
for every `k` (in particular `φ` and `x_i φ(x)` are integrable). -/
theorem integrable_pow_mul_bpPhi (k : ℕ) :
    Integrable (fun x : EuclideanSpace ℝ (Fin n) => ‖x‖ ^ k * bpPhi x) := by
  refine (bpPhiS.integrable_pow_mul volume k).congr (Filter.Eventually.of_forall fun x => ?_)
  simp only [bpPhiS_apply, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (bpPhi_nonneg x)]

/-- Blueprint Construction 4.4 (`con:phi`): the first moments vanish,
`∫_E x_i φ(x) dx = 0` for every `i`. -/
theorem integral_coord_mul_bpPhi (i : Fin n) :
    ∫ x : EuclideanSpace ℝ (Fin n), x i * bpPhi x = 0 := by
  have h := integral_neg_eq_self (fun x : EuclideanSpace ℝ (Fin n) => x i * bpPhi x) volume
  simp only [PiLp.neg_apply, bpPhi_neg, neg_mul, integral_neg] at h
  linarith

/-- Helper: `𝓕 φ (ξ) = (∫|ǔ|²)⁻¹ ∫ b(t) b(ξ - t) dt`. -/
lemma fourier_bpPhi_apply (ξ : EuclideanSpace ℝ (Fin n)) :
    𝓕 (fun x => (bpPhi x : ℂ)) ξ =
      (bpNorm (n := n) : ℂ)⁻¹ * ∫ t, bpBump t * bpBump (ξ - t) := by
  rw [← coe_bpPhiS, ← SchwartzMap.fourier_coe, fourier_bpPhiS, smul_apply, bpConv,
    SchwartzMap.convolution_apply, convolution_def]
  simp

/-- Blueprint Construction 4.4 (`con:phi`): `supp 𝓕φ ⊆ [-1/16, 1/16]^n`, i.e. `𝓕 φ (ξ) = 0`
as soon as `|ξ_i| > 1/16` for some `i` (`𝓕` is Mathlib's Fourier transform). -/
theorem fourier_bpPhi_eq_zero {ξ : EuclideanSpace ℝ (Fin n)} (h : ∃ i, 1 / 16 < |ξ i|) :
    𝓕 (fun x => (bpPhi x : ℂ)) ξ = 0 := by
  obtain ⟨i, hi⟩ := h
  rw [fourier_bpPhi_apply]
  have : ∀ t, bpBump t * bpBump (ξ - t) = 0 := by
    intro t
    by_cases ht : 1 / 32 ≤ ‖t‖
    · rw [bpBump_eq_zero ht, zero_mul]
    · rw [bpBump_eq_zero (x := ξ - t) ?_, mul_zero]
      have h1 : |t i| ≤ ‖t‖ := by simpa [Real.norm_eq_abs] using PiLp.norm_apply_le t i
      have h2 : |(ξ - t) i| ≤ ‖ξ - t‖ := by
        simpa [Real.norm_eq_abs] using PiLp.norm_apply_le (ξ - t) i
      have h3 : |ξ i| ≤ |(ξ - t) i| + |t i| := by
        simpa using abs_add_le ((ξ - t) i) (t i)
      linarith
  simp [this]

/-- Blueprint Construction 4.4 (`con:phi`): `𝓕 φ (0) = ∫ φ = 1`. -/
theorem fourier_bpPhi_zero : 𝓕 (fun x => (bpPhi (n := n) x : ℂ)) 0 = 1 := by
  rw [Real.fourier_eq]
  simp [integral_complex_ofReal, integral_bpPhi]

/-- The dilates `φ_J(x) = 2^{-Jn} φ(2^{-J} x)`, `J ∈ ℤ`, of Blueprint Construction 4.4
(`con:phi`). -/
noncomputable def bpPhiDil (J : ℤ) (x : EuclideanSpace ℝ (Fin n)) : ℝ :=
  (2 : ℝ) ^ (-(J * n)) * bpPhi ((2 : ℝ) ^ (-J) • x)

/-- The multipliers `τ_J(ξ) = 𝓕φ(2^J ξ)`, `J ∈ ℤ`, of Blueprint Construction 4.4
(`con:phi`). -/
noncomputable def bpTau (J : ℤ) (ξ : EuclideanSpace ℝ (Fin n)) : ℂ :=
  𝓕 (fun x => (bpPhi x : ℂ)) ((2 : ℝ) ^ J • ξ)

/-- Helper: `2^{-Jn} = (2^{-J})^n`. -/
lemma two_zpow_neg_mul_natCast_eq_pow (J : ℤ) :
    (2 : ℝ) ^ (-(J * n)) = ((2 : ℝ) ^ (-J)) ^ n := by
  rw [← zpow_natCast, ← zpow_mul, neg_mul]

/-- Blueprint Construction 4.4 (`con:phi`): `φ_J ≥ 0`. -/
theorem bpPhiDil_nonneg (J : ℤ) (x : EuclideanSpace ℝ (Fin n)) : 0 ≤ bpPhiDil J x :=
  mul_nonneg (by positivity) (bpPhi_nonneg _)

/-- Blueprint Construction 4.4 (`con:phi`): `τ_J = 𝓕 φ_J`, i.e.
`𝓕 φ_J (ξ) = 𝓕 φ (2^J ξ)`. -/
theorem fourier_bpPhiDil (J : ℤ) (ξ : EuclideanSpace ℝ (Fin n)) :
    𝓕 (fun x => (bpPhiDil J x : ℂ)) ξ = bpTau J ξ := by
  set c : ℝ := (2 : ℝ) ^ (-J) with hc_def
  have hc : 0 < c := by positivity
  let g : EuclideanSpace ℝ (Fin n) → ℂ := fun y => 𝐞 (-⟪c⁻¹ • y, ξ⟫) • (bpPhi y : ℂ)
  have h1 : ∀ x, 𝐞 (-⟪x, ξ⟫) • (bpPhiDil J x : ℂ) = c ^ n • g (c • x) := by
    intro x
    simp only [g, bpPhiDil, inv_smul_smul₀ hc.ne', two_zpow_neg_mul_natCast_eq_pow, ← hc_def]
    simp only [Circle.smul_def, Complex.real_smul]
    push_cast
    ring
  rw [bpTau, Real.fourier_eq, Real.fourier_eq]
  simp_rw [h1]
  rw [integral_smul, Measure.integral_comp_smul, finrank_euclideanSpace_fin, smul_smul,
    abs_of_pos (by positivity), mul_inv_cancel₀ (by positivity), one_smul]
  refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
  simp only [g, real_inner_smul_left, real_inner_smul_right, hc_def, zpow_neg, inv_inv]

/-- Blueprint Construction 4.4 (`con:phi`): `supp τ_J ⊆ [-2^{-J}/16, 2^{-J}/16]^n`. -/
theorem bpTau_eq_zero (J : ℤ) {ξ : EuclideanSpace ℝ (Fin n)}
    (h : ∃ i, (2 : ℝ) ^ (-J) / 16 < |ξ i|) : bpTau J ξ = 0 := by
  obtain ⟨i, hi⟩ := h
  refine fourier_bpPhi_eq_zero ⟨i, ?_⟩
  have h2 : (0 : ℝ) < 2 ^ J := by positivity
  rw [PiLp.smul_apply, smul_eq_mul, abs_mul, abs_of_pos h2]
  rw [zpow_neg, div_lt_iff₀ (by norm_num)] at hi
  have h3 := mul_lt_mul_of_pos_left hi h2
  rw [mul_inv_cancel₀ h2.ne'] at h3
  linarith

/-- Blueprint Construction 4.4 (`con:phi`): `τ_J(0) = 1`. -/
theorem bpTau_zero (J : ℤ) : bpTau J (0 : EuclideanSpace ℝ (Fin n)) = 1 := by
  rw [bpTau, smul_zero, fourier_bpPhi_zero]

/-- Blueprint Construction 4.4 (`con:phi`): `∫_E φ_J = 1` for every `J ∈ ℤ`. -/
theorem integral_bpPhiDil (J : ℤ) : ∫ x, bpPhiDil (n := n) J x = 1 := by
  have h := fourier_bpPhiDil (n := n) J 0
  rw [bpTau_zero, Real.fourier_eq] at h
  simp only [inner_zero_right, neg_zero, AddChar.map_zero_eq_one, one_smul,
    integral_complex_ofReal] at h
  exact_mod_cast h

/-- The explicit constant `C = 2^{n+1} max_{k ≤ n+1} ‖φ‖_{k,0}` in `φ(x) ≤ C (1 + |x|)^{-n-1}`
(Blueprint Construction 4.4, `con:phi`). -/
noncomputable def bpPhiConst (n : ℕ) : ℝ :=
  2 ^ (n + 1) * (Finset.Iic (n + 1, 0)).sup (fun m => SchwartzMap.seminorm ℝ m.1 m.2)
    (bpPhiS (n := n))

/-- Helper: the constant `bpPhiConst n` is nonnegative. -/
lemma bpPhiConst_nonneg : 0 ≤ bpPhiConst n := mul_nonneg (by positivity) (apply_nonneg _ _)

/-- Helper: the Schwartz decay `φ(x) ≤ C (1 + |x|)^{-n-1}`. -/
lemma bpPhi_le (x : EuclideanSpace ℝ (Fin n)) :
    bpPhi x ≤ bpPhiConst n * ((1 + ‖x‖) ^ (n + 1))⁻¹ := by
  have h := SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℝ) (m := (n + 1, 0)) le_rfl le_rfl
    (bpPhiS (n := n)) x
  rw [norm_iteratedFDeriv_zero, bpPhiS_apply, Complex.norm_real,
    Real.norm_of_nonneg (bpPhi_nonneg x)] at h
  rw [le_mul_inv_iff₀ (by positivity), mul_comm]
  exact h

/-- Blueprint Construction 4.4 (`con:phi`), domination by the envelope of Lemma 2.4
(`lem:maximal`): `φ_J(x) ≤ C B_{2^J}(x)` for all `J ∈ ℤ` and `x ∈ E`, with
`C = bpPhiConst n`. -/
theorem bpPhiDil_le_envelope (J : ℤ) (x : EuclideanSpace ℝ (Fin n)) :
    bpPhiDil J x ≤ bpPhiConst n * envelope n ((2 : ℝ) ^ J) x := by
  have hc : (0 : ℝ) < 2 ^ (-J) := by positivity
  calc bpPhiDil J x ≤ (2 : ℝ) ^ (-(J * n)) * (bpPhiConst n *
        ((1 + ‖(2 : ℝ) ^ (-J) • x‖) ^ (n + 1))⁻¹) :=
        mul_le_mul_of_nonneg_left (bpPhi_le _) (by positivity)
    _ = bpPhiConst n * envelope n ((2 : ℝ) ^ J) x := by
      rw [envelope, norm_smul, Real.norm_of_nonneg hc.le, two_zpow_neg_mul_natCast_eq_pow,
        zpow_neg, div_eq_inv_mul, inv_pow]
      ring

/-- Blueprint Construction 4.4 (`con:phi`), "in particular" (on `E`, via Lemma 2.4
`lem:maximal`): `(|φ_J| * |f|)(x) = ∫ φ_J(y) |f(x - y)| dy ≤ C 𝖬 f(x)` for every `J ∈ ℤ`,
`x ∈ E` and a.e. strongly measurable `f`, with `C = bpPhiConst n * envelopeConst n`. -/
theorem lintegral_bpPhiDil_mul_le_cubeMaximalEuclidean {F : Type*} [NormedAddCommGroup F]
    (J : ℤ) {f : EuclideanSpace ℝ (Fin n) → F} (hf : AEStronglyMeasurable f volume)
    (x : EuclideanSpace ℝ (Fin n)) :
    ∫⁻ y, ENNReal.ofReal (bpPhiDil J y) * ‖f (x - y)‖ₑ ≤
      ENNReal.ofReal (bpPhiConst n * envelopeConst n) * cubeMaximalEuclidean n f x := by
  have hR : (0 : ℝ) < 2 ^ J := by positivity
  calc ∫⁻ y, ENNReal.ofReal (bpPhiDil J y) * ‖f (x - y)‖ₑ
      ≤ ∫⁻ y, ENNReal.ofReal (bpPhiConst n) *
          (ENNReal.ofReal (envelope n ((2 : ℝ) ^ J) y) * ‖f (x - y)‖ₑ) := by
        refine lintegral_mono fun y => ?_
        rw [← mul_assoc, ← ENNReal.ofReal_mul bpPhiConst_nonneg]
        gcongr
        exact bpPhiDil_le_envelope J y
    _ = ENNReal.ofReal (bpPhiConst n) *
          ∫⁻ y, ENNReal.ofReal (envelope n ((2 : ℝ) ^ J) y) * ‖f (x - y)‖ₑ :=
        lintegral_const_mul' _ _ ENNReal.ofReal_ne_top
    _ ≤ ENNReal.ofReal (bpPhiConst n) *
          (ENNReal.ofReal (envelopeConst n) * cubeMaximalEuclidean n f x) := by
        gcongr
        exact lintegral_envelope_mul_le_cubeMaximalEuclidean hR hf x
    _ = _ := by rw [ENNReal.ofReal_mul bpPhiConst_nonneg, mul_assoc]

/-- Blueprint Construction 4.4 (`con:phi`), "in particular" (on `E`), maximal form:
`sup_J (φ_J * |f|)(x) ≤ C 𝖬 f(x)` with `C = bpPhiConst n * envelopeConst n`. -/
theorem iSup_lintegral_bpPhiDil_mul_le_cubeMaximalEuclidean {F : Type*} [NormedAddCommGroup F]
    {f : EuclideanSpace ℝ (Fin n) → F} (hf : AEStronglyMeasurable f volume)
    (x : EuclideanSpace ℝ (Fin n)) :
    ⨆ J : ℤ, ∫⁻ y, ENNReal.ofReal (bpPhiDil J y) * ‖f (x - y)‖ₑ ≤
      ENNReal.ofReal (bpPhiConst n * envelopeConst n) * cubeMaximalEuclidean n f x :=
  iSup_le fun J => lintegral_bpPhiDil_mul_le_cubeMaximalEuclidean J hf x

/-- Blueprint Construction 4.4 (`con:phi`), "in particular" for the sampled lattice kernel
(on `G = ℤⁿ`, via Lemma 2.4 `lem:maximal`): for `J ≥ 0`,
`∑_y φ_J(y) |f(x - y)| ≤ C 𝖬 f(x)` with `C = bpPhiConst n * envelopeConst n`. -/
theorem tsum_bpPhiDil_latEmbed_mul_le_cubeMaximalInt {F : Type*} [NormedAddCommGroup F]
    {J : ℤ} (hJ : 0 ≤ J) (f : (Fin n → ℤ) → F) (x : Fin n → ℤ) :
    ∑' y, ENNReal.ofReal (bpPhiDil J (latEmbed y)) * ‖f (x - y)‖ₑ ≤
      ENNReal.ofReal (bpPhiConst n * envelopeConst n) * cubeMaximalInt n f x := by
  have hR : (1 : ℝ) ≤ 2 ^ J := one_le_zpow₀ (by norm_num) hJ
  calc ∑' y, ENNReal.ofReal (bpPhiDil J (latEmbed y)) * ‖f (x - y)‖ₑ
      ≤ ∑' y, ENNReal.ofReal (bpPhiConst n) *
          (ENNReal.ofReal (latEnvelope n ((2 : ℝ) ^ J) y) * ‖f (x - y)‖ₑ) := by
        refine ENNReal.tsum_le_tsum fun y => ?_
        rw [← mul_assoc, ← ENNReal.ofReal_mul bpPhiConst_nonneg]
        gcongr
        exact bpPhiDil_le_envelope J (latEmbed y)
    _ = ENNReal.ofReal (bpPhiConst n) *
          ∑' y, ENNReal.ofReal (latEnvelope n ((2 : ℝ) ^ J) y) * ‖f (x - y)‖ₑ :=
        ENNReal.tsum_mul_left
    _ ≤ ENNReal.ofReal (bpPhiConst n) *
          (ENNReal.ofReal (envelopeConst n) * cubeMaximalInt n f x) := by
        gcongr
        exact tsum_envelope_mul_le_cubeMaximalInt hR f x
    _ = _ := by rw [ENNReal.ofReal_mul bpPhiConst_nonneg, mul_assoc]

/-- Blueprint Construction 4.4 (`con:phi`), lattice maximal form:
`sup_{J ≥ 0} ∑_y φ_J(y) |f(x - y)| ≤ C 𝖬 f(x)` on `G = ℤⁿ`, with
`C = bpPhiConst n * envelopeConst n`. -/
theorem iSup_tsum_bpPhiDil_latEmbed_mul_le_cubeMaximalInt {F : Type*} [NormedAddCommGroup F]
    (f : (Fin n → ℤ) → F) (x : Fin n → ℤ) :
    ⨆ (J : ℤ) (_ : 0 ≤ J), ∑' y, ENNReal.ofReal (bpPhiDil J (latEmbed y)) * ‖f (x - y)‖ₑ ≤
      ENNReal.ofReal (bpPhiConst n * envelopeConst n) * cubeMaximalInt n f x :=
  iSup₂_le fun _ hJ => tsum_bpPhiDil_latEmbed_mul_le_cubeMaximalInt hJ f x

/-! ## Lemma 4.5 (`lem:smootherrors`): signed smoothing errors for truncation -/

/-- The truncated kernel `∑_{j ≥ J} K_j` of Blueprint Lemma 4.5 (`lem:smootherrors`), as the
series `∑_{i ∈ ℕ} K_{J+i}` (at each point only finitely many terms are nonzero). -/
noncomputable def truncKernel (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (J : ℤ)
    (x : EuclideanSpace ℝ (Fin n)) : ℂ :=
  ∑' i : ℕ, dyadicKernel Ω (J + i) x

/-- Helper: `K_j(x) = 0` for `|x| ≤ 2^{j-1}`. -/
lemma dyadicKernel_eq_zero_of_norm_le (j : ℤ) {x : EuclideanSpace ℝ (Fin n)}
    (h : ‖x‖ ≤ (2 : ℝ) ^ (j - 1)) : dyadicKernel Ω j x = 0 := by
  by_contra hx
  exact absurd (support_dyadicKernel j hx).1 (not_lt.2 h)

/-- Helper: on `|w| ≤ 2^{J+N-1}` the truncated kernel is the finite sum `∑_{i < N} K_{J+i}`. -/
lemma truncKernel_eq_sum (J : ℤ) (N : ℕ) {w : EuclideanSpace ℝ (Fin n)}
    (hw : ‖w‖ ≤ (2 : ℝ) ^ (J + N - 1)) :
    truncKernel Ω J w = ∑ i ∈ Finset.range N, dyadicKernel Ω (J + i) w := by
  unfold truncKernel
  apply tsum_eq_sum
  intro i hi
  rw [Finset.mem_range, not_lt] at hi
  apply dyadicKernel_eq_zero_of_norm_le
  refine hw.trans (zpow_le_zpow_right₀ (by norm_num) ?_)
  have : (N : ℤ) ≤ i := by exact_mod_cast hi
  omega

/-- Helper: every radius is below some `2^{J+N-1}`. -/
lemma exists_lt_two_zpow_add (J : ℤ) (r : ℝ) : ∃ N : ℕ, r < (2 : ℝ) ^ (J + N - 1) := by
  obtain ⟨m, hm⟩ := pow_unbounded_of_one_lt r (by norm_num : (1 : ℝ) < 2)
  refine ⟨(m + 1 - J).toNat, hm.trans_le ?_⟩
  rw [← zpow_natCast]
  exact zpow_le_zpow_right₀ (by norm_num) (by omega)

/-- Helper: locally the truncated kernel is a finite sum of the `K_{J+i}`. -/
lemma truncKernel_eventuallyEq_sum (J : ℤ) (w : EuclideanSpace ℝ (Fin n)) :
    ∃ N : ℕ, truncKernel Ω J =ᶠ[nhds w]
      fun v => ∑ i ∈ Finset.range N, dyadicKernel Ω (J + i) v := by
  obtain ⟨N, hN⟩ := exists_lt_two_zpow_add J (‖w‖ + 1)
  refine ⟨N, ?_⟩
  filter_upwards [ball_mem_nhds w one_pos] with v hv
  apply truncKernel_eq_sum
  have : ‖v‖ ≤ ‖w‖ + dist v w := by
    have := norm_le_norm_add_norm_sub' v w
    rw [dist_eq_norm]; linarith [norm_sub_rev v w]
  rw [mem_ball] at hv
  linarith

/-- Helper: `∑_{i ≥ 0} K_{J+i}(x)` has finitely many nonzero terms and sums to the truncated
kernel. -/
lemma hasSum_truncKernel (J : ℤ) (x : EuclideanSpace ℝ (Fin n)) :
    HasSum (fun i : ℕ => dyadicKernel Ω (J + i) x) (truncKernel Ω J x) := by
  obtain ⟨N, hN⟩ := exists_lt_two_zpow_add J ‖x‖
  rw [truncKernel_eq_sum J N hN.le]
  apply hasSum_sum_of_ne_finset_zero
  intro i hi
  rw [Finset.mem_range, not_lt] at hi
  apply dyadicKernel_eq_zero_of_norm_le
  refine hN.le.trans (zpow_le_zpow_right₀ (by norm_num) ?_)
  have : (N : ℤ) ≤ i := by exact_mod_cast hi
  omega

/-- Helper: the truncated kernel is smooth. -/
theorem contDiff_truncKernel (hΩ : IsSWProfile Ω) (J : ℤ) :
    ContDiff ℝ ∞ (truncKernel Ω J) := by
  rw [contDiff_iff_contDiffAt]
  intro w
  obtain ⟨N, hN⟩ := truncKernel_eventuallyEq_sum (Ω := Ω) J w
  refine ContDiffAt.congr_of_eventuallyEq ?_ hN
  exact (ContDiff.sum fun i _ => contDiff_dyadicKernel hΩ _).contDiffAt

/-- Helper: `2^{-jm} ≤ 2^{-Jm} 2^{-|j - J|}` for `j ≥ J`, `m ≥ 1`. -/
lemma two_zpow_neg_mul_le {J j : ℤ} (h : J ≤ j) {m : ℕ} (hm : 1 ≤ m) :
    (2 : ℝ) ^ (-j * (m : ℤ)) ≤ (2 : ℝ) ^ (-J * (m : ℤ)) * 2 ^ (-|j - J|) := by
  rw [← zpow_add₀ two_ne_zero, abs_of_nonneg (by omega)]
  apply zpow_le_zpow_right₀ (by norm_num)
  have : (j - J) * 1 ≤ (j - J) * (m : ℤ) :=
    mul_le_mul_of_nonneg_left (by exact_mod_cast hm) (by omega)
  nlinarith

/-- Helper: for every order `k` (with `n + k ≥ 1`) there is `A` with
`∑_{i ∈ s} ‖D^k K_{J+i}(x)‖ ≤ A (2^J + |x|)^{-n-k}` for all `J`, finite `s ⊆ ℕ` and `x`. -/
lemma sum_norm_iteratedFDeriv_dyadicKernel_add_le (hΩ : IsSWProfile Ω) (k : ℕ)
    (hk : 1 ≤ n + k) :
    ∃ A : ℝ, 0 ≤ A ∧ ∀ (J : ℤ) (s : Finset ℕ) (x : EuclideanSpace ℝ (Fin n)),
      ∑ i ∈ s, ‖iteratedFDeriv ℝ k (dyadicKernel Ω (J + i)) x‖ ≤
        A / ((2 : ℝ) ^ J + ‖x‖) ^ (n + k) := by
  obtain ⟨C, hC⟩ := norm_iteratedFDeriv_dyadicKernel_le hΩ k
  have hC0 : 0 ≤ C := by
    have h := (norm_nonneg _).trans (hC 0 0)
    exact nonneg_of_mul_nonneg_left h (by positivity)
  obtain ⟨B, hB0, hB⟩ := sum_norm_iteratedFDeriv_dyadicKernel_le hΩ k
  refine ⟨2 ^ (n + k) * (C * geomZ + B), by have := geomZ_nonneg; positivity,
    fun J s x => ?_⟩
  set R : ℝ := (2 : ℝ) ^ J with hR
  have hR0 : 0 < R := by positivity
  let emb : ℕ ↪ ℤ := ⟨fun i => J + i, fun a b h => by simpa using h⟩
  -- first bound: `C geomZ R^{-(n+k)}`
  have h1 : ∑ i ∈ s, ‖iteratedFDeriv ℝ k (dyadicKernel Ω (J + i)) x‖ ≤
      C * geomZ / R ^ (n + k) := by
    calc ∑ i ∈ s, ‖iteratedFDeriv ℝ k (dyadicKernel Ω (J + i)) x‖
        ≤ ∑ j ∈ s.map emb, C * ((2 : ℝ) ^ (-J * ((n + k : ℕ) : ℤ)) * 2 ^ (-|j - J|)) := by
          rw [Finset.sum_map]
          refine Finset.sum_le_sum fun i _ => (hC _ x).trans ?_
          refine mul_le_mul_of_nonneg_left ?_ hC0
          have := two_zpow_neg_mul_le (J := J) (j := J + i) (by omega) hk
          change _ ≤ (2 : ℝ) ^ (-J * ((n + k : ℕ) : ℤ)) * 2 ^ (-|(J + i) - J|)
          push_cast at this ⊢
          exact this
      _ = C * (2 : ℝ) ^ (-J * ((n + k : ℕ) : ℤ)) * ∑ j ∈ s.map emb, (2 : ℝ) ^ (-|j - J|) := by
          rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun _ _ => by ring
      _ ≤ C * (2 : ℝ) ^ (-J * ((n + k : ℕ) : ℤ)) * geomZ := by
          gcongr; exact sum_two_zpow_neg_abs_sub_le _ J
      _ = C * geomZ / R ^ (n + k) := by
          rw [hR, ← zpow_natCast, ← zpow_mul, neg_mul, zpow_neg]; ring
  rcases le_or_gt ‖x‖ R with hx | hx
  · calc _ ≤ C * geomZ / R ^ (n + k) := h1
      _ ≤ 2 ^ (n + k) * (C * geomZ) / (R + ‖x‖) ^ (n + k) := by
          rw [div_le_div_iff₀ (by positivity) (by positivity)]
          have : (R + ‖x‖) ^ (n + k) ≤ 2 ^ (n + k) * R ^ (n + k) := by
            rw [← mul_pow]; exact pow_le_pow_left₀ (by positivity) (by linarith) _
          have := geomZ_nonneg
          nlinarith [mul_nonneg hC0 geomZ_nonneg]
      _ ≤ _ := by
          gcongr; have := geomZ_nonneg; nlinarith [mul_nonneg hC0 geomZ_nonneg]
  · have hx0 : x ≠ 0 := by rintro rfl; simp at hx; linarith
    have h2 := hB (s.map emb) x hx0
    rw [Finset.sum_map] at h2
    calc _ ≤ B / ‖x‖ ^ (n + k) := h2
      _ ≤ 2 ^ (n + k) * B / (R + ‖x‖) ^ (n + k) := by
          have hxp : 0 < ‖x‖ := norm_pos_iff.2 hx0
          rw [div_le_div_iff₀ (by positivity) (by positivity)]
          have : (R + ‖x‖) ^ (n + k) ≤ 2 ^ (n + k) * ‖x‖ ^ (n + k) := by
            rw [← mul_pow]; exact pow_le_pow_left₀ (by positivity) (by linarith) _
          nlinarith
      _ ≤ _ := by
          gcongr; have := geomZ_nonneg; nlinarith [mul_nonneg hC0 geomZ_nonneg]

/-- Helper: derivative bounds for the truncated kernel,
`‖D^k (∑_{j ≥ J} K_j)(x)‖ ≤ A_k (2^J + |x|)^{-n-k}` uniformly in `J ∈ ℤ`. -/
theorem norm_iteratedFDeriv_truncKernel_le (hΩ : IsSWProfile Ω) (k : ℕ) (hk : 1 ≤ n + k) :
    ∃ A : ℝ, 0 ≤ A ∧ ∀ (J : ℤ) (x : EuclideanSpace ℝ (Fin n)),
      ‖iteratedFDeriv ℝ k (truncKernel Ω J) x‖ ≤ A / ((2 : ℝ) ^ J + ‖x‖) ^ (n + k) := by
  obtain ⟨A, hA0, hA⟩ := sum_norm_iteratedFDeriv_dyadicKernel_add_le hΩ k hk
  refine ⟨A, hA0, fun J x => ?_⟩
  obtain ⟨N, hN⟩ := truncKernel_eventuallyEq_sum (Ω := Ω) J x
  rw [(hN.iteratedFDeriv ℝ k).eq_of_nhds, iteratedFDeriv_fun_sum_apply
    (fun i _ => (contDiff_dyadicKernel hΩ _).contDiffAt.of_le (by simp))]
  exact (norm_sum_le _ _).trans (hA J _ x)

/-! ### Complex dilates of `φ` -/

/-- The complexification `x ↦ (φ_J(x) : ℂ)` of the dilates of Blueprint Construction 4.4
(`con:phi`), used as a convolution kernel. -/
noncomputable def bpPhiDilC (J : ℤ) (x : EuclideanSpace ℝ (Fin n)) : ℂ := (bpPhiDil J x : ℂ)

/-- Helper: `φ_J(x) = c^n φ(c x)` with `c = 2^{-J}`, in terms of the Schwartz function
`bpPhiS`. -/
lemma bpPhiDilC_eq (J : ℤ) (x : EuclideanSpace ℝ (Fin n)) :
    bpPhiDilC J x = ((2 : ℝ) ^ (-J)) ^ n • bpPhiS ((2 : ℝ) ^ (-J) • x) := by
  rw [bpPhiDilC, bpPhiDil, bpPhiS_apply, two_zpow_neg_mul_natCast_eq_pow, Complex.real_smul]
  push_cast; ring

/-- Helper: `φ_J` is even. -/
lemma bpPhiDil_neg (J : ℤ) (x : EuclideanSpace ℝ (Fin n)) : bpPhiDil J (-x) = bpPhiDil J x := by
  rw [bpPhiDil, bpPhiDil, smul_neg, bpPhi_neg]

/-- Helper: `φ` is continuous. -/
lemma continuous_bpPhi : Continuous (bpPhi (n := n)) :=
  ((bpU (n := n)).continuous.norm.pow 2).div_const _

/-- Helper: `φ_J` is continuous. -/
lemma continuous_bpPhiDil (J : ℤ) : Continuous (bpPhiDil (n := n) J) :=
  continuous_const.mul (continuous_bpPhi.comp (continuous_const_smul _))

/-- Helper: `φ_J` is smooth (complex form). -/
lemma contDiff_bpPhiDilC (J : ℤ) : ContDiff ℝ ∞ (bpPhiDilC (n := n) J) := by
  have : bpPhiDilC (n := n) J =
      fun x => ((2 : ℝ) ^ (-J)) ^ n • bpPhiS ((2 : ℝ) ^ (-J) • x) := funext (bpPhiDilC_eq J)
  rw [this]
  exact ((bpPhiS (n := n)).smooth ⊤ |>.comp (contDiff_const_smul _)).const_smul _

/-- Helper: scaling of derivatives, `‖D^k (c^n S(c ·))(x)‖ ≤ c^{n+k} ‖D^k S(c x)‖`. -/
lemma norm_iteratedFDeriv_dilate_le {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
    {S : EuclideanSpace ℝ (Fin n) → F} (hS : ContDiff ℝ ∞ S) (k : ℕ) {c : ℝ} (hc : 0 < c)
    (x : EuclideanSpace ℝ (Fin n)) :
    ‖iteratedFDeriv ℝ k (fun y => c ^ n • S (c • y)) x‖ ≤
      c ^ (n + k) * ‖iteratedFDeriv ℝ k S (c • x)‖ := by
  let L : EuclideanSpace ℝ (Fin n) →L[ℝ] EuclideanSpace ℝ (Fin n) :=
    c • ContinuousLinearMap.id ℝ _
  have hL : ‖L‖ ≤ c := by
    calc ‖L‖ ≤ ‖c‖ * ‖ContinuousLinearMap.id ℝ (EuclideanSpace ℝ (Fin n))‖ :=
          norm_smul_le c (ContinuousLinearMap.id ℝ (EuclideanSpace ℝ (Fin n)))
      _ ≤ ‖c‖ * 1 := by gcongr; exact ContinuousLinearMap.norm_id_le
      _ = c := by rw [mul_one, Real.norm_eq_abs, abs_of_pos hc]
  have hfun : (fun y => c ^ n • S (c • y)) = fun y => c ^ n • (S ∘ L) y := rfl
  have hcomp : ContDiff ℝ ∞ (S ∘ L) := hS.comp L.contDiff
  rw [hfun, iteratedFDeriv_const_smul_apply' (hcomp.of_le (by simp)).contDiffAt,
    L.iteratedFDeriv_comp_right hS x (by simp), norm_smul]
  calc ‖c ^ n‖ * ‖(iteratedFDeriv ℝ k S (L x)).compContinuousLinearMap fun _ => L‖
      ≤ c ^ n * (‖iteratedFDeriv ℝ k S (L x)‖ * ∏ _i : Fin k, ‖L‖) := by
        rw [Real.norm_eq_abs, abs_of_pos (by positivity)]
        gcongr
        exact ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _
    _ ≤ c ^ n * (‖iteratedFDeriv ℝ k S (L x)‖ * c ^ k) := by
        rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
        gcongr
    _ = c ^ (n + k) * ‖iteratedFDeriv ℝ k S (c • x)‖ := by
        rw [pow_add]; simp only [L, smul_apply, ContinuousLinearMap.id_apply]
        ring

/-- Helper: derivative bounds for the dilates, `‖D^k φ_J(x)‖ ≤ Q 2^{-J(n+k)} (1+|x|/2^J)^{-N}`
uniformly in `J ∈ ℤ`. -/
lemma norm_iteratedFDeriv_bpPhiDilC_le (k N : ℕ) :
    ∃ Q : ℝ, 0 ≤ Q ∧ ∀ (J : ℤ) (x : EuclideanSpace ℝ (Fin n)),
      ‖iteratedFDeriv ℝ k (bpPhiDilC J) x‖ ≤
        Q / (((2 : ℝ) ^ J) ^ (n + k) * (1 + ‖x‖ / 2 ^ J) ^ N) := by
  set Q := 2 ^ N * (Finset.Iic (N, k)).sup (fun m => SchwartzMap.seminorm ℝ m.1 m.2)
    (bpPhiS (n := n))
  have hQ : 0 ≤ Q := mul_nonneg (by positivity) (apply_nonneg _ _)
  refine ⟨Q, hQ, fun J x => ?_⟩
  set c : ℝ := (2 : ℝ) ^ (-J) with hc_def
  have hc : 0 < c := by positivity
  have hfun : bpPhiDilC (n := n) J = fun y => c ^ n • bpPhiS (c • y) := funext (bpPhiDilC_eq J)
  have h1 := norm_iteratedFDeriv_dilate_le ((bpPhiS (n := n)).smooth ⊤) k hc x
  rw [← hfun] at h1
  have h2 := SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℝ) (m := (N, k)) le_rfl le_rfl
    (bpPhiS (n := n)) (c • x)
  have hcx : ‖c • x‖ = ‖x‖ / 2 ^ J := by
    rw [norm_smul, Real.norm_of_nonneg hc.le, hc_def, zpow_neg, inv_mul_eq_div]
  rw [hcx] at h2
  have hpos : 0 < (1 + ‖x‖ / 2 ^ J) ^ N := by positivity
  have h3 : ‖iteratedFDeriv ℝ k (⇑bpPhiS) (c • x)‖ ≤ Q / (1 + ‖x‖ / 2 ^ J) ^ N := by
    rw [le_div_iff₀ hpos, mul_comm]; exact h2
  calc ‖iteratedFDeriv ℝ k (bpPhiDilC J) x‖ ≤ c ^ (n + k) * (Q / (1 + ‖x‖ / 2 ^ J) ^ N) :=
        h1.trans (mul_le_mul_of_nonneg_left h3 (by positivity))
    _ = Q / (((2 : ℝ) ^ J) ^ (n + k) * (1 + ‖x‖ / 2 ^ J) ^ N) := by
        rw [hc_def, zpow_neg, inv_pow]; field_simp

/-- Helper: `φ_J` is integrable. -/
lemma integrable_bpPhiDil (J : ℤ) : Integrable (bpPhiDil (n := n) J) := by
  have h := ((integrable_pow_mul_bpPhi (n := n) 0).comp_smul
    (show (2 : ℝ) ^ (-J) ≠ 0 by positivity)).const_mul ((2 : ℝ) ^ (-(J * n)))
  refine h.congr (Filter.Eventually.of_forall fun x => ?_)
  simp [bpPhiDil]

/-- Helper: `φ_J` is integrable (complex form). -/
lemma integrable_bpPhiDilC (J : ℤ) : Integrable (bpPhiDilC (n := n) J) :=
  (integrable_bpPhiDil J).ofReal

/-- Helper: `∫ φ_J = 1` (complex form). -/
lemma integral_bpPhiDilC (J : ℤ) : ∫ x, bpPhiDilC (n := n) J x = 1 := by
  simp only [bpPhiDilC, integral_complex_ofReal, integral_bpPhiDil, Complex.ofReal_one]

/-- Helper: `‖φ_J(x)‖ = φ_J(x)` (complex form). -/
lemma norm_bpPhiDilC (J : ℤ) (x : EuclideanSpace ℝ (Fin n)) :
    ‖bpPhiDilC J x‖ = bpPhiDil J x := by
  rw [bpPhiDilC, Complex.norm_real, Real.norm_of_nonneg (bpPhiDil_nonneg J x)]

/-- The weighted moments `∫ |u|^k (1 + |u|)^N φ(u) du` of `φ`. -/
noncomputable def bpMoment (n k N : ℕ) : ℝ :=
  ∫ u : EuclideanSpace ℝ (Fin n), ‖u‖ ^ k * (1 + ‖u‖) ^ N * bpPhi u

/-- Helper: `|u|^k (1 + |u|)^N φ(u)` is integrable. -/
lemma integrable_moment_bpPhi (k N : ℕ) :
    Integrable (fun u : EuclideanSpace ℝ (Fin n) => ‖u‖ ^ k * (1 + ‖u‖) ^ N * bpPhi u) := by
  refine (((integrable_pow_mul_bpPhi k).add (integrable_pow_mul_bpPhi (k + N))).const_mul
    (2 ^ N)).mono'
    (((continuous_norm.pow k).mul ((continuous_const.add continuous_norm).pow N)).mul
      continuous_bpPhi).aestronglyMeasurable (Filter.Eventually.of_forall fun u => ?_)
  have hφ := bpPhi_nonneg u
  have h1 : (1 + ‖u‖) ^ N ≤ 2 ^ N * (1 + ‖u‖ ^ N) := by
    rcases le_total ‖u‖ 1 with h | h
    · calc (1 + ‖u‖) ^ N ≤ 2 ^ N := pow_le_pow_left₀ (by positivity) (by linarith) _
        _ ≤ 2 ^ N * (1 + ‖u‖ ^ N) := by
          have : 0 ≤ ‖u‖ ^ N := by positivity
          nlinarith [pow_pos (show (0:ℝ) < 2 by norm_num) N]
    · calc (1 + ‖u‖) ^ N ≤ (2 * ‖u‖) ^ N := pow_le_pow_left₀ (by positivity) (by linarith) _
        _ = 2 ^ N * ‖u‖ ^ N := mul_pow _ _ _
        _ ≤ 2 ^ N * (1 + ‖u‖ ^ N) := by
          nlinarith [pow_pos (show (0:ℝ) < 2 by norm_num) N]
  rw [Real.norm_of_nonneg (by positivity)]
  calc ‖u‖ ^ k * (1 + ‖u‖) ^ N * bpPhi u ≤ ‖u‖ ^ k * (2 ^ N * (1 + ‖u‖ ^ N)) * bpPhi u := by
        gcongr
    _ = 2 ^ N * (‖u‖ ^ k * bpPhi u + ‖u‖ ^ (k + N) * bpPhi u) := by ring

/-- Helper: `bpMoment n k N ≥ 0`. -/
lemma bpMoment_nonneg (k N : ℕ) : 0 ≤ bpMoment n k N :=
  integral_nonneg fun u => mul_nonneg (by positivity) (bpPhi_nonneg u)

/-- Helper: scaling of the moments,
`∫ |z|^k (1 + |z|/2^J)^N φ_J(z) dz = 2^{Jk} ∫ |u|^k (1 + |u|)^N φ(u) du`, with integrability. -/
lemma integral_moment_bpPhiDil (J : ℤ) (k N : ℕ) :
    Integrable (fun z : EuclideanSpace ℝ (Fin n) =>
        ‖z‖ ^ k * (1 + ‖z‖ / 2 ^ J) ^ N * bpPhiDil J z) ∧
      ∫ z : EuclideanSpace ℝ (Fin n), ‖z‖ ^ k * (1 + ‖z‖ / 2 ^ J) ^ N * bpPhiDil J z =
        ((2 : ℝ) ^ J) ^ k * bpMoment n k N := by
  set c : ℝ := (2 : ℝ) ^ (-J) with hc_def
  have hc : 0 < c := by positivity
  have hcR : c * 2 ^ J = 1 := by rw [hc_def, zpow_neg, inv_mul_cancel₀ (by positivity)]
  let g : EuclideanSpace ℝ (Fin n) → ℝ := fun u =>
    ((2 : ℝ) ^ J) ^ k * c ^ n * (‖u‖ ^ k * (1 + ‖u‖) ^ N * bpPhi u)
  have hfun : (fun z : EuclideanSpace ℝ (Fin n) =>
      ‖z‖ ^ k * (1 + ‖z‖ / 2 ^ J) ^ N * bpPhiDil J z) = fun z => g (c • z) := by
    funext z
    have h1 : ‖c • z‖ = ‖z‖ / 2 ^ J := by
      rw [norm_smul, Real.norm_of_nonneg hc.le, hc_def, zpow_neg, inv_mul_eq_div]
    simp only [g, bpPhiDil, two_zpow_neg_mul_natCast_eq_pow, ← hc_def]
    rw [h1, div_pow]
    field_simp
  have hg : Integrable g := (integrable_moment_bpPhi k N).const_mul _
  refine ⟨?_, ?_⟩
  · rw [hfun]; exact hg.comp_smul hc.ne'
  · rw [hfun, Measure.integral_comp_smul, finrank_euclideanSpace_fin, smul_eq_mul,
      integral_const_mul, bpMoment, abs_of_pos (by positivity)]
    have : (c ^ n)⁻¹ * c ^ n = 1 := inv_mul_cancel₀ (by positivity)
    calc (c ^ n)⁻¹ * (((2 : ℝ) ^ J) ^ k * c ^ n *
          ∫ u : EuclideanSpace ℝ (Fin n), ‖u‖ ^ k * (1 + ‖u‖) ^ N * bpPhi u)
        = ((c ^ n)⁻¹ * c ^ n) * (((2 : ℝ) ^ J) ^ k *
          ∫ u : EuclideanSpace ℝ (Fin n), ‖u‖ ^ k * (1 + ‖u‖) ^ N * bpPhi u) := by ring
      _ = _ := by rw [this, one_mul]

section Taylor
variable {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]

/-- Helper: first-order mean value bound along the segment `[x, x - z]`. -/
lemma norm_sub_le_of_norm_fderiv_segment {f : EuclideanSpace ℝ (Fin n) → F}
    (hf : Differentiable ℝ f) {x z : EuclideanSpace ℝ (Fin n)} {M : ℝ}
    (hM : ∀ t ∈ Icc (0 : ℝ) 1, ‖fderiv ℝ f (x - t • z)‖ ≤ M) {s : ℝ} (hs : s ∈ Icc (0 : ℝ) 1) :
    ‖f (x - s • z) - f x‖ ≤ M * ‖z‖ * s := by
  have hd : ∀ t : ℝ, HasDerivAt (fun t : ℝ => f (x - t • z)) (fderiv ℝ f (x - t • z) (-z)) t := by
    intro t
    have h1 : HasDerivAt (fun t : ℝ => x - t • z) (-z) t := by
      simpa using ((hasDerivAt_id t).smul_const z).const_sub x
    exact (hf _).hasFDerivAt.comp_hasDerivAt t h1
  have := norm_image_sub_le_of_norm_deriv_le_segment' (f := fun t : ℝ => f (x - t • z))
    (a := 0) (b := 1) (C := M * ‖z‖) (fun t _ => (hd t).hasDerivWithinAt) (fun t ht => ?_) s hs
  · simpa using this
  · refine (ContinuousLinearMap.le_opNorm _ _).trans ?_
    rw [norm_neg]
    exact mul_le_mul_of_nonneg_right (hM t (Ico_subset_Icc_self ht)) (norm_nonneg _)

/-- Helper: second-order Taylor bound
`‖f(x - z) - f(x) + Df(x) z‖ ≤ M |z|²` if `‖D²f‖ ≤ M` on the segment `[x, x - z]`. -/
lemma norm_taylor_two_le {f : EuclideanSpace ℝ (Fin n) → F} (hf : ContDiff ℝ 2 f)
    {x z : EuclideanSpace ℝ (Fin n)} {M : ℝ}
    (hM : ∀ t ∈ Icc (0 : ℝ) 1, ‖iteratedFDeriv ℝ 2 f (x - t • z)‖ ≤ M) :
    ‖f (x - z) - f x + fderiv ℝ f x z‖ ≤ M * ‖z‖ ^ 2 := by
  have hdf : Differentiable ℝ f := hf.differentiable (by norm_num)
  have hdf' : Differentiable ℝ (fderiv ℝ f) :=
    (hf.fderiv_right (m := 1) (by norm_num)).differentiable (by norm_num)
  have hM' : ∀ t ∈ Icc (0 : ℝ) 1, ‖fderiv ℝ (fderiv ℝ f) (x - t • z)‖ ≤ M := by
    intro t ht
    rw [← norm_iteratedFDeriv_one, norm_iteratedFDeriv_fderiv]
    exact hM t ht
  have hstep : ∀ s ∈ Icc (0 : ℝ) 1, ‖fderiv ℝ f (x - s • z) - fderiv ℝ f x‖ ≤ M * ‖z‖ :=
    fun s hs => (norm_sub_le_of_norm_fderiv_segment hdf' hM' hs).trans
      (by
        have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM 0 (by simp))
        have : M * ‖z‖ * s ≤ M * ‖z‖ * 1 :=
          mul_le_mul_of_nonneg_left hs.2 (by positivity)
        linarith)
  let g : ℝ → F := fun t => f (x - t • z) + t • fderiv ℝ f x z
  have hd : ∀ t : ℝ, HasDerivAt g (fderiv ℝ f (x - t • z) (-z) + fderiv ℝ f x z) t := by
    intro t
    have h1 : HasDerivAt (fun t : ℝ => x - t • z) (-z) t := by
      simpa using ((hasDerivAt_id t).smul_const z).const_sub x
    have h2 := (hdf _).hasFDerivAt.comp_hasDerivAt t h1
    have h3 : HasDerivAt (fun t : ℝ => t • fderiv ℝ f x z) ((1 : ℝ) • fderiv ℝ f x z) t :=
      (hasDerivAt_id t).smul_const _
    rw [one_smul] at h3
    exact h2.add h3
  have := norm_image_sub_le_of_norm_deriv_le_segment' (f := g) (a := 0) (b := 1)
    (C := M * ‖z‖ ^ 2) (fun t _ => (hd t).hasDerivWithinAt) (fun t ht => ?_) 1 (by simp)
  · simpa [g, sub_eq_add_neg, add_comm, add_left_comm, add_assoc] using this
  · have : fderiv ℝ f (x - t • z) (-z) + fderiv ℝ f x z =
        (fderiv ℝ f x - fderiv ℝ f (x - t • z)) z := by
      rw [show (fderiv ℝ f x - fderiv ℝ f (x - t • z)) z =
        fderiv ℝ f x z - fderiv ℝ f (x - t • z) z from rfl, map_neg]; abel
    rw [this]
    refine (ContinuousLinearMap.le_opNorm _ _).trans ?_
    rw [norm_sub_rev, pow_two, ← mul_assoc]
    exact mul_le_mul_of_nonneg_right (hstep t (Ico_subset_Icc_self ht)) (norm_nonneg _)

end Taylor

/-- Helper: Peetre's inequality in the form
`(1 + |x - t z|/ρ)^{-N} ≤ (1 + |z|/R)^N (1 + |x|/ρ)^{-N}` for `0 < R ≤ ρ`, `t ∈ [0,1]`. -/
lemma inv_one_add_pow_le {R ρ : ℝ} (hR : 0 < R) (hRρ : R ≤ ρ) (N : ℕ)
    (x z : EuclideanSpace ℝ (Fin n)) {t : ℝ} (ht : t ∈ Icc (0 : ℝ) 1) :
    1 / (1 + ‖x - t • z‖ / ρ) ^ N ≤ (1 + ‖z‖ / R) ^ N / (1 + ‖x‖ / ρ) ^ N := by
  have hρ : 0 < ρ := hR.trans_le hRρ
  have h1 : ‖x‖ ≤ ‖x - t • z‖ + t * ‖z‖ := by
    have := norm_le_norm_add_norm_sub' x (t • z)
    rw [norm_sub_rev] at this
    have h := norm_le_norm_sub_add x (t • z)
    rw [norm_smul, Real.norm_of_nonneg ht.1] at h
    linarith
  have h2 : t * ‖z‖ / ρ ≤ ‖z‖ / R := by
    rw [div_le_div_iff₀ hρ hR]
    have : t * ‖z‖ * R ≤ 1 * ‖z‖ * R :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right ht.2 (norm_nonneg _)) hR.le
    nlinarith [norm_nonneg z]
  have key : 1 + ‖x‖ / ρ ≤ (1 + ‖x - t • z‖ / ρ) * (1 + ‖z‖ / R) := by
    have h3 : ‖x‖ / ρ ≤ ‖x - t • z‖ / ρ + t * ‖z‖ / ρ := by
      rw [← add_div]; exact div_le_div_of_nonneg_right h1 hρ.le
    have : 0 ≤ ‖x - t • z‖ / ρ * (‖z‖ / R) := by positivity
    nlinarith
  rw [div_le_div_iff₀ (by positivity) (by positivity), one_mul, ← mul_pow]
  exact pow_le_pow_left₀ (by positivity) (key.trans_eq (mul_comm _ _)) _

section Convolution
variable {F : Type*} [NormedAddCommGroup F] [NormedSpace ℂ F]

/-- Helper: differentiation under the integral sign for `x ↦ ∫ g(t) h(x - t) dt` with `g`
integrable and `h` of class `C¹` with bounded values and derivative. -/
lemma hasFDerivAt_integral_smul_sub [CompleteSpace F] {g : EuclideanSpace ℝ (Fin n) → ℂ}
    (hg : Integrable g) {h : EuclideanSpace ℝ (Fin n) → F} (hh : ContDiff ℝ 1 h) {M0 M1 : ℝ}
    (hh0 : ∀ v, ‖h v‖ ≤ M0) (hh1 : ∀ v, ‖fderiv ℝ h v‖ ≤ M1) (x : EuclideanSpace ℝ (Fin n)) :
    HasFDerivAt (fun x => ∫ t, g t • h (x - t)) (∫ t, g t • fderiv ℝ h (x - t)) x := by
  have hc : Continuous h := hh.continuous
  have hc' : Continuous (fderiv ℝ h) := hh.continuous_fderiv (by norm_num)
  refine hasFDerivAt_integral_of_dominated_of_fderiv_le (𝕜 := ℝ) (μ := volume)
    (F := fun x t => g t • h (x - t)) (F' := fun x t => g t • fderiv ℝ h (x - t)) (s := univ)
    (bound := fun t => ‖g t‖ * M1)
    Filter.univ_mem (Filter.Eventually.of_forall fun y => ?_) ?_ ?_ ?_ (hg.norm.mul_const M1) ?_
  · exact hg.aestronglyMeasurable.smul
      (hc.comp (continuous_const.sub continuous_id)).aestronglyMeasurable
  · refine (hg.norm.mul_const M0).mono'
      (hg.aestronglyMeasurable.smul
        (hc.comp (continuous_const.sub continuous_id)).aestronglyMeasurable)
      (Filter.Eventually.of_forall fun t => ?_)
    rw [norm_smul]; exact mul_le_mul_of_nonneg_left (hh0 _) (norm_nonneg _)
  · exact hg.aestronglyMeasurable.smul
      (hc'.comp (continuous_const.sub continuous_id)).aestronglyMeasurable
  · refine Filter.Eventually.of_forall fun t y _ => ?_
    rw [norm_smul]; exact mul_le_mul_of_nonneg_left (hh1 _) (norm_nonneg _)
  · refine Filter.Eventually.of_forall fun t y _ => ?_
    have h1 := (hh.differentiable (by norm_num) (y - t)).hasFDerivAt.comp y
      ((hasFDerivAt_id y).sub_const t)
    have h2 := h1.const_smul (g t)
    rw [ContinuousLinearMap.comp_id] at h2
    exact h2

/-- Helper: continuity of `x ↦ ∫ g(t) h(x - t) dt` for integrable `g` and bounded continuous
`h`. -/
lemma continuous_integral_smul_sub [CompleteSpace F] {g : EuclideanSpace ℝ (Fin n) → ℂ}
    (hg : Integrable g) {h : EuclideanSpace ℝ (Fin n) → F} (hc : Continuous h) {M0 : ℝ}
    (hh0 : ∀ v, ‖h v‖ ≤ M0) : Continuous (fun x => ∫ t, g t • h (x - t)) := by
  refine continuous_of_dominated (bound := fun t => ‖g t‖ * M0) (fun y => ?_) (fun y => ?_)
    (hg.norm.mul_const M0) (Filter.Eventually.of_forall fun t => ?_)
  · exact hg.aestronglyMeasurable.smul
      (hc.comp (continuous_const.sub continuous_id)).aestronglyMeasurable
  · refine Filter.Eventually.of_forall fun t => ?_
    rw [norm_smul]; exact mul_le_mul_of_nonneg_left (hh0 _) (norm_nonneg _)
  · exact continuous_const.smul (hc.comp (continuous_id.sub continuous_const))

end Convolution

section Smoothing
variable {F : Type*} [NormedAddCommGroup F] [NormedSpace ℂ F]

/-- Helper: the first moments of `φ_J` vanish against any linear map,
`∫ φ_J(z) L(z) dz = 0` (`φ_J` is even). -/
lemma integral_bpPhiDilC_smul_clm [CompleteSpace F] (J : ℤ) (L : EuclideanSpace ℝ (Fin n) →L[ℝ] F) :
    ∫ z, bpPhiDilC J z • L z = 0 := by
  have h := integral_neg_eq_self (fun z => bpPhiDilC J z • L z) volume
  have hodd : ∀ z, bpPhiDilC J (-z) • L (-z) = -(bpPhiDilC J z • L z) := by
    intro z; rw [bpPhiDilC, bpPhiDil_neg, map_neg, smul_neg]; rfl
  simp only [hodd, integral_neg] at h
  set I := ∫ z, bpPhiDilC J z • L z
  have h2 : (2 : ℂ) • I = 0 := by
    rw [two_smul]; nth_rewrite 1 [← h]; exact neg_add_cancel I
  exact (smul_eq_zero.1 h2).resolve_left two_ne_zero

/-- Helper: `z ↦ φ_J(z) T(x - z)` is integrable for bounded continuous `T`. -/
lemma integrable_bpPhiDilC_smul_sub {T : EuclideanSpace ℝ (Fin n) → F} (hT : Continuous T)
    {M0 : ℝ} (hT0 : ∀ w, ‖T w‖ ≤ M0) (J : ℤ) (x : EuclideanSpace ℝ (Fin n)) :
    Integrable (fun z => bpPhiDilC J z • T (x - z)) := by
  refine ((integrable_bpPhiDilC J).norm.mul_const M0).mono'
    ((integrable_bpPhiDilC J).aestronglyMeasurable.smul
      (hT.comp (continuous_const.sub continuous_id)).aestronglyMeasurable)
    (Filter.Eventually.of_forall fun z => ?_)
  rw [norm_smul]; exact mul_le_mul_of_nonneg_left (hT0 _) (norm_nonneg _)

/-- Helper: `z ↦ φ_J(z) L(z)` is integrable for a continuous linear map `L`. -/
lemma integrable_bpPhiDilC_smul_clm (J : ℤ) (L : EuclideanSpace ℝ (Fin n) →L[ℝ] F) :
    Integrable (fun z => bpPhiDilC J z • L z) := by
  refine ((integral_moment_bpPhiDil J 1 0).1.const_mul ‖L‖).mono'
    ((integrable_bpPhiDilC J).aestronglyMeasurable.smul L.continuous.aestronglyMeasurable)
    (Filter.Eventually.of_forall fun z => ?_)
  rw [norm_smul, norm_bpPhiDilC]
  have := L.le_opNorm z
  have hφ := bpPhiDil_nonneg J z
  simp only [pow_one, pow_zero, mul_one]
  nlinarith

/-- Helper: `a ≥ 0` if some norm is bounded by `a / (1 + r)^N`. -/
lemma nonneg_of_norm_le_div {G : Type*} [NormedAddCommGroup G] {a r : ℝ} {N : ℕ} (hr : 0 ≤ r)
    {y : G}
    (h : ‖y‖ ≤ a / (1 + r) ^ N) : 0 ≤ a := by
  have hp : 0 < (1 + r) ^ N := by positivity
  have := mul_nonneg ((norm_nonneg _).trans h) hp.le
  rwa [div_mul_cancel₀ _ hp.ne'] at this

/-- Helper (first-order smoothing error): if `‖DT(w)‖ ≤ a (1 + |w|/ρ)^{-N}` with
`2^J ≤ ρ`, then `‖T(x) - (φ_J * T)(x)‖ ≤ a (1 + |x|/ρ)^{-N} 2^J M_{1,N}`. -/
lemma norm_sub_integral_bpPhiDilC_smul_le_one [CompleteSpace F] {T : EuclideanSpace ℝ (Fin n) → F}
    (hT : ContDiff ℝ 1 T) {M0 : ℝ} (hT0 : ∀ w, ‖T w‖ ≤ M0) (J : ℤ) {ρ a : ℝ}
    (hρ : (2 : ℝ) ^ J ≤ ρ) {N : ℕ}
    (hT1 : ∀ w, ‖fderiv ℝ T w‖ ≤ a / (1 + ‖w‖ / ρ) ^ N) (x : EuclideanSpace ℝ (Fin n)) :
    ‖T x - ∫ z, bpPhiDilC J z • T (x - z)‖ ≤
      a / (1 + ‖x‖ / ρ) ^ N * ((2 : ℝ) ^ J * bpMoment n 1 N) := by
  have hR : (0 : ℝ) < 2 ^ J := by positivity
  have hρ0 : 0 < ρ := hR.trans_le hρ
  have ha : 0 ≤ a := nonneg_of_norm_le_div (by positivity) (hT1 0)
  have hi1 := integrable_bpPhiDilC_smul_sub hT.continuous hT0 J x
  have hi2 := (integrable_bpPhiDilC (n := n) J).smul_const (T x)
  have h1 : ∫ z : EuclideanSpace ℝ (Fin n), bpPhiDilC J z • T x = T x := by
    rw [integral_smul_const, integral_bpPhiDilC, one_smul]
  have hrem : T x - ∫ z, bpPhiDilC J z • T (x - z) =
      ∫ z, bpPhiDilC J z • (T x - T (x - z)) := by
    simp_rw [smul_sub]; rw [integral_sub hi2 hi1, h1]
  rw [hrem]
  have hmom := integral_moment_bpPhiDil (n := n) J 1 N
  have hb : ∀ z, ‖bpPhiDilC J z • (T x - T (x - z))‖ ≤
      a / (1 + ‖x‖ / ρ) ^ N * (‖z‖ ^ 1 * (1 + ‖z‖ / 2 ^ J) ^ N * bpPhiDil J z) := by
    intro z
    rw [norm_smul, norm_bpPhiDilC]
    have hM : ∀ t ∈ Icc (0 : ℝ) 1, ‖fderiv ℝ T (x - t • z)‖ ≤
        a * ((1 + ‖z‖ / 2 ^ J) ^ N / (1 + ‖x‖ / ρ) ^ N) := by
      intro t ht
      refine (hT1 _).trans ?_
      rw [div_eq_mul_one_div a]
      exact mul_le_mul_of_nonneg_left (inv_one_add_pow_le hR hρ N x z ht) ha
    have h := norm_sub_le_of_norm_fderiv_segment (hT.differentiable (by norm_num)) hM
      (s := 1) (by simp)
    rw [one_smul, norm_sub_rev] at h
    have hφ := bpPhiDil_nonneg J z
    calc bpPhiDil J z * ‖T x - T (x - z)‖
        ≤ bpPhiDil J z * (a * ((1 + ‖z‖ / 2 ^ J) ^ N / (1 + ‖x‖ / ρ) ^ N) * ‖z‖ * 1) :=
          mul_le_mul_of_nonneg_left h hφ
      _ = _ := by ring
  refine (norm_integral_le_of_norm_le (hmom.1.const_mul _) (Filter.Eventually.of_forall hb)).trans
    (le_of_eq ?_)
  rw [integral_const_mul, hmom.2, pow_one]

/-- Helper (second-order smoothing error): if `‖D²T(w)‖ ≤ a (1 + |w|/ρ)^{-N}` with
`2^J ≤ ρ`, then `‖T(x) - (φ_J * T)(x)‖ ≤ a (1 + |x|/ρ)^{-N} 2^{2J} M_{2,N}` (Taylor's formula
and the vanishing first moments of `φ_J`). -/
lemma norm_sub_integral_bpPhiDilC_smul_le_two [CompleteSpace F] {T : EuclideanSpace ℝ (Fin n) → F}
    (hT : ContDiff ℝ 2 T) {M0 : ℝ} (hT0 : ∀ w, ‖T w‖ ≤ M0) (J : ℤ) {ρ a : ℝ}
    (hρ : (2 : ℝ) ^ J ≤ ρ) {N : ℕ}
    (hT2 : ∀ w, ‖iteratedFDeriv ℝ 2 T w‖ ≤ a / (1 + ‖w‖ / ρ) ^ N)
    (x : EuclideanSpace ℝ (Fin n)) :
    ‖T x - ∫ z, bpPhiDilC J z • T (x - z)‖ ≤
      a / (1 + ‖x‖ / ρ) ^ N * (((2 : ℝ) ^ J) ^ 2 * bpMoment n 2 N) := by
  have hR : (0 : ℝ) < 2 ^ J := by positivity
  have hρ0 : 0 < ρ := hR.trans_le hρ
  have ha : 0 ≤ a := nonneg_of_norm_le_div (by positivity) (hT2 0)
  set D := fderiv ℝ T x
  have hi1 := integrable_bpPhiDilC_smul_sub hT.continuous hT0 J x
  have hi2 := (integrable_bpPhiDilC (n := n) J).smul_const (T x)
  have hi3 := integrable_bpPhiDilC_smul_clm J D
  have h1 : ∫ z : EuclideanSpace ℝ (Fin n), bpPhiDilC J z • T x = T x := by
    rw [integral_smul_const, integral_bpPhiDilC, one_smul]
  have hrem : T x - ∫ z, bpPhiDilC J z • T (x - z) =
      -∫ z, bpPhiDilC J z • (T (x - z) - T x + D z) := by
    have e : ∀ z, bpPhiDilC J z • (T (x - z) - T x + D z) =
        (bpPhiDilC J z • T (x - z) - bpPhiDilC J z • T x) + bpPhiDilC J z • D z := fun z => by
      rw [smul_add, smul_sub]
    have hsum : ∫ z, (bpPhiDilC J z • T (x - z) - bpPhiDilC J z • T x + bpPhiDilC J z • D z) =
        (∫ z, bpPhiDilC J z • T (x - z)) - T x := by
      have := integral_add (hi1.sub hi2) hi3
      simp only [Pi.sub_apply] at this
      rw [this, integral_sub hi1 hi2, h1, integral_bpPhiDilC_smul_clm, add_zero]
    simp_rw [e]
    rw [hsum]
    abel
  rw [hrem, norm_neg]
  have hmom := integral_moment_bpPhiDil (n := n) J 2 N
  have hb : ∀ z, ‖bpPhiDilC J z • (T (x - z) - T x + D z)‖ ≤
      a / (1 + ‖x‖ / ρ) ^ N * (‖z‖ ^ 2 * (1 + ‖z‖ / 2 ^ J) ^ N * bpPhiDil J z) := by
    intro z
    rw [norm_smul, norm_bpPhiDilC]
    have hM : ∀ t ∈ Icc (0 : ℝ) 1, ‖iteratedFDeriv ℝ 2 T (x - t • z)‖ ≤
        a * ((1 + ‖z‖ / 2 ^ J) ^ N / (1 + ‖x‖ / ρ) ^ N) := by
      intro t ht
      refine (hT2 _).trans ?_
      rw [div_eq_mul_one_div a]
      exact mul_le_mul_of_nonneg_left (inv_one_add_pow_le hR hρ N x z ht) ha
    have h := norm_taylor_two_le hT hM
    have hφ := bpPhiDil_nonneg J z
    calc bpPhiDil J z * ‖T (x - z) - T x + D z‖
        ≤ bpPhiDil J z * (a * ((1 + ‖z‖ / 2 ^ J) ^ N / (1 + ‖x‖ / ρ) ^ N) * ‖z‖ ^ 2) :=
          mul_le_mul_of_nonneg_left h hφ
      _ = _ := by ring
  refine (norm_integral_le_of_norm_le (hmom.1.const_mul _) (Filter.Eventually.of_forall hb)).trans
    (le_of_eq ?_)
  rw [integral_const_mul, hmom.2]

/-- Helper (cancellation against a mean-zero kernel): if `L` is integrable, vanishes for
`|w| > R` and has integral zero, and `‖Dh(v)‖ ≤ b (1 + |v|/R)^{-N}`, then
`‖∫ L(w) h(x - w) dw‖ ≤ b 2^N (1 + |x|/R)^{-N} ∫ |w| |L(w)| dw`. -/
lemma norm_integral_smul_sub_le_of_integral_eq_zero [CompleteSpace F]
    {L : EuclideanSpace ℝ (Fin n) → ℂ}
    (hL : Integrable L) {R : ℝ} (hR : 0 < R) (hLs : ∀ w, R < ‖w‖ → L w = 0)
    (hL0 : ∫ w, L w = 0) {h : EuclideanSpace ℝ (Fin n) → F} (hh : ContDiff ℝ 1 h) {M0 : ℝ}
    (hh0 : ∀ v, ‖h v‖ ≤ M0) {b : ℝ} {N : ℕ} (hh1 : ∀ v, ‖fderiv ℝ h v‖ ≤ b / (1 + ‖v‖ / R) ^ N)
    (x : EuclideanSpace ℝ (Fin n)) :
    Integrable (fun w => ‖w‖ * ‖L w‖) ∧
    ‖∫ w, L w • h (x - w)‖ ≤ b * 2 ^ N / (1 + ‖x‖ / R) ^ N * ∫ w, ‖w‖ * ‖L w‖ := by
  have hb : 0 ≤ b := nonneg_of_norm_le_div (by positivity) (hh1 0)
  have hwL : ∀ w, ‖w‖ * ‖L w‖ ≤ R * ‖L w‖ := by
    intro w
    rcases le_or_gt ‖w‖ R with hw | hw
    · exact mul_le_mul_of_nonneg_right hw (norm_nonneg _)
    · rw [hLs w hw, norm_zero, mul_zero, mul_zero]
  have hint : Integrable (fun w => ‖w‖ * ‖L w‖) :=
    (hL.norm.const_mul R).mono' (continuous_norm.aestronglyMeasurable.mul hL.norm.1)
      (Filter.Eventually.of_forall fun w => by
        rw [Real.norm_of_nonneg (by positivity)]; exact hwL w)
  refine ⟨hint, ?_⟩
  have hi1 : Integrable (fun w => L w • h (x - w)) := by
    refine (hL.norm.mul_const M0).mono'
      (hL.aestronglyMeasurable.smul
        (hh.continuous.comp (continuous_const.sub continuous_id)).aestronglyMeasurable)
      (Filter.Eventually.of_forall fun z => ?_)
    rw [norm_smul]; exact mul_le_mul_of_nonneg_left (hh0 _) (norm_nonneg _)
  have hi2 : Integrable (fun w => L w • h x) := hL.smul_const _
  have h0 : ∫ w : EuclideanSpace ℝ (Fin n), L w • h x = 0 := by
    rw [integral_smul_const, hL0, zero_smul]
  have heq : ∫ w, L w • h (x - w) = ∫ w, L w • (h (x - w) - h x) := by
    simp_rw [smul_sub]; rw [integral_sub hi1 hi2, h0, sub_zero]
  rw [heq]
  have hbd : ∀ w, ‖L w • (h (x - w) - h x)‖ ≤ b * 2 ^ N / (1 + ‖x‖ / R) ^ N * (‖w‖ * ‖L w‖) := by
    intro w
    rw [norm_smul]
    rcases le_or_gt ‖w‖ R with hw | hw
    · have hM : ∀ t ∈ Icc (0 : ℝ) 1, ‖fderiv ℝ h (x - t • w)‖ ≤ b * 2 ^ N / (1 + ‖x‖ / R) ^ N := by
        intro t ht
        refine (hh1 _).trans ?_
        have h1 := inv_one_add_pow_le hR le_rfl N x w ht
        have h2 : (1 + ‖w‖ / R) ^ N ≤ 2 ^ N := by
          apply pow_le_pow_left₀ (by positivity)
          have : ‖w‖ / R ≤ 1 := by rw [div_le_one hR]; exact hw
          linarith
        calc b / (1 + ‖x - t • w‖ / R) ^ N = b * (1 / (1 + ‖x - t • w‖ / R) ^ N) := by ring
          _ ≤ b * ((1 + ‖w‖ / R) ^ N / (1 + ‖x‖ / R) ^ N) := mul_le_mul_of_nonneg_left h1 hb
          _ ≤ b * (2 ^ N / (1 + ‖x‖ / R) ^ N) := by gcongr
          _ = _ := by ring
      have hmv := norm_sub_le_of_norm_fderiv_segment (hh.differentiable (by norm_num)) hM
        (s := 1) (by simp)
      rw [one_smul] at hmv
      calc ‖L w‖ * ‖h (x - w) - h x‖ ≤ ‖L w‖ * (b * 2 ^ N / (1 + ‖x‖ / R) ^ N * ‖w‖ * 1) :=
            mul_le_mul_of_nonneg_left hmv (norm_nonneg _)
        _ = _ := by ring
    · rw [hLs w hw, norm_zero, zero_mul, mul_zero, mul_zero]
  refine (norm_integral_le_of_norm_le (hint.const_mul _) (Filter.Eventually.of_forall hbd)).trans
    (le_of_eq ?_)
  rw [integral_const_mul]

end Smoothing

/-! ### The smoothing errors `E_J` -/

/-- The kernel `𝒦 = (1 - η) K` of the multiplier `m_K` (Blueprint Lemma 4.3, `lem:signedK`). -/
noncomputable def symbolKernel (Ω : EuclideanSpace ℝ (Fin n) → ℂ)
    (x : EuclideanSpace ℝ (Fin n)) : ℂ :=
  ((1 - dyadicEta x : ℝ) : ℂ) * swKernel Ω x

/-- The smoothing errors `E_J = ∑_{j ≥ J} K_j - φ_J * 𝒦` of Blueprint Lemma 4.5
(`lem:smootherrors`), where `𝒦 = (1 - η) K` and `φ_J * 𝒦 (x) = ∫ φ_J(t) 𝒦(x - t) dt`. -/
noncomputable def smoothErr (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (J : ℤ) :
    EuclideanSpace ℝ (Fin n) → ℂ :=
  truncKernel Ω J - bpPhiDilC J ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] symbolKernel Ω

/-- Helper: `(φ_J * g)(x) = ∫ φ_J(t) g(x - t) dt`. -/
lemma bpPhiDilC_convolution_apply (J : ℤ) (g : EuclideanSpace ℝ (Fin n) → ℂ)
    (x : EuclideanSpace ℝ (Fin n)) :
    (bpPhiDilC J ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] g) x =
      ∫ t, bpPhiDilC J t • g (x - t) := by
  rw [convolution_def]; simp only [ContinuousLinearMap.mul_apply', smul_eq_mul]

/-- Helper: `∫ φ(t) g(x - t) dt = ∫ g(w) φ(x - w) dw` (change of variables). -/
lemma integral_smul_sub_comm (φ g : EuclideanSpace ℝ (Fin n) → ℂ)
    (x : EuclideanSpace ℝ (Fin n)) :
    ∫ t, φ t • g (x - t) = ∫ w, g w • φ (x - w) := by
  rw [← integral_sub_left_eq_self (fun w => g w • φ (x - w)) volume x]
  simp only [sub_sub_cancel, smul_eq_mul, mul_comm]

/-- Helper: `𝒦 = ∑_{j ≥ 1} K_j`, split at `J ≥ 1`: `𝒦 = ∑_{j ≥ J} K_j + ∑_{1 ≤ j < J} K_j`. -/
lemma symbolKernel_eq_truncKernel_add {J : ℤ} (hJ : 1 ≤ J) (w : EuclideanSpace ℝ (Fin n)) :
    symbolKernel Ω w = truncKernel Ω J w + ∑ j ∈ Finset.Ico 1 J, dyadicKernel Ω j w := by
  obtain ⟨k, rfl⟩ : ∃ k : ℕ, J = k + 1 := ⟨(J - 1).toNat, by omega⟩
  have hs := hasSum_dyadicKernel (Ω := Ω) w
  have hIco : Finset.Ico (1 : ℤ) ((k : ℤ) + 1) = (Finset.range k).map succIntEmb := by
    ext j
    simp only [Finset.mem_Ico, Finset.mem_map, Finset.mem_range]
    constructor
    · rintro ⟨h1, h2⟩
      refine ⟨(j - 1).toNat, by omega, ?_⟩
      show ((j - 1).toNat : ℤ) + 1 = j
      omega
    · rintro ⟨i, hi, rfl⟩
      show 1 ≤ (i : ℤ) + 1 ∧ (i : ℤ) + 1 < k + 1
      omega
  rw [hIco, Finset.sum_map, symbolKernel, ← hs.tsum_eq,
    ← hs.summable.sum_add_tsum_nat_add k, add_comm]
  congr 1
  unfold truncKernel
  congr 1; ext i; congr 1; push_cast; ring

/-- Helper: `K_j` is bounded, `‖K_j‖ ≤ C 2^{-jn}`, and `‖DK_j‖ ≤ C 2^{-j(n+1)}`. -/
lemma norm_fderiv_dyadicKernel_le (hΩ : IsSWProfile Ω) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (j : ℤ) (x : EuclideanSpace ℝ (Fin n)),
      ‖fderiv ℝ (dyadicKernel Ω j) x‖ ≤ C * (2 : ℝ) ^ (-j * ((n : ℤ) + 1)) := by
  obtain ⟨C, hC⟩ := norm_iteratedFDeriv_dyadicKernel_le hΩ 1
  have hC0 : 0 ≤ C := by
    have h := (norm_nonneg _).trans (hC 0 0)
    exact nonneg_of_mul_nonneg_left h (by positivity)
  refine ⟨C, hC0, fun j x => ?_⟩
  have := hC j x
  rwa [norm_iteratedFDeriv_one, Nat.cast_one] at this

/-- Helper: `A / (R + r)^m = (A / R^m) / (1 + r/R)^m` for `R > 0`. -/
lemma div_add_pow_eq {A R : ℝ} (r : ℝ) (hR : 0 < R) (m : ℕ) :
    A / (R + r) ^ m = A / R ^ m / (1 + r / R) ^ m := by
  rw [div_div, ← mul_pow, mul_add, mul_one, mul_div_cancel₀ _ hR.ne']

/-- Helper: the truncated kernels and their derivatives are bounded:
`‖D^k 𝒦_J(w)‖ ≤ A (2^J)^{-n-k}` and `‖D^k 𝒦_J(w)‖ ≤ (A (2^J)^{-n-k}) (1 + |w|/2^J)^{-n-k}`. -/
lemma norm_iteratedFDeriv_truncKernel_le' (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) (k : ℕ) :
    ∃ A : ℝ, 0 ≤ A ∧ ∀ (J : ℤ) (w : EuclideanSpace ℝ (Fin n)),
      ‖iteratedFDeriv ℝ k (truncKernel Ω J) w‖ ≤
        A / ((2 : ℝ) ^ J) ^ (n + k) / (1 + ‖w‖ / 2 ^ J) ^ (n + k) ∧
      ‖iteratedFDeriv ℝ k (truncKernel Ω J) w‖ ≤ A / ((2 : ℝ) ^ J) ^ (n + k) := by
  obtain ⟨A, hA0, hA⟩ := norm_iteratedFDeriv_truncKernel_le hΩ k (by omega)
  refine ⟨A, hA0, fun J w => ?_⟩
  have hR : (0 : ℝ) < 2 ^ J := by positivity
  have h1 := hA J w
  rw [div_add_pow_eq _ hR] at h1
  refine ⟨h1, h1.trans ?_⟩
  apply div_le_self (by positivity)
  have : 0 ≤ ‖w‖ / 2 ^ J := by positivity
  exact one_le_pow₀ (by linarith)

/-- Helper: `‖φ_J‖ ≤ Q (2^J)^{-n}` and `‖Dφ_J‖ ≤ Q (2^J)^{-n-1}` (bounds used for dominated
differentiation). -/
lemma exists_bound_bpPhiDilC (k : ℕ) :
    ∃ Q : ℝ, 0 ≤ Q ∧ ∀ (J : ℤ) (x : EuclideanSpace ℝ (Fin n)),
      ‖iteratedFDeriv ℝ k (bpPhiDilC J) x‖ ≤ Q / ((2 : ℝ) ^ J) ^ (n + k) := by
  obtain ⟨Q, hQ0, hQ⟩ := norm_iteratedFDeriv_bpPhiDilC_le (n := n) k 0
  exact ⟨Q, hQ0, fun J x => by simpa using hQ J x⟩

/-- Helper: `∑_{1 ≤ j < J} 2^{j+1} ≤ 2 geomZ 2^J`. -/
lemma sum_Ico_two_zpow_le (J : ℤ) :
    ∑ j ∈ Finset.Ico 1 J, (2 : ℝ) ^ (j + 1) ≤ 2 * geomZ * 2 ^ J := by
  calc ∑ j ∈ Finset.Ico 1 J, (2 : ℝ) ^ (j + 1)
      = ∑ j ∈ Finset.Ico 1 J, 2 * 2 ^ J * (2 : ℝ) ^ (-|j - J|) := by
        refine Finset.sum_congr rfl fun j hj => ?_
        rw [Finset.mem_Ico] at hj
        rw [abs_of_neg (by omega), neg_neg, mul_assoc, ← zpow_add₀ two_ne_zero,
          ← zpow_one_add₀ two_ne_zero]
        congr 1; ring
    _ = 2 * 2 ^ J * ∑ j ∈ Finset.Ico 1 J, (2 : ℝ) ^ (-|j - J|) := by rw [Finset.mul_sum]
    _ ≤ 2 * 2 ^ J * geomZ := by gcongr; exact sum_two_zpow_neg_abs_sub_le _ J
    _ = 2 * geomZ * 2 ^ J := by ring

/-- Helper: `∫ |w| |K_j(w)| dw ≤ 2^{j+1} ∫ |K_0|`. -/
lemma integral_norm_mul_norm_dyadicKernel_le (hΩ : IsSWProfile Ω) (j : ℤ) :
    Integrable (fun w => ‖w‖ * ‖dyadicKernel Ω j w‖) ∧
    ∫ w, ‖w‖ * ‖dyadicKernel Ω j w‖ ≤ (2 : ℝ) ^ (j + 1) * ∫ x, ‖dyadicKernel Ω 0 x‖ := by
  have hb : ∀ w, ‖w‖ * ‖dyadicKernel Ω j w‖ ≤ (2 : ℝ) ^ (j + 1) * ‖dyadicKernel Ω j w‖ := by
    intro w
    rcases le_or_gt ‖w‖ ((2 : ℝ) ^ (j + 1)) with hw | hw
    · exact mul_le_mul_of_nonneg_right hw (norm_nonneg _)
    · rw [dyadicKernel_eq_zero_of_le j hw.le, norm_zero, mul_zero, mul_zero]
  have hi := (integrable_dyadicKernel hΩ j).norm.const_mul ((2 : ℝ) ^ (j + 1))
  have hint : Integrable (fun w => ‖w‖ * ‖dyadicKernel Ω j w‖) :=
    hi.mono' (continuous_norm.aestronglyMeasurable.mul
      (integrable_dyadicKernel hΩ j).norm.1) (Filter.Eventually.of_forall fun w => by
        rw [Real.norm_of_nonneg (by positivity)]; exact hb w)
  refine ⟨hint, (integral_mono hint hi hb).trans ?_⟩
  rw [integral_const_mul, integral_norm_dyadicKernel hΩ j]

/-- Helper: the cancellation bound for `∫ K_j(w) h(x - w) dw`, `j < J`, with `h` varying on
scale `2^J`. -/
lemma norm_integral_dyadicKernel_smul_sub_le (hn : 1 ≤ n) (hΩ : IsSWProfile Ω)
    {F : Type*} [NormedAddCommGroup F] [NormedSpace ℂ F] [CompleteSpace F]
    {J j : ℤ} (hjJ : j < J) {h : EuclideanSpace ℝ (Fin n) → F} (hh : ContDiff ℝ 1 h)
    {M0 b : ℝ} (hh0 : ∀ v, ‖h v‖ ≤ M0) {N : ℕ}
    (hh1 : ∀ v, ‖fderiv ℝ h v‖ ≤ b / (1 + ‖v‖ / 2 ^ J) ^ N) (x : EuclideanSpace ℝ (Fin n)) :
    ‖∫ w, dyadicKernel Ω j w • h (x - w)‖ ≤
      b * 2 ^ N / (1 + ‖x‖ / 2 ^ J) ^ N * ((2 : ℝ) ^ (j + 1) * ∫ x, ‖dyadicKernel Ω 0 x‖) := by
  have hR : (0 : ℝ) < 2 ^ J := by positivity
  have hb : 0 ≤ b := nonneg_of_norm_le_div (by positivity) (hh1 0)
  have hsupp : ∀ w : EuclideanSpace ℝ (Fin n), 2 ^ J < ‖w‖ → dyadicKernel Ω j w = 0 := by
    intro w hw
    refine dyadicKernel_eq_zero_of_le j (le_trans ?_ hw.le)
    exact zpow_le_zpow_right₀ (by norm_num) (by omega)
  obtain ⟨-, h1⟩ := norm_integral_smul_sub_le_of_integral_eq_zero (integrable_dyadicKernel hΩ j)
    hR hsupp (integral_dyadicKernel hn hΩ j) hh hh0 hh1 x
  refine h1.trans (mul_le_mul_of_nonneg_left (integral_norm_mul_norm_dyadicKernel_le hΩ j).2
    (by positivity))

/-- Helper: bounds on the truncated kernel as a function (value and first derivative). -/
lemma truncKernel_bounds (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) (J : ℤ) :
    ContDiff ℝ ∞ (truncKernel Ω J) ∧ (∃ M, ∀ w, ‖truncKernel Ω J w‖ ≤ M) ∧
      (∃ M, ∀ w, ‖fderiv ℝ (truncKernel Ω J) w‖ ≤ M) := by
  obtain ⟨A0, -, hA0⟩ := norm_iteratedFDeriv_truncKernel_le' hn hΩ 0
  obtain ⟨A1, -, hA1⟩ := norm_iteratedFDeriv_truncKernel_le' hn hΩ 1
  refine ⟨contDiff_truncKernel hΩ J, ⟨A0 / ((2 : ℝ) ^ J) ^ (n + 0), fun w => ?_⟩,
    ⟨A1 / ((2 : ℝ) ^ J) ^ (n + 1), fun w => ?_⟩⟩
  · have := (hA0 J w).2; rwa [norm_iteratedFDeriv_zero] at this
  · have := (hA1 J w).2; rwa [norm_iteratedFDeriv_one] at this

/-- Helper: bounds on `φ_J` as a function (value, first and second derivative). -/
lemma bpPhiDilC_bounds (J : ℤ) :
    ContDiff ℝ ∞ (bpPhiDilC (n := n) J) ∧ (∃ M, ∀ w, ‖bpPhiDilC (n := n) J w‖ ≤ M) ∧
      (∃ M, ∀ w, ‖fderiv ℝ (bpPhiDilC (n := n) J) w‖ ≤ M) := by
  obtain ⟨Q0, -, hQ0⟩ := exists_bound_bpPhiDilC (n := n) 0
  obtain ⟨Q1, -, hQ1⟩ := exists_bound_bpPhiDilC (n := n) 1
  refine ⟨contDiff_bpPhiDilC J, ⟨Q0 / ((2 : ℝ) ^ J) ^ (n + 0), fun w => ?_⟩,
    ⟨Q1 / ((2 : ℝ) ^ J) ^ (n + 1), fun w => ?_⟩⟩
  · have := hQ0 J w; rwa [norm_iteratedFDeriv_zero] at this
  · have := hQ1 J w; rwa [norm_iteratedFDeriv_one] at this

/-- Helper: `K_j` is bounded. -/
lemma dyadicKernel_bounded (hΩ : IsSWProfile Ω) (j : ℤ) :
    ∃ M, ∀ w : EuclideanSpace ℝ (Fin n), ‖dyadicKernel Ω j w‖ ≤ M := by
  obtain ⟨C, -, hC⟩ := norm_dyadicKernel_le hΩ
  exact ⟨C * (2 : ℝ) ^ (-j * n), hC j⟩

/-- Helper: the explicit formula
`E_J(x) = (𝒦_J(x) - ∫ φ_J(z) 𝒦_J(x - z) dz) - ∑_{1 ≤ j < J} ∫ K_j(w) φ_J(x - w) dw`,
where `𝒦_J = ∑_{j ≥ J} K_j`. -/
lemma smoothErr_eq (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) {J : ℤ} (hJ : 1 ≤ J) :
    smoothErr Ω J = fun x =>
      (truncKernel Ω J x - ∫ z, bpPhiDilC J z • truncKernel Ω J (x - z)) -
        ∑ j ∈ Finset.Ico 1 J, ∫ w, dyadicKernel Ω j w • bpPhiDilC J (x - w) := by
  funext x
  obtain ⟨hTc, ⟨M, hM⟩, -⟩ := truncKernel_bounds hn hΩ J
  have hi1 := integrable_bpPhiDilC_smul_sub hTc.continuous hM J x
  have hi2 : ∀ j ∈ Finset.Ico 1 J, Integrable (fun z => bpPhiDilC J z • dyadicKernel Ω j (x - z)) :=
    fun j _ => by
      obtain ⟨Mj, hMj⟩ := dyadicKernel_bounded hΩ j
      exact integrable_bpPhiDilC_smul_sub (contDiff_dyadicKernel hΩ j).continuous hMj J x
  rw [smoothErr, Pi.sub_apply, bpPhiDilC_convolution_apply]
  simp_rw [symbolKernel_eq_truncKernel_add hJ, smul_add, Finset.smul_sum]
  rw [integral_add hi1 (integrable_finsetSum _ hi2), integral_finsetSum _ hi2]
  simp_rw [integral_smul_sub_comm (bpPhiDilC J) (dyadicKernel Ω _) x]
  abel

/-- Blueprint Lemma 4.5 (`lem:smootherrors`), termwise differentiation: for `J ≥ 1`, `E_J` is
differentiable at every `x`, with
`DE_J(x) = (D𝒦_J(x) - ∫ φ_J(z) D𝒦_J(x - z) dz) - ∑_{1 ≤ j < J} ∫ K_j(w) Dφ_J(x - w) dw`,
`𝒦_J = ∑_{j ≥ J} K_j`. -/
lemma hasFDerivAt_smoothErr (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) {J : ℤ} (hJ : 1 ≤ J)
    (x : EuclideanSpace ℝ (Fin n)) :
    HasFDerivAt (smoothErr Ω J)
      ((fderiv ℝ (truncKernel Ω J) x -
          ∫ z, bpPhiDilC J z • fderiv ℝ (truncKernel Ω J) (x - z)) -
        ∑ j ∈ Finset.Ico 1 J, ∫ w, dyadicKernel Ω j w • fderiv ℝ (bpPhiDilC J) (x - w)) x := by
  rw [smoothErr_eq hn hΩ hJ]
  obtain ⟨hTc, ⟨M, hM⟩, ⟨M', hM'⟩⟩ := truncKernel_bounds hn hΩ J
  obtain ⟨hPc, ⟨P, hP⟩, ⟨P', hP'⟩⟩ := bpPhiDilC_bounds (n := n) J
  refine ((((hTc.differentiable (by simp)) x).hasFDerivAt).sub
    (hasFDerivAt_integral_smul_sub (integrable_bpPhiDilC J) (hTc.of_le (by simp)) hM hM' x)).sub
    (HasFDerivAt.fun_sum fun j _ => ?_)
  exact hasFDerivAt_integral_smul_sub (integrable_dyadicKernel hΩ j) (hPc.of_le (by simp)) hP hP' x

/-- Blueprint Lemma 4.5 (`lem:smootherrors`), regularity: for `J ≥ 1`, `E_J` is continuously
differentiable (`C¹`); see `hasFDerivAt_smoothErr` for the derivative. -/
theorem contDiff_smoothErr (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) {J : ℤ} (hJ : 1 ≤ J) :
    ContDiff ℝ 1 (smoothErr Ω J) := by
  rw [contDiff_one_iff_hasFDerivAt]
  refine ⟨_, ?_, hasFDerivAt_smoothErr hn hΩ hJ⟩
  obtain ⟨hTc, -, ⟨M', hM'⟩⟩ := truncKernel_bounds hn hΩ J
  obtain ⟨hPc, -, ⟨P', hP'⟩⟩ := bpPhiDilC_bounds (n := n) J
  refine ((hTc.continuous_fderiv (by simp)).sub (continuous_integral_smul_sub
    (integrable_bpPhiDilC J) (hTc.continuous_fderiv (by simp)) hM')).sub
    (continuous_finsetSum _ fun j _ => ?_)
  exact continuous_integral_smul_sub (integrable_dyadicKernel hΩ j)
    (hPc.continuous_fderiv (by simp)) hP'

/-- Helper: combining two bounds with the weights `(1 + |x|/R)^{-m}` and `(1 + |x|/R)^{-m-1}`. -/
lemma add_le_div_of_le {a b X Y C D u : ℝ} {m : ℕ} (hD : 0 < D) (hu : 1 ≤ u) (hY : 0 ≤ Y)
    (hXY : X + Y ≤ C) (ha : a ≤ X / (D * u ^ m)) (hb : b ≤ Y / (D * u ^ (m + 1))) :
    a + b ≤ C / (D * u ^ m) := by
  have hu0 : 0 < u := by linarith
  have h1 : Y / (D * u ^ (m + 1)) ≤ Y / (D * u ^ m) :=
    div_le_div_of_nonneg_left hY (by positivity)
      (mul_le_mul_of_nonneg_left (pow_le_pow_right₀ hu (by omega)) hD.le)
  calc a + b ≤ X / (D * u ^ m) + Y / (D * u ^ m) := by linarith
    _ = (X + Y) / (D * u ^ m) := by rw [add_div]
    _ ≤ C / (D * u ^ m) := div_le_div_of_nonneg_right hXY (by positivity)

/-- Blueprint Lemma 4.5 (`lem:smootherrors`), (4.5): there is `C` such that for all `J ≥ 1`,
with `R = 2^J`, and all `x ∈ E`,
`|E_J(x)| ≤ C R^{-n} (1 + |x|/R)^{-n-2}` and `|∇E_J(x)| ≤ C R^{-n-1} (1 + |x|/R)^{-n-3}`
(`E_J` is differentiable, `contDiff_smoothErr`). -/
theorem norm_smoothErr_le (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ J : ℤ, 1 ≤ J → ∀ x : EuclideanSpace ℝ (Fin n),
      ‖smoothErr Ω J x‖ ≤ C / (((2 : ℝ) ^ J) ^ n * (1 + ‖x‖ / 2 ^ J) ^ (n + 2)) ∧
      ‖fderiv ℝ (smoothErr Ω J) x‖ ≤
        C / (((2 : ℝ) ^ J) ^ (n + 1) * (1 + ‖x‖ / 2 ^ J) ^ (n + 3)) := by
  obtain ⟨A2, hA2, hA2'⟩ := norm_iteratedFDeriv_truncKernel_le' hn hΩ 2
  obtain ⟨A3, hA3, hA3'⟩ := norm_iteratedFDeriv_truncKernel_le' hn hΩ 3
  obtain ⟨Q1, hQ1, hQ1'⟩ := norm_iteratedFDeriv_bpPhiDilC_le (n := n) 1 (n + 3)
  obtain ⟨Q2, hQ2, hQ2'⟩ := norm_iteratedFDeriv_bpPhiDilC_le (n := n) 2 (n + 4)
  set C1 := ∫ x, ‖dyadicKernel Ω 0 x‖ with hC1_def
  have hC1 : 0 ≤ C1 := integral_nonneg fun _ => norm_nonneg _
  have hG : 0 ≤ geomZ := geomZ_nonneg
  have hM2 := bpMoment_nonneg (n := n) 2 (n + 2)
  have hM3 := bpMoment_nonneg (n := n) 2 (n + 3)
  set X1 := A2 * bpMoment n 2 (n + 2)
  set Y1 := Q1 * 2 ^ (n + 3) * C1 * (2 * geomZ)
  set X2 := A3 * bpMoment n 2 (n + 3)
  set Y2 := Q2 * 2 ^ (n + 4) * C1 * (2 * geomZ)
  have hX1 : 0 ≤ X1 := by positivity
  have hY1 : 0 ≤ Y1 := by positivity
  have hX2 : 0 ≤ X2 := by positivity
  have hY2 : 0 ≤ Y2 := by positivity
  refine ⟨X1 + Y1 + X2 + Y2, by positivity, fun J hJ x => ?_⟩
  set R : ℝ := (2 : ℝ) ^ J with hR_def
  have hR : 0 < R := by positivity
  set u := 1 + ‖x‖ / R with hu_def
  have hu : 1 ≤ u := by have : 0 ≤ ‖x‖ / R := by positivity
                        linarith
  have hu0 : 0 < u := by linarith
  obtain ⟨hTc, ⟨M, hM⟩, ⟨M', hM'⟩⟩ := truncKernel_bounds hn hΩ J
  obtain ⟨hPc, ⟨P, hP⟩, ⟨P', hP'⟩⟩ := bpPhiDilC_bounds (n := n) J
  -- the sum over `1 ≤ j < J`
  have hsum : ∀ c : ℝ, 0 ≤ c → ∑ j ∈ Finset.Ico 1 J, c * ((2 : ℝ) ^ (j + 1) * C1) ≤
      c * C1 * (2 * geomZ) * R := by
    intro c hc
    calc ∑ j ∈ Finset.Ico 1 J, c * ((2 : ℝ) ^ (j + 1) * C1)
        = c * C1 * ∑ j ∈ Finset.Ico 1 J, (2 : ℝ) ^ (j + 1) := by
          rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun _ _ => by ring
      _ ≤ c * C1 * (2 * geomZ * R) := by gcongr; exact sum_Ico_two_zpow_le J
      _ = c * C1 * (2 * geomZ) * R := by ring
  refine ⟨?_, ?_⟩
  · -- size bound
    have hA : ‖truncKernel Ω J x - ∫ z, bpPhiDilC J z • truncKernel Ω J (x - z)‖ ≤
        X1 / (R ^ n * u ^ (n + 2)) := by
      have := norm_sub_integral_bpPhiDilC_smul_le_two (hTc.of_le (by simp)) hM J le_rfl
        (a := A2 / R ^ (n + 2)) (N := n + 2) (fun w => (hA2' J w).1) x
      refine this.trans (le_of_eq ?_)
      rw [← hu_def]
      field_simp
      ring
    have hB : ‖∑ j ∈ Finset.Ico 1 J, ∫ w, dyadicKernel Ω j w • bpPhiDilC J (x - w)‖ ≤
        Y1 / (R ^ n * u ^ (n + 3)) := by
      refine (norm_sum_le _ _).trans ?_
      have hj : ∀ j ∈ Finset.Ico 1 J, ‖∫ w, dyadicKernel Ω j w • bpPhiDilC J (x - w)‖ ≤
          Q1 / R ^ (n + 1) * 2 ^ (n + 3) / u ^ (n + 3) * ((2 : ℝ) ^ (j + 1) * C1) := by
        intro j hj
        exact norm_integral_dyadicKernel_smul_sub_le hn hΩ (Finset.mem_Ico.1 hj).2
          (hPc.of_le (by simp)) hP (b := Q1 / R ^ (n + 1)) (N := n + 3)
          (fun v => by rw [← norm_iteratedFDeriv_one, div_div]; exact hQ1' J v) x
      refine (Finset.sum_le_sum hj).trans ((hsum _ (by positivity)).trans (le_of_eq ?_))
      field_simp
      ring
    rw [smoothErr_eq hn hΩ hJ]
    refine (norm_sub_le _ _).trans ?_
    exact add_le_div_of_le (by positivity) hu (by positivity) (by linarith) hA hB
  · -- gradient bound
    rw [(hasFDerivAt_smoothErr hn hΩ hJ x).fderiv]
    have hA : ‖fderiv ℝ (truncKernel Ω J) x -
        ∫ z, bpPhiDilC J z • fderiv ℝ (truncKernel Ω J) (x - z)‖ ≤
        X2 / (R ^ (n + 1) * u ^ (n + 3)) := by
      have := norm_sub_integral_bpPhiDilC_smul_le_two
        (hTc.fderiv_right (m := 2) (by simp)) hM' J le_rfl
        (a := A3 / R ^ (n + 3)) (N := n + 3)
        (fun w => by rw [norm_iteratedFDeriv_fderiv]; exact (hA3' J w).1) x
      refine this.trans (le_of_eq ?_)
      rw [← hu_def]
      field_simp
      ring
    have hB : ‖∑ j ∈ Finset.Ico 1 J,
        ∫ w, dyadicKernel Ω j w • fderiv ℝ (bpPhiDilC J) (x - w)‖ ≤
        Y2 / (R ^ (n + 1) * u ^ (n + 3 + 1)) := by
      refine (norm_sum_le _ _).trans ?_
      have hj : ∀ j ∈ Finset.Ico 1 J,
          ‖∫ w, dyadicKernel Ω j w • fderiv ℝ (bpPhiDilC J) (x - w)‖ ≤
          Q2 / R ^ (n + 2) * 2 ^ (n + 4) / u ^ (n + 4) * ((2 : ℝ) ^ (j + 1) * C1) := by
        intro j hj
        exact norm_integral_dyadicKernel_smul_sub_le hn hΩ (Finset.mem_Ico.1 hj).2
          (hPc.fderiv_right (m := 1) (by simp)) hP' (b := Q2 / R ^ (n + 2)) (N := n + 4)
          (fun v => by
            rw [← norm_iteratedFDeriv_one, norm_iteratedFDeriv_fderiv, div_div]
            exact hQ2' J v) x
      refine (Finset.sum_le_sum hj).trans ((hsum _ (by positivity)).trans (le_of_eq ?_))
      field_simp
      ring
    refine (norm_sub_le _ _).trans ?_
    exact add_le_div_of_le (by positivity) hu (by positivity) (by linarith) hA hB

/-! ### The series (4.6) -/

/-- Helper: `2^{-(J+i)n} ≤ 2^{-Jn} (1/2)^i` for `n ≥ 1`. -/
lemma two_zpow_neg_add_mul_le (hn : 1 ≤ n) (J : ℤ) (i : ℕ) :
    (2 : ℝ) ^ (-(J + i) * (n : ℤ)) ≤ (2 : ℝ) ^ (-J * (n : ℤ)) * (1 / 2) ^ i := by
  have := two_zpow_neg_mul_le (J := J) (j := J + i) (by omega) hn
  refine this.trans (le_of_eq ?_)
  congr 1
  rw [show J + (i : ℤ) - J = i by ring, Nat.abs_cast, zpow_neg, zpow_natCast, one_div, inv_pow]

/-- Helper: pointwise bound for the terms `K_j - φ_J * K_j`, `j ≥ J`:
`|K_j - φ_J * K_j|(x) ≤ C 2^{J-j} B_{2^j}(x)`. -/
lemma norm_dyadicKernel_sub_convolution_le (hΩ : IsSWProfile Ω) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ J j : ℤ, J ≤ j → ∀ x : EuclideanSpace ℝ (Fin n),
      ‖(dyadicKernel Ω j - bpPhiDilC J ⋆[ContinuousLinearMap.mul ℂ ℂ, volume]
          dyadicKernel Ω j) x‖ ≤ C * (2 : ℝ) ^ (J - j) * envelope n ((2 : ℝ) ^ j) x := by
  obtain ⟨Cd, hCd0, hCd⟩ := norm_fderiv_dyadicKernel_le hΩ
  have hM := bpMoment_nonneg (n := n) 1 (n + 1)
  refine ⟨Cd * 3 ^ (n + 1) * bpMoment n 1 (n + 1), by positivity, fun J j hjJ x => ?_⟩
  set ρ : ℝ := (2 : ℝ) ^ j with hρ_def
  have hρ : 0 < ρ := by positivity
  have hRρ : (2 : ℝ) ^ J ≤ ρ := zpow_le_zpow_right₀ (by norm_num) hjJ
  obtain ⟨Mj, hMj⟩ := dyadicKernel_bounded hΩ j
  have hd : ∀ w, ‖fderiv ℝ (dyadicKernel Ω j) w‖ ≤
      Cd * 3 ^ (n + 1) / ρ ^ (n + 1) / (1 + ‖w‖ / ρ) ^ (n + 1) := by
    intro w
    by_cases hw : w ∈ tsupport (dyadicKernel Ω j)
    · have hw2 := (tsupport_dyadicKernel j hw).2
      have h3 : (1 + ‖w‖ / ρ) ^ (n + 1) ≤ 3 ^ (n + 1) := by
        apply pow_le_pow_left₀ (by positivity)
        have : ‖w‖ / ρ ≤ 2 := by
          rw [div_le_iff₀ hρ]; rw [zpow_add_one₀ two_ne_zero] at hw2; linarith
        linarith
      have hc : Cd * (2 : ℝ) ^ (-j * ((n : ℤ) + 1)) = Cd / ρ ^ (n + 1) := by
        rw [hρ_def, ← zpow_natCast, ← zpow_mul, div_eq_mul_inv, ← zpow_neg]; push_cast; ring_nf
      refine (hCd j w).trans ?_
      rw [hc, div_div, div_le_div_iff₀ (by positivity) (by positivity)]
      calc Cd * (ρ ^ (n + 1) * (1 + ‖w‖ / ρ) ^ (n + 1))
          ≤ Cd * (ρ ^ (n + 1) * 3 ^ (n + 1)) := by gcongr
        _ = Cd * 3 ^ (n + 1) * ρ ^ (n + 1) := by ring
    · rw [Function.notMem_support.1 (fun h => hw (support_fderiv_subset ℝ h)), norm_zero]
      positivity
  have h := norm_sub_integral_bpPhiDilC_smul_le_one
    ((contDiff_dyadicKernel hΩ j).of_le (by simp)) hMj J hRρ hd x
  rw [Pi.sub_apply, bpPhiDilC_convolution_apply]
  refine h.trans (le_of_eq ?_)
  rw [envelope, hρ_def, zpow_sub₀ two_ne_zero]
  field_simp
  ring

/-- Helper: pointwise bound for the terms `φ_J * K_j`, `j < J`:
`|φ_J * K_j|(x) ≤ C 2^{j-J} B_{2^J}(x)`. -/
lemma norm_convolution_dyadicKernel_le (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ J j : ℤ, j < J → ∀ x : EuclideanSpace ℝ (Fin n),
      ‖(bpPhiDilC J ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] dyadicKernel Ω j) x‖ ≤
        C * (2 : ℝ) ^ (j - J) * envelope n ((2 : ℝ) ^ J) x := by
  obtain ⟨Q1, hQ1, hQ1'⟩ := norm_iteratedFDeriv_bpPhiDilC_le (n := n) 1 (n + 1)
  set C1 := ∫ x, ‖dyadicKernel Ω 0 x‖ with hC1_def
  have hC1 : 0 ≤ C1 := integral_nonneg fun _ => norm_nonneg _
  refine ⟨Q1 * 2 ^ (n + 2) * C1, by positivity, fun J j hjJ x => ?_⟩
  obtain ⟨hPc, ⟨P, hP⟩, -⟩ := bpPhiDilC_bounds (n := n) J
  have hR : (0 : ℝ) < 2 ^ J := by positivity
  have h := norm_integral_dyadicKernel_smul_sub_le hn hΩ hjJ (hPc.of_le (by simp)) hP
    (b := Q1 / ((2 : ℝ) ^ J) ^ (n + 1)) (N := n + 1)
    (fun v => by rw [← norm_iteratedFDeriv_one, div_div]; exact hQ1' J v) x
  rw [bpPhiDilC_convolution_apply, integral_smul_sub_comm]
  refine h.trans (le_of_eq ?_)
  rw [envelope, zpow_sub₀ two_ne_zero, zpow_add_one₀ two_ne_zero]
  field_simp
  ring

/-- Blueprint Lemma 4.5 (`lem:smootherrors`), the series (4.6) and its absolute convergence in
`L¹`: there is `C` such that for every `J ≥ 1`
* for `j ≥ J`, `K_j - φ_J * K_j` is integrable with `‖K_j - φ_J * K_j‖_1 ≤ C 2^{J-j}`;
* for `j < J`, `φ_J * K_j` is integrable with `‖φ_J * K_j‖_1 ≤ C 2^{j-J}`;
* pointwise, `∑_{j ≥ J} (K_j - φ_J * K_j)(x) = E_J(x) + ∑_{1 ≤ j < J} (φ_J * K_j)(x)`, i.e.
  `E_J = ∑_{j ≥ J} (K_j - φ_J * K_j) - ∑_{1 ≤ j < J} φ_J * K_j`
(here `φ_J * g (x) = ∫ φ_J(t) g(x - t) dt`). -/
theorem smoothErr_hasSum (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ J : ℤ, 1 ≤ J →
      (∀ j : ℤ, J ≤ j →
        Integrable (dyadicKernel Ω j - bpPhiDilC J ⋆[ContinuousLinearMap.mul ℂ ℂ, volume]
          dyadicKernel Ω j) ∧
        ∫ x, ‖(dyadicKernel Ω j - bpPhiDilC J ⋆[ContinuousLinearMap.mul ℂ ℂ, volume]
          dyadicKernel Ω j) x‖ ≤ C * (2 : ℝ) ^ (J - j)) ∧
      (∀ j : ℤ, j < J →
        Integrable (bpPhiDilC J ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] dyadicKernel Ω j) ∧
        ∫ x, ‖(bpPhiDilC J ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] dyadicKernel Ω j) x‖ ≤
          C * (2 : ℝ) ^ (j - J)) ∧
      ∀ x : EuclideanSpace ℝ (Fin n),
        HasSum (fun i : ℕ => (dyadicKernel Ω (J + i) -
            bpPhiDilC J ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] dyadicKernel Ω (J + i)) x)
          (smoothErr Ω J x + ∑ j ∈ Finset.Ico 1 J,
            (bpPhiDilC J ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] dyadicKernel Ω j) x) := by
  obtain ⟨C₁, hC₁, h₁⟩ := norm_dyadicKernel_sub_convolution_le hΩ
  obtain ⟨C₂, hC₂, h₂⟩ := norm_convolution_dyadicKernel_le hn hΩ
  obtain ⟨Cb, hCb0, hCb⟩ := norm_dyadicKernel_le hΩ
  have hE : 0 ≤ envelopeConst n := by unfold envelopeConst; positivity
  refine ⟨(C₁ + C₂) * envelopeConst n, by positivity, fun J hJ => ⟨fun j hj => ?_,
    fun j hj => ?_, fun x => ?_⟩⟩
  · have hint : Integrable (dyadicKernel Ω j - bpPhiDilC J ⋆[ContinuousLinearMap.mul ℂ ℂ, volume]
        dyadicKernel Ω j) :=
      (integrable_dyadicKernel hΩ j).sub
        ((integrable_bpPhiDilC J).integrable_convolution _ (integrable_dyadicKernel hΩ j))
    refine ⟨hint, ?_⟩
    obtain ⟨hei, hel⟩ := integrable_envelope_and_integral_le (n := n)
      (show (0 : ℝ) < 2 ^ j by positivity)
    calc ∫ x, ‖(dyadicKernel Ω j - bpPhiDilC J ⋆[ContinuousLinearMap.mul ℂ ℂ, volume]
          dyadicKernel Ω j) x‖
        ≤ ∫ x, C₁ * (2 : ℝ) ^ (J - j) * envelope n ((2 : ℝ) ^ j) x :=
          integral_mono hint.norm (hei.const_mul _) (h₁ J j hj)
      _ = C₁ * (2 : ℝ) ^ (J - j) * ∫ x, envelope n ((2 : ℝ) ^ j) x := integral_const_mul _ _
      _ ≤ C₁ * (2 : ℝ) ^ (J - j) * envelopeConst n := by gcongr
      _ ≤ (C₁ + C₂) * envelopeConst n * (2 : ℝ) ^ (J - j) := by
          have : 0 ≤ C₂ * envelopeConst n * (2 : ℝ) ^ (J - j) := by positivity
          nlinarith
  · have hint : Integrable (bpPhiDilC J ⋆[ContinuousLinearMap.mul ℂ ℂ, volume]
        dyadicKernel Ω j) :=
      (integrable_bpPhiDilC J).integrable_convolution _ (integrable_dyadicKernel hΩ j)
    refine ⟨hint, ?_⟩
    obtain ⟨hei, hel⟩ := integrable_envelope_and_integral_le (n := n)
      (show (0 : ℝ) < 2 ^ J by positivity)
    calc ∫ x, ‖(bpPhiDilC J ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] dyadicKernel Ω j) x‖
        ≤ ∫ x, C₂ * (2 : ℝ) ^ (j - J) * envelope n ((2 : ℝ) ^ J) x :=
          integral_mono hint.norm (hei.const_mul _) (h₂ J j hj)
      _ = C₂ * (2 : ℝ) ^ (j - J) * ∫ x, envelope n ((2 : ℝ) ^ J) x := integral_const_mul _ _
      _ ≤ C₂ * (2 : ℝ) ^ (j - J) * envelopeConst n := by gcongr
      _ ≤ (C₁ + C₂) * envelopeConst n * (2 : ℝ) ^ (j - J) := by
          have : 0 ≤ C₁ * envelopeConst n * (2 : ℝ) ^ (j - J) := by positivity
          nlinarith
  · -- the pointwise identity
    have hK := hasSum_truncKernel (Ω := Ω) J x
    have hconv : HasSum (fun i : ℕ => ∫ z, bpPhiDilC J z • dyadicKernel Ω (J + i) (x - z))
        (∫ z, bpPhiDilC J z • truncKernel Ω J (x - z)) := by
      refine hasSum_integral_of_dominated_convergence
        (fun i z => ‖bpPhiDilC J z‖ * (Cb * (2 : ℝ) ^ (-J * (n : ℤ))) * (1 / 2) ^ i)
        (fun i => ?_) (fun i => Filter.Eventually.of_forall fun z => ?_)
        (Filter.Eventually.of_forall fun z => summable_geometric_two.mul_left _) ?_
        (Filter.Eventually.of_forall fun z =>
          (hasSum_truncKernel J (x - z)).const_smul (bpPhiDilC J z))
      · exact (integrable_bpPhiDilC J).aestronglyMeasurable.smul
          ((contDiff_dyadicKernel hΩ _).continuous.comp
            (continuous_const.sub continuous_id)).aestronglyMeasurable
      · rw [norm_smul, mul_assoc, mul_assoc]
        refine mul_le_mul_of_nonneg_left ((hCb _ _).trans ?_) (norm_nonneg _)
        exact mul_le_mul_of_nonneg_left (two_zpow_neg_add_mul_le hn J i) hCb0
      · simp_rw [tsum_mul_left, tsum_geometric_two]
        exact ((integrable_bpPhiDilC J).norm.mul_const _).mul_const _
    have heq : smoothErr Ω J x + ∑ j ∈ Finset.Ico 1 J,
        (bpPhiDilC J ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] dyadicKernel Ω j) x =
        truncKernel Ω J x - ∫ z, bpPhiDilC J z • truncKernel Ω J (x - z) := by
      rw [smoothErr_eq hn hΩ hJ]
      simp_rw [bpPhiDilC_convolution_apply, integral_smul_sub_comm (bpPhiDilC J)
        (dyadicKernel Ω _) x]
      abel
    rw [heq]
    refine (hK.sub hconv).congr_fun fun i => ?_
    rw [Pi.sub_apply, bpPhiDilC_convolution_apply]

/-! ### Integrability, integral zero, and the Fourier transform of `E_J` -/

/-- Blueprint Lemma 4.5 (`lem:smootherrors`): for `J ≥ 1`, `E_J` is integrable. -/
theorem integrable_smoothErr (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) {J : ℤ} (hJ : 1 ≤ J) :
    Integrable (smoothErr Ω J) := by
  obtain ⟨C, hC0, hC⟩ := norm_smoothErr_le hn hΩ
  have hR : (0 : ℝ) < 2 ^ J := by positivity
  refine ((integrable_envelope_and_integral_le (n := n) hR).1.const_mul C).mono'
    (contDiff_smoothErr hn hΩ hJ).continuous.aestronglyMeasurable
    (Filter.Eventually.of_forall fun x => (hC J hJ x).1.trans ?_)
  rw [envelope, ← mul_inv, ← div_eq_mul_inv]
  have hu : 1 ≤ 1 + ‖x‖ / 2 ^ J := by
    have : 0 ≤ ‖x‖ / 2 ^ J := by positivity
    linarith
  exact div_le_div_of_nonneg_left hC0 (by positivity)
    (mul_le_mul_of_nonneg_left (pow_le_pow_right₀ hu (by omega)) (by positivity))

/-- Helper: `𝓕(f - g) = 𝓕 f - 𝓕 g` for integrable `f, g`. -/
lemma fourier_sub_apply {f g : EuclideanSpace ℝ (Fin n) → ℂ} (hf : Integrable f)
    (hg : Integrable g) (ξ : EuclideanSpace ℝ (Fin n)) :
    𝓕 (f - g) ξ = 𝓕 f ξ - 𝓕 g ξ := by
  simp only [Real.fourier_eq, Pi.sub_apply, smul_sub]
  exact integral_sub ((Real.fourierIntegral_convergent_iff ξ).2 hf)
    ((Real.fourierIntegral_convergent_iff ξ).2 hg)

/-- Helper: `𝓕(∑_{i ∈ s} c_i f_i) = ∑_{i ∈ s} c_i 𝓕 f_i` for integrable `f_i`. -/
lemma fourier_finsetSum_smul {ι : Type*} (s : Finset ι) (c : ι → ℂ)
    {f : ι → EuclideanSpace ℝ (Fin n) → ℂ} (hf : ∀ i ∈ s, Integrable (f i))
    (ξ : EuclideanSpace ℝ (Fin n)) :
    𝓕 (∑ i ∈ s, c i • f i) ξ = ∑ i ∈ s, c i * 𝓕 (f i) ξ := by
  simp only [Real.fourier_eq, Finset.sum_apply, Pi.smul_apply, Finset.smul_sum]
  rw [integral_finsetSum _ (fun i hi => ?_)]
  · refine Finset.sum_congr rfl fun i _ => ?_
    rw [← integral_const_mul]
    refine integral_congr_ae (Filter.Eventually.of_forall fun v => ?_)
    simp only [Circle.smul_def, smul_eq_mul]
    ring
  · refine (((Real.fourierIntegral_convergent_iff ξ).2 (hf i hi)).const_mul (c i)).congr
      (Filter.Eventually.of_forall fun v => ?_)
    simp only [Circle.smul_def, smul_eq_mul]
    ring

/-- Helper: splitting `∑_{i ≥ 0} g(i + 1) = ∑_{1 ≤ j < J} g(j) + ∑_{i ≥ 0} g(J + i)` for
`J ≥ 1`. -/
lemma tsum_succ_eq_sum_Ico_add_tsum {g : ℤ → ℂ} (hg : Summable fun i : ℕ => g (i + 1))
    {J : ℤ} (hJ : 1 ≤ J) :
    ∑' i : ℕ, g (i + 1) = ∑ j ∈ Finset.Ico 1 J, g j + ∑' i : ℕ, g (J + i) := by
  obtain ⟨k, rfl⟩ : ∃ k : ℕ, J = k + 1 := ⟨(J - 1).toNat, by omega⟩
  have hIco : Finset.Ico (1 : ℤ) ((k : ℤ) + 1) = (Finset.range k).map succIntEmb := by
    ext j
    simp only [Finset.mem_Ico, Finset.mem_map, Finset.mem_range]
    constructor
    · rintro ⟨h1, h2⟩
      refine ⟨(j - 1).toNat, by omega, ?_⟩
      show ((j - 1).toNat : ℤ) + 1 = j
      omega
    · rintro ⟨i, hi, rfl⟩
      show 1 ≤ (i : ℤ) + 1 ∧ (i : ℤ) + 1 < k + 1
      omega
  rw [hIco, Finset.sum_map, ← hg.sum_add_tsum_nat_add k]
  congr 1
  congr 1; ext i; congr 1; push_cast; ring

/-- Helper: bounds for `τ_J(ξ) = 𝓕φ(2^J ξ)`: `|τ_J| ≤ S₀`, `|τ_J(ξ)| 2^J |ξ| ≤ S₁` and
`|1 - τ_J(ξ)| ≤ L 2^J |ξ|`. -/
lemma norm_bpTau_le :
    ∃ S₀ S₁ L : ℝ, 0 ≤ S₀ ∧ 0 ≤ S₁ ∧ 0 ≤ L ∧ ∀ (J : ℤ) (ξ : EuclideanSpace ℝ (Fin n)),
      ‖bpTau J ξ‖ ≤ S₀ ∧ ‖bpTau J ξ‖ * ((2 : ℝ) ^ J * ‖ξ‖) ≤ S₁ ∧
        ‖1 - bpTau J ξ‖ ≤ L * ((2 : ℝ) ^ J * ‖ξ‖) := by
  set Φ : SchwartzMap (EuclideanSpace ℝ (Fin n)) ℂ := 𝓕 (bpPhiS (n := n))
  have hΦ : 𝓕 (fun x => (bpPhi (n := n) x : ℂ)) = ⇑Φ := by
    rw [← coe_bpPhiS, ← SchwartzMap.fourier_coe]
  have hΦ0 : Φ 0 = 1 := by rw [← hΦ]; exact fourier_bpPhi_zero
  set L := SchwartzMap.seminorm ℝ 0 1 Φ
  have hL : ∀ ζ, ‖Φ ζ - Φ 0‖ ≤ L * ‖ζ‖ := by
    intro ζ
    have h := Convex.norm_image_sub_le_of_norm_fderiv_le (s := univ) (C := L)
      (f := (Φ : EuclideanSpace ℝ (Fin n) → ℂ))
      (fun x _ => Φ.differentiableAt) (fun x _ => ?_) convex_univ (mem_univ 0) (mem_univ ζ)
    · simpa using h
    · rw [← norm_iteratedFDeriv_one]; exact SchwartzMap.norm_iteratedFDeriv_le_seminorm ℝ _ 1 x
  refine ⟨SchwartzMap.seminorm ℝ 0 0 Φ, SchwartzMap.seminorm ℝ 1 0 Φ, L, apply_nonneg _ _,
    apply_nonneg _ _, apply_nonneg _ _, fun J ξ => ?_⟩
  have hτ : bpTau J ξ = Φ ((2 : ℝ) ^ J • ξ) := by rw [bpTau, hΦ]
  have hn : ‖(2 : ℝ) ^ J • ξ‖ = (2 : ℝ) ^ J * ‖ξ‖ := by
    rw [norm_smul, Real.norm_of_nonneg (by positivity)]
  rw [hτ]
  refine ⟨SchwartzMap.norm_le_seminorm ℝ Φ _, ?_, ?_⟩
  · have := SchwartzMap.norm_pow_mul_le_seminorm ℝ Φ 1 ((2 : ℝ) ^ J • ξ)
    rw [pow_one, hn] at this
    linarith
  · have := hL ((2 : ℝ) ^ J • ξ)
    rw [hΦ0, hn, norm_sub_rev] at this
    exact this

/-- Helper: finite sums `∑_{i ∈ u} |𝓕 K_{J+i}(ξ)| ≤ A`. -/
lemma sum_norm_fourier_dyadicKernel_add_le (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) :
    ∃ A : ℝ, 0 ≤ A ∧ ∀ (J : ℤ) (u : Finset ℕ) (ξ : EuclideanSpace ℝ (Fin n)),
      ∑ i ∈ u, ‖𝓕 (dyadicKernel Ω (J + i)) ξ‖ ≤ A := by
  obtain ⟨A, hA0, hA⟩ := sum_norm_fourier_dyadicKernel_le hn hΩ
  refine ⟨A, hA0, fun J u ξ => ?_⟩
  have := hA (u.map ⟨fun i : ℕ => J + i, fun a b h => by simpa using h⟩) ξ
  rwa [Finset.sum_map] at this

/-- Blueprint Lemma 4.5 (`lem:smootherrors`) and Lemma 10.1 (`m_{≥J} = τ_J m_K + Ê_J`), Fourier
side: for `J ≥ 1`, `E_J` is integrable with `∫ E_J = 0`, its Fourier transform is continuous,
as is the right-hand side below, and for every `ξ` the series `∑_{j ≥ J} 𝓕K_j(ξ)` converges
absolutely with
`𝓕 E_J(ξ) = ∑_{j ≥ J} 𝓕 K_j(ξ) - τ_J(ξ) m_K(ξ)` (Mathlib's `𝓕`, `𝓕 f(ξ) = ∫ e(-x·ξ) f(x) dx`). -/
theorem fourier_smoothErr (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) {J : ℤ} (hJ : 1 ≤ J) :
    Integrable (smoothErr Ω J) ∧ ∫ x, smoothErr Ω J x = 0 ∧
      Continuous (𝓕 (smoothErr Ω J)) ∧
      Continuous (fun ξ => ∑' i : ℕ, 𝓕 (dyadicKernel Ω (J + i)) ξ - bpTau J ξ * dyadicSymbol Ω ξ) ∧
      ∀ ξ : EuclideanSpace ℝ (Fin n),
        Summable (fun i : ℕ => ‖𝓕 (dyadicKernel Ω (J + i)) ξ‖) ∧
        𝓕 (smoothErr Ω J) ξ =
          ∑' i : ℕ, 𝓕 (dyadicKernel Ω (J + i)) ξ - bpTau J ξ * dyadicSymbol Ω ξ := by
  have hE := integrable_smoothErr hn hΩ hJ
  obtain ⟨A, hA0, hA⟩ := sum_norm_fourier_dyadicKernel_add_le hn hΩ
  have hsa : ∀ ξ, Summable (fun i : ℕ => ‖𝓕 (dyadicKernel Ω (J + i)) ξ‖) := fun ξ =>
    summable_of_sum_le (fun _ => norm_nonneg _) (hA J · ξ)
  obtain ⟨C, hC0, hC⟩ := smoothErr_hasSum hn hΩ
  obtain ⟨hD, hP, hs⟩ := hC J hJ
  set D : ℕ → EuclideanSpace ℝ (Fin n) → ℂ := fun i =>
    dyadicKernel Ω (J + i) - bpPhiDilC J ⋆[ContinuousLinearMap.mul ℂ ℂ, volume]
      dyadicKernel Ω (J + i) with hD_def
  set P : ℤ → EuclideanSpace ℝ (Fin n) → ℂ := fun j =>
    bpPhiDilC J ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] dyadicKernel Ω j with hP_def
  have hτ : ∀ ξ, 𝓕 (bpPhiDilC (n := n) J) ξ = bpTau J ξ := fun ξ => fourier_bpPhiDil J ξ
  have hFP : ∀ j ξ, 𝓕 (P j) ξ = bpTau J ξ * 𝓕 (dyadicKernel Ω j) ξ := fun j ξ => by
    rw [hP_def, Real.fourier_mul_convolution_eq (integrable_bpPhiDilC J)
      (integrable_dyadicKernel hΩ j), hτ]
  have hFD : ∀ i ξ, 𝓕 (D i) ξ = (1 - bpTau J ξ) * 𝓕 (dyadicKernel Ω (J + i)) ξ := fun i ξ => by
    rw [hD_def, fourier_sub_apply (integrable_dyadicKernel hΩ _)
      ((integrable_bpPhiDilC J).integrable_convolution _ (integrable_dyadicKernel hΩ _))]
    rw [show 𝓕 (bpPhiDilC J ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] dyadicKernel Ω (J + i)) ξ = _
      from hFP (J + i) ξ]
    ring
  have hDi : ∀ i, Integrable (D i) := fun i => (hD (J + i) (by omega)).1
  have hPi : ∀ j ∈ Finset.Ico 1 J, Integrable (P j) :=
    fun j hj => (hP j (Finset.mem_Ico.1 hj).2).1
  -- pointwise series representation
  have hEx : ∀ x, smoothErr Ω J x = ∑' i, D i x - ∑ j ∈ Finset.Ico 1 J, P j x := fun x => by
    rw [(hs x).tsum_eq]; ring
  have hformula : ∀ ξ, 𝓕 (smoothErr Ω J) ξ =
      ∑' i : ℕ, 𝓕 (dyadicKernel Ω (J + i)) ξ - bpTau J ξ * dyadicSymbol Ω ξ := by
    intro ξ
    -- the `L¹`-summable series of Fourier integrands
    have hsum : HasSum (fun i => ∫ x, 𝐞 (-⟪x, ξ⟫) • D i x)
        (∫ x, ∑' i, 𝐞 (-⟪x, ξ⟫) • D i x) := by
      refine hasSum_integral_of_summable_integral_norm
        (fun i => (Real.fourierIntegral_convergent_iff ξ).2 (hDi i)) ?_
      refine Summable.of_nonneg_of_le (fun i => integral_nonneg fun _ => norm_nonneg _)
        (fun i => ?_) (summable_geometric_two.mul_left C)
      simp only [Circle.norm_smul]
      refine (hD (J + i) (by omega)).2.trans (le_of_eq ?_)
      rw [show J - (J + (i : ℤ)) = -(i : ℤ) by ring, zpow_neg, zpow_natCast, one_div, inv_pow]
    have hFE : 𝓕 (smoothErr Ω J) ξ = (∫ x, ∑' i, 𝐞 (-⟪x, ξ⟫) • D i x) -
        ∑ j ∈ Finset.Ico 1 J, ∫ x, 𝐞 (-⟪x, ξ⟫) • P j x := by
      rw [Real.fourier_eq]
      have hi2 : ∀ j ∈ Finset.Ico 1 J, Integrable (fun x => 𝐞 (-⟪x, ξ⟫) • P j x) :=
        fun j hj => (Real.fourierIntegral_convergent_iff ξ).2 (hPi j hj)
      have hi1 : Integrable (fun x => ∑' i, 𝐞 (-⟪x, ξ⟫) • D i x) := by
        have h1 : Integrable (fun x => 𝐞 (-⟪x, ξ⟫) • (smoothErr Ω J x +
            ∑ j ∈ Finset.Ico 1 J, P j x)) :=
          (Real.fourierIntegral_convergent_iff ξ).2 (hE.add (integrable_finsetSum _ hPi))
        refine h1.congr (Filter.Eventually.of_forall fun x => ?_)
        simp only [Circle.smul_def, smul_eq_mul]
        rw [tsum_mul_left, (hs x).tsum_eq]
      rw [← integral_finsetSum _ hi2, ← integral_sub hi1 (integrable_finsetSum _ hi2)]
      refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
      simp only [Circle.smul_def, smul_eq_mul]
      rw [hEx x, tsum_mul_left, ← Finset.mul_sum]
      ring
    rw [hFE, ← hsum.tsum_eq]
    simp_rw [← Real.fourier_eq, hFD, hFP]
    obtain ⟨A', -, hA', -⟩ := dyadicSymbol_spec hn hΩ
    rw [dyadicSymbol, tsum_succ_eq_sum_Ico_add_tsum (g := fun j => 𝓕 (dyadicKernel Ω j) ξ)
      (hA' ξ).1.of_norm hJ, tsum_mul_left, ← Finset.mul_sum]
    ring
  have hcont : Continuous (𝓕 (smoothErr Ω J)) :=
    VectorFourier.fourierIntegral_continuous Real.continuous_fourierChar continuous_inner hE
  refine ⟨hE, ?_, hcont, (funext hformula) ▸ hcont, fun ξ => ⟨hsa ξ, hformula ξ⟩⟩
  have h0 := hformula 0
  obtain ⟨-, -, -, hm0⟩ := dyadicSymbol_spec hn hΩ
  simp only [fourier_dyadicKernel_apply_zero hn hΩ, tsum_zero, hm0,
    mul_zero, sub_zero] at h0
  rw [Real.fourier_eq] at h0
  simpa using h0

/-- Blueprint Lemma 4.5 (`lem:smootherrors`), Fourier bound: there is `C` such that for all
`J ≥ 1` and `ξ`, with `R = 2^J`, `|𝓕 E_J(ξ)| ≤ C min(R|ξ|, (R|ξ|)⁻¹)`. -/
theorem norm_fourier_smoothErr_le (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ J : ℤ, 1 ≤ J → ∀ ξ : EuclideanSpace ℝ (Fin n),
      ‖𝓕 (smoothErr Ω J) ξ‖ ≤ C * min (2 ^ J * ‖ξ‖) (2 ^ J * ‖ξ‖)⁻¹ := by
  obtain ⟨S₀, S₁, L, hS₀, hS₁, hL, hτ⟩ := norm_bpTau_le (n := n)
  obtain ⟨A, hA0, hA⟩ := sum_norm_fourier_dyadicKernel_add_le hn hΩ
  obtain ⟨A', hA'0, hA'⟩ := sum_norm_fourier_dyadicKernel_le hn hΩ
  obtain ⟨Ck, hCk0, hCk⟩ := norm_fourier_dyadicKernel_le hn hΩ
  obtain ⟨Am, -, hmK, -⟩ := dyadicSymbol_spec hn hΩ
  have hG := geomZ_nonneg
  refine ⟨L * A + S₀ * Ck * geomZ + (1 + S₀) * (2 * Ck) + S₁ * A', by positivity,
    fun J hJ ξ => ?_⟩
  obtain ⟨-, -, -, -, hF⟩ := fourier_smoothErr hn hΩ hJ
  obtain ⟨hsa, hformula⟩ := hF ξ
  set R : ℝ := (2 : ℝ) ^ J with hR_def
  have hR : 0 < R := by positivity
  set t := R * ‖ξ‖ with ht_def
  have ht0 : 0 ≤ t := by positivity
  set T := ∑' i : ℕ, 𝓕 (dyadicKernel Ω (J + i)) ξ
  set B := ∑ j ∈ Finset.Ico 1 J, 𝓕 (dyadicKernel Ω j) ξ
  have hsplit : 𝓕 (smoothErr Ω J) ξ = (1 - bpTau J ξ) * T - bpTau J ξ * B := by
    rw [hformula, dyadicSymbol, tsum_succ_eq_sum_Ico_add_tsum
      (g := fun j => 𝓕 (dyadicKernel Ω j) ξ) (hmK ξ).1.of_norm hJ]
    ring
  have hT1 : ‖T‖ ≤ A :=
    (norm_tsum_le_tsum_norm hsa).trans (Real.tsum_le_of_sum_le (fun _ => norm_nonneg _)
      (hA J · ξ))
  have hB1 : ‖B‖ ≤ A' := (norm_sum_le _ _).trans (hA' _ ξ)
  have hB2 : ‖B‖ ≤ Ck * geomZ * t := by
    refine (norm_sum_le _ _).trans ?_
    calc ∑ j ∈ Finset.Ico 1 J, ‖𝓕 (dyadicKernel Ω j) ξ‖
        ≤ ∑ j ∈ Finset.Ico 1 J, Ck * ‖ξ‖ / 2 * (2 : ℝ) ^ (j + 1) := by
          refine Finset.sum_le_sum fun j _ => (hCk j ξ).trans ?_
          rw [zpow_add_one₀ two_ne_zero]
          have := min_le_left ((2 : ℝ) ^ j * ‖ξ‖) (2 ^ j * ‖ξ‖)⁻¹
          nlinarith
      _ = Ck * ‖ξ‖ / 2 * ∑ j ∈ Finset.Ico 1 J, (2 : ℝ) ^ (j + 1) := by rw [Finset.mul_sum]
      _ ≤ Ck * ‖ξ‖ / 2 * (2 * geomZ * R) := by
          gcongr; exact sum_Ico_two_zpow_le J
      _ = Ck * geomZ * t := by rw [ht_def]; ring
  have hmain : ‖𝓕 (smoothErr Ω J) ξ‖ ≤ ‖1 - bpTau J ξ‖ * ‖T‖ + ‖bpTau J ξ‖ * ‖B‖ := by
    rw [hsplit, ← norm_mul, ← norm_mul]; exact norm_sub_le _ _
  obtain ⟨hτ0, hτ1, hτ2⟩ := hτ J ξ
  rcases le_or_gt t 1 with ht1 | ht1
  · have hmin : min (2 ^ J * ‖ξ‖) (2 ^ J * ‖ξ‖)⁻¹ = t := by
      rw [← hR_def, ← ht_def]
      apply min_eq_left
      rcases eq_or_lt_of_le ht0 with h | h
      · rw [← h, inv_zero]
      · exact ht1.trans (one_le_inv₀ h |>.2 ht1)
    rw [hmin]
    calc ‖𝓕 (smoothErr Ω J) ξ‖ ≤ ‖1 - bpTau J ξ‖ * ‖T‖ + ‖bpTau J ξ‖ * ‖B‖ := hmain
      _ ≤ (L * t) * A + S₀ * (Ck * geomZ * t) := by
          gcongr
      _ ≤ (L * A + S₀ * Ck * geomZ + (1 + S₀) * (2 * Ck) + S₁ * A') * t := by
          have : 0 ≤ ((1 + S₀) * (2 * Ck) + S₁ * A') * t := by positivity
          nlinarith
  · have ht : 0 < t := by linarith
    have hmin : min (2 ^ J * ‖ξ‖) (2 ^ J * ‖ξ‖)⁻¹ = t⁻¹ := by
      rw [← hR_def, ← ht_def]
      exact min_eq_right (by rw [inv_le_iff_one_le_mul₀ ht]; nlinarith)
    rw [hmin]
    have hξ : 0 < ‖ξ‖ := by
      by_contra h
      have : ‖ξ‖ = 0 := le_antisymm (not_lt.1 h) (norm_nonneg _)
      rw [ht_def, this, mul_zero] at ht; exact lt_irrefl _ ht
    have hT2 : ‖T‖ ≤ 2 * Ck * t⁻¹ := by
      have hb : ∀ i : ℕ, ‖𝓕 (dyadicKernel Ω (J + i)) ξ‖ ≤ Ck * t⁻¹ * (1 / 2) ^ i := by
        intro i
        refine (hCk _ ξ).trans ?_
        rw [mul_assoc]
        refine mul_le_mul_of_nonneg_left ((min_le_right _ _).trans (le_of_eq ?_)) hCk0
        rw [zpow_add₀ two_ne_zero, zpow_natCast, ht_def, hR_def, one_div, inv_pow]
        field_simp
      refine (norm_tsum_le_tsum_norm hsa).trans ?_
      refine (hsa.tsum_le_tsum hb (summable_geometric_two.mul_left _)).trans (le_of_eq ?_)
      rw [tsum_mul_left, tsum_geometric_two]; ring
    have h1τ : ‖1 - bpTau J ξ‖ ≤ 1 + S₀ := (norm_sub_le _ _).trans (by simp [hτ0])
    have hτ' : ‖bpTau J ξ‖ ≤ S₁ * t⁻¹ := by
      rw [le_mul_inv_iff₀ ht]; exact hτ1
    calc ‖𝓕 (smoothErr Ω J) ξ‖ ≤ ‖1 - bpTau J ξ‖ * ‖T‖ + ‖bpTau J ξ‖ * ‖B‖ := hmain
      _ ≤ (1 + S₀) * (2 * Ck * t⁻¹) + S₁ * t⁻¹ * A' := by gcongr
      _ ≤ (L * A + S₀ * Ck * geomZ + (1 + S₀) * (2 * Ck) + S₁ * A') * t⁻¹ := by
          have : 0 ≤ (L * A + S₀ * Ck * geomZ) * t⁻¹ := by positivity
          nlinarith

/-- Helper: `v^{n+1} (1 + v)^{-n-3} ≤ min(v, v⁻¹)` for `v ≥ 0`. -/
lemma pow_div_one_add_pow_le_min {v : ℝ} (hv : 0 ≤ v) :
    v ^ (n + 1) / (1 + v) ^ (n + 3) ≤ min v v⁻¹ := by
  have h1 : 0 < (1 + v) ^ (n + 3) := by positivity
  have hle : v ≤ 1 + v := by linarith
  refine le_min ?_ ?_
  · rw [div_le_iff₀ h1]
    calc v ^ (n + 1) = v * v ^ n := by ring
      _ ≤ v * (1 + v) ^ (n + 3) := by
          gcongr
          exact (pow_le_pow_left₀ hv hle n).trans (pow_le_pow_right₀ (by linarith) (by omega))
  · rcases eq_or_lt_of_le hv with h | h
    · rw [← h]; simp
    · rw [div_le_iff₀ h1, ← div_eq_inv_mul, le_div_iff₀ h]
      calc v ^ (n + 1) * v = v ^ (n + 2) := by ring
        _ ≤ (1 + v) ^ (n + 2) := pow_le_pow_left₀ hv hle _
        _ ≤ (1 + v) ^ (n + 3) := pow_le_pow_right₀ (by linarith) (by omega)

/-- Blueprint Lemma 4.5 (`lem:smootherrors`), uniform `L^p` bound for finite signed sums: for
`1 < p < ∞` there is `C_p` such that for every finite set `S` of integers `J ≥ 1`, all
coefficients `|c_J| ≤ 1`, and all `f ∈ L^p(E)`,
`‖(∑_{J ∈ S} c_J E_J) * f‖_p ≤ C_p ‖f‖_p`. -/
theorem exists_eLpNorm_convolution_sum_smul_smoothErr_le (hn : 1 ≤ n) (hΩ : IsSWProfile Ω)
    {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (S : Finset ℤ), (∀ J ∈ S, 1 ≤ J) → ∀ c : ℤ → ℂ, (∀ J, ‖c J‖ ≤ 1) →
      ∀ f : EuclideanSpace ℝ (Fin n) → ℂ, MemLp f (ENNReal.ofReal p) volume →
        eLpNorm ((∑ J ∈ S, c J • smoothErr Ω J) ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] f)
            (ENNReal.ofReal p) volume ≤
          ENNReal.ofReal C * eLpNorm f (ENNReal.ofReal p) volume := by
  obtain ⟨Cp, hCp, h⟩ := exists_eLpNorm_convolution_le_of_norm_fourier_le (n := n) (by omega) hp
  obtain ⟨CF, hCF0, hCF⟩ := norm_fourier_smoothErr_le hn hΩ
  obtain ⟨CD, hCD0, hCD⟩ := norm_smoothErr_le hn hΩ
  obtain ⟨C₀, hC₀⟩ := sum_min_two_zpow_le
  set A := CF * max C₀ 0
  set B := CD * max C₀ 0
  have hA0 : 0 ≤ A := mul_nonneg hCF0 (le_max_right _ _)
  have hB0 : 0 ≤ B := mul_nonneg hCD0 (le_max_right _ _)
  refine ⟨Cp * max A B, mul_nonneg hCp.le (le_max_of_le_left hA0), fun S hS c hc f hf => ?_⟩
  -- the sum over `S` of the dyadic weights
  have hmin : ∀ t : ℝ, 0 ≤ t → ∑ J ∈ S, min ((2 : ℝ) ^ (-J) * t) ((2 : ℝ) ^ (-J) * t)⁻¹ ≤
      max C₀ 0 := by
    intro t ht
    rcases eq_or_lt_of_le ht with h0 | h0
    · simp [← h0]
    have := hC₀ t h0 (S.map (Equiv.neg ℤ).toEmbedding)
    rw [Finset.sum_map] at this
    exact this.trans (le_max_left _ _)
  have hminJ : ∀ t : ℝ, 0 ≤ t → ∑ J ∈ S, min ((2 : ℝ) ^ J * t) ((2 : ℝ) ^ J * t)⁻¹ ≤
      max C₀ 0 := by
    intro t ht
    rcases eq_or_lt_of_le ht with h0 | h0
    · simp [← h0]
    exact (hC₀ t h0 S).trans (le_max_left _ _)
  have hd : ∀ x, ∀ J ∈ S, HasFDerivAt (c J • smoothErr Ω J)
      (c J • fderiv ℝ (smoothErr Ω J) x) x := fun x J hJ =>
    (((contDiff_smoothErr hn hΩ (hS J hJ)).differentiable (by norm_num)) x).hasFDerivAt.const_smul
      (c J)
  have hsd : ∀ x, HasFDerivAt (∑ J ∈ S, c J • smoothErr Ω J)
      (∑ J ∈ S, c J • fderiv ℝ (smoothErr Ω J) x) x := fun x => HasFDerivAt.sum (hd x)
  refine h _ (max A B) ?_ (fun x _ => (hsd x).differentiableAt) (fun x hx => ?_)
    (fun ξ => ?_) f hf
  · exact integrable_finsetSum' _ fun J hJ => (integrable_smoothErr hn hΩ (hS J hJ)).smul (c J)
  · -- gradient bound
    rw [(hsd x).fderiv]
    have hr : 0 < ‖x‖ := norm_pos_iff.2 hx
    have hterm : ∀ J ∈ S, ‖c J • fderiv ℝ (smoothErr Ω J) x‖ ≤
        CD * min ((2 : ℝ) ^ (-J) * ‖x‖) ((2 : ℝ) ^ (-J) * ‖x‖)⁻¹ / ‖x‖ ^ (n + 1) := by
      intro J hJ
      rw [norm_smul]
      refine (mul_le_of_le_one_left (norm_nonneg _) (hc J)).trans ((hCD J (hS J hJ) x).2.trans ?_)
      have hR : (0 : ℝ) < 2 ^ J := by positivity
      have hv := pow_div_one_add_pow_le_min (n := n) (v := (2 : ℝ) ^ (-J) * ‖x‖) (by positivity)
      have heq : (2 : ℝ) ^ (-J) * ‖x‖ = ‖x‖ / 2 ^ J := by rw [zpow_neg, inv_mul_eq_div]
      rw [heq] at hv ⊢
      rw [mul_div_assoc]
      refine mul_le_mul_of_nonneg_left ?_ hCD0
      calc (((2 : ℝ) ^ J) ^ (n + 1) * (1 + ‖x‖ / 2 ^ J) ^ (n + 3))⁻¹
          = (‖x‖ / 2 ^ J) ^ (n + 1) / (1 + ‖x‖ / 2 ^ J) ^ (n + 3) / ‖x‖ ^ (n + 1) := by
            rw [div_pow]; field_simp
        _ ≤ _ := div_le_div_of_nonneg_right hv (by positivity)
    calc ‖∑ J ∈ S, c J • fderiv ℝ (smoothErr Ω J) x‖
        ≤ ∑ J ∈ S, CD * min ((2 : ℝ) ^ (-J) * ‖x‖) ((2 : ℝ) ^ (-J) * ‖x‖)⁻¹ / ‖x‖ ^ (n + 1) :=
          (norm_sum_le _ _).trans (Finset.sum_le_sum hterm)
      _ = CD * (∑ J ∈ S, min ((2 : ℝ) ^ (-J) * ‖x‖) ((2 : ℝ) ^ (-J) * ‖x‖)⁻¹) / ‖x‖ ^ (n + 1) := by
          rw [Finset.mul_sum, Finset.sum_div]
      _ ≤ CD * max C₀ 0 / ‖x‖ ^ (n + 1) := by gcongr; exact hmin _ hr.le
      _ ≤ max A B / ‖x‖ ^ (n + 1) := by gcongr; exact le_max_right _ _
  · rw [fourier_finsetSum_smul S c (fun J hJ => integrable_smoothErr hn hΩ (hS J hJ))]
    calc ‖∑ J ∈ S, c J * 𝓕 (smoothErr Ω J) ξ‖
        ≤ ∑ J ∈ S, CF * min ((2 : ℝ) ^ J * ‖ξ‖) ((2 : ℝ) ^ J * ‖ξ‖)⁻¹ := by
          refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun J hJ => ?_)
          rw [norm_mul]
          exact (mul_le_of_le_one_left (norm_nonneg _) (hc J)).trans (hCF J (hS J hJ) ξ)
      _ = CF * ∑ J ∈ S, min ((2 : ℝ) ^ J * ‖ξ‖) ((2 : ℝ) ^ J * ‖ξ‖)⁻¹ := by
          rw [Finset.mul_sum]
      _ ≤ CF * max C₀ 0 := by gcongr; exact hminJ _ (norm_nonneg _)
      _ ≤ max A B := le_max_left _ _

/-- Blueprint Lemma 4.5 (`lem:smootherrors`), (4.6) as an `L¹` limit: for `J ≥ 1` the partial
sums `∑_{J ≤ j < J + N} (K_j - φ_J * K_j) - ∑_{1 ≤ j < J} φ_J * K_j` converge to `E_J` in
`L¹(E)` as `N → ∞`. -/
theorem tendsto_eLpNorm_smoothErr_sub_partialSum (hn : 1 ≤ n) (hΩ : IsSWProfile Ω) {J : ℤ}
    (hJ : 1 ≤ J) :
    Filter.Tendsto (fun N : ℕ => eLpNorm (smoothErr Ω J -
        (∑ i ∈ Finset.range N, (dyadicKernel Ω (J + i) -
          bpPhiDilC J ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] dyadicKernel Ω (J + i)) -
        ∑ j ∈ Finset.Ico 1 J, bpPhiDilC J ⋆[ContinuousLinearMap.mul ℂ ℂ, volume]
          dyadicKernel Ω j)) 1 volume) Filter.atTop (nhds 0) := by
  obtain ⟨C, hC0, hC⟩ := smoothErr_hasSum hn hΩ
  obtain ⟨hD, -, hs⟩ := hC J hJ
  set D : ℕ → EuclideanSpace ℝ (Fin n) → ℂ := fun i =>
    dyadicKernel Ω (J + i) - bpPhiDilC J ⋆[ContinuousLinearMap.mul ℂ ℂ, volume]
      dyadicKernel Ω (J + i) with hD_def
  have hDi : ∀ i, Integrable (D i) := fun i => (hD (J + i) (by omega)).1
  have hDn : ∀ i, ∫ x, ‖D i x‖ ≤ C * (1 / 2) ^ i := fun i => by
    refine (hD (J + i) (by omega)).2.trans (le_of_eq ?_)
    rw [show J - (J + (i : ℤ)) = -(i : ℤ) by ring, zpow_neg, zpow_natCast, one_div, inv_pow]
  have hbound : ∀ N : ℕ, eLpNorm (smoothErr Ω J -
      (∑ i ∈ Finset.range N, D i - ∑ j ∈ Finset.Ico 1 J,
        bpPhiDilC J ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] dyadicKernel Ω j)) 1 volume ≤
      ENNReal.ofReal (2 * C * (1 / 2) ^ N) := by
    intro N
    have htail : ∀ x, (smoothErr Ω J - (∑ i ∈ Finset.range N, D i - ∑ j ∈ Finset.Ico 1 J,
        bpPhiDilC J ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] dyadicKernel Ω j)) x =
        ∑' i, D (i + N) x := by
      intro x
      have h1 := (hs x).tsum_eq
      have h2 := (hs x).summable.sum_add_tsum_nat_add N
      simp only [Pi.sub_apply, Finset.sum_apply]
      change ∑ i ∈ Finset.range N, D i x + ∑' i, D (i + N) x = ∑' i, D i x at h2
      rw [← h2] at h1
      linear_combination (-1 : ℂ) * h1
    have hmeas : AEStronglyMeasurable (smoothErr Ω J -
        (∑ i ∈ Finset.range N, D i - ∑ j ∈ Finset.Ico 1 J,
          bpPhiDilC J ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] dyadicKernel Ω j)) volume :=
      ((integrable_smoothErr hn hΩ hJ).sub ((integrable_finsetSum' _ fun i _ => hDi i).sub
        (integrable_finsetSum' _ fun j _ => (integrable_bpPhiDilC J).integrable_convolution _
          (integrable_dyadicKernel hΩ j)))).aestronglyMeasurable
    rw [eLpNorm_one_eq_lintegral_enorm hmeas]
