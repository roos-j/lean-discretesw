    congr 2; ring
  · rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (liftChi_nonneg s ξ)]
    have h1 := (continuous_radialOscPhi_and_le (d := d) hΩ (a u).1 (a u).2).2 ξ
    have h2 : ∫ x, ‖bandKer n d Ω (a u) x‖ ≤ B :=
