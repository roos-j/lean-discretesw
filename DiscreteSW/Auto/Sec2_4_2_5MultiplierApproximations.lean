/-! ## Lemma 2.7 (`lem:binary`): binary partial sums -/

/-- Blueprint Lemma 2.7 (`lem:binary`, "Binary partial sums"): for `u_1, …, u_{2^L}` in a
(semi)normed group (e.g. `ℂ`) and the dyadic intervals `I_{l,k} = {k 2^l + 1, …, (k+1) 2^l}`,
`0 ≤ l ≤ L`, `0 ≤ k < 2^{L-l}`, every partial sum with `0 ≤ J ≤ 2^L` satisfies
`|∑_{j=1}^J u_j| ≤ ∑_{l=0}^L (∑_{k=0}^{2^{L-l}-1} |∑_{j ∈ I_{l,k}} u_j|²)^{1/2}`
(equivalently, the maximum over `J` is bounded by the right side). -/
theorem binary_maximal_inequality {E : Type*} [SeminormedAddCommGroup E] (L : ℕ) (u : ℕ → E) :
    ∀ J ≤ 2 ^ L, ‖∑ j ∈ Finset.Icc 1 J, u j‖ ≤
      ∑ l ∈ Finset.range (L + 1), Real.sqrt (∑ k ∈ Finset.range (2 ^ (L - l)),
        ‖∑ j ∈ Finset.Icc (k * 2 ^ l + 1) ((k + 1) * 2 ^ l), u j‖ ^ 2) := by
  intro J hJ
  have hIoc : ∀ a b : ℕ, Finset.Icc (a + 1) b = Finset.Ioc a b := by
    intro a b; ext; simp only [Finset.mem_Icc, Finset.mem_Ioc]; omega
  set F : ℕ → E := fun n => ∑ j ∈ Finset.Ioc 0 n, u j with hF
  have hdiff : ∀ a b, a ≤ b → F b - F a = ∑ j ∈ Finset.Ioc a b, u j := by
    intro a b hab
    rw [sub_eq_iff_eq_add', hF]
    exact (Finset.sum_Ioc_consecutive u (Nat.zero_le a) hab).symm
  have tele : ∑ j ∈ Finset.Icc 1 J, u j =
      ∑ l ∈ Finset.range (L + 1), (F (J / 2 ^ l * 2 ^ l) - F (J / 2 ^ (l + 1) * 2 ^ (l + 1))) := by
    rw [Finset.sum_range_sub' (fun l => F (J / 2 ^ l * 2 ^ l))]
    have h0 : J / 2 ^ (L + 1) = 0 :=
      Nat.div_eq_of_lt (lt_of_le_of_lt hJ (Nat.pow_lt_pow_right (by norm_num) (Nat.lt_succ_self L)))
    simp [hF, h0, hIoc]
  rw [tele]
  refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun l hl => ?_)
  have hlL : l ≤ L := Nat.lt_succ_iff.1 (Finset.mem_range.1 hl)
  set a := J / 2 ^ l with ha
  have hdiv : J / 2 ^ (l + 1) = a / 2 := by
    rw [ha, Nat.div_div_eq_div_mul, pow_succ]
  rw [hdiv]
  have hsq0 : 0 ≤ Real.sqrt (∑ k ∈ Finset.range (2 ^ (L - l)),
      ‖∑ j ∈ Finset.Icc (k * 2 ^ l + 1) ((k + 1) * 2 ^ l), u j‖ ^ 2) := Real.sqrt_nonneg _
  rcases Nat.even_or_odd a with he | ho
  · have : a / 2 * 2 ^ (l + 1) = a * 2 ^ l := by
      obtain ⟨m, hm⟩ := he
      rw [hm, pow_succ]
      rw [show m + m = m * 2 by ring, Nat.mul_div_cancel _ (by norm_num)]; ring
    rw [this, sub_self, norm_zero]
    exact hsq0
  · have ha1 : 1 ≤ a := ho.pos
    have : a / 2 * 2 ^ (l + 1) = (a - 1) * 2 ^ l := by
      obtain ⟨m, hm⟩ := ho
      rw [hm, pow_succ, show 2 * m + 1 - 1 = m * 2 by omega,
        show (2 * m + 1) / 2 = m by omega]; ring
    have hle : (a - 1) * 2 ^ l ≤ a * 2 ^ l := Nat.mul_le_mul_right _ (Nat.sub_le a 1)
    rw [this, hdiff _ _ hle]
    have hk : a - 1 ∈ Finset.range (2 ^ (L - l)) := by
      have : a ≤ 2 ^ (L - l) := by
        rw [ha]
        refine Nat.div_le_of_le_mul ?_
        rw [← pow_add, Nat.add_sub_cancel' hlL]; exact hJ
      exact Finset.mem_range.2 (by omega)
    have hk1 : a - 1 + 1 = a := Nat.sub_add_cancel ha1
    have hterm := Finset.single_le_sum (f := fun k =>
      ‖∑ j ∈ Finset.Icc (k * 2 ^ l + 1) ((k + 1) * 2 ^ l), u j‖ ^ 2)
      (fun k _ => sq_nonneg _) hk
    simp only [hk1, hIoc] at hterm
    have := Real.abs_le_sqrt hterm
    rw [abs_of_nonneg (norm_nonneg _)] at this
    simpa only [hIoc] using this

end BinaryPartialSums

