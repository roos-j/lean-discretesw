  rw [← h1, ← Set.image_vadd]
  simp only [vadd_eq_add]
  rw [(measurePreserving_add_left volume a).setIntegral_image_emb (measurableEmbedding_addLeft a)]
  simp_rw [add_comm a]

/-- Tiling `E` by the translates of `[0,1)ⁿ`: for integrable `F`,
`∑_{k ∈ ℤⁿ} ∫_{[0,1)ⁿ} F(ξ + k) dξ = ∫_E F`, with absolute convergence. -/
theorem hasSum_setIntegral_torusCube_add {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
    [CompleteSpace F] {g : EuclideanSpace ℝ (Fin n) → F} (hg : Integrable g) :
