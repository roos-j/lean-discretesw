/-! ### The unit cube and the lattice -/

/-- The unit cube `[0,1)ⁿ ⊂ E`, a fundamental domain of `ι(G)`; torus integrals are taken over it
with respect to `volume` (mass one, `volume_torusCube`). -/
def torusCube (n : ℕ) : Set (EuclideanSpace ℝ (Fin n)) := {ξ | ∀ i, 0 ≤ ξ i ∧ ξ i < 1}

/-- The lattice `ι(G) = ℤⁿ ⊂ E` as the `ℤ`-span of the standard basis (used to access Mathlib's
fundamental-domain API; `mem_torusLattice` identifies it with the range of `latEmbed`). -/
noncomputable def torusLattice (n : ℕ) : Submodule ℤ (EuclideanSpace ℝ (Fin n)) :=
  Submodule.span ℤ (range (EuclideanSpace.basisFun (Fin n) ℝ).toBasis)

instance : Countable (torusLattice n) := by unfold torusLattice; infer_instance

/-- `v ∈ ι(G)` iff `v = ι k` for some `k ∈ ℤⁿ`. -/
lemma mem_torusLattice {v : EuclideanSpace ℝ (Fin n)} :
    v ∈ torusLattice n ↔ ∃ k : Fin n → ℤ, latEmbed k = v := by
  unfold torusLattice
  rw [Module.Basis.mem_span_iff_repr_mem]
  simp only [OrthonormalBasis.coe_toBasis_repr_apply, EuclideanSpace.basisFun_repr,
    algebraMap_int_eq, eq_intCast, mem_range]
  constructor
  · intro h
    choose k hk using h
    exact ⟨k, PiLp.ext fun i => by simp [hk i]⟩
  · rintro ⟨k, rfl⟩ i
    exact ⟨k i, by simp⟩

lemma latEmbed_injective : Function.Injective (latEmbed (n := n)) := by
  intro k j h
  funext i
  have := congrArg (fun v : EuclideanSpace ℝ (Fin n) => v i) h
  simpa using this

/-- The bijection `ℤⁿ ≃ ι(ℤⁿ)`. -/
noncomputable def latEquiv (n : ℕ) : (Fin n → ℤ) ≃ torusLattice n :=
  Equiv.ofBijective (fun k => ⟨latEmbed k, mem_torusLattice.2 ⟨k, rfl⟩⟩)
    ⟨fun k j h => latEmbed_injective (congrArg Subtype.val h),
     fun l => by obtain ⟨k, hk⟩ := mem_torusLattice.1 l.2; exact ⟨k, Subtype.ext hk⟩⟩

@[simp] lemma coe_latEquiv (k : Fin n → ℤ) : ((latEquiv n k : torusLattice n) :
    EuclideanSpace ℝ (Fin n)) = latEmbed k := rfl

lemma torusCube_eq_fundamentalDomain :
    torusCube n = ZSpan.fundamentalDomain (EuclideanSpace.basisFun (Fin n) ℝ).toBasis := by
  ext ξ; simp [torusCube, ZSpan.mem_fundamentalDomain]

/-- `[0,1)ⁿ` is a fundamental domain for `ι(G)` acting on `E` by translation. -/
lemma isAddFundamentalDomain_torusCube :
    IsAddFundamentalDomain (torusLattice n) (torusCube n) volume := by
  rw [torusCube_eq_fundamentalDomain]; exact ZSpan.isAddFundamentalDomain _ _

lemma measurableSet_torusCube : MeasurableSet (torusCube n) := by
  rw [torusCube_eq_fundamentalDomain]; exact ZSpan.fundamentalDomain_measurableSet _

/-- The torus `[0,1)ⁿ` has mass one. -/
lemma volume_torusCube : volume (torusCube n) = 1 := by
  have h : torusCube n = (WithLp.ofLp (p := 2)) ⁻¹' Set.pi univ (fun _ : Fin n => Ico (0 : ℝ) 1) := by
    ext ξ; simp [torusCube]
  rw [h, (PiLp.volume_preserving_ofLp (Fin n)).measure_preimage
    (MeasurableSet.univ_pi fun _ => measurableSet_Ico).nullMeasurableSet]
  simp [volume_pi, Measure.pi_pi]

instance : VAddInvariantMeasure (torusLattice n) (EuclideanSpace ℝ (Fin n)) volume :=
  inferInstanceAs <| VAddInvariantMeasure (torusLattice n).toAddSubgroup _ _

instance : IsFiniteMeasure (volume.restrict (torusCube n)) :=
  isFiniteMeasure_restrict.2 (by rw [volume_torusCube]; exact ENNReal.one_ne_top)

lemma inner_latEmbed_latEmbed (k j : Fin n → ℤ) :
    inner ℝ (latEmbed k) (latEmbed j) = ((∑ i, k i * j i : ℤ) : ℝ) := by
  simp [PiLp.inner_apply, mul_comm]

/-- `e(k · j) = 1` for `k, j ∈ ℤⁿ`. -/
lemma eC_inner_latEmbed_latEmbed (k j : Fin n → ℤ) :
    eC (inner ℝ (latEmbed k) (latEmbed j)) = 1 := by
  rw [inner_latEmbed_latEmbed, eC_intCast]

/-- Integrals of `ι(G)`-periodic functions over `[0,1)ⁿ` are translation invariant. -/
theorem setIntegral_torusCube_comp_add {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
    {g : EuclideanSpace ℝ (Fin n) → F} (hg : ∀ ξ (k : Fin n → ℤ), g (ξ + latEmbed k) = g ξ)
