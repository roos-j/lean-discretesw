/-! ### Definitions -/

/-- The finite-kernel operator `T_{j,λ} f(x) = ∑_{y ∈ G} e(λ P(y)) K_j(y) f(x - y)` of blueprint
§8 (`P = radialPolyZ n d`, `K_j = dyadicKernel Ω j`; the sum has finitely many nonzero terms). -/
noncomputable def minorOp {n : ℕ} (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (d j : ℕ) (lam : ℝ)
    (f : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) : ℂ :=
  ∑' y : Fin n → ℤ, eC (lam * (radialPolyZ n d y : ℝ)) * dyadicKernel Ω j (latEmbed y) * f (x - y)

/-- The denominator bound `H_j = 2^{⌊M log₂(j+1)⌋}` of blueprint §8. -/
noncomputable def minorH (M j : ℕ) : ℕ := 2 ^ ⌊(M : ℝ) * Real.logb 2 ((j : ℝ) + 1)⌋₊

/-- The arc width `w_j = (j+1)^M 2^{-Dj}`, `D = 2d`, of blueprint §8. -/
noncomputable def minorW (d M j : ℕ) : ℝ := ((j : ℝ) + 1) ^ M / (2 : ℝ) ^ (2 * d * j)

/-- The major parameter arcs `X_j = ⋃_{1 ≤ q < H_j, 0 ≤ a < q, (a,q) = 1} {λ : ‖λ - a/q‖_𝕋 ≤ w_j}`
of blueprint §8, as a (`1`-periodic) set of real parameters. -/
def minorArcs (d M j : ℕ) : Set ℝ :=
  {lam | ∃ q a : ℕ, 1 ≤ q ∧ q < minorH M j ∧ a < q ∧ Nat.Coprime a q ∧
    ‖((lam - a / q : ℝ) : UnitAddCircle)‖ ≤ minorW d M j}

/-! ### Arithmetic of the major arcs -/

/-- `H_j ≥ (j+1)^M / 2`. -/
lemma minorH_ge (M j : ℕ) : ((j : ℝ) + 1) ^ M / 2 ≤ minorH M j := by
  set x : ℝ := (M : ℝ) * Real.logb 2 ((j : ℝ) + 1) with hx
  have hj : (0 : ℝ) < (j : ℝ) + 1 := by positivity
  have hx0 : 0 ≤ x := mul_nonneg (Nat.cast_nonneg _)
    (Real.logb_nonneg (by norm_num) (by linarith [(Nat.cast_nonneg j : (0 : ℝ) ≤ j)]))
  have h2x : (2 : ℝ) ^ x = ((j : ℝ) + 1) ^ M := by
    rw [hx, mul_comm, Real.rpow_mul (by norm_num), Real.rpow_logb (by norm_num) (by norm_num) hj,
      Real.rpow_natCast]
  have hfl : x - 1 < (⌊x⌋₊ : ℝ) := Nat.sub_one_lt_floor x
  rw [minorH, Nat.cast_pow, Nat.cast_ofNat, ← h2x, ← Real.rpow_natCast]
  calc (2 : ℝ) ^ x / 2 = (2 : ℝ) ^ (x - 1) := by
        rw [Real.rpow_sub (by norm_num), Real.rpow_one]
    _ ≤ (2 : ℝ) ^ (⌊x⌋₊ : ℝ) := Real.rpow_le_rpow_of_exponent_le (by norm_num) hfl.le

/-- A rational approximation `‖q' λ‖_𝕋 ≤ w_j` with `1 ≤ q' < H_j` puts `λ` into `X_j`
(reduce the fraction `round(q'λ)/q'` to lowest terms). -/
lemma minor_mem_arcs_of_approx {d M j q' : ℕ} {lam : ℝ} (hq' : 1 ≤ q') (hqH : q' < minorH M j)
    (happ : ‖((q' * lam : ℝ) : UnitAddCircle)‖ ≤ minorW d M j) : lam ∈ minorArcs d M j := by
  set a' : ℤ := round ((q' : ℝ) * lam) with ha'
  have hq'0 : (0 : ℤ) < q' := by exact_mod_cast hq'
  set g : ℕ := Int.gcd a' q' with hg
  have hg0 : 0 < g := Int.gcd_pos_of_ne_zero_right _ hq'0.ne'
  set q : ℤ := (q' : ℤ) / g
  set a₀ : ℤ := a' / g
  have hgq : (g : ℤ) ∣ q' := Int.gcd_dvd_right _ _
  have hga : (g : ℤ) ∣ a' := Int.gcd_dvd_left _ _
  have hq'eq : (q' : ℤ) = q * g := (Int.ediv_mul_cancel hgq).symm
  have ha'eq : a' = a₀ * g := (Int.ediv_mul_cancel hga).symm
  have hq0 : 0 < q := by
    rcases lt_trichotomy q 0 with h | h | h
    · nlinarith
    · rw [h, zero_mul] at hq'eq; omega
    · exact h
  have hcop : Int.gcd a₀ q = 1 := Int.gcd_div_gcd_div_gcd hg0
  set a : ℤ := a₀ % q with ha
  have ha0 : 0 ≤ a := Int.emod_nonneg _ hq0.ne'
  have haq : a < q := Int.emod_lt_of_pos _ hq0
  have hqq' : q ≤ q' := by
    rw [hq'eq]; exact le_mul_of_one_le_right hq0.le (by exact_mod_cast hg0)
  refine ⟨q.toNat, a.toNat, by omega, ?_, by omega, ?_, ?_⟩
  · have : (q.toNat : ℤ) ≤ q' := by omega
    exact lt_of_le_of_lt (by exact_mod_cast this) hqH
  · have h1 : Int.gcd a q = 1 := by rw [ha, Int.gcd_emod, hcop]
    rw [Nat.Coprime, ← h1, ← Int.gcd_natCast_natCast, Int.toNat_of_nonneg ha0,
      Int.toNat_of_nonneg hq0.le]
  · have hqR : (0 : ℝ) < q := by exact_mod_cast hq0
    have hcastq : ((q.toNat : ℕ) : ℝ) = (q : ℝ) := by exact_mod_cast Int.toNat_of_nonneg hq0.le
    have hcasta : ((a.toNat : ℕ) : ℝ) = (a : ℝ) := by exact_mod_cast Int.toNat_of_nonneg ha0
    rw [hcastq, hcasta]
    -- `a/q = a₀/q - ⌊a₀/q⌋` as integers
    have hdiv : (a₀ : ℝ) = q * ((a₀ / q : ℤ) : ℝ) + a := by
      have := Int.emod_add_mul_ediv a₀ q
      rw [← ha] at this
      have h' : (a₀ : ℝ) = ((a + q * (a₀ / q) : ℤ) : ℝ) := by rw [this]
      rw [h']; push_cast; ring
    have hshift : lam - (a : ℝ) / q = (lam - (a₀ : ℝ) / q) + ((a₀ / q : ℤ) : ℝ) := by
      rw [hdiv]; field_simp; ring
    rw [hshift, tnorm_add_intCast]
    refine le_trans ?_ happ
    rw [UnitAddCircle.norm_eq (x := (q' : ℝ) * lam), ← ha']
    have hq'R : (1 : ℝ) ≤ q' := by exact_mod_cast hq'
    have hkey : lam - (a₀ : ℝ) / q = ((q' : ℝ) * lam - a') / q' := by
      have hq'R' : (q' : ℝ) = q * g := by exact_mod_cast hq'eq
      have ha'R : (a' : ℝ) = a₀ * g := by exact_mod_cast ha'eq
      have hgR : (0 : ℝ) < g := by exact_mod_cast hg0
      rw [ha'R, hq'R']; field_simp
    refine (show ‖((lam - (a₀ : ℝ) / q : ℝ) : UnitAddCircle)‖ ≤ |lam - (a₀ : ℝ) / q| by
      rw [UnitAddCircle.norm_eq]; simpa using round_le (lam - (a₀ : ℝ) / q) 0).trans ?_
    rw [hkey, abs_div, abs_of_pos (by linarith : (0 : ℝ) < q')]
    exact div_le_self (abs_nonneg _) hq'R

/-- The counting step of Blueprint Lemma 8.1 (`lem:minorL2`), with explicit size conditions: let
`λ ∉ X_j`, `Q ≥ 1`, `0 < η ≤ 1`, and let `T` be a set of integers `h` with `|h| ≤ 4 · 2^j`, each
admitting some `1 ≤ q ≤ Q` with `‖q D h λ‖_𝕋 ≤ Q 2^{-j(D-1)}` (`D = 2d`). If
`640 Q² ≤ η 2^j`, `2400 Q² ≤ η² 2^j`, `160 d Q² < η (j+1)^M` and `2400 Q³ ≤ η² (j+1)^M`, then
`#T < η 2^j` (pigeonhole in `q`, then Lemma 3.3, then reduction of the fraction). -/
lemma minor_card_lt_core {d M j : ℕ} (hd : 1 ≤ d) {lam Q η : ℝ} (hlam : lam ∉ minorArcs d M j)
    (hQ : 1 ≤ Q) (hη : 0 < η) (hη1 : η ≤ 1)
    (hA : 640 * Q ^ 2 ≤ η * 2 ^ j) (hB : 2400 * Q ^ 2 ≤ η ^ 2 * 2 ^ j)
    (hC : 160 * d * Q ^ 2 < η * ((j : ℝ) + 1) ^ M)
    (hD : 2400 * Q ^ 3 ≤ η ^ 2 * ((j : ℝ) + 1) ^ M) (T : Finset ℤ)
    (hT : ∀ h ∈ T, |(h : ℝ)| ≤ 4 * 2 ^ j ∧ ∃ q : ℕ, 1 ≤ q ∧ (q : ℝ) ≤ Q ∧
      ‖((q * (2 * d) * h * lam : ℝ) : UnitAddCircle)‖ ≤ Q / ((2 : ℝ) ^ j) ^ (2 * d - 1)) :
    (#T : ℝ) < η * 2 ^ j := by
  by_contra hcon
  push Not at hcon
  have hQ0 : 0 < Q := by linarith
  have hR1 : (1 : ℝ) ≤ 2 ^ j := one_le_pow₀ (by norm_num)
  have hR0 : (0 : ℝ) < 2 ^ j := by positivity
  have hex : ∀ h, ∃ q : ℕ, h ∈ T → 1 ≤ q ∧ (q : ℝ) ≤ Q ∧
      ‖((q * (2 * d) * h * lam : ℝ) : UnitAddCircle)‖ ≤ Q / ((2 : ℝ) ^ j) ^ (2 * d - 1) := by
    intro h
    by_cases hh : h ∈ T
    · obtain ⟨q, hq⟩ := (hT h hh).2
      exact ⟨q, fun _ => hq⟩
    · exact ⟨0, fun h' => absurd h' hh⟩
  choose qf hqf using hex
  set t : Finset ℕ := Icc 1 ⌊Q⌋₊
  have hmaps : ∀ h ∈ T, qf h ∈ t := fun h hh => by
    obtain ⟨h1, h2, -⟩ := hqf h hh
    exact mem_Icc.2 ⟨h1, Nat.le_floor h2⟩
  have hfl1 : 1 ≤ ⌊Q⌋₊ := Nat.one_le_floor_iff _ |>.2 hQ
  have ht : t.Nonempty := ⟨1, mem_Icc.2 ⟨le_rfl, hfl1⟩⟩
  have hb : #t • (η * 2 ^ j / Q) ≤ (#T : ℝ) := by
    rw [nsmul_eq_mul, Nat.card_Icc, Nat.add_sub_cancel]
    calc (⌊Q⌋₊ : ℝ) * (η * 2 ^ j / Q) ≤ Q * (η * 2 ^ j / Q) :=
          mul_le_mul_of_nonneg_right (Nat.floor_le hQ0.le) (by positivity)
      _ = η * 2 ^ j := by field_simp
      _ ≤ #T := hcon
  obtain ⟨q, hqt, hfib⟩ := exists_le_card_fiber_of_nsmul_le_card_of_maps_to hmaps ht hb
  set H' : Finset ℤ := {h ∈ T | qf h = q}
  have hq1 : 1 ≤ q := (mem_Icc.1 hqt).1
  have hqQ : (q : ℝ) ≤ Q := by
    have := (mem_Icc.1 hqt).2
    exact (Nat.cast_le.2 this).trans (Nat.floor_le hQ0.le)
  set α : ℝ := q * (2 * d) * lam
  set E : ℝ := Q / ((2 : ℝ) ^ j) ^ (2 * d - 1)
  have hpowle : (2 : ℝ) ^ j ≤ ((2 : ℝ) ^ j) ^ (2 * d - 1) := le_self_pow₀ hR1 (by omega)
  have hE : E ≤ η / Q / (128 * (4 + 1)) := by
    calc E ≤ Q / 2 ^ j := div_le_div_of_nonneg_left hQ0.le hR0 hpowle
      _ ≤ η / Q / (128 * (4 + 1)) := by
        rw [div_div, div_le_div_iff₀ hR0 (by positivity)]; nlinarith
  have hN : 384 * (4 + 1) ^ 2 / (4 * (η / Q) ^ 2) ≤ ((2 ^ j : ℕ) : ℝ) := by
    rw [Nat.cast_pow, Nat.cast_ofNat, div_le_iff₀ (by positivity)]
    have : 2 ^ j * (4 * (η / Q) ^ 2) = 4 * (η ^ 2 * 2 ^ j) / Q ^ 2 := by field_simp
    rw [this, le_div_iff₀ (by positivity)]; nlinarith
  have hH : ∀ h ∈ H', |(h : ℝ)| ≤ 4 * ((2 ^ j : ℕ) : ℝ) := fun h hh => by
    rw [Nat.cast_pow, Nat.cast_ofNat]; exact (hT h (mem_filter.1 hh).1).1
  have hcard : η / Q * ((2 ^ j : ℕ) : ℝ) ≤ #H' := by
    rw [Nat.cast_pow, Nat.cast_ofNat]
    refine le_trans (le_of_eq ?_) hfib
    ring
  have hHE : ∀ h ∈ H', ‖((h * α : ℝ) : UnitAddCircle)‖ ≤ E := fun h hh => by
    obtain ⟨hhT, hhq⟩ := mem_filter.1 hh
    have := (hqf h hhT).2.2
    rw [hhq] at this
    convert this using 3
    simp only [α]; ring
  obtain ⟨r, hr1, hr2, hr3⟩ := norm_mul_le_of_many_multiples_int (by norm_num : (0 : ℝ) < 4)
    (div_pos hη hQ0) (div_le_one_of_le₀ (hη1.trans hQ) hQ0.le) (by positivity) hE hN hH hcard hHE
  set q' : ℕ := r * q * (2 * d)
  have hq'1 : 1 ≤ q' := by
    have : 1 ≤ r * q := Nat.one_le_iff_ne_zero.2 (by positivity)
    exact le_trans this (Nat.le_mul_of_pos_right _ (by omega))
  apply hlam
  refine minor_mem_arcs_of_approx (q' := q') hq'1 ?_ ?_
  · -- `q' < H_j`
    have hr2' : (r : ℝ) ≤ 40 * Q / η := by
      refine hr2.trans (le_of_eq ?_); field_simp; ring
    have hq'R : (q' : ℝ) ≤ 80 * d * Q ^ 2 / η := by
      simp only [q']; push_cast
      calc (r : ℝ) * q * (2 * d) ≤ (40 * Q / η) * Q * (2 * d) := by gcongr
        _ = 80 * d * Q ^ 2 / η := by ring
    have hlt : 80 * d * Q ^ 2 / η < ((j : ℝ) + 1) ^ M / 2 := by
      rw [div_lt_div_iff₀ hη (by norm_num)]; linarith
    exact_mod_cast (lt_of_le_of_lt hq'R (lt_of_lt_of_le hlt (minorH_ge M j)))
  · -- `‖q' λ‖ ≤ w_j`
    have heq : ((q' : ℕ) : ℝ) * lam = r * α := by simp only [q', α]; push_cast; ring
    rw [heq]
    refine hr3.trans ?_
    have hpow : ((2 : ℝ) ^ j) ^ (2 * d - 1) * 2 ^ j = (2 : ℝ) ^ (2 * d * j) := by
      rw [← pow_succ, Nat.sub_add_cancel (by omega), ← pow_mul, mul_comm]
    rw [minorW, Nat.cast_pow, Nat.cast_ofNat]
    have hR' : (0 : ℝ) < (2 : ℝ) ^ (2 * d * j) := by positivity
    have : 384 * (4 + 1) ^ 2 / 4 * E / ((η / Q) ^ 2 * 2 ^ j) =
        2400 * Q ^ 3 / (η ^ 2 * (2 : ℝ) ^ (2 * d * j)) := by
      simp only [E]; rw [← hpow]; field_simp; ring
    rw [this, div_le_div_iff₀ (by positivity) hR']
    nlinarith

/-- `c j^K ≤ 2^j` for all large `j`. -/
lemma minor_eventually_pow_le_two_pow (c : ℝ) (K : ℕ) :
    ∃ j₀ : ℕ, ∀ j ≥ j₀, c * (j : ℝ) ^ K ≤ 2 ^ j := by
  have ht := tendsto_pow_const_div_const_pow_of_one_lt K (r := 2) one_lt_two
  have hc : (0 : ℝ) < 1 / (|c| + 1) := by positivity
  obtain ⟨j₀, hj₀⟩ := Filter.eventually_atTop.1 (ht.eventually (gt_mem_nhds hc))
  refine ⟨j₀, fun j hj => ?_⟩
  have h := hj₀ j hj
  have h2 : (0 : ℝ) < 2 ^ j := by positivity
  rw [div_lt_div_iff₀ h2 (by positivity), one_mul] at h
  have h3 : c * (j : ℝ) ^ K ≤ |c| * (j : ℝ) ^ K :=
    mul_le_mul_of_nonneg_right (le_abs_self c) (by positivity)
  nlinarith [pow_nonneg (Nat.cast_nonneg j : (0 : ℝ) ≤ j) K, abs_nonneg c]

/-- The counting step of Blueprint Lemma 8.1 (`lem:minorL2`) with `Q = C_W j^B` and
`η = j^{-V}`: there are `M₀, j₁` such that for all `M ≥ M₀`, `j ≥ j₁` and `λ ∉ X_j`, a set `T`
of integers `|h| ≤ 4 · 2^j`, each with some `1 ≤ q ≤ C_W j^B` and
`‖q D h λ‖_𝕋 ≤ C_W j^B 2^{-j(D-1)}`, has fewer than `j^{-V} 2^j` elements. -/
lemma minor_card_lt {d : ℕ} (hd : 1 ≤ d) {Cw : ℝ} (hCw : 1 ≤ Cw) (B V : ℕ) :
    ∃ M₀ j₁ : ℕ, 1 ≤ M₀ ∧ 1 ≤ j₁ ∧ ∀ M ≥ M₀, ∀ j ≥ j₁, ∀ lam ∉ minorArcs d M j,
      ∀ T : Finset ℤ, (∀ h ∈ T, |(h : ℝ)| ≤ 4 * 2 ^ j ∧ ∃ q : ℕ, 1 ≤ q ∧
        (q : ℝ) ≤ Cw * (j : ℝ) ^ B ∧
        ‖((q * (2 * d) * h * lam : ℝ) : UnitAddCircle)‖ ≤
          Cw * (j : ℝ) ^ B / ((2 : ℝ) ^ j) ^ (2 * d - 1)) →
      (#T : ℝ) < 1 / (j : ℝ) ^ V * 2 ^ j := by
  set K := 3 * B + 2 * V
  set c : ℝ := 2400 * d * Cw ^ 3
  have hd' : (1 : ℝ) ≤ d := by exact_mod_cast hd
  have hc1 : 1 ≤ c := by
    have : 1 ≤ Cw ^ 3 := one_le_pow₀ hCw
    simp only [c]; nlinarith
  obtain ⟨j₀, hj₀⟩ := minor_eventually_pow_le_two_pow c K
  refine ⟨K + 1, max (max j₀ 1) ⌈c⌉₊, by omega, by omega, fun M hM j hj lam hlam T hT => ?_⟩
  have hj1 : 1 ≤ j := le_trans (le_max_right _ _) (le_trans (le_max_left _ _) hj)
  have hjc : c ≤ j := (Nat.le_ceil c).trans (by exact_mod_cast le_trans (le_max_right _ _) hj)
  have hJ : (1 : ℝ) ≤ j := by exact_mod_cast hj1
  have hJ0 : (0 : ℝ) < j := by linarith
  have h2j := hj₀ j (le_trans (le_max_left _ _) (le_trans (le_max_left _ _) hj))
  have hJV : (0 : ℝ) < (j : ℝ) ^ V := by positivity
  have hpowK : ∀ e ≤ K, (j : ℝ) ^ e ≤ (j : ℝ) ^ K := fun e he => pow_le_pow_right₀ hJ he
  have hMpow : c * (j : ℝ) ^ K < ((j : ℝ) + 1) ^ M := by
    calc c * (j : ℝ) ^ K ≤ (j : ℝ) * (j : ℝ) ^ K := by gcongr
      _ = (j : ℝ) ^ (K + 1) := by ring
      _ < ((j : ℝ) + 1) ^ (K + 1) := by gcongr; linarith
      _ ≤ ((j : ℝ) + 1) ^ M := pow_le_pow_right₀ (by linarith) hM
  have hCw3 : Cw ^ 2 ≤ Cw ^ 3 := pow_le_pow_right₀ hCw (by norm_num)
  have hCw2 : 1 ≤ Cw ^ 2 := one_le_pow₀ hCw
  have hQ : 1 ≤ Cw * (j : ℝ) ^ B := one_le_mul_of_one_le_of_one_le hCw (one_le_pow₀ hJ)
  refine minor_card_lt_core hd hlam hQ (by positivity) ?_ ?_ ?_ ?_ ?_ T hT
  · rw [div_le_one hJV]; exact one_le_pow₀ hJ
  · rw [one_div_mul_eq_div, le_div_iff₀ hJV]
    calc 640 * (Cw * (j : ℝ) ^ B) ^ 2 * (j : ℝ) ^ V = 640 * Cw ^ 2 * (j : ℝ) ^ (2 * B + V) := by
          ring
      _ ≤ c * (j : ℝ) ^ K := by
          gcongr
          · simp only [c]; nlinarith
          · omega
      _ ≤ 2 ^ j := h2j
  · rw [div_pow, one_pow, one_div_mul_eq_div, le_div_iff₀ (by positivity)]
    calc 2400 * (Cw * (j : ℝ) ^ B) ^ 2 * ((j : ℝ) ^ V) ^ 2 =
          2400 * Cw ^ 2 * (j : ℝ) ^ (2 * B + 2 * V) := by ring
      _ ≤ c * (j : ℝ) ^ K := by
          gcongr
          · simp only [c]; nlinarith
          · omega
      _ ≤ 2 ^ j := h2j
  · rw [one_div_mul_eq_div, lt_div_iff₀ hJV]
    calc 160 * d * (Cw * (j : ℝ) ^ B) ^ 2 * (j : ℝ) ^ V =
        160 * d * Cw ^ 2 * (j : ℝ) ^ (2 * B + V) := by
          ring
      _ ≤ c * (j : ℝ) ^ K := by
          gcongr
          · simp only [c]; nlinarith
          · omega
      _ < _ := hMpow
  · rw [div_pow, one_pow, one_div_mul_eq_div, le_div_iff₀ (by positivity)]
    calc 2400 * (Cw * (j : ℝ) ^ B) ^ 3 * ((j : ℝ) ^ V) ^ 2 =
          2400 * Cw ^ 3 * (j : ℝ) ^ (3 * B + 2 * V) := by ring
      _ ≤ c * (j : ℝ) ^ K := by
          gcongr
          simp only [c]; nlinarith
      _ ≤ _ := hMpow.le

/-! ### Kernel facts -/

variable {n : ℕ} {Ω : EuclideanSpace ℝ (Fin n) → ℂ}

/-- The integer box `[-r, r]ⁿ`. -/
def minorBox (n : ℕ) (r : ℤ) : Finset (Fin n → ℤ) := Fintype.piFinset fun _ => Icc (-r) r

lemma mem_minorBox {r : ℤ} {z : Fin n → ℤ} : z ∈ minorBox n r ↔ ∀ i, |z i| ≤ r := by
  simp [minorBox, abs_le]

lemma card_minorBox {r : ℤ} (hr : 0 ≤ r) : (#(minorBox n r) : ℝ) = (2 * r + 1 : ℝ) ^ n := by
  simp only [minorBox, Fintype.card_piFinset, Int.card_Icc, prod_const, card_univ,
    Fintype.card_fin]
  have : (r + 1 - -r).toNat = ((2 * r + 1 : ℤ)).toNat := by congr 1; ring
  rw [this]
  have h2 : (((2 * r + 1 : ℤ)).toNat : ℝ) = ((2 * r + 1 : ℤ) : ℝ) := by
    exact_mod_cast Int.toNat_of_nonneg (by omega)
  rw [Nat.cast_pow, h2]; push_cast; ring

/-- `2^{-j(n+k)}` as `1 / (2^j)^{n+k}`. -/
lemma minor_two_zpow (j n : ℕ) :
    (2 : ℝ) ^ (-(j : ℤ) * (n : ℤ)) = 1 / ((2 : ℝ) ^ j) ^ n := by
  rw [← pow_mul, one_div, ← zpow_natCast, ← zpow_neg]; congr 1; push_cast; ring

/-- Size and Lipschitz bounds for `K_j`, `j ∈ ℕ`: `|K_j| ≤ C₀ 2^{-jn}` and
`|K_j(a) - K_j(b)| ≤ C₁ 2^{-j(n+1)} |a - b|`. -/
lemma minor_kernel_bounds (hΩ : IsSWProfile Ω) :
    ∃ C₀ C₁ : ℝ, 0 ≤ C₀ ∧ 0 ≤ C₁ ∧ ∀ j : ℕ,
      (∀ a, ‖dyadicKernel Ω j a‖ ≤ C₀ / ((2 : ℝ) ^ j) ^ n) ∧
      (∀ a b, ‖dyadicKernel Ω j a - dyadicKernel Ω j b‖ ≤
        C₁ / ((2 : ℝ) ^ j) ^ (n + 1) * ‖a - b‖) := by
  obtain ⟨C₀, hC₀, h0⟩ := norm_dyadicKernel_le hΩ
  obtain ⟨C₁, h1⟩ := norm_iteratedFDeriv_dyadicKernel_le hΩ 1
  have hC₁ : 0 ≤ C₁ := by
    have h := (norm_nonneg _).trans (h1 0 0)
    exact nonneg_of_mul_nonneg_left h (by positivity)
  refine ⟨C₀, C₁, hC₀, hC₁, fun j => ⟨fun a => ?_, fun a b => ?_⟩⟩
  · have := h0 j a
    rwa [minor_two_zpow, mul_one_div] at this
  · have hd := (contDiff_dyadicKernel hΩ (j : ℤ)).differentiable (by simp)
    have hb : ∀ x ∈ (Set.univ : Set (EuclideanSpace ℝ (Fin n))),
        ‖fderiv ℝ (dyadicKernel Ω j) x‖ ≤ C₁ / ((2 : ℝ) ^ j) ^ (n + 1) := by
      intro x _
      have := h1 j x
      rw [norm_iteratedFDeriv_one] at this
      rw [show ((n : ℤ) + ((1 : ℕ) : ℤ)) = ((n + 1 : ℕ) : ℤ) by push_cast; ring,
        minor_two_zpow, mul_one_div] at this
      exact this
    exact convex_univ.norm_image_sub_le_of_norm_fderiv_le (fun x _ => hd x) hb trivial trivial

/-- `K_j(y) = 0` on the lattice unless `y ∈ [-2^{j+1}, 2^{j+1}]ⁿ`. -/
lemma minor_kernel_eq_zero (j : ℕ) {y : Fin n → ℤ} (hy : y ∉ minorBox n (2 * 2 ^ j)) :
    dyadicKernel Ω j (latEmbed y) = 0 := by
  rw [mem_minorBox] at hy
  push Not at hy
  obtain ⟨i, hi⟩ := hy
  apply dyadicKernel_eq_zero_of_le
  calc (2 : ℝ) ^ ((j : ℤ) + 1) = ((2 * 2 ^ j : ℤ) : ℝ) := by
        rw [zpow_add_one₀ two_ne_zero, zpow_natCast]; push_cast; ring
    _ ≤ |(y i : ℝ)| := by exact_mod_cast hi.le
    _ = ‖latEmbed y i‖ := by simp
    _ ≤ ‖latEmbed y‖ := PiLp.norm_apply_le _ _

/-! ### The `TT*` kernel -/

/-- The `TT*` kernel of blueprint Lemma 8.1 (`lem:minorL2`), recentred at the first point:
`H(x, y) = ∑_w e(λ_x P(-w) - λ_y P(h - w)) K_j(-w) conj K_j(h - w)` with `h = y - x`, `w = z - x`
running over the box `[-2^{j+1}, 2^{j+1}]ⁿ` which contains all nonzero terms. -/
noncomputable def minorTT (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (d j : ℕ) (lx ly : ℝ)
    (h : Fin n → ℤ) : ℂ :=
  ∑ w ∈ minorBox n (2 * 2 ^ j),
    eC (lx * (radialPolyZ n d (-w) : ℝ) - ly * (radialPolyZ n d (h - w) : ℝ)) *
      dyadicKernel Ω j (latEmbed (-w)) * conj (dyadicKernel Ω j (latEmbed (h - w)))

/-- `e(a) conj(e(b)) = e(a - b)`. -/
lemma minor_eC_mul_conj (a b : ℝ) : eC a * conj (eC b) = eC (a - b) := by
  rw [conj_eC, ← eC_add, sub_eq_add_neg]

/-- Splitting a box sum over `Fin (m+1) → ℤ` into the first coordinate and the others. -/
lemma minorBox_sum_succ {m : ℕ} (r : ℤ) (F : (Fin (m + 1) → ℤ) → ℂ) :
    ∑ w ∈ minorBox (m + 1) r, F w = ∑ s ∈ minorBox m r, ∑ t ∈ Icc (-r) r, F (Fin.cons t s) := by
  rw [← Finset.sum_product_right' (s := Icc (-r) r) (t := minorBox m r)
    (f := fun t s => F (Fin.cons t s))]
  refine Finset.sum_nbij' (fun w => (w 0, Fin.tail w)) (fun p => Fin.cons p.1 p.2) ?_ ?_ ?_ ?_ ?_
  · intro w hw
    rw [mem_minorBox] at hw
    simp only [mem_product, mem_Icc, mem_minorBox, Fin.tail]
    exact ⟨abs_le.1 (hw 0), fun i => hw _⟩
  · intro p hp
    simp only [mem_product, mem_Icc, mem_minorBox] at hp ⊢
    intro i
    refine Fin.cases ?_ (fun k => ?_) i
    · simpa using abs_le.2 hp.1
    · simpa using hp.2 k
  · intro w _; simp
  · intro p _; simp
  · intro w _; simp

variable {d : ℕ}

/-- The elementary bound `|H| ≤ 5ⁿ C₀² 2^{-jn}`. -/
lemma norm_minorTT_le {C₀ : ℝ} (hC₀ : 0 ≤ C₀) {j : ℕ}
    (hK : ∀ a, ‖dyadicKernel Ω j a‖ ≤ C₀ / ((2 : ℝ) ^ j) ^ n) (lx ly : ℝ) (h : Fin n → ℤ) :
    ‖minorTT Ω d j lx ly h‖ ≤ 5 ^ n * C₀ ^ 2 / ((2 : ℝ) ^ j) ^ n := by
  have hR : (0 : ℝ) < (2 : ℝ) ^ j := by positivity
  have hR1 : (1 : ℝ) ≤ (2 : ℝ) ^ j := one_le_pow₀ (by norm_num)
  refine (norm_sum_le _ _).trans ?_
  have hterm : ∀ w ∈ minorBox n (2 * 2 ^ j),
      ‖eC (lx * (radialPolyZ n d (-w) : ℝ) - ly * (radialPolyZ n d (h - w) : ℝ)) *
        dyadicKernel Ω j (latEmbed (-w)) * conj (dyadicKernel Ω j (latEmbed (h - w)))‖ ≤
        (C₀ / ((2 : ℝ) ^ j) ^ n) ^ 2 := by
    intro w _
    rw [norm_mul, norm_mul, norm_eC, one_mul, RCLike.norm_conj, sq]
    exact mul_le_mul (hK _) (hK _) (norm_nonneg _) (by positivity)
  refine (sum_le_sum hterm).trans ?_
  rw [sum_const, nsmul_eq_mul, card_minorBox (by positivity)]
  push_cast
  have h5 : (2 * (2 * (2 : ℝ) ^ j) + 1) ^ n ≤ (5 * (2 : ℝ) ^ j) ^ n := by
    gcongr; linarith
  calc (2 * (2 * (2 : ℝ) ^ j) + 1) ^ n * (C₀ / ((2 : ℝ) ^ j) ^ n) ^ 2
      ≤ (5 * (2 : ℝ) ^ j) ^ n * (C₀ / ((2 : ℝ) ^ j) ^ n) ^ 2 := by gcongr
    _ = 5 ^ n * C₀ ^ 2 / ((2 : ℝ) ^ j) ^ n := by
        rw [mul_pow]; field_simp

/-- `H(x, y) = 0` unless `y - x ∈ [-2^{j+2}, 2^{j+2}]ⁿ`. -/
lemma minorTT_eq_zero {j : ℕ} (lx ly : ℝ) {h : Fin n → ℤ} (hh : h ∉ minorBox n (4 * 2 ^ j)) :
    minorTT Ω d j lx ly h = 0 := by
  refine sum_eq_zero fun w hw => ?_
  rw [mem_minorBox] at hw hh
  push Not at hh
  obtain ⟨i, hi⟩ := hh
  have : h - w ∉ minorBox n (2 * 2 ^ j) := by
    rw [mem_minorBox]; push Not
    refine ⟨i, ?_⟩
    have := hw i
    simp only [Pi.sub_apply]
    rw [abs_le] at this
    rcases le_or_gt 0 (h i) with h0 | h0
    · rw [abs_of_nonneg h0] at hi
      rw [lt_abs]; left; linarith
    · rw [abs_of_neg h0] at hi
      rw [lt_abs]; right; linarith
  rw [minor_kernel_eq_zero j this, map_zero, mul_zero]

/-! ### Bad pairs: the inverse theorem -/

/-- A unit step in the first coordinate has Euclidean length one. -/
lemma norm_latEmbed_sub_cons_succ {m : ℕ} (c : Fin (m + 1) → ℤ) (t : ℤ) (s : Fin m → ℤ) :
    ‖latEmbed (c - Fin.cons (t + 1) s) - latEmbed (c - Fin.cons t s)‖ = 1 := by
  rw [EuclideanSpace.norm_eq, Fin.sum_univ_succ]
  simp only [PiLp.sub_apply, latEmbed_apply, Pi.sub_apply, Fin.cons_zero, Fin.cons_succ,
    Real.norm_eq_abs, sq_abs]
  push_cast
  simp

/-- Variation of a product of two kernel values under unit steps. -/
lemma minor_prod_step {E : Type*} [NormedAddCommGroup E] {k : E → ℂ} {C₀ C₁ : ℝ}
    (hk : ∀ a, ‖k a‖ ≤ C₀) (hkl : ∀ a b, ‖k a - k b‖ ≤ C₁ * ‖a - b‖) {a₀ a₁ b₀ b₁ : E}
    (ha : ‖a₁ - a₀‖ = 1) (hb : ‖b₁ - b₀‖ = 1) :
    ‖k a₁ * conj (k b₁) - k a₀ * conj (k b₀)‖ ≤ 2 * C₀ * C₁ := by
  have hC₀ : 0 ≤ C₀ := (norm_nonneg _).trans (hk a₀)
  have e : k a₁ * conj (k b₁) - k a₀ * conj (k b₀) =
      (k a₁ - k a₀) * conj (k b₁) + k a₀ * conj (k b₁ - k b₀) := by
    rw [map_sub]; ring
  rw [e]
  refine (norm_add_le _ _).trans ?_
  rw [norm_mul, norm_mul, RCLike.norm_conj, RCLike.norm_conj]
  have h1 := hkl a₁ a₀
  have h2 := hkl b₁ b₀
  rw [ha, mul_one] at h1
  rw [hb, mul_one] at h2
  have := mul_le_mul h1 (hk b₁) (norm_nonneg _) ((norm_nonneg _).trans h1)
  have := mul_le_mul (hk a₀) h2 (norm_nonneg _) hC₀
  linarith

/-- The phase of the `TT*` kernel as a polynomial in the first coordinate `t` (Blueprint Lemma 3.1):
`λ_x P(-w) - λ_y P(h - w)` for `w = (t, s)`. -/
noncomputable def minorPhasePoly {m : ℕ} (d : ℕ) (lx ly : ℝ) (h : Fin (m + 1) → ℤ)
    (s : Fin m → ℤ) : ℝ[X] :=
  C lx * sliceRadialPoly (m + 1) d 0 (fun l => ((Fin.cons 0 s : Fin (m + 1) → ℤ) l : ℝ))
      (-(0 : Fin (m + 1) → ℝ)) -
    C ly * sliceRadialPoly (m + 1) d 0 (fun l => ((Fin.cons 0 s : Fin (m + 1) → ℤ) l : ℝ))
      (-(fun l => (h l : ℝ)))

lemma minorPhasePoly_natDegree_le {m : ℕ} (d : ℕ) (lx ly : ℝ) (h : Fin (m + 1) → ℤ)
    (s : Fin m → ℤ) : (minorPhasePoly d lx ly h s).natDegree ≤ 2 * d := by
  refine (natDegree_sub_le _ _).trans (max_le ?_ ?_) <;>
    exact (natDegree_C_mul_le _ _).trans (sliceRadialPoly_natDegree_le _ _ _ _ _)

lemma minorPhasePoly_eval {m : ℕ} (d : ℕ) (lx ly : ℝ) (h : Fin (m + 1) → ℤ)
    (s : Fin m → ℤ) (t : ℤ) :
    ∑ k ∈ range (2 * d + 1), (minorPhasePoly d lx ly h s).coeff k * (t : ℝ) ^ k =
      lx * (radialPolyZ (m + 1) d (-Fin.cons t s) : ℝ) -
        ly * (radialPolyZ (m + 1) d (h - Fin.cons t s) : ℝ) := by
  rw [← eval_eq_sum_range' (Nat.lt_succ_of_le (minorPhasePoly_natDegree_le d lx ly h s)),
    minorPhasePoly, sliceRadialPoly_sub_eval]
  have hu : Function.update (fun l => ((Fin.cons 0 s : Fin (m + 1) → ℤ) l : ℝ)) 0 (t : ℝ) =
      fun l => ((Fin.cons t s : Fin (m + 1) → ℤ) l : ℝ) := by
    funext l
    refine Fin.cases ?_ (fun k => ?_) l
    · simp
    · rw [Function.update_of_ne (Fin.succ_ne_zero k)]; simp
  rw [hu]
  simp only [radialPolyZ, Pi.sub_apply, Pi.neg_apply, Pi.zero_apply, sub_zero]
  push_cast
  congr 3
  · refine sum_congr rfl fun l _ => by ring
  · refine sum_congr rfl fun l _ => by ring

lemma minorPhasePoly_coeff {m : ℕ} {d : ℕ} (hd : 1 ≤ d) (lx ly : ℝ) (h : Fin (m + 1) → ℤ)
    (s : Fin m → ℤ) : (minorPhasePoly d lx ly h s).coeff (2 * d - 1) = 2 * d * ly * h 0 := by
  rw [minorPhasePoly, sliceRadialPoly_sub_coeff_top_sub_one (m + 1) (by omega)]
  simp only [Pi.zero_apply]
  ring

/-- **Bad pairs** (the inverse step of Blueprint Lemma 8.1 (`lem:minorL2`), via Corollary 3.5 and
Lemma 3.1): there are `C_W ≥ 1` and `e > 0` such that if `0 < ε ≤ 1` and
`|H(x, y)| > ε 2^{-jn}` (with `h = y - x`), then some integer `1 ≤ q ≤ C_W ε^{-e}` satisfies
`‖q D h₁ λ_y‖_𝕋 ≤ C_W ε^{-e} 2^{-j(D-1)}`, `D = 2d` (the degree-`(D-1)` coefficient of the
phase in the first coordinate is `D h₁ λ_y`). -/
lemma minor_bad_pair {m d : ℕ} {Ω : EuclideanSpace ℝ (Fin (m + 1)) → ℂ} (hΩ : IsSWProfile Ω)
    (hd : 1 ≤ d) :
    ∃ Cw e : ℝ, 1 ≤ Cw ∧ 0 < e ∧ ∀ (j : ℕ) (lx ly : ℝ) (h : Fin (m + 1) → ℤ) (ε : ℝ),
      0 < ε → ε ≤ 1 → ε / ((2 : ℝ) ^ j) ^ (m + 1) < ‖minorTT Ω d j lx ly h‖ →
      ∃ q : ℕ, 1 ≤ q ∧ (q : ℝ) ≤ Cw * ε ^ (-e) ∧
        ‖((q * (2 * d) * (h 0 : ℝ) * ly : ℝ) : UnitAddCircle)‖ ≤
          Cw * ε ^ (-e) / ((2 : ℝ) ^ j) ^ (2 * d - 1) := by
  obtain ⟨C₀, C₁, hC₀, hC₁, hK⟩ := minor_kernel_bounds (n := m + 1) hΩ
  set A : ℝ := max (max (C₀ ^ 2) (8 * C₀ * C₁)) 2 with hA
  have hA2 : 2 ≤ A := le_max_right _ _
  have hA0 : 0 < A := by linarith
  have h5 : (1 : ℝ) ≤ 5 ^ m := one_le_pow₀ (by norm_num)
  obtain ⟨C, hC1, hCor⟩ := exists_slice_inverse_poly_sum_weighted (2 * d) 2
  refine ⟨C * (A * 5 ^ m) ^ C, C, one_le_mul_of_one_le_of_one_le hC1
    (Real.one_le_rpow (by nlinarith) (by linarith)), by linarith,
    fun j lx ly h ε hε hε1 hbad => ?_⟩
  set R : ℝ := (2 : ℝ) ^ j with hR
  have hR0 : 0 < R := by positivity
  have hR1 : 1 ≤ R := one_le_pow₀ (by norm_num)
  set r : ℤ := 2 * 2 ^ j with hr
  have hrR : (r : ℝ) = 2 * R := by simp [r, hR]
  have hr0 : 0 ≤ r := by positivity
  have hNR : (((2 ^ j : ℕ) : ℝ)) = R := by simp [hR]
  set S := minorBox m r
  set a : (Fin m → ℤ) → ℕ → ℝ := fun s k => (minorPhasePoly d lx ly h s).coeff k
  set w : (Fin m → ℤ) → ℤ → ℂ := fun s t => ((R ^ (2 * (m + 1)) : ℝ) : ℂ) *
    (dyadicKernel Ω j (latEmbed (-Fin.cons t s)) *
      conj (dyadicKernel Ω j (latEmbed (h - Fin.cons t s))))
  set δ : ℝ := ε / (A * 5 ^ m)
  have hδ : 0 < δ := by positivity
  have hδ2 : δ ≤ 1 / 2 := by
    rw [div_le_div_iff₀ (by positivity) (by norm_num)]; nlinarith
  -- the sum identity
  have hid : ∑ s ∈ S, ∑ t ∈ Icc (-r) r,
      w s t * eC (∑ k ∈ range (2 * d + 1), a s k * (t : ℝ) ^ k) =
      ((R ^ (2 * (m + 1)) : ℝ) : ℂ) * minorTT Ω d j lx ly h := by
    rw [minorTT, minorBox_sum_succ, mul_sum]
    refine sum_congr rfl fun s _ => ?_
    rw [mul_sum]
    refine sum_congr rfl fun t _ => ?_
    simp only [w, a, minorPhasePoly_eval]
    ring
  have hKb := (hK j).1
  have hKl := (hK j).2
  have hRn : R ^ (2 * (m + 1)) * (C₀ / R ^ (m + 1)) ^ 2 = C₀ ^ 2 := by
    field_simp; ring
  have hS0 : (0 : Fin m → ℤ) ∈ S := by rw [mem_minorBox]; intro i; simpa using hr0
  have hT0 : -(2 * ((2 ^ j : ℕ) : ℝ)) ≤ ((-r : ℤ) : ℝ) := by rw [hNR]; push_cast; rw [hrR]
  have hT1 : ((r : ℤ) : ℝ) ≤ 2 * ((2 ^ j : ℕ) : ℝ) := by rw [hNR, hrR]
  have hw : ∀ s ∈ S, ∀ t ∈ Icc (-r) r, ‖w s t‖ ≤ A := by
    intro s _ t _
    simp only [w]
    rw [norm_mul, norm_mul, RCLike.norm_conj, Complex.norm_real,
      Real.norm_of_nonneg (by positivity)]
    calc R ^ (2 * (m + 1)) * (‖dyadicKernel Ω j (latEmbed (-Fin.cons t s))‖ *
          ‖dyadicKernel Ω j (latEmbed (h - Fin.cons t s))‖)
        ≤ R ^ (2 * (m + 1)) * ((C₀ / R ^ (m + 1)) * (C₀ / R ^ (m + 1))) := by
          gcongr
          · exact hKb _
          · exact hKb _
      _ = C₀ ^ 2 := by rw [← sq, hRn]
      _ ≤ A := (le_max_left _ _).trans (le_max_left _ _)
  have hwv : ∀ s ∈ S, ∑ t ∈ Ico (-r) r, ‖w s (t + 1) - w s t‖ ≤ A := by
    intro s _
    have hstep : ∀ t : ℤ, ‖w s (t + 1) - w s t‖ ≤ 2 * C₀ * C₁ / R := by
      intro t
      simp only [w]
      rw [← mul_sub, norm_mul, Complex.norm_real, Real.norm_of_nonneg (by positivity)]
      have ha : ‖latEmbed (-Fin.cons (t + 1) s) - latEmbed (-Fin.cons t s)‖ = 1 := by
        simpa using norm_latEmbed_sub_cons_succ 0 t s
      have hb := norm_latEmbed_sub_cons_succ h t s
      have := minor_prod_step (k := dyadicKernel Ω j) hKb hKl ha hb
      calc R ^ (2 * (m + 1)) * ‖_‖ ≤ R ^ (2 * (m + 1)) *
            (2 * (C₀ / R ^ (m + 1)) * (C₁ / R ^ (m + 1 + 1))) := by gcongr
        _ = 2 * C₀ * C₁ / R := by field_simp; ring
    calc ∑ t ∈ Ico (-r) r, ‖w s (t + 1) - w s t‖ ≤ ∑ _t ∈ Ico (-r) r, 2 * C₀ * C₁ / R :=
          sum_le_sum fun t _ => hstep t
      _ = 4 * R * (2 * C₀ * C₁ / R) := by
          rw [sum_const, Int.card_Ico, nsmul_eq_mul]
          have : ((r - -r).toNat : ℝ) = 4 * R := by
            have h' : ((r - -r).toNat : ℤ) = 2 * r := by omega
            have : (((r - -r).toNat : ℤ) : ℝ) = ((2 * r : ℤ) : ℝ) := by rw [h']
            push_cast at this; rw [this, hrR]; ring
          rw [this]
      _ = 8 * C₀ * C₁ := by field_simp; ring
      _ ≤ A := (le_max_right _ _).trans (le_max_left _ _)
  have hsum : δ * A * ((2 ^ j : ℕ) : ℝ) * #S ≤ ‖∑ s ∈ S, ∑ t ∈ Icc (-r) r,
      w s t * eC (∑ k ∈ range (2 * d + 1), a s k * (t : ℝ) ^ k)‖ := by
    rw [hid, norm_mul, Complex.norm_real, Real.norm_of_nonneg (by positivity), hNR]
    have hcard : (#S : ℝ) ≤ (5 * R) ^ m := by
      rw [card_minorBox hr0, hrR]; gcongr; linarith
    have hlt := hbad
    rw [div_lt_iff₀ (by positivity)] at hlt
    calc δ * A * R * #S ≤ δ * A * R * (5 * R) ^ m := by gcongr
      _ = ε * R ^ (m + 1) := by simp only [δ]; field_simp; ring
      _ ≤ ‖minorTT Ω d j lx ly h‖ * R ^ (m + 1) * R ^ (m + 1) := by
          have : ε ≤ ‖minorTT Ω d j lx ly h‖ * R ^ (m + 1) := hlt.le
          have h1 : (1 : ℝ) ≤ R ^ (m + 1) := one_le_pow₀ hR1
          nlinarith [pow_pos hR0 (m + 1)]
      _ = R ^ (2 * (m + 1)) * ‖minorTT Ω d j lx ly h‖ := by ring
  obtain ⟨s, -, q, hq1, hq2, hq3⟩ := hCor S a w (2 ^ j) (-r) r A δ ⟨0, hS0⟩ Nat.one_le_two_pow
    hA0 hδ hδ2 hT0 hT1 hw hwv hsum
  -- conclusion
  have hδC : δ ^ (-C) = (A * 5 ^ m) ^ C * ε ^ (-C) := by
    simp only [δ]
    rw [div_eq_mul_inv, Real.mul_rpow hε.le (by positivity), Real.inv_rpow (by positivity),
      Real.rpow_neg (by positivity : (0 : ℝ) ≤ A * 5 ^ m), inv_inv]
    ring
  refine ⟨q, hq1, ?_, ?_⟩
  · rw [hδC] at hq2; linarith
  · have := hq3 (2 * d - 1) (mem_Icc.2 ⟨by omega, by omega⟩)
    simp only [a] at this
    rw [minorPhasePoly_coeff hd, hδC, hNR] at this
    calc ‖((q * (2 * d) * (h 0 : ℝ) * ly : ℝ) : UnitAddCircle)‖ =
        ‖((q * (2 * d * ly * (h 0 : ℝ)) : ℝ) : UnitAddCircle)‖ := by ring_nf
      _ ≤ _ := this
      _ = _ := by ring

/-! ### Counting bad pairs: the column bound -/

/-- **Column bound for the `TT*` kernel** (Blueprint Lemma 8.1 (`lem:minorL2`), counting step):
fix the second point `y` (parameter `λ_y`). Suppose every bad pair (`|H| > ε 2^{-jn}`) yields an
approximation `1 ≤ q ≤ Q`, `‖q D h₁ λ_y‖_𝕋 ≤ Q 2^{-j(D-1)}`, and that every set of such
`|h₁| ≤ 4 · 2^j` has fewer than `η 2^j` elements. Then, whatever the parameters `g h = λ_x` of
the first points,
`∑_h |H| ≤ 9ⁿ ε + 9^{n-1} 5ⁿ C₀² η` (for each fixed `h' = (h₂, …, hₙ)` fewer than `η 2^j` values
of `h₁` are bad). -/
lemma minor_column_bound {m d j : ℕ} {Ω : EuclideanSpace ℝ (Fin (m + 1)) → ℂ} {C₀ : ℝ}
    (hC₀ : 0 ≤ C₀) (hK : ∀ a, ‖dyadicKernel Ω j a‖ ≤ C₀ / ((2 : ℝ) ^ j) ^ (m + 1))
    {ε η Q ly : ℝ} (hε : 0 < ε) (hη : 0 < η)
    (hbad : ∀ lx h, ε / ((2 : ℝ) ^ j) ^ (m + 1) < ‖minorTT Ω d j lx ly h‖ →
      ∃ q : ℕ, 1 ≤ q ∧ (q : ℝ) ≤ Q ∧
        ‖((q * (2 * d) * (h 0 : ℝ) * ly : ℝ) : UnitAddCircle)‖ ≤ Q / ((2 : ℝ) ^ j) ^ (2 * d - 1))
    (hcount : ∀ T : Finset ℤ, (∀ h ∈ T, |(h : ℝ)| ≤ 4 * 2 ^ j ∧ ∃ q : ℕ, 1 ≤ q ∧ (q : ℝ) ≤ Q ∧
        ‖((q * (2 * d) * h * ly : ℝ) : UnitAddCircle)‖ ≤ Q / ((2 : ℝ) ^ j) ^ (2 * d - 1)) →
      (#T : ℝ) < η * 2 ^ j)
    (g : (Fin (m + 1) → ℤ) → ℝ) :
    ∑' h, ‖minorTT Ω d j (g h) ly h‖ₑ ≤
      ENNReal.ofReal (9 ^ (m + 1) * ε + 9 ^ m * (5 ^ (m + 1) * C₀ ^ 2) * η) := by
  set R : ℝ := (2 : ℝ) ^ j with hR
  have hR0 : 0 < R := by positivity
  have hR1 : 1 ≤ R := one_le_pow₀ (by norm_num)
  set r : ℤ := 4 * 2 ^ j with hr
  have hr0 : 0 ≤ r := by positivity
  have hrR : (r : ℝ) = 4 * R := by simp [r, hR]
  set box := minorBox (m + 1) r
  set F : (Fin (m + 1) → ℤ) → ℝ := fun h => ‖minorTT Ω d j (g h) ly h‖
  have hzero : ∀ h ∉ box, ‖minorTT Ω d j (g h) ly h‖ₑ = 0 := fun h hh => by
    rw [minorTT_eq_zero _ _ hh, enorm_zero]
  rw [tsum_eq_sum hzero]
  have hsum : ∑ h ∈ box, ‖minorTT Ω d j (g h) ly h‖ₑ = ENNReal.ofReal (∑ h ∈ box, F h) := by
    rw [ENNReal.ofReal_sum_of_nonneg fun _ _ => norm_nonneg _]
    exact sum_congr rfl fun h _ => (ofReal_norm _).symm
  rw [hsum]
  refine ENNReal.ofReal_le_ofReal ?_
  set CH : ℝ := 5 ^ (m + 1) * C₀ ^ 2
  set Bad := {h ∈ box | ε / R ^ (m + 1) < F h}
  have hsplit := sum_filter_add_sum_filter_not box (fun h => ε / R ^ (m + 1) < F h) F
  have h1 : ∑ h ∈ Bad, F h ≤ #Bad * (CH / R ^ (m + 1)) := by
    rw [← nsmul_eq_mul, ← sum_const]
    exact sum_le_sum fun h _ => norm_minorTT_le hC₀ hK _ _ _
  have h2 : ∑ h ∈ box with ¬(ε / R ^ (m + 1) < F h), F h ≤ #box * (ε / R ^ (m + 1)) := by
    calc _ ≤ ∑ h ∈ box with ¬(ε / R ^ (m + 1) < F h), ε / R ^ (m + 1) :=
          sum_le_sum fun h hh => not_lt.1 (mem_filter.1 hh).2
      _ = #(box.filter fun h => ¬(ε / R ^ (m + 1) < F h)) * (ε / R ^ (m + 1)) := by
          rw [sum_const, nsmul_eq_mul]
      _ ≤ #box * (ε / R ^ (m + 1)) := by
          gcongr; exact filter_subset _ _
  have hbox : (#box : ℝ) ≤ (9 * R) ^ (m + 1) := by
    rw [card_minorBox hr0, hrR]; gcongr; linarith
  -- counting the bad set fibrewise over the last `m` coordinates
  set boxm := minorBox m r
  have hBad : (#Bad : ℝ) ≤ (9 * R) ^ m * (η * R) := by
    have hmaps : ∀ h ∈ Bad, Fin.tail h ∈ boxm := by
      intro h hh
      have := (mem_filter.1 hh).1
      rw [mem_minorBox] at this ⊢
      exact fun i => this _
    rw [card_eq_sum_card_fiberwise hmaps]
    push_cast
    have hfib : ∀ s ∈ boxm, (#{h ∈ Bad | Fin.tail h = s} : ℝ) ≤ η * R := by
      intro s _
      set Fb := {h ∈ Bad | Fin.tail h = s}
      have hinj : Set.InjOn (fun h : Fin (m + 1) → ℤ => h 0) (Fb : Set _) := by
        intro a ha b hb hab
        have ha' := (mem_filter.1 ha).2
        have hb' := (mem_filter.1 hb).2
        rw [← Fin.cons_self_tail a, ← Fin.cons_self_tail b, ha', hb']
        simp only at hab
        rw [hab]
      rw [← card_image_of_injOn hinj]
      refine (hcount _ fun x hx => ?_).le
      obtain ⟨h, hh, rfl⟩ := mem_image.1 hx
      have hhB := (mem_filter.1 hh).1
      obtain ⟨hbox', hbad'⟩ := mem_filter.1 hhB
      refine ⟨?_, hbad (g h) h hbad'⟩
      have := (mem_minorBox.1 hbox') 0
      have : |((h 0 : ℤ) : ℝ)| ≤ (r : ℝ) := by exact_mod_cast this
      rw [hrR] at this; exact this
    calc ∑ s ∈ boxm, (#{h ∈ Bad | Fin.tail h = s} : ℝ) ≤ ∑ _s ∈ boxm, η * R :=
          sum_le_sum hfib
      _ = #boxm * (η * R) := by rw [sum_const, nsmul_eq_mul]
      _ ≤ (9 * R) ^ m * (η * R) := by
          gcongr
          rw [card_minorBox hr0, hrR]; gcongr; linarith
  have hRm : (0 : ℝ) < R ^ (m + 1) := by positivity
  have hCH : 0 ≤ CH := by positivity
  rw [← hsplit]
  calc ∑ h ∈ Bad, F h + ∑ h ∈ box with ¬(ε / R ^ (m + 1) < F h), F h
      ≤ (9 * R) ^ m * (η * R) * (CH / R ^ (m + 1)) + (9 * R) ^ (m + 1) * (ε / R ^ (m + 1)) := by
        gcongr
        · exact h1.trans (by gcongr)
        · exact h2.trans (by gcongr)
    _ = 9 ^ (m + 1) * ε + 9 ^ m * CH * η := by
        field_simp; ring

/-! ### The `TT*` argument for a linearization -/

/-- `2ab ≤ a² + b²` in `[0, ∞]`. -/
lemma minor_two_mul_le_add_sq (a b : ℝ≥0∞) : 2 * a * b ≤ a ^ 2 + b ^ 2 := by
  rcases eq_or_ne a ∞ with rfl | ha
  · rcases eq_or_ne b 0 with rfl | hb
    · simp
    · simp [ENNReal.top_pow two_ne_zero]
  rcases eq_or_ne b ∞ with rfl | hb
  · rcases eq_or_ne a 0 with rfl | ha'
    · simp
    · simp [ENNReal.top_pow two_ne_zero]
  lift a to ℝ≥0 using ha
  lift b to ℝ≥0 using hb
  exact_mod_cast two_mul_le_add_sq a b

/-- Schur's test for a bilinear form on a countable space with counting measure: if all row and
column sums of `|H|` are at most `A`, then `∑_x |v x| ∑_{x'} |H x x'| |v x'| ≤ A ∑ |v|²`. -/
lemma minor_bilinear_schur {α : Type*} (b : α → α → ℝ≥0∞) (a : α → ℝ≥0∞) {A : ℝ≥0∞}
    (hrow : ∀ x, ∑' x', b x x' ≤ A) (hcol : ∀ x', ∑' x, b x x' ≤ A) :
    ∑' x, a x * ∑' x', b x x' * a x' ≤ A * ∑' x, a x ^ 2 := by
  have h2 : (2 : ℝ≥0∞) ≠ 0 := two_ne_zero
  have h2' : (2 : ℝ≥0∞) ≠ ∞ := ENNReal.ofNat_ne_top
  have hpt : ∀ x x', 2 * (a x * (b x x' * a x')) ≤ b x x' * a x ^ 2 + b x x' * a x' ^ 2 := by
    intro x x'
    calc 2 * (a x * (b x x' * a x')) = b x x' * (2 * a x * a x') := by ring
      _ ≤ b x x' * (a x ^ 2 + a x' ^ 2) := by gcongr; exact minor_two_mul_le_add_sq _ _
      _ = _ := by ring
  have key : 2 * ∑' x, a x * ∑' x', b x x' * a x' ≤ 2 * (A * ∑' x, a x ^ 2) := by
    calc 2 * ∑' x, a x * ∑' x', b x x' * a x'
        = ∑' x, ∑' x', 2 * (a x * (b x x' * a x')) := by
          rw [← ENNReal.tsum_mul_left]
          refine tsum_congr fun x => ?_
          rw [← ENNReal.tsum_mul_left, ← ENNReal.tsum_mul_left]
      _ ≤ ∑' x, ∑' x', (b x x' * a x ^ 2 + b x x' * a x' ^ 2) :=
          ENNReal.tsum_le_tsum fun x => ENNReal.tsum_le_tsum fun x' => hpt x x'
      _ = ∑' x, (∑' x', b x x') * a x ^ 2 + ∑' x', (∑' x, b x x') * a x' ^ 2 := by
          simp_rw [ENNReal.tsum_add]
          rw [ENNReal.tsum_comm (f := fun x x' => b x x' * a x' ^ 2)]
          simp_rw [ENNReal.tsum_mul_right]
      _ ≤ ∑' x, A * a x ^ 2 + ∑' x', A * a x' ^ 2 := by
          gcongr with x x'
          · exact hrow x
          · exact hcol x'
      _ = 2 * (A * ∑' x, a x ^ 2) := by
          rw [ENNReal.tsum_mul_left, two_mul]
  exact (ENNReal.mul_le_mul_iff_right h2 h2').1 key

/-- `‖v‖₂² = ∑_x |v x|²` for counting measure. -/
lemma minor_eLpNorm_two_sq {α : Type*} [MeasurableSpace α] [MeasurableSingletonClass α]
    [Countable α] (v : α → ℂ) :
    eLpNorm v 2 Measure.count ^ 2 = ∑' x, ‖v x‖ₑ ^ 2 := by
  have := eLpNorm_two_rpow_two (ν := Measure.count) (AEStronglyMeasurable.of_discrete (f := v))
  rw [lintegral_count] at this
  rw [← ENNReal.rpow_natCast, Nat.cast_ofNat, this]
  simp_rw [← ENNReal.rpow_natCast, Nat.cast_ofNat]

/-- A Bochner integral against counting measure of a finitely supported function is its sum. -/
lemma minor_integral_count_eq_tsum {α : Type*} [MeasurableSpace α] [MeasurableSingletonClass α]
    [Countable α] {g : α → ℂ} (S : Finset α) (hg : ∀ z ∉ S, g z = 0) :
    ∫ z, g z ∂Measure.count = ∑' z, g z := by
  have hint : Integrable g Measure.count :=
    integrable_count_iff.2 (summable_of_ne_finset_zero (s := S) fun z hz => by simp [hg z hz])
  rw [integral_countable hint]
  simp

/-- The kernel `κ(x, z) = e(λ_x P(x - z)) K_j(x - z)` of the linearized operator. -/
noncomputable def minorKer (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (d j : ℕ) (lam : (Fin n → ℤ) → ℝ)
    (x z : Fin n → ℤ) : ℂ :=
  eC (lam x * (radialPolyZ n d (x - z) : ℝ)) * dyadicKernel Ω j (latEmbed (x - z))

/-- The box is symmetric. -/
lemma neg_mem_minorBox {r : ℤ} {w : Fin n → ℤ} (hw : w ∈ minorBox n r) : -w ∈ minorBox n r := by
  rw [mem_minorBox] at hw ⊢; intro i; simpa using hw i

lemma minorKer_eq_zero {j : ℕ} (lam : (Fin n → ℤ) → ℝ) (x z : Fin n → ℤ)
    (hz : z ∉ (minorBox n (2 * 2 ^ j)).image (fun w => x + w)) : minorKer Ω d j lam x z = 0 := by
  rw [minorKer, minor_kernel_eq_zero j, mul_zero]
  intro hmem
  apply hz
  refine mem_image.2 ⟨z - x, ?_, by abel⟩
  have := neg_mem_minorBox hmem
  rwa [neg_sub] at this

/-- The linearized operator is the integral operator with kernel `minorKer`. -/
lemma minorOp_eq_integral {j : ℕ} (lam : (Fin n → ℤ) → ℝ) (f : (Fin n → ℤ) → ℂ)
    (x : Fin n → ℤ) :
    minorOp Ω d j (lam x) f x = ∫ z, minorKer Ω d j lam x z * f z ∂Measure.count := by
  rw [minor_integral_count_eq_tsum ((minorBox n (2 * 2 ^ j)).image (fun w => x + w))
    (fun z hz => by rw [minorKer_eq_zero lam x z hz, zero_mul]), minorOp]
  rw [← (Equiv.subLeft x).tsum_eq]
  refine tsum_congr fun z => ?_
  simp only [Equiv.subLeft_apply, minorKer, sub_sub_cancel]

/-- The `TT*` kernel of the linearized operator is `minorTT`. -/
lemma integral_minorKer_mul_conj {j : ℕ} (lam : (Fin n → ℤ) → ℝ) (x x' : Fin n → ℤ) :
    ∫ z, minorKer Ω d j lam x z * conj (minorKer Ω d j lam x' z) ∂Measure.count =
      minorTT Ω d j (lam x) (lam x') (x' - x) := by
  rw [minor_integral_count_eq_tsum ((minorBox n (2 * 2 ^ j)).image (fun w => x + w))
    (fun z hz => by rw [minorKer_eq_zero lam x z hz, zero_mul])]
  rw [← (Equiv.addLeft x).tsum_eq, tsum_eq_sum (s := minorBox n (2 * 2 ^ j))]
  · refine sum_congr rfl fun w _ => ?_
    simp only [Equiv.coe_addLeft, minorKer, map_mul]
    have e1 : x - (x + w) = -w := by abel
    have e2 : x' - (x + w) = x' - x - w := by abel
    rw [e1, e2]
    rw [show ∀ a b c e : ℂ, a * b * (c * e) = (a * c) * b * e by intros; ring, minor_eC_mul_conj]
  · intro w hw
    simp only [Equiv.coe_addLeft, minorKer]
    have e1 : x - (x + w) = -w := by abel
    rw [e1, minor_kernel_eq_zero j (fun h => hw (by simpa using neg_mem_minorBox h))]
    simp

/-- `|H(x, x')| = |H(x', x)|`. -/
lemma norm_integral_minorKer_symm {j : ℕ} (lam : (Fin n → ℤ) → ℝ) (x x' : Fin n → ℤ) :
    ‖∫ z, minorKer Ω d j lam x z * conj (minorKer Ω d j lam x' z) ∂Measure.count‖ₑ =
      ‖∫ z, minorKer Ω d j lam x' z * conj (minorKer Ω d j lam x z) ∂Measure.count‖ₑ := by
  rw [← RCLike.enorm_conj, ← integral_conj]
  congr 2; funext z
  rw [map_mul, RCLike.conj_conj, mul_comm]

/-- `∑_y |K_j(y)| ≤ 5ⁿ C₀`. -/
lemma minor_tsum_enorm_kernel_le {C₀ : ℝ} (hC₀ : 0 ≤ C₀) {j : ℕ}
    (hK : ∀ a, ‖dyadicKernel Ω j a‖ ≤ C₀ / ((2 : ℝ) ^ j) ^ n) :
    ∑' y : Fin n → ℤ, ‖dyadicKernel Ω j (latEmbed y)‖ₑ ≤ ENNReal.ofReal (5 ^ n * C₀) := by
  rw [tsum_eq_sum (s := minorBox n (2 * 2 ^ j)) fun y hy => by
    rw [minor_kernel_eq_zero j hy, enorm_zero]]
  have hR : (0 : ℝ) < (2 : ℝ) ^ j := by positivity
  have hR1 : (1 : ℝ) ≤ (2 : ℝ) ^ j := one_le_pow₀ (by norm_num)
  calc ∑ y ∈ minorBox n (2 * 2 ^ j), ‖dyadicKernel Ω j (latEmbed y)‖ₑ
      ≤ ∑ _y ∈ minorBox n (2 * 2 ^ j), ENNReal.ofReal (C₀ / ((2 : ℝ) ^ j) ^ n) :=
        sum_le_sum fun y _ => by rw [← ofReal_norm]; exact ENNReal.ofReal_le_ofReal (hK _)
    _ = ENNReal.ofReal (#(minorBox n (2 * 2 ^ j)) * (C₀ / ((2 : ℝ) ^ j) ^ n)) := by
        rw [sum_const, nsmul_eq_mul, ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_natCast]
    _ ≤ ENNReal.ofReal (5 ^ n * C₀) := by
        refine ENNReal.ofReal_le_ofReal ?_
        rw [card_minorBox (by positivity)]
        push_cast
        calc (2 * (2 * (2 : ℝ) ^ j) + 1) ^ n * (C₀ / ((2 : ℝ) ^ j) ^ n)
            ≤ (5 * (2 : ℝ) ^ j) ^ n * (C₀ / ((2 : ℝ) ^ j) ^ n) := by gcongr; linarith
          _ = 5 ^ n * C₀ := by rw [mul_pow]; field_simp

/-- **Linearized bound via `TT*`** (Blueprint Lemma 8.1 (`lem:minorL2`), with Blueprint Lemma 2.5
(`lem:ttstar`)): for any selection of parameters `λ : G → ℝ`, if every column sum of the `TT*`
kernel satisfies `∑_x |H(x, y)| ≤ A`, then `‖x ↦ T_{j,λ_x} f(x)‖₂ ≤ A^{1/2} ‖f‖₂`. (Row sums
equal column sums since `|H(x, y)| = |H(y, x)|`.) -/
lemma minor_linearized_bound {j : ℕ} {C₀ : ℝ} (hC₀ : 0 ≤ C₀)
    (hK : ∀ a, ‖dyadicKernel Ω j a‖ ≤ C₀ / ((2 : ℝ) ^ j) ^ n) {A : ℝ} (lam : (Fin n → ℤ) → ℝ)
    (hcol : ∀ y, ∑' x, ‖minorTT Ω d j (lam x) (lam y) (y - x)‖ₑ ≤ ENNReal.ofReal A)
    {f : (Fin n → ℤ) → ℂ} (hf : MemLp f 2 Measure.count) :
    eLpNorm (fun x => minorOp Ω d j (lam x) f x) 2 Measure.count ≤
      ENNReal.ofReal A ^ (1 / 2 : ℝ) * eLpNorm f 2 Measure.count := by
  have hfun : (fun x => minorOp Ω d j (lam x) f x) =
      fun x => ∫ z, minorKer Ω d j lam x z * f z ∂Measure.count :=
    funext fun x => minorOp_eq_integral lam f x
  rw [hfun]
  have hκ : StronglyMeasurable (Function.uncurry (minorKer Ω d j lam)) :=
    (Measurable.of_discrete).stronglyMeasurable
  have hnorm : ∀ x z, ‖minorKer Ω d j lam x z‖ₑ = ‖dyadicKernel Ω j (latEmbed (x - z))‖ₑ := by
    intro x z
    rw [minorKer, enorm_mul, ← ofReal_norm (eC _), norm_eC, ENNReal.ofReal_one, one_mul]
  have hrow : ∀ x, ∫⁻ z, ‖minorKer Ω d j lam x z‖ₑ ∂Measure.count ≤
      ENNReal.ofReal (5 ^ n * C₀) := by
    intro x
    rw [lintegral_count]
    simp_rw [hnorm]
    refine ((Equiv.subLeft x).tsum_eq (fun y => ‖dyadicKernel Ω j (latEmbed y)‖ₑ)).trans_le ?_
    exact minor_tsum_enorm_kernel_le hC₀ hK
  have hcol' : ∀ z, ∫⁻ x, ‖minorKer Ω d j lam x z‖ₑ ∂Measure.count ≤
      ENNReal.ofReal (5 ^ n * C₀) := by
    intro z
    rw [lintegral_count]
    simp_rw [hnorm]
    refine ((Equiv.subRight z).tsum_eq (fun y => ‖dyadicKernel Ω j (latEmbed y)‖ₑ)).trans_le ?_
    exact minor_tsum_enorm_kernel_le hC₀ hK
  have hM : ∀ x z, ‖minorKer Ω d j lam x z‖ ≤ C₀ / ((2 : ℝ) ^ j) ^ n := by
    intro x z
    rw [minorKer, norm_mul, norm_eC, one_mul]; exact hK _
  refine band_eLpNorm_kernel_le_of_ttstar hκ ENNReal.ofReal_ne_top hrow hcol' hM ?_ hf
  intro v _
  rw [lintegral_count, minor_eLpNorm_two_sq]
  simp_rw [lintegral_count]
  refine minor_bilinear_schur _ _ (fun x => ?_) (fun x' => ?_)
  · simp_rw [norm_integral_minorKer_symm lam x, integral_minorKer_mul_conj]
    exact hcol x
  · simp_rw [integral_minorKer_mul_conj]
    exact hcol x'

/-! ### Lemma 8.1 -/

/-- `(1/j^U)^{-e} ≤ j^B` for `B ≥ U e`, `j ≥ 1`. -/
lemma minor_rpow_le {j U B : ℕ} {e : ℝ} (hj : 1 ≤ j) (hB : (U : ℝ) * e ≤ B) :
    (1 / (j : ℝ) ^ U) ^ (-e) ≤ (j : ℝ) ^ B := by
  have hJ : (1 : ℝ) ≤ j := by exact_mod_cast hj
  have hJ0 : (0 : ℝ) < j := by linarith
  rw [one_div, Real.inv_rpow (by positivity), Real.rpow_neg (by positivity), inv_inv,
    ← Real.rpow_natCast (j : ℝ) U, ← Real.rpow_mul hJ0.le, ← Real.rpow_natCast (j : ℝ) B]
  exact Real.rpow_le_rpow_of_exponent_le hJ hB

/-- `(c² / j^U)^{1/2} ≤ c j^{-κ}` for `U ≥ 2κ`, `j ≥ 1`, `c ≥ 0`. -/
lemma minor_sqrt_le {j U : ℕ} {c κ : ℝ} (hj : 1 ≤ j) (hc : 0 ≤ c) (hU : 2 * κ ≤ U) :
    ENNReal.ofReal (c ^ 2 / (j : ℝ) ^ U) ^ (1 / 2 : ℝ) ≤ ENNReal.ofReal (c * (j : ℝ) ^ (-κ)) := by
  have hJ : (1 : ℝ) ≤ j := by exact_mod_cast hj
  have hJ0 : (0 : ℝ) < j := by linarith
  rw [ENNReal.ofReal_rpow_of_nonneg (by positivity) (by norm_num)]
  refine ENNReal.ofReal_le_ofReal ?_
  rw [← Real.sqrt_eq_rpow]
  have hx : 0 ≤ c * (j : ℝ) ^ (-κ) := by positivity
  rw [← Real.sqrt_sq hx]
  refine Real.sqrt_le_sqrt ?_
  rw [mul_pow, ← Real.rpow_natCast ((j : ℝ) ^ (-κ)) 2, ← Real.rpow_mul hJ0.le, div_eq_mul_inv,
    ← Real.rpow_natCast (j : ℝ) U, ← Real.rpow_neg hJ0.le]
  gcongr
  push_cast; linarith

/-- Blueprint Lemma 8.1 (`lem:minorL2`), uniform form: let `n ≥ 1`, `d ≥ 1` and `Ω` an admissible
profile. For every real `κ` (the substance is `κ > 0`) there are integers `M₀, j₁ ≥ 1` and
`C ≥ 0` such that for
every `M ≥ M₀` (the arcs `X_j` depend on `M`), every `j ≥ j₁` and every `f ∈ ℓ²(ℤⁿ)`,
`‖sup_{λ ∉ X_j} |T_{j,λ} f|‖₂ ≤ C j^{-κ} ‖f‖₂` (the supremum of the empty family being `0`). -/
theorem minor_arc_decay_uniform {n d : ℕ} (hn : 1 ≤ n) (hd : 1 ≤ d)
    {Ω : EuclideanSpace ℝ (Fin n) → ℂ} (hΩ : IsSWProfile Ω) (κ : ℝ) :
    ∃ M₀ j₁ : ℕ, 1 ≤ M₀ ∧ 1 ≤ j₁ ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ M ≥ M₀, ∀ j ≥ j₁,
      ∀ f : (Fin n → ℤ) → ℂ, MemLp f 2 Measure.count →
        eLpNorm (fun x => ⨆ (lam : ℝ) (_ : lam ∉ minorArcs d M j), ‖minorOp Ω d j lam f x‖ₑ)
            2 Measure.count ≤
          ENNReal.ofReal (C * (j : ℝ) ^ (-κ)) * eLpNorm f 2 Measure.count := by
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  obtain ⟨C₀, C₁, hC₀, hC₁, hK⟩ := minor_kernel_bounds hΩ
  obtain ⟨Cw, e, hCw, he, hbadp⟩ := minor_bad_pair hΩ hd
  set U : ℕ := ⌈2 * κ⌉₊
  have hU : 2 * κ ≤ U := Nat.le_ceil _
  set B : ℕ := ⌈(U : ℝ) * e⌉₊
  have hB : (U : ℝ) * e ≤ B := Nat.le_ceil _
  obtain ⟨M₀, j₁, hM₀, hj₁, hcnt⟩ := minor_card_lt hd hCw B U
  set CH : ℝ := 5 ^ (m + 1) * C₀ ^ 2
  set c : ℝ := Real.sqrt (9 ^ (m + 1) + 9 ^ m * CH)
  have hc2 : c ^ 2 = 9 ^ (m + 1) + 9 ^ m * CH := Real.sq_sqrt (by positivity)
  refine ⟨M₀, j₁, hM₀, hj₁, c, Real.sqrt_nonneg _, fun M hM j hj f hf => ?_⟩
  have hj1 : 1 ≤ j := hj₁.trans hj
  have hJ0 : (0 : ℝ) < j := by exact_mod_cast hj1
  set ε : ℝ := 1 / (j : ℝ) ^ U
  have hε : 0 < ε := by positivity
  have hε1 : ε ≤ 1 := by
    rw [div_le_one (by positivity)]; exact one_le_pow₀ (by exact_mod_cast hj1)
  have hA : 9 ^ (m + 1) * ε + 9 ^ m * CH * ε = c ^ 2 / (j : ℝ) ^ U := by
    rw [hc2]; simp only [ε]; ring
  -- Lemma 2.1 and linearization reduce to a selection `λ : G → ℝ ∖ X_j`
  have hsup : (fun x => ⨆ (lam : ℝ) (_ : lam ∉ minorArcs d M j), ‖minorOp Ω d j lam f x‖ₑ) =
      fun x => ⨆ a : {lam : ℝ // lam ∉ minorArcs d M j}, ‖minorOp Ω d j a.1 f x‖ₑ := by
    funext x; rw [iSup_subtype']
  rw [hsup]
  refine eLpNorm_iSup_le_of_finset_count (by norm_num) _ _ fun F => ?_
  refine eLpNorm_finset_sup_le_of_linearization_op
    (fun (a : {lam : ℝ // lam ∉ minorArcs d M j}) f x => minorOp Ω d j a.1 f x) f F
    (fun _ _ => AEStronglyMeasurable.of_discrete) _ fun σ _ _ => ?_
  set lam : (Fin (m + 1) → ℤ) → ℝ := fun x => (σ x).1
  have hlam : ∀ x, lam x ∉ minorArcs d M j := fun x => (σ x).2
  refine (minor_linearized_bound hC₀ (hK j).1 lam (A := c ^ 2 / (j : ℝ) ^ U) (fun y => ?_) hf).trans
    (mul_le_mul_left (minor_sqrt_le hj1 (Real.sqrt_nonneg _) hU) _)
  -- the column bound
  rw [← (Equiv.subLeft y).tsum_eq]
  simp only [Equiv.subLeft_apply, sub_sub_cancel]
  rw [← hA]
  refine minor_column_bound (Q := Cw * (j : ℝ) ^ B) hC₀ (hK j).1 hε hε (fun lx h hbad => ?_)
    (fun T hT => hcnt M hM j hj (lam y) (hlam y) T hT) (fun h => lam (y - h))
  obtain ⟨q, hq1, hq2, hq3⟩ := hbadp j lx (lam y) h ε hε hε1 hbad
  have hle : Cw * ε ^ (-e) ≤ Cw * (j : ℝ) ^ B :=
    mul_le_mul_of_nonneg_left (minor_rpow_le hj1 hB) (by linarith)
  exact ⟨q, hq1, hq2.trans hle, hq3.trans (div_le_div_of_nonneg_right hle (by positivity))⟩

/-- Blueprint Lemma 8.1 (`lem:minorL2`, "Minor-arc decay with an arbitrarily large logarithmic
power"): let `n ≥ 1`, `d ≥ 1` and `Ω` an admissible profile (`IsSWProfile Ω`). For every
`κ > 0` (indeed every real `κ`) there is `M₀ ≥ 1` such that for every integer `M ≥ M₀` there
are `j₁ ≥ 1` and `C` with
`‖sup_{λ ∉ X_j} |T_{j,λ} f|‖_{ℓ²} ≤ C j^{-κ} ‖f‖_{ℓ²}` for all `j ≥ j₁` and all `f ∈ ℓ²(ℤⁿ)`,
where `T_{j,λ} f(x) = ∑_y e(λ P(y)) K_j(y) f(x - y)` (`minorOp`) and `X_j` (`minorArcs d M j`) is
the union of the arcs `‖λ - a/q‖_𝕋 ≤ w_j = (j+1)^M 2^{-Dj}` over reduced `a/q`,
`1 ≤ q < H_j = 2^{⌊M log₂(j+1)⌋}`. (The blueprint asserts this for some `M`; the version for all
`M ≥ M₀`, with `j₁` and `C` even independent of `M`, is `minor_arc_decay_uniform`.) -/
theorem minor_arc_decay {n d : ℕ} (hn : 1 ≤ n) (hd : 1 ≤ d)
    {Ω : EuclideanSpace ℝ (Fin n) → ℂ} (hΩ : IsSWProfile Ω) (κ : ℝ) :
    ∃ M₀ : ℕ, 1 ≤ M₀ ∧ ∀ M ≥ M₀, ∃ j₁ : ℕ, 1 ≤ j₁ ∧ ∃ C : ℝ, ∀ j ≥ j₁,
      ∀ f : (Fin n → ℤ) → ℂ, MemLp f 2 Measure.count →
        eLpNorm (fun x => ⨆ (lam : ℝ) (_ : lam ∉ minorArcs d M j), ‖minorOp Ω d j lam f x‖ₑ)
            2 Measure.count ≤
          ENNReal.ofReal (C * (j : ℝ) ^ (-κ)) * eLpNorm f 2 Measure.count := by
  obtain ⟨M₀, j₁, hM₀, hj₁, C, -, h⟩ := minor_arc_decay_uniform hn hd hΩ κ
  exact ⟨M₀, hM₀, fun M hM => ⟨j₁, hj₁, C, fun j hj f hf => h M hM j hj f hf⟩⟩

/-! ### Construction 8.2: the final exponent and the major-arc parameters -/

/-- The dual exponent `p' = p/(p-1)` of Blueprint Construction 8.2 (`con:parameters`). -/
noncomputable def paramDual (p : ℝ) : ℝ := p / (p - 1)

/-- The integer `r = ⌊max(p, p')⌋ + 1` of Blueprint Construction 8.2 (`con:parameters`)
(so `r ≥ 2` and `2r > max(p, p')` for `1 < p`). -/
noncomputable def paramR (p : ℝ) : ℕ := ⌊max p (paramDual p)⌋₊ + 1

/-- The exponent `a_p = min(2/p, 2/p')` of Blueprint Construction 8.2 (`con:parameters`). -/
noncomputable def paramA (p : ℝ) : ℝ := min (2 / p) (2 / paramDual p)

/-- The exponent `κ = 4 / a_p` (so `κ a_p = 4 > 3`) of Blueprint Construction 8.2
(`con:parameters`). -/
noncomputable def paramKappa (p : ℝ) : ℝ := 4 / paramA p

/-- The conclusion of `minor_arc_decay_uniform` for given `κ, M₀, j₁`. -/
def MinorDecaySpec (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (κ : ℝ) (M₀ j₁ : ℕ) : Prop :=
  1 ≤ M₀ ∧ 1 ≤ j₁ ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ M ≥ M₀, ∀ j ≥ j₁,
    ∀ f : (Fin n → ℤ) → ℂ, MemLp f 2 Measure.count →
      eLpNorm (fun x => ⨆ (lam : ℝ) (_ : lam ∉ minorArcs d M j), ‖minorOp Ω d j lam f x‖ₑ)
          2 Measure.count ≤
        ENNReal.ofReal (C * (j : ℝ) ^ (-κ)) * eLpNorm f 2 Measure.count

/-- A choice of `(M₀, j₁)` from `minor_arc_decay_uniform` for `κ = paramKappa p`. -/
noncomputable def paramMJ (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) : ℕ × ℕ :=
  Classical.epsilon fun q : ℕ × ℕ => MinorDecaySpec n d Ω (paramKappa p) q.1 q.2

/-- The integer `M ≥ 2` of Blueprint Construction 8.2 (`con:parameters`). -/
noncomputable def paramM (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) : ℕ :=
  max (paramMJ n d Ω p).1 2

/-- The lower scale `j₁` of Blueprint Construction 8.2 (`con:parameters`). -/
noncomputable def paramJ1 (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) : ℕ :=
  (paramMJ n d Ω p).2

/-- `ρ = 1/(16 M)` of Blueprint Construction 8.2 (`con:parameters`). -/
noncomputable def paramRho (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) : ℝ :=
  1 / (16 * (paramM n d Ω p : ℝ))

/-- The good rational sets `𝒰_N` (Construction 7.8 with `ρ = paramRho`) of Blueprint
Construction 8.2 (`con:parameters`). -/
noncomputable def paramGoodSet (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (N : ℕ) :
    Finset (Fin n → ZMod (blockProd (goodBlocks (paramRho n d Ω p) N))) :=
  goodSet (paramRho n d Ω p) N

/-- `p' > 1` for `p > 1`. -/
theorem one_lt_paramDual {p : ℝ} (hp : 1 < p) : 1 < paramDual p := by
  rw [paramDual, one_lt_div (by linarith)]; linarith

/-- `1/p + 1/p' = 1`. -/
theorem inv_add_inv_paramDual {p : ℝ} (hp : 1 < p) : 1 / p + 1 / paramDual p = 1 := by
  have : p - 1 ≠ 0 := by linarith
  rw [paramDual]; field_simp; ring

/-- `max(p, p') < r`. -/
theorem max_lt_paramR (p : ℝ) : max p (paramDual p) < paramR p := by
  rw [paramR]; push_cast; exact Nat.lt_floor_add_one _

/-- Blueprint Construction 8.2 (`con:parameters`): `r ≥ 2`. -/
theorem two_le_paramR {p : ℝ} (hp : 1 < p) : 2 ≤ paramR p := by
  have : 1 ≤ ⌊max p (paramDual p)⌋₊ :=
    Nat.le_floor (by push_cast; exact (le_max_left _ _).trans' hp.le)
  rw [paramR]; omega

/-- Blueprint Construction 8.2 (`con:parameters`): `2r > p`. -/
theorem lt_two_mul_paramR {p : ℝ} (hp : 1 < p) : p < 2 * (paramR p : ℝ) := by
  have := max_lt_paramR p
  have := le_max_left p (paramDual p)
  linarith

/-- Blueprint Construction 8.2 (`con:parameters`): `2r > p'`. -/
theorem paramDual_lt_two_mul_paramR {p : ℝ} (hp : 1 < p) : paramDual p < 2 * (paramR p : ℝ) := by
  have := max_lt_paramR p
  have := le_max_right p (paramDual p)
  have := one_lt_paramDual hp
  linarith

/-- Blueprint Construction 8.2 (`con:parameters`): `(2r)' ≤ p ≤ 2r`, the exponent range of
Theorem 7.7 (`thm:IW`). -/
theorem paramR_exponent_range {p : ℝ} (hp : 1 < p) :
    (2 * (paramR p : ℝ)) / (2 * (paramR p : ℝ) - 1) ≤ p ∧ p ≤ 2 * (paramR p : ℝ) := by
  refine ⟨?_, (lt_two_mul_paramR hp).le⟩
  have h := paramDual_lt_two_mul_paramR hp
  have hR : (4 : ℝ) ≤ 2 * (paramR p : ℝ) := by
    have := two_le_paramR hp; have : (2 : ℝ) ≤ paramR p := by exact_mod_cast this
    linarith
  set R := 2 * (paramR p : ℝ)
  rw [paramDual, div_lt_iff₀ (by linarith)] at h
  rw [div_le_iff₀ (by linarith)]
  nlinarith

/-- Blueprint Construction 8.2 (`con:parameters`): `a_p > 0`. -/
theorem paramA_pos {p : ℝ} (hp : 1 < p) : 0 < paramA p := by
  have := one_lt_paramDual hp
  rw [paramA]; exact lt_min (by positivity) (by positivity)

/-- `a_p = 2 - 2/p` for `p ≤ 2`. -/
theorem paramA_eq_of_le_two {p : ℝ} (hp : 1 < p) (hp2 : p ≤ 2) : paramA p = 2 - 2 / p := by
  have h2 : 2 / paramDual p = 2 - 2 / p := by
    rw [paramDual]; field_simp
  rw [paramA, h2, min_eq_right]
  rw [sub_le_iff_le_add, ← add_div, le_div_iff₀ (by linarith)]; nlinarith

/-- `a_p = 2/p` for `p ≥ 2`. -/
theorem paramA_eq_of_two_le {p : ℝ} (hp : 1 < p) (hp2 : 2 ≤ p) : paramA p = 2 / p := by
  have h2 : 2 / paramDual p = 2 - 2 / p := by
    rw [paramDual]; field_simp
  rw [paramA, h2, min_eq_left]
  rw [le_sub_iff_add_le, ← add_div, div_le_iff₀ (by linarith)]; nlinarith

/-- Blueprint Construction 8.2 (`con:parameters`): `κ a_p = 4 > 3`. -/
theorem paramKappa_mul_paramA {p : ℝ} (hp : 1 < p) : paramKappa p * paramA p = 4 := by
  rw [paramKappa]; field_simp [(paramA_pos hp).ne']

/-- Blueprint Construction 8.2 (`con:parameters`): `κ a_p > 3`. -/
theorem three_lt_paramKappa_mul_paramA {p : ℝ} (hp : 1 < p) : 3 < paramKappa p * paramA p := by
  rw [paramKappa_mul_paramA hp]; norm_num

/-- Blueprint Construction 8.2 (`con:parameters`): `M ≥ 2`. -/
theorem two_le_paramM (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) :
    2 ≤ paramM n d Ω p := le_max_right _ _

/-- Blueprint Construction 8.2 (`con:parameters`): `ρ = 1/(16M) > 0`. -/
theorem paramRho_pos (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) :
    0 < paramRho n d Ω p := by
  have : (2 : ℝ) ≤ paramM n d Ω p := by exact_mod_cast two_le_paramM n d Ω p
  rw [paramRho]; positivity

/-- Blueprint Construction 8.2 (`con:parameters`), used in (9.1): `2ρ < 1/(2M)`. -/
theorem two_mul_paramRho_lt (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) :
    2 * paramRho n d Ω p < 1 / (2 * (paramM n d Ω p : ℝ)) := by
  have : (2 : ℝ) ≤ paramM n d Ω p := by exact_mod_cast two_le_paramM n d Ω p
  rw [paramRho, mul_one_div, div_lt_div_iff₀ (by positivity) (by positivity)]
  nlinarith

/-- The choice `paramMJ` satisfies the conclusion of `minor_arc_decay_uniform`. -/
theorem paramMJ_spec {n d : ℕ} (hn : 1 ≤ n) (hd : 1 ≤ d) {Ω : EuclideanSpace ℝ (Fin n) → ℂ}
    (hΩ : IsSWProfile Ω) (p : ℝ) :
    MinorDecaySpec n d Ω (paramKappa p) (paramMJ n d Ω p).1 (paramMJ n d Ω p).2 := by
  obtain ⟨M₀, j₁, hM₀, hj₁, C, hC, h⟩ := minor_arc_decay_uniform hn hd hΩ (paramKappa p)
  exact Classical.epsilon_spec (p := fun q : ℕ × ℕ => MinorDecaySpec n d Ω (paramKappa p) q.1 q.2)
    ⟨(M₀, j₁), hM₀, hj₁, C, hC, h⟩

/-- Blueprint Construction 8.2 (`con:parameters`): `j₁ ≥ 1`. -/
theorem one_le_paramJ1 {n d : ℕ} (hn : 1 ≤ n) (hd : 1 ≤ d) {Ω : EuclideanSpace ℝ (Fin n) → ℂ}
    (hΩ : IsSWProfile Ω) (p : ℝ) : 1 ≤ paramJ1 n d Ω p :=
  (paramMJ_spec hn hd hΩ p).2.1

/-- Blueprint Lemma 8.1 (`lem:minorL2`) for the parameters `κ, M, j₁` of Construction 8.2
(`con:parameters`): `‖sup_{λ ∉ X_j} |T_{j,λ} f|‖₂ ≤ C j^{-κ} ‖f‖₂` for `j ≥ j₁`. -/
theorem param_minor_arc_decay {n d : ℕ} (hn : 1 ≤ n) (hd : 1 ≤ d)
    {Ω : EuclideanSpace ℝ (Fin n) → ℂ} (hΩ : IsSWProfile Ω) (p : ℝ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ j ≥ paramJ1 n d Ω p, ∀ f : (Fin n → ℤ) → ℂ, MemLp f 2 Measure.count →
      eLpNorm (fun x => ⨆ (lam : ℝ) (_ : lam ∉ minorArcs d (paramM n d Ω p) j),
          ‖minorOp Ω d j lam f x‖ₑ) 2 Measure.count ≤
        ENNReal.ofReal (C * (j : ℝ) ^ (-paramKappa p)) * eLpNorm f 2 Measure.count := by
  obtain ⟨-, -, C, hC, h⟩ := paramMJ_spec hn hd hΩ p
  exact ⟨C, hC, fun j hj f hf => h _ (le_max_left _ _) j hj f hf⟩

/-! ### The maximal minor-arc operator: pointwise majorant, sublinearity -/

/-- `T_{j,λ} f(x)` as a finite sum over the box `[-2^{j+1}, 2^{j+1}]ⁿ`. -/
lemma minorOp_eq_sum (j : ℕ) (lam : ℝ) (f : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) :
    minorOp Ω d j lam f x = ∑ y ∈ minorBox n (2 * 2 ^ j),
      eC (lam * (radialPolyZ n d y : ℝ)) * dyadicKernel Ω j (latEmbed y) * f (x - y) := by
  rw [minorOp, tsum_eq_sum]
  intro y hy
  rw [minor_kernel_eq_zero j hy, mul_zero, zero_mul]

/-- `|T_{j,λ} f(x)| ≤ (|K_j| * |f|)(x)`. -/
lemma enorm_minorOp_le (j : ℕ) (lam : ℝ) (f : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) :
    ‖minorOp Ω d j lam f x‖ₑ ≤
      ∑ y ∈ minorBox n (2 * 2 ^ j), ‖dyadicKernel Ω j (latEmbed y)‖ₑ * ‖f (x - y)‖ₑ := by
  rw [minorOp_eq_sum]
  refine (enorm_sum_le _ _).trans (sum_le_sum fun y _ => ?_)
  rw [enorm_mul, enorm_mul, ← ofReal_norm (eC _), norm_eC, ENNReal.ofReal_one, one_mul]

/-- `T_{j,λ}` is additive. -/
lemma minorOp_add (j : ℕ) (lam : ℝ) (f g : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) :
    minorOp Ω d j lam (f + g) x = minorOp Ω d j lam f x + minorOp Ω d j lam g x := by
  simp only [minorOp_eq_sum, Pi.add_apply, mul_add, sum_add_distrib]

/-- The maximal function `sup_{λ ∉ X} |T_{j,λ} f(x)|` (for a parameter set `X`). -/
noncomputable def minorSup (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (d j : ℕ) (X : Set ℝ)
    (f : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) : ℝ≥0∞ :=
  ⨆ (lam : ℝ) (_ : lam ∉ X), ‖minorOp Ω d j lam f x‖ₑ

/-- `sup_{λ ∉ X} |T_{j,λ} f| ≤ |K_j| * |f|`. -/
lemma minorSup_le (j : ℕ) (X : Set ℝ) (f : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) :
    minorSup Ω d j X f x ≤
      ∑ y ∈ minorBox n (2 * 2 ^ j), ‖dyadicKernel Ω j (latEmbed y)‖ₑ * ‖f (x - y)‖ₑ :=
  iSup₂_le fun lam _ => enorm_minorOp_le j lam f x

/-- `minorSup` is finite everywhere. -/
lemma minorSup_ne_top (j : ℕ) (X : Set ℝ) (f : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) :
    minorSup Ω d j X f x ≠ ∞ :=
  ne_top_of_le_ne_top
    (ENNReal.sum_ne_top.2 fun _ _ => ENNReal.mul_ne_top enorm_ne_top enorm_ne_top)
    (minorSup_le j X f x)

/-- `minorSup` is subadditive. -/
lemma minorSup_add_le (j : ℕ) (X : Set ℝ) (f g : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) :
    minorSup Ω d j X (f + g) x ≤ minorSup Ω d j X f x + minorSup Ω d j X g x := by
  refine iSup₂_le fun lam hlam => ?_
  rw [minorOp_add]
  exact (enorm_add_le _ _).trans (add_le_add
    (le_iSup₂ (f := fun (l : ℝ) (_ : l ∉ X) => ‖minorOp Ω d j l f x‖ₑ) lam hlam)
    (le_iSup₂ (f := fun (l : ℝ) (_ : l ∉ X) => ‖minorOp Ω d j l g x‖ₑ) lam hlam))

/-- The real-valued version of `minorSup` (finite everywhere), to which Marcinkiewicz
interpolation is applied. -/
noncomputable def minorSupR (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (d j : ℕ) (X : Set ℝ)
    (f : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) : ℝ :=
  (minorSup Ω d j X f x).toReal

/-- `|minorSupR| = minorSup`. -/
lemma enorm_minorSupR (j : ℕ) (X : Set ℝ) (f : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) :
    ‖minorSupR Ω d j X f x‖ₑ = minorSup Ω d j X f x := by
  rw [minorSupR, Real.enorm_eq_ofReal ENNReal.toReal_nonneg,
    ENNReal.ofReal_toReal (minorSup_ne_top j X f x)]

/-- `minorSupR` and `minorSup` have the same `ℓ^q` norms. -/
lemma eLpNorm_minorSupR (j : ℕ) (X : Set ℝ) (f : (Fin n → ℤ) → ℂ) (q : ℝ≥0∞) :
    eLpNorm (minorSupR Ω d j X f) q Measure.count =
      eLpNorm (minorSup Ω d j X f) q Measure.count :=
  eLpNorm_congr_enorm_ae AEStronglyMeasurable.of_discrete AEStronglyMeasurable.of_discrete
    (ae_of_all _ fun x => by rw [enorm_minorSupR, enorm_eq_self])

/-- Uniform `ℓ¹` bound of the kernels `K_j` (on the box containing their support). -/
lemma minor_box_kernel_le (hΩ : IsSWProfile Ω) :
    ∃ C₀ : ℝ, 0 ≤ C₀ ∧ ∀ j : ℕ,
      ∑ y ∈ minorBox n (2 * 2 ^ j), ‖dyadicKernel Ω j (latEmbed y)‖ₑ ≤ ENNReal.ofReal C₀ := by
  obtain ⟨C₀, C₁, hC₀, -, hK⟩ := minor_kernel_bounds hΩ
  exact ⟨5 ^ n * C₀, by positivity, fun j =>
    (ENNReal.sum_le_tsum _).trans (minor_tsum_enorm_kernel_le hC₀ (hK j).1)⟩

/-- Interpolation of the uniform strong `(1,1)` and `(∞,∞)` bounds of
`sup_{λ ∉ X} |T_{j,λ} f| ≤ |K_j| * |f|` with an `ℓ²` bound `B`: for `1 < p < ∞`,
`‖sup_{λ ∉ X} |T_{j,λ} f|‖_p ≤ K B^{a_p} ‖f‖_p`, `a_p = min(2/p, 2/p')`, with `K` independent of
`j`, `X`, `B` and `f` (the interpolation step of Blueprint Construction 8.2
(`con:parameters`)). -/
theorem minorSup_lp_of_l2 (hΩ : IsSWProfile Ω) {p : ℝ} (hp : 1 < p) :
    ∃ K : ℝ≥0∞, K ≠ ∞ ∧ ∀ (j : ℕ) (X : Set ℝ) (B : ℝ≥0), 0 < B →
      (∀ f : (Fin n → ℤ) → ℂ, MemLp f 2 Measure.count →
        eLpNorm (minorSup Ω d j X f) 2 Measure.count ≤ (B : ℝ≥0∞) * eLpNorm f 2 Measure.count) →
      ∀ f : (Fin n → ℤ) → ℂ, MemLp f (ENNReal.ofReal p) Measure.count →
        eLpNorm (minorSup Ω d j X f) (ENNReal.ofReal p) Measure.count ≤
          K * (B : ℝ≥0∞) ^ paramA p * eLpNorm f (ENNReal.ofReal p) Measure.count := by
  obtain ⟨C₀, hC₀, hbox⟩ := minor_box_kernel_le hΩ
  set A : ℝ≥0 := C₀.toNNReal
  have hA : (A : ℝ≥0∞) = ENNReal.ofReal C₀ := rfl
  set D : Set ((Fin n → ℤ) → ℂ) := {f | MemLp f (ENNReal.ofReal p) Measure.count}
  have hD : IsTruncationClosed D := isTruncationClosed_memLp
  -- sublinearity
  have hsub : ∀ j X, IsSublinearOn (minorSupR Ω d j X) D Measure.count := by
    intro j X f _ g _
    refine ae_of_all _ fun x => ?_
    simp only [minorSupR, Real.norm_eq_abs, abs_of_nonneg ENNReal.toReal_nonneg]
    rw [← ENNReal.toReal_add (minorSup_ne_top j X f x) (minorSup_ne_top j X g x)]
    exact ENNReal.toReal_mono (ENNReal.add_ne_top.2 ⟨minorSup_ne_top j X f x,
      minorSup_ne_top j X g x⟩) (minorSup_add_le j X f g x)
  -- the `(∞, ∞)` bound
  have hinf : ∀ j X, HasLinftyBoundOn (minorSupR Ω d j X) D A Measure.count := by
    intro j X f _ s hs
    refine ae_of_all _ fun x => ?_
    have hs0 : 0 ≤ s := (norm_nonneg _).trans (hs 0)
    rw [Real.norm_eq_abs, minorSupR, abs_of_nonneg ENNReal.toReal_nonneg, Real.coe_toNNReal _ hC₀]
    refine ENNReal.toReal_le_of_le_ofReal (by positivity) ?_
    calc minorSup Ω d j X f x
        ≤ ∑ y ∈ minorBox n (2 * 2 ^ j), ‖dyadicKernel Ω j (latEmbed y)‖ₑ * ENNReal.ofReal s := by
          refine (minorSup_le j X f x).trans (sum_le_sum fun y _ => ?_)
          gcongr
          rw [← ofReal_norm]; exact ENNReal.ofReal_le_ofReal (hs _)
      _ ≤ ENNReal.ofReal C₀ * ENNReal.ofReal s := by rw [← sum_mul]; gcongr; exact hbox j
      _ = ENNReal.ofReal (C₀ * s) := (ENNReal.ofReal_mul hC₀).symm
  -- the strong `(1, 1)` bound
  have hone : ∀ j X, HasStrongTypeOn (minorSupR Ω d j X) D 1 A Measure.count Measure.count := by
    intro j X f _
    rw [ENNReal.ofReal_one, eLpNorm_one_eq_lintegral_enorm AEStronglyMeasurable.of_discrete,
      eLpNorm_one_eq_lintegral_enorm AEStronglyMeasurable.of_discrete, lintegral_count,
      lintegral_count]
    simp_rw [enorm_minorSupR]
    calc ∑' x, minorSup Ω d j X f x
        ≤ ∑' x, ∑ y ∈ minorBox n (2 * 2 ^ j),
            ‖dyadicKernel Ω j (latEmbed y)‖ₑ * ‖f (x - y)‖ₑ :=
          ENNReal.tsum_le_tsum fun x => minorSup_le j X f x
      _ = ∑ y ∈ minorBox n (2 * 2 ^ j),
            ‖dyadicKernel Ω j (latEmbed y)‖ₑ * ∑' x, ‖f x‖ₑ := by
          rw [Summable.tsum_finsetSum fun _ _ => ENNReal.summable]
          refine sum_congr rfl fun y _ => ?_
          rw [ENNReal.tsum_mul_left]
          congr 1
          exact (Equiv.subRight y).tsum_eq (fun z => ‖f z‖ₑ)
      _ ≤ (A : ℝ≥0∞) * ∑' x, ‖f x‖ₑ := by rw [← sum_mul, hA]; gcongr; exact hbox j
  -- the `ℓ²` bound, on `D`
  have htwo : ∀ j X (B : ℝ≥0), 0 < B →
      (∀ f : (Fin n → ℤ) → ℂ, MemLp f 2 Measure.count →
        eLpNorm (minorSup Ω d j X f) 2 Measure.count ≤ (B : ℝ≥0∞) * eLpNorm f 2 Measure.count) →
      HasStrongTypeOn (minorSupR Ω d j X) D 2 B Measure.count Measure.count := by
    intro j X B hB h f _
    rw [ENNReal.ofReal_ofNat, eLpNorm_minorSupR]
    by_cases hf2 : MemLp f 2 Measure.count
    · exact h f hf2
    · have : eLpNorm f 2 Measure.count = ∞ := by
        by_contra hne
        exact hf2 (memLp_iff.2 (lt_top_iff_ne_top.2 hne))
      rw [this, ENNReal.mul_top (by exact_mod_cast hB.ne')]
      exact le_top
  have hmeas : ∀ j X (f : (Fin n → ℤ) → ℂ),
      AEStronglyMeasurable (minorSupR Ω d j X f) Measure.count :=
    fun _ _ _ => AEStronglyMeasurable.of_discrete
  rcases lt_trichotomy p 2 with hp2 | rfl | hp2
  · -- `1 < p < 2`: interpolate between `(1,1)` and `(2,2)`, `θ = 2 - 2/p`
    set θ : ℝ := 2 - 2 / p
    have hθ : 1 / p = (1 - θ) / 1 + θ / 2 := by simp only [θ]; field_simp; ring
    have h1θ : 0 ≤ 1 - θ := by
      have : 1 ≤ 2 / p := by rw [le_div_iff₀ (by linarith)]; linarith
      simp only [θ]; linarith
    refine ⟨(marcinkiewiczConst 1 2 p : ℝ≥0∞) * (A : ℝ≥0∞) ^ (1 - θ),
      ENNReal.mul_ne_top ENNReal.coe_ne_top (ENNReal.rpow_ne_top_of_nonneg h1θ ENNReal.coe_ne_top),
      fun j X B hB h f hf => ?_⟩
    rw [paramA_eq_of_le_two hp hp2.le, ← eLpNorm_minorSupR]
    exact eLpNorm_le_of_hasWeakTypeOn one_pos hp hp2 hθ
      ((hone j X).hasWeakTypeOn one_pos) ((htwo j X B hB h).hasWeakTypeOn two_pos) (hsub j X) hD
      hf AEStronglyMeasurable.of_discrete (hmeas j X f)
  · -- `p = 2`
    refine ⟨1, ENNReal.one_ne_top, fun j X B _ h f hf => ?_⟩
    rw [paramA_eq_of_two_le hp le_rfl, div_self two_ne_zero, ENNReal.rpow_one, one_mul,
      ENNReal.ofReal_ofNat]
    exact h f (by simpa using hf)
  · -- `2 < p < ∞`: interpolate between `(2,2)` and `(∞,∞)`
    have h1 : 0 ≤ 1 - 2 / p := by rw [sub_nonneg, div_le_one (by linarith)]; linarith
    refine ⟨(marcinkiewiczConstTop 2 p : ℝ≥0∞) * (A : ℝ≥0∞) ^ (1 - 2 / p),
      ENNReal.mul_ne_top ENNReal.coe_ne_top (ENNReal.rpow_ne_top_of_nonneg h1 ENNReal.coe_ne_top),
      fun j X B hB h f hf => ?_⟩
    rw [paramA_eq_of_two_le hp hp2.le, ← eLpNorm_minorSupR]
    calc eLpNorm (minorSupR Ω d j X f) (ENNReal.ofReal p) Measure.count
        ≤ (marcinkiewiczConstTop 2 p : ℝ≥0∞) * (B : ℝ≥0∞) ^ (2 / p) * (A : ℝ≥0∞) ^ (1 - 2 / p) *
            eLpNorm f (ENNReal.ofReal p) Measure.count :=
          eLpNorm_le_of_hasWeakTypeOn_of_linfty two_pos hp2
            ((htwo j X B hB h).hasWeakTypeOn two_pos) (hinf j X) (hsub j X) hD hf
            AEStronglyMeasurable.of_discrete (hmeas j X f) (Or.inr hf.eLpNorm_ne_top)
      _ = _ := by ring


/-- Blueprint Construction 8.2 (`con:parameters`), eq. (8.2) (`eq:minorp`): let `n ≥ 1`, `d ≥ 1`,
`Ω` an admissible profile and `1 < p < ∞`, and let `r = paramR p`, `κ = paramKappa p`
(`κ a_p = 4 > 3`), `M = paramM n d Ω p ≥ 2` and `j₁ = paramJ1 n d Ω p` be the parameters of
Construction 8.2 (`M, j₁` from Lemma 8.1 (`lem:minorL2`) for this `κ`). There is a constant `C ≥ 0`
such that for every `j ≥ j₁` and every `f ∈ ℓ^p(ℤⁿ)`,
`‖sup_{λ ∉ X_j} |T_{j,λ} f|‖_{ℓ^p} ≤ C j^{-2} ‖f‖_{ℓ^p}`, where `X_j = minorArcs d M j`. -/
theorem minor_arc_decay_lp {n d : ℕ} (hn : 1 ≤ n) (hd : 1 ≤ d)
    {Ω : EuclideanSpace ℝ (Fin n) → ℂ} (hΩ : IsSWProfile Ω) {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ j ≥ paramJ1 n d Ω p, ∀ f : (Fin n → ℤ) → ℂ,
      MemLp f (ENNReal.ofReal p) Measure.count →
        eLpNorm (fun x => ⨆ (lam : ℝ) (_ : lam ∉ minorArcs d (paramM n d Ω p) j),
            ‖minorOp Ω d j lam f x‖ₑ) (ENNReal.ofReal p) Measure.count ≤
          ENNReal.ofReal (C * (j : ℝ) ^ (-2 : ℝ)) * eLpNorm f (ENNReal.ofReal p) Measure.count := by
  obtain ⟨C, hC, hdec⟩ := param_minor_arc_decay hn hd hΩ p
  obtain ⟨K, hK, hint⟩ := minorSup_lp_of_l2 (d := d) hΩ hp
  have ha := paramA_pos hp
  have hκa := paramKappa_mul_paramA hp
  refine ⟨K.toReal * (C + 1) ^ paramA p, by positivity, fun j hj f hf => ?_⟩
  have hj1 : 1 ≤ j := (one_le_paramJ1 hn hd hΩ p).trans hj
  have hJ : (1 : ℝ) ≤ j := by exact_mod_cast hj1
  have hJ0 : (0 : ℝ) < j := by linarith
  set b : ℝ := (C + 1) * (j : ℝ) ^ (-paramKappa p)
  have hb : 0 < b := by positivity
  have hB : ((b.toNNReal : ℝ≥0) : ℝ≥0∞) = ENNReal.ofReal b := rfl
  have h2 : ∀ g : (Fin n → ℤ) → ℂ, MemLp g 2 Measure.count →
      eLpNorm (minorSup Ω d j (minorArcs d (paramM n d Ω p) j) g) 2 Measure.count ≤
        ((b.toNNReal : ℝ≥0) : ℝ≥0∞) * eLpNorm g 2 Measure.count := by
    intro g hg
    refine (hdec j hj g hg).trans ?_
    rw [hB]
    gcongr
    have := Real.rpow_pos_of_pos hJ0 (-paramKappa p)
    simp only [b]; nlinarith
  refine (hint j _ b.toNNReal (Real.toNNReal_pos.2 hb) h2 f hf).trans ?_
  rw [hB, ENNReal.ofReal_rpow_of_nonneg hb.le ha.le]
  gcongr
  rw [mul_assoc, ENNReal.ofReal_mul ENNReal.toReal_nonneg, ENNReal.ofReal_toReal hK]
  gcongr
  simp only [b]
  rw [Real.mul_rpow (by linarith) (by positivity), ← Real.rpow_mul hJ0.le, neg_mul, hκa]
  gcongr
  norm_num

end MinorArcs

