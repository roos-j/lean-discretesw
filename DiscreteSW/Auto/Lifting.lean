variable {n : ℕ}

/-! ### The cutoffs `χ` and `χ̃` -/

/-- `χ̃ = θ = companionCutoff n` is even. -/
lemma companionCutoff_neg (ξ : EuclideanSpace ℝ (Fin n)) :
    companionCutoff n (-ξ) = companionCutoff n ξ := by
  unfold companionCutoff
  refine Finset.prod_congr rfl fun i _ => ?_
  rw [PiLp.neg_apply]
  exact companionBump.neg _

/-- The smooth real even product cutoff `χ(ξ) = θ(2ξ) = ∏ᵢ ψ(2ξᵢ)` of the §9 setup: `0 ≤ χ ≤ 1`,
`χ = 1` on `[-1/2,1/2]ⁿ`, `supp χ ⊆ [-1,1]ⁿ`. -/
noncomputable def liftCutoff (n : ℕ) (ξ : EuclideanSpace ℝ (Fin n)) : ℝ :=
  companionCutoff n ((2 : ℝ) • ξ)

/-- `χ` is a product cutoff: `χ(ξ) = ∏ᵢ ψ(2ξᵢ)`. -/
lemma liftCutoff_eq_prod (ξ : EuclideanSpace ℝ (Fin n)) :
    liftCutoff n ξ = ∏ i, companionBump (2 * ξ i) := by
  simp [liftCutoff, companionCutoff, PiLp.smul_apply, smul_eq_mul]

lemma liftCutoff_nonneg (ξ : EuclideanSpace ℝ (Fin n)) : 0 ≤ liftCutoff n ξ :=
  companionCutoff_nonneg _

lemma liftCutoff_le_one (ξ : EuclideanSpace ℝ (Fin n)) : liftCutoff n ξ ≤ 1 :=
  companionCutoff_le_one _

lemma liftCutoff_neg (ξ : EuclideanSpace ℝ (Fin n)) : liftCutoff n (-ξ) = liftCutoff n ξ := by
  rw [liftCutoff, smul_neg, companionCutoff_neg, liftCutoff]

lemma liftCutoff_eq_one {ξ : EuclideanSpace ℝ (Fin n)} (h : ∀ i, |ξ i| ≤ 1 / 2) :
    liftCutoff n ξ = 1 :=
  companionCutoff_eq_one fun i => by
    rw [PiLp.smul_apply, smul_eq_mul, abs_mul, abs_two]
    linarith [h i]

lemma liftCutoff_eq_zero {ξ : EuclideanSpace ℝ (Fin n)} (h : ¬ ∀ i, |ξ i| < 1) :
    liftCutoff n ξ = 0 := by
  refine companionCutoff_eq_zero fun h' => h fun i => ?_
  have := h' i
  rw [PiLp.smul_apply, smul_eq_mul, abs_mul, abs_two] at this
  linarith

/-- `supp χ ⊆ [-1,1]ⁿ`. -/
lemma support_liftCutoff :
    Function.support (liftCutoff n) ⊆ {ξ | ∀ i, |ξ i| ≤ 1} := fun ξ hξ i => by
  by_contra h
  exact hξ (liftCutoff_eq_zero fun h' => h (h' i).le)

/-- `supp χ̃ ⊆ [-2,2]ⁿ`. -/
lemma support_companionCutoff :
    Function.support (companionCutoff n) ⊆ {ξ | ∀ i, |ξ i| ≤ 2} := fun _ hξ i => by
  by_contra h
  exact hξ (companionCutoff_eq_zero fun h' => h (h' i).le)

lemma contDiff_liftCutoff : ContDiff ℝ ∞ (liftCutoff n) :=
  contDiff_companionCutoff.comp (contDiff_const_smul (2 : ℝ))

lemma hasCompactSupport_liftCutoff : HasCompactSupport (liftCutoff n) :=
  HasCompactSupport.intro (isCompact_box 1) fun _ hξ =>
    liftCutoff_eq_zero fun h => hξ fun i => (h i).le

/-- The cutoff `χ` as a (complex-valued) Schwartz function. -/
noncomputable def liftCutoffSchwartz (n : ℕ) : 𝓢(EuclideanSpace ℝ (Fin n), ℂ) :=
  (hasCompactSupport_liftCutoff (n := n)).comp_left (g := Complex.ofReal) Complex.ofReal_zero
    |>.toSchwartzMap (Complex.ofRealCLM.contDiff.comp contDiff_liftCutoff)

@[simp] lemma liftCutoffSchwartz_apply (ξ : EuclideanSpace ℝ (Fin n)) :
    liftCutoffSchwartz n ξ = (liftCutoff n ξ : ℂ) := rfl

/-- `χ θ = χ` (`θ = χ̃ = 1` on `supp χ`). -/
lemma liftCutoff_mul_companionCutoff (ξ : EuclideanSpace ℝ (Fin n)) :
    liftCutoff n ξ * companionCutoff n ξ = liftCutoff n ξ := by
  by_cases h : liftCutoff n ξ = 0
  · rw [h, zero_mul]
  · rw [companionCutoff_eq_one fun i => support_liftCutoff h i, mul_one]

/-! ### Scales (eq. (9.1), `eq:vs`) -/

/-- `r = paramR p ≥ 1` (for every real `p`). -/
lemma one_le_paramR (p : ℝ) : 1 ≤ paramR p := by unfold paramR; omega

/-- The constant `C_{ρ,r}` of `goodBlocks_eps_threshold` for `ρ = paramRho`, `r = paramR p`
(a fixed choice). -/
noncomputable def liftCrho (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) : ℝ :=
  Classical.choose (goodBlocks_eps_threshold (paramRho_pos n d Ω p) (paramR p) (one_le_paramR p))

lemma liftCrho_spec (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) :
    0 < liftCrho n d Ω p ∧ ∀ N : ℕ, 2 ≤ N → ∀ ε : ℝ, 0 < ε →
      ε ≤ Real.exp (-(liftCrho n d Ω p * (N : ℝ) ^ (2 * paramRho n d Ω p))) →
      ε ≤ (100 * paramR p * (blockStar (goodBlocks (paramRho n d Ω p) N) : ℝ) ^
        (2 * paramR p * goodK (paramRho n d Ω p)))⁻¹ :=
  Classical.choose_spec
    (goodBlocks_eps_threshold (paramRho_pos n d Ω p) (paramR p) (one_le_paramR p))

/-- `N_s = 2^s` of eq. (9.1) (`eq:vs`). -/
def liftN (s : ℕ) : ℕ := 2 ^ s

/-- The constant `C_* = 100 (n + D + 1) + 2 C_{ρ,r} + 2` (`D = 2d`) of eq. (9.1) (`eq:vs`),
chosen so that eq. (9.2) (`eq:scalerequirements`) holds (`exists_liftCStar`). -/
noncomputable def liftCStar (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) : ℝ :=
  100 * ((n : ℝ) + 2 * d + 1) + 2 * liftCrho n d Ω p + 2

/-- `v_s = ⌈C_* (s+1)(1 + 2^{s/(2M)})⌉` of eq. (9.1) (`eq:vs`). -/
noncomputable def liftV (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ) : ℕ :=
  ⌈liftCStar n d Ω p * ((s : ℝ) + 1) *
    (1 + (2 : ℝ) ^ ((s : ℝ) / (2 * (paramM n d Ω p : ℝ))))⌉₊

/-- `L_s = 2^{v_s}` of eq. (9.1) (`eq:vs`). -/
noncomputable def liftL (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ) : ℕ :=
  2 ^ liftV n d Ω p s

/-- `χ_s(ξ) = χ(L_s ξ)` of eq. (9.1) (`eq:vs`). -/
noncomputable def liftChi (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ)
    (ξ : EuclideanSpace ℝ (Fin n)) : ℝ :=
  liftCutoff n ((liftL n d Ω p s : ℝ) • ξ)

/-- `χ̃_s(ξ) = χ̃(L_s ξ)` of eq. (9.1) (`eq:vs`), with `χ̃ = θ = companionCutoff n`. -/
noncomputable def liftChiT (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ)
    (ξ : EuclideanSpace ℝ (Fin n)) : ℝ :=
  companionCutoff n ((liftL n d Ω p s : ℝ) • ξ)

variable {d : ℕ} {Ω : EuclideanSpace ℝ (Fin n) → ℂ} {p : ℝ}

lemma liftCrho_pos : 0 < liftCrho n d Ω p := (liftCrho_spec n d Ω p).1

lemma liftCStar_pos : 0 < liftCStar n d Ω p := by
  have := liftCrho_pos (n := n) (d := d) (Ω := Ω) (p := p)
  unfold liftCStar; positivity

lemma liftL_pos (s : ℕ) : (0 : ℝ) < liftL n d Ω p s := by unfold liftL; positivity

lemma two_le_liftN {s : ℕ} (hs : 1 ≤ s) : 2 ≤ liftN s := by
  unfold liftN
  calc 2 = 2 ^ 1 := rfl
    _ ≤ 2 ^ s := Nat.pow_le_pow_right (by norm_num) hs

/-- The core of eq. (9.2): for every `C ≥ 100 (n + D + 1) + 2 C_{ρ,r} + 2` and every `s`, the
integer `v = ⌈C(s+1)(1 + 2^{s/(2M)})⌉` satisfies `v ≥ 100(n+D+1)(s+1)` and
`4/2^v ≤ exp(-C_{ρ,r} N_s^{2ρ})`. -/
lemma scale_requirements_of_le {C : ℝ}
    (hC : 100 * ((n : ℝ) + 2 * d + 1) + 2 * liftCrho n d Ω p + 2 ≤ C) (s : ℕ) :
    100 * (n + 2 * d + 1) * (s + 1) ≤
        ⌈C * ((s : ℝ) + 1) * (1 + (2 : ℝ) ^ ((s : ℝ) / (2 * (paramM n d Ω p : ℝ))))⌉₊ ∧
      4 / (2 : ℝ) ^ ⌈C * ((s : ℝ) + 1) *
          (1 + (2 : ℝ) ^ ((s : ℝ) / (2 * (paramM n d Ω p : ℝ))))⌉₊ ≤
