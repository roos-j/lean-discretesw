    have hNt : ((liftN s : ℕ) : ℝ) ^ (2 * ρ) ≤ t := by
      have h2ρ : 2 * ρ < 1 / (2 * M) := two_mul_paramRho_lt n d Ω p
      rw [liftN, Nat.cast_pow, Nat.cast_ofNat, ← Real.rpow_natCast, ← Real.rpow_mul (by norm_num)]
      refine Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_
