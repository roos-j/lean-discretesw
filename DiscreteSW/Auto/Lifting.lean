        have : (2 * K + 2) * (1 + t) ≤ C * (1 + t) :=
          mul_le_mul_of_nonneg_right (by linarith) (by linarith)
        linarith
      have h2 : (2 * K + 2) * (1 + t) * Real.log 2 ≤ v * Real.log 2 :=
        mul_le_mul_of_nonneg_right h1 hl0.le
      have h3 : (K + 1) * (1 + t) ≤ (2 * K + 2) * (1 + t) * Real.log 2 := by
        have : 0 ≤ (K + 1) * (1 + t) := by positivity
        nlinarith
      have h4 : K * ((liftN s : ℕ) : ℝ) ^ (2 * ρ) ≤ K * t := mul_le_mul_of_nonneg_left hNt hK.le
      nlinarith
