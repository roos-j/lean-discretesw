      norm_num
    rw [h2v, h4, ← Real.exp_sub]
    exact Real.exp_le_exp.2 (by linarith)

/-- Eq. (9.2) (`eq:scalerequirements`) of the §9 setup, existence of `C_*`: there is `C_* > 0`
such that for every `s ≥ 1`, `v_s = ⌈C_*(s+1)(1 + 2^{s/(2M)})⌉` satisfies
`v_s ≥ 100(n+D+1)(s+1)` (`D = 2d`) and `4/2^{v_s} ≤ exp(-C_{ρ,r} N_s^{2ρ})`; the choice
`C_* = liftCStar` used in `liftV` is such a constant. -/
theorem exists_liftCStar (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) :
    ∃ C : ℝ, 0 < C ∧ C = liftCStar n d Ω p ∧ ∀ s : ℕ, 1 ≤ s →
      100 * (n + 2 * d + 1) * (s + 1) ≤
          ⌈C * ((s : ℝ) + 1) * (1 + (2 : ℝ) ^ ((s : ℝ) / (2 * (paramM n d Ω p : ℝ))))⌉₊ ∧
        4 / (2 : ℝ) ^ ⌈C * ((s : ℝ) + 1) *
            (1 + (2 : ℝ) ^ ((s : ℝ) / (2 * (paramM n d Ω p : ℝ))))⌉₊ ≤
          Real.exp (-(liftCrho n d Ω p * ((liftN s : ℕ) : ℝ) ^ (2 * paramRho n d Ω p))) :=
  ⟨liftCStar n d Ω p, liftCStar_pos, rfl, fun s _ => scale_requirements_of_le le_rfl s⟩

/-- Eq. (9.2) (`eq:scalerequirements`), first requirement: `v_s ≥ 100(n+D+1)(s+1)` (`D = 2d`;
it holds for every `s`, in particular for `s ≥ 1`). -/
theorem liftV_ge (s : ℕ) : 100 * (n + 2 * d + 1) * (s + 1) ≤ liftV n d Ω p s :=
  (scale_requirements_of_le le_rfl s).1

/-- Eq. (9.2) (`eq:scalerequirements`), second requirement: `4/L_s ≤ exp(-C_{ρ,r} N_s^{2ρ})`
(for every `s`, in particular for `s ≥ 1`). -/
theorem four_div_liftL_le (s : ℕ) :
    4 / (liftL n d Ω p s : ℝ) ≤
      Real.exp (-(liftCrho n d Ω p * ((liftN s : ℕ) : ℝ) ^ (2 * paramRho n d Ω p))) := by
  have := (scale_requirements_of_le (n := n) (d := d) (Ω := Ω) (p := p) le_rfl s).2
  rw [liftL, Nat.cast_pow, Nat.cast_ofNat]
  exact this

/-- `L_s ≥ 2^{100(n+D+1)(s+1)}`, a consequence of eq. (9.2) (`eq:scalerequirements`). -/
theorem pow_le_liftL (s : ℕ) : 2 ^ (100 * (n + 2 * d + 1) * (s + 1)) ≤ liftL n d Ω p s :=
  Nat.pow_le_pow_right (by norm_num) (liftV_ge s)

/-- Consequence of eq. (9.2) (`eq:scalerequirements`): for `s ≥ 1`, `ε = 4/L_s` satisfies
hypothesis (7.1) of Theorem 7.7 (`thm:IW`) for the blocks of `𝒰_{N_s}`:
`4/L_s ≤ (100 r q_*^{2rk})⁻¹`. -/
theorem liftEps_threshold {s : ℕ} (hs : 1 ≤ s) :
    4 / (liftL n d Ω p s : ℝ) ≤
      (100 * paramR p * (blockStar (goodBlocks (paramRho n d Ω p) (liftN s)) : ℝ) ^
        (2 * paramR p * goodK (paramRho n d Ω p)))⁻¹ :=
  (liftCrho_spec n d Ω p).2 (liftN s) (two_le_liftN hs) _
    (div_pos (by norm_num) (liftL_pos s)) (four_div_liftL_le s)

/-- Consequence of eq. (9.2) (`eq:scalerequirements`): Theorem 7.7 (`thm:IW`) applies to
`𝒰_{N_s}` with `ε = 4/L_s`. For `1 < p`, `r = paramR p`, there is `C ≥ 0` such that for every
`s ≥ 1`, every bounded measurable `m` supported in `[-2/L_s, 2/L_s]ⁿ` with Euclidean `L^{2r}`
multiplier norm `≤ A`, and every finitely supported `f`, `‖T_{m;𝒰_{N_s}} f‖_{ℓ^p} ≤ C A ‖f‖_{ℓ^p}`. -/
theorem lift_transference (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ s : ℕ, 1 ≤ s →
      ∀ (m : EuclideanSpace ℝ (Fin n) → ℂ) (B A : ℝ), AEStronglyMeasurable m volume →
      (∀ ξ, ‖m ξ‖ ≤ B) →
      Function.support m ⊆ {ξ | ∀ i, |ξ i| ≤ 2 / (liftL n d Ω p s : ℝ)} →
      (∀ F : 𝓢(EuclideanSpace ℝ (Fin n), ℂ),
        eLpNorm (𝓕⁻ (fun ξ => m ξ * 𝓕 (F : EuclideanSpace ℝ (Fin n) → ℂ) ξ))
          (ENNReal.ofReal (2 * paramR p)) volume ≤
            ENNReal.ofReal A * eLpNorm F (ENNReal.ofReal (2 * paramR p)) volume) →
      ∀ f : (Fin n → ℤ) → ℂ, (Function.support f).Finite →
        eLpNorm (cosetMult (blockProd (goodBlocks (paramRho n d Ω p) (liftN s))) m
            (paramGoodSet n d Ω p (liftN s)) f) (ENNReal.ofReal p) Measure.count ≤
          ENNReal.ofReal (C * A) * eLpNorm f (ENNReal.ofReal p) Measure.count := by
  obtain ⟨C, hC, hT⟩ := coprime_block_multiplier_transference n (goodK (paramRho n d Ω p))
    (paramR p) (one_le_paramR p) (paramR_exponent_range hp).1 (paramR_exponent_range hp).2
  refine ⟨C, hC, fun s hs m B A hm hB hsupp hA f hf => ?_⟩
  have hL := liftL_pos (n := n) (d := d) (Ω := Ω) (p := p) s
  refine hT (goodBlocks (paramRho n d Ω p) (liftN s)) goodBlocks_one_lt
    goodBlocks_pairwise_coprime (4 / (liftL n d Ω p s : ℝ)) (by positivity)
    (liftEps_threshold hs) m B A hm hB ?_ hA f hf
  refine hsupp.trans fun ξ hξ i => ?_
  have := hξ i
  rw [div_div, show (4 : ℝ) / (liftL n d Ω p s * 2) = 2 / liftL n d Ω p s by field_simp; ring]
  exact this

/-! ### Properties of the scaled cutoffs -/

lemma liftChi_nonneg (s : ℕ) (ξ : EuclideanSpace ℝ (Fin n)) : 0 ≤ liftChi n d Ω p s ξ :=
  liftCutoff_nonneg _

lemma liftChi_le_one (s : ℕ) (ξ : EuclideanSpace ℝ (Fin n)) : liftChi n d Ω p s ξ ≤ 1 :=
  liftCutoff_le_one _

lemma liftChiT_nonneg (s : ℕ) (ξ : EuclideanSpace ℝ (Fin n)) : 0 ≤ liftChiT n d Ω p s ξ :=
  companionCutoff_nonneg _

lemma liftChiT_le_one (s : ℕ) (ξ : EuclideanSpace ℝ (Fin n)) : liftChiT n d Ω p s ξ ≤ 1 :=
  companionCutoff_le_one _

/-- `supp χ_s ⊆ [-1/L_s, 1/L_s]ⁿ`. -/
lemma support_liftChi (s : ℕ) :
    Function.support (liftChi n d Ω p s) ⊆
      {ξ | ∀ i, |ξ i| ≤ 1 / (liftL n d Ω p s : ℝ)} := fun ξ hξ i => by
  have hL := liftL_pos (n := n) (d := d) (Ω := Ω) (p := p) s
  have := support_liftCutoff hξ i
  rw [PiLp.smul_apply, smul_eq_mul, abs_mul, abs_of_pos hL] at this
  rw [le_div_iff₀ hL]; linarith

/-- `supp χ̃_s ⊆ [-2/L_s, 2/L_s]ⁿ`. -/
lemma support_liftChiT (s : ℕ) :
    Function.support (liftChiT n d Ω p s) ⊆
      {ξ | ∀ i, |ξ i| ≤ 2 / (liftL n d Ω p s : ℝ)} := fun ξ hξ i => by
  have hL := liftL_pos (n := n) (d := d) (Ω := Ω) (p := p) s
  have := support_companionCutoff hξ i
  rw [PiLp.smul_apply, smul_eq_mul, abs_mul, abs_of_pos hL] at this
  rw [le_div_iff₀ hL]; linarith

/-- `χ_s χ̃_s = χ_s`. -/
lemma liftChi_mul_liftChiT (s : ℕ) (ξ : EuclideanSpace ℝ (Fin n)) :
    liftChi n d Ω p s ξ * liftChiT n d Ω p s ξ = liftChi n d Ω p s ξ :=
  liftCutoff_mul_companionCutoff _

/-- Consequence of eq. (9.2) (`eq:scalerequirements`) (§9 setup, "all bumps centered at
`𝒰_{N_s}` used below are disjoint"): for `s ≥ 1` and any symbol `m`, at most one center
`γ ∈ 𝒰_{N_s}` has `(m χ̃_s)_per(ξ - γ) ≠ 0`. -/
theorem liftBump_center_atMostOne {s : ℕ} (hs : 1 ≤ s) (m : EuclideanSpace ℝ (Fin n) → ℂ)
    {γ γ' : Fin n → ZMod (blockProd (goodBlocks (paramRho n d Ω p) (liftN s)))}
    (hγ : γ ∈ paramGoodSet n d Ω p (liftN s)) (hγ' : γ' ∈ paramGoodSet n d Ω p (liftN s))
    (ξ : EuclideanSpace ℝ (Fin n))
    (h : periodize (fun η => m η * (liftChiT n d Ω p s η : ℂ))
      (ξ - ratPt (blockProd (goodBlocks (paramRho n d Ω p) (liftN s))) γ) ≠ 0)
    (h' : periodize (fun η => m η * (liftChiT n d Ω p s η : ℂ))
      (ξ - ratPt (blockProd (goodBlocks (paramRho n d Ω p) (liftN s))) γ') ≠ 0) :
    γ = γ' := by
  have hL := liftL_pos (n := n) (d := d) (Ω := Ω) (p := p) s
  refine periodize_center_atMostOne (ε := 4 / (liftL n d Ω p s : ℝ)) ?_ goodBlocks_one_lt
    goodBlocks_pairwise_coprime (by positivity) (liftEps_threshold hs) hγ hγ' ξ h h'
  intro η hη i
  have hχ : liftChiT n d Ω p s η ≠ 0 := by
    intro h0; apply hη; rw [h0, Complex.ofReal_zero, mul_zero]
  have := support_liftChiT s hχ i
  refine this.trans ?_
  rw [div_le_iff₀ hL, mul_assoc, div_mul_cancel₀ _ hL.ne']
  norm_num

/-! ### The rational frequencies `𝓡_s`, Gauss sums and the lifted symbols -/

/-- `𝓡_s = {a/q : (a,q) = 1, 0 ≤ a < q, N_s/2 ≤ q < N_s}` of the §9 setup, as the finite set of
pairs `(a, q)` (the condition `N_s/2 ≤ q` is written `N_s ≤ 2q`). -/
def liftRat (s : ℕ) : Finset (ℕ × ℕ) :=
  ((range (liftN s)) ×ˢ (range (liftN s))).filter fun aq =>
    liftN s ≤ 2 * aq.2 ∧ aq.1 < aq.2 ∧ Nat.Coprime aq.1 aq.2

lemma mem_liftRat {s a q : ℕ} :
    (a, q) ∈ liftRat s ↔ liftN s ≤ 2 * q ∧ q < liftN s ∧ a < q ∧ Nat.Coprime a q := by
  simp only [liftRat, mem_filter, mem_product, Finset.mem_range]
  constructor
  · rintro ⟨⟨_, h2⟩, h3, h4, h5⟩; exact ⟨h3, h2, h4, h5⟩
  · rintro ⟨h3, h2, h4, h5⟩; exact ⟨⟨by omega, h2⟩, h3, h4, h5⟩

/-- The §9 setup: `𝓡_s` has at most `N_s²` elements. -/
theorem card_liftRat_le (s : ℕ) : (liftRat s).card ≤ liftN s ^ 2 := by
  refine (card_filter_le _ _).trans ?_
  rw [card_product, card_range, sq]

lemma one_le_of_mem_liftRat {s a q : ℕ} (h : (a, q) ∈ liftRat s) : 1 ≤ q := by
  have := (mem_liftRat.1 h).2.2.1; omega

/-- The integer vector `(zᵢ)ᵢ ∈ ℤⁿ` of a residue vector `z ∈ {0, …, q-1}ⁿ`. -/
def finIntVec {q : ℕ} (z : Fin n → Fin q) : Fin n → ℤ := fun i => ((z i : ℕ) : ℤ)

/-- The Gauss sum `S(α, β) = q^{-n} ∑_{z mod q} e(α P(z) - z · β)`, `α = a/q`, `β = b/q`, of
eq. (`eq:Gaussdef`), in the Mathlib sign convention (the blueprint's `+β · z` becomes `-z · β`),
so that `∑_β S(α, β) e(β · y) = e(α P(y))` (`sum_gaussSum_mul_eC`). -/
noncomputable def gaussSum (n d a q : ℕ) (b : Fin n → Fin q) : ℂ :=
  ((q : ℂ) ^ n)⁻¹ * ∑ z : Fin n → Fin q,
    eC ((a : ℝ) / q * (radialPolyZ n d (finIntVec z) : ℝ) -
      inner ℝ (latEmbed (finIntVec z)) (gridPt q b))

/-- The lifted symbol `Lift_{s,α}[m](ξ) = ∑_{β ∈ T[q]} S(α, β) (m χ_s)_per(ξ - β)`, `α = a/q`,
of eq. (`eq:Liftdef`). -/
noncomputable def liftSym (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s a q : ℕ)
    (m : EuclideanSpace ℝ (Fin n) → ℂ) (ξ : EuclideanSpace ℝ (Fin n)) : ℂ :=
  ∑ b : Fin n → Fin q, gaussSum n d a q b *
    periodize (fun η => m η * (liftChi n d Ω p s η : ℂ)) (ξ - gridPt q b)

/-- `A_{s,α} = Lift_{s,α}[1]` of the §9 setup, `α = a/q`. -/
noncomputable def liftA (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s a q : ℕ) :
    EuclideanSpace ℝ (Fin n) → ℂ :=
  liftSym n d Ω p s a q fun _ => 1

/-- `D_s[m](ξ) = ∑_{β ∈ 𝒰_{N_s}} (m χ̃_s)_per(ξ - β)` of the §9 setup. -/
noncomputable def liftD (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ)
    (m : EuclideanSpace ℝ (Fin n) → ℂ) : EuclideanSpace ℝ (Fin n) → ℂ :=
  cosetSymbol (blockProd (goodBlocks (paramRho n d Ω p) (liftN s)))
    (fun η => m η * (liftChiT n d Ω p s η : ℂ)) (paramGoodSet n d Ω p (liftN s))

/-- `φ_s = 𝓕⁻ χ_s` of Blueprint Lemma 9.1 (`lem:liftkernel`). -/
noncomputable def liftPhi (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ) :
    EuclideanSpace ℝ (Fin n) → ℂ :=
  𝓕⁻ fun ξ => (liftChi n d Ω p s ξ : ℂ)

/-! ### Blueprint Lemma 9.1 (`lem:liftkernel`) -/

/-- The residue vector `y mod q ∈ {0, …, q-1}ⁿ`. -/
def resVec {q : ℕ} (hq : 1 ≤ q) (y : Fin n → ℤ) : Fin n → Fin q := fun i =>
  ⟨(y i % q).toNat, by
    have h0 : (0 : ℤ) < q := by exact_mod_cast hq
    have h1 := Int.emod_nonneg (y i) h0.ne'
    have h2 := Int.emod_lt_of_pos (y i) h0
    omega⟩

lemma finIntVec_resVec {q : ℕ} (hq : 1 ≤ q) (y : Fin n → ℤ) (i : Fin n) :
    finIntVec (resVec hq y) i = y i % q := by
  have h0 : (0 : ℤ) < q := by exact_mod_cast hq
  have h1 := Int.emod_nonneg (y i) h0.ne'
  simp only [finIntVec, resVec]
  omega

/-- `q ∣ yᵢ - zᵢ` for all `i` iff `z = y mod q`. -/
lemma dvd_sub_finIntVec_iff {q : ℕ} (hq : 1 ≤ q) (y : Fin n → ℤ) (z : Fin n → Fin q) :
    (∀ i, (q : ℤ) ∣ (y - finIntVec z) i) ↔ z = resVec hq y := by
  have h0 : (0 : ℤ) < q := by exact_mod_cast hq
  constructor
  · intro h
    funext i
    have hi : finIntVec z i ≡ y i [ZMOD q] := (Int.modEq_iff_dvd.2 (h i))
    have hz0 : 0 ≤ finIntVec z i := by simp [finIntVec]
    have hzq : finIntVec z i < q := by simp only [finIntVec]; exact_mod_cast (z i).2
    have he : finIntVec z i % q = finIntVec z i := Int.emod_eq_of_lt hz0 hzq
    have h2 : finIntVec z i = y i % q := by rw [← he]; exact hi
    have h3 := finIntVec_resVec hq y i
    apply Fin.ext
    have : ((z i : ℕ) : ℤ) = ((resVec hq y i : ℕ) : ℤ) := by
      change finIntVec z i = finIntVec (resVec hq y) i
      rw [h2, h3]
    exact_mod_cast this
  · rintro rfl i
    rw [Pi.sub_apply, finIntVec_resVec, Int.emod_def]
    exact ⟨y i / q, by ring⟩

/-- The finite Gauss-sum identity in the proof of Blueprint Lemma 9.1 (`lem:liftkernel`):
for `q ≥ 1` and `y ∈ ℤⁿ`, `∑_{β ∈ T[q]} S(a/q, β) e(β · y) = e((a/q) P(y))`
(geometric sums and `P(z) ≡ P(y) mod q` for `z ≡ y mod q`). -/
theorem sum_gaussSum_mul_eC (d a : ℕ) {q : ℕ} (hq : 1 ≤ q) (y : Fin n → ℤ) :
    ∑ b : Fin n → Fin q, gaussSum n d a q b * eC (inner ℝ (gridPt q b) (latEmbed y)) =
      eC ((a : ℝ) / q * (radialPolyZ n d y : ℝ)) := by
  set A : (Fin n → ℤ) → ℝ := fun w => (a : ℝ) / q * (radialPolyZ n d w : ℝ)
  have hq0 : (q : ℂ) ≠ 0 := by exact_mod_cast (show q ≠ 0 by omega)
  have hterm : ∀ (b z : Fin n → Fin q),
      eC (A (finIntVec z) - inner ℝ (latEmbed (finIntVec z)) (gridPt q b)) *
        eC (inner ℝ (gridPt q b) (latEmbed y)) =
      eC (A (finIntVec z)) * eC (inner ℝ (gridPt q b) (latEmbed (y - finIntVec z))) := by
    intro b z
    rw [← eC_add, ← eC_add, latEmbed_sub, inner_sub_right, real_inner_comm (gridPt q b)]
    congr 1; ring
  calc ∑ b : Fin n → Fin q, gaussSum n d a q b * eC (inner ℝ (gridPt q b) (latEmbed y))
      = ((q : ℂ) ^ n)⁻¹ * ∑ z : Fin n → Fin q, eC (A (finIntVec z)) *
          ∑ b : Fin n → Fin q, eC (inner ℝ (gridPt q b) (latEmbed (y - finIntVec z))) := by
        simp only [gaussSum, mul_assoc, ← Finset.mul_sum]
        congr 1
        simp only [Finset.sum_mul, Finset.mul_sum]
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl fun z _ => Finset.sum_congr rfl fun b _ => ?_
        exact hterm b z
    _ = ((q : ℂ) ^ n)⁻¹ * ∑ z : Fin n → Fin q,
          if z = resVec hq y then eC (A (finIntVec z)) * (q : ℂ) ^ n else 0 := by
        congr 1
        refine Finset.sum_congr rfl fun z _ => ?_
        rw [sum_eC_gridPt q hq]
        by_cases hz : z = resVec hq y
        · rw [ite_eq_left ((dvd_sub_finIntVec_iff hq y z).2 hz), ite_eq_left hz]
        · rw [ite_eq_right (fun h => hz ((dvd_sub_finIntVec_iff hq y z).1 h)), ite_eq_right hz, mul_zero]
    _ = eC (A (finIntVec (resVec hq y))) := by
        rw [Finset.sum_ite_eq' Finset.univ, ite_eq_left (Finset.mem_univ _), mul_comm,
          mul_assoc, mul_inv_cancel₀ (pow_ne_zero _ hq0), mul_one]
    _ = eC (A y) := by
        have hmod : radialPolyZ n d (finIntVec (resVec hq y)) ≡ radialPolyZ n d y [ZMOD q] :=
          radialPolyZ_modEq n d q fun i => by rw [finIntVec_resVec]; exact Int.mod_modEq _ _
        obtain ⟨k, hk⟩ := (Int.modEq_iff_dvd.1 hmod)
        have hqR : (q : ℝ) ≠ 0 := by exact_mod_cast (show q ≠ 0 by omega)
        have hA : A y = A (finIntVec (resVec hq y)) + ((a * k : ℤ) : ℝ) := by
          simp only [A]
          have hk' : (radialPolyZ n d y : ℝ) =
              (radialPolyZ n d (finIntVec (resVec hq y)) : ℝ) + q * k := by
            have := congrArg (fun t : ℤ => (t : ℝ)) hk
            push_cast at this; linarith
          rw [hk']; push_cast; field_simp
        rw [hA, eC_add, eC_intCast, mul_one]

/-- The lifted symbol is integrable on the torus when `m χ_s` is integrable. -/
lemma integrableOn_liftSym {s a q : ℕ} {m : EuclideanSpace ℝ (Fin n) → ℂ}
    (hm : Integrable fun ξ => m ξ * (liftChi n d Ω p s ξ : ℂ)) :
    IntegrableOn (liftSym n d Ω p s a q m) (torusCube n) := by
  rw [show liftSym n d Ω p s a q m = fun ξ => ∑ b : Fin n → Fin q, gaussSum n d a q b *
    periodize (fun η => m η * (liftChi n d Ω p s η : ℂ)) (ξ - gridPt q b) from rfl]
  refine integrable_finsetSum _ fun b _ => ?_
  simp_rw [periodize_comp_sub]
  exact (integrableOn_periodize (hm.comp_sub_right _)).const_mul _

/-- Blueprint Lemma 9.1 (`lem:liftkernel`), eq. (`eq:liftkernel`): for `q ≥ 1`, `α = a/q` and a
symbol `m` with `m χ_s` integrable (e.g. `m` bounded measurable on `supp χ_s`,
`latKernel_liftSym_of_bdd`), the kernel of `Lift_{s,α}[m]` is
`(Lift_{s,α}[m])ˇ(y) = e(α P(y)) (m χ_s)ˇ(y)` for every `y ∈ G` (including `y = 0`). -/
theorem latKernel_liftSym (s a : ℕ) {q : ℕ} (hq : 1 ≤ q) {m : EuclideanSpace ℝ (Fin n) → ℂ}
    (hm : Integrable fun ξ => m ξ * (liftChi n d Ω p s ξ : ℂ)) (y : Fin n → ℤ) :
    latKernel (liftSym n d Ω p s a q m) y =
      eC ((a : ℝ) / q * (radialPolyZ n d y : ℝ)) *
        𝓕⁻ (fun ξ => m ξ * (liftChi n d Ω p s ξ : ℂ)) (latEmbed y) := by
  rw [← sum_gaussSum_mul_eC d a hq y, Finset.sum_mul, latKernel]
  simp only [liftSym, Finset.sum_mul]
  rw [integral_finsetSum _ fun b _ => ?_]
  · refine Finset.sum_congr rfl fun b _ => ?_
    simp_rw [mul_assoc]
    rw [integral_const_mul]
    simp_rw [periodize_comp_sub]
    rw [← latKernel, latKernel_periodize (hm.comp_sub_right _),
      fourierInv_comp_sub (fun η => m η * (liftChi n d Ω p s η : ℂ))]
  · simp_rw [mul_assoc, periodize_comp_sub]
    exact (integrableOn_periodize_mul_eC (hm.comp_sub_right _) y).const_mul _

/-- `χ_s` (as a complex function) is integrable. -/
lemma integrable_liftChi (s : ℕ) :
    Integrable fun ξ : EuclideanSpace ℝ (Fin n) => (liftChi n d Ω p s ξ : ℂ) :=
  (liftCutoffSchwartz n).integrable.comp_smul (liftL_pos s).ne'

/-- `m χ_s` is integrable for `m` a.e.-strongly measurable and bounded on `supp χ_s`. -/
lemma integrable_mul_liftChi {s : ℕ} {m : EuclideanSpace ℝ (Fin n) → ℂ}
    (hm : AEStronglyMeasurable m volume) {B : ℝ}
    (hB : ∀ ξ, liftChi n d Ω p s ξ ≠ 0 → ‖m ξ‖ ≤ B) :
    Integrable fun ξ => m ξ * (liftChi n d Ω p s ξ : ℂ) := by
  have hχ := integrable_liftChi (n := n) (d := d) (Ω := Ω) (p := p) s
  refine Integrable.mono' (hχ.norm.const_mul B) (hm.mul hχ.aestronglyMeasurable)
    (Filter.Eventually.of_forall fun ξ => ?_)
  rw [norm_mul]
  by_cases h : liftChi n d Ω p s ξ = 0
  · simp [h]
  · exact mul_le_mul_of_nonneg_right (hB ξ h) (norm_nonneg _)

/-- Blueprint Lemma 9.1 (`lem:liftkernel`), eq. (`eq:liftkernel`), for bounded measurable `m`
on the support of `χ_s`: for `q ≥ 1`, `α = a/q`, and every `y ∈ G`,
`(Lift_{s,α}[m])ˇ(y) = e(α P(y)) (m χ_s)ˇ(y)`. -/
theorem latKernel_liftSym_of_bdd (s a : ℕ) {q : ℕ} (hq : 1 ≤ q)
    {m : EuclideanSpace ℝ (Fin n) → ℂ} (hm : AEStronglyMeasurable m volume) {B : ℝ}
    (hB : ∀ ξ, liftChi n d Ω p s ξ ≠ 0 → ‖m ξ‖ ≤ B) (y : Fin n → ℤ) :
    latKernel (liftSym n d Ω p s a q m) y =
      eC ((a : ℝ) / q * (radialPolyZ n d y : ℝ)) *
        𝓕⁻ (fun ξ => m ξ * (liftChi n d Ω p s ξ : ℂ)) (latEmbed y) :=
  latKernel_liftSym s a hq (integrable_mul_liftChi hm hB) y

/-- Blueprint Lemma 9.1 (`lem:liftkernel`), "in particular": for `q ≥ 1`, `α = a/q`, the kernel of
`A_{s,α}` is `e(α P(y)) φ_s(y)`, `φ_s = 𝓕⁻ χ_s`, for every `y ∈ G`. -/
theorem latKernel_liftA (s a : ℕ) {q : ℕ} (hq : 1 ≤ q) (y : Fin n → ℤ) :
    latKernel (liftA n d Ω p s a q) y =
      eC ((a : ℝ) / q * (radialPolyZ n d y : ℝ)) * liftPhi n d Ω p s (latEmbed y) := by
  have h := latKernel_liftSym (n := n) (d := d) (Ω := Ω) (p := p) s a hq (m := fun _ => 1)
    (by simpa using integrable_liftChi (n := n) (d := d) (Ω := Ω) (p := p) s) y
  simpa [liftA, liftPhi] using h

/-- Scaling of the envelope bound: there is `C ≥ 0` (depending only on `n`) such that for every
`L > 0`, `|𝓕⁻(χ(L ·))(x)| ≤ C B_L(x)` for all `x ∈ E`. -/
lemma exists_norm_fourierInv_liftCutoff_smul_le (n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ L : ℝ, 0 < L → ∀ x : EuclideanSpace ℝ (Fin n),
      ‖𝓕⁻ (fun ξ => (liftCutoff n (L • ξ) : ℂ)) x‖ ≤ C * envelope n L x := by
  obtain ⟨K, hK, hKb⟩ := exists_norm_le_envelope (𝓕⁻ (liftCutoffSchwartz n))
  refine ⟨K, hK, fun L hL x => ?_⟩
  have hL' : 0 < L⁻¹ := inv_pos.2 hL
  have hfun : (fun ξ : EuclideanSpace ℝ (Fin n) => (liftCutoff n (L • ξ) : ℂ)) =
      fun ξ => liftCutoffSchwartz n ((L⁻¹)⁻¹ • ξ) := by
    funext ξ; rw [inv_inv, liftCutoffSchwartz_apply]
  rw [hfun, fourierInv_comp_inv_smul _ hL', ← SchwartzMap.fourierInv_coe, norm_mul,
    Complex.norm_real, Real.norm_of_nonneg (by positivity)]
  have hb := hKb (L⁻¹ • x)
  have he : envelope n 1 (L⁻¹ • x) = ((1 + ‖x‖ / L) ^ (n + 1))⁻¹ := by
    rw [envelope, norm_smul, Real.norm_of_nonneg hL'.le]
    simp [div_eq_inv_mul]
  rw [he] at hb
  calc (L⁻¹) ^ n * ‖(𝓕⁻ (liftCutoffSchwartz n)) (L⁻¹ • x)‖
      ≤ (L⁻¹) ^ n * (K * ((1 + ‖x‖ / L) ^ (n + 1))⁻¹) :=
        mul_le_mul_of_nonneg_left hb (by positivity)
    _ = K * envelope n L x := by rw [envelope, inv_pow]; ring

/-- Blueprint Lemma 9.1 (`lem:liftkernel`), envelope bound: there is `C ≥ 0` (depending only on
`n`, independent of `s` and of `d, Ω, p`) such that `|φ_s(y)| ≤ C B_{L_s}(y)` for every `s` and
every `y ∈ G`, where `φ_s = 𝓕⁻ χ_s` and `B_R` is the envelope of Lemma 2.4 (`lem:maximal`);
the same bound holds at every point of `E`. -/
theorem norm_liftPhi_le (n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ),
      (∀ x : EuclideanSpace ℝ (Fin n),
        ‖liftPhi n d Ω p s x‖ ≤ C * envelope n (liftL n d Ω p s) x) ∧
      ∀ y : Fin n → ℤ,
        ‖liftPhi n d Ω p s (latEmbed y)‖ ≤ C * latEnvelope n (liftL n d Ω p s) y := by
  obtain ⟨C, hC, h⟩ := exists_norm_fourierInv_liftCutoff_smul_le n
  exact ⟨C, hC, fun d Ω p s =>
    ⟨fun x => h _ (liftL_pos s) x, fun y => h _ (liftL_pos s) (latEmbed y)⟩⟩

/-! ### Blueprint Lemma 9.2 (`lem:arithmax`): arithmetic maximal decay

Proof structure (following the blueprint):
* the complete phase sums `arithG` (`G_Q`, `Q = q r`) and their bounds in both degree cases:
  `norm_arithG_one_le` (`D = 2`, Lemma 3.6), `norm_arithG_slice_le` (`D ≥ 4`, Lemma 3.1 and
  Corollary 3.5), the exceptional densities `card_exc_quad_le`, `card_exc_slice_le` (Lemma 3.2),
  combined in `exists_arithG_bound`;
* the lattice sum of `B_L` over the exceptional set by dyadic shells
  (`arith_tsum_latEnvelope_indicator_le`);
* the `TT*` kernel of a linearization (`integral_arithKer_mul_conj`, via Lemma 9.1) and its bound
  `|H| ≤ C (|G_Q| + Q/L) B_L(h)` (`norm_arithTT_le`, Lemma 3.7);
* Schur and `TT*` (`arith_linearized_bound`, via `band_eLpNorm_kernel_le_of_ttstar`), then
  linearization of the maximal function: eq. (9.5), `arith_maximal_decay`;
* eq. (9.6), `arith_maximal_decay_vector`: the `ℓ²` case by squaring and summing (9.5), the
  endpoints by the domination `(∑_ν sup_α |A f_ν|²)^{1/2} ≤ |φ_s| * (∑_ν |f_ν|²)^{1/2}`
  (Minkowski) and Young, and Marcinkiewicz interpolation for `ℓ²_ν`-valued inputs
  (`arithVec_lp_of_l2`).

Deviations: the period is `Q = q_x q_y` (instead of `lcm(q_x, q_y)`; still `N/2 ≤ Q ≤ N²`); for
`D ≥ 4` the exceptional set is `{h : gcd(D b_y h₁, q_y) > N^{1/2}}` (equal to the blueprint's set
since `(b_y, q_y) = 1`); both exceptional sets have density `≤ C N^{-3/8}` in every interval
`[-R, R]`, `R ≥ N`; the error term uses `Q/L ≤ N²/L ≤ N^{-1}` (from `L_s ≥ N_s³`). -/

section ArithMax

open Polynomial
open scoped ComplexConjugate ENNReal NNReal


/-- The phase `α P(v) - β P(v + h)` of the `TT*` kernel in the proof of Blueprint Lemma 9.2. -/
noncomputable def arithPhase (n d : ℕ) (α β : ℝ) (h v : Fin n → ℤ) : ℝ :=
  α * (radialPolyZ n d v : ℝ) - β * (radialPolyZ n d (v + h) : ℝ)

/-- `X ≡ Y (mod q)` gives `(a/q) Y = (a/q) X + k` with `k ∈ ℤ`. -/
lemma exists_div_mul_eq_add_int (a : ℤ) {q : ℕ} (hq : 1 ≤ q) {X Y : ℤ} (h : X ≡ Y [ZMOD q]) :
    ∃ k : ℤ, (a : ℝ) / q * Y = (a : ℝ) / q * X + k := by
  obtain ⟨k, hk⟩ := (Int.modEq_iff_dvd.1 h)
  have hqR : (q : ℝ) ≠ 0 := by have : (0 : ℝ) < q := by exact_mod_cast hq
                               exact this.ne'
  refine ⟨a * k, ?_⟩
  have hk' : (Y : ℝ) = X + q * k := by
    have := congrArg (fun t : ℤ => (t : ℝ)) hk; push_cast at this; linarith
  rw [hk']; push_cast; field_simp

/-- The phase is periodic modulo `Q = q r` (for `α = a/q`, `β = b/r`). -/
lemma eC_arithPhase_periodic (d : ℕ) (a b : ℤ) {q r : ℕ} (hq : 1 ≤ q) (hr : 1 ≤ r)
    (h : Fin n → ℤ) {v v' : Fin n → ℤ} (hv : ∀ i, v i ≡ v' i [ZMOD (q * r : ℕ)]) :
    eC (arithPhase n d ((a : ℝ) / q) ((b : ℝ) / r) h v) =
      eC (arithPhase n d ((a : ℝ) / q) ((b : ℝ) / r) h v') := by
  have h1 : radialPolyZ n d v ≡ radialPolyZ n d v' [ZMOD q] :=
    radialPolyZ_modEq n d q fun i =>
      Int.ModEq.of_mul_right (r : ℤ) (by have := hv i; push_cast at this; exact this)
  have h2 : radialPolyZ n d (v + h) ≡ radialPolyZ n d (v' + h) [ZMOD r] :=
    radialPolyZ_modEq n d r fun i => by
      simp only [Pi.add_apply]
      exact (Int.ModEq.of_mul_left (q : ℤ) (by have := hv i; push_cast at this; exact this)).add_right _
  obtain ⟨k₁, hk₁⟩ := exists_div_mul_eq_add_int a hq h1
  obtain ⟨k₂, hk₂⟩ := exists_div_mul_eq_add_int b hr h2
  have : arithPhase n d ((a : ℝ) / q) ((b : ℝ) / r) h v' =
      arithPhase n d ((a : ℝ) / q) ((b : ℝ) / r) h v + ((k₁ - k₂ : ℤ) : ℝ) := by
    unfold arithPhase; rw [hk₁, hk₂]; push_cast; ring
  rw [this, eC_add, eC_intCast, mul_one]

/-- The normalized complete phase sum
`G = Q^{-n} ∑_{u ∈ [0, Q)ⁿ} e((a/q) P(u) - (b/r) P(u + h))`, `Q = q r`. -/
noncomputable def arithG (n d a q b r : ℕ) (h : Fin n → ℤ) : ℂ :=
  (((q * r : ℕ) : ℂ) ^ n)⁻¹ * ∑ u : Fin n → Fin (q * r),
    eC (arithPhase n d ((a : ℝ) / q) ((b : ℝ) / r) h (finIntVec u))

/-- The trivial bound `|G| ≤ 1`. -/
lemma norm_arithG_le_one (d a b : ℕ) {q r : ℕ} (hq : 1 ≤ q) (hr : 1 ≤ r) (h : Fin n → ℤ) :
    ‖arithG n d a q b r h‖ ≤ 1 := by
  have hQ : (0 : ℝ) < ((q * r : ℕ) : ℝ) := by exact_mod_cast Nat.mul_pos hq hr
  unfold arithG
  rw [norm_mul, norm_inv, norm_pow, Complex.norm_natCast]
  refine (mul_le_mul_of_nonneg_left (norm_sum_le _ _) (by positivity)).trans ?_
  simp only [norm_eC, sum_const, card_univ, Fintype.card_pi, Fintype.card_fin, prod_const,
    nsmul_eq_mul, mul_one]
  push_cast
  rw [inv_mul_cancel₀ (by positivity)]

/-- `e` of a finite sum is the product of the `e`'s. -/
lemma arith_eC_finsetSum {ι : Type*} (s : Finset ι) (f : ι → ℝ) :
    eC (∑ i ∈ s, f i) = ∏ i ∈ s, eC (f i) := by
  unfold eC; push_cast; rw [Finset.mul_sum, Complex.exp_sum]

lemma arithPhase_one (α β : ℝ) (h v : Fin n → ℤ) :
    arithPhase n 1 α β h v = ∑ i, (α * (v i : ℝ) ^ 2 - β * ((v i : ℝ) + h i) ^ 2) := by
  simp [arithPhase, radialPolyZ, Finset.mul_sum, Finset.sum_sub_distrib]

/-- For `D = 2` the complete sum factors over the coordinates. -/
lemma arithG_one_eq_prod (a q b r : ℕ) (h : Fin n → ℤ) :
    arithG n 1 a q b r h = ∏ i, (((q * r : ℕ) : ℂ))⁻¹ * ∑ t : Fin (q * r),
      eC ((a : ℝ) / q * ((t : ℕ) : ℝ) ^ 2 - (b : ℝ) / r * (((t : ℕ) : ℝ) + h i) ^ 2) := by
  unfold arithG
  simp_rw [arithPhase_one, arith_eC_finsetSum]
  rw [Finset.prod_mul_distrib, prod_const, card_univ, Fintype.card_fin, inv_pow]
  congr 1
  rw [Finset.prod_univ_sum, Fintype.piFinset_univ]
  simp [finIntVec]

/-- The one-dimensional quadratic factor in the form of Lemma 3.6. -/
lemma arith_quad_factor_eq (a q b r : ℕ) (hq : 1 ≤ q) (hr : 1 ≤ r) (h0 : ℤ) :
    (((q * r : ℕ) : ℂ))⁻¹ * ∑ t : Fin (q * r),
      eC ((a : ℝ) / q * ((t : ℕ) : ℝ) ^ 2 - (b : ℝ) / r * (((t : ℕ) : ℝ) + h0) ^ 2) =
    eC (-((b : ℝ) / r * (h0 : ℝ) ^ 2)) * ((((q * r : ℕ) : ℂ))⁻¹ * ∑ z ∈ range (q * r),
      eC ((((a * r - b * q : ℤ) : ℝ) * (z : ℝ) ^ 2 + ((-2 * b * h0 * q : ℤ) : ℝ) * z) /
        ((q * r : ℕ) : ℝ))) := by
  have hsum : ∑ t : Fin (q * r),
      eC ((a : ℝ) / q * ((t : ℕ) : ℝ) ^ 2 - (b : ℝ) / r * (((t : ℕ) : ℝ) + h0) ^ 2) =
      eC (-((b : ℝ) / r * (h0 : ℝ) ^ 2)) * ∑ z ∈ range (q * r),
      eC ((((a * r - b * q : ℤ) : ℝ) * (z : ℝ) ^ 2 + ((-2 * b * h0 * q : ℤ) : ℝ) * z) /
        ((q * r : ℕ) : ℝ)) := by
    rw [Fin.sum_univ_eq_sum_range (fun t : ℕ =>
      eC ((a : ℝ) / q * (t : ℝ) ^ 2 - (b : ℝ) / r * ((t : ℝ) + h0) ^ 2)) (q * r), Finset.mul_sum]
    refine sum_congr rfl fun z _ => ?_
    rw [← eC_add]
    congr 1
    have hq0 : (q : ℝ) ≠ 0 := by have : (0 : ℝ) < q := by exact_mod_cast hq
                                 exact this.ne'
    have hr0 : (r : ℝ) ≠ 0 := by have : (0 : ℝ) < r := by exact_mod_cast hr
                                 exact this.ne'
    push_cast
    field_simp
    ring
  rw [hsum]; ring

/-- `√(2/v) ≤ √2 N^{-1/8}` for `v ≥ N^{1/4}`. -/
lemma arith_sqrt_two_div_le {N v : ℝ} (hN : 0 < N) (hv : N ^ (1 / 4 : ℝ) ≤ v) :
    Real.sqrt (2 / v) ≤ Real.sqrt 2 * N ^ (-(1 / 8 : ℝ)) := by
  have h4 : 0 < N ^ (1 / 4 : ℝ) := Real.rpow_pos_of_pos hN _
  have hv0 : 0 < v := h4.trans_le hv
  have e : N ^ (-(1 / 8 : ℝ)) = Real.sqrt ((N ^ (1 / 4 : ℝ))⁻¹) := by
    rw [Real.sqrt_eq_rpow, ← Real.rpow_neg hN.le, ← Real.rpow_mul hN.le]; norm_num
  rw [e, ← Real.sqrt_mul (by norm_num)]
  refine Real.sqrt_le_sqrt ?_
  rw [div_eq_mul_inv]
  gcongr

open scoped Classical in
/-- Blueprint Lemma 9.2, the case `D = 2`: with `v` the reduced denominator of `a/q - b/r`,
`|G| ≤ √2 N^{-1/8}` unless `r ∣ 2 v h₁` for some `1 ≤ v ≤ N^{1/4}`. -/
lemma norm_arithG_one_le {m : ℕ} (a q b r N : ℕ) (hq : 1 ≤ q) (hr : 1 ≤ r) (hN : 1 ≤ N)
    (hbr : Nat.Coprime b r) (h : Fin (m + 1) → ℤ) :
    ‖arithG (m + 1) 1 a q b r h‖ ≤ Real.sqrt 2 * (N : ℝ) ^ (-(1 / 8 : ℝ)) +
      if (∃ v : ℕ, 1 ≤ v ∧ (v : ℝ) ≤ (N : ℝ) ^ (1 / 4 : ℝ) ∧ (r : ℤ) ∣ 2 * v * h 0)
        then 1 else 0 := by
  classical
  have hQ : 1 ≤ q * r := Nat.mul_pos hq hr
  have hN0 : (0 : ℝ) < N := by exact_mod_cast hN
  have hs0 : 0 ≤ Real.sqrt 2 * (N : ℝ) ^ (-(1 / 8 : ℝ)) := by positivity
  set A : ℤ := a * r - b * q
  set B : ℤ := -2 * b * h 0 * q
  set Gq : ℂ := (((q * r : ℕ) : ℂ))⁻¹ * ∑ z ∈ range (q * r),
      eC ((A * (z : ℝ) ^ 2 + B * z) / ((q * r : ℕ) : ℝ)) with hGq
  have hfac : ∀ i, ‖(((q * r : ℕ) : ℂ))⁻¹ * ∑ t : Fin (q * r),
      eC ((a : ℝ) / q * ((t : ℕ) : ℝ) ^ 2 - (b : ℝ) / r * (((t : ℕ) : ℝ) + h i) ^ 2)‖ ≤ 1 := by
    intro i
    rw [norm_mul, norm_inv, Complex.norm_natCast]
    refine (mul_le_mul_of_nonneg_left (norm_sum_le _ _) (by positivity)).trans ?_
    simp only [norm_eC, sum_const, card_univ, Fintype.card_fin, nsmul_eq_mul, mul_one]
    push_cast
    rw [inv_mul_cancel₀ (by positivity)]
  have hmain : ‖arithG (m + 1) 1 a q b r h‖ ≤ ‖Gq‖ := by
    rw [arithG_one_eq_prod, Fin.prod_univ_succ, norm_mul, arith_quad_factor_eq a q b r hq hr, norm_mul,
      norm_eC, one_mul]
    refine mul_le_of_le_one_right (norm_nonneg _) ?_
    rw [norm_prod]
    exact Finset.prod_le_one₀ (fun _ _ => norm_nonneg _) fun i _ => hfac _
  have hG1 : ‖arithG (m + 1) 1 a q b r h‖ ≤ 1 := norm_arithG_le_one 1 a b hq hr h
  set v : ℕ := (q * r) / Int.gcd A (q * r : ℕ) with hv
  have hg0 : 0 < Int.gcd A (q * r : ℕ) :=
    Int.gcd_pos_of_ne_zero_right _ (by exact_mod_cast (show q * r ≠ 0 by omega))
  have hgQ : Int.gcd A (q * r : ℕ) ≤ q * r := by
    have := Int.gcd_dvd_right A ((q * r : ℕ) : ℤ)
    exact Nat.le_of_dvd hQ (by exact_mod_cast this)
  have hv1 : 1 ≤ v := Nat.div_pos hgQ hg0
  by_cases hvN : (N : ℝ) ^ (1 / 4 : ℝ) ≤ v
  · refine hmain.trans ((norm_quadratic_complete_sum_le A B hQ).trans ?_)
    refine (arith_sqrt_two_div_le hN0 hvN).trans ?_
    split_ifs <;> linarith
  · push Not at hvN
    by_cases hG : Gq = 0
    · refine hmain.trans ?_
      rw [hG, norm_zero]
      split_ifs <;> linarith
    · have hdvd := dvd_of_quadratic_complete_sum_ne_zero A B b (h 0) hQ (Dvd.intro_left q rfl)
        (by simpa [Int.gcd_natCast_natCast] using hbr)
        (by rw [Nat.mul_div_cancel _ (by omega)]) hG
      have hex : ∃ v : ℕ, 1 ≤ v ∧ (v : ℝ) ≤ (N : ℝ) ^ (1 / 4 : ℝ) ∧ (r : ℤ) ∣ 2 * v * h 0 :=
        ⟨v, hv1, hvN.le, hdvd⟩
      rw [ite_eq_left hex]
      linarith

/-- The phase `α P(v) - β P(v + h)`, `v = (t, s)`, as a polynomial in the first coordinate `t`
(Blueprint Lemma 3.1). -/
noncomputable def arithPoly {m : ℕ} (d : ℕ) (α β : ℝ) (h : Fin (m + 1) → ℤ) (s : Fin m → ℤ) :
    ℝ[X] :=
  C α * sliceRadialPoly (m + 1) d 0 (fun l => ((Fin.cons 0 s : Fin (m + 1) → ℤ) l : ℝ)) 0 -
    C β * sliceRadialPoly (m + 1) d 0 (fun l => ((Fin.cons 0 s : Fin (m + 1) → ℤ) l : ℝ))
      (fun l => (h l : ℝ))

lemma arithPoly_natDegree_le {m : ℕ} (d : ℕ) (α β : ℝ) (h : Fin (m + 1) → ℤ) (s : Fin m → ℤ) :
    (arithPoly d α β h s).natDegree ≤ 2 * d := by
  refine (natDegree_sub_le _ _).trans (max_le ?_ ?_) <;>
    exact (natDegree_C_mul_le _ _).trans (sliceRadialPoly_natDegree_le _ _ _ _ _)

lemma arithPoly_eval {m : ℕ} (d : ℕ) (α β : ℝ) (h : Fin (m + 1) → ℤ) (s : Fin m → ℤ) (t : ℤ) :
    ∑ k ∈ range (2 * d + 1), (arithPoly d α β h s).coeff k * (t : ℝ) ^ k =
      arithPhase (m + 1) d α β h (Fin.cons t s) := by
  rw [← eval_eq_sum_range' (Nat.lt_succ_of_le (arithPoly_natDegree_le d α β h s)),
    arithPoly, eval_sub, eval_mul, eval_mul, eval_C, eval_C, sliceRadialPoly_eval,
    sliceRadialPoly_eval]
  have hu : Function.update (fun l => ((Fin.cons 0 s : Fin (m + 1) → ℤ) l : ℝ)) 0 (t : ℝ) =
      fun l => ((Fin.cons t s : Fin (m + 1) → ℤ) l : ℝ) := by
    funext l
    refine Fin.cases ?_ (fun k => ?_) l
    · simp
    · rw [Function.update_of_ne (Fin.succ_ne_zero k)]; simp
  rw [hu]
  simp only [arithPhase, radialPolyZ, Pi.add_apply, Pi.zero_apply, add_zero]
  push_cast
  rfl

lemma arithPoly_coeff {m : ℕ} {d : ℕ} (hd : 1 ≤ d) (α β : ℝ) (h : Fin (m + 1) → ℤ)
    (s : Fin m → ℤ) : (arithPoly d α β h s).coeff (2 * d - 1) = -(2 * d * β * h 0) := by
  rw [arithPoly, coeff_sub, coeff_C_mul, coeff_C_mul, sliceRadialPoly_coeff_top_sub_one _ (by omega),
    sliceRadialPoly_coeff_top_sub_one _ (by omega)]
  simp only [Pi.zero_apply]
  ring

lemma arith_finIntVec_cons {m q : ℕ} (t : Fin q) (s : Fin m → Fin q) :
    finIntVec (Fin.cons t s : Fin (m + 1) → Fin q) = Fin.cons ((t : ℕ) : ℤ) (finIntVec s) := by
  funext l
  refine Fin.cases ?_ (fun k => ?_) l <;> simp [finIntVec]

/-- Slicing the complete sum in the first coordinate, with `t ∈ [1, Q]` (periodicity). -/
lemma sum_eC_arithPhase_slice {m : ℕ} (d a b : ℕ) {q r : ℕ} (hq : 1 ≤ q) (hr : 1 ≤ r)
    (h : Fin (m + 1) → ℤ) :
    ∑ u : Fin (m + 1) → Fin (q * r), eC (arithPhase (m + 1) d ((a : ℝ) / q) ((b : ℝ) / r) h
        (finIntVec u)) =
      ∑ s : Fin m → Fin (q * r), ∑ t ∈ Icc 1 (q * r),
        eC (∑ k ∈ range (2 * d + 1),
          (arithPoly d ((a : ℝ) / q) ((b : ℝ) / r) h (finIntVec s)).coeff k * (t : ℝ) ^ k) := by
  set Q := q * r
  set F : (Fin m → ℤ) → ℕ → ℂ := fun w t =>
    eC (arithPhase (m + 1) d ((a : ℝ) / q) ((b : ℝ) / r) h (Fin.cons (t : ℤ) w)) with hF
  rw [← (Fin.consEquiv fun _ : Fin (m + 1) => Fin Q).sum_comp, Fintype.sum_prod_type_right]
  refine Fintype.sum_congr _ _ fun s => ?_
  have hc : ∀ t : Fin Q, (Fin.consEquiv fun _ : Fin (m + 1) => Fin Q) (t, s) = Fin.cons t s :=
    fun _ => rfl
  simp only [hc, arith_finIntVec_cons]
  have h1 : ∑ t : Fin Q, eC (arithPhase (m + 1) d ((a : ℝ) / q) ((b : ℝ) / r) h
      (Fin.cons ((t : ℕ) : ℤ) (finIntVec s))) = ∑ t ∈ range Q, F (finIntVec s) t :=
    Fin.sum_univ_eq_sum_range (F (finIntVec s)) Q
  have hper : F (finIntVec s) Q = F (finIntVec s) 0 := by
    simp only [hF]
    refine eC_arithPhase_periodic d a b hq hr h fun i => ?_
    refine Fin.cases ?_ (fun k => ?_) i
    · simp only [Fin.cons_zero, Nat.cast_zero]
      exact Int.modEq_zero_iff_dvd.2 (by simp [Q])
    · simp
  have h2 : ∑ t ∈ range Q, F (finIntVec s) t = ∑ t ∈ Icc 1 Q, F (finIntVec s) t := by
    rw [sum_Icc_one_eq_sum_range]
    have e1 := Finset.sum_range_succ (F (finIntVec s)) Q
    have e2 := Finset.sum_range_succ' (F (finIntVec s)) Q
    rw [hper] at e1
    have := e1.symm.trans e2
    exact add_right_cancel this
  rw [h1, h2]
  refine sum_congr rfl fun t _ => ?_
  simp only [hF]
  congr 1
  rw [← arithPoly_eval d _ _ h (finIntVec s) (t : ℤ)]
  simp

/-- Blueprint Lemma 9.2, the case `D = 2d ≥ 4`: there are `C ≥ 1` and `c > 0` such that if
`N/2 ≤ r ≤ N`, `(b, r) = 1` and `gcd(D b h₁, r) ≤ N^{1/2}`, then `|G| ≤ C N^{-c}` (for every
`a/q`, `q ≥ 1`). The coefficient of `t^{D-1}` on every slice is `-D (b/r) h₁` (Lemma 3.1), whose
reduced denominator lies in `[N^{1/2}/2, N]`, and Corollary 3.5 applies. -/
lemma norm_arithG_slice_le {m d : ℕ} (hd : 2 ≤ d) :
    ∃ C c : ℝ, 1 ≤ C ∧ 0 < c ∧ ∀ (a q b r N : ℕ), 1 ≤ q → 1 ≤ r → 1 ≤ N → N ≤ 2 * r → r ≤ N →
      ∀ h : Fin (m + 1) → ℤ, (Int.gcd (2 * d * b * h 0) r : ℝ) ≤ Real.sqrt N →
        ‖arithG (m + 1) d a q b r h‖ ≤ C * (N : ℝ) ^ (-c) := by
  obtain ⟨C, c, hC, hc, hcor⟩ := norm_sum_slices_le_of_rational_coeff (2 * d)
  refine ⟨C, c, hC, hc, fun a q b r N hq hr hN hNr hrN h hgcd => ?_⟩
  have hQ : 1 ≤ q * r := Nat.mul_pos hq hr
  have hQ0 : (0 : ℝ) < ((q * r : ℕ) : ℝ) := by exact_mod_cast hQ
  have hN1 : (1 : ℝ) ≤ N := by exact_mod_cast hN
  have hr0 : (0 : ℝ) < r := by exact_mod_cast hr
  set X : ℤ := -(2 * d * b * h 0) with hX
  set g : ℕ := Int.gcd X r with hg
  have hg' : g = Int.gcd (2 * d * b * h 0) r := by rw [hg, hX, Int.neg_gcd]
  have hg0 : 0 < g := Int.gcd_pos_of_ne_zero_right _ (by exact_mod_cast (show r ≠ 0 by omega))
  have hgr : g ∣ r := by
    have := Int.gcd_dvd_right X (r : ℤ); exact_mod_cast this
  have hgX : (g : ℤ) ∣ X := Int.gcd_dvd_left X r
  set B' : ℤ := X / g
  set r' : ℕ := r / g
  have hg0R : (g : ℝ) ≠ 0 := by exact_mod_cast hg0.ne'
  have hr'R : (r' : ℝ) = r / g := Nat.cast_div hgr hg0R
  have hB'R : (B' : ℝ) = X / g := by
    rw [Int.cast_div hgX (by exact_mod_cast hg0.ne')]; rfl
  have hcop : Int.gcd B' r' = 1 := by
    have := Int.gcd_div_gcd_div_gcd (i := X) (j := r) (by omega)
    rw [← hg] at this
    convert this using 2
    simp [r']
  -- the coefficient
  have hcoeff : ∀ s : Fin m → Fin (q * r),
      (arithPoly d ((a : ℝ) / q) ((b : ℝ) / r) h (finIntVec s)).coeff (2 * d - 1) =
        (B' : ℝ) / r' := by
    intro s
    rw [arithPoly_coeff (by omega), hB'R, hr'R, hX]
    push_cast
    field_simp
  have hgN : (g : ℝ) ≤ Real.sqrt N := by rw [hg']; exact hgcd
  have hsqrt : Real.sqrt N ^ 2 = N := Real.sq_sqrt (by linarith)
  have hsq0 : 0 < Real.sqrt N := Real.sqrt_pos.2 (by linarith)
  have hg1 : (1 : ℝ) ≤ g := by exact_mod_cast hg0
  have hr'lo : Real.sqrt N / 2 ≤ r' := by
    rw [hr'R, le_div_iff₀ (by linarith)]
    have h2r : (N : ℝ) ≤ 2 * r := by exact_mod_cast hNr
    nlinarith
  have hr'hi : (r' : ℝ) ≤ N := by
    have : r' ≤ N := (Nat.div_le_self r g).trans hrN
    exact_mod_cast this
  have hQN : (N : ℝ) / 2 ≤ ((q * r : ℕ) : ℝ) := by
    have h2r : (N : ℝ) ≤ 2 * r := by exact_mod_cast hNr
    have : (r : ℝ) ≤ ((q * r : ℕ) : ℝ) := by
      exact_mod_cast Nat.le_mul_of_pos_left r hq
    linarith
  have hbound := hcor (univ : Finset (Fin m → Fin (q * r)))
    (fun s k => (arithPoly d ((a : ℝ) / q) ((b : ℝ) / r) h (finIntVec s)).coeff k)
    (fun _ => B') (fun _ => r') (N : ℝ) (q * r) (2 * d - 1) hN1 hQN (by omega) (by omega)
    (fun s _ => hcoeff s) (fun _ _ => hcop) (fun _ _ => hr'lo) (fun _ _ => hr'hi)
  unfold arithG
  rw [sum_eC_arithPhase_slice d a b hq hr h, norm_mul, norm_inv, norm_pow, Complex.norm_natCast]
  rw [card_univ, Fintype.card_pi, prod_const, card_univ, Fintype.card_fin, Fintype.card_fin]
    at hbound
  calc (((q * r : ℕ) : ℝ) ^ (m + 1))⁻¹ * ‖_‖
      ≤ (((q * r : ℕ) : ℝ) ^ (m + 1))⁻¹ *
          (C * (N : ℝ) ^ (-c) * ((q * r : ℕ) : ℝ) * (((q * r) ^ m : ℕ) : ℝ)) :=
        mul_le_mul_of_nonneg_left hbound (by positivity)
    _ = C * (N : ℝ) ^ (-c) := by
        push_cast
        field_simp
        ring

/-- Progression count on `[-R, R]` (Lemma 3.2): `#{t ∈ [-R, R] : g ∣ D t} ≤ 2 D R / g + D + 1`. -/
lemma arith_card_Icc_filter_dvd_le {g D : ℕ} (hg : 0 < g) (hD : 0 < D) (R : ℕ) :
    (#{t ∈ Finset.Icc (-(R : ℤ)) R | (g : ℤ) ∣ D * t} : ℝ) ≤ D * (2 * R) / g + D + 1 :=
  card_filter_dvd_mul_le hg hD (by positivity) (-(R : ℝ)) _ fun t ht => by
    rw [Finset.mem_Icc] at ht
    constructor
    · exact_mod_cast ht.1
    · have : (t : ℝ) ≤ R := by exact_mod_cast ht.2
      linarith

/-- Blueprint Lemma 9.2, exceptional density for `D ≥ 4`: for `(b, r) = 1`, `1 ≤ r ≤ N` and
`R ≥ N`, `#{t ∈ [-R, R] : gcd(D b t, r) > N^{1/2}} ≤ C N^{-3/8} (2R + 1)` (divisor bound with
exponent `1/8` and progression counts). -/
lemma card_exc_slice_le (d : ℕ) (hd : 1 ≤ d) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (b r N : ℕ), 1 ≤ r → r ≤ N → Nat.Coprime b r → ∀ R : ℕ, N ≤ R →
      (#{t ∈ Finset.Icc (-(R : ℤ)) R | Real.sqrt N < (Int.gcd (2 * d * b * t) r : ℝ)} : ℝ) ≤
        C * (N : ℝ) ^ (-(3 / 8 : ℝ)) * (2 * R + 1) := by
  obtain ⟨Cτ, hτ⟩ := card_divisors_le_rpow (ε := 1 / 8) (by norm_num)
  have hCτ : 0 ≤ Cτ := by
    have := hτ 1 one_pos
    simp at this; linarith
  refine ⟨Cτ * (6 * d + 1), by positivity, fun b r N hr hrN hbr R hR => ?_⟩
  classical
  have hN1 : (1 : ℝ) ≤ N := by exact_mod_cast hr.trans hrN
  have hN0 : (0 : ℝ) < N := by linarith
  have hRN : (N : ℝ) ≤ R := by exact_mod_cast hR
  set D : ℕ := 2 * d
  have hD : 0 < D := by omega
  set G : Finset ℕ := r.divisors.filter fun g : ℕ => Real.sqrt N < (g : ℝ)
  have hsub : {t ∈ Finset.Icc (-(R : ℤ)) R | Real.sqrt N < (Int.gcd (2 * d * b * t) r : ℝ)} ⊆
      G.biUnion fun g => {t ∈ Finset.Icc (-(R : ℤ)) R | (g : ℤ) ∣ D * t} := by
    intro t ht
    rw [mem_filter] at ht
    rw [Finset.mem_biUnion]
    set g := Int.gcd (2 * d * b * t) r
    have hgr : g ∣ r := by
      have := Int.gcd_dvd_right (2 * d * b * t) (r : ℤ); exact_mod_cast this
    refine ⟨g, ?_, ?_⟩
    · rw [mem_filter, Nat.mem_divisors]; exact ⟨⟨hgr, by omega⟩, ht.2⟩
    · rw [mem_filter]
      refine ⟨ht.1, ?_⟩
      have h1 : (g : ℤ) ∣ (D * t) * b := by
        have := Int.gcd_dvd_left (2 * d * b * t) (r : ℤ)
        have e : (2 * d * b * t : ℤ) = (D * t) * b := by simp only [D]; push_cast; ring
        exact this.trans (dvd_of_eq e)
      have hcop : IsCoprime (g : ℤ) (b : ℤ) := by
        have hc : Nat.Coprime g b := Nat.Coprime.coprime_dvd_left hgr hbr.symm
        exact Nat.isCoprime_iff_coprime.2 hc
      exact hcop.dvd_of_dvd_mul_right h1
  have hsqrt : Real.sqrt N ^ 2 = N := Real.sq_sqrt hN0.le
  have hsq0 : 0 < Real.sqrt N := Real.sqrt_pos.2 hN0
  have hsqR : Real.sqrt N ≤ R := by
    have : Real.sqrt N ≤ N := by nlinarith [Real.sqrt_nonneg (N : ℝ)]
    linarith
  have hterm : ∀ g ∈ G, (#{t ∈ Finset.Icc (-(R : ℤ)) R | (g : ℤ) ∣ D * t} : ℝ) ≤
      D * (2 * R) / Real.sqrt N + D + 1 := by
    intro g hg
    rw [mem_filter, Nat.mem_divisors] at hg
    have hg0 : 0 < g := Nat.pos_of_dvd_of_pos hg.1.1 (by omega)
    refine (arith_card_Icc_filter_dvd_le hg0 hD R).trans ?_
    gcongr; exact hg.2.le
  have hcardG : (#G : ℝ) ≤ Cτ * (N : ℝ) ^ (1 / 8 : ℝ) := by
    have h1 : (#G : ℝ) ≤ (r.divisors.card : ℝ) := by exact_mod_cast Finset.card_filter_le _ _
    refine h1.trans ((hτ r (by omega)).trans ?_)
    gcongr
  calc (#{t ∈ Finset.Icc (-(R : ℤ)) R | Real.sqrt N < (Int.gcd (2 * d * b * t) r : ℝ)} : ℝ)
      ≤ (#(G.biUnion fun g => {t ∈ Finset.Icc (-(R : ℤ)) R | (g : ℤ) ∣ D * t}) : ℝ) := by
        exact_mod_cast Finset.card_le_card hsub
    _ ≤ ∑ g ∈ G, (#{t ∈ Finset.Icc (-(R : ℤ)) R | (g : ℤ) ∣ D * t} : ℝ) := by
        exact_mod_cast Finset.card_biUnion_le
    _ ≤ ∑ g ∈ G, (D * (2 * R) / Real.sqrt N + D + 1) := sum_le_sum hterm
    _ = #G * (D * (2 * R) / Real.sqrt N + D + 1) := by rw [sum_const, nsmul_eq_mul]
    _ ≤ Cτ * (N : ℝ) ^ (1 / 8 : ℝ) * (D * (2 * R) / Real.sqrt N + D + 1) := by
        gcongr
    _ ≤ Cτ * (6 * d + 1) * (N : ℝ) ^ (-(3 / 8 : ℝ)) * (2 * R + 1) := by
        have e1 : (N : ℝ) ^ (1 / 8 : ℝ) / Real.sqrt N = (N : ℝ) ^ (-(3 / 8 : ℝ)) := by
          rw [Real.sqrt_eq_rpow, ← Real.rpow_sub hN0]; norm_num
        have e2 : (N : ℝ) ^ (1 / 8 : ℝ) = (N : ℝ) ^ (-(3 / 8 : ℝ)) * Real.sqrt N := by
          rw [← e1, div_mul_cancel₀ _ hsq0.ne']
        have hp : 0 ≤ (N : ℝ) ^ (-(3 / 8 : ℝ)) := by positivity
        have hDd : (D : ℝ) = 2 * d := by simp only [D]; push_cast; ring
        have key : (N : ℝ) ^ (1 / 8 : ℝ) * (D * (2 * R) / Real.sqrt N + D + 1) ≤
            (6 * d + 1) * (N : ℝ) ^ (-(3 / 8 : ℝ)) * (2 * R + 1) := by
          rw [mul_add, mul_add, mul_div_assoc', mul_comm ((N : ℝ) ^ (1 / 8 : ℝ)) (D * (2 * R)),
            mul_div_assoc, e1, e2, hDd]
          have hd1 : (1 : ℝ) ≤ d := by exact_mod_cast hd
          nlinarith [mul_nonneg hp hsq0.le, mul_le_mul_of_nonneg_left hsqR hp]
        calc Cτ * (N : ℝ) ^ (1 / 8 : ℝ) * (D * (2 * R) / Real.sqrt N + D + 1)
            = Cτ * ((N : ℝ) ^ (1 / 8 : ℝ) * (D * (2 * R) / Real.sqrt N + D + 1)) := by ring
          _ ≤ Cτ * ((6 * d + 1) * (N : ℝ) ^ (-(3 / 8 : ℝ)) * (2 * R + 1)) :=
            mul_le_mul_of_nonneg_left key hCτ
          _ = _ := by ring

open scoped Classical in
/-- Blueprint Lemma 9.2, exceptional density for `D = 2`: for `N/2 ≤ r` and `R ≥ N`,
`#{t ∈ [-R, R] : r ∣ 2 v t for some 1 ≤ v ≤ N^{1/4}} ≤ 11 N^{-3/8} (2R + 1)`. -/
lemma card_exc_quad_le (r N : ℕ) (hN : 1 ≤ N) (hNr : N ≤ 2 * r) (R : ℕ) (hR : N ≤ R) :
    (#{t ∈ Finset.Icc (-(R : ℤ)) R | ∃ v : ℕ, 1 ≤ v ∧ (v : ℝ) ≤ (N : ℝ) ^ (1 / 4 : ℝ) ∧
        (r : ℤ) ∣ 2 * v * t} : ℝ) ≤ 11 * (N : ℝ) ^ (-(3 / 8 : ℝ)) * (2 * R + 1) := by
  classical
  have hN1 : (1 : ℝ) ≤ N := by exact_mod_cast hN
  have hN0 : (0 : ℝ) < N := by linarith
  have hr : 0 < r := by omega
  have hr0 : (0 : ℝ) < r := by exact_mod_cast hr
  have hRN : (N : ℝ) ≤ R := by exact_mod_cast hR
  set V : ℝ := (N : ℝ) ^ (1 / 4 : ℝ) with hV
  have hV1 : 1 ≤ V := Real.one_le_rpow hN1 (by norm_num)
  set w : ℝ := Real.sqrt N with hw
  have hw0 : 0 < w := Real.sqrt_pos.2 hN0
  have hw2 : w ^ 2 = N := Real.sq_sqrt hN0.le
  have hV2 : V ^ 2 = w := by
    rw [hV, hw, Real.sqrt_eq_rpow, ← Real.rpow_natCast, ← Real.rpow_mul hN0.le]; norm_num
  have hsub : {t ∈ Finset.Icc (-(R : ℤ)) R | ∃ v : ℕ, 1 ≤ v ∧ (v : ℝ) ≤ V ∧
        (r : ℤ) ∣ 2 * v * t} ⊆
      (Finset.Icc 1 ⌊V⌋₊).biUnion fun v =>
        {t ∈ Finset.Icc (-(R : ℤ)) R | (r : ℤ) ∣ ((2 * v : ℕ) : ℤ) * t} := by
    intro t ht
    rw [mem_filter] at ht
    obtain ⟨v, hv1, hvV, hdvd⟩ := ht.2
    rw [Finset.mem_biUnion]
    refine ⟨v, Finset.mem_Icc.2 ⟨hv1, Nat.le_floor hvV⟩, mem_filter.2 ⟨ht.1, ?_⟩⟩
    push_cast; exact hdvd
  have hterm : ∀ v ∈ Finset.Icc 1 ⌊V⌋₊,
      (#{t ∈ Finset.Icc (-(R : ℤ)) R | (r : ℤ) ∣ ((2 * v : ℕ) : ℤ) * t} : ℝ) ≤
        2 * V * (2 * R) / r + 2 * V + 1 := by
    intro v hv
    rw [Finset.mem_Icc] at hv
    have hvV : (v : ℝ) ≤ V := (Nat.le_floor_iff (by linarith)).1 hv.2
    refine (arith_card_Icc_filter_dvd_le hr (by omega) R).trans ?_
    push_cast
    gcongr
  have hcard : (#(Finset.Icc 1 ⌊V⌋₊) : ℝ) ≤ V := by
    rw [Nat.card_Icc, Nat.add_sub_cancel]; exact Nat.floor_le (by linarith)
  have h2r : (N : ℝ) ≤ 2 * r := by exact_mod_cast hNr
  calc (#{t ∈ Finset.Icc (-(R : ℤ)) R | ∃ v : ℕ, 1 ≤ v ∧ (v : ℝ) ≤ V ∧
        (r : ℤ) ∣ 2 * v * t} : ℝ)
      ≤ (#((Finset.Icc 1 ⌊V⌋₊).biUnion fun v =>
          {t ∈ Finset.Icc (-(R : ℤ)) R | (r : ℤ) ∣ ((2 * v : ℕ) : ℤ) * t}) : ℝ) := by
        exact_mod_cast Finset.card_le_card hsub
    _ ≤ ∑ v ∈ Finset.Icc 1 ⌊V⌋₊,
          (#{t ∈ Finset.Icc (-(R : ℤ)) R | (r : ℤ) ∣ ((2 * v : ℕ) : ℤ) * t} : ℝ) := by
        exact_mod_cast Finset.card_biUnion_le
    _ ≤ ∑ v ∈ Finset.Icc 1 ⌊V⌋₊, (2 * V * (2 * R) / r + 2 * V + 1) := sum_le_sum hterm
    _ = #(Finset.Icc 1 ⌊V⌋₊) * (2 * V * (2 * R) / r + 2 * V + 1) := by
        rw [sum_const, nsmul_eq_mul]
    _ ≤ V * (2 * V * (2 * R) / r + 2 * V + 1) := by gcongr
    _ ≤ 11 * R / w := by
        have e1 : 2 * V * (2 * R) / r ≤ 8 * V * R / N := by
          have h4 : (0 : ℝ) ≤ 4 * V * R := by positivity
          rw [div_le_div_iff₀ hr0 hN0]; nlinarith [mul_le_mul_of_nonneg_left h2r h4]
        have e2 : V * (8 * V * R / N) = 8 * R / w := by
          rw [← hw2]; field_simp; rw [← hV2]; ring
        have e3 : V * (2 * V + 1) ≤ 3 * w := by nlinarith
        have e4 : 3 * w ≤ 3 * R / w := by
          rw [le_div_iff₀ hw0]; nlinarith
        calc V * (2 * V * (2 * R) / r + 2 * V + 1)
            = V * (2 * V * (2 * R) / r) + V * (2 * V + 1) := by ring
          _ ≤ V * (8 * V * R / N) + 3 * w := by gcongr
          _ ≤ 8 * R / w + 3 * R / w := by rw [e2]; linarith
          _ = 11 * R / w := by ring
    _ ≤ 11 * (N : ℝ) ^ (-(3 / 8 : ℝ)) * (2 * R + 1) := by
        have e5 : 1 / w ≤ (N : ℝ) ^ (-(3 / 8 : ℝ)) := by
          rw [hw, Real.sqrt_eq_rpow, one_div, ← Real.rpow_neg hN0.le]
          exact Real.rpow_le_rpow_of_exponent_le hN1 (by norm_num)
        have hp : 0 ≤ (N : ℝ) ^ (-(3 / 8 : ℝ)) := by positivity
        calc 11 * R / w = 11 * R * (1 / w) := by ring
          _ ≤ 11 * R * (N : ℝ) ^ (-(3 / 8 : ℝ)) := by gcongr
          _ ≤ 11 * (N : ℝ) ^ (-(3 / 8 : ℝ)) * (2 * R + 1) := by nlinarith

open scoped Classical in
/-- Blueprint Lemma 9.2, the complete-sum bound in both degree cases: there are `c, b > 0` (here
`b = 3/8`) with `|G| ≤ C N^{-c} + 𝟙_{E}(h₁)` for an exceptional set `E ⊆ ℤ` depending only on
`(b, r)` (and `N`), of density at most `C' N^{-3/8}` in every interval `[-R, R]`, `R ≥ N`. -/
lemma exists_arithG_bound {m d : ℕ} (hd : 1 ≤ d) :
    ∃ C c C' : ℝ, 0 ≤ C ∧ 0 < c ∧ 0 ≤ C' ∧ ∀ N b r : ℕ, 1 ≤ N → N ≤ 2 * r → r ≤ N →
      Nat.Coprime b r → ∃ E : Set ℤ,
        (∀ R : ℕ, N ≤ R → (#{t ∈ Finset.Icc (-(R : ℤ)) R | t ∈ E} : ℝ) ≤
          C' * (N : ℝ) ^ (-(3 / 8 : ℝ)) * (2 * R + 1)) ∧
        ∀ (a q : ℕ) (h : Fin (m + 1) → ℤ), 1 ≤ q →
          ‖arithG (m + 1) d a q b r h‖ ≤ C * (N : ℝ) ^ (-c) + if h 0 ∈ E then 1 else 0 := by
  rcases Nat.lt_or_ge d 2 with hd1 | hd2
  · obtain rfl : d = 1 := by omega
    refine ⟨Real.sqrt 2, 1 / 8, 11, by positivity, by norm_num, by norm_num,
      fun N b r hN hNr hrN hbr => ?_⟩
    refine ⟨{t | ∃ v : ℕ, 1 ≤ v ∧ (v : ℝ) ≤ (N : ℝ) ^ (1 / 4 : ℝ) ∧ (r : ℤ) ∣ 2 * v * t},
      fun R hR => ?_, fun a q h hq => ?_⟩
    · simpa only [Set.mem_ofPred_eq] using card_exc_quad_le r N hN hNr R hR
    · simpa only [Set.mem_ofPred_eq] using norm_arithG_one_le a q b r N hq (by omega) hN hbr h
  · obtain ⟨C, c, hC, hc, hsl⟩ := norm_arithG_slice_le (m := m) hd2
    obtain ⟨C', hC', hcnt⟩ := card_exc_slice_le d hd
    refine ⟨C, c, C', by linarith, hc, hC', fun N b r hN hNr hrN hbr => ?_⟩
    refine ⟨{t | Real.sqrt N < (Int.gcd (2 * d * b * t) r : ℝ)}, fun R hR => ?_,
      fun a q h hq => ?_⟩
    · simpa only [Set.mem_ofPred_eq] using hcnt b r N (by omega) hrN hbr R hR
    · by_cases hE : h 0 ∈ {t : ℤ | Real.sqrt N < (Int.gcd (2 * d * b * t) r : ℝ)}
      · rw [ite_eq_left hE]
        have h1 := norm_arithG_le_one (n := m + 1) (q := q) (r := r) d a b hq (by omega) h
        have h2 : 0 ≤ C * (N : ℝ) ^ (-c) := by positivity
        linarith
      · rw [ite_eq_right hE, add_zero]
        exact hsl a q b r N hq (by omega) hN hNr hrN h (not_lt.1 hE)


open scoped Classical in
/-- The lattice points of the cube `|hᵢ| ≤ R` whose first coordinate lies in `E`. -/
lemma arith_count_intCube_inter_le {m : ℕ} (E : Set ℤ) (R : ℕ) {δ : ℝ}
    (hE : (#{t ∈ Finset.Icc (-(R : ℤ)) R | t ∈ E} : ℝ) ≤ δ * (2 * R + 1)) :
    Measure.count (intCube (0 : Fin (m + 1) → ℤ) R ∩ {h | h 0 ∈ E}) ≤
      ENNReal.ofReal (δ * (2 * R + 1) ^ (m + 1)) := by
  set t : Fin (m + 1) → Finset ℤ := fun i =>
    if i = 0 then {t ∈ Finset.Icc (-(R : ℤ)) R | t ∈ E} else Finset.Icc (-(R : ℤ)) R
  have hset : intCube (0 : Fin (m + 1) → ℤ) R ∩ {h | h 0 ∈ E} = (Fintype.piFinset t : Set _) := by
    ext h
    simp only [intCube, Set.mem_inter_iff, Set.mem_ofPred_eq, Pi.zero_apply, sub_zero,
      Finset.mem_coe, Fintype.mem_piFinset, t]
    constructor
    · rintro ⟨h1, h2⟩ i
      split_ifs with hi
      · subst hi; exact mem_filter.2 ⟨Finset.mem_Icc.2 (abs_le.1 (h1 0)), h2⟩
      · exact Finset.mem_Icc.2 (abs_le.1 (h1 i))
    · intro h1
      refine ⟨fun i => ?_, ?_⟩
      · have := h1 i
        split_ifs at this with hi
        · exact abs_le.2 (Finset.mem_Icc.1 (mem_filter.1 this).1)
        · exact abs_le.2 (Finset.mem_Icc.1 this)
      · have := h1 0
        simp only [↓reduceIte] at this
        exact (mem_filter.1 this).2
  rw [hset, Measure.count_apply_finset, Fintype.card_piFinset, Fin.prod_univ_succ]
  simp only [t, ↓reduceIte, Fin.succ_ne_zero, prod_const, card_univ, Fintype.card_fin,
    Int.card_Icc]
  have hc : ((R : ℤ) + 1 - -(R : ℤ)).toNat = 2 * R + 1 := by omega
  rw [hc, ← ENNReal.ofReal_natCast]
  refine ENNReal.ofReal_le_ofReal ?_
  push_cast
  rw [pow_succ']
  have : (0 : ℝ) ≤ (2 * R + 1) ^ m := by positivity
  nlinarith

open scoped Classical in
/-- Blueprint Lemma 9.2, the lattice sum of `B_L` over an exceptional set (dyadic shells): if
`E ⊆ ℤ` has density at most `δ` in every interval `[-R, R]` with `R ≥ L` (`L ≥ 1`), then
`∑_{h : h₁ ∈ E} B_L(h) ≤ C_n δ`, `C_n = envelopeConst n`. -/
lemma arith_tsum_latEnvelope_indicator_le {m : ℕ} {E : Set ℤ} {L δ : ℝ} (hL : 1 ≤ L) (hδ : 0 ≤ δ)
    (hE : ∀ R : ℕ, L ≤ R → (#{t ∈ Finset.Icc (-(R : ℤ)) R | t ∈ E} : ℝ) ≤ δ * (2 * R + 1)) :
    ∑' h : Fin (m + 1) → ℤ, ENNReal.ofReal (latEnvelope (m + 1) L h) *
        (if h 0 ∈ E then 1 else 0) ≤
      ENNReal.ofReal (envelopeConst (m + 1) * δ) := by
  have hL0 : 0 < L := by linarith
  set T : Set (Fin (m + 1) → ℤ) := {h | h 0 ∈ E}
  have hg : ∀ h : Fin (m + 1) → ℤ, (if h 0 ∈ E then (1 : ℝ≥0∞) else 0) = T.indicator 1 h := by
    intro h; by_cases hh : h 0 ∈ E <;> simp [T, hh]
  simp_rw [hg]
  rw [← lintegral_count]
  refine (lintegral_mul_le_tsum_setLIntegral Measure.count
    (AEMeasurable.of_discrete (f := T.indicator 1))
    (fun k => MeasurableSet.of_discrete (s := intCube 0 ⌈2 ^ k * L⌉₊)) _
    (envelope_le_tsum_indicator_int hL0)).trans ?_
  rw [ENNReal.ofReal_mul (by unfold envelopeConst; positivity), ← tsum_envelopeCoeff_mul (m + 1) hL0]
  refine ENNReal.tsum_le_tsum fun k => ?_
  gcongr
  rw [lintegral_indicator_one MeasurableSet.of_discrete, Measure.restrict_apply
    MeasurableSet.of_discrete, Set.inter_comm]
  set R : ℕ := ⌈2 ^ k * L⌉₊
  have hk1 : (1 : ℝ) ≤ 2 ^ k * L := one_le_mul_of_one_le_of_one_le (one_le_pow₀ one_le_two) hL
  have hLR : L ≤ R := by
    have : L ≤ 2 ^ k * L := le_mul_of_one_le_left hL0.le (one_le_pow₀ one_le_two)
    exact this.trans (Nat.le_ceil _)
  refine (arith_count_intCube_inter_le E R (hE R hLR)).trans ?_
  rw [← ENNReal.ofReal_mul (by positivity), mul_comm]
  refine ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_right ?_ hδ)
  refine pow_le_pow_left₀ (by positivity) ?_ _
  have := Nat.ceil_lt_add_one (show 0 ≤ 2 ^ k * L by positivity)
  linarith


/-- The Schwartz function `𝓕⁻ χ`, of which `φ_s` is the `L_s`-dilate (`arith_liftPhi_eq_dilateL`). -/
noncomputable def arithPhiS (n : ℕ) : 𝓢(EuclideanSpace ℝ (Fin n), ℂ) := 𝓕⁻ (liftCutoffSchwartz n)

/-- `φ_s = (𝓕⁻ χ)_{L_s}` is the `L_s`-dilate of the Schwartz function `𝓕⁻ χ`. -/
lemma arith_liftPhi_eq_dilateL (s : ℕ) :
    liftPhi n d Ω p s =
      dilateL (arithPhiS n)
        (liftL n d Ω p s : ℝ) := by
  funext x
  have hL := liftL_pos (n := n) (d := d) (Ω := Ω) (p := p) s
  have hL' : 0 < (liftL n d Ω p s : ℝ)⁻¹ := inv_pos.2 hL
  have hfun : (fun ξ : EuclideanSpace ℝ (Fin n) => (liftChi n d Ω p s ξ : ℂ)) =
      fun ξ => liftCutoffSchwartz n (((liftL n d Ω p s : ℝ)⁻¹)⁻¹ • ξ) := by
    funext ξ; rw [inv_inv, liftCutoffSchwartz_apply]; rfl
  rw [liftPhi, hfun, fourierInv_comp_inv_smul _ hL', arithPhiS, ← SchwartzMap.fourierInv_coe, dilateL,
    inv_pow]

/-- Uniform bounds for `φ_s` on `G`: `|φ_s(y)| ≤ C B_{L_s}(y) ≤ C`, with `∑_y |φ_s(y)| ≤ C C_n`. -/
lemma arith_liftPhi_bounds (n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ),
      (∀ y : Fin n → ℤ, ‖liftPhi n d Ω p s (latEmbed y)‖ ≤
        C * latEnvelope n (liftL n d Ω p s) y) ∧
      (∀ y : Fin n → ℤ, ‖liftPhi n d Ω p s (latEmbed y)‖ ≤ C) ∧
      ∑' y : Fin n → ℤ, ‖liftPhi n d Ω p s (latEmbed y)‖ₑ ≤
        ENNReal.ofReal (C * envelopeConst n) := by
  obtain ⟨C, hC, h⟩ := norm_liftPhi_le n
  refine ⟨C, hC, fun d Ω p s => ⟨(h d Ω p s).2, fun y => ?_, ?_⟩⟩
  · have hL1 : (1 : ℝ) ≤ liftL n d Ω p s := by
      unfold liftL; exact_mod_cast Nat.one_le_two_pow
    refine ((h d Ω p s).2 y).trans (mul_le_of_le_one_right hC ?_)
    unfold latEnvelope envelope
    have h1 : ((liftL n d Ω p s : ℝ) ^ n)⁻¹ ≤ 1 := inv_le_one_of_one_le₀ (one_le_pow₀ hL1)
    have h2 : ((1 + ‖latEmbed y‖ / (liftL n d Ω p s : ℝ)) ^ (n + 1))⁻¹ ≤ 1 :=
      inv_le_one_of_one_le₀ (one_le_pow₀ (by
        have : 0 ≤ ‖latEmbed y‖ / (liftL n d Ω p s : ℝ) := by positivity
        linarith))
    have h3 : 0 ≤ ((liftL n d Ω p s : ℝ) ^ n)⁻¹ := by positivity
    have h4 : 0 ≤ ((1 + ‖latEmbed y‖ / (liftL n d Ω p s : ℝ)) ^ (n + 1))⁻¹ := by positivity
    nlinarith
  · have hL1 : (1 : ℝ) ≤ liftL n d Ω p s := by
      unfold liftL; exact_mod_cast Nat.one_le_two_pow
    obtain ⟨hs, hsum⟩ := summable_latEnvelope_and_tsum_le (n := n) hL1
    calc ∑' y : Fin n → ℤ, ‖liftPhi n d Ω p s (latEmbed y)‖ₑ
        ≤ ∑' y : Fin n → ℤ, ENNReal.ofReal (C * latEnvelope n (liftL n d Ω p s) y) :=
          ENNReal.tsum_le_tsum fun y => by
            rw [← ofReal_norm]; exact ENNReal.ofReal_le_ofReal ((h d Ω p s).2 y)
      _ = ENNReal.ofReal (∑' y, C * latEnvelope n (liftL n d Ω p s) y) :=
          (ENNReal.ofReal_tsum_of_nonneg (fun y => mul_nonneg hC
            (envelope_nonneg (by linarith) _)) (hs.mul_left C)).symm
      _ ≤ ENNReal.ofReal (C * envelopeConst n) := by
          rw [tsum_mul_left]; exact ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_left hsum hC)

/-- Blueprint Lemma 9.1 applied to `f ∈ ℓ¹`: `A_{s,a/q} f(x) = ∑_y e((a/q) P(x - y)) φ_s(x - y) f(y)`. -/
lemma arith_latMult_liftA_eq (s a : ℕ) {q : ℕ} (hq : 1 ≤ q) {f : (Fin n → ℤ) → ℂ}
    (hf : Summable fun z => ‖f z‖) (x : Fin n → ℤ) :
    latMult (liftA n d Ω p s a q) f x = ∑' y, eC ((a : ℝ) / q * (radialPolyZ n d (x - y) : ℝ)) *
      liftPhi n d Ω p s (latEmbed (x - y)) * f y := by
  have hint : IntegrableOn (liftA n d Ω p s a q) (torusCube n) :=
    integrableOn_liftSym (by simpa using integrable_liftChi (n := n) (d := d) (Ω := Ω) (p := p) s)
  rw [latMult_eq_latConv hint hf, latConv, ← (Equiv.subLeft x).tsum_eq]
  refine tsum_congr fun y => ?_
  simp only [Equiv.subLeft_apply, sub_sub_cancel, latKernel_liftA s a hq]

/-- A counting-measure integral of an absolutely summable function is its sum. -/
lemma arith_integral_count_eq_tsum {α : Type*} [MeasurableSpace α] [MeasurableSingletonClass α]
    [Countable α] {g : α → ℂ} (hg : Summable fun z => ‖g z‖) :
    ∫ z, g z ∂Measure.count = ∑' z, g z := by
  rw [integral_countable (integrable_count_iff.2 hg)]
  simp

/-- `y ↦ |φ_s(y)|` is summable on `G`. -/
lemma arith_summable_norm_liftPhi (s : ℕ) :
    Summable fun y : Fin n → ℤ => ‖liftPhi n d Ω p s (latEmbed y)‖ := by
  obtain ⟨C, hC, h⟩ := arith_liftPhi_bounds n
  have hL1 : (1 : ℝ) ≤ liftL n d Ω p s := by
    unfold liftL; exact_mod_cast Nat.one_le_two_pow
  exact Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (h d Ω p s).1
    ((summable_latEnvelope_and_tsum_le hL1).1.mul_left C)

/-- The kernel `κ(x, y) = e(α_x P(x - y)) φ_s(x - y)` of the linearized operator
`x ↦ A_{s, α_x} f(x)`, with `α_x = a_x / q_x` for the selection `σ(x) = (a_x, q_x)`. -/
noncomputable def arithKer (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ)
    (σ : (Fin n → ℤ) → ℕ × ℕ) (x y : Fin n → ℤ) : ℂ :=
  eC (((σ x).1 : ℝ) / (σ x).2 * (radialPolyZ n d (x - y) : ℝ)) *
    liftPhi n d Ω p s (latEmbed (x - y))

lemma norm_arithKer (s : ℕ) (σ : (Fin n → ℤ) → ℕ × ℕ) (x y : Fin n → ℤ) :
    ‖arithKer n d Ω p s σ x y‖ = ‖liftPhi n d Ω p s (latEmbed (x - y))‖ := by
  rw [arithKer, norm_mul, norm_eC, one_mul]

/-- The linearized operator is the kernel operator of `arithKer`. -/
lemma latMult_liftA_sel_eq (s : ℕ) (σ : (Fin n → ℤ) → ℕ × ℕ) (hσ : ∀ x, 1 ≤ (σ x).2)
    {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) (x : Fin n → ℤ) :
    latMult (liftA n d Ω p s (σ x).1 (σ x).2) f x =
      ∫ y, arithKer n d Ω p s σ x y * f y ∂Measure.count := by
  obtain ⟨C, hC, hb⟩ := arith_liftPhi_bounds n
  rw [arith_latMult_liftA_eq s _ (hσ x) hf, arith_integral_count_eq_tsum]
  · rfl
  · refine Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun y => ?_) (hf.mul_left C)
    rw [norm_mul, norm_arithKer]
    exact mul_le_mul_of_nonneg_right ((hb d Ω p s).2.1 _) (norm_nonneg _)

/-- The `TT*` kernel of the linearization (via Blueprint Lemma 9.1):
`H(x, x') = ∑_z e(α_x P(z) - α_{x'} P(z + h)) φ_s(z) conj φ_s(z + h)`, `h = x' - x`. -/
lemma integral_arithKer_mul_conj (s : ℕ) (σ : (Fin n → ℤ) → ℕ × ℕ) (x x' : Fin n → ℤ) :
    ∫ y, arithKer n d Ω p s σ x y * conj (arithKer n d Ω p s σ x' y) ∂Measure.count =
      ∑' z, eC (arithPhase n d (((σ x).1 : ℝ) / (σ x).2) (((σ x').1 : ℝ) / (σ x').2)
          (x' - x) z) * liftPhi n d Ω p s (latEmbed z) *
        conj (liftPhi n d Ω p s (latEmbed z + latEmbed (x' - x))) := by
  obtain ⟨C, hC, hb⟩ := arith_liftPhi_bounds n
  rw [arith_integral_count_eq_tsum]
  · rw [← (Equiv.subLeft x).tsum_eq]
    refine tsum_congr fun z => ?_
    simp only [Equiv.subLeft_apply, arithKer, sub_sub_cancel, map_mul, conj_eC]
    have e : x' - (x - z) = z + (x' - x) := by abel
    rw [e, latEmbed_add, arithPhase, sub_eq_add_neg _ (_ * _), eC_add]
    ring_nf
  · have hs := (arith_summable_norm_liftPhi (n := n) (d := d) (Ω := Ω) (p := p) s).comp_injective
      (Equiv.subLeft x).injective
    refine Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun y => ?_) (hs.mul_left C)
    rw [norm_mul, RCLike.norm_conj, norm_arithKer, norm_arithKer, mul_comm]
    exact mul_le_mul_of_nonneg_right ((hb d Ω p s).2.1 _) (norm_nonneg _)

/-- `|H(x, x')| = |H(x', x)|` for a `TT*` kernel. -/
lemma arith_enorm_integral_mul_conj_symm {α : Type*} [MeasurableSpace α] {μ : Measure α}
    (k : α → α → ℂ) (x x' : α) :
    ‖∫ z, k x z * conj (k x' z) ∂μ‖ₑ = ‖∫ z, k x' z * conj (k x z) ∂μ‖ₑ := by
  rw [← RCLike.enorm_conj, ← integral_conj]
  congr 2; funext z
  rw [map_mul, RCLike.conj_conj, mul_comm]

/-- Blueprint Lemma 9.2, eq. (`eq:arithH`), via Lemma 3.7 (`lem:periodic`): there is `C`
(depending only on `n`) such that for `α = a/q`, `β = b/r` and `Q = q r ≤ L_s`,
`|H| ≤ C (|G_Q| + Q/L_s) B_{L_s}(h)` for the `TT*` sum
`H = ∑_z e(α P(z) - β P(z + h)) φ_s(z) conj φ_s(z + h)`. -/
lemma norm_arithTT_le (n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s a q b r : ℕ),
      1 ≤ q → 1 ≤ r → ((q * r : ℕ) : ℝ) ≤ liftL n d Ω p s → ∀ h : Fin n → ℤ,
        ‖∑' z, eC (arithPhase n d ((a : ℝ) / q) ((b : ℝ) / r) h z) *
            liftPhi n d Ω p s (latEmbed z) * conj (liftPhi n d Ω p s (latEmbed z + latEmbed h))‖ ≤
          C * (‖arithG n d a q b r h‖ + ((q * r : ℕ) : ℝ) / liftL n d Ω p s) *
            latEnvelope n (liftL n d Ω p s) h := by
  obtain ⟨C, hC, hper⟩ := periodic_riemann_sum (arithPhiS n)
  refine ⟨C, hC, fun d Ω p s a q b r hq hr hQL h => ?_⟩
  have hQ : 1 ≤ q * r := Nat.mul_pos hq hr
  set L : ℝ := (liftL n d Ω p s : ℝ)
  have hL0 : 0 < L := liftL_pos s
  obtain ⟨-, h1, h2⟩ := hper L (q * r) hQ hQL
    (fun z => eC (arithPhase n d ((a : ℝ) / q) ((b : ℝ) / r) h z))
    (fun z z' hzz => eC_arithPhase_periodic d a b hq hr h hzz)
    (fun z => (norm_eC _).le) h
  rw [arith_liftPhi_eq_dilateL]
  set T := ∑' z, eC (arithPhase n d ((a : ℝ) / q) ((b : ℝ) / r) h z) *
    dilateL (arithPhiS n) L (latEmbed z) * conj (dilateL (arithPhiS n) L (latEmbed z + latEmbed h))
  set I := ∫ w, dilateL (arithPhiS n) L w * conj (dilateL (arithPhiS n) L (w + latEmbed h))
  have hG : ((((q * r : ℕ) : ℂ) ^ n)⁻¹ * ∑ u : Fin n → Fin (q * r),
      eC (arithPhase n d ((a : ℝ) / q) ((b : ℝ) / r) h fun i => ((u i : ℕ) : ℤ))) =
      arithG n d a q b r h := rfl
  rw [hG] at h1
  have hB : 0 ≤ latEnvelope n L h := envelope_nonneg hL0 _
  calc ‖T‖ ≤ ‖T - arithG n d a q b r h * I‖ + ‖arithG n d a q b r h * I‖ := by
        have := norm_le_insert' T (arithG n d a q b r h * I); linarith
    _ ≤ C * (((q * r : ℕ) : ℝ) / L) * latEnvelope n L h +
          ‖arithG n d a q b r h‖ * (C * latEnvelope n L h) := by
        rw [norm_mul]; gcongr
    _ = C * (‖arithG n d a q b r h‖ + ((q * r : ℕ) : ℝ) / L) * latEnvelope n L h := by ring

open scoped Classical in
/-- Column sums of a kernel with the bound of eq. (`eq:arithH`): if
`|F(h)| ≤ K (ε + 𝟙_E(h₁)) B_L(h)` and `E` has density `≤ δ` in intervals `[-R, R]`, `R ≥ L`, then
`∑_h |F(h)| ≤ K C_n (ε + δ)`. -/
lemma tsum_enorm_le_of_arith_bound {m : ℕ} {E : Set ℤ} {L ε δ K : ℝ} (hL : 1 ≤ L)
    (hε : 0 ≤ ε) (hδ : 0 ≤ δ) (hK : 0 ≤ K)
    (hE : ∀ R : ℕ, L ≤ R → (#{t ∈ Finset.Icc (-(R : ℤ)) R | t ∈ E} : ℝ) ≤ δ * (2 * R + 1))
    (F : (Fin (m + 1) → ℤ) → ℂ)
    (hF : ∀ h, ‖F h‖ ≤ K * (ε + if h 0 ∈ E then 1 else 0) * latEnvelope (m + 1) L h) :
    ∑' h, ‖F h‖ₑ ≤ ENNReal.ofReal (K * envelopeConst (m + 1) * (ε + δ)) := by
  have hL0 : 0 < L := by linarith
  have hCn : 0 ≤ envelopeConst (m + 1) := by unfold envelopeConst; positivity
  have hpt : ∀ h, ‖F h‖ₑ ≤ ENNReal.ofReal (K * ε) * ENNReal.ofReal (latEnvelope (m + 1) L h) +
      ENNReal.ofReal K * (ENNReal.ofReal (latEnvelope (m + 1) L h) *
        (if h 0 ∈ E then 1 else 0)) := by
    intro h
    have hB := envelope_nonneg (n := m + 1) hL0 (latEmbed h)
    rw [← ofReal_norm]
    refine (ENNReal.ofReal_le_ofReal (hF h)).trans ?_
    split_ifs with hh
    · rw [mul_one, ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul hK,
        ← ENNReal.ofReal_add (by positivity) (by positivity)]
      refine ENNReal.ofReal_le_ofReal (le_of_eq ?_)
      unfold latEnvelope; ring
    · rw [mul_zero, mul_zero, add_zero, add_zero, ← ENNReal.ofReal_mul (by positivity)]
  have hall : ∑' h, ENNReal.ofReal (latEnvelope (m + 1) L h) ≤
      ENNReal.ofReal (envelopeConst (m + 1)) := by
    obtain ⟨hs, hsum⟩ := summable_latEnvelope_and_tsum_le (n := m + 1) hL
    rw [← ENNReal.ofReal_tsum_of_nonneg (f := latEnvelope (m + 1) L) (fun h => envelope_nonneg hL0 _) hs]
    exact ENNReal.ofReal_le_ofReal hsum
  have hexc := arith_tsum_latEnvelope_indicator_le (m := m) hL hδ hE
  calc ∑' h, ‖F h‖ₑ
      ≤ ∑' h, (ENNReal.ofReal (K * ε) * ENNReal.ofReal (latEnvelope (m + 1) L h) +
          ENNReal.ofReal K * (ENNReal.ofReal (latEnvelope (m + 1) L h) *
            (if h 0 ∈ E then 1 else 0))) := ENNReal.tsum_le_tsum hpt
    _ = ENNReal.ofReal (K * ε) * ∑' h, ENNReal.ofReal (latEnvelope (m + 1) L h) +
          ENNReal.ofReal K * ∑' h, ENNReal.ofReal (latEnvelope (m + 1) L h) *
            (if h 0 ∈ E then 1 else 0) := by
        rw [ENNReal.tsum_add, ENNReal.tsum_mul_left, ENNReal.tsum_mul_left]
    _ ≤ ENNReal.ofReal (K * ε) * ENNReal.ofReal (envelopeConst (m + 1)) +
          ENNReal.ofReal K * ENNReal.ofReal (envelopeConst (m + 1) * δ) := by
        gcongr
    _ = ENNReal.ofReal (K * envelopeConst (m + 1) * (ε + δ)) := by
        rw [← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul hK,
          ← ENNReal.ofReal_add (by positivity) (by positivity)]
        congr 1; ring

/-- `ℓ¹(ℤⁿ) ⊆ ℓ²(ℤⁿ)`. -/
lemma arith_memLp_two_of_summable {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) :
    MemLp f 2 Measure.count := by
  rw [memLp_two_iff_integrable_sq_norm AEStronglyMeasurable.of_discrete, integrable_count_iff]
  refine Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun z => ?_)
    (hf.mul_left (∑' z, ‖f z‖))
  rw [Real.norm_of_nonneg (by positivity), sq]
  exact mul_le_mul_of_nonneg_right (hf.le_tsum z fun _ _ => norm_nonneg _) (norm_nonneg _)

lemma enorm_arithKer (s : ℕ) (σ : (Fin n → ℤ) → ℕ × ℕ) (x y : Fin n → ℤ) :
    ‖arithKer n d Ω p s σ x y‖ₑ = ‖liftPhi n d Ω p s (latEmbed (x - y))‖ₑ := by
  rw [← ofReal_norm, ← ofReal_norm, norm_arithKer]

/-- `N_s^3 ≤ L_s` (from eq. (9.2), `eq:scalerequirements`). -/
lemma arith_liftN_pow_three_le_liftL (s : ℕ) : ((liftN s : ℕ) : ℝ) ^ 3 ≤ liftL n d Ω p s := by
  have h : liftN s ^ 3 ≤ liftL n d Ω p s := by
    refine le_trans ?_ (pow_le_liftL (n := n) (d := d) (Ω := Ω) (p := p) s)
    rw [liftN, ← pow_mul]
    exact Nat.pow_le_pow_right (by norm_num) (by nlinarith)
  exact_mod_cast h

/-- Blueprint Lemma 9.2, the linearized `ℓ²` bound: for every selection `x ↦ σ(x) = (a_x, q_x)`
of `𝓡_s`, the `TT*` kernel has column (and, by symmetry, row) sums at most `K N_s^{-c₀}`, so by
Schur's test and `TT*` (Lemma 2.5), `‖x ↦ A_{s, α_x} f(x)‖₂ ≤ (K N_s^{-c₀})^{1/2} ‖f‖₂`. -/
lemma arith_linearized_bound {m d : ℕ} (hd : 1 ≤ d) :
    ∃ K c₀ : ℝ, 0 ≤ K ∧ 0 < c₀ ∧ ∀ (Ω : EuclideanSpace ℝ (Fin (m + 1)) → ℂ) (p : ℝ) (s : ℕ),
      1 ≤ s → ∀ σ : (Fin (m + 1) → ℤ) → ℕ × ℕ, (∀ x, σ x ∈ liftRat s) →
      ∀ f : (Fin (m + 1) → ℤ) → ℂ, Summable (fun z => ‖f z‖) →
        eLpNorm (fun x => latMult (liftA (m + 1) d Ω p s (σ x).1 (σ x).2) f x) 2
            Measure.count ≤
          ENNReal.ofReal (K * ((liftN s : ℕ) : ℝ) ^ (-c₀)) ^ (1 / 2 : ℝ) *
            eLpNorm f 2 Measure.count := by
  obtain ⟨Cφ, hCφ, hφ⟩ := arith_liftPhi_bounds (m + 1)
  obtain ⟨Cp, hCp, hTT⟩ := norm_arithTT_le (m + 1)
  obtain ⟨C, c, C', hC, hc, hC', hG⟩ := exists_arithG_bound (m := m) hd
  set Cn := envelopeConst (m + 1) with hCn_def
  have hCn : 0 ≤ Cn := by unfold Cn envelopeConst; positivity
  set c₀ := min c (3 / 8) with hc₀_def
  have hc₀ : 0 < c₀ := lt_min hc (by norm_num)
  refine ⟨Cp * Cn * (C + 1 + C'), c₀, by positivity, hc₀, fun Ω p s hs σ hσ f hf => ?_⟩
  set N : ℕ := liftN s
  set L : ℝ := (liftL (m + 1) d Ω p s : ℝ)
  have hN2 : 2 ≤ N := two_le_liftN hs
  have hN1 : (1 : ℝ) ≤ N := by exact_mod_cast (by omega : 1 ≤ N)
  have hN0 : (0 : ℝ) < N := by linarith
  have hNL3 : (N : ℝ) ^ 3 ≤ L := arith_liftN_pow_three_le_liftL s
  have hNL : (N : ℝ) ≤ L := le_trans (le_self_pow₀ hN1 (by norm_num)) hNL3
  have hL1 : 1 ≤ L := hN1.trans hNL
  have hL0 : 0 < L := by linarith
  have hmem : ∀ x, N ≤ 2 * (σ x).2 ∧ (σ x).2 < N ∧ (σ x).1 < (σ x).2 ∧
      Nat.Coprime (σ x).1 (σ x).2 := fun x => mem_liftRat.1 (hσ x)
  have hq1 : ∀ x, 1 ≤ (σ x).2 := fun x => by have := (hmem x).2.2.1; omega
  set κ := arithKer (m + 1) d Ω p s σ
  rw [show (fun x => latMult (liftA (m + 1) d Ω p s (σ x).1 (σ x).2) f x) =
    fun x => ∫ y, κ x y * f y ∂Measure.count from
      funext fun x => latMult_liftA_sel_eq s σ hq1 hf x]
  set ε : ℝ := C * (N : ℝ) ^ (-c) + (N : ℝ) ^ 2 / L
  set δ : ℝ := C' * (N : ℝ) ^ (-(3 / 8 : ℝ))
  have hε : 0 ≤ ε := by positivity
  have hδ : 0 ≤ δ := by positivity
  -- column sums of the `TT*` kernel
  have hcolH : ∀ x', ∑' x, ‖∫ y, κ x y * conj (κ x' y) ∂Measure.count‖ₑ ≤
      ENNReal.ofReal (Cp * Cn * (ε + δ)) := by
    intro x'
    obtain ⟨hbN, hrN, -, hbr⟩ := hmem x'
    obtain ⟨E, hEd, hEb⟩ := hG N (σ x').1 (σ x').2 (by omega) hbN hrN.le hbr
    rw [← (Equiv.subLeft x').tsum_eq]
    refine tsum_enorm_le_of_arith_bound (m := m) (E := E) hL1 hε hδ hCp (fun R hR => ?_)
      (fun h => ∫ y, κ (x' - h) y * conj (κ x' y) ∂Measure.count) (fun h => ?_)
    · have : N ≤ R := by exact_mod_cast hNL.trans hR
      exact hEd R this
    · rw [integral_arithKer_mul_conj, sub_sub_cancel]
      obtain ⟨haN, hqN, -, -⟩ := hmem (x' - h)
      have hQN : (((σ (x' - h)).2 * (σ x').2 : ℕ) : ℝ) ≤ (N : ℝ) ^ 2 := by
        have : (σ (x' - h)).2 * (σ x').2 ≤ N ^ 2 := by
          rw [sq]; exact Nat.mul_le_mul hqN.le hrN.le
        exact_mod_cast this
      have hQL : (((σ (x' - h)).2 * (σ x').2 : ℕ) : ℝ) ≤ L := hQN.trans
        (le_trans (pow_le_pow_right₀ hN1 (by norm_num)) hNL3)
      refine (hTT d Ω p s _ _ _ _ (hq1 _) (hq1 x') hQL h).trans ?_
      have hB : 0 ≤ latEnvelope (m + 1) L h := envelope_nonneg hL0 _
      have hGb := hEb (σ (x' - h)).1 (σ (x' - h)).2 h (hq1 _)
      have hQ' : (((σ (x' - h)).2 * (σ x').2 : ℕ) : ℝ) / L ≤ (N : ℝ) ^ 2 / L :=
        div_le_div_of_nonneg_right hQN hL0.le
      refine mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left ?_ hCp) hB
      simp only [ε]
      linarith
  -- row sums, by symmetry
  have hrowH : ∀ x, ∑' x', ‖∫ y, κ x y * conj (κ x' y) ∂Measure.count‖ₑ ≤
      ENNReal.ofReal (Cp * Cn * (ε + δ)) := by
    intro x
    simp_rw [arith_enorm_integral_mul_conj_symm κ x]
    exact hcolH x
  have hκm : StronglyMeasurable (Function.uncurry κ) := (Measurable.of_discrete).stronglyMeasurable
  have hsumφ := (hφ d Ω p s).2.2
  have hrow : ∀ x, ∫⁻ y, ‖κ x y‖ₑ ∂Measure.count ≤ ENNReal.ofReal (Cφ * Cn) := by
    intro x
    rw [lintegral_count]
    simp_rw [κ, enorm_arithKer]
    exact ((Equiv.subLeft x).tsum_eq (fun w => ‖liftPhi (m + 1) d Ω p s (latEmbed w)‖ₑ)).trans_le
      hsumφ
  have hcol : ∀ y, ∫⁻ x, ‖κ x y‖ₑ ∂Measure.count ≤ ENNReal.ofReal (Cφ * Cn) := by
    intro y
    rw [lintegral_count]
    simp_rw [κ, enorm_arithKer]
    exact ((Equiv.subRight y).tsum_eq (fun w => ‖liftPhi (m + 1) d Ω p s (latEmbed w)‖ₑ)).trans_le
      hsumφ
  have hM : ∀ x y, ‖κ x y‖ ≤ Cφ := fun x y => by
    simp only [κ]; rw [norm_arithKer]; exact (hφ d Ω p s).2.1 _
  refine (band_eLpNorm_kernel_le_of_ttstar (A := ENNReal.ofReal (Cp * Cn * (ε + δ)))
    hκm ENNReal.ofReal_ne_top hrow hcol hM ?_
    (arith_memLp_two_of_summable hf)).trans ?_
  · intro v _
    rw [lintegral_count, minor_eLpNorm_two_sq]
    simp_rw [lintegral_count]
    exact minor_bilinear_schur _ _ hrowH hcolH
  · refine mul_le_mul_of_nonneg_right (ENNReal.rpow_le_rpow (ENNReal.ofReal_le_ofReal ?_)
      (by norm_num)) zero_le
    -- `ε + δ ≤ (C + 1 + C') N^{-c₀}`
    have h1 : (N : ℝ) ^ (-c) ≤ (N : ℝ) ^ (-c₀) :=
      Real.rpow_le_rpow_of_exponent_le hN1 (by simp only [c₀]; linarith [min_le_left c (3 / 8)])
    have h2 : (N : ℝ) ^ (-(3 / 8 : ℝ)) ≤ (N : ℝ) ^ (-c₀) :=
      Real.rpow_le_rpow_of_exponent_le hN1 (by simp only [c₀]; linarith [min_le_right c (3 / 8)])
    have h3 : (N : ℝ) ^ 2 / L ≤ (N : ℝ) ^ (-c₀) := by
      have e1 : (N : ℝ) ^ 2 / L ≤ (N : ℝ) ^ 2 / (N : ℝ) ^ 3 :=
        div_le_div_of_nonneg_left (by positivity) (by positivity) hNL3
      have e2 : (N : ℝ) ^ 2 / (N : ℝ) ^ 3 = (N : ℝ) ^ (-1 : ℝ) := by
        rw [Real.rpow_neg_one]; field_simp
      have e3 : (N : ℝ) ^ (-1 : ℝ) ≤ (N : ℝ) ^ (-c₀) :=
        Real.rpow_le_rpow_of_exponent_le hN1 (by
          have : c₀ ≤ 3 / 8 := min_le_right _ _
          linarith)
      linarith
    have hCpn : 0 ≤ Cp * Cn := by positivity
    calc Cp * Cn * (ε + δ) ≤ Cp * Cn * ((C + 1 + C') * (N : ℝ) ^ (-c₀)) := by
          refine mul_le_mul_of_nonneg_left ?_ hCpn
          simp only [ε, δ]
          nlinarith [mul_le_mul_of_nonneg_left h1 hC, mul_le_mul_of_nonneg_left h2 hC']
      _ = Cp * Cn * (C + 1 + C') * (N : ℝ) ^ (-c₀) := by ring

/-- `(K N_s^{-c₀})^{1/2} = √K 2^{-(c₀/2) s}`. -/
lemma arith_ofReal_mul_liftN_rpow_half {K c₀ : ℝ} (hK : 0 ≤ K) (s : ℕ) :
    ENNReal.ofReal (K * ((liftN s : ℕ) : ℝ) ^ (-c₀)) ^ (1 / 2 : ℝ) =
      ENNReal.ofReal (Real.sqrt K * (2 : ℝ) ^ (-(c₀ / 2 * s))) := by
  have h2 : ((liftN s : ℕ) : ℝ) ^ (-c₀) = (2 : ℝ) ^ (-(c₀ * s)) := by
    rw [liftN, Nat.cast_pow, Nat.cast_ofNat, ← Real.rpow_natCast, ← Real.rpow_mul (by norm_num)]
    congr 1; ring
  rw [ENNReal.ofReal_rpow_of_nonneg (by positivity) (by norm_num), h2,
    Real.mul_rpow hK (by positivity), ← Real.rpow_mul (by norm_num), Real.sqrt_eq_rpow]
  congr 2; ring_nf

/-- **Blueprint Lemma 9.2 (`lem:arithmax`), eq. (9.5) (`eq:arith2`)**, arithmetic maximal decay
in `ℓ²`: for `n ≥ 1` and `d ≥ 1` (`D = 2d`) there is `γ > 0` (depending only on `n, d`) and a
constant `C` (independent of the parameters `Ω, p` of the §9 setup) such that for every `s ≥ 1`
and every `f ∈ ℓ¹(ℤⁿ)` (in particular every finitely supported `f`),
`‖sup_{α ∈ 𝓡_s} |A_{s,α} f|‖_{ℓ²} ≤ C 2^{-γ s} ‖f‖_{ℓ²}`,
the supremum being over the finite set `𝓡_s = liftRat s` of reduced `α = a/q`,
`N_s/2 ≤ q < N_s`, and `A_{s,a/q} = liftA n d Ω p s a q`. -/
theorem arith_maximal_decay (n d : ℕ) (hn : 1 ≤ n) (hd : 1 ≤ d) :
    ∃ γ : ℝ, 0 < γ ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ),
      1 ≤ s → ∀ f : (Fin n → ℤ) → ℂ, Summable (fun z => ‖f z‖) →
        eLpNorm (fun x => (liftRat s).sup fun aq =>
            ‖latMult (liftA n d Ω p s aq.1 aq.2) f x‖ₑ) 2 Measure.count ≤
          ENNReal.ofReal (C * (2 : ℝ) ^ (-(γ * s))) * eLpNorm f 2 Measure.count := by
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  obtain ⟨K, c₀, hK, hc₀, hlin⟩ := arith_linearized_bound (m := m) hd
  refine ⟨c₀ / 2, by positivity, Real.sqrt K, Real.sqrt_nonneg _, fun Ω p s hs f hf => ?_⟩
  refine eLpNorm_finset_sup_le_of_linearization_op
    (fun (aq : ℕ × ℕ) f x => latMult (liftA (m + 1) d Ω p s aq.1 aq.2) f x) f (liftRat s)
    (fun _ _ => AEStronglyMeasurable.of_discrete) _ fun σ hσ _ => ?_
  refine (hlin Ω p s hs σ hσ f hf).trans (le_of_eq ?_)
  rw [arith_ofReal_mul_liftN_rpow_half hK]

/-! #### The vector-valued estimate (9.6) -/

/-- The maximal function `sup_{α ∈ 𝓡_s} |A_{s,α} u(x)|` (real-valued). -/
noncomputable def arithSup (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ)
    (u : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) : ℝ :=
  (((liftRat s).sup fun aq => ‖latMult (liftA n d Ω p s aq.1 aq.2) u x‖₊ : ℝ≥0) : ℝ)

lemma arithSup_nonneg (s : ℕ) (u : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) :
    0 ≤ arithSup n d Ω p s u x := NNReal.coe_nonneg _

lemma enorm_arithSup (s : ℕ) (u : (Fin n → ℤ) → ℂ) (x : Fin n → ℤ) :
    ‖arithSup n d Ω p s u x‖ₑ =
      (liftRat s).sup fun aq => ‖latMult (liftA n d Ω p s aq.1 aq.2) u x‖ₑ := by
  rw [arithSup, Real.enorm_eq_ofReal (NNReal.coe_nonneg _), ENNReal.ofReal_coe_nnreal,
    ENNReal.coe_finset_sup]
  rfl

/-- A bound for a finite supremum of norms. -/
lemma arith_coe_finset_sup_nnnorm_le {α : Type*} {s : Finset α} {g : α → ℂ} {R : ℝ} (hR : 0 ≤ R)
    (h : ∀ a ∈ s, ‖g a‖ ≤ R) : ((s.sup fun a => ‖g a‖₊ : ℝ≥0) : ℝ) ≤ R := by
  have : s.sup (fun a => ‖g a‖₊) ≤ R.toNNReal := Finset.sup_le fun a ha => by
    rw [← NNReal.coe_le_coe, Real.coe_toNNReal _ hR]; exact h a ha
  exact (NNReal.coe_le_coe.2 this).trans_eq (Real.coe_toNNReal _ hR)

lemma norm_le_arithSup {s : ℕ} {aq : ℕ × ℕ} (haq : aq ∈ liftRat s) (u : (Fin n → ℤ) → ℂ)
    (x : Fin n → ℤ) : ‖latMult (liftA n d Ω p s aq.1 aq.2) u x‖ ≤ arithSup n d Ω p s u x := by
  have := Finset.le_sup (f := fun aq : ℕ × ℕ => ‖latMult (liftA n d Ω p s aq.1 aq.2) u x‖₊) haq
  exact_mod_cast this

/-- Subadditivity of the maximal function on `ℓ¹`. -/
lemma arithSup_add_le (s : ℕ) {u v : (Fin n → ℤ) → ℂ} (hu : Summable fun z => ‖u z‖)
    (hv : Summable fun z => ‖v z‖) (x : Fin n → ℤ) :
    arithSup n d Ω p s (u + v) x ≤ arithSup n d Ω p s u x + arithSup n d Ω p s v x := by
  refine arith_coe_finset_sup_nnnorm_le (add_nonneg (arithSup_nonneg s u x) (arithSup_nonneg s v x))
    fun aq haq => ?_
  have hint : IntegrableOn (liftA n d Ω p s aq.1 aq.2) (torusCube n) :=
    integrableOn_liftSym (by simpa using integrable_liftChi (n := n) (d := d) (Ω := Ω) (p := p) s)
  rw [latMult_add hint hu hv, Pi.add_apply]
  exact (norm_add_le _ _).trans (add_le_add (norm_le_arithSup haq u x) (norm_le_arithSup haq v x))

/-- Pointwise domination (Blueprint Lemma 9.1): `sup_α |A_{s,α} u(x)| ≤ ∑_w |φ_s(w)| |u(x - w)|`. -/
lemma arithSup_le_conv (s : ℕ) {u : (Fin n → ℤ) → ℂ} (hu : Summable fun z => ‖u z‖)
    (x : Fin n → ℤ) :
    arithSup n d Ω p s u x ≤ ∑' w, ‖liftPhi n d Ω p s (latEmbed w)‖ * ‖u (x - w)‖ := by
  obtain ⟨C, hC, hb⟩ := arith_liftPhi_bounds n
  have hs : Summable fun w => ‖liftPhi n d Ω p s (latEmbed w)‖ * ‖u (x - w)‖ := by
    refine Summable.of_nonneg_of_le (fun _ => by positivity) (fun w => ?_)
      ((hu.comp_injective (Equiv.subLeft x).injective).mul_left C)
    exact mul_le_mul_of_nonneg_right ((hb d Ω p s).2.1 w) (norm_nonneg _)
  refine arith_coe_finset_sup_nnnorm_le (tsum_nonneg fun _ => by positivity) fun aq haq => ?_
  have hq : 1 ≤ aq.2 := one_le_of_mem_liftRat (a := aq.1) (by simpa using haq)
  rw [arith_latMult_liftA_eq s aq.1 hq hu x]
  have hs' : Summable fun y => ‖eC ((aq.1 : ℝ) / aq.2 * (radialPolyZ n d (x - y) : ℝ)) *
      liftPhi n d Ω p s (latEmbed (x - y)) * u y‖ := by
    have := hs.comp_injective (Equiv.subLeft x).injective
    refine this.congr fun y => ?_
    simp [norm_eC]
  refine (norm_tsum_le_tsum_norm hs').trans (le_of_eq ?_)
  rw [← (Equiv.subLeft x).tsum_eq]
  refine tsum_congr fun w => ?_
  simp [norm_eC]

/-- `(∑_ν sup_{α ∈ 𝓡_s} |A_{s,α} g_ν(x)|²)^{1/2}` for an `ℓ²`-valued input `g = (g_ν)_ν`. -/
noncomputable def arithVec {ι : Type*} [Fintype ι] (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ)
    (p : ℝ) (s : ℕ) (g : (Fin n → ℤ) → EuclideanSpace ℂ ι) (x : Fin n → ℤ) : ℝ :=
  Real.sqrt (∑ ν, arithSup n d Ω p s (fun y => g y ν) x ^ 2)

section Vector

variable {ι : Type*} [Fintype ι]

lemma arith_norm_toLp_le_of_le {u v : ι → ℝ} (h0 : ∀ i, 0 ≤ u i) (h : ∀ i, u i ≤ v i) :
    ‖(WithLp.toLp 2 u : EuclideanSpace ℝ ι)‖ ≤ ‖(WithLp.toLp 2 v : EuclideanSpace ℝ ι)‖ := by
  rw [EuclideanSpace.norm_eq, EuclideanSpace.norm_eq]
  refine Real.sqrt_le_sqrt (Finset.sum_le_sum fun i _ => ?_)
  simp only [Real.norm_eq_abs, sq_abs]
  exact pow_le_pow_left₀ (h0 i) (h i) 2

lemma arithVec_eq_norm (s : ℕ) (g : (Fin n → ℤ) → EuclideanSpace ℂ ι) (x : Fin n → ℤ) :
    arithVec n d Ω p s g x =
      ‖(WithLp.toLp 2 fun ν => arithSup n d Ω p s (fun y => g y ν) x : EuclideanSpace ℝ ι)‖ := by
  rw [EuclideanSpace.norm_eq, arithVec]
  simp only [Real.norm_eq_abs, sq_abs]

lemma arithVec_nonneg (s : ℕ) (g : (Fin n → ℤ) → EuclideanSpace ℂ ι) (x : Fin n → ℤ) :
    0 ≤ arithVec n d Ω p s g x := Real.sqrt_nonneg _

lemma arith_summable_coord {g : (Fin n → ℤ) → EuclideanSpace ℂ ι} (hg : Summable fun x => ‖g x‖)
    (ν : ι) : Summable fun x => ‖g x ν‖ :=
  Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun x => PiLp.norm_apply_le (g x) ν) hg

lemma arithVec_add_le (s : ℕ) {g h : (Fin n → ℤ) → EuclideanSpace ℂ ι}
    (hg : Summable fun x => ‖g x‖) (hh : Summable fun x => ‖h x‖) (x : Fin n → ℤ) :
    arithVec n d Ω p s (g + h) x ≤ arithVec n d Ω p s g x + arithVec n d Ω p s h x := by
  rw [arithVec_eq_norm, arithVec_eq_norm, arithVec_eq_norm]
  have e : ∀ ν, (fun y => (g + h) y ν) = (fun y => g y ν) + (fun y => h y ν) := fun ν => by
    funext y; simp
  refine (arith_norm_toLp_le_of_le (fun ν => arithSup_nonneg _ _ _) (fun ν => ?_)).trans
    ((le_of_eq (congrArg norm (WithLp.toLp_add 2 _ _))).trans (norm_add_le _ _))
  rw [e ν]
  exact arithSup_add_le s (arith_summable_coord hg ν) (arith_summable_coord hh ν) x

/-- Minkowski and Blueprint Lemma 9.1: `(∑_ν sup_α |A_{s,α} g_ν(x)|²)^{1/2} ≤ (|φ_s| * |g|)(x)`. -/
lemma arithVec_le_conv (s : ℕ) {g : (Fin n → ℤ) → EuclideanSpace ℂ ι}
    (hg : Summable fun x => ‖g x‖) (x : Fin n → ℤ) :
    arithVec n d Ω p s g x ≤ ∑' w, ‖liftPhi n d Ω p s (latEmbed w)‖ * ‖g (x - w)‖ := by
  obtain ⟨C, hC, hb⟩ := arith_liftPhi_bounds n
  set a : (Fin n → ℤ) → ℝ := fun w => ‖liftPhi n d Ω p s (latEmbed w)‖
  set V : (Fin n → ℤ) → EuclideanSpace ℝ ι := fun w =>
    a w • (WithLp.toLp 2 fun ν => ‖g (x - w) ν‖ : EuclideanSpace ℝ ι)
  have hnormV : ∀ w, ‖V w‖ = a w * ‖g (x - w)‖ := by
    intro w
    simp only [V, norm_smul, Real.norm_of_nonneg (norm_nonneg _), a]
    congr 1
    rw [EuclideanSpace.norm_eq, EuclideanSpace.norm_eq]
    simp only [norm_norm]
  have hsV : Summable fun w => ‖V w‖ := by
    simp_rw [hnormV]
    refine Summable.of_nonneg_of_le (fun _ => by positivity) (fun w => ?_)
      ((hg.comp_injective (Equiv.subLeft x).injective).mul_left C)
    exact mul_le_mul_of_nonneg_right ((hb d Ω p s).2.1 w) (norm_nonneg _)
  have hV : Summable V := hsV.of_norm
  set W := ∑' w, V w
  have hcoord : ∀ ν, W ν = ∑' w, a w * ‖g (x - w) ν‖ := by
    intro ν
    have := (EuclideanSpace.proj ν : EuclideanSpace ℝ ι →L[ℝ] ℝ).map_tsum hV
    simpa [V, W] using this
  rw [arithVec_eq_norm]
  calc ‖(WithLp.toLp 2 fun ν => arithSup n d Ω p s (fun y => g y ν) x : EuclideanSpace ℝ ι)‖
      ≤ ‖(WithLp.toLp 2 (WithLp.ofLp W) : EuclideanSpace ℝ ι)‖ := by
        refine arith_norm_toLp_le_of_le (fun ν => arithSup_nonneg _ _ _) fun ν => ?_
        refine (arithSup_le_conv s (arith_summable_coord hg ν) x).trans (le_of_eq ?_)
        rw [← hcoord ν]
    _ = ‖W‖ := by rw [WithLp.toLp_ofLp]
    _ ≤ ∑' w, ‖V w‖ := norm_tsum_le_tsum_norm hsV
    _ = ∑' w, ‖liftPhi n d Ω p s (latEmbed w)‖ * ‖g (x - w)‖ := tsum_congr hnormV

/-- `∑_w |φ_s(w)| ≤ C C_n` (real form). -/
lemma arith_tsum_norm_liftPhi_le (n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ),
      ∑' w : Fin n → ℤ, ‖liftPhi n d Ω p s (latEmbed w)‖ ≤ C * envelopeConst n := by
  obtain ⟨C, hC, hb⟩ := arith_liftPhi_bounds n
  refine ⟨C, hC, fun d Ω p s => ?_⟩
  have hL1 : (1 : ℝ) ≤ liftL n d Ω p s := by
    unfold liftL; exact_mod_cast Nat.one_le_two_pow
  obtain ⟨hs, hsum⟩ := summable_latEnvelope_and_tsum_le (n := n) hL1
  calc ∑' w : Fin n → ℤ, ‖liftPhi n d Ω p s (latEmbed w)‖
      ≤ ∑' w, C * latEnvelope n (liftL n d Ω p s) w :=
        (arith_summable_norm_liftPhi s).tsum_le_tsum (hb d Ω p s).1 (hs.mul_left C)
    _ ≤ C * envelopeConst n := by rw [tsum_mul_left]; exact mul_le_mul_of_nonneg_left hsum hC

/-- The endpoint bounds (`ℓ^r`, `1 ≤ r ≤ ∞`, by Young's inequality): for `g ∈ ℓ¹(ℤⁿ; ℓ²)`,
`‖(∑_ν sup_α |A_{s,α} g_ν|²)^{1/2}‖_r ≤ C ‖g‖_r`, `C` independent of `s`. -/
lemma eLpNorm_arithVec_le_young (n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ) {r : ℝ≥0∞},
      1 ≤ r → ∀ {ι : Type*} [Fintype ι] (g : (Fin n → ℤ) → EuclideanSpace ℂ ι),
      Summable (fun x => ‖g x‖) →
        eLpNorm (arithVec n d Ω p s g) r Measure.count ≤
          ENNReal.ofReal C * eLpNorm g r Measure.count := by
  obtain ⟨C, hC, hb⟩ := arith_liftPhi_bounds n
  refine ⟨C * envelopeConst n, by unfold envelopeConst; positivity,
    fun d Ω p s r hr ι _ g hg => ?_⟩
  set G : (Fin n → ℤ) → ℂ := fun x => ((‖g x‖ : ℝ) : ℂ)
  set k : (Fin n → ℤ) → ℂ := fun w => liftPhi n d Ω p s (latEmbed w)
  have hGe : ∀ y, ‖G y‖ₑ = ‖g y‖ₑ := fun y => by
    rw [← ofReal_norm, ← ofReal_norm]; simp [G]
  have hpt : ∀ x, ‖arithVec n d Ω p s g x‖ₑ ≤ ‖∑' w, ‖k w‖ₑ * ‖G (x - w)‖ₑ‖ₑ := by
    intro x
    rw [enorm_eq_self, Real.enorm_eq_ofReal (arithVec_nonneg s g x)]
    have hs : Summable fun w => ‖liftPhi n d Ω p s (latEmbed w)‖ * ‖g (x - w)‖ := by
      refine Summable.of_nonneg_of_le (fun _ => by positivity) (fun w => ?_)
        ((hg.comp_injective (Equiv.subLeft x).injective).mul_left C)
      exact mul_le_mul_of_nonneg_right ((hb d Ω p s).2.1 w) (norm_nonneg _)
    refine (ENNReal.ofReal_le_ofReal (arithVec_le_conv s hg x)).trans (le_of_eq ?_)
    rw [ENNReal.ofReal_tsum_of_nonneg (fun _ => by positivity) hs]
    refine tsum_congr fun w => ?_
    rw [ENNReal.ofReal_mul (norm_nonneg _), ofReal_norm, ofReal_norm]
    rw [hGe]
  refine (eLpNorm_mono_enorm AEStronglyMeasurable.of_discrete hpt).trans
    ((eLpNorm_tsum_enorm_mul_sub_le hr k G).trans ?_)
  have hk : eLpNorm k 1 Measure.count ≤ ENNReal.ofReal (C * envelopeConst n) := by
    rw [eLpNorm_one_eq_lintegral_enorm AEStronglyMeasurable.of_discrete, lintegral_count]
    exact (hb d Ω p s).2.2
  have hG : eLpNorm G r Measure.count = eLpNorm g r Measure.count :=
    eLpNorm_congr_enorm_ae AEStronglyMeasurable.of_discrete AEStronglyMeasurable.of_discrete
      (ae_of_all _ hGe)
  rw [hG]
  gcongr

/-- The `ℓ^∞` endpoint: `|g| ≤ S` implies `(∑_ν sup_α |A_{s,α} g_ν|²)^{1/2} ≤ C S`. -/
lemma arithVec_le_of_norm_le (n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ)
      {ι : Type*} [Fintype ι] (g : (Fin n → ℤ) → EuclideanSpace ℂ ι),
      Summable (fun x => ‖g x‖) → ∀ S : ℝ, (∀ x, ‖g x‖ ≤ S) → ∀ x,
        arithVec n d Ω p s g x ≤ C * S := by
  obtain ⟨C, hC, hb⟩ := arith_liftPhi_bounds n
  obtain ⟨C₁, hC₁, hsum⟩ := arith_tsum_norm_liftPhi_le n
  refine ⟨C₁ * envelopeConst n, by unfold envelopeConst; positivity,
    fun d Ω p s ι _ g hg S hS x => ?_⟩
  have hS0 : 0 ≤ S := (norm_nonneg _).trans (hS 0)
  have hs1 : Summable fun w => ‖liftPhi n d Ω p s (latEmbed w)‖ * ‖g (x - w)‖ := by
    refine Summable.of_nonneg_of_le (fun _ => by positivity) (fun w => ?_)
      ((hg.comp_injective (Equiv.subLeft x).injective).mul_left C)
    exact mul_le_mul_of_nonneg_right ((hb d Ω p s).2.1 w) (norm_nonneg _)
  refine (arithVec_le_conv s hg x).trans ?_
  calc ∑' w, ‖liftPhi n d Ω p s (latEmbed w)‖ * ‖g (x - w)‖
      ≤ ∑' w, ‖liftPhi n d Ω p s (latEmbed w)‖ * S :=
        hs1.tsum_le_tsum (fun w => mul_le_mul_of_nonneg_left (hS _) (norm_nonneg _))
          ((arith_summable_norm_liftPhi s).mul_right S)
    _ = (∑' w, ‖liftPhi n d Ω p s (latEmbed w)‖) * S := tsum_mul_right
    _ ≤ C₁ * envelopeConst n * S := mul_le_mul_of_nonneg_right (hsum d Ω p s) hS0

/-- `‖v‖₂² = ∑_x |v x|²` for counting measure (any normed codomain). -/
lemma arith_eLpNorm_two_sq_eq_tsum {α E : Type*} [MeasurableSpace α] [MeasurableSingletonClass α]
    [Countable α] [NormedAddCommGroup E] (v : α → E) :
    eLpNorm v 2 Measure.count ^ 2 = ∑' x, ‖v x‖ₑ ^ 2 := by
  have := eLpNorm_two_rpow_two (ν := Measure.count) (AEStronglyMeasurable.of_discrete (f := v))
  rw [lintegral_count] at this
  rw [← ENNReal.rpow_natCast, Nat.cast_ofNat, this]
  simp_rw [← ENNReal.rpow_natCast, Nat.cast_ofNat]

lemma arith_enorm_sq_euclidean {𝕜 : Type*} [RCLike 𝕜] (u : EuclideanSpace 𝕜 ι) :
    ‖u‖ₑ ^ 2 = ∑ ν, ‖u ν‖ₑ ^ 2 := by
  rw [← ofReal_norm, EuclideanSpace.norm_eq, ← ENNReal.ofReal_pow (Real.sqrt_nonneg _),
    Real.sq_sqrt (Finset.sum_nonneg fun _ _ => by positivity),
    ENNReal.ofReal_sum_of_nonneg fun _ _ => by positivity]
  refine Finset.sum_congr rfl fun ν _ => ?_
  rw [ENNReal.ofReal_pow (norm_nonneg _), ofReal_norm]

lemma enorm_arithVec_sq (s : ℕ) (g : (Fin n → ℤ) → EuclideanSpace ℂ ι) (x : Fin n → ℤ) :
    ‖arithVec n d Ω p s g x‖ₑ ^ 2 = ∑ ν, ‖arithSup n d Ω p s (fun y => g y ν) x‖ₑ ^ 2 := by
  rw [Real.enorm_eq_ofReal (arithVec_nonneg s g x), arithVec_eq_norm, ofReal_norm,
    arith_enorm_sq_euclidean]

/-- The `ℓ²` case of eq. (9.6): the square function of the maximal functions is bounded on
`ℓ²(ℤⁿ; ℓ²)` with the constant of the scalar bound (9.5) (square and sum over `ν`). -/
lemma eLpNorm_arithVec_two_le {B : ℝ} (s : ℕ)
    (h2 : ∀ u : (Fin n → ℤ) → ℂ, Summable (fun z => ‖u z‖) →
      eLpNorm (fun x => (liftRat s).sup fun aq =>
        ‖latMult (liftA n d Ω p s aq.1 aq.2) u x‖ₑ) 2 Measure.count ≤
          ENNReal.ofReal B * eLpNorm u 2 Measure.count)
    (g : (Fin n → ℤ) → EuclideanSpace ℂ ι) (hg : Summable fun x => ‖g x‖) :
    eLpNorm (arithVec n d Ω p s g) 2 Measure.count ≤
      ENNReal.ofReal B * eLpNorm g 2 Measure.count := by
  have key : eLpNorm (arithVec n d Ω p s g) 2 Measure.count ^ 2 ≤
      1 * (ENNReal.ofReal B * eLpNorm g 2 Measure.count) ^ 2 := by
    rw [one_mul, arith_eLpNorm_two_sq_eq_tsum, mul_pow, arith_eLpNorm_two_sq_eq_tsum]
    simp_rw [enorm_arithVec_sq, arith_enorm_sq_euclidean]
    rw [Summable.tsum_finsetSum (fun _ _ => ENNReal.summable),
      Summable.tsum_finsetSum (fun _ _ => ENNReal.summable), Finset.mul_sum]
    refine Finset.sum_le_sum fun ν _ => ?_
    have h := h2 (fun y => g y ν) (arith_summable_coord hg ν)
    have e1 : eLpNorm (arithSup n d Ω p s (fun y => g y ν)) 2 Measure.count =
        eLpNorm (fun x => (liftRat s).sup fun aq =>
          ‖latMult (liftA n d Ω p s aq.1 aq.2) (fun y => g y ν) x‖ₑ) 2 Measure.count := by
      rw [← eLpNorm_enorm _ AEStronglyMeasurable.of_discrete]
      simp_rw [enorm_arithSup]
    rw [← arith_eLpNorm_two_sq_eq_tsum (arithSup n d Ω p s (fun y => g y ν)),
      ← arith_eLpNorm_two_sq_eq_tsum (fun y => g y ν), e1, ← mul_pow]
    gcongr
  have := band_le_of_sq_le key
  rwa [ENNReal.one_rpow, one_mul] at this

end Vector

/-- The inputs `g ∈ ℓ¹(ℤⁿ; ℓ²)` form a truncation-closed class. -/
lemma arith_isTruncationClosed_summable {ι : Type*} [Fintype ι] :
    IsTruncationClosed {g : (Fin n → ℤ) → EuclideanSpace ℂ ι | Summable fun x => ‖g x‖} := by
  intro g hg s _
  have hg' : Summable fun x => ‖g x‖ := hg
  refine ⟨?_, ?_⟩
  · exact Summable.of_nonneg_of_le (fun _ => norm_nonneg _)
      (fun x => norm_indicator_le_norm_self _ _) hg'
  · exact Summable.of_nonneg_of_le (fun _ => norm_nonneg _)
      (fun x => norm_indicator_le_norm_self _ _) hg'

/-- Marcinkiewicz interpolation (Blueprint Lemma 2.3) of the uniform `ℓ¹` and `ℓ^∞` endpoint
bounds of `g ↦ (∑_ν sup_α |A_{s,α} g_ν|²)^{1/2}` with an `ℓ²` bound `B` (for `ℓ²`-valued inputs):
for `1 < t < ∞`, `‖·‖_t ≤ K B^{a_t} ‖g‖_t`, `a_t = min(2/t, 2/t')`, with `K` independent of `s`,
`B`, the index set and `g`. -/
theorem arithVec_lp_of_l2 (n : ℕ) {t : ℝ} (ht : 1 < t) :
    ∃ K : ℝ≥0∞, K ≠ ⊤ ∧ ∀ (d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ)
      {ι : Type*} [Fintype ι] (B : ℝ≥0),
      (∀ u : (Fin n → ℤ) → ℂ, Summable (fun z => ‖u z‖) →
        eLpNorm (fun x => (liftRat s).sup fun aq =>
          ‖latMult (liftA n d Ω p s aq.1 aq.2) u x‖ₑ) 2 Measure.count ≤
            ENNReal.ofReal B * eLpNorm u 2 Measure.count) →
      ∀ g : (Fin n → ℤ) → EuclideanSpace ℂ ι, Summable (fun x => ‖g x‖) →
        eLpNorm (arithVec n d Ω p s g) (ENNReal.ofReal t) Measure.count ≤
          K * (B : ℝ≥0∞) ^ paramA t * eLpNorm g (ENNReal.ofReal t) Measure.count := by
  obtain ⟨A₁, hA₁, hyoung⟩ := eLpNorm_arithVec_le_young n
  obtain ⟨A₂, hA₂, hinfty⟩ := arithVec_le_of_norm_le n
  set A : ℝ≥0 := (max (max A₁ A₂) 1).toNNReal
  have hA : (A : ℝ≥0∞) = ENNReal.ofReal (max (max A₁ A₂) 1) := rfl
  have hApos : 0 < A := Real.toNNReal_pos.2 (lt_of_lt_of_le one_pos (le_max_right _ _))
  -- the common hypotheses
  have hsub : ∀ d Ω p s (ι : Type _) [Fintype ι], IsSublinearOn (arithVec (ι := ι) n d Ω p s)
      {g | Summable fun x => ‖g x‖} Measure.count := by
    intro d Ω p s ι _ f hf g hg
    refine ae_of_all _ fun x => ?_
    rw [Real.norm_of_nonneg (arithVec_nonneg s _ x), Real.norm_of_nonneg (arithVec_nonneg s _ x),
      Real.norm_of_nonneg (arithVec_nonneg s _ x)]
    exact arithVec_add_le s hf hg x
  have hone : ∀ d Ω p s (ι : Type _) [Fintype ι], HasStrongTypeOn (arithVec (ι := ι) n d Ω p s)
      {g | Summable fun x => ‖g x‖} 1 A Measure.count Measure.count := by
    intro d Ω p s ι _ g hg
    rw [ENNReal.ofReal_one]
    refine (hyoung d Ω p s le_rfl g hg).trans ?_
    rw [hA]; gcongr; exact (le_max_left _ _).trans (le_max_left _ _)
  have hinf : ∀ d Ω p s (ι : Type _) [Fintype ι], HasLinftyBoundOn (arithVec (ι := ι) n d Ω p s)
      {g | Summable fun x => ‖g x‖} A Measure.count := by
    intro d Ω p s ι _ g hg S hS
    refine ae_of_all _ fun x => ?_
    have hS0 : 0 ≤ S := (norm_nonneg _).trans (hS 0)
    rw [Real.norm_of_nonneg (arithVec_nonneg s _ x), Real.coe_toNNReal _ (by positivity)]
    exact (hinfty d Ω p s g hg S hS x).trans
      (mul_le_mul_of_nonneg_right ((le_max_right _ _).trans (le_max_left _ _)) hS0)
  have htwo : ∀ d Ω p s (ι : Type _) [Fintype ι] (B : ℝ≥0),
      (∀ u : (Fin n → ℤ) → ℂ, Summable (fun z => ‖u z‖) →
        eLpNorm (fun x => (liftRat s).sup fun aq =>
          ‖latMult (liftA n d Ω p s aq.1 aq.2) u x‖ₑ) 2 Measure.count ≤
            ENNReal.ofReal B * eLpNorm u 2 Measure.count) →
      HasStrongTypeOn (arithVec (ι := ι) n d Ω p s) {g | Summable fun x => ‖g x‖} 2 B
        Measure.count Measure.count := by
    intro d Ω p s ι _ B h g hg
    rw [ENNReal.ofReal_ofNat, ← ENNReal.ofReal_coe_nnreal]
    exact eLpNorm_arithVec_two_le s h g hg
  rcases lt_trichotomy t 2 with ht2 | rfl | ht2
  · -- `1 < t < 2`: interpolate between `(1,1)` and `(2,2)`, `θ = 2 - 2/t`
    set θ : ℝ := 2 - 2 / t
    have hθ : 1 / t = (1 - θ) / 1 + θ / 2 := by simp only [θ]; field_simp; ring
    have h1θ : 0 ≤ 1 - θ := by
      have : 1 ≤ 2 / t := by rw [le_div_iff₀ (by linarith)]; linarith
      simp only [θ]; linarith
    refine ⟨(marcinkiewiczConst 1 2 t : ℝ≥0∞) * (A : ℝ≥0∞) ^ (1 - θ),
      ENNReal.mul_ne_top ENNReal.coe_ne_top (ENNReal.rpow_ne_top_of_nonneg h1θ ENNReal.coe_ne_top),
      fun d Ω p s ι _ B h g hg => ?_⟩
    rw [paramA_eq_of_le_two ht ht2.le]
    refine (eLpNorm_le_of_hasWeakTypeOn one_pos ht ht2 hθ
      ((hone d Ω p s ι).hasWeakTypeOn one_pos) ((htwo d Ω p s ι B h).hasWeakTypeOn two_pos)
      (hsub d Ω p s ι) arith_isTruncationClosed_summable hg AEStronglyMeasurable.of_discrete
      AEStronglyMeasurable.of_discrete).trans (le_of_eq ?_)
    ring
  · -- `t = 2`
    refine ⟨1, ENNReal.one_ne_top, fun d Ω p s ι _ B h g hg => ?_⟩
    rw [paramA_eq_of_two_le ht le_rfl, div_self two_ne_zero, ENNReal.rpow_one, one_mul]
    exact htwo d Ω p s ι B h g hg
  · -- `2 < t < ∞`: interpolate between `(2,2)` and `(∞,∞)`
    have h1 : 0 ≤ 1 - 2 / t := by rw [sub_nonneg, div_le_one (by linarith)]; linarith
    refine ⟨(marcinkiewiczConstTop 2 t : ℝ≥0∞) * (A : ℝ≥0∞) ^ (1 - 2 / t),
      ENNReal.mul_ne_top ENNReal.coe_ne_top (ENNReal.rpow_ne_top_of_nonneg h1 ENNReal.coe_ne_top),
      fun d Ω p s ι _ B h g hg => ?_⟩
    rw [paramA_eq_of_two_le ht ht2.le]
    calc eLpNorm (arithVec n d Ω p s g) (ENNReal.ofReal t) Measure.count
        ≤ (marcinkiewiczConstTop 2 t : ℝ≥0∞) * (B : ℝ≥0∞) ^ (2 / t) * (A : ℝ≥0∞) ^ (1 - 2 / t) *
            eLpNorm g (ENNReal.ofReal t) Measure.count :=
          eLpNorm_le_of_hasWeakTypeOn_of_linfty two_pos ht2
            ((htwo d Ω p s ι B h).hasWeakTypeOn two_pos) (hinf d Ω p s ι) (hsub d Ω p s ι)
            arith_isTruncationClosed_summable hg AEStronglyMeasurable.of_discrete
            AEStronglyMeasurable.of_discrete (Or.inl hApos)
      _ = _ := by ring

/-- **Blueprint Lemma 9.2 (`lem:arithmax`), eq. (9.6) (`eq:arithvector`)**, the vector-valued
arithmetic maximal decay: for `n ≥ 1`, `d ≥ 1` and `1 < t < ∞` there are `δ_t > 0` and `C_t`
(independent of `Ω, p`, of `s` and of the list) such that for every `s ≥ 1` and every finite
list `(f_ν)_{ν ∈ F}` of functions in `ℓ¹(ℤⁿ)` (e.g. finitely supported),
`‖(∑_ν sup_{α ∈ 𝓡_s} |A_{s,α} f_ν|²)^{1/2}‖_{ℓ^t} ≤ C_t 2^{-δ_t s} ‖(∑_ν |f_ν|²)^{1/2}‖_{ℓ^t}`.
One may take `δ_t = γ min(2/t, 2/t')` (`γ` from eq. (9.5), `arith_maximal_decay`). -/
theorem arith_maximal_decay_vector (n d : ℕ) (hn : 1 ≤ n) (hd : 1 ≤ d) {t : ℝ} (ht : 1 < t) :
    ∃ δ : ℝ, 0 < δ ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ),
      1 ≤ s → ∀ {ι : Type*} (F : Finset ι) (f : ι → (Fin n → ℤ) → ℂ),
        (∀ ν ∈ F, Summable fun z => ‖f ν z‖) →
        eLpNorm (fun x => Real.sqrt (∑ ν ∈ F,
            ((((liftRat s).sup fun aq =>
              ‖latMult (liftA n d Ω p s aq.1 aq.2) (f ν) x‖₊ : ℝ≥0) : ℝ) ^ 2)))
            (ENNReal.ofReal t) Measure.count ≤
          ENNReal.ofReal (C * (2 : ℝ) ^ (-(δ * s))) *
            eLpNorm (fun x => Real.sqrt (∑ ν ∈ F, ‖f ν x‖ ^ 2)) (ENNReal.ofReal t)
              Measure.count := by
  obtain ⟨γ, hγ, C₂, hC₂, h95⟩ := arith_maximal_decay n d hn hd
  obtain ⟨K, hK, hint⟩ := arithVec_lp_of_l2 n ht
  set θ := paramA t
  have hθ : 0 < θ := paramA_pos ht
  refine ⟨γ * θ, by positivity, K.toReal * C₂ ^ θ, by positivity,
    fun Ω p s hs ι F f hf => ?_⟩
  set g : (Fin n → ℤ) → EuclideanSpace ℂ F := fun x => WithLp.toLp 2 fun ν => f ν x
  have hgnorm : ∀ x, ‖g x‖ = Real.sqrt (∑ ν ∈ F, ‖f ν x‖ ^ 2) := by
    intro x
    rw [EuclideanSpace.norm_eq]
    simp only [g]
    rw [Finset.sum_coe_sort F (fun ν => ‖f ν x‖ ^ 2)]
  have hg : Summable fun x => ‖g x‖ := by
    refine Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun x => ?_)
      (summable_sum fun ν hν => hf ν hν)
    rw [hgnorm]
    refine Real.sqrt_le_iff.2 ⟨Finset.sum_nonneg fun _ _ => norm_nonneg _, ?_⟩
    exact Finset.sum_sq_le_sq_sum_of_nonneg fun _ _ => norm_nonneg _
  set B : ℝ := C₂ * (2 : ℝ) ^ (-(γ * s))
  have hB : 0 ≤ B := by positivity
  have h2 : ∀ u : (Fin n → ℤ) → ℂ, Summable (fun z => ‖u z‖) →
      eLpNorm (fun x => (liftRat s).sup fun aq =>
        ‖latMult (liftA n d Ω p s aq.1 aq.2) u x‖ₑ) 2 Measure.count ≤
          ENNReal.ofReal (B.toNNReal : ℝ) * eLpNorm u 2 Measure.count := by
    intro u hu
    rw [Real.coe_toNNReal _ hB]
    exact h95 Ω p s hs u hu
  have hmain := hint d Ω p s B.toNNReal h2 g hg
  have hL : (fun x => Real.sqrt (∑ ν ∈ F,
      ((((liftRat s).sup fun aq =>
        ‖latMult (liftA n d Ω p s aq.1 aq.2) (f ν) x‖₊ : ℝ≥0) : ℝ) ^ 2))) =
      arithVec n d Ω p s g := by
    funext x
    rw [arithVec, ← Finset.sum_coe_sort F]
    rfl
  have hR : eLpNorm g (ENNReal.ofReal t) Measure.count =
      eLpNorm (fun x => Real.sqrt (∑ ν ∈ F, ‖f ν x‖ ^ 2)) (ENNReal.ofReal t) Measure.count :=
    eLpNorm_congr_norm_ae AEStronglyMeasurable.of_discrete AEStronglyMeasurable.of_discrete
      (ae_of_all _ fun x => by
      rw [hgnorm, Real.norm_of_nonneg (Real.sqrt_nonneg _)])
  rw [hL, ← hR]
  refine hmain.trans (le_of_eq ?_)
  congr 1
  show K * ENNReal.ofReal B ^ θ = _
  rw [ENNReal.ofReal_rpow_of_nonneg hB hθ.le, ← ENNReal.ofReal_toReal hK,
    ← ENNReal.ofReal_mul ENNReal.toReal_nonneg, ENNReal.ofReal_toReal hK]
  congr 1
  simp only [B]
  rw [Real.mul_rpow hC₂ (by positivity), ← Real.rpow_mul (by norm_num), mul_assoc]
  congr 3; ring


end ArithMax

/-! ### Blueprint Lemma 9.3 (`lem:liftsquare`): the factorization (9.8) -/

/-- `L_s ≥ 8`. -/
lemma eight_le_liftL (s : ℕ) : (8 : ℝ) ≤ liftL n d Ω p s := by
  have h := pow_le_liftL (n := n) (d := d) (Ω := Ω) (p := p) s
  have h3 : 3 ≤ 100 * (n + 2 * d + 1) * (s + 1) := by nlinarith
  have : (2 : ℕ) ^ 3 ≤ liftL n d Ω p s := (Nat.pow_le_pow_right (by norm_num) h3).trans h
  exact_mod_cast this

/-- `χ_s ≠ 0` forces `χ̃_s ≠ 0` (from `χ_s χ̃_s = χ_s`). -/
lemma liftChiT_ne_zero_of_liftChi_ne_zero {s : ℕ} {η : EuclideanSpace ℝ (Fin n)}
    (h : liftChi n d Ω p s η ≠ 0) : liftChiT n d Ω p s η ≠ 0 := by
  intro h0
  apply h
  rw [← liftChi_mul_liftChiT s η, h0, mul_zero]

/-- The box bound `|ηᵢ| ≤ 2 (1/L_s)` on the support of `χ̃_s`. -/
lemma abs_le_of_liftChiT_ne_zero {s : ℕ} {η : EuclideanSpace ℝ (Fin n)}
    (h : liftChiT n d Ω p s η ≠ 0) (i : Fin n) :
    |η i| ≤ 2 * (1 / (liftL n d Ω p s : ℝ)) := by
  have := support_liftChiT (n := n) (d := d) (Ω := Ω) (p := p) s h i
  rw [mul_one_div]; exact this

/-- At most one lattice translate of `χ̃_s` is nonzero at any point. -/
lemma liftChiT_translate_unique {s : ℕ} {ζ : EuclideanSpace ℝ (Fin n)} {z z' : Fin n → ℤ}
    (hz : liftChiT n d Ω p s (ζ - latEmbed z) ≠ 0)
    (hz' : liftChiT n d Ω p s (ζ - latEmbed z') ≠ 0) : z = z' := by
  have hL := eight_le_liftL (n := n) (d := d) (Ω := Ω) (p := p) s
  have hε4 : 4 * (1 / (liftL n d Ω p s : ℝ)) < 1 := by
    rw [mul_one_div, div_lt_one (by linarith)]; linarith
  refine periodize_atMostOne (m := fun η => (liftChiT n d Ω p s η : ℂ))
    (ε := 1 / (liftL n d Ω p s : ℝ))
    (fun η hη => abs_le_of_liftChiT_ne_zero (by exact_mod_cast hη)) hε4 ζ z z'
    (by exact_mod_cast hz) (by exact_mod_cast hz')

/-- At any point at most one center `β ∈ 𝒰_{N_s}` and one translate `z` have
`χ̃_s(ξ - β - z) ≠ 0` (`s ≥ 1`). -/
lemma liftChiT_center_unique {s : ℕ} (hs : 1 ≤ s)
    {γ γ' : Fin n → ZMod (blockProd (goodBlocks (paramRho n d Ω p) (liftN s)))}
    (hγ : γ ∈ paramGoodSet n d Ω p (liftN s)) (hγ' : γ' ∈ paramGoodSet n d Ω p (liftN s))
    {ξ : EuclideanSpace ℝ (Fin n)} {z z' : Fin n → ℤ}
    (h : liftChiT n d Ω p s
      (ξ - ratPt (blockProd (goodBlocks (paramRho n d Ω p) (liftN s))) γ - latEmbed z) ≠ 0)
    (h' : liftChiT n d Ω p s
      (ξ - ratPt (blockProd (goodBlocks (paramRho n d Ω p) (liftN s))) γ' - latEmbed z') ≠ 0) :
    γ = γ' ∧ z = z' := by
  have hL := liftL_pos (n := n) (d := d) (Ω := Ω) (p := p) s
  have hb : ∀ {η : EuclideanSpace ℝ (Fin n)}, liftChiT n d Ω p s η ≠ 0 → ∀ i,
      |η i| ≤ 2 * (4 / (liftL n d Ω p s : ℝ)) := fun hη i => by
    refine (abs_le_of_liftChiT_ne_zero hη i).trans ?_
    gcongr; norm_num
  have hγγ : γ = γ' := eq_of_near_ratPt goodBlocks_one_lt goodBlocks_pairwise_coprime
    (by positivity) (liftEps_threshold hs) hγ hγ' (z := z) (z' := z') (ξ := ξ)
    (fun i => by simpa [latEmbed_apply] using hb h i)
    (fun i => by simpa [latEmbed_apply] using hb h' i)
  subst hγγ
  exact ⟨rfl, liftChiT_translate_unique h h'⟩

/-- For `g` supported where `χ̃_s ≠ 0`: if `χ̃_s(ζ - z) ≠ 0` then `g_per(ζ) = g(ζ - z)`. -/
lemma periodize_eq_of_liftChiT {s : ℕ} {g : EuclideanSpace ℝ (Fin n) → ℂ}
    (hg : ∀ η, g η ≠ 0 → liftChiT n d Ω p s η ≠ 0) {ζ : EuclideanSpace ℝ (Fin n)}
    {z : Fin n → ℤ} (hz : liftChiT n d Ω p s (ζ - latEmbed z) ≠ 0) :
    periodize g ζ = g (ζ - latEmbed z) := by
  rw [periodize, tsum_eq_single z]
  intro z' hz'
  by_contra h
  exact hz' (liftChiT_translate_unique (hg _ h) hz)

/-- For `g` supported where `χ̃_s ≠ 0`: if no translate of `χ̃_s` is nonzero at `ζ`, then
`g_per(ζ) = 0`. -/
lemma periodize_eq_zero_of_liftChiT {s : ℕ} {g : EuclideanSpace ℝ (Fin n) → ℂ}
    (hg : ∀ η, g η ≠ 0 → liftChiT n d Ω p s η ≠ 0) {ζ : EuclideanSpace ℝ (Fin n)}
    (h : ∀ z : Fin n → ℤ, liftChiT n d Ω p s (ζ - latEmbed z) = 0) : periodize g ζ = 0 := by
  by_contra h'
  obtain ⟨z, hz⟩ := exists_ne_zero_of_periodize_ne_zero h'
  exact hg _ hz (h z)

/-- The good-set periodization of `g` (supported where `χ̃_s ≠ 0`) at an active point:
if `χ̃_s(ξ - β - z) ≠ 0` with `β ∈ 𝒰_{N_s}`, then `∑_{β' ∈ 𝒰} g_per(ξ - β') = g(ξ - β - z)`. -/
lemma cosetSymbol_eq_of_liftChiT {s : ℕ} (hs : 1 ≤ s) {g : EuclideanSpace ℝ (Fin n) → ℂ}
    (hg : ∀ η, g η ≠ 0 → liftChiT n d Ω p s η ≠ 0) {ξ : EuclideanSpace ℝ (Fin n)}
    {β : Fin n → ZMod (blockProd (goodBlocks (paramRho n d Ω p) (liftN s)))}
    (hβ : β ∈ paramGoodSet n d Ω p (liftN s)) {z : Fin n → ℤ}
    (hz : liftChiT n d Ω p s
      (ξ - ratPt (blockProd (goodBlocks (paramRho n d Ω p) (liftN s))) β - latEmbed z) ≠ 0) :
    cosetSymbol (blockProd (goodBlocks (paramRho n d Ω p) (liftN s))) g
        (paramGoodSet n d Ω p (liftN s)) ξ =
      g (ξ - ratPt (blockProd (goodBlocks (paramRho n d Ω p) (liftN s))) β - latEmbed z) := by
  unfold cosetSymbol
  rw [Finset.sum_eq_single_of_mem β hβ, periodize_eq_of_liftChiT hg hz]
  intro β' hβ' hne
  refine periodize_eq_zero_of_liftChiT hg fun z' => ?_
  by_contra h
  exact hne (liftChiT_center_unique hs hβ' hβ h hz).1

/-- The good-set periodization of `g` (supported where `χ̃_s ≠ 0`) vanishes at inactive points. -/
lemma cosetSymbol_eq_zero_of_liftChiT {s : ℕ} {g : EuclideanSpace ℝ (Fin n) → ℂ}
    (hg : ∀ η, g η ≠ 0 → liftChiT n d Ω p s η ≠ 0) {ξ : EuclideanSpace ℝ (Fin n)}
    (h : ∀ β ∈ paramGoodSet n d Ω p (liftN s), ∀ z : Fin n → ℤ, liftChiT n d Ω p s
      (ξ - ratPt (blockProd (goodBlocks (paramRho n d Ω p) (liftN s))) β - latEmbed z) = 0) :
    cosetSymbol (blockProd (goodBlocks (paramRho n d Ω p) (liftN s))) g
        (paramGoodSet n d Ω p (liftN s)) ξ = 0 :=
  Finset.sum_eq_zero fun β hβ => periodize_eq_zero_of_liftChiT hg (h β hβ)

/-- **Blueprint Lemma 9.3 (`lem:liftsquare`), eq. (9.8) (`eq:liftfactor`)**, the exact symbol
factorization: for `s ≥ 1`, `α = a/q ∈ 𝓡_s` and every symbol `m`,
`Lift_{s,α}[m] = A_{s,α} · D_s[m]` pointwise on `E`. -/
theorem liftSym_eq_liftA_mul_liftD {s : ℕ} (hs : 1 ≤ s) {a q : ℕ} (haq : (a, q) ∈ liftRat s)
    (m : EuclideanSpace ℝ (Fin n) → ℂ) (ξ : EuclideanSpace ℝ (Fin n)) :
    liftSym n d Ω p s a q m ξ = liftA n d Ω p s a q ξ * liftD n d Ω p s m ξ := by
  obtain ⟨-, hqN, -, -⟩ := mem_liftRat.1 haq
  have hq1 : 1 ≤ q := one_le_of_mem_liftRat haq
  set Q := blockProd (goodBlocks (paramRho n d Ω p) (liftN s))
  have hgT : ∀ η, m η * (liftChiT n d Ω p s η : ℂ) ≠ 0 → liftChiT n d Ω p s η ≠ 0 :=
    fun η h h0 => h (by rw [h0, Complex.ofReal_zero, mul_zero])
  have hgC : ∀ (c : EuclideanSpace ℝ (Fin n) → ℂ) η, c η * (liftChi n d Ω p s η : ℂ) ≠ 0 →
      liftChiT n d Ω p s η ≠ 0 := fun c η h => liftChiT_ne_zero_of_liftChi_ne_zero
    fun h0 => h (by rw [h0, Complex.ofReal_zero, mul_zero])
  unfold liftA liftSym
  rw [Finset.sum_mul]
  refine Finset.sum_congr rfl fun b _ => ?_
  rw [mul_assoc]
  congr 1
  obtain ⟨hγ, hγpt⟩ := gridEmb_mem_goodSet (n := n) (paramRho_pos n d Ω p) (two_le_liftN hs) hq1
    hqN.le b
  rw [← hγpt]
  by_cases hact : ∃ z : Fin n → ℤ, liftChiT n d Ω p s
      (ξ - ratPt Q (gridEmb Q q b) - latEmbed z) ≠ 0
  · obtain ⟨z, hz⟩ := hact
    rw [periodize_eq_of_liftChiT (hgC m) hz, periodize_eq_of_liftChiT (hgC _) hz, liftD,
      cosetSymbol_eq_of_liftChiT hs hgT hγ hz]
    set η := ξ - ratPt Q (gridEmb Q q b) - latEmbed z
    have h := liftChi_mul_liftChiT (n := n) (d := d) (Ω := Ω) (p := p) s η
    have h' : (liftChi n d Ω p s η : ℂ) * (liftChiT n d Ω p s η : ℂ) = liftChi n d Ω p s η := by
      exact_mod_cast h
    calc m η * (liftChi n d Ω p s η : ℂ)
        = m η * ((liftChi n d Ω p s η : ℂ) * (liftChiT n d Ω p s η : ℂ)) := by rw [h']
      _ = 1 * (liftChi n d Ω p s η : ℂ) * (m η * (liftChiT n d Ω p s η : ℂ)) := by ring
  · push Not at hact
    rw [periodize_eq_zero_of_liftChiT (hgC m) hact, periodize_eq_zero_of_liftChiT (hgC _) hact,
      zero_mul]


/-! #### The operator form of (9.8) -/

lemma continuous_liftChi (s : ℕ) :
    Continuous fun ξ : EuclideanSpace ℝ (Fin n) => (liftChi n d Ω p s ξ : ℂ) :=
  Complex.continuous_ofReal.comp (contDiff_liftCutoff.continuous.comp (continuous_const_smul _))

lemma continuous_liftChiT (s : ℕ) :
    Continuous fun ξ : EuclideanSpace ℝ (Fin n) => (liftChiT n d Ω p s ξ : ℂ) :=
  Complex.continuous_ofReal.comp (contDiff_companionCutoff.continuous.comp (continuous_const_smul _))

/-- `A_{s,α}` is continuous. -/
lemma continuous_liftA (s a q : ℕ) : Continuous (liftA n d Ω p s a q) := by
  have hL := eight_le_liftL (n := n) (d := d) (Ω := Ω) (p := p) s
  unfold liftA liftSym
  refine continuous_finsetSum _ fun b _ => continuous_const.mul ?_
  refine (continuous_periodize_of_support (c := 1 / (liftL n d Ω p s : ℝ))
    (continuous_const.mul (continuous_liftChi s)) ?_ fun η hη i => ?_).comp
    (continuous_sub_right _)
  · rw [div_lt_div_iff₀ (by linarith) (by norm_num)]; linarith
  · have h : liftChi n d Ω p s η ≠ 0 := fun h0 => hη (by simp [h0])
    exact support_liftChi s h i

/-- Lifted symbols are `ℤⁿ`-periodic. -/
lemma liftSym_add_latEmbed (s a q : ℕ) (m : EuclideanSpace ℝ (Fin n) → ℂ)
    (ξ : EuclideanSpace ℝ (Fin n)) (k : Fin n → ℤ) :
    liftSym n d Ω p s a q m (ξ + latEmbed k) = liftSym n d Ω p s a q m ξ := by
  unfold liftSym
  refine Finset.sum_congr rfl fun b _ => ?_
  rw [add_sub_right_comm, periodize_add_latEmbed]

/-- The kernel of `A_{s,α}` is in `ℓ¹`. -/
lemma summable_latKernel_liftA (s a : ℕ) {q : ℕ} (hq : 1 ≤ q) :
    Summable fun y => ‖latKernel (liftA n d Ω p s a q) y‖ := by
  refine (arith_summable_norm_liftPhi (n := n) (d := d) (Ω := Ω) (p := p) s).congr fun y => ?_
  rw [latKernel_liftA s a hq, norm_mul, norm_eC, one_mul]

/-- `A_{s,α}` is integrable on the torus. -/
lemma integrableOn_liftA (s a q : ℕ) : IntegrableOn (liftA n d Ω p s a q) (torusCube n) :=
  integrableOn_liftSym (by simpa using integrable_liftChi (n := n) (d := d) (Ω := Ω) (p := p) s)

/-- Composition with a continuous periodic symbol with `ℓ¹` kernel, in convolution form: for
`D` integrable on the torus and `f ∈ ℓ¹`, `(A D)(D) f = Ǎ * (D(D) f)` (the second factor need
not be in `ℓ¹`). -/
lemma latMult_mul_eq_tsum {A D : EuclideanSpace ℝ (Fin n) → ℂ} (hA : Continuous A)
    (hper : ∀ ξ (k : Fin n → ℤ), A (ξ + latEmbed k) = A ξ)
    (hK : Summable fun y => ‖latKernel A y‖) (hD : IntegrableOn D (torusCube n))
    {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) (x : Fin n → ℤ) :
    latMult (fun ξ => A ξ * D ξ) f x = ∑' y, latKernel A y * latMult D f (x - y) := by
  have hH : IntegrableOn (fun ξ => D ξ * latFT f ξ * eC (inner ℝ (latEmbed x) ξ))
      (torusCube n) := by
    refine hD.mul_bdd (c := ∑' z, ‖f z‖)
      (((continuous_latFT hf).mul (by fun_prop : Continuous fun ξ : EuclideanSpace ℝ (Fin n) =>
        eC (inner ℝ (latEmbed x) ξ))).aestronglyMeasurable) ?_ |>.congr ?_
    · exact Filter.Eventually.of_forall fun ξ => by
        rw [Pi.mul_apply, norm_mul, norm_eC, mul_one]; exact norm_latFT_le hf ξ
    · exact Filter.Eventually.of_forall fun ξ => by simp only [Pi.mul_apply]; ring
  have e1 : latMult (fun ξ => A ξ * D ξ) f x = ∫ ξ in torusCube n, latFT (latKernel A) ξ *
      (D ξ * latFT f ξ * eC (inner ℝ (latEmbed x) ξ)) := by
    unfold latMult
    congr 1; funext ξ
    rw [latFT_latKernel_of_continuous hA hper hK ξ]; ring
  rw [e1, integral_latFT_mul hK hH]
  refine tsum_congr fun y => ?_
  congr 1
  unfold latMult
  congr 1; funext ξ
  rw [latEmbed_sub, inner_sub_left, sub_eq_add_neg, eC_add]; ring

/-- `χ̃_s` (as a complex function) is integrable. -/
lemma integrable_liftChiT (s : ℕ) :
    Integrable fun ξ : EuclideanSpace ℝ (Fin n) => (liftChiT n d Ω p s ξ : ℂ) := by
  refine (continuous_liftChiT s).integrable_of_hasCompactSupport ?_
  refine HasCompactSupport.intro (isCompact_box (2 / (liftL n d Ω p s : ℝ))) fun ξ hξ => ?_
  by_contra h
  exact hξ (support_liftChiT s (fun h0 => h (by simp [h0])))

/-- `m χ̃_s` is integrable for `m` a.e. strongly measurable and bounded. -/
lemma integrable_mul_liftChiT {s : ℕ} {m : EuclideanSpace ℝ (Fin n) → ℂ}
    (hm : AEStronglyMeasurable m volume) {B : ℝ} (hB : ∀ ξ, ‖m ξ‖ ≤ B) :
    Integrable fun ξ => m ξ * (liftChiT n d Ω p s ξ : ℂ) := by
  have hχ := integrable_liftChiT (n := n) (d := d) (Ω := Ω) (p := p) s
  exact Integrable.mono' (hχ.norm.const_mul B) (hm.mul hχ.aestronglyMeasurable)
    (Filter.Eventually.of_forall fun ξ => by
      rw [norm_mul]; exact mul_le_mul_of_nonneg_right (hB ξ) (norm_nonneg _))

/-- `D_s[m]` is integrable on the torus for bounded measurable `m`. -/
lemma integrableOn_liftD {s : ℕ} {m : EuclideanSpace ℝ (Fin n) → ℂ}
    (hm : AEStronglyMeasurable m volume) {B : ℝ} (hB : ∀ ξ, ‖m ξ‖ ≤ B) :
    IntegrableOn (liftD n d Ω p s m) (torusCube n) :=
  integrableOn_cosetSymbol (integrable_mul_liftChiT hm hB) _

/-- **Blueprint Lemma 9.3 (`lem:liftsquare`), eq. (9.8), operator form**: for `s ≥ 1`,
`α = a/q ∈ 𝓡_s`, `m` bounded measurable and `f ∈ ℓ¹` (e.g. finitely supported),
`Lift_{s,α}[m](D) f = Ǎ_{s,α} * (D_s[m](D) f)`, i.e. `A_{s,α}(D)` applied (by its `ℓ¹` kernel) to
`D_s[m](D) f` (which is bounded, but need not be in `ℓ¹`). -/
theorem latMult_liftSym_eq_tsum {s : ℕ} (hs : 1 ≤ s) {a q : ℕ} (haq : (a, q) ∈ liftRat s)
    {m : EuclideanSpace ℝ (Fin n) → ℂ} (hm : AEStronglyMeasurable m volume) {B : ℝ}
    (hB : ∀ ξ, ‖m ξ‖ ≤ B) {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖)
    (x : Fin n → ℤ) :
    latMult (liftSym n d Ω p s a q m) f x =
      ∑' y, latKernel (liftA n d Ω p s a q) y * latMult (liftD n d Ω p s m) f (x - y) := by
  have e : liftSym n d Ω p s a q m = fun ξ => liftA n d Ω p s a q ξ * liftD n d Ω p s m ξ :=
    funext (liftSym_eq_liftA_mul_liftD hs haq m)
  rw [e]
  exact latMult_mul_eq_tsum (continuous_liftA s a q) (liftSym_add_latEmbed s a q _)
    (summable_latKernel_liftA s a (one_le_of_mem_liftRat haq)) (integrableOn_liftD hm hB) hf x

/-- **Blueprint Lemma 9.3 (`lem:liftsquare`), eq. (9.8), composition form**: under the hypotheses
of `latMult_liftSym_eq_tsum`, if moreover `D_s[m](D) f ∈ ℓ¹`, then
`Lift_{s,α}[m](D) f = A_{s,α}(D) (D_s[m](D) f)`. -/
theorem latMult_liftSym_eq_latMult {s : ℕ} (hs : 1 ≤ s) {a q : ℕ} (haq : (a, q) ∈ liftRat s)
    {m : EuclideanSpace ℝ (Fin n) → ℂ} (hm : AEStronglyMeasurable m volume) {B : ℝ}
    (hB : ∀ ξ, ‖m ξ‖ ≤ B) {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖)
    (hDf : Summable fun z => ‖latMult (liftD n d Ω p s m) f z‖) :
    latMult (liftSym n d Ω p s a q m) f =
      latMult (liftA n d Ω p s a q) (latMult (liftD n d Ω p s m) f) := by
  funext x
  rw [latMult_liftSym_eq_tsum hs haq hm hB hf x,
    latMult_eq_latConv (integrableOn_liftA s a q) hDf, latConv]


/-! #### The arithmetic vector bound (9.6) for bounded inputs -/

open scoped NNReal ENNReal in
/-- Finite suprema of norms are continuous. -/
lemma tendsto_finset_sup_nnnorm {ι : Type*} (S : Finset ι) {u : ℕ → ι → ℂ} {v : ι → ℂ}
    (h : ∀ i ∈ S, Filter.Tendsto (fun N => u N i) Filter.atTop (nhds (v i))) :
    Filter.Tendsto (fun N => S.sup fun i => ‖u N i‖₊) Filter.atTop
      (nhds (S.sup fun i => ‖v i‖₊)) := by
  classical
  induction S using Finset.induction_on with
  | empty => simp
  | insert a S ha ih =>
    simp only [Finset.sup_insert]
    exact ((continuous_nnnorm.tendsto _).comp (h a (mem_insert_self a S))).max
      (ih fun i hi => h i (mem_insert_of_mem hi))

open scoped NNReal ENNReal in
/-- Eq. (9.6) of Blueprint Lemma 9.2 for bounded inputs (not necessarily in `ℓ¹`), with
`A_{s,α}` acting by its `ℓ¹` kernel `Ǎ_{s,α}`: for `1 < t < ∞` there are `δ_t > 0` and `C_t` such
that for every `s ≥ 1` and every finite list `(g_ν)` of functions bounded by `M`,
`‖(∑_ν sup_{α ∈ 𝓡_s} |Ǎ_{s,α} * g_ν|²)^{1/2}‖_t ≤ C_t 2^{-δ_t s} ‖(∑_ν |g_ν|²)^{1/2}‖_t`.
(Windowing `g_ν w_N ∈ ℓ¹`, `arith_maximal_decay_vector`, and Fatou as `N → ∞`.) -/
theorem arith_maximal_decay_vector_bdd (n d : ℕ) (hn : 1 ≤ n) (hd : 1 ≤ d) {t : ℝ}
    (ht : 1 < t) :
    ∃ δ : ℝ, 0 < δ ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ),
      1 ≤ s → ∀ {ι : Type*} (F : Finset ι) (g : ι → (Fin n → ℤ) → ℂ) (M : ℝ),
        (∀ ν ∈ F, ∀ x, ‖g ν x‖ ≤ M) →
        eLpNorm (fun x => Real.sqrt (∑ ν ∈ F,
            ((((liftRat s).sup fun aq =>
              ‖∑' y, latKernel (liftA n d Ω p s aq.1 aq.2) y * g ν (x - y)‖₊ : ℝ≥0) : ℝ) ^ 2)))
            (ENNReal.ofReal t) Measure.count ≤
          ENNReal.ofReal (C * (2 : ℝ) ^ (-(δ * s))) *
            eLpNorm (fun x => Real.sqrt (∑ ν ∈ F, ‖g ν x‖ ^ 2)) (ENNReal.ofReal t)
              Measure.count := by
  obtain ⟨δ, hδ, C, hC, h⟩ := arith_maximal_decay_vector n d hn hd ht
  refine ⟨δ, hδ, C, hC, fun Ω p s hs ι F g M hM => ?_⟩
  set gN : ℕ → ι → (Fin n → ℤ) → ℂ := fun N ν x => g ν x * windowFun n N x with hgN
  have hgNs : ∀ N, ∀ ν ∈ F, Summable fun z => ‖gN N ν z‖ := by
    intro N ν hν
    refine Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun z => ?_)
      ((summable_windowFun N).mul_left M)
    rw [hgN, norm_mul]
    exact mul_le_mul_of_nonneg_right (hM ν hν z) (norm_nonneg _)
  -- the kernel form of `A_{s,α}` on `ℓ¹`
  have hker : ∀ N, ∀ ν ∈ F, ∀ aq ∈ liftRat s, ∀ x,
      latMult (liftA n d Ω p s aq.1 aq.2) (gN N ν) x =
        ∑' y, latKernel (liftA n d Ω p s aq.1 aq.2) y * gN N ν (x - y) := by
    intro N ν hν aq _ x
    rw [latMult_eq_latConv (integrableOn_liftA s _ _) (hgNs N ν hν), latConv]
  refine eLpNorm_le_of_tendsto_of_eLpNorm_le
    (u := fun N x => Real.sqrt (∑ ν ∈ F,
      ((((liftRat s).sup fun aq =>
        ‖latMult (liftA n d Ω p s aq.1 aq.2) (gN N ν) x‖₊ : ℝ≥0) : ℝ) ^ 2)))
    (fun _ => AEStronglyMeasurable.of_discrete) (Filter.Eventually.of_forall fun x => ?_)
    fun N => ?_
  · -- pointwise convergence
    refine (Real.continuous_sqrt.tendsto _).comp (tendsto_finsetSum _ fun ν hν => ?_)
    refine ((continuous_pow 2).tendsto _).comp ((NNReal.continuous_coe.tendsto _).comp ?_)
    refine tendsto_finset_sup_nnnorm _ fun aq haq => ?_
    have hq : 1 ≤ aq.2 := one_le_of_mem_liftRat (a := aq.1) (by simpa using haq)
    simp_rw [hker _ ν hν aq haq x]
    refine tendsto_tsum_of_dominated_convergence (bound := fun y =>
        ‖latKernel (liftA n d Ω p s aq.1 aq.2) y‖ * M)
      ((summable_latKernel_liftA s aq.1 hq).mul_right M) (fun y => ?_)
      (Filter.Eventually.of_forall fun N y => ?_)
    · have := (tendsto_windowFun (n := n) (x - y)).const_mul (g ν (x - y))
      rw [mul_one] at this
      exact this.const_mul _
    · rw [norm_mul, hgN, norm_mul]
      refine mul_le_mul_of_nonneg_left ?_ (norm_nonneg _)
      calc ‖g ν (x - y)‖ * ‖windowFun n N (x - y)‖ ≤ ‖g ν (x - y)‖ * 1 :=
            mul_le_mul_of_nonneg_left (norm_windowFun_le N _) (norm_nonneg _)
        _ ≤ M := by rw [mul_one]; exact hM ν hν _
  · -- the windowed bound
    refine (h Ω p s hs F (gN N) (hgNs N)).trans ?_
    gcongr
    refine eLpNorm_mono_real AEStronglyMeasurable.of_discrete fun x => ?_
    rw [Real.norm_of_nonneg (Real.sqrt_nonneg _)]
    refine Real.sqrt_le_sqrt (Finset.sum_le_sum fun ν _ => ?_)
    rw [hgN, norm_mul]
    refine pow_le_pow_left₀ (by positivity) ?_ 2
    calc ‖g ν x‖ * ‖windowFun n N x‖ ≤ ‖g ν x‖ * 1 :=
          mul_le_mul_of_nonneg_left (norm_windowFun_le N _) (norm_nonneg _)
      _ = ‖g ν x‖ := mul_one _


/-! #### The `ℓ²` square estimate (9.9) -/

/-- Pointwise: `∑_ν |D_s[m_ν](ξ)|² ≤ sup_η ∑_ν |m_ν(η)|²` (the good-set bumps are disjoint and
`0 ≤ χ̃_s ≤ 1`). -/
lemma sum_norm_sq_liftD_le {s : ℕ} (hs : 1 ≤ s) {ι : Type*} (F : Finset ι)
    (m : ι → EuclideanSpace ℝ (Fin n) → ℂ) {B : ℝ} (hB : ∀ η, ∑ ν ∈ F, ‖m ν η‖ ^ 2 ≤ B ^ 2)
    (ξ : EuclideanSpace ℝ (Fin n)) :
    ∑ ν ∈ F, ‖liftD n d Ω p s (m ν) ξ‖ ^ 2 ≤ B ^ 2 := by
  have hgT : ∀ ν η, m ν η * (liftChiT n d Ω p s η : ℂ) ≠ 0 → liftChiT n d Ω p s η ≠ 0 :=
    fun ν η h h0 => h (by rw [h0, Complex.ofReal_zero, mul_zero])
  by_cases hact : ∃ β ∈ paramGoodSet n d Ω p (liftN s), ∃ z : Fin n → ℤ, liftChiT n d Ω p s
      (ξ - ratPt (blockProd (goodBlocks (paramRho n d Ω p) (liftN s))) β - latEmbed z) ≠ 0
  · obtain ⟨β, hβ, z, hz⟩ := hact
    set η := ξ - ratPt (blockProd (goodBlocks (paramRho n d Ω p) (liftN s))) β - latEmbed z
    refine le_trans (Finset.sum_le_sum fun ν _ => ?_) (hB η)
    rw [liftD, cosetSymbol_eq_of_liftChiT hs (hgT ν) hβ hz, norm_mul, Complex.norm_real,
      Real.norm_of_nonneg (liftChiT_nonneg s η)]
    refine pow_le_pow_left₀ (mul_nonneg (norm_nonneg _) (liftChiT_nonneg s η)) ?_ 2
    exact mul_le_of_le_one_right (norm_nonneg _) (liftChiT_le_one s η)
  · push Not at hact
    rw [Finset.sum_eq_zero fun ν _ => by
      rw [liftD, cosetSymbol_eq_zero_of_liftChiT (hgT ν) hact, norm_zero]; norm_num]
    positivity

/-- A single term of a finite sum of squares is bounded by the bound of the sum. -/
lemma lift_norm_le_of_sum_sq_le {ι : Type*} {F : Finset ι} {a : ι → ℂ} {B : ℝ} (hB0 : 0 ≤ B)
    (h : ∑ ν ∈ F, ‖a ν‖ ^ 2 ≤ B ^ 2) {ν : ι} (hν : ν ∈ F) : ‖a ν‖ ≤ B := by
  have h1 : ‖a ν‖ ^ 2 ≤ B ^ 2 :=
    (Finset.single_le_sum (f := fun ν => ‖a ν‖ ^ 2) (fun _ _ => by positivity) hν).trans h
  exact (pow_le_pow_iff_left₀ (norm_nonneg _) hB0 two_ne_zero).1 h1

/-- `ℓ¹ ⊆ ℓ²` on `ℤⁿ` (summability of `|f|²`). -/
lemma summable_norm_sq_of_summable {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) :
    Summable fun z => ‖f z‖ ^ 2 := by
  refine Summable.of_nonneg_of_le (fun _ => by positivity) (fun z => ?_)
    (hf.mul_left (∑' z, ‖f z‖))
  rw [sq]
  exact mul_le_mul_of_nonneg_right (hf.le_tsum z fun _ _ => norm_nonneg _) (norm_nonneg _)

/-- `‖(∑_ν |g_ν|²)^{1/2}‖₂² = ∑_ν ∑_x |g_ν(x)|²` for square-summable `g_ν` on `ℤⁿ`. -/
lemma eLpNorm_sqrt_sum_sq_two_sq {ι : Type*} (F : Finset ι) (g : ι → (Fin n → ℤ) → ℂ)
    (hg : ∀ ν ∈ F, Summable fun x => ‖g ν x‖ ^ 2) :
    eLpNorm (fun x => Real.sqrt (∑ ν ∈ F, ‖g ν x‖ ^ 2)) 2 Measure.count ^ 2 =
      ENNReal.ofReal (∑ ν ∈ F, ∑' x, ‖g ν x‖ ^ 2) := by
  rw [arith_eLpNorm_two_sq_eq_tsum]
  have e : ∀ x, ‖Real.sqrt (∑ ν ∈ F, ‖g ν x‖ ^ 2)‖ₑ ^ 2 =
      ENNReal.ofReal (∑ ν ∈ F, ‖g ν x‖ ^ 2) := by
    intro x
    rw [Real.enorm_eq_ofReal (Real.sqrt_nonneg _), ← ENNReal.ofReal_pow (Real.sqrt_nonneg _),
      Real.sq_sqrt (Finset.sum_nonneg fun _ _ => by positivity)]
  simp_rw [e]
  rw [← ENNReal.ofReal_tsum_of_nonneg (fun x => Finset.sum_nonneg fun _ _ => by positivity)
    (summable_sum hg), Summable.tsum_finsetSum hg]

/-- The `ℓ²` bound of the proof of eq. (9.9): Parseval (Bessel) and disjointness of the
good-set bumps give `‖(∑_ν |D_s[m_ν](D) f|²)^{1/2}‖₂ ≤ B ‖f‖₂` when
`∑_ν |m_ν(η)|² ≤ B²` for all `η`. -/
lemma eLpNorm_sqrt_sum_liftD_two_le {s : ℕ} (hs : 1 ≤ s) {ι : Type*} (F : Finset ι)
    (m : ι → EuclideanSpace ℝ (Fin n) → ℂ) (hm : ∀ ν ∈ F, AEStronglyMeasurable (m ν) volume)
    {B : ℝ} (hB0 : 0 ≤ B) (hB : ∀ η, ∑ ν ∈ F, ‖m ν η‖ ^ 2 ≤ B ^ 2)
    {f : (Fin n → ℤ) → ℂ} (hf : Summable fun z => ‖f z‖) :
    eLpNorm (fun x => Real.sqrt (∑ ν ∈ F, ‖latMult (liftD n d Ω p s (m ν)) f x‖ ^ 2)) 2
      Measure.count ≤ ENNReal.ofReal B * eLpNorm f 2 Measure.count := by
  set D := fun ν => liftD n d Ω p s (m ν) with hD
  have hmB : ∀ ν ∈ F, ∀ η, ‖m ν η‖ ≤ B := fun ν hν η => lift_norm_le_of_sum_sq_le hB0 (hB η) hν
  have hDB : ∀ ν ∈ F, ∀ ξ, ‖D ν ξ‖ ≤ B := fun ν hν ξ =>
    lift_norm_le_of_sum_sq_le (a := fun ν => D ν ξ) hB0 (sum_norm_sq_liftD_le hs F m hB ξ) hν
  have hDm : ∀ ν ∈ F, AEStronglyMeasurable (D ν) (volume.restrict (torusCube n)) :=
    fun ν hν => (integrableOn_liftD (hm ν hν) (hmB ν hν)).aestronglyMeasurable
  have hBes := fun ν hν => summable_and_tsum_norm_sq_latMult_le_integral (hDm ν hν)
    (fun ξ _ => hDB ν hν ξ) hf
  set S := ∑' z, ‖f z‖
  have hfb : ∀ ξ, ‖latFT f ξ‖ ≤ S := norm_latFT_le hf
  have hint : ∀ ν ∈ F, IntegrableOn (fun ξ => ‖D ν ξ‖ ^ 2 * ‖latFT f ξ‖ ^ 2) (torusCube n) := by
    intro ν hν
    refine integrableOn_torusCube_of_bound
      (((hDm ν hν).norm.pow 2).mul ((continuous_latFT hf).norm.pow 2).aestronglyMeasurable)
      (B ^ 2 * S ^ 2) fun ξ _ => ?_
    rw [Real.norm_of_nonneg (by positivity)]
    gcongr
    · exact hDB ν hν ξ
    · exact hfb ξ
  have hintR : IntegrableOn (fun ξ => B ^ 2 * ‖latFT f ξ‖ ^ 2) (torusCube n) := by
    refine integrableOn_torusCube_of_bound
      ((continuous_const.mul ((continuous_latFT hf).norm.pow 2)).aestronglyMeasurable)
      (B ^ 2 * S ^ 2) fun ξ _ => ?_
    rw [Real.norm_of_nonneg (by positivity)]
    gcongr
    exact hfb ξ
  have hreal : ∑ ν ∈ F, ∑' x, ‖latMult (D ν) f x‖ ^ 2 ≤ B ^ 2 * ∑' x, ‖f x‖ ^ 2 := by
    calc ∑ ν ∈ F, ∑' x, ‖latMult (D ν) f x‖ ^ 2
        ≤ ∑ ν ∈ F, ∫ ξ in torusCube n, ‖D ν ξ‖ ^ 2 * ‖latFT f ξ‖ ^ 2 :=
          Finset.sum_le_sum fun ν hν => (hBes ν hν).2
      _ = ∫ ξ in torusCube n, (∑ ν ∈ F, ‖D ν ξ‖ ^ 2) * ‖latFT f ξ‖ ^ 2 := by
          rw [← integral_finsetSum _ hint]
          congr 1; funext ξ; rw [Finset.sum_mul]
      _ ≤ ∫ ξ in torusCube n, B ^ 2 * ‖latFT f ξ‖ ^ 2 := by
          refine integral_mono_of_nonneg (Filter.Eventually.of_forall fun ξ => by positivity)
            hintR (Filter.Eventually.of_forall fun ξ => ?_)
          exact mul_le_mul_of_nonneg_right (sum_norm_sq_liftD_le hs F m hB ξ) (by positivity)
      _ = B ^ 2 * ∑' x, ‖f x‖ ^ 2 := by rw [integral_const_mul, integral_norm_sq_latFT hf]
  have key : eLpNorm (fun x => Real.sqrt (∑ ν ∈ F, ‖latMult (D ν) f x‖ ^ 2)) 2
      Measure.count ^ 2 ≤ 1 * (ENNReal.ofReal B * eLpNorm f 2 Measure.count) ^ 2 := by
    rw [eLpNorm_sqrt_sum_sq_two_sq F _ fun ν hν => (hBes ν hν).1, one_mul, mul_pow,
      arith_eLpNorm_two_sq_eq_tsum]
    have e : ∑' x, ‖f x‖ₑ ^ 2 = ENNReal.ofReal (∑' x, ‖f x‖ ^ 2) := by
      rw [ENNReal.ofReal_tsum_of_nonneg (fun _ => by positivity)
        (summable_norm_sq_of_summable hf)]
      refine tsum_congr fun x => ?_
      rw [ENNReal.ofReal_pow (norm_nonneg _), ofReal_norm]
    rw [e, ← ENNReal.ofReal_pow hB0, ← ENNReal.ofReal_mul (by positivity)]
    exact ENNReal.ofReal_le_ofReal hreal
  have := band_le_of_sq_le key
  rwa [ENNReal.one_rpow, one_mul] at this

/-- The bounded inputs `D_s[m](D) f` (`|D_s[m](D) f| ≤ ‖D_s[m]‖_{L¹(𝕋ⁿ)} ‖f‖_{ℓ¹}`) of a finite
family, with a common bound. -/
lemma exists_bound_latMult_liftD {s : ℕ} {ι : Type*} (F : Finset ι)
    {m : ι → EuclideanSpace ℝ (Fin n) → ℂ} (hm : ∀ ν ∈ F, AEStronglyMeasurable (m ν) volume)
    {B : ℝ} (hmB : ∀ ν ∈ F, ∀ η, ‖m ν η‖ ≤ B) {f : (Fin n → ℤ) → ℂ}
    (hf : Summable fun z => ‖f z‖) :
    ∃ M : ℝ, ∀ ν ∈ F, ∀ x, ‖latMult (liftD n d Ω p s (m ν)) f x‖ ≤ M := by
  refine ⟨∑ ν ∈ F, (∫ η in torusCube n, ‖liftD n d Ω p s (m ν) η‖) * ∑' z, ‖f z‖,
    fun ν hν x => ?_⟩
  refine (norm_latMult_le (integrableOn_liftD (hm ν hν) (hmB ν hν)) hf x).trans ?_
  exact Finset.single_le_sum (f := fun ν => (∫ η in torusCube n,
    ‖liftD n d Ω p s (m ν) η‖) * ∑' z, ‖f z‖)
    (fun _ _ => mul_nonneg (integral_nonneg fun _ => norm_nonneg _)
      (tsum_nonneg fun _ => norm_nonneg _)) hν

open scoped NNReal ENNReal in
/-- The lifted square function equals the arithmetic square function of the inputs
`D_s[m_ν](D) f` (factorization (9.8), operator form). -/
lemma lift_sqrt_sum_eq {s : ℕ} (hs : 1 ≤ s) {ι : Type*} (F : Finset ι)
    {m : ι → EuclideanSpace ℝ (Fin n) → ℂ} (hm : ∀ ν ∈ F, AEStronglyMeasurable (m ν) volume)
    {B : ℝ} (hmB : ∀ ν ∈ F, ∀ η, ‖m ν η‖ ≤ B) {f : (Fin n → ℤ) → ℂ}
    (hf : Summable fun z => ‖f z‖) :
    (fun x => Real.sqrt (∑ ν ∈ F,
      ((((liftRat s).sup fun aq =>
        ‖latMult (liftSym n d Ω p s aq.1 aq.2 (m ν)) f x‖₊ : ℝ≥0) : ℝ) ^ 2))) =
      fun x => Real.sqrt (∑ ν ∈ F,
      ((((liftRat s).sup fun aq =>
        ‖∑' y, latKernel (liftA n d Ω p s aq.1 aq.2) y *
          latMult (liftD n d Ω p s (m ν)) f (x - y)‖₊ : ℝ≥0) : ℝ) ^ 2)) := by
  funext x
  congr 1
  refine Finset.sum_congr rfl fun ν hν => ?_
  refine congrArg (fun t : ℝ≥0 => (t : ℝ) ^ 2) (Finset.sup_congr rfl fun aq haq => ?_)
  rw [latMult_liftSym_eq_tsum hs (a := aq.1) (q := aq.2) (by simpa using haq) (hm ν hν)
    (hmB ν hν) hf x]

open scoped NNReal ENNReal in
/-- **Blueprint Lemma 9.3 (`lem:liftsquare`), eq. (9.9) (`eq:liftL2square`)**, the `ℓ²` lifted
square estimate: for `n, d ≥ 1` there are `γ > 0` and `C` (independent of `Ω, p`, of `s`, of the
family and of `f`) such that for every `s ≥ 1`, every finite family `(m_ν)_{ν ∈ F}` of
a.e. strongly measurable symbols with `∑_ν |m_ν(η)|² ≤ B²` for all `η` (`B ≥ 0`; i.e.
`B ≥ (sup_η ∑_ν |m_ν(η)|²)^{1/2}`), and every `f ∈ ℓ¹(ℤⁿ)` (e.g. finitely supported),
`‖(∑_ν sup_{α ∈ 𝓡_s} |Lift_{s,α}[m_ν](D) f|²)^{1/2}‖₂ ≤ C 2^{-γ s} B ‖f‖₂`. -/
theorem lift_square_two (n d : ℕ) (hn : 1 ≤ n) (hd : 1 ≤ d) :
    ∃ γ : ℝ, 0 < γ ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ),
      1 ≤ s → ∀ {ι : Type*} (F : Finset ι) (m : ι → EuclideanSpace ℝ (Fin n) → ℂ) (B : ℝ),
        (∀ ν ∈ F, AEStronglyMeasurable (m ν) volume) → 0 ≤ B →
        (∀ η, ∑ ν ∈ F, ‖m ν η‖ ^ 2 ≤ B ^ 2) →
        ∀ f : (Fin n → ℤ) → ℂ, Summable (fun z => ‖f z‖) →
          eLpNorm (fun x => Real.sqrt (∑ ν ∈ F,
              ((((liftRat s).sup fun aq =>
                ‖latMult (liftSym n d Ω p s aq.1 aq.2 (m ν)) f x‖₊ : ℝ≥0) : ℝ) ^ 2)))
              2 Measure.count ≤
            ENNReal.ofReal (C * (2 : ℝ) ^ (-(γ * s)) * B) * eLpNorm f 2 Measure.count := by
  obtain ⟨γ, hγ, C, hC, h⟩ := arith_maximal_decay_vector_bdd n d hn hd (t := 2) one_lt_two
  refine ⟨γ, hγ, C, hC, fun Ω p s hs ι F m B hm hB0 hB f hf => ?_⟩
  have hmB : ∀ ν ∈ F, ∀ η, ‖m ν η‖ ≤ B := fun ν hν η => lift_norm_le_of_sum_sq_le hB0 (hB η) hν
  obtain ⟨M, hM⟩ := exists_bound_latMult_liftD (d := d) (Ω := Ω) (p := p) (s := s) F hm hmB hf
  have h1 := h Ω p s hs F (fun ν => latMult (liftD n d Ω p s (m ν)) f) M hM
  rw [show ENNReal.ofReal 2 = 2 by norm_num] at h1
  rw [lift_sqrt_sum_eq hs F hm hmB hf]
  refine h1.trans ((mul_le_mul' le_rfl (eLpNorm_sqrt_sum_liftD_two_le hs F m hm hB0 hB hf)).trans
    (le_of_eq ?_))
  rw [ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ C * (2 : ℝ) ^ (-(γ * s))), mul_assoc]


/-! #### The `ℓ^p` square estimate (9.10) -/

lemma hasCompactSupport_liftChiT (s : ℕ) :
    HasCompactSupport fun ξ : EuclideanSpace ℝ (Fin n) => (liftChiT n d Ω p s ξ : ℂ) :=
  HasCompactSupport.intro (isCompact_box (2 / (liftL n d Ω p s : ℝ))) fun ξ hξ => by
    by_contra h
    exact hξ (support_liftChiT s (fun h0 => h (by simp [h0])))

/-- `χ̃_s` as a (complex-valued) Schwartz function. -/
noncomputable def liftChiTSchwartz (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ)
    (s : ℕ) : 𝓢(EuclideanSpace ℝ (Fin n), ℂ) :=
  (hasCompactSupport_liftChiT (n := n) (d := d) (Ω := Ω) (p := p) s).toSchwartzMap
    (Complex.ofRealCLM.contDiff.comp
      (contDiff_companionCutoff.comp (contDiff_const_smul (liftL n d Ω p s : ℝ))))

@[simp] lemma liftChiTSchwartz_apply (s : ℕ) (ξ : EuclideanSpace ℝ (Fin n)) :
    liftChiTSchwartz n d Ω p s ξ = (liftChiT n d Ω p s ξ : ℂ) := rfl

/-- The companion cutoff `χ̃ = θ` as a Schwartz function. -/
noncomputable def companionSchwartz (n : ℕ) : 𝓢(EuclideanSpace ℝ (Fin n), ℂ) :=
  (HasCompactSupport.intro (isCompact_box (2 : ℝ)) fun ξ hξ => by
      by_contra h
      exact hξ (support_companionCutoff (n := n) (fun h0 => h (by simp [h0])))
    : HasCompactSupport fun ξ : EuclideanSpace ℝ (Fin n) => (companionCutoff n ξ : ℂ)).toSchwartzMap
    (Complex.ofRealCLM.contDiff.comp contDiff_companionCutoff)

/-- Uniform envelope bound for the kernels of `χ̃_s`: `|𝓕⁻ χ̃_s| ≤ C B_{L_s}` with `C`
depending only on `n`. -/
lemma exists_norm_fourierInv_liftChiT_le (n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ)
      (x : EuclideanSpace ℝ (Fin n)),
      ‖𝓕⁻ (fun ξ => (liftChiT n d Ω p s ξ : ℂ)) x‖ ≤ C * envelope n (liftL n d Ω p s) x := by
  obtain ⟨K, hK, hKb⟩ := exists_norm_le_envelope (𝓕⁻ (companionSchwartz n))
  refine ⟨K, hK, fun d Ω p s x => ?_⟩
  set L : ℝ := (liftL n d Ω p s : ℝ)
  have hL : 0 < L := liftL_pos s
  have hL' : 0 < L⁻¹ := inv_pos.2 hL
  have hfun : (fun ξ : EuclideanSpace ℝ (Fin n) => (liftChiT n d Ω p s ξ : ℂ)) =
      fun ξ => companionSchwartz n ((L⁻¹)⁻¹ • ξ) := by
    funext ξ; rw [inv_inv]; rfl
  rw [hfun, fourierInv_comp_inv_smul _ hL', ← SchwartzMap.fourierInv_coe, norm_mul,
    Complex.norm_real, Real.norm_of_nonneg (by positivity)]
  have hb := hKb (L⁻¹ • x)
  have he : envelope n 1 (L⁻¹ • x) = ((1 + ‖x‖ / L) ^ (n + 1))⁻¹ := by
    rw [envelope, norm_smul, Real.norm_of_nonneg hL'.le]
    simp [div_eq_inv_mul]
  rw [he] at hb
  calc (L⁻¹) ^ n * ‖(𝓕⁻ (companionSchwartz n)) (L⁻¹ • x)‖
      ≤ (L⁻¹) ^ n * (K * ((1 + ‖x‖ / L) ^ (n + 1))⁻¹) :=
        mul_le_mul_of_nonneg_left hb (by positivity)
    _ = K * envelope n L x := by rw [envelope, inv_pow]; ring

/-- Uniform `L¹` bound for the kernels of `χ̃_s`: `‖𝓕⁻ χ̃_s‖_{L¹} ≤ K` with `K` depending only
on `n`. -/
lemma exists_eLpNorm_fourierInv_liftChiT_le (n : ℕ) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ (d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ),
      eLpNorm (𝓕⁻ (fun ξ => (liftChiT n d Ω p s ξ : ℂ))) 1 volume ≤ ENNReal.ofReal K := by
  obtain ⟨C, hC, h⟩ := exists_norm_fourierInv_liftChiT_le n
  have hE : 0 ≤ envelopeConst n := by unfold envelopeConst; positivity
  refine ⟨C * envelopeConst n, by positivity, fun d Ω p s => ?_⟩
  have hL := liftL_pos (n := n) (d := d) (Ω := Ω) (p := p) s
  obtain ⟨hi, hI⟩ := integrable_envelope_and_integral_le (n := n) hL
  have hmeas : AEStronglyMeasurable (𝓕⁻ (fun ξ => (liftChiT n d Ω p s ξ : ℂ))) volume := by
    have e : (fun ξ => (liftChiT n d Ω p s ξ : ℂ)) = ⇑(liftChiTSchwartz n d Ω p s) := rfl
    rw [e, ← SchwartzMap.fourierInv_coe]
    exact (𝓕⁻ (liftChiTSchwartz n d Ω p s)).continuous.aestronglyMeasurable
  refine (eLpNorm_mono_real (g := fun x => C * envelope n (liftL n d Ω p s) x) hmeas
      (h d Ω p s)).trans ?_
  rw [eLpNorm_one_eq_lintegral_enorm (hi.const_mul C).aestronglyMeasurable]
  rw [← ofReal_integral_norm_eq_lintegral_enorm (hi.const_mul C)]
  refine ENNReal.ofReal_le_ofReal ?_
  calc ∫ x, ‖C * envelope n (liftL n d Ω p s) x‖
      = ∫ x, C * envelope n (liftL n d Ω p s) x := by
        congr 1; funext x
        rw [Real.norm_of_nonneg (mul_nonneg hC (envelope_nonneg hL x))]
    _ ≤ C * envelopeConst n := by
        rw [integral_const_mul]; exact mul_le_mul_of_nonneg_left hI hC


open scoped Convolution ENNReal in
/-- Young for the cutoff: if `M` has Euclidean `L^P` multiplier norm `≤ A` on Schwartz inputs
(`1 ≤ P`), then so does `M χ̃_s`, with norm `≤ A K`, where `‖𝓕⁻ χ̃_s‖_{L¹} ≤ K`. -/
lemma eLpNorm_fourierInv_mul_liftChiT_le {s : ℕ} {K : ℝ}
    (hK : eLpNorm (𝓕⁻ (fun ξ => (liftChiT n d Ω p s ξ : ℂ))) 1 volume ≤ ENNReal.ofReal K)
    (hK0 : 0 ≤ K) {P : ℝ≥0∞} (hP : 1 ≤ P) {M : EuclideanSpace ℝ (Fin n) → ℂ} {A : ℝ}
    (hA : ∀ F : 𝓢(EuclideanSpace ℝ (Fin n), ℂ),
      eLpNorm (𝓕⁻ (fun ξ => M ξ * 𝓕 (F : EuclideanSpace ℝ (Fin n) → ℂ) ξ)) P volume ≤
        ENNReal.ofReal A * eLpNorm F P volume)
    (F : 𝓢(EuclideanSpace ℝ (Fin n), ℂ)) :
    eLpNorm (𝓕⁻ (fun ξ => (M ξ * (liftChiT n d Ω p s ξ : ℂ)) *
        𝓕 (F : EuclideanSpace ℝ (Fin n) → ℂ) ξ)) P volume ≤
      ENNReal.ofReal (A * K) * eLpNorm F P volume := by
  set φ : 𝓢(EuclideanSpace ℝ (Fin n), ℂ) := 𝓕⁻ (liftChiTSchwartz n d Ω p s) with hφ
  set G := SchwartzMap.convolution (ContinuousLinearMap.mul ℂ ℂ) φ F with hG
  have hGF : ∀ ξ, 𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ =
      (liftChiT n d Ω p s ξ : ℂ) * 𝓕 (F : EuclideanSpace ℝ (Fin n) → ℂ) ξ := by
    intro ξ
    have h := congrArg (fun H : 𝓢(EuclideanSpace ℝ (Fin n), ℂ) => H ξ)
      (SchwartzMap.fourier_convolution (ContinuousLinearMap.mul ℂ ℂ) φ F)
    simp only [SchwartzMap.pairing_apply_apply, hφ, FourierTransform.fourier_fourierInv_eq,
      ContinuousLinearMap.mul_apply', liftChiTSchwartz_apply] at h
    rw [← SchwartzMap.fourier_coe, h, SchwartzMap.fourier_coe]
  have e : (fun ξ => (M ξ * (liftChiT n d Ω p s ξ : ℂ)) *
      𝓕 (F : EuclideanSpace ℝ (Fin n) → ℂ) ξ) =
      fun ξ => M ξ * 𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ := by
    funext ξ; rw [hGF, mul_assoc]
  rw [e]
  refine (hA G).trans ?_
  have hGc : (G : EuclideanSpace ℝ (Fin n) → ℂ) =
      (φ : EuclideanSpace ℝ (Fin n) → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ, volume]
        (F : EuclideanSpace ℝ (Fin n) → ℂ) :=
    funext fun x => SchwartzMap.convolution_apply _ φ F x
  have hY := (young_convolution_euclidean hP (φ.memLp 1) (F.memLp P)).2.1
  have hφK : eLpNorm (φ : EuclideanSpace ℝ (Fin n) → ℂ) 1 volume ≤ ENNReal.ofReal K := by
    rw [hφ, SchwartzMap.fourierInv_coe]; exact hK
  rw [hGc, ENNReal.ofReal_mul' hK0, mul_assoc]
  gcongr
  exact hY.trans (by gcongr)

open scoped ENNReal in
/-- Lower Khintchine inequality for `L^p` norms (Blueprint Lemma 2.6): if every signed sum
`∑_ν ±g_ν` has `L^p` norm `≤ K` (`0 < p`), then `‖(∑_ν |g_ν|²)^{1/2}‖_p ≤ c_p⁻¹ K`. -/
lemma eLpNorm_sqrt_sum_le_of_rademacher {α : Type*} [MeasurableSpace α] {μ : Measure α}
    {ι : Type*} [DecidableEq ι] (F : Finset ι) (g : ι → α → ℂ)
    (hg : ∀ ν ∈ F, AEStronglyMeasurable (g ν) μ) {p : ℝ} (hp : 0 < p) {K : ℝ≥0∞}
    (h : ∀ u ∈ F.powerset, eLpNorm (fun x => rademacherSum F u (fun ν => g ν x))
      (ENNReal.ofReal p) μ ≤ K) :
    eLpNorm (fun x => Real.sqrt (∑ ν ∈ F, ‖g ν x‖ ^ 2)) (ENNReal.ofReal p) μ ≤
      ENNReal.ofReal (khintchineLowerConst p)⁻¹ * K := by
  set P := ENNReal.ofReal p
  have hP0 : P ≠ 0 := (ENNReal.ofReal_pos.mpr hp).ne'
  have hPtop : P ≠ ⊤ := ENNReal.ofReal_ne_top
  have hPr : P.toReal = p := ENNReal.toReal_ofReal hp.le
  have hc := khintchineLowerConst_pos p
  set c := khintchineLowerConst p
  set S := fun x => Real.sqrt (∑ ν ∈ F, ‖g ν x‖ ^ 2)
  have hSm : AEStronglyMeasurable S μ := aestronglyMeasurable_sqrt_sum_norm_sq F g hg
  have hRm : ∀ u, AEStronglyMeasurable (fun x => rademacherSum F u (fun ν => g ν x)) μ :=
    fun u => aestronglyMeasurable_rademacherSum F u g hg
  have hR : ∀ u ∈ F.powerset, ∫⁻ x, ‖rademacherSum F u (fun ν => g ν x)‖ₑ ^ p ∂μ ≤ K ^ p := by
    intro u hu
    have h1 := h u hu
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hP0 hPtop (hRm u), hPr] at h1
    have h2 := ENNReal.rpow_le_rpow h1 hp.le
    rwa [one_div, ENNReal.rpow_inv_rpow hp.ne'] at h2
  set N : ℝ≥0∞ := (2 ^ F.card : ℝ≥0∞)⁻¹
  have hcS : ∫⁻ x, (ENNReal.ofReal c * ‖S x‖ₑ) ^ p ∂μ ≤ K ^ p := by
    calc ∫⁻ x, (ENNReal.ofReal c * ‖S x‖ₑ) ^ p ∂μ
        ≤ ∫⁻ x, N * ∑ u ∈ F.powerset, ‖rademacherSum F u (fun ν => g ν x)‖ₑ ^ p ∂μ :=
          lintegral_mono fun x => khintchine_lower_enorm ℂ F (fun ν => g ν x) hp
      _ = N * ∑ u ∈ F.powerset, ∫⁻ x, ‖rademacherSum F u (fun ν => g ν x)‖ₑ ^ p ∂μ := by
          rw [lintegral_const_mul' _ _ (ENNReal.inv_ne_top.mpr (by positivity)),
            lintegral_finsetSum']
          intro u _
          exact (hRm u).enorm.pow_const p
      _ ≤ N * ∑ u ∈ F.powerset, K ^ p := by gcongr with u hu; exact hR u hu
      _ = K ^ p := by
          rw [Finset.sum_const, Finset.card_powerset, nsmul_eq_mul, ← mul_assoc]
          rw [show ((2 ^ F.card : ℕ) : ℝ≥0∞) = (2 : ℝ≥0∞) ^ F.card by push_cast; rfl]
          rw [ENNReal.inv_mul_cancel (by positivity) (by simp), one_mul]
  have hcS' : ENNReal.ofReal c * eLpNorm S P μ ≤ K := by
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hP0 hPtop hSm, hPr]
    have e : ENNReal.ofReal c = (ENNReal.ofReal c ^ p) ^ (1 / p) := by
      rw [one_div, ENNReal.rpow_rpow_inv hp.ne']
    rw [e, ← ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← lintegral_const_mul' _ _
      (ENNReal.rpow_ne_top_of_nonneg hp.le ENNReal.ofReal_ne_top)]
    have e2 : ∀ x, ENNReal.ofReal c ^ p * ‖S x‖ₑ ^ p = (ENNReal.ofReal c * ‖S x‖ₑ) ^ p :=
      fun x => (ENNReal.mul_rpow_of_nonneg _ _ hp.le).symm
    simp_rw [e2]
    calc (∫⁻ x, (ENNReal.ofReal c * ‖S x‖ₑ) ^ p ∂μ) ^ (1 / p) ≤ (K ^ p) ^ (1 / p) :=
          ENNReal.rpow_le_rpow hcS (by positivity)
      _ = K := by rw [one_div, ENNReal.rpow_rpow_inv hp.ne']
  have hc0 : ENNReal.ofReal c ≠ 0 := (ENNReal.ofReal_pos.mpr hc).ne'
  calc eLpNorm S P μ = (ENNReal.ofReal c)⁻¹ * (ENNReal.ofReal c * eLpNorm S P μ) := by
        rw [← mul_assoc, ENNReal.inv_mul_cancel hc0 ENNReal.ofReal_ne_top, one_mul]
    _ ≤ (ENNReal.ofReal c)⁻¹ * K := by gcongr
    _ = ENNReal.ofReal c⁻¹ * K := by rw [ENNReal.ofReal_inv_of_pos hc]

/-- `D_s` is linear in the symbol: `D_s[∑_ν c_ν m_ν] = ∑_ν c_ν D_s[m_ν]` (`s ≥ 1`). -/
lemma liftD_sum_smul {s : ℕ} (hs : 1 ≤ s) {ι : Type*} (F : Finset ι) (c : ι → ℂ)
    (m : ι → EuclideanSpace ℝ (Fin n) → ℂ) (ξ : EuclideanSpace ℝ (Fin n)) :
    liftD n d Ω p s (fun η => ∑ ν ∈ F, c ν * m ν η) ξ =
      ∑ ν ∈ F, c ν * liftD n d Ω p s (m ν) ξ := by
  have hgT : ∀ (M : EuclideanSpace ℝ (Fin n) → ℂ) η, M η * (liftChiT n d Ω p s η : ℂ) ≠ 0 →
      liftChiT n d Ω p s η ≠ 0 :=
    fun M η h h0 => h (by rw [h0, Complex.ofReal_zero, mul_zero])
  by_cases hact : ∃ β ∈ paramGoodSet n d Ω p (liftN s), ∃ z : Fin n → ℤ, liftChiT n d Ω p s
      (ξ - ratPt (blockProd (goodBlocks (paramRho n d Ω p) (liftN s))) β - latEmbed z) ≠ 0
  · obtain ⟨β, hβ, z, hz⟩ := hact
    simp only [liftD]
    rw [cosetSymbol_eq_of_liftChiT hs (hgT _) hβ hz, Finset.sum_mul]
    refine Finset.sum_congr rfl fun ν _ => ?_
    rw [cosetSymbol_eq_of_liftChiT hs (hgT _) hβ hz, mul_assoc]
  · push Not at hact
    simp only [liftD]
    rw [cosetSymbol_eq_zero_of_liftChiT (hgT _) hact]
    refine (Finset.sum_eq_zero fun ν _ => ?_).symm
    rw [cosetSymbol_eq_zero_of_liftChiT (hgT _) hact, mul_zero]

open scoped NNReal ENNReal in
/-- **Blueprint Lemma 9.3 (`lem:liftsquare`), eq. (9.10) (`eq:liftLpsquare`)**, the `ℓ^p` lifted
square estimate at the fixed exponent `p > 1` (with `r = paramR p`): for `n, d ≥ 1` there are
`δ_p > 0` and `C_p` (independent of `s`, of the family, of `A` and of `f`) such that for every
`s ≥ 1`, every finite family `(m_ν)_{ν ∈ F}` of bounded a.e. strongly measurable symbols such that
every signed sum `∑_ν ε_ν m_ν` (`ε_ν ∈ {-1, 1}`) has Euclidean `L^{2r}` multiplier norm at most
`A ≥ 0` (on Schwartz inputs), and every finitely supported `f`,
`‖(∑_ν sup_{α ∈ 𝓡_s} |Lift_{s,α}[m_ν](D) f|²)^{1/2}‖_p ≤ C_p 2^{-δ_p s} A ‖f‖_p`. -/
theorem lift_square_p (n d : ℕ) (hn : 1 ≤ n) (hd : 1 ≤ d) (Ω : EuclideanSpace ℝ (Fin n) → ℂ)
    {p : ℝ} (hp : 1 < p) :
    ∃ δ : ℝ, 0 < δ ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ s : ℕ, 1 ≤ s →
      ∀ {ι : Type*} (F : Finset ι) (m : ι → EuclideanSpace ℝ (Fin n) → ℂ) (B A : ℝ),
        (∀ ν ∈ F, AEStronglyMeasurable (m ν) volume) → (∀ ν ∈ F, ∀ η, ‖m ν η‖ ≤ B) →
        0 ≤ A →
        (∀ ε : ι → ℝ, (∀ ν ∈ F, ε ν = 1 ∨ ε ν = -1) →
          ∀ G : 𝓢(EuclideanSpace ℝ (Fin n), ℂ),
            eLpNorm (𝓕⁻ (fun ξ => (∑ ν ∈ F, (ε ν : ℂ) * m ν ξ) *
                𝓕 (G : EuclideanSpace ℝ (Fin n) → ℂ) ξ))
              (ENNReal.ofReal (2 * paramR p)) volume ≤
            ENNReal.ofReal A * eLpNorm G (ENNReal.ofReal (2 * paramR p)) volume) →
        ∀ f : (Fin n → ℤ) → ℂ, (Function.support f).Finite →
          eLpNorm (fun x => Real.sqrt (∑ ν ∈ F,
              ((((liftRat s).sup fun aq =>
                ‖latMult (liftSym n d Ω p s aq.1 aq.2 (m ν)) f x‖₊ : ℝ≥0) : ℝ) ^ 2)))
              (ENNReal.ofReal p) Measure.count ≤
            ENNReal.ofReal (C * (2 : ℝ) ^ (-(δ * s)) * A) *
              eLpNorm f (ENNReal.ofReal p) Measure.count := by
  obtain ⟨δ, hδ, Cv, hCv, hv⟩ := arith_maximal_decay_vector_bdd n d hn hd hp
  obtain ⟨CT, hCT, hT⟩ := lift_transference n d Ω hp
  obtain ⟨K, hK0, hKb⟩ := exists_eLpNorm_fourierInv_liftChiT_le n
  have hc := khintchineLowerConst_pos p
  set c := khintchineLowerConst p
  refine ⟨δ, hδ, Cv * (c⁻¹ * (CT * K)), by positivity,
    fun s hs ι F m B A hm hmB hA0 hA f hf => ?_⟩
  classical
  have hf1 : Summable fun z => ‖f z‖ := summable_of_finite_support hf
  obtain ⟨M, hM⟩ := exists_bound_latMult_liftD (d := d) (Ω := Ω) (p := p) (s := s) F hm hmB hf1
  set g : ι → (Fin n → ℤ) → ℂ := fun ν => latMult (liftD n d Ω p s (m ν)) f with hg
  rw [lift_sqrt_sum_eq hs F hm hmB hf1]
  refine (hv Ω p s hs F g M hM).trans ?_
  have hP : (1 : ℝ≥0∞) ≤ ENNReal.ofReal (2 * paramR p) := by
    rw [← ENNReal.ofReal_one]
    refine ENNReal.ofReal_le_ofReal ?_
    have := one_le_paramR p
    have : (1 : ℝ) ≤ paramR p := by exact_mod_cast this
    linarith
  have hsq : eLpNorm (fun x => Real.sqrt (∑ ν ∈ F, ‖g ν x‖ ^ 2)) (ENNReal.ofReal p)
      Measure.count ≤ ENNReal.ofReal c⁻¹ *
        (ENNReal.ofReal (CT * (A * K)) * eLpNorm f (ENNReal.ofReal p) Measure.count) := by
    refine eLpNorm_sqrt_sum_le_of_rademacher F g (fun _ _ => AEStronglyMeasurable.of_discrete)
      (by linarith) fun u _ => ?_
    set ε : ι → ℝ := fun ν => if ν ∈ u then 1 else -1 with hε
    set Mu : EuclideanSpace ℝ (Fin n) → ℂ := fun η => ∑ ν ∈ F, (ε ν : ℂ) * m ν η with hMu
    have hmi : ∀ ν ∈ F, IntegrableOn (liftD n d Ω p s (m ν)) (torusCube n) :=
      fun ν hν => integrableOn_liftD (hm ν hν) (hmB ν hν)
    have e : (fun x => rademacherSum F u (fun ν => g ν x)) =
        cosetMult (blockProd (goodBlocks (paramRho n d Ω p) (liftN s)))
          (fun η => Mu η * (liftChiT n d Ω p s η : ℂ)) (paramGoodSet n d Ω p (liftN s)) f := by
      funext x
      have h1 : rademacherSum F u (fun ν => g ν x) = ∑ ν ∈ F, (ε ν : ℂ) * g ν x := by
        unfold rademacherSum
        refine Finset.sum_congr rfl fun ν _ => ?_
        by_cases h : ν ∈ u <;> simp [hε, h]
      rw [h1, cosetMult]
      have h2 := latMult_sum_mul F (fun ν => (ε ν : ℂ)) hmi hf1 x
      rw [← h2]
      congr 1
      funext ξ
      exact (liftD_sum_smul hs F (fun ν => (ε ν : ℂ)) m ξ).symm
    rw [e]
    have hMum : AEStronglyMeasurable (fun η => Mu η * (liftChiT n d Ω p s η : ℂ)) volume :=
      (Finset.aestronglyMeasurable_fun_sum F fun ν hν =>
        (hm ν hν).const_mul _).mul (continuous_liftChiT s).aestronglyMeasurable
    have hMuB : ∀ ξ, ‖Mu ξ * (liftChiT n d Ω p s ξ : ℂ)‖ ≤ F.card * B := by
      intro ξ
      rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (liftChiT_nonneg s ξ)]
      refine (mul_le_of_le_one_right (norm_nonneg _) (liftChiT_le_one s ξ)).trans ?_
      refine (norm_sum_le _ _).trans ?_
      rw [← nsmul_eq_mul, ← Finset.sum_const]
      refine Finset.sum_le_sum fun ν hν => ?_
      rw [norm_mul]
      have : ‖(ε ν : ℂ)‖ = 1 := by by_cases h : ν ∈ u <;> simp [hε, h]
      rw [this, one_mul]; exact hmB ν hν ξ
    have hsupp : Function.support (fun η => Mu η * (liftChiT n d Ω p s η : ℂ)) ⊆
        {ξ | ∀ i, |ξ i| ≤ 2 / (liftL n d Ω p s : ℝ)} := fun ξ hξ =>
      support_liftChiT s fun h0 => hξ (by simp [h0])
    have hmult := fun G => eLpNorm_fourierInv_mul_liftChiT_le (hKb d Ω p s) hK0 hP
      (hA ε fun ν _ => by by_cases h : ν ∈ u <;> simp [hε, h]) G
    exact hT s hs _ _ _ hMum hMuB hsupp hmult f hf
  calc ENNReal.ofReal (Cv * (2 : ℝ) ^ (-(δ * s))) *
        eLpNorm (fun x => Real.sqrt (∑ ν ∈ F, ‖g ν x‖ ^ 2)) (ENNReal.ofReal p) Measure.count
      ≤ ENNReal.ofReal (Cv * (2 : ℝ) ^ (-(δ * s))) * (ENNReal.ofReal c⁻¹ *
        (ENNReal.ofReal (CT * (A * K)) * eLpNorm f (ENNReal.ofReal p) Measure.count)) := by
        gcongr
    _ = _ := by
        rw [← mul_assoc, ← mul_assoc, ← ENNReal.ofReal_mul (by positivity),
          ← ENNReal.ofReal_mul (by positivity)]
        congr 2
        ring


/-! ### Blueprint Lemma 9.4 (`lem:liftenvelope`): positive envelopes for lifted kernels -/

lemma hasCompactSupport_liftChi (s : ℕ) :
    HasCompactSupport fun ξ : EuclideanSpace ℝ (Fin n) => (liftChi n d Ω p s ξ : ℂ) :=
  HasCompactSupport.intro (isCompact_box (1 / (liftL n d Ω p s : ℝ))) fun ξ hξ => by
    by_contra h
    exact hξ (support_liftChi s (fun h0 => h (by simp [h0])))

/-- `χ_s` as a (complex-valued) Schwartz function. -/
noncomputable def liftChiSchwartz (n d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ)
    (s : ℕ) : 𝓢(EuclideanSpace ℝ (Fin n), ℂ) :=
  (hasCompactSupport_liftChi (n := n) (d := d) (Ω := Ω) (p := p) s).toSchwartzMap
    (Complex.ofRealCLM.contDiff.comp
      (contDiff_liftCutoff.comp (contDiff_const_smul (liftL n d Ω p s : ℝ))))

@[simp] lemma liftChiSchwartz_apply (s : ℕ) (ξ : EuclideanSpace ℝ (Fin n)) :
    liftChiSchwartz n d Ω p s ξ = (liftChi n d Ω p s ξ : ℂ) := rfl

/-- `𝓕 H` is continuous and bounded by `‖H‖_{L¹}` for integrable `H`. -/
lemma continuous_fourier_and_norm_le {H : EuclideanSpace ℝ (Fin n) → ℂ} (hH : Integrable H) :
    Continuous (𝓕 H) ∧ ∀ ξ, ‖𝓕 H ξ‖ ≤ ∫ x, ‖H x‖ := by
  refine ⟨VectorFourier.fourierIntegral_continuous Real.continuous_fourierChar continuous_inner hH,
    fun ξ => ?_⟩
  rw [fourier_eq_integral_eC]
  refine (norm_integral_le_integral_norm _).trans (le_of_eq ?_)
  congr 1; funext x; rw [norm_mul, norm_eC, one_mul]

open scoped Convolution in
/-- The Euclidean kernel of `𝓕H · χ_s` is `H * φ_s` (`H` integrable). -/
lemma fourierInv_fourier_mul_liftChi {H : EuclideanSpace ℝ (Fin n) → ℂ} (hH : Integrable H)
    (s : ℕ) :
    𝓕⁻ (fun ξ => 𝓕 H ξ * (liftChi n d Ω p s ξ : ℂ)) =
      H ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] liftPhi n d Ω p s := by
  set f : 𝓢(EuclideanSpace ℝ (Fin n), ℂ) := 𝓕⁻ (liftChiSchwartz n d Ω p s) with hf
  have hff : 𝓕 (f : EuclideanSpace ℝ (Fin n) → ℂ) = fun ξ => (liftChi n d Ω p s ξ : ℂ) := by
    rw [← SchwartzMap.fourier_coe, hf, FourierTransform.fourier_fourierInv_eq]; rfl
  have hfφ : (f : EuclideanSpace ℝ (Fin n) → ℂ) = liftPhi n d Ω p s := by
    rw [hf, SchwartzMap.fourierInv_coe]; rfl
  have h := fourierInv_fourier_mul_eq_convolution hH (continuous_fourier_and_norm_le hH).2 f
  rw [hff, hfφ] at h
  exact h

open scoped Convolution in
/-- Envelope bound for the kernel: if `|H| ≤ K B_R` (`R > 0`), then
`|H * φ_s| ≤ C K B_{max(R, L_s)}` with `C` depending only on `n`. -/
lemma exists_norm_convolution_liftPhi_le (n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s : ℕ)
      (H : EuclideanSpace ℝ (Fin n) → ℂ) (K R : ℝ), 0 < R → 0 ≤ K →
      (∀ z, ‖H z‖ ≤ K * envelope n R z) → ∀ y : EuclideanSpace ℝ (Fin n),
        ‖(H ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] liftPhi n d Ω p s) y‖ ≤
          C * K * envelope n (max R (liftL n d Ω p s)) y := by
  obtain ⟨Cφ, hCφ, hφ⟩ := norm_liftPhi_le n
  have hcc : 0 ≤ envelopeConvConst n := by
    unfold envelopeConvConst envelopeConst; positivity
  refine ⟨Cφ * envelopeConvConst n, by positivity, fun d Ω p s H K R hR hK hHK y => ?_⟩
  have hL := liftL_pos (n := n) (d := d) (Ω := Ω) (p := p) s
  obtain ⟨hi, hI⟩ := envelope_conv_le (n := n) hL hR y
  rw [MeasureTheory.convolution_def]
  refine (norm_integral_le_integral_norm _).trans ?_
  calc ∫ t, ‖(ContinuousLinearMap.mul ℂ ℂ) (H t) (liftPhi n d Ω p s (y - t))‖
      ≤ ∫ t, K * Cφ * (envelope n (liftL n d Ω p s) (y - t) * envelope n R t) := by
        refine integral_mono_of_nonneg (Filter.Eventually.of_forall fun _ => norm_nonneg _)
          (hi.const_mul _) (Filter.Eventually.of_forall fun t => ?_)
        simp only [ContinuousLinearMap.mul_apply', norm_mul]
        calc ‖H t‖ * ‖liftPhi n d Ω p s (y - t)‖
            ≤ (K * envelope n R t) * (Cφ * envelope n (liftL n d Ω p s) (y - t)) :=
              mul_le_mul (hHK t) ((hφ d Ω p s).1 _) (norm_nonneg _)
                (mul_nonneg hK (envelope_nonneg hR _))
          _ = _ := by ring
    _ = K * Cφ * ∫ t, envelope n (liftL n d Ω p s) (y - t) * envelope n R t :=
        integral_const_mul _ _
    _ ≤ K * Cφ * (envelopeConvConst n * envelope n (max (liftL n d Ω p s : ℝ) R) y) :=
        mul_le_mul_of_nonneg_left hI (by positivity)
    _ = Cφ * envelopeConvConst n * K * envelope n (max R (liftL n d Ω p s)) y := by
        rw [max_comm]; ring

/-- `1 ≤ L_s`. -/
lemma one_le_liftL (s : ℕ) : (1 : ℝ) ≤ liftL n d Ω p s := by
  have := eight_le_liftL (n := n) (d := d) (Ω := Ω) (p := p) s
  linarith


/-- `B_R * |f| ≤ C_n 𝖬 f` in the form used below: for `R ≥ 1`, `f ∈ ℓ¹` and `x`,
`ofReal (∑_y B_R(y) |f(x - y)|) ≤ C_n 𝖬 f(x)`. -/
lemma ofReal_tsum_latEnvelope_mul_le {R : ℝ} (hR : 1 ≤ R) {f : (Fin n → ℤ) → ℂ}
    (hf : Summable fun z => ‖f z‖) (x : Fin n → ℤ) :
    ENNReal.ofReal (∑' y, latEnvelope n R y * ‖f (x - y)‖) ≤
      ENNReal.ofReal (envelopeConst n) * cubeMaximalInt n f x := by
  obtain ⟨hsE, -⟩ := summable_latEnvelope_and_tsum_le (n := n) hR
  have hfb : ∀ z, ‖f z‖ ≤ ∑' z, ‖f z‖ := fun z => hf.le_tsum z fun _ _ => norm_nonneg _
  have hs2 : Summable fun y => latEnvelope n R y * ‖f (x - y)‖ :=
    Summable.of_nonneg_of_le
      (fun y => mul_nonneg (envelope_nonneg (by linarith) _) (norm_nonneg _))
      (fun y => mul_le_mul_of_nonneg_left (hfb _) (envelope_nonneg (by linarith) _))
      (hsE.mul_right _)
  refine le_trans (le_of_eq ((ENNReal.ofReal_tsum_of_nonneg
    (fun y => mul_nonneg (envelope_nonneg (by linarith) _) (norm_nonneg _)) hs2).trans
      (tsum_congr fun y => ?_))) (tsum_envelope_mul_le_cubeMaximalInt hR f x)
  rw [ENNReal.ofReal_mul (envelope_nonneg (by linarith) _), ofReal_norm]
  rfl

/-- The pointwise envelope bound for lifted symbols `𝓕 H` (the proof of Blueprint Lemma 9.4
(`lem:liftenvelope`), for general kernels): there is `C` depending only on `n` such that, if `H`
is integrable with `|H| ≤ K B_R` (`K ≥ 0`, `R > 0`), then for all `s`, `a`, `q ≥ 1`, `f ∈ ℓ¹`
and `x ∈ ℤⁿ`, `|Lift_{s,a/q}[𝓕 H](D) f(x)| ≤ C K ∑_y B_{max(R, L_s)}(y) |f(x - y)|`
(the lattice kernel is `e((a/q) P(y)) (H *_E φ_s)(y)` by Lemma 9.1). -/
theorem norm_latMult_liftSym_fourier_le (n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (d : ℕ) (Ω : EuclideanSpace ℝ (Fin n) → ℂ) (p : ℝ) (s a q : ℕ), 1 ≤ q →
      ∀ (H : EuclideanSpace ℝ (Fin n) → ℂ) (K R : ℝ), Integrable H → 0 < R → 0 ≤ K →
      (∀ z, ‖H z‖ ≤ K * envelope n R z) →
      ∀ f : (Fin n → ℤ) → ℂ, Summable (fun z => ‖f z‖) → ∀ x : Fin n → ℤ,
        ‖latMult (liftSym n d Ω p s a q (𝓕 H)) f x‖ ≤
          C * K * ∑' y, latEnvelope n (max R (liftL n d Ω p s)) y * ‖f (x - y)‖ := by
  obtain ⟨C, hC, hconv⟩ := exists_norm_convolution_liftPhi_le n
  refine ⟨C, hC, fun d Ω p s a q hq H K R hH hR hK hHK f hf x => ?_⟩
  obtain ⟨hFc, hFb⟩ := continuous_fourier_and_norm_le hH
  set R' := max R (liftL n d Ω p s : ℝ) with hR'def
  have hR' : 1 ≤ R' := le_max_of_le_right (one_le_liftL s)
  have hint : IntegrableOn (liftSym n d Ω p s a q (𝓕 H)) (torusCube n) :=
    integrableOn_liftSym (integrable_mul_liftChi hFc.aestronglyMeasurable (fun ξ _ => hFb ξ))
  have hker : ∀ y, ‖latKernel (liftSym n d Ω p s a q (𝓕 H)) y‖ ≤
      C * K * latEnvelope n R' y := by
    intro y
    rw [latKernel_liftSym_of_bdd s a hq hFc.aestronglyMeasurable (fun ξ _ => hFb ξ) y, norm_mul,
      norm_eC, one_mul, fourierInv_fourier_mul_liftChi hH]
    exact hconv d Ω p s H K R hR hK hHK _
  obtain ⟨hsE, -⟩ := summable_latEnvelope_and_tsum_le (n := n) hR'
  have hfb : ∀ z, ‖f z‖ ≤ ∑' z, ‖f z‖ := fun z => hf.le_tsum z fun _ _ => norm_nonneg _
  have hs2 : Summable fun y => latEnvelope n R' y * ‖f (x - y)‖ :=
    Summable.of_nonneg_of_le
      (fun y => mul_nonneg (envelope_nonneg (by linarith) _) (norm_nonneg _))
      (fun y => mul_le_mul_of_nonneg_left (hfb _) (envelope_nonneg (by linarith) _))
      (hsE.mul_right _)
  have hs3 : Summable fun y => C * K * latEnvelope n R' y * ‖f (x - y)‖ :=
    (hs2.mul_left (C * K)).congr fun y => by ring
  have hs1 : Summable fun y => ‖latKernel (liftSym n d Ω p s a q (𝓕 H)) y * f (x - y)‖ :=
    Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun y => by
      rw [norm_mul]; exact mul_le_mul_of_nonneg_right (hker y) (norm_nonneg _)) hs3
  rw [latMult_eq_latConv hint hf, latConv]
  calc ‖∑' y, latKernel (liftSym n d Ω p s a q (𝓕 H)) y * f (x - y)‖
      ≤ ∑' y, ‖latKernel (liftSym n d Ω p s a q (𝓕 H)) y * f (x - y)‖ :=
        norm_tsum_le_tsum_norm hs1
    _ ≤ ∑' y, C * K * latEnvelope n R' y * ‖f (x - y)‖ :=
        hs1.tsum_le_tsum (fun y => by
          rw [norm_mul]; exact mul_le_mul_of_nonneg_right (hker y) (norm_nonneg _)) hs3
    _ = C * K * ∑' y, latEnvelope n R' y * ‖f (x - y)‖ := by
        rw [← tsum_mul_left]; exact tsum_congr fun y => by ring

/-- `|e(μ P) K_j| ≤ C B_{2^j}` uniformly in `j ∈ ℤ` and `μ ∈ ℝ` (Lemma 4.1 and the support of
`K_j` in `|x| < 2^{j+1}`). -/
lemma exists_norm_oscKernel_le {Ω : EuclideanSpace ℝ (Fin n) → ℂ} (hΩ : IsSWProfile Ω) (d : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (j : ℤ) (μ : ℝ) (x : EuclideanSpace ℝ (Fin n)),
      ‖eC (μ * radialPoly n d x) * dyadicKernel Ω j x‖ ≤
        C * envelope n ((2 : ℝ) ^ j) x := by
  obtain ⟨C, hC, hK⟩ := norm_dyadicKernel_le hΩ
  refine ⟨C * 3 ^ (n + 1), by positivity, fun j μ x => ?_⟩
  rw [norm_mul, norm_eC, one_mul]
  have h2 : (0 : ℝ) < 2 ^ j := by positivity
  by_cases hx : dyadicKernel Ω j x = 0
  · rw [hx, norm_zero]
    exact mul_nonneg (by positivity) (envelope_nonneg h2 _)
  have hsupp := (support_dyadicKernel (Ω := Ω) j hx).2
  have hlt : ‖x‖ / 2 ^ j < 2 := by
    rw [div_lt_iff₀ h2]
    calc ‖x‖ < 2 ^ (j + 1) := hsupp
      _ = 2 * 2 ^ j := by rw [zpow_add_one₀ two_ne_zero]; ring
  have hz : (2 : ℝ) ^ (-j * (n : ℤ)) = (((2 : ℝ) ^ j) ^ n)⁻¹ := by
    rw [← zpow_natCast, ← zpow_mul, neg_mul, zpow_neg]
  have h3 : ((1 + ‖x‖ / 2 ^ j) ^ (n + 1))⁻¹ ≥ ((3 : ℝ) ^ (n + 1))⁻¹ := by
    have h0 : 0 ≤ ‖x‖ / 2 ^ j := by positivity
    exact inv_anti₀ (by positivity) (pow_le_pow_left₀ (by positivity) (by linarith) _)
  calc ‖dyadicKernel Ω j x‖ ≤ C * (2 : ℝ) ^ (-j * (n : ℤ)) := hK j x
    _ = C * 3 ^ (n + 1) * ((((2 : ℝ) ^ j) ^ n)⁻¹ * ((3 : ℝ) ^ (n + 1))⁻¹) := by
        rw [hz]; field_simp
    _ ≤ C * 3 ^ (n + 1) * ((((2 : ℝ) ^ j) ^ n)⁻¹ * ((1 + ‖x‖ / 2 ^ j) ^ (n + 1))⁻¹) := by
        gcongr
    _ = C * 3 ^ (n + 1) * envelope n ((2 : ℝ) ^ j) x := rfl

/-- `e(μ P) K_j` is integrable. -/
lemma integrable_oscKernel {Ω : EuclideanSpace ℝ (Fin n) → ℂ} (hΩ : IsSWProfile Ω) (d : ℕ)
    (j : ℤ) (μ : ℝ) :
    Integrable fun x : EuclideanSpace ℝ (Fin n) => eC (μ * radialPoly n d x) * dyadicKernel Ω j x := by
  have hc : Continuous fun x : EuclideanSpace ℝ (Fin n) => eC (μ * radialPoly n d x) := by
    unfold radialPoly; fun_prop
  refine Integrable.mono' (integrable_dyadicKernel hΩ j).norm
    (hc.aestronglyMeasurable.mul (integrable_dyadicKernel hΩ j).aestronglyMeasurable)
    (Filter.Eventually.of_forall fun x => ?_)
  rw [norm_mul, norm_eC, one_mul]

/-- **Blueprint Lemma 9.4 (`lem:liftenvelope`)**, positive envelopes for lifted annular kernels:
for a Stein–Wainger profile `Ω` and `d`, there is `C` (independent of `p`, `s`, `j`, `μ`, `α` and
`f`) such that for every `j ∈ ℤ` (in particular every `j ≥ 1`), every real `μ`, every
`α = a/q` with `q ≥ 1` (in particular every `α ∈ 𝓡_s`), every `f ∈ ℓ¹(ℤⁿ)` (e.g. finitely
supported) and every `x ∈ ℤⁿ`,
`|Lift_{s,α}[Φ_{j,μ}](D) f(x)| ≤ C (B_{max(2^j, L_s)} * |f|)(x) ≤ C C_n 𝖬 f(x)`,
where `Φ_{j,μ} = radialOscPhi Ω d j μ`, `B_R` is the envelope and `𝖬 = cubeMaximalInt`. -/
theorem lift_envelope (n d : ℕ) {Ω : EuclideanSpace ℝ (Fin n) → ℂ} (hΩ : IsSWProfile Ω) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (p : ℝ) (s : ℕ) (j : ℤ) (μ : ℝ) (a q : ℕ), 1 ≤ q →
      ∀ f : (Fin n → ℤ) → ℂ, Summable (fun z => ‖f z‖) → ∀ x : Fin n → ℤ,
        ‖latMult (liftSym n d Ω p s a q (radialOscPhi Ω d j μ)) f x‖ ≤
            C * ∑' y, latEnvelope n (max ((2 : ℝ) ^ j) (liftL n d Ω p s)) y * ‖f (x - y)‖ ∧
          ‖latMult (liftSym n d Ω p s a q (radialOscPhi Ω d j μ)) f x‖ₑ ≤
            ENNReal.ofReal (C * envelopeConst n) * cubeMaximalInt n f x := by
  obtain ⟨C₁, hC₁, h₁⟩ := norm_latMult_liftSym_fourier_le n
  obtain ⟨C₂, hC₂, h₂⟩ := exists_norm_oscKernel_le hΩ d
  refine ⟨C₁ * C₂, by positivity, fun p s j μ a q hq f hf x => ?_⟩
  have hR : (0 : ℝ) < 2 ^ j := by positivity
  have h := h₁ d Ω p s a q hq _ C₂ _ (integrable_oscKernel hΩ d j μ) hR hC₂
    (fun z => h₂ j μ z) f hf x
  have e : radialOscPhi Ω d j μ = 𝓕 fun x => eC (μ * radialPoly n d x) * dyadicKernel Ω j x := by
    funext ξ; rfl
  rw [← e] at h
  refine ⟨h, ?_⟩
  have hR' : 1 ≤ max ((2 : ℝ) ^ j) (liftL n d Ω p s) := le_max_of_le_right (one_le_liftL s)
  rw [← ofReal_norm]
  refine (ENNReal.ofReal_le_ofReal h).trans ?_
  have hS0 : 0 ≤ ∑' y, latEnvelope n (max ((2 : ℝ) ^ j) (liftL n d Ω p s)) y * ‖f (x - y)‖ :=
    tsum_nonneg fun y => mul_nonneg (envelope_nonneg (by linarith) _) (norm_nonneg _)
  rw [ENNReal.ofReal_mul (by positivity)]
  refine (mul_le_mul' le_rfl (ofReal_tsum_latEnvelope_mul_le hR' hf x)).trans (le_of_eq ?_)
  rw [← mul_assoc, ← ENNReal.ofReal_mul (by positivity)]

open scoped ENNReal in
/-- **Blueprint Lemma 9.4 (`lem:liftenvelope`)**, the supremum over all indices at fixed `s`:
with `C` from `lift_envelope`, for every `f ∈ ℓ¹` and `x`,
`sup_{j, μ, α ∈ 𝓡_s} |Lift_{s,α}[Φ_{j,μ}](D) f(x)| ≤ C C_n 𝖬 f(x)`. -/
theorem lift_envelope_sup (n d : ℕ) {Ω : EuclideanSpace ℝ (Fin n) → ℂ} (hΩ : IsSWProfile Ω) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (p : ℝ) (s : ℕ) (f : (Fin n → ℤ) → ℂ), Summable (fun z => ‖f z‖) →
      ∀ x : Fin n → ℤ,
        (⨆ (j : ℤ) (μ : ℝ) (aq ∈ liftRat s),
          ‖latMult (liftSym n d Ω p s aq.1 aq.2 (radialOscPhi Ω d j μ)) f x‖ₑ) ≤
            ENNReal.ofReal (C * envelopeConst n) * cubeMaximalInt n f x := by
  obtain ⟨C, hC, h⟩ := lift_envelope n d hΩ
  refine ⟨C, hC, fun p s f hf x => iSup_le fun j => iSup_le fun μ => iSup₂_le fun aq haq => ?_⟩
  exact (h p s j μ aq.1 aq.2 (one_le_of_mem_liftRat (a := aq.1) (by simpa using haq)) f hf x).2

end Auto
