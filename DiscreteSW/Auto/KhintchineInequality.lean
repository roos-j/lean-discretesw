  have hq0 : 0 < q := by linarith
  have hw : ∑ _u ∈ s.powerset, N⁻¹ = 1 := by
    rw [Finset.sum_const, Finset.card_powerset, nsmul_eq_mul]
    push_cast
    exact mul_inv_cancel₀ hN.ne'
  have hpm := Real.rpow_arith_mean_le_arith_mean_rpow s.powerset (fun _ => N⁻¹)
