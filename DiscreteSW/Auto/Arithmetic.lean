    refine pow_le_pow_right₀ hM1 ?_
    calc #{p ∈ q.primeFactors | p < B} ≤ #(range B) :=
          card_le_card fun p hp => by simp only [mem_filter] at hp; simpa using hp.2
      _ = B := card_range B
  calc ∏ p ∈ q.primeFactors, ((q.factorization p : ℝ) + 1)
      ≤ ∏ p ∈ q.primeFactors, (g p * (p : ℝ) ^ (ε * q.factorization p)) :=
        prod_le_prod₀ (fun p _ => by positivity) hpt
    _ = (∏ p ∈ q.primeFactors, g p) * ∏ p ∈ q.primeFactors, (p : ℝ) ^ (ε * q.factorization p) :=
        prod_mul_distrib
    _ ≤ M ^ B * ∏ p ∈ q.primeFactors, (p : ℝ) ^ (ε * q.factorization p) :=
        mul_le_mul_of_nonneg_right hg (prod_nonneg fun p _ => by positivity)

/-- Blueprint Lemma 3.2 (`lem:divisor`), second assertion (rational separation): for integers
`a, b` and positive integers `q, r`, if `a/q - b/r ∉ ℤ` then `|a/q - b/r - m| ≥ 1/(qr)` for every
integer `m`, i.e. `‖a/q - b/r‖_𝕋 ≥ 1/(qr)`. -/
theorem one_div_mul_le_abs_sub_int (a b : ℤ) {q r : ℤ} (hq : 0 < q) (hr : 0 < r)
    (hx : ¬ ∃ m : ℤ, (a / q - b / r : ℝ) = m) (m : ℤ) :
    1 / ((q : ℝ) * r) ≤ |(a / q - b / r : ℝ) - m| := by
  have hq' : (0 : ℝ) < q := by exact_mod_cast hq
  have hr' : (0 : ℝ) < r := by exact_mod_cast hr
  set k : ℤ := a * r - b * q - q * r * m
  have hk : ((q : ℝ) * r) * ((a / q - b / r : ℝ) - m) = k := by
    simp only [k]; push_cast; field_simp
  have hk0 : k ≠ 0 := by
    intro h0
    rw [h0, Int.cast_zero, mul_eq_zero] at hk
    rcases hk with hk | hk
    · exact (mul_pos hq' hr').ne' hk
    · exact hx ⟨m, by linarith⟩
  have hk1 : (1 : ℝ) ≤ |(k : ℝ)| := by
    rw [← Int.cast_abs]; exact_mod_cast Int.one_le_abs hk0
  rw [div_le_iff₀ (mul_pos hq' hr'), ← abs_of_pos (mul_pos hq' hr'), ← abs_mul]
  rw [mul_comm, hk]
  exact hk1

/-- Blueprint Lemma 3.2 (`lem:divisor`), second assertion, in the `AddCircle` convention:
if `a/q - b/r ∉ ℤ` then `‖a/q - b/r‖_{ℝ/ℤ} ≥ 1/(qr)`. -/
theorem one_div_mul_le_norm_addCircle (a b : ℤ) {q r : ℤ} (hq : 0 < q) (hr : 0 < r)
    (hx : ¬ ∃ m : ℤ, (a / q - b / r : ℝ) = m) :
    1 / ((q : ℝ) * r) ≤ ‖((a / q - b / r : ℝ) : UnitAddCircle)‖ := by
  rw [UnitAddCircle.norm_eq]
  exact one_div_mul_le_abs_sub_int a b hq hr hx _

/-- Integer core of the progression count: `#{h ∈ [a, b] : r ∣ D h} · r ≤ D (b - a) + 1 + r`. -/
lemma card_filter_dvd_mul_Icc_mul_le {r D : ℕ} (hr : 0 < r) (hD : 0 < D) {a b : ℤ}
    (hab : a ≤ b) :
    (#{h ∈ Icc a b | (r : ℤ) ∣ D * h} : ℤ) * r ≤ D * (b - a) + 1 + r := by
  have hr' : (0 : ℤ) < r := by exact_mod_cast hr
  have hD' : (0 : ℤ) < D := by exact_mod_cast hD
  have hle : #{h ∈ Icc a b | (r : ℤ) ∣ D * h} ≤
      #{x ∈ Ioc (D * a - 1) (D * b) | (r : ℤ) ∣ x} := by
    refine card_le_card_of_injOn (fun h => (D : ℤ) * h) ?_ ?_
    · intro h hh
      simp only [coe_filter, mem_Icc, Set.mem_ofPred_eq, mem_Ioc] at hh ⊢
      refine ⟨⟨?_, ?_⟩, hh.2⟩
      · nlinarith [hh.1.1]
      · nlinarith [hh.1.2]
    · intro h₁ _ h₂ _ he
      exact mul_left_cancel₀ hD'.ne' he
  have hcard := Int.Ioc_filter_dvd_card (D * a - 1) (D * b) hr'
  simp only [Int.cast_natCast, Rat.floor_intCast_div_natCast] at hcard
  have h1 := Int.ediv_mul_le (D * b) hr'.ne'
  have h2 := Int.lt_ediv_add_one_mul_self (D * a - 1) hr'
  have hmax : max ((D * b) / (r : ℤ) - (D * a - 1) / (r : ℤ)) 0 * r ≤ D * (b - a) + 1 + r := by
    rcases le_total ((D * b) / (r : ℤ) - (D * a - 1) / (r : ℤ)) 0 with h | h
    · rw [max_eq_right h, zero_mul]; nlinarith
    · rw [max_eq_left h]; nlinarith
  calc (#{h ∈ Icc a b | (r : ℤ) ∣ D * h} : ℤ) * r
      ≤ (#{x ∈ Ioc (D * a - 1) (D * b) | (r : ℤ) ∣ x} : ℤ) * r :=
        mul_le_mul_of_nonneg_right (by exact_mod_cast hle) hr'.le
    _ ≤ D * (b - a) + 1 + r := by rw [hcard]; exact hmax

/-- Blueprint Lemma 3.2 (`lem:divisor`), third assertion (progression count): for positive
integers `r, D` and `L ≥ 0`, among any integers lying in an interval `[x, x + L]` at most
`D L / r + D + 1` satisfy `r ∣ D h`. (The blueprint's hypothesis `r ∣ q` is not needed.) -/
theorem card_filter_dvd_mul_le {r D : ℕ} (hr : 0 < r) (hD : 0 < D) {L : ℝ} (hL : 0 ≤ L)
    (x : ℝ) (S : Finset ℤ) (hS : ∀ h ∈ S, x ≤ (h : ℝ) ∧ (h : ℝ) ≤ x + L) :
    (#{h ∈ S | (r : ℤ) ∣ D * h} : ℝ) ≤ D * L / r + D + 1 := by
  have hr' : (0 : ℝ) < r := by exact_mod_cast hr
  have hD1 : (1 : ℝ) ≤ D := by exact_mod_cast hD
  have hsub : {h ∈ S | (r : ℤ) ∣ D * h} ⊆ {h ∈ Icc ⌈x⌉ ⌊x + L⌋ | (r : ℤ) ∣ D * h} := by
    intro h hh
    simp only [mem_filter, mem_Icc] at hh ⊢
    exact ⟨⟨Int.ceil_le.2 (hS h hh.1).1, Int.le_floor.2 (hS h hh.1).2⟩, hh.2⟩
  have hcard := card_le_card hsub
  have hrhs : 0 ≤ (D : ℝ) * L / r + D + 1 := by positivity
  rcases lt_or_ge ⌊x + L⌋ ⌈x⌉ with hlt | hab
  · rw [Icc_eq_empty_of_lt hlt, filter_empty, card_empty, Nat.le_zero] at hcard
    rw [hcard]; simpa using hrhs
  have hcore := card_filter_dvd_mul_Icc_mul_le hr hD hab
  have hcoreR : (#{h ∈ Icc ⌈x⌉ ⌊x + L⌋ | (r : ℤ) ∣ D * h} : ℝ) * r ≤
      D * ((⌊x + L⌋ : ℝ) - ⌈x⌉) + 1 + r := by exact_mod_cast hcore
  have hba : ((⌊x + L⌋ : ℝ) - ⌈x⌉) ≤ L := by
    have := Int.floor_le (x + L); have := Int.le_ceil x; linarith
  have hN : (#{h ∈ S | (r : ℤ) ∣ D * h} : ℝ) ≤ #{h ∈ Icc ⌈x⌉ ⌊x + L⌋ | (r : ℤ) ∣ D * h} := by
    exact_mod_cast hcard
  rw [div_add' _ _ _ hr'.ne', div_add' _ _ _ hr'.ne', le_div_iff₀ hr']
  have hrD : (1 : ℝ) ≤ D * r := by nlinarith [(by exact_mod_cast hr : (1 : ℝ) ≤ r)]
  have : (D : ℝ) * ((⌊x + L⌋ : ℝ) - ⌈x⌉) ≤ D * L := mul_le_mul_of_nonneg_left hba (by linarith)
  nlinarith

/-! ### Lemma 3.3 -/

/-- A finite set of naturals whose pairwise differences are at most `D` has at most
`⌊D⌋₊ + 1` elements. -/
lemma card_le_floor_add_one_of_sub_le (S : Finset ℕ) {D : ℝ}
    (h : ∀ x ∈ S, ∀ y ∈ S, (x : ℝ) - y ≤ D) : #S ≤ ⌊D⌋₊ + 1 := by
  rcases S.eq_empty_or_nonempty with hS | hS
  · simp [hS]
  set m := S.min' hS
  have hsub : S ⊆ Icc m (m + ⌊D⌋₊) := by
    intro x hx
    have hmx : m ≤ x := S.min'_le x hx
    have hD := h x hx m (S.min'_mem hS)
    have : x - m ≤ ⌊D⌋₊ := Nat.le_floor (by push_cast [hmx]; exact hD)
    simp only [mem_Icc]; omega
  calc #S ≤ #(Icc m (m + ⌊D⌋₊)) := card_le_card hsub
    _ = ⌊D⌋₊ + 1 := by rw [Nat.card_Icc]; omega

/-- Pigeonhole step of Lemma 3.3: a set `H ⊆ {1, …, N}` with `#H ≥ ηN ≥ 2` contains two
elements `h < h'` with `h' - h < 2/η`. -/
lemma exists_lt_sub_lt_of_card {η : ℝ} (hη : 0 < η) {N : ℕ} {H : Finset ℕ}
    (hH : H ⊆ Icc 1 N) (hcard : η * N ≤ #H) (hηN : 2 < η * N) :
    ∃ h ∈ H, ∃ h' ∈ H, h < h' ∧ ((h' - h : ℕ) : ℝ) < 2 / η := by
  set f : ℕ → ℕ := fun h => ⌊h * η / 2⌋₊
  have hmaps : Set.MapsTo f H (range (⌊N * η / 2⌋₊ + 1)) := by
    intro h hh
    have hhN : h ≤ N := (mem_Icc.1 (hH hh)).2
    simp only [coe_range, Set.mem_Iio, f]
    refine Nat.lt_succ_of_le (Nat.floor_le_floor ?_)
    have : (h : ℝ) ≤ N := by exact_mod_cast hhN
    have := mul_le_mul_of_nonneg_right this hη.le
    linarith
  have hlt : #(range (⌊N * η / 2⌋₊ + 1)) < #H := by
    rw [card_range]
    have h1 : (⌊N * η / 2⌋₊ : ℝ) ≤ N * η / 2 := Nat.floor_le (by positivity)
    have : ((⌊N * η / 2⌋₊ + 1 : ℕ) : ℝ) < #H := by push_cast; nlinarith
    exact_mod_cast this
  obtain ⟨x, hx, y, hy, hxy, hf⟩ := exists_ne_map_eq_of_card_lt_of_maps_to hlt hmaps
  have key : ∀ u v : ℕ, u < v → f u = f v → ((v - u : ℕ) : ℝ) < 2 / η := by
    intro u v huv he
    have h1 := Nat.floor_le (show (0 : ℝ) ≤ u * η / 2 by positivity)
    have h2 := Nat.lt_floor_add_one (v * η / 2)
    simp only [f] at he
    rw [← he] at h2
    rw [Nat.cast_sub huv.le, lt_div_iff₀ hη]
    linarith
  rcases lt_or_gt_of_ne hxy with h | h
  · exact ⟨x, hx, y, hy, h, key x y h hf⟩
  · exact ⟨y, hy, x, hx, h, key y x h hf.symm⟩

/-- Counting step of Lemma 3.3: if `r ≥ 1`, `g = ‖rα‖_𝕋 > 0`, `H ⊆ {1, …, N}` and
`‖hα‖_𝕋 ≤ E` on `H`, then `#H ≤ (2E/g + 1)(2r + 2Ng + 2rE)`. -/
lemma card_le_of_norm_mul_le {α E : ℝ} {r N : ℕ} (hr : 0 < r) {H : Finset ℕ}
    (hH : H ⊆ Icc 1 N) (hE : ∀ h ∈ H, ‖((h * α : ℝ) : UnitAddCircle)‖ ≤ E)
    (hg : 0 < ‖((r * α : ℝ) : UnitAddCircle)‖) (hE0 : 0 ≤ E) :
    (#H : ℝ) ≤ (2 * E / ‖((r * α : ℝ) : UnitAddCircle)‖ + 1) *
      (2 * r + 2 * N * ‖((r * α : ℝ) : UnitAddCircle)‖ + 2 * r * E) := by
  set g := ‖((r * α : ℝ) : UnitAddCircle)‖ with hg_def
  set a := round ((r : ℝ) * α)
  set γ := (r : ℝ) * α - a
  have hγ : g = |γ| := by rw [hg_def, UnitAddCircle.norm_eq]
  have hr' : (0 : ℝ) < r := by exact_mod_cast hr
  set e : ℕ → ℝ := fun h => (h : ℝ) * α - round ((h : ℝ) * α)
  set k : ℕ → ℤ := fun h =>
    round ((h : ℝ) * α) - ((h / r : ℕ) : ℤ) * a - round (((h % r : ℕ) : ℝ) * α)
  have hid : ∀ h : ℕ, e h = (((h % r : ℕ) : ℝ) * α - round (((h % r : ℕ) : ℝ) * α)) +
      ((h / r : ℕ) : ℝ) * γ - (k h : ℝ) := by
    intro h
    have hh : (h : ℝ) = ((h % r : ℕ) : ℝ) + r * ((h / r : ℕ) : ℝ) := by
      exact_mod_cast (Nat.mod_add_div h r).symm
    simp only [e, k, γ, Int.cast_sub, Int.cast_mul, Int.cast_natCast]
    rw [hh]
    ring
  have heE : ∀ h ∈ H, |e h| ≤ E := by
    intro h hh
    have := hE h hh
    rwa [UnitAddCircle.norm_eq] at this
  set Xb : ℝ := 1 / 2 + N * g / r + E
  set K : ℤ := ⌊Xb⌋
  set φ : ℕ → ℕ × ℤ := fun h => (h % r, k h)
  set T : Finset (ℕ × ℤ) := range r ×ˢ Icc (-K) K
  have ht : ∀ h ∈ H, ((h / r : ℕ) : ℝ) ≤ N / r := by
    intro h hh
    have hhN : (h : ℝ) ≤ N := by exact_mod_cast (mem_Icc.1 (hH hh)).2
    exact Nat.cast_div_le.trans (div_le_div_of_nonneg_right hhN hr'.le)
  have hkX : ∀ h ∈ H, |(k h : ℝ)| ≤ Xb := by
    intro h hh
    have hk : (k h : ℝ) = (((h % r : ℕ) : ℝ) * α - round (((h % r : ℕ) : ℝ) * α)) +
        ((h / r : ℕ) : ℝ) * γ - e h := by linarith [hid h]
    have h1 := abs_sub_round (((h % r : ℕ) : ℝ) * α)
    have h2 : |((h / r : ℕ) : ℝ) * γ| ≤ N * g / r := by
      rw [abs_mul, ← hγ, abs_of_nonneg (Nat.cast_nonneg _), mul_div_right_comm]
      exact mul_le_mul_of_nonneg_right (ht h hh) (norm_nonneg _)
    have h3 := heE h hh
    rw [hk]
    have h4 := abs_sub ((((h % r : ℕ) : ℝ) * α - round (((h % r : ℕ) : ℝ) * α)) +
          ((h / r : ℕ) : ℝ) * γ) (e h)
    have h5 := abs_add_le (((h % r : ℕ) : ℝ) * α - round (((h % r : ℕ) : ℝ) * α))
          (((h / r : ℕ) : ℝ) * γ)
    show _ ≤ 1 / 2 + N * g / r + E
    linarith
  have hmaps : ∀ h ∈ H, φ h ∈ T := by
    intro h hh
    have := abs_le.1 (hkX h hh)
    simp only [T, φ, mem_product, mem_range, mem_Icc]
    refine ⟨Nat.mod_lt _ hr, ?_, Int.le_floor.2 this.2⟩
    have : -k h ≤ K := Int.le_floor.2 (by push_cast; linarith)
    omega
  have hfib : ∀ b ∈ T, #{h ∈ H | φ h = b} ≤ ⌊2 * E / g⌋₊ + 1 := by
    intro b _
    have hinj : Set.InjOn (fun h : ℕ => h / r) ({h ∈ H | φ h = b} : Finset ℕ) := by
      intro h₁ hh₁ h₂ hh₂ he
      simp only [coe_filter, Set.mem_ofPred_eq] at hh₁ hh₂
      have hm : h₁ % r = h₂ % r := by
        have := hh₁.2.trans hh₂.2.symm
        exact (Prod.ext_iff.1 this).1
      simp only at he
      rw [← Nat.mod_add_div h₁ r, ← Nat.mod_add_div h₂ r, hm, he]
    rw [← card_image_of_injOn hinj]
    apply card_le_floor_add_one_of_sub_le
    intro x hx y hy
    obtain ⟨h₁, hh₁, rfl⟩ := mem_image.1 hx
    obtain ⟨h₂, hh₂, rfl⟩ := mem_image.1 hy
    rw [mem_filter] at hh₁ hh₂
    have he := hh₁.2.trans hh₂.2.symm
    have hm : h₁ % r = h₂ % r := (Prod.ext_iff.1 he).1
    have hkk : k h₁ = k h₂ := (Prod.ext_iff.1 he).2
    have hdiff : e h₁ - e h₂ = (((h₁ / r : ℕ) : ℝ) - ((h₂ / r : ℕ) : ℝ)) * γ := by
      rw [hid h₁, hid h₂, hm, hkk]; ring
    have hb : |e h₁ - e h₂| ≤ 2 * E := by
      have := abs_sub (e h₁) (e h₂)
      linarith [heE h₁ hh₁.1, heE h₂ hh₂.1]
    rw [le_div_iff₀ hg]
    calc (((h₁ / r : ℕ) : ℝ) - ((h₂ / r : ℕ) : ℝ)) * g
        ≤ |((h₁ / r : ℕ) : ℝ) - ((h₂ / r : ℕ) : ℝ)| * g :=
          mul_le_mul_of_nonneg_right (le_abs_self _) hg.le
      _ = |e h₁ - e h₂| := by rw [hdiff, abs_mul, hγ]
      _ ≤ 2 * E := hb
  have hmain := card_le_mul_card_image_of_maps_to hmaps _ hfib
  have hK0 : 0 ≤ K := Int.floor_nonneg.2 (by positivity)
  have hT : ((#T : ℕ) : ℝ) = r * (2 * K + 1) := by
    have : ((#T : ℕ) : ℤ) = r * (2 * K + 1) := by
      simp only [T, card_product, card_range, Int.card_Icc]
      push_cast
      rw [Int.toNat_of_nonneg (by omega)]
      ring
    exact_mod_cast this
  have hKX : (K : ℝ) ≤ Xb := Int.floor_le Xb
  have hmainR : (#H : ℝ) ≤ ((⌊2 * E / g⌋₊ + 1 : ℕ) : ℝ) * (#T : ℕ) := by exact_mod_cast hmain
  have hfl : ((⌊2 * E / g⌋₊ + 1 : ℕ) : ℝ) ≤ 2 * E / g + 1 := by
    push_cast; linarith [Nat.floor_le (show 0 ≤ 2 * E / g by positivity)]
  have hTX : ((#T : ℕ) : ℝ) ≤ 2 * r + 2 * N * g + 2 * r * E := by
    rw [hT]
    have : (r : ℝ) * (2 * K + 1) ≤ r * (2 * Xb + 1) :=
      mul_le_mul_of_nonneg_left (by linarith) hr'.le
    refine this.trans (le_of_eq ?_)
    simp only [Xb]
    field_simp
    ring
  calc (#H : ℝ) ≤ ((⌊2 * E / g⌋₊ + 1 : ℕ) : ℝ) * (#T : ℕ) := hmainR
    _ ≤ (2 * E / g + 1) * (2 * r + 2 * N * g + 2 * r * E) :=
      mul_le_mul hfl hTX (Nat.cast_nonneg _) (by positivity)

/-- Blueprint Lemma 3.3 (`lem:multiples`), first assertion, with explicit constants `c = 1/32`,
`C = 24`: if `0 < η ≤ 1`, `0 ≤ E ≤ η/32`, `N ≥ 24 η⁻²`, `H ⊆ {1, …, N}` has at least `ηN`
elements and `‖hα‖_𝕋 ≤ E` for every `h ∈ H`, then there is an integer `1 ≤ r ≤ 2/η` with
`‖rα‖_𝕋 ≤ 24 E η⁻² N⁻¹`. -/
theorem norm_mul_le_of_many_multiples {α η E : ℝ} (hη : 0 < η) (hη1 : η ≤ 1) (hE0 : 0 ≤ E)
    (hE : E ≤ η / 32) {N : ℕ} (hN : 24 / η ^ 2 ≤ N) {H : Finset ℕ} (hH : H ⊆ Icc 1 N)
    (hcard : η * N ≤ #H) (hHE : ∀ h ∈ H, ‖((h * α : ℝ) : UnitAddCircle)‖ ≤ E) :
    ∃ r : ℕ, 1 ≤ r ∧ (r : ℝ) ≤ 2 / η ∧
      ‖((r * α : ℝ) : UnitAddCircle)‖ ≤ 24 * E / (η ^ 2 * N) := by
  have hη2 : 0 < η ^ 2 := by positivity
  have hNη : 24 ≤ η ^ 2 * N := by rwa [div_le_iff₀' hη2] at hN
  have hN0 : (0 : ℝ) < N := by
    have : 0 < 24 / η ^ 2 := by positivity
    linarith
  have hηN : 2 < η * N := by nlinarith
  obtain ⟨h, hh, h', hh', hlt, hr⟩ := exists_lt_sub_lt_of_card hη hH hcard hηN
  set r := h' - h with hr_def
  refine ⟨r, by omega, hr.le, ?_⟩
  set g := ‖((r * α : ℝ) : UnitAddCircle)‖ with hg_def
  have hg2 : g ≤ 2 * E := by
    have hcast : ((r : ℝ) * α) = (h' : ℝ) * α - (h : ℝ) * α := by
      rw [hr_def, Nat.cast_sub hlt.le]; ring
    rw [hg_def, hcast, AddCircle.coe_sub]
    linarith [norm_sub_le (((h' : ℝ) * α : ℝ) : UnitAddCircle) (((h : ℝ) * α : ℝ) : UnitAddCircle),
      hHE h hh, hHE h' hh']
  have hr1 : (1 : ℝ) ≤ r := by exact_mod_cast (show 1 ≤ r by omega)
  have hrη : (r : ℝ) * η ≤ 2 := by
    have := (lt_div_iff₀ hη).1 hr; linarith
  rcases (norm_nonneg _ : (0 : ℝ) ≤ g).eq_or_lt with hg0 | hg0
  · rw [show g = 0 from hg0.symm]; positivity
  have hmain := hcard.trans (card_le_of_norm_mul_le (by omega) hH hHE hg0 hE0)
  set D := 2 * E / g with hD
  have hD0 : 0 ≤ D := by positivity
  have hDg : D * g = 2 * E := by rw [hD, div_mul_cancel₀ _ hg0.ne']
  have hexp : (D + 1) * (2 * r + 2 * N * g + 2 * r * E) =
      2 * r * (1 + E) * D + 2 * r * (1 + E) + 2 * N * (D * g) + 2 * N * g := by ring
  rw [hexp, hDg] at hmain
  have h3r : 3 * (r : ℝ) ≤ η * N / 4 := by
    have : η * (3 * r) ≤ η * (η * N / 4) := by nlinarith
    exact le_of_mul_le_mul_left this hη
  have hE12 : E ≤ 1 / 2 := by linarith
  have hrE : 2 * r * (1 + E) ≤ 3 * r := by nlinarith
  have hrED : 2 * r * (1 + E) * D ≤ 3 * r * D := mul_le_mul_of_nonneg_right hrE hD0
  have hNE : 8 * E * N ≤ η * N / 4 := by nlinarith
  have hNg : 2 * N * g ≤ 4 * E * N := by nlinarith
  have hkey : η * N / 2 ≤ 3 * r * D := by nlinarith
  have hkey' : η * N * g ≤ 12 * r * E := by
    have := mul_le_mul_of_nonneg_right hkey hg0.le
    have h6 : 3 * r * D * g = 6 * r * E := by rw [mul_assoc, hDg]; ring
    nlinarith
  rw [le_div_iff₀ (by positivity)]
  have : η * (η * N * g) ≤ η * (12 * r * E) := mul_le_mul_of_nonneg_left hkey' hη.le
  nlinarith

/-- Blueprint Lemma 3.3 (`lem:multiples`), first assertion: there are absolute constants
`c, C > 0` such that whenever `0 < η ≤ 1`, `0 ≤ E ≤ cη`, `N ≥ C η⁻²`, `H ⊆ {1, …, N}` has at
least `ηN` elements and `‖hα‖_𝕋 ≤ E` for all `h ∈ H`, there is an integer `1 ≤ r ≤ 2/η` with
`‖rα‖_𝕋 ≤ C E η⁻² N⁻¹`. -/
theorem exists_norm_mul_le_of_many_multiples :
    ∃ c C : ℝ, 0 < c ∧ 0 < C ∧ ∀ (α η E : ℝ) (N : ℕ) (H : Finset ℕ), 0 < η → η ≤ 1 →
      0 ≤ E → E ≤ c * η → C / η ^ 2 ≤ N → H ⊆ Icc 1 N → η * N ≤ #H →
      (∀ h ∈ H, ‖((h * α : ℝ) : UnitAddCircle)‖ ≤ E) →
      ∃ r : ℕ, 1 ≤ r ∧ (r : ℝ) ≤ 2 / η ∧
        ‖((r * α : ℝ) : UnitAddCircle)‖ ≤ C * E / (η ^ 2 * N) :=
  ⟨1 / 32, 24, by norm_num, by norm_num, fun _ _ _ _ _ hη hη1 hE0 hE hN hH hcard hHE =>
    norm_mul_le_of_many_multiples hη hη1 hE0 (by linarith) hN hH hcard hHE⟩

/-- Positive half of the signed case of Lemma 3.3: positive integers `h ≤ c₀ N`, at least
`ηN/4` of them, with `‖hα‖_𝕋 ≤ E`. -/
lemma norm_mul_le_of_many_multiples_pos {c₀ α η E : ℝ} (hc₀ : 0 < c₀) (hη : 0 < η)
    (hη1 : η ≤ 1) (hE0 : 0 ≤ E) (hE : E ≤ η / (128 * (c₀ + 1))) {N : ℕ}
    (hN : 384 * (c₀ + 1) ^ 2 / (c₀ * η ^ 2) ≤ N) {P : Finset ℤ}
    (hP : ∀ h ∈ P, 0 < h ∧ (h : ℝ) ≤ c₀ * N) (hcard : η * N / 4 ≤ #P)
    (hPE : ∀ h ∈ P, ‖((h * α : ℝ) : UnitAddCircle)‖ ≤ E) :
    ∃ r : ℕ, 1 ≤ r ∧ (r : ℝ) ≤ 8 * (c₀ + 1) / η ∧
      ‖((r * α : ℝ) : UnitAddCircle)‖ ≤ 384 * (c₀ + 1) ^ 2 / c₀ * E / (η ^ 2 * N) := by
  have hc1 : 0 < c₀ + 1 := by linarith
  have hη2 : 0 < η ^ 2 := by positivity
  have hN0 : (0 : ℝ) < N := lt_of_lt_of_le (by positivity) hN
  set N' := ⌈c₀ * N⌉₊
  have hN'1 : c₀ * N ≤ N' := Nat.le_ceil _
  have hN1 : (1 : ℝ) ≤ N := by
    have : 0 < N := by exact_mod_cast hN0
    exact_mod_cast this
  have hN'2 : (N' : ℝ) ≤ (c₀ + 1) * N := by
    have := Nat.ceil_lt_add_one (show 0 ≤ c₀ * (N : ℝ) by positivity); nlinarith
  set η' := η / (4 * (c₀ + 1))
  have hη' : 0 < η' := by positivity
  have hη'1 : η' ≤ 1 := by
    rw [div_le_one (by positivity)]; linarith
  set H' : Finset ℕ := P.image Int.toNat
  have hinj : Set.InjOn Int.toNat (P : Set ℤ) := by
    intro x hx y hy hxy
    have := (hP x hx).1; have := (hP y hy).1
    omega
  have hcardH' : #H' = #P := card_image_of_injOn hinj
  have hmemH' : ∀ h' ∈ H', ∃ h ∈ P, (h' : ℤ) = h := by
    intro h' hh'
    obtain ⟨h, hh, rfl⟩ := mem_image.1 hh'
    exact ⟨h, hh, Int.toNat_of_nonneg (hP h hh).1.le⟩
  have hsub : H' ⊆ Icc 1 N' := by
    intro h' hh'
    obtain ⟨h, hh, he⟩ := hmemH' h' hh'
    have h1 := (hP h hh).1
    have h2 : (h' : ℝ) ≤ N' := by
      have : (h' : ℝ) = (h : ℝ) := by exact_mod_cast he
      linarith [(hP h hh).2]
    rw [mem_Icc]
    exact ⟨by omega, by exact_mod_cast h2⟩
  have hE' : E ≤ η' / 32 := by
    simp only [η']; rw [div_div]; convert hE using 2; ring
  have hN' : 24 / η' ^ 2 ≤ N' := by
    have : 24 / η' ^ 2 = 384 * (c₀ + 1) ^ 2 / η ^ 2 := by
      simp only [η']; field_simp; ring
    rw [this]
    refine le_trans ?_ hN'1
    rw [div_le_iff₀ (by positivity)] at hN
    rw [div_le_iff₀ hη2]; nlinarith
  have hcard' : η' * N' ≤ #H' := by
    rw [hcardH']
    refine le_trans ?_ hcard
    have : η' * N' ≤ η' * ((c₀ + 1) * N) := mul_le_mul_of_nonneg_left hN'2 hη'.le
    refine this.trans (le_of_eq ?_)
    simp only [η']; field_simp
  have hHE' : ∀ h' ∈ H', ‖((h' * α : ℝ) : UnitAddCircle)‖ ≤ E := by
    intro h' hh'
    obtain ⟨h, hh, he⟩ := hmemH' h' hh'
    have : (h' : ℝ) = (h : ℝ) := by exact_mod_cast he
    rw [this]; exact hPE h hh
  obtain ⟨r, hr1, hr2, hr3⟩ :=
    norm_mul_le_of_many_multiples hη' hη'1 hE0 hE' hN' hsub hcard' hHE'
  refine ⟨r, hr1, hr2.trans (le_of_eq ?_), hr3.trans ?_⟩
  · simp only [η']; field_simp; norm_num
  · have heq : 24 * E / (η' ^ 2 * N') = 384 * (c₀ + 1) ^ 2 * E / (η ^ 2 * N') := by
      simp only [η']; field_simp; ring
    rw [heq, div_mul_eq_mul_div, div_div]
    refine div_le_div_of_nonneg_left (by positivity) (by positivity) ?_
    nlinarith

/-- Blueprint Lemma 3.3 (`lem:multiples`), second assertion (signed intervals), with explicit
constants: for `c₀ > 0`, if `0 < η ≤ 1`, `0 ≤ E ≤ η/(128(c₀+1))`,
`N ≥ 384 (c₀+1)² c₀⁻¹ η⁻²`, `H ⊆ [-c₀N, c₀N] ∩ ℤ` has at least `ηN` elements and `‖hα‖_𝕋 ≤ E`
for all `h ∈ H`, then there is an integer `1 ≤ r ≤ 8(c₀+1)/η` with
`‖rα‖_𝕋 ≤ 384 (c₀+1)² c₀⁻¹ E η⁻² N⁻¹`. -/
theorem norm_mul_le_of_many_multiples_int {c₀ α η E : ℝ} (hc₀ : 0 < c₀) (hη : 0 < η)
    (hη1 : η ≤ 1) (hE0 : 0 ≤ E) (hE : E ≤ η / (128 * (c₀ + 1))) {N : ℕ}
    (hN : 384 * (c₀ + 1) ^ 2 / (c₀ * η ^ 2) ≤ N) {H : Finset ℤ}
    (hH : ∀ h ∈ H, |(h : ℝ)| ≤ c₀ * N) (hcard : η * N ≤ #H)
    (hHE : ∀ h ∈ H, ‖((h * α : ℝ) : UnitAddCircle)‖ ≤ E) :
    ∃ r : ℕ, 1 ≤ r ∧ (r : ℝ) ≤ 8 * (c₀ + 1) / η ∧
      ‖((r * α : ℝ) : UnitAddCircle)‖ ≤ 384 * (c₀ + 1) ^ 2 / c₀ * E / (η ^ 2 * N) := by
  have hc1 : 0 < c₀ + 1 := by linarith
  have hη2 : 0 < η ^ 2 := by positivity
  have hηN : 2 ≤ η * N := by
    rw [div_le_iff₀ (by positivity)] at hN
    have h4 : 4 * c₀ ≤ (c₀ + 1) ^ 2 := by nlinarith [sq_nonneg (c₀ - 1)]
    have : 2 * (c₀ * η) ≤ (η * N) * (c₀ * η) := by nlinarith
    exact le_of_mul_le_mul_right this (by positivity)
  set P := H.filter (0 < ·)
  set Q := H.filter (· < 0)
  have hsplit : #H ≤ #P + #Q + 1 := by
    have hsub : H ⊆ P ∪ Q ∪ {0} := by
      intro h hh
      simp only [P, Q, mem_union, mem_filter, mem_singleton]
      rcases lt_trichotomy h 0 with h0 | h0 | h0
      · exact Or.inl (Or.inr ⟨hh, h0⟩)
      · exact Or.inr h0
      · exact Or.inl (Or.inl ⟨hh, h0⟩)
    calc #H ≤ #(P ∪ Q ∪ {0}) := card_le_card hsub
      _ ≤ #(P ∪ Q) + #({0} : Finset ℤ) := card_union_le _ _
      _ ≤ #P + #Q + 1 := by rw [card_singleton]; linarith [card_union_le P Q]
  have hsplitR : (#H : ℝ) ≤ #P + #Q + 1 := by exact_mod_cast hsplit
  rcases le_total (η * N / 4) (#P : ℝ) with hP | hP
  · refine norm_mul_le_of_many_multiples_pos hc₀ hη hη1 hE0 hE hN (fun h hh => ?_) hP
      (fun h hh => hHE h (mem_filter.1 hh).1)
    have hh' := mem_filter.1 hh
    exact ⟨hh'.2, (le_abs_self _).trans (hH h hh'.1)⟩
  · have hQ : η * N / 4 ≤ #Q := by linarith
    have hinj : Set.InjOn (fun h : ℤ => -h) (Q : Set ℤ) := fun x _ y _ h => neg_inj.1 h
    have hcardQ : #(Q.image (fun h : ℤ => -h)) = #Q := card_image_of_injOn hinj
    have hQ1 : ∀ h ∈ Q.image (fun h : ℤ => -h), 0 < h ∧ (h : ℝ) ≤ c₀ * N := by
      intro h hh
      obtain ⟨x, hx, rfl⟩ := mem_image.1 hh
      have hx' := mem_filter.1 hx
      refine ⟨by omega, ?_⟩
      have := hH x hx'.1
      push_cast
      linarith [neg_abs_le (x : ℝ)]
    have hQ2 : ∀ h ∈ Q.image (fun h : ℤ => -h), ‖((h * -α : ℝ) : UnitAddCircle)‖ ≤ E := by
      intro h hh
      obtain ⟨x, hx, rfl⟩ := mem_image.1 hh
      have : (((-x : ℤ) : ℝ) * -α) = (x : ℝ) * α := by push_cast; ring
      rw [this]
      exact hHE x (mem_filter.1 hx).1
    obtain ⟨r, hr1, hr2, hr3⟩ := norm_mul_le_of_many_multiples_pos hc₀ hη hη1 hE0 hE hN hQ1
      (by rw [hcardQ]; exact hQ) hQ2
    refine ⟨r, hr1, hr2, ?_⟩
    have : ((r : ℝ) * α) = -((r : ℝ) * -α) := by ring
    rw [this, AddCircle.coe_neg, norm_neg]
    exact hr3

/-- Blueprint Lemma 3.3 (`lem:multiples`), second assertion (signed intervals): for every
`c₀ > 0` there are constants `c', C' > 0` (depending only on `c₀`) such that whenever
`0 < η ≤ 1`, `0 ≤ E ≤ c'η`, `N ≥ C' η⁻²`, `H ⊆ [-c₀N, c₀N] ∩ ℤ` has at least `ηN` elements and
`‖hα‖_𝕋 ≤ E` for all `h ∈ H`, there is an integer `1 ≤ r ≤ C'/η` with
`‖rα‖_𝕋 ≤ C' E η⁻² N⁻¹`. -/
theorem exists_norm_mul_le_of_many_multiples_int {c₀ : ℝ} (hc₀ : 0 < c₀) :
    ∃ c C : ℝ, 0 < c ∧ 0 < C ∧ ∀ (α η E : ℝ) (N : ℕ) (H : Finset ℤ), 0 < η → η ≤ 1 →
      0 ≤ E → E ≤ c * η → C / η ^ 2 ≤ N → (∀ h ∈ H, |(h : ℝ)| ≤ c₀ * N) → η * N ≤ #H →
      (∀ h ∈ H, ‖((h * α : ℝ) : UnitAddCircle)‖ ≤ E) →
      ∃ r : ℕ, 1 ≤ r ∧ (r : ℝ) ≤ C / η ∧
        ‖((r * α : ℝ) : UnitAddCircle)‖ ≤ C * E / (η ^ 2 * N) := by
  have hc1 : 0 < c₀ + 1 := by linarith
  refine ⟨1 / (128 * (c₀ + 1)), 384 * (c₀ + 1) ^ 2 / c₀, by positivity, by positivity,
    fun α η E N H hη hη1 hE0 hE hN hH hcard hHE => ?_⟩
  have hE' : E ≤ η / (128 * (c₀ + 1)) := by
    rw [div_eq_mul_one_div, mul_comm]; exact hE
  have hN' : 384 * (c₀ + 1) ^ 2 / (c₀ * η ^ 2) ≤ N := by rw [← div_div]; exact hN
  obtain ⟨r, hr1, hr2, hr3⟩ := norm_mul_le_of_many_multiples_int hc₀ hη hη1 hE0 hE' hN' hH
    hcard hHE
  refine ⟨r, hr1, hr2.trans ?_, hr3⟩
  refine div_le_div_of_nonneg_right ?_ hη.le
  rw [le_div_iff₀ hc₀]
  nlinarith


/-! ### Lemma 3.4 -/

/-! #### The character `e(t)` -/

/-- `e(x + y) = e(x) e(y)`. -/
lemma eC_add (x y : ℝ) : eC (x + y) = eC x * eC y := by
  unfold eC; rw [← Complex.exp_add]; congr 1; push_cast; ring

/-- `e(x) = 1` if and only if `x` is an integer. -/
lemma eC_eq_one_iff (x : ℝ) : eC x = 1 ↔ ∃ n : ℤ, x = n := by
  unfold eC
  rw [Complex.exp_eq_one_iff]
  constructor
  · rintro ⟨n, hn⟩
    refine ⟨n, ?_⟩
    have h2 : (2 * (Real.pi : ℂ) * Complex.I) ≠ 0 := by
      simp [Real.pi_ne_zero, Complex.I_ne_zero]
    have : ((x : ℂ)) = n := by
      apply mul_left_cancel₀ h2; rw [hn]; ring
    exact_mod_cast this
  · rintro ⟨n, rfl⟩; exact ⟨n, by push_cast; ring⟩

/-- `e(n) = 1` for integers `n`. -/
lemma eC_intCast (n : ℤ) : eC n = 1 := (eC_eq_one_iff _).2 ⟨n, rfl⟩

/-- `|e(x)| = 1`. -/
lemma norm_eC (x : ℝ) : ‖eC x‖ = 1 := by
  unfold eC
  rw [show (2 * (Real.pi : ℂ) * Complex.I * x) = ((2 * Real.pi * x : ℝ) : ℂ) * Complex.I by
    push_cast; ring]
  exact Complex.norm_exp_ofReal_mul_I _

/-- `conj e(x) = e(-x)`. -/
lemma conj_eC (x : ℝ) : (starRingEnd ℂ) (eC x) = eC (-x) := by
  unfold eC
  rw [← Complex.exp_conj]
  congr 1
  simp [Complex.conj_ofReal, map_ofNat]

/-- `e(n x) = e(x)^n`. -/
lemma eC_natCast_mul (n : ℕ) (x : ℝ) : eC (n * x) = eC x ^ n := by
  unfold eC; rw [← Complex.exp_nat_mul]; congr 1; push_cast; ring

/-- Lipschitz bound `|e(x) - e(y)| ≤ 2π |x - y|`. -/
lemma norm_eC_sub_eC_le (x y : ℝ) : ‖eC x - eC y‖ ≤ 2 * Real.pi * |x - y| := by
  have h1 : eC (x - y) = Complex.exp (Complex.I * ((2 * Real.pi * (x - y) : ℝ))) := by
    unfold eC; congr 1; push_cast; ring
  have h : eC x - eC y = eC y * (eC (x - y) - 1) := by
    rw [mul_sub, mul_one, ← eC_add]; ring_nf
  rw [h, norm_mul, norm_eC, one_mul, h1]
  refine Real.norm_exp_I_mul_ofReal_sub_one_le.trans (le_of_eq ?_)
  rw [Real.norm_eq_abs, abs_mul, abs_of_pos Real.two_pi_pos]

/-- Blueprint Lemma 3.4 (`lem:inverseweyl`), proof of the case `m = 1`: the inequality
`|1 - e(u)| = 2|sin πu| ≥ 4‖u‖_𝕋`. -/
theorem four_mul_norm_le_norm_one_sub_eC (u : ℝ) :
    4 * ‖(u : UnitAddCircle)‖ ≤ ‖1 - eC u‖ := by
  have h1 : 1 - eC u = -(Complex.exp (Complex.I * ((2 * Real.pi * u : ℝ))) - 1) := by
    unfold eC; push_cast; ring_nf
  rw [h1, norm_neg, Complex.norm_exp_I_mul_ofReal_sub_one, UnitAddCircle.norm_eq]
  set v := u - round u with hv
  have hv2 : |v| ≤ 1 / 2 := abs_sub_round u
  have hsin : |Real.sin (Real.pi * u)| = |Real.sin (Real.pi * v)| := by
    have : Real.pi * u = Real.pi * v + (round u : ℤ) * Real.pi := by rw [hv]; ring
    rw [this, Real.sin_add_int_mul_pi, abs_mul]; simp
  have hjordan : 2 * |v| ≤ |Real.sin (Real.pi * v)| := by
    have h0 : 0 ≤ Real.pi * |v| := by positivity
    have h1 : Real.pi * |v| ≤ Real.pi / 2 := by nlinarith [Real.pi_pos]
    have := Real.mul_le_sin h0 h1
    have heq : 2 / Real.pi * (Real.pi * |v|) = 2 * |v| := by field_simp
    rw [heq] at this
    rcases le_total 0 v with h | h
    · rw [abs_of_nonneg h] at this ⊢
      exact this.trans (le_abs_self _)
    · rw [abs_of_nonpos h] at this ⊢
      rw [show Real.pi * -v = -(Real.pi * v) by ring, Real.sin_neg] at this
      exact this.trans (neg_le_abs _)
  rw [show 2 * Real.pi * u / 2 = Real.pi * u by ring, Real.norm_eq_abs, abs_mul, hsin]
  norm_num
  linarith

/-! #### Torus distance -/

/-- Adding an integer does not change the torus distance. -/
lemma tnorm_add_intCast (x : ℝ) (n : ℤ) :
    ‖((x + n : ℝ) : UnitAddCircle)‖ = ‖(x : UnitAddCircle)‖ := by
  rw [AddCircle.coe_add]
  have : ((n : ℝ) : UnitAddCircle) = 0 := (AddCircle.coe_eq_zero_iff _).2 ⟨n, by simp⟩
  rw [this, add_zero]

/-- `‖n x‖_𝕋 ≤ |n| ‖x‖_𝕋` for integers `n`. -/
lemma tnorm_intCast_mul_le (n : ℤ) (x : ℝ) :
    ‖((n * x : ℝ) : UnitAddCircle)‖ ≤ |(n : ℝ)| * ‖(x : UnitAddCircle)‖ := by
  rw [← zsmul_eq_mul, AddCircle.coe_zsmul]
  refine (norm_zsmul_le _ _).trans (le_of_eq ?_)
  rw [Int.norm_eq_abs]

/-- `‖n x‖_𝕋 ≤ n ‖x‖_𝕋` for natural `n`. -/
lemma tnorm_natCast_mul_le (n : ℕ) (x : ℝ) :
    ‖((n * x : ℝ) : UnitAddCircle)‖ ≤ n * ‖(x : UnitAddCircle)‖ := by
  have := tnorm_intCast_mul_le n x
  simpa using this

/-- `‖x‖_𝕋 ≤ 1/2`. -/
lemma tnorm_le_half (x : ℝ) : ‖(x : UnitAddCircle)‖ ≤ 1 / 2 := by
  rw [UnitAddCircle.norm_eq]; exact abs_sub_round x

/-- Triangle inequality for the torus distance of a finite sum. -/
lemma tnorm_sum_le {ι : Type*} (s : Finset ι) (f : ι → ℝ) :
    ‖((∑ i ∈ s, f i : ℝ) : UnitAddCircle)‖ ≤ ∑ i ∈ s, ‖((f i : ℝ) : UnitAddCircle)‖ := by
  have : ((∑ i ∈ s, f i : ℝ) : UnitAddCircle) = ∑ i ∈ s, ((f i : ℝ) : UnitAddCircle) :=
    map_sum (QuotientAddGroup.mk' _) f s
  rw [this]; exact norm_sum_le _ _

/-! #### Reindexing sums over intervals -/

/-- `∑_{t=1}^N f(t) = ∑_{t<N} f(t+1)`. -/
lemma sum_Icc_one_eq_sum_range {M : Type*} [AddCommMonoid M] (f : ℕ → M) (N : ℕ) :
    ∑ t ∈ Icc 1 N, f t = ∑ t ∈ range N, f (t + 1) := by
  refine Finset.sum_nbij' (fun t => t - 1) (fun t => t + 1) ?_ ?_ ?_ ?_ ?_ <;>
    intro a ha <;> simp only [mem_Icc, mem_range] at ha ⊢ <;>
      first | omega | (congr 1; omega)

/-- `∑_{t ∈ [A, B)} f(t) = ∑_{u < B - A} f(A + u)` over the integers. -/
lemma sum_Ico_int_eq_sum_range {M : Type*} [AddCommMonoid M] (f : ℤ → M) (A B : ℤ) :
    ∑ t ∈ Ico A B, f t = ∑ u ∈ range (B - A).toNat, f (A + u) := by
  refine Finset.sum_nbij' (fun t => (t - A).toNat) (fun u => A + u) ?_ ?_ ?_ ?_ ?_ <;>
    intro a ha <;> simp only [mem_Ico, mem_range] at ha ⊢ <;>
      first | omega | (congr 1; omega)

/-- `∑_{t ∈ [A, B]} f(t) = ∑_{u < B + 1 - A} f(A + u)` over the integers. -/
lemma sum_Icc_int_eq_sum_range {M : Type*} [AddCommMonoid M] (f : ℤ → M) (A B : ℤ) :
    ∑ t ∈ Icc A B, f t = ∑ u ∈ range (B + 1 - A).toNat, f (A + u) := by
  refine Finset.sum_nbij' (fun t => (t - A).toNat) (fun u => A + u) ?_ ?_ ?_ ?_ ?_ <;>
    intro a ha <;> simp only [mem_Icc, mem_range] at ha ⊢ <;>
      first | omega | (congr 1; omega)

/-! #### The linear case -/

/-- Geometric sum bound: `|∑_{t<N} e(a t)| · ‖a‖_𝕋 ≤ 1/2`. -/
lemma norm_sum_eC_mul_tnorm_le (a : ℝ) (N : ℕ) :
    ‖∑ t ∈ range N, eC (a * t)‖ * ‖(a : UnitAddCircle)‖ ≤ 1 / 2 := by
  have h4 := four_mul_norm_le_norm_one_sub_eC a
  by_cases h1 : eC a = 1
  · rw [h1, sub_self, norm_zero] at h4
    have : ‖(a : UnitAddCircle)‖ = 0 := le_antisymm (by linarith) (norm_nonneg _)
    rw [this, mul_zero]; norm_num
  have hsum : ∑ t ∈ range N, eC (a * t) = (eC a ^ N - 1) / (eC a - 1) := by
    rw [← geom_sum_eq h1]
    refine Finset.sum_congr rfl fun t _ => ?_
    rw [mul_comm, eC_natCast_mul]
  have hne : 0 < ‖eC a - 1‖ := norm_pos_iff.2 (sub_ne_zero.2 h1)
  have hnum : ‖eC a ^ N - 1‖ ≤ 2 := by
    refine (norm_sub_le _ _).trans ?_
    rw [norm_pow, norm_eC, one_pow, norm_one]; norm_num
  rw [hsum, norm_div]
  have h4' : 4 * ‖(a : UnitAddCircle)‖ ≤ ‖eC a - 1‖ := by rwa [norm_sub_rev] at h4
  rw [div_mul_eq_mul_div, div_le_iff₀ hne]
  nlinarith [norm_nonneg (eC a ^ N - 1), norm_nonneg (a : UnitAddCircle)]

/-- Blueprint Lemma 3.4 (`lem:inverseweyl`), the case `m = 1` (with `q = 1`): if
`|∑_{t=1}^N e(a₀ + a₁ t)| ≥ δN` with `δ > 0` and `N ≥ 1`, then `‖a₁‖_𝕋 ≤ δ⁻¹ N⁻¹ / 2`. -/
theorem tnorm_le_of_linear_sum (a₀ a₁ : ℝ) {N : ℕ} (hN : 1 ≤ N) {δ : ℝ} (hδ : 0 < δ)
    (hS : δ * N ≤ ‖∑ t ∈ Icc 1 N, eC (a₀ + a₁ * t)‖) :
    ‖(a₁ : UnitAddCircle)‖ ≤ δ⁻¹ / (2 * N) := by
  have hN0 : (0 : ℝ) < N := by exact_mod_cast hN
  have hsum : ∑ t ∈ Icc 1 N, eC (a₀ + a₁ * t) = eC (a₀ + a₁) * ∑ t ∈ range N, eC (a₁ * t) := by
    rw [sum_Icc_one_eq_sum_range, mul_sum]
    refine Finset.sum_congr rfl fun t _ => ?_
    rw [← eC_add]; congr 1; push_cast; ring
  rw [hsum, norm_mul, norm_eC, one_mul] at hS
  have hb := norm_sum_eC_mul_tnorm_le a₁ N
  have : δ * N * ‖(a₁ : UnitAddCircle)‖ ≤ 1 / 2 :=
    (mul_le_mul_of_nonneg_right hS (norm_nonneg _)).trans hb
  rw [le_div_iff₀ (by positivity)]
  have h2 : δ⁻¹ * δ = 1 := inv_mul_cancel₀ hδ.ne'
  nlinarith [norm_nonneg (a₁ : UnitAddCircle), inv_pos.2 hδ]

/-! #### Summation by parts and a finite Fourier expansion -/

/-- Summation by parts: some prefix sum of `g` controls a weighted sum,
`|∑_{i<n} f_i g_i| ≤ (|f_{n-1}| + ∑_{i<n-1} |f_{i+1} - f_i|) |∑_{j<k} g_j|` for some
`1 ≤ k ≤ n`. -/
lemma exists_norm_sum_mul_le (f g : ℕ → ℂ) {n : ℕ} (hn : 1 ≤ n) :
    ∃ k ∈ Icc 1 n, ‖∑ i ∈ range n, f i * g i‖ ≤
      (‖f (n - 1)‖ + ∑ i ∈ range (n - 1), ‖f (i + 1) - f i‖) * ‖∑ j ∈ range k, g j‖ := by
  obtain ⟨k, hk, hmax⟩ := (Icc 1 n).exists_max_image (fun k => ‖∑ j ∈ range k, g j‖)
    ⟨n, mem_Icc.2 ⟨hn, le_rfl⟩⟩
  refine ⟨k, hk, ?_⟩
  have hparts := sum_range_by_parts f g n
  simp only [smul_eq_mul] at hparts
  rw [hparts]
  set Gm := ‖∑ j ∈ range k, g j‖
  have h1 : ‖f (n - 1) * ∑ i ∈ range n, g i‖ ≤ ‖f (n - 1)‖ * Gm := by
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_left (hmax n (mem_Icc.2 ⟨hn, le_rfl⟩)) (norm_nonneg _)
  have h2 : ‖∑ i ∈ range (n - 1), (f (i + 1) - f i) * ∑ j ∈ range (i + 1), g j‖ ≤
      (∑ i ∈ range (n - 1), ‖f (i + 1) - f i‖) * Gm := by
    rw [sum_mul]
    refine (norm_sum_le _ _).trans (sum_le_sum fun i hi => ?_)
    rw [norm_mul]
    refine mul_le_mul_of_nonneg_left (hmax (i + 1) ?_) (norm_nonneg _)
    rw [mem_range] at hi; rw [mem_Icc]; omega
  calc _ ≤ ‖f (n - 1) * ∑ i ∈ range n, g i‖ +
        ‖∑ i ∈ range (n - 1), (f (i + 1) - f i) * ∑ j ∈ range (i + 1), g j‖ := norm_sub_le _ _
    _ ≤ _ := by rw [add_mul]; exact add_le_add h1 h2

/-- Orthogonality: `∑_{j<q} e(jx/q)` is `q` if `q ∣ x` and `0` otherwise. -/
lemma sum_eC_mul_div (q : ℕ) (hq : 1 ≤ q) (x : ℤ) :
    ∑ j ∈ range q, eC (j * x / q) = if (q : ℤ) ∣ x then (q : ℂ) else 0 := by
  have hq0 : (q : ℝ) ≠ 0 := by positivity
  have hpow : ∀ j : ℕ, eC (j * x / q) = eC (x / q) ^ j := by
    intro j; rw [mul_div_assoc, eC_natCast_mul]
  simp_rw [hpow]
  split_ifs with hdvd
  · obtain ⟨c, rfl⟩ := hdvd
    have : ((q * c : ℤ) : ℝ) / q = (c : ℝ) := by push_cast; field_simp
    rw [this, eC_intCast]; simp
  · have hne : eC (x / q) ≠ 1 := by
      intro h
      obtain ⟨c, hc⟩ := (eC_eq_one_iff _).1 h
      apply hdvd
      refine ⟨c, ?_⟩
      have : (x : ℝ) = q * c := by rw [← hc]; field_simp
      exact_mod_cast this
    rw [geom_sum_eq hne, ← eC_natCast_mul, mul_div_cancel₀ _ hq0, eC_intCast, sub_self, zero_div]

/-- Finite Fourier expansion of a `q`-periodic function bounded by one: its coefficients are
bounded by one. -/
lemma exists_periodic_expansion {q : ℕ} (hq : 1 ≤ q) (φ : ℕ → ℂ)
    (hper : ∀ t, φ t = φ (t % q)) (hb : ∀ t, ‖φ t‖ ≤ 1) :
    ∃ α : ℕ → ℂ, (∀ j, ‖α j‖ ≤ 1) ∧ ∀ t, φ t = ∑ j ∈ range q, α j * eC (j * t / q) := by
  have hq0 : (0 : ℝ) < q := by exact_mod_cast hq
  refine ⟨fun j => (1 / (q : ℂ)) * ∑ s ∈ range q, φ s * eC (-(j * s / q)), fun j => ?_,
    fun t => ?_⟩
  · rw [norm_mul, norm_div, norm_one, Complex.norm_natCast]
    have : ‖∑ s ∈ range q, φ s * eC (-(j * s / q))‖ ≤ q := by
      refine (norm_sum_le _ _).trans ?_
      calc ∑ s ∈ range q, ‖φ s * eC (-(j * s / q))‖ ≤ ∑ s ∈ range q, (1 : ℝ) :=
            sum_le_sum fun s _ => by rw [norm_mul, norm_eC, mul_one]; exact hb s
        _ = q := by simp
    rw [div_mul_eq_mul_div, one_mul, div_le_one hq0]; exact this
  · have hexp : ∑ j ∈ range q, (1 / (q : ℂ)) * (∑ s ∈ range q, φ s * eC (-(j * s / q))) *
        eC (j * t / q) = (1 / (q : ℂ)) * ∑ s ∈ range q, φ s *
          ∑ j ∈ range q, eC (j * (((t : ℤ) - s : ℤ) : ℝ) / q) := by
      rw [mul_sum]
      simp_rw [mul_sum, sum_mul]
      rw [sum_comm]
      refine sum_congr rfl fun s _ => sum_congr rfl fun j _ => ?_
      rw [mul_assoc, mul_assoc, ← eC_add]
      congr 2
      push_cast; ring_nf
    rw [hexp]
    simp_rw [sum_eC_mul_div q hq]
    have hiff : ∀ s ∈ range q, ((q : ℤ) ∣ ((t : ℤ) - s) ↔ t % q = s) := by
      intro s hs
      rw [mem_range] at hs
      rw [← Nat.modEq_iff_dvd, Nat.ModEq, Nat.mod_eq_of_lt hs, eq_comm]
    rw [sum_congr rfl fun s hs => by rw [if_congr (hiff s hs) rfl rfl]]
    simp only [mul_ite, mul_zero]
    simp only [sum_ite_eq, mem_range, Nat.mod_lt t (by omega : 0 < q), ↓reduceIte]
    rw [← hper]
    have hqC : (q : ℂ) ≠ 0 := by exact_mod_cast (by omega : q ≠ 0)
    field_simp

/-! #### Polynomial coefficients under translation -/

/-- Coefficients of the translate `p(X + c)`:
`[X^k] p(X + c) = ∑_{i ≤ n} pᵢ c^{i-k} (i choose k)` when `deg p ≤ n`. -/
lemma coeff_comp_X_add_C {p : ℝ[X]} {n : ℕ} (hp : p.natDegree ≤ n) (c : ℝ) (k : ℕ) :
    (p.comp (X + C c)).coeff k =
      ∑ i ∈ range (n + 1), p.coeff i * (c ^ (i - k) * i.choose k) := by
  conv_lhs => rw [p.as_sum_range' (n + 1) (by omega)]
  rw [Polynomial.sum_comp, finsetSum_coeff]
  refine sum_congr rfl fun i _ => ?_
  rw [monomial_comp, coeff_C_mul, coeff_X_add_C_pow]

/-- Translation preserves the degree. -/
lemma natDegree_comp_X_add_C (p : ℝ[X]) (c : ℝ) :
    (p.comp (X + C c)).natDegree = p.natDegree := by
  rw [natDegree_comp, natDegree_X_add_C, mul_one]

/-- Translation preserves the coefficient of `X^n` when `deg p ≤ n`. -/
lemma coeff_comp_X_add_C_self {p : ℝ[X]} {n : ℕ} (hp : p.natDegree ≤ n) (c : ℝ) :
    (p.comp (X + C c)).coeff n = p.coeff n := by
  rw [coeff_comp_X_add_C hp, sum_range_succ,
    sum_eq_zero fun i hi => by rw [Nat.choose_eq_zero_of_lt (mem_range.1 hi)]; simp]
  simp

/-- The difference `p(X + c) - p(X)` of a polynomial of degree at most `d + 1` has degree at
most `d` and coefficient `(d + 1) c p_{d+1}` at `X^d`. -/
lemma comp_X_add_C_sub_self {p : ℝ[X]} {d : ℕ} (hp : p.natDegree ≤ d + 1) (c : ℝ) :
    (p.comp (X + C c) - p).natDegree ≤ d ∧
      (p.comp (X + C c) - p).coeff d = (d + 1) * c * p.coeff (d + 1) := by
  constructor
  · rw [natDegree_le_iff_coeff_eq_zero]
    intro N hN
    rw [coeff_sub]
    rcases (show N = d + 1 ∨ d + 1 < N by omega) with h | h
    · rw [h, coeff_comp_X_add_C_self hp, sub_self]
    · rw [coeff_eq_zero_of_natDegree_lt (lt_of_le_of_lt hp h),
        coeff_eq_zero_of_natDegree_lt (by rw [natDegree_comp_X_add_C]; omega), sub_zero]
  · rw [coeff_sub, coeff_comp_X_add_C hp, sum_range_succ, sum_range_succ,
      sum_eq_zero fun i hi => by rw [Nat.choose_eq_zero_of_lt (mem_range.1 hi)]; simp,
      Nat.choose_self, Nat.choose_succ_self_right]
    simp only [Nat.sub_self, pow_zero, Nat.cast_one, mul_one, zero_add,
      show d + 1 - d = 1 by omega, pow_one]
    push_cast
    ring

/-- The differenced phase of van der Corput's inequality for the shift `h`, translated so
that the overlap interval starts at `1`: `u ↦ p(u + A + h) - p(u + A)` with `A = max(0, -h)`. -/
noncomputable def vdcPoly (p : ℝ[X]) (h : ℤ) : ℝ[X] :=
  (p.comp (X + C (h : ℝ)) - p).comp (X + C ((((-h).toNat : ℕ)) : ℝ))

/-- `vdcPoly p h` has degree at most `d` and coefficient `(d+1) h p_{d+1}` at `X^d`. -/
lemma vdcPoly_spec {p : ℝ[X]} {d : ℕ} (hp : p.natDegree ≤ d + 1) (h : ℤ) :
    (vdcPoly p h).natDegree ≤ d ∧ (vdcPoly p h).coeff d = (d + 1) * h * p.coeff (d + 1) := by
  obtain ⟨h1, h2⟩ := comp_X_add_C_sub_self hp (h : ℝ)
  refine ⟨?_, ?_⟩
  · rw [vdcPoly, natDegree_comp_X_add_C]; exact h1
  · rw [vdcPoly, coeff_comp_X_add_C_self h1, h2]

/-- Translating back: if `‖q p_l‖_𝕋 ≤ E N^{-l}` for `1 ≤ l ≤ m` and `|c| ≤ T N`, then the
translate `p(X + c)` satisfies `‖q [X^k] p(X + c)‖_𝕋 ≤ (m+1) (2(T+1))^m E N^{-k}`. -/
lemma tnorm_coeff_comp_le {p : ℝ[X]} {m : ℕ} (hp : p.natDegree ≤ m) (c : ℤ) (q : ℕ)
    {N T E : ℝ} (hN : 0 < N) (hT : 0 ≤ T) (hc : |(c : ℝ)| ≤ T * N) (hE : 0 ≤ E)
    (h : ∀ l ∈ Icc 1 m, ‖((q * p.coeff l : ℝ) : UnitAddCircle)‖ ≤ E / N ^ l) :
    ∀ k ∈ Icc 1 m, ‖((q * (p.comp (X + C (c : ℝ))).coeff k : ℝ) : UnitAddCircle)‖ ≤
      (m + 1) * (2 * (T + 1)) ^ m * E / N ^ k := by
  intro k hk
  rw [mem_Icc] at hk
  rw [coeff_comp_X_add_C hp, mul_sum]
  refine (tnorm_sum_le _ _).trans ?_
  have hterm : ∀ i ∈ range (m + 1),
      ‖((q * (p.coeff i * ((c : ℝ) ^ (i - k) * i.choose k)) : ℝ) : UnitAddCircle)‖ ≤
        (2 * (T + 1)) ^ m * E / N ^ k := by
    intro i hi
    rw [mem_range] at hi
    rcases lt_or_ge i k with hik | hik
    · rw [Nat.choose_eq_zero_of_lt hik]; simp only [Nat.cast_zero, mul_zero]
      simp only [AddCircle.coe_zero, norm_zero]; positivity
    · have heq : (q * (p.coeff i * ((c : ℝ) ^ (i - k) * i.choose k)) : ℝ) =
          ((c ^ (i - k) * i.choose k : ℤ) : ℝ) * (q * p.coeff i) := by push_cast; ring
      rw [heq]
      refine (tnorm_intCast_mul_le _ _).trans ?_
      have h1 := h i (mem_Icc.2 ⟨by omega, by omega⟩)
      have habs : |(((c ^ (i - k) * i.choose k : ℤ)) : ℝ)| ≤ (T * N) ^ (i - k) * 2 ^ i := by
        push_cast
        rw [abs_mul, abs_pow, Nat.abs_cast]
        exact mul_le_mul (pow_le_pow_left₀ (abs_nonneg _) hc _)
          (by exact_mod_cast Nat.choose_le_two_pow i k) (by positivity) (by positivity)
      have hNi : N ^ i = N ^ (i - k) * N ^ k := by rw [← pow_add, Nat.sub_add_cancel hik]
      have hT1 : T ^ (i - k) * 2 ^ i ≤ (2 * (T + 1)) ^ m := by
        rw [mul_pow, mul_comm]
        exact mul_le_mul (pow_le_pow_right₀ (by norm_num) (by omega))
          ((pow_le_pow_left₀ hT (by linarith) _).trans
            (pow_le_pow_right₀ (by linarith) (by omega))) (by positivity) (by positivity)
      calc _ ≤ ((T * N) ^ (i - k) * 2 ^ i) * (E / N ^ i) :=
            mul_le_mul habs h1 (norm_nonneg _) (by positivity)
        _ = (T ^ (i - k) * 2 ^ i) * E / N ^ k := by
            rw [hNi, mul_pow]; field_simp
        _ ≤ _ := by gcongr
  refine (sum_le_sum hterm).trans (le_of_eq ?_)
  rw [sum_const, card_range, nsmul_eq_mul]; push_cast; ring

/-! #### The inductive statement and the linear case -/

/-- The inductive statement behind Blueprint Lemma 3.4 at degree `m` with exponent `K`: all
losses are powers `(δ⁻¹)^K`, and `∑_{t=1}^N` is written `∑_{t<N} e(p(t+1))`. -/
def InvWeylBound (m K : ℕ) : Prop :=
  ∀ p : ℝ[X], p.natDegree ≤ m → ∀ N : ℕ, 1 ≤ N → ∀ δ : ℝ, 0 < δ → δ ≤ 1 / 2 →
    δ * N ≤ ‖∑ t ∈ range N, eC (p.eval ((t : ℝ) + 1))‖ →
    ∃ q : ℕ, 1 ≤ q ∧ (q : ℝ) ≤ δ⁻¹ ^ K ∧
      ∀ k ∈ Icc 1 m, ‖((q * p.coeff k : ℝ) : UnitAddCircle)‖ ≤ δ⁻¹ ^ K / N ^ k

/-- `δ ≤ 1/2` gives `δ⁻¹ ≥ 2`. -/
lemma two_le_inv_of_le_half {δ : ℝ} (hδ : 0 < δ) (hδ2 : δ ≤ 1 / 2) : 2 ≤ δ⁻¹ := by
  rw [le_inv_comm₀ (by norm_num) hδ]; linarith

/-- Enlarging the exponent preserves `InvWeylBound`. -/
lemma InvWeylBound.mono {m K K' : ℕ} (h : InvWeylBound m K) (hK : K ≤ K') :
    InvWeylBound m K' := by
  intro p hp N hN δ hδ hδ2 hS
  obtain ⟨q, hq1, hq2, hq3⟩ := h p hp N hN δ hδ hδ2 hS
  have hpow : δ⁻¹ ^ K ≤ δ⁻¹ ^ K' :=
    pow_le_pow_right₀ (by linarith [two_le_inv_of_le_half hδ hδ2]) hK
  exact ⟨q, hq1, hq2.trans hpow,
    fun k hk => (hq3 k hk).trans (div_le_div_of_nonneg_right hpow (by positivity))⟩

/-- The case `m = 1` of the inductive statement (geometric sums, `q = 1`). -/
lemma invWeylBound_one : InvWeylBound 1 1 := by
  intro p hp N hN δ hδ hδ2 hS
  have hX := two_le_inv_of_le_half hδ hδ2
  have hN0 : (0 : ℝ) < N := by exact_mod_cast hN
  have heval : ∀ x : ℝ, p.eval x = p.coeff 0 + p.coeff 1 * x := by
    intro x; rw [eval_eq_sum_range' (n := 2) (by omega)]; simp [sum_range_succ]
  have hsum : ∑ t ∈ range N, eC (p.eval ((t : ℝ) + 1)) =
      eC (p.coeff 0 + p.coeff 1) * ∑ t ∈ range N, eC (p.coeff 1 * t) := by
    rw [mul_sum]
    refine sum_congr rfl fun t _ => ?_
    rw [← eC_add, heval]; congr 1; ring
  rw [hsum, norm_mul, norm_eC, one_mul] at hS
  have hb := norm_sum_eC_mul_tnorm_le (p.coeff 1) N
  have h1 : δ * N * ‖((p.coeff 1 : ℝ) : UnitAddCircle)‖ ≤ 1 / 2 :=
    (mul_le_mul_of_nonneg_right hS (norm_nonneg _)).trans hb
  refine ⟨1, le_rfl, by simp; linarith, fun k hk => ?_⟩
  have hk1 : k = 1 := by simp only [mem_Icc] at hk; omega
  subst hk1
  rw [Nat.cast_one, one_mul, pow_one, pow_one, le_div_iff₀ hN0]
  have h2 : δ⁻¹ * δ = 1 := inv_mul_cancel₀ hδ.ne'
  nlinarith [norm_nonneg ((p.coeff 1 : ℝ) : UnitAddCircle)]

/-! #### Van der Corput differencing -/

/-- The correlation `∑_{t} e(p(t + h) - p(t))` over the overlap of `{1, …, N}` and its shift,
reindexed to start at `1`. -/
noncomputable def vdcSum (p : ℝ[X]) (N : ℕ) (h : ℤ) : ℂ :=
  ∑ u ∈ range (N - h.natAbs), eC ((vdcPoly p h).eval ((u : ℝ) + 1))

/-- The pairs `(s, t)` with `s - t = h` contribute `vdcSum p N h`. -/
lemma sum_fiber_eq_vdcSum (p : ℝ[X]) (N : ℕ) (h : ℤ) :
    ∑ x ∈ range N ×ˢ range N with (x.1 : ℤ) - x.2 = h,
      eC (p.eval ((x.1 : ℝ) + 1)) * (starRingEnd ℂ) (eC (p.eval ((x.2 : ℝ) + 1))) =
      vdcSum p N h := by
  symm
  set A := (-h).toNat with hA
  refine Finset.sum_nbij' (fun u => ((((A + u : ℕ) : ℤ) + h).toNat, A + u))
    (fun x => x.2 - A) ?_ ?_ ?_ ?_ ?_
  · intro u hu
    simp only [mem_filter, mem_product, mem_range] at hu ⊢
    omega
  · intro x hx
    simp only [mem_filter, mem_product, mem_range] at hx ⊢
    omega
  · intro u hu; simp
  · intro x hx
    simp only [mem_filter, mem_product, mem_range] at hx
    ext <;> simp <;> omega
  · intro u hu
    simp only [mem_range] at hu
    have hs : ((((((A + u : ℕ) : ℤ) + h).toNat : ℕ)) : ℤ) = A + u + h := by
      rw [Int.toNat_of_nonneg (by omega)]; push_cast; ring
    have hsR : (((((A + u : ℕ) : ℤ) + h).toNat : ℕ) : ℝ) = (A : ℝ) + u + h := by
      exact_mod_cast hs
    simp only
    rw [conj_eC, ← eC_add, hsR, vdcPoly]
    congr 1
    simp only [eval_comp, eval_sub, eval_add, eval_X, eval_C]
    push_cast
    rw [← hA]; ring_nf

/-- Van der Corput: `|∑_{t=1}^N e(p(t))|² ≤ ∑_{|h| < N} |vdcSum p N h|`. -/
lemma norm_sq_le_sum_vdcSum (p : ℝ[X]) (N : ℕ) :
    ‖∑ t ∈ range N, eC (p.eval ((t : ℝ) + 1))‖ ^ 2 ≤
      ∑ h ∈ Icc (1 - (N : ℤ)) (N - 1), ‖vdcSum p N h‖ := by
  set S := ∑ t ∈ range N, eC (p.eval ((t : ℝ) + 1))
  have hSS : ((‖S‖ ^ 2 : ℝ) : ℂ) = ∑ h ∈ Icc (1 - (N : ℤ)) (N - 1), vdcSum p N h := by
    have h1 : ((‖S‖ ^ 2 : ℝ) : ℂ) = S * (starRingEnd ℂ) S := by
      rw [Complex.mul_conj, Complex.normSq_eq_norm_sq]
    rw [h1, map_sum, sum_mul_sum, ← sum_product']
    rw [← sum_fiberwise_of_maps_to (s := range N ×ˢ range N) (t := Icc (1 - (N : ℤ)) (N - 1))
      (g := fun x : ℕ × ℕ => (x.1 : ℤ) - x.2) (fun x hx => by
        simp only [mem_product, mem_range] at hx; simp only [mem_Icc]; omega)]
    exact sum_congr rfl fun h _ => sum_fiber_eq_vdcSum p N h
  have : ‖S‖ ^ 2 = ‖((‖S‖ ^ 2 : ℝ) : ℂ)‖ := by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (by positivity)]
  rw [this, hSS]
  exact norm_sum_le _ _

/-- `|vdcSum p N h| ≤ N - |h|`. -/
lemma norm_vdcSum_le (p : ℝ[X]) (N : ℕ) (h : ℤ) :
    ‖vdcSum p N h‖ ≤ ((N - h.natAbs : ℕ) : ℝ) := by
  refine (norm_sum_le _ _).trans (le_of_eq ?_)
  simp [norm_eC]

/-- Many shifts with large correlation: if `|∑_{t=1}^N e(p(t))| ≥ δN` then at least `δ²N/2`
shifts `|h| < N` have `|vdcSum p N h| ≥ δ²N/4`. -/
lemma card_large_vdcSum (p : ℝ[X]) {N : ℕ} (hN : 1 ≤ N) {δ : ℝ} (hδ : 0 < δ)
    (hS : δ * N ≤ ‖∑ t ∈ range N, eC (p.eval ((t : ℝ) + 1))‖) :
    δ ^ 2 * N / 2 ≤
      (#{h ∈ Icc (1 - (N : ℤ)) (N - 1) | δ ^ 2 * N / 4 ≤ ‖vdcSum p N h‖} : ℝ) := by
  have hN0 : (0 : ℝ) < N := by exact_mod_cast hN
  set J := Icc (1 - (N : ℤ)) (N - 1)
  set H := {h ∈ J | δ ^ 2 * N / 4 ≤ ‖vdcSum p N h‖}
  have hsq := norm_sq_le_sum_vdcSum p N
  have hsq' : (δ * N) ^ 2 ≤ ‖∑ t ∈ range N, eC (p.eval ((t : ℝ) + 1))‖ ^ 2 :=
    pow_le_pow_left₀ (by positivity) hS 2
  rw [← sum_filter_add_sum_filter_not J (fun h => δ ^ 2 * N / 4 ≤ ‖vdcSum p N h‖)] at hsq
  have hH : ∑ h ∈ H, ‖vdcSum p N h‖ ≤ #H * N := by
    rw [← nsmul_eq_mul, ← sum_const]
    refine sum_le_sum fun h _ => (norm_vdcSum_le p N h).trans ?_
    exact_mod_cast Nat.sub_le _ _
  have hJ : (#J : ℝ) ≤ 2 * N := by
    have : #J = (2 * N - 1 : ℤ).toNat := by simp only [J, Int.card_Icc]; congr 1; ring
    rw [this]
    have h2 : ((2 * N - 1 : ℤ).toNat : ℤ) ≤ 2 * N := by omega
    exact_mod_cast h2
  have hnot : ∑ h ∈ J with ¬(δ ^ 2 * N / 4 ≤ ‖vdcSum p N h‖), ‖vdcSum p N h‖ ≤
      #J * (δ ^ 2 * N / 4) := by
    calc _ ≤ ∑ h ∈ J with ¬(δ ^ 2 * N / 4 ≤ ‖vdcSum p N h‖), δ ^ 2 * N / 4 :=
          sum_le_sum fun h hh => (not_le.1 (mem_filter.1 hh).2).le
      _ ≤ ∑ h ∈ J, δ ^ 2 * N / 4 := sum_le_sum_of_subset_of_nonneg (filter_subset _ _)
          fun _ _ _ => by positivity
      _ = _ := by rw [sum_const, nsmul_eq_mul]
  have hmain : δ ^ 2 * N ^ 2 ≤ #H * N + 2 * N * (δ ^ 2 * N / 4) := by
    have := mul_le_mul_of_nonneg_right hJ (show 0 ≤ δ ^ 2 * N / 4 by positivity)
    nlinarith
  have : δ ^ 2 * N / 2 * N ≤ #H * N := by nlinarith
  exact le_of_mul_le_mul_right this hN0

/-! #### The leading coefficient -/

/-- `n ≤ X^n` for `X ≥ 2`. -/
lemma natCast_le_pow_of_two_le {X : ℝ} (hX : 2 ≤ X) (n : ℕ) : (n : ℝ) ≤ X ^ n := by
  have h1 : (n : ℝ) ≤ 2 ^ n := by exact_mod_cast (Nat.lt_two_pow_self).le
  exact h1.trans (pow_le_pow_left₀ (by norm_num) hX n)

/-- `2^k ≤ X^k` for `X ≥ 2`. -/
lemma two_pow_le_pow_of_two_le {X : ℝ} (hX : 2 ≤ X) (k : ℕ) : (2 : ℝ) ^ k ≤ X ^ k :=
  pow_le_pow_left₀ (by norm_num) hX k

/-- Inductive step, leading coefficient (differencing, pigeonholing and Lemma 3.3): from the
statement at degree `d ≥ 1`, a large degree-`(d+1)` sum forces `‖q₀ p_{d+1}‖_𝕋 ≤ δ^{-O(1)}
N^{-(d+1)}` for some `q₀ ≤ δ^{-O(1)}`, provided `N ≥ δ^{-O(1)}`. -/
lemma leading_coeff_step {d K₁ : ℕ} (hd : 1 ≤ d) (hIH : InvWeylBound d K₁) {p : ℝ[X]}
    (hp : p.natDegree ≤ d + 1) {N : ℕ} (hN : 1 ≤ N) {δ : ℝ} (hδ : 0 < δ) (hδ2 : δ ≤ 1 / 2)
    (hS : δ * N ≤ ‖∑ t ∈ range N, eC (p.eval ((t : ℝ) + 1))‖)
    (hNl : δ⁻¹ ^ (8 * K₁ + 4 * d + 17) ≤ N) :
    ∃ q₀ : ℕ, 1 ≤ q₀ ∧ (q₀ : ℝ) ≤ δ⁻¹ ^ (8 * K₁ + d + 8) ∧
      ‖((q₀ * p.coeff (d + 1) : ℝ) : UnitAddCircle)‖ ≤
        δ⁻¹ ^ (12 * K₁ + 4 * d + 17) / N ^ (d + 1) := by
  set X := δ⁻¹ with hXdef
  have hX : 2 ≤ X := two_le_inv_of_le_half hδ hδ2
  have hX0 : 0 < X := by linarith
  have hX1 : 1 ≤ X := by linarith
  have hδX : δ = X⁻¹ := (inv_inv δ).symm
  have hN0 : (0 : ℝ) < N := by exact_mod_cast hN
  have hN1 : (1 : ℝ) ≤ N := by exact_mod_cast hN
  set a := p.coeff (d + 1)
  set J := Icc (1 - (N : ℤ)) (N - 1)
  set H := {h ∈ J | δ ^ 2 * N / 4 ≤ ‖vdcSum p N h‖}
  have hH := card_large_vdcSum p hN hδ hS
  have hX4 : 4 * X ^ 2 ≤ X ^ 4 := by
    have h4 : (4 : ℝ) ≤ X ^ 2 := by nlinarith
    calc 4 * X ^ 2 ≤ X ^ 2 * X ^ 2 := by gcongr
      _ = X ^ 4 := by ring
  -- the induction hypothesis on each differenced sum
  have hex : ∀ h ∈ H, ∃ q : ℕ, 1 ≤ q ∧ (q : ℝ) ≤ X ^ (4 * K₁) ∧
      ‖((q * ((d + 1) * h * a) : ℝ) : UnitAddCircle)‖ ≤ X ^ (4 * K₁ + 4 * d) / N ^ d := by
    intro h hh
    have hh' := (mem_filter.1 hh).2
    set M := N - h.natAbs
    have hMb := norm_vdcSum_le p N h
    have hMlow : δ ^ 2 * N / 4 ≤ M := hh'.trans hMb
    have hM0 : (0 : ℝ) < M := lt_of_lt_of_le (by positivity) hMlow
    have hM1 : 1 ≤ M := by exact_mod_cast hM0
    have hMN : (M : ℝ) ≤ N := by exact_mod_cast Nat.sub_le N h.natAbs
    obtain ⟨hdeg, hcoeff⟩ := vdcPoly_spec hp h
    have hδ' : 0 < δ ^ 2 / 4 := by positivity
    have hδ'2 : δ ^ 2 / 4 ≤ 1 / 2 := by nlinarith
    have hS' : δ ^ 2 / 4 * M ≤ ‖∑ t ∈ range M, eC ((vdcPoly p h).eval ((t : ℝ) + 1))‖ := by
      have : δ ^ 2 / 4 * M ≤ δ ^ 2 * N / 4 := by nlinarith
      exact this.trans hh'
    obtain ⟨q, hq1, hq2, hq3⟩ := hIH (vdcPoly p h) hdeg M hM1 (δ ^ 2 / 4) hδ' hδ'2 hS'
    have hinv : (δ ^ 2 / 4)⁻¹ ≤ X ^ 4 := by
      rw [hδX, inv_div, inv_pow, div_inv_eq_mul]; linarith
    have hinvK : (δ ^ 2 / 4)⁻¹ ^ K₁ ≤ X ^ (4 * K₁) := by
      rw [pow_mul]; exact pow_le_pow_left₀ (by positivity) hinv K₁
    refine ⟨q, hq1, hq2.trans hinvK, ?_⟩
    have h3 := hq3 d (mem_Icc.2 ⟨hd, le_rfl⟩)
    rw [hcoeff] at h3
    have hNM : (N : ℝ) ≤ X ^ 4 * M := by
      rw [hδX] at hMlow
      have : (N : ℝ) = 4 * X ^ 2 * (X⁻¹ ^ 2 * N / 4) := by field_simp
      rw [this]
      exact mul_le_mul hX4 hMlow (by positivity) (by positivity)
    have hNMd : (N : ℝ) ^ d ≤ X ^ (4 * d) * M ^ d := by
      rw [pow_mul, ← mul_pow]; exact pow_le_pow_left₀ (by positivity) hNM d
    calc _ ≤ (δ ^ 2 / 4)⁻¹ ^ K₁ / (M : ℝ) ^ d := h3
      _ ≤ X ^ (4 * K₁) / (M : ℝ) ^ d := div_le_div_of_nonneg_right hinvK (by positivity)
      _ ≤ X ^ (4 * K₁ + 4 * d) / N ^ d := by
          rw [div_le_div_iff₀ (by positivity) (by positivity), pow_add, mul_assoc]
          exact mul_le_mul_of_nonneg_left hNMd (by positivity)
  choose! qf hqf1 hqf2 hqf3 using hex
  -- pigeonhole the denominators
  set Q := ⌊X ^ (4 * K₁)⌋₊
  have hXK : (1 : ℝ) ≤ X ^ (4 * K₁) := one_le_pow₀ hX1
  have hQ1 : 1 ≤ Q := Nat.le_floor (by exact_mod_cast hXK)
  have hQ : (Q : ℝ) ≤ X ^ (4 * K₁) := Nat.floor_le (by positivity)
  have hQ0 : (0 : ℝ) < Q := by exact_mod_cast hQ1
  have hmaps : ∀ h ∈ H, qf h ∈ Icc 1 Q := fun h hh =>
    mem_Icc.2 ⟨hqf1 h hh, Nat.le_floor (hqf2 h hh)⟩
  obtain ⟨qs, hqs, hfib⟩ := exists_le_card_fiber_of_nsmul_le_card_of_maps_to hmaps
    ⟨1, mem_Icc.2 ⟨le_rfl, hQ1⟩⟩ (b := (#H : ℝ) / Q) (by
      rw [Nat.card_Icc, show Q + 1 - 1 = Q by omega, nsmul_eq_mul, mul_div_cancel₀ _ hQ0.ne'])
  set Hs := {h ∈ H | qf h = qs}
  -- apply Lemma 3.3
  set η := (X ^ (4 * K₁ + 3))⁻¹
  set E := X ^ (4 * K₁ + 4 * d) / N ^ d
  have hXa : (0 : ℝ) < X ^ (4 * K₁ + 3) := by positivity
  have hη : 0 < η := by positivity
  have hη1 : η ≤ 1 := inv_le_one_of_one_le₀ (one_le_pow₀ hX1)
  have hE0 : 0 ≤ E := by positivity
  have hNd : (N : ℝ) ≤ N ^ d := by
    calc (N : ℝ) = N ^ 1 := (pow_one _).symm
      _ ≤ N ^ d := pow_le_pow_right₀ hN1 hd
  have hX8 : (256 : ℝ) ≤ X ^ 8 := by
    have := two_pow_le_pow_of_two_le hX 8; norm_num at this; linarith
  have hX11 : (1536 : ℝ) ≤ X ^ 11 := by
    have := two_pow_le_pow_of_two_le hX 11; norm_num at this; linarith
  have hE : E ≤ η / (128 * (1 + 1)) := by
    simp only [E, η]
    rw [div_le_div_iff₀ (by positivity) (by positivity), inv_mul_eq_div, le_div_iff₀ hXa]
    calc X ^ (4 * K₁ + 4 * d) * (128 * (1 + 1)) * X ^ (4 * K₁ + 3)
        ≤ X ^ (4 * K₁ + 4 * d) * X ^ 8 * X ^ (4 * K₁ + 3) := by gcongr; linarith
      _ = X ^ (8 * K₁ + 4 * d + 11) := by rw [← pow_add, ← pow_add]; ring_nf
      _ ≤ X ^ (8 * K₁ + 4 * d + 17) := pow_le_pow_right₀ hX1 (by omega)
      _ ≤ N := hNl
      _ ≤ N ^ d := hNd
  have hNη : 384 * (1 + 1) ^ 2 / (1 * η ^ 2) ≤ N := by
    simp only [η]
    rw [inv_pow, one_mul, div_inv_eq_mul]
    calc (384 : ℝ) * (1 + 1) ^ 2 * (X ^ (4 * K₁ + 3)) ^ 2 ≤ X ^ 11 * (X ^ (4 * K₁ + 3)) ^ 2 := by
          gcongr; linarith
      _ = X ^ (8 * K₁ + 17) := by rw [← pow_mul, ← pow_add]; ring_nf
      _ ≤ X ^ (8 * K₁ + 4 * d + 17) := pow_le_pow_right₀ hX1 (by omega)
      _ ≤ N := hNl
  have hHs : ∀ h ∈ Hs, |(h : ℝ)| ≤ 1 * N := by
    intro h hh
    have hJ := (mem_filter.1 (mem_filter.1 hh).1).1
    rw [mem_Icc] at hJ
    rw [one_mul, abs_le]
    constructor
    · have : (1 - N : ℤ) ≤ h := hJ.1
      have : ((1 - N : ℤ) : ℝ) ≤ h := by exact_mod_cast this
      push_cast at this; linarith
    · have : h ≤ (N - 1 : ℤ) := hJ.2
      have : (h : ℝ) ≤ ((N - 1 : ℤ) : ℝ) := by exact_mod_cast this
      push_cast at this; linarith
  have hcard : η * N ≤ #Hs := by
    refine le_trans ?_ hfib
    rw [le_div_iff₀ hQ0]
    calc η * N * Q ≤ η * N * X ^ (4 * K₁) := by gcongr
      _ = N / (X ^ 3) := by
          simp only [η]; rw [pow_add]; field_simp
      _ ≤ δ ^ 2 * N / 2 := by
          rw [hδX, div_le_div_iff₀ (by positivity) (by norm_num)]
          have : X⁻¹ ^ 2 * X ^ 3 = X := by field_simp
          nlinarith
      _ ≤ #H := hH
  have hHE : ∀ h ∈ Hs, ‖((h * (qs * (d + 1) * a) : ℝ) : UnitAddCircle)‖ ≤ E := by
    intro h hh
    have hh' := mem_filter.1 hh
    have := hqf3 h hh'.1
    rw [hh'.2] at this
    convert this using 3; ring
  obtain ⟨r, hr1, hr2, hr3⟩ := norm_mul_le_of_many_multiples_int (c₀ := 1) one_pos hη hη1
    hE0 hE hNη hHs hcard hHE
  refine ⟨r * qs * (d + 1), by
    have : 1 ≤ qs := (mem_Icc.1 hqs).1
    have : 1 ≤ r * qs := Nat.one_le_iff_ne_zero.2 (by positivity)
    nlinarith, ?_, ?_⟩
  · have hqs' : (qs : ℝ) ≤ X ^ (4 * K₁) := by
      have : (qs : ℝ) ≤ Q := by exact_mod_cast (mem_Icc.1 hqs).2
      linarith
    have hr' : (r : ℝ) ≤ X ^ (4 * K₁ + 7) := by
      refine hr2.trans ?_
      simp only [η]
      rw [div_inv_eq_mul, pow_add, pow_add X _ 7]
      have : (8 : ℝ) * (1 + 1) ≤ X ^ 4 := by
        have := two_pow_le_pow_of_two_le hX 4; norm_num at this; linarith
      have hX7 : X ^ 4 * X ^ 3 = X ^ 7 := by rw [← pow_add]
      rw [← hX7]
      have : 0 ≤ X ^ (4 * K₁) * X ^ 3 := by positivity
      nlinarith
    have hd' : ((d + 1 : ℕ) : ℝ) ≤ X ^ (d + 1) := natCast_le_pow_of_two_le hX (d + 1)
    push_cast
    push_cast at hd'
    calc (r : ℝ) * qs * (d + 1) ≤ X ^ (4 * K₁ + 7) * X ^ (4 * K₁) * X ^ (d + 1) := by
          gcongr
      _ = X ^ (8 * K₁ + d + 8) := by rw [← pow_add, ← pow_add]; ring_nf
  · have heq : ((((r * qs * (d + 1) : ℕ) : ℝ) * a : ℝ)) = (r : ℝ) * (qs * (d + 1) * a) := by
      push_cast; ring
    rw [heq]
    refine hr3.trans ?_
    rw [show E = X ^ (4 * K₁ + 4 * d) / N ^ d from rfl,
      show η = (X ^ (4 * K₁ + 3))⁻¹ from rfl]
    have hp1 : X ^ (12 * K₁ + 4 * d + 17) =
        X ^ 11 * X ^ (4 * K₁ + 4 * d) * (X ^ (4 * K₁ + 3)) ^ 2 := by
      rw [← pow_mul, ← pow_add, ← pow_add]; congr 1; ring
    rw [hp1, div_le_div_iff₀ (by positivity) (by positivity)]
    have hNp : (N : ℝ) ^ (d + 1) = N ^ d * N := pow_succ _ _
    rw [hNp]
    field_simp
    linarith

/-! #### Lower coefficients -/

/-- The slowly varying weight `e(ε (i+1)^n)`. -/
noncomputable def slowWeight (ε : ℝ) (n i : ℕ) : ℂ := eC (ε * ((i : ℝ) + 1) ^ n)

/-- Total variation of the weight `e(ε t^n)` on `{1, …, N}`, plus its last value, is at most
`1 + 2π|ε| N^n`. -/
lemma slowWeight_variation_le (ε : ℝ) (n : ℕ) {N : ℕ} (hN : 1 ≤ N) :
    ‖slowWeight ε n (N - 1)‖ + ∑ i ∈ range (N - 1), ‖slowWeight ε n (i + 1) - slowWeight ε n i‖ ≤
      1 + 2 * Real.pi * |ε| * N ^ n := by
  rw [slowWeight, norm_eC]
  have hterm : ∀ i ∈ range (N - 1), ‖slowWeight ε n (i + 1) - slowWeight ε n i‖ ≤
      2 * Real.pi * |ε| * ((((i + 1 : ℕ) : ℝ) + 1) ^ n - ((i : ℝ) + 1) ^ n) := by
    intro i _
    refine (norm_eC_sub_eC_le _ _).trans (le_of_eq ?_)
    have hmono : ((i : ℝ) + 1) ^ n ≤ (((i + 1 : ℕ) : ℝ) + 1) ^ n :=
      pow_le_pow_left₀ (by positivity) (by push_cast; linarith) n
    rw [← mul_sub, abs_mul, abs_of_nonneg (sub_nonneg.2 hmono), mul_assoc]; ring
  have htel : ∑ i ∈ range (N - 1), ((((i + 1 : ℕ) : ℝ) + 1) ^ n - ((i : ℝ) + 1) ^ n) =
      (N : ℝ) ^ n - 1 := by
    rw [sum_range_sub (fun i : ℕ => ((i : ℝ) + 1) ^ n)]
    simp only [Nat.cast_zero, zero_add, one_pow]
    rw [Nat.cast_sub hN, Nat.cast_one, sub_add_cancel]
  have := sum_le_sum hterm
  rw [← mul_sum, htel] at this
  have hN1 : (1 : ℝ) ≤ (N : ℝ) ^ n := one_le_pow₀ (by exact_mod_cast hN)
  nlinarith [Real.pi_pos, abs_nonneg ε]

/-- The major-arc factor `t ↦ e(b t^n / q)` of `t = i + 1` is `q`-periodic in `i`. -/
lemma eC_int_mul_pow_div_periodic (b : ℤ) (n q : ℕ) (hq : 1 ≤ q) (i : ℕ) :
    eC (b * ((i : ℝ) + 1) ^ n / q) = eC (b * (((i % q : ℕ) : ℝ) + 1) ^ n / q) := by
  have hmod : (i % q + 1) ^ n ≡ (i + 1) ^ n [MOD q] :=
    Nat.ModEq.pow n (Nat.ModEq.add_right 1 (Nat.mod_modEq i q))
  obtain ⟨c, hc⟩ := (Nat.modEq_iff_dvd.1 hmod)
  have hcR : ((i : ℝ) + 1) ^ n = (((i % q : ℕ) : ℝ) + 1) ^ n + q * c := by
    have h' : (((i + 1) ^ n : ℕ) : ℝ) - (((i % q + 1) ^ n : ℕ) : ℝ) = (q : ℝ) * c := by
      exact_mod_cast hc
    rw [Nat.cast_pow, Nat.cast_pow, Nat.cast_add, Nat.cast_add, Nat.cast_one] at h'
    linarith
  have hq0 : (q : ℝ) ≠ 0 := by positivity
  rw [hcR, mul_add, add_div, eC_add,
    show (b : ℝ) * (q * c) / q = ((b * c : ℤ) : ℝ) by push_cast; field_simp,
    eC_intCast, mul_one]

/-- Inductive step, lower coefficients (major-arc Fourier expansion, summation by parts and the
induction hypothesis on a prefix): given `‖q₀ p_{d+1}‖_𝕋 ≤ δ^{-K₂} N^{-(d+1)}` with
`q₀ ≤ δ^{-K₃}`, all coefficients have a common approximate denominator. -/
lemma all_coeff_step {d K₁ K₂ K₃ : ℕ} (hd : 1 ≤ d) (hIH : InvWeylBound d K₁) {p : ℝ[X]}
    (hp : p.natDegree ≤ d + 1) {N : ℕ} (hN : 1 ≤ N) {δ : ℝ} (hδ : 0 < δ) (hδ2 : δ ≤ 1 / 2)
    (hS : δ * N ≤ ‖∑ t ∈ range N, eC (p.eval ((t : ℝ) + 1))‖) {q₀ : ℕ} (hq₀ : 1 ≤ q₀)
    (hq₀' : (q₀ : ℝ) ≤ δ⁻¹ ^ K₃)
    (hlead : ‖((q₀ * p.coeff (d + 1) : ℝ) : UnitAddCircle)‖ ≤ δ⁻¹ ^ K₂ / N ^ (d + 1)) :
    ∃ q : ℕ, 1 ≤ q ∧ (q : ℝ) ≤ δ⁻¹ ^ ((K₂ + K₃ + 4) * K₁ + K₃) ∧
      ∀ k ∈ Icc 1 (d + 1), ‖((q * p.coeff k : ℝ) : UnitAddCircle)‖ ≤
        δ⁻¹ ^ ((K₂ + K₃ + 4) * K₁ + K₃ + (K₂ + K₃ + 4) * d + K₂) / N ^ k := by
  set Y := δ⁻¹ with hYdef
  have hY : 2 ≤ Y := two_le_inv_of_le_half hδ hδ2
  have hY0 : 0 < Y := by linarith
  have hY1 : 1 ≤ Y := by linarith
  have hN0 : (0 : ℝ) < N := by exact_mod_cast hN
  have hN1 : (1 : ℝ) ≤ N := by exact_mod_cast hN
  have hq0R : (0 : ℝ) < q₀ := by exact_mod_cast hq₀
  set n := d + 1 with hn
  set K₄ := K₂ + K₃ + 4 with hK₄
  set a := p.coeff n
  -- `q₀ a = b + ε q₀`
  set b : ℤ := round ((q₀ : ℝ) * a)
  set ε : ℝ := ((q₀ : ℝ) * a - b) / q₀
  have ha : a = b / q₀ + ε := by simp only [ε]; field_simp; ring
  have hε : |ε| ≤ Y ^ K₂ / N ^ n := by
    have h1 : |(q₀ : ℝ) * a - b| ≤ Y ^ K₂ / N ^ n := by
      rw [← UnitAddCircle.norm_eq]; exact hlead
    simp only [ε]
    rw [abs_div, abs_of_pos hq0R, div_le_iff₀ hq0R]
    have : 0 ≤ Y ^ K₂ / N ^ n := by positivity
    have hq1R : (1 : ℝ) ≤ q₀ := by exact_mod_cast hq₀
    nlinarith
  -- the lower-degree part
  set plow := p - C a * X ^ n
  have hplow_deg : plow.natDegree ≤ d := by
    rw [natDegree_le_iff_coeff_eq_zero]
    intro m hm
    rw [coeff_sub, coeff_C_mul_X_pow]
    rcases (show m = n ∨ n < m by omega) with h | h
    · rw [ite_eq_left h, h, sub_self]
    · rw [ite_eq_right (by omega), coeff_eq_zero_of_natDegree_lt (lt_of_le_of_lt hp h), sub_zero]
  have hplow_coeff : ∀ m, m ≤ d → plow.coeff m = p.coeff m := by
    intro m hm
    rw [coeff_sub, coeff_C_mul_X_pow, ite_eq_right (by omega), sub_zero]
  have hplow_eval : ∀ x : ℝ, p.eval x = a * x ^ n + plow.eval x := by
    intro x; simp only [plow, eval_sub, eval_mul, eval_C, eval_pow, eval_X]; ring
  -- Fourier expansion of the major-arc factor
  set φ : ℕ → ℂ := fun i => eC (b * ((i : ℝ) + 1) ^ n / q₀)
  obtain ⟨α, hα1, hαexp⟩ := exists_periodic_expansion hq₀ φ
    (fun i => eC_int_mul_pow_div_periodic b n q₀ hq₀ i) (fun i => le_of_eq (norm_eC _))
  set P : ℕ → ℝ[X] := fun j => plow + C ((j : ℝ) / q₀) * (X - 1)
  set T : ℕ → ℂ := fun j =>
    ∑ t ∈ range N, slowWeight ε n t * eC ((P j).eval ((t : ℝ) + 1))
  have hST : ∑ t ∈ range N, eC (p.eval ((t : ℝ) + 1)) = ∑ j ∈ range q₀, α j * T j := by
    simp only [T, mul_sum]
    rw [sum_comm]
    refine sum_congr rfl fun t _ => ?_
    have hsplit : eC (p.eval ((t : ℝ) + 1)) =
        φ t * (slowWeight ε n t * eC (plow.eval ((t : ℝ) + 1))) := by
      simp only [φ, slowWeight]
      rw [← eC_add, ← eC_add, hplow_eval, ha]; congr 1; ring
    rw [hsplit, hαexp t, sum_mul]
    refine sum_congr rfl fun j _ => ?_
    simp only [P, eval_add, eval_mul, eval_C, eval_sub, eval_X, eval_one]
    rw [eC_add]
    have : ((j : ℝ) / q₀ * ((t : ℝ) + 1 - 1)) = j * t / q₀ := by ring
    rw [this]; ring
  -- pigeonhole a frequency `j`
  have hsumT : δ * N ≤ ∑ j ∈ range q₀, ‖T j‖ := by
    refine hS.trans ?_
    rw [hST]
    refine (norm_sum_le _ _).trans (sum_le_sum fun j _ => ?_)
    rw [norm_mul]
    exact mul_le_of_le_one_left (norm_nonneg _) (hα1 j)
  obtain ⟨j, hj, hjT⟩ := exists_le_of_sum_le (s := range q₀) (f := fun _ => δ * N / q₀)
    (g := fun j => ‖T j‖) ⟨0, mem_range.2 (by omega)⟩ (by
      rw [sum_const, card_range, nsmul_eq_mul, mul_div_cancel₀ _ hq0R.ne']; exact hsumT)
  -- summation by parts
  obtain ⟨k, hk, hkT⟩ := exists_norm_sum_mul_le (slowWeight ε n)
    (fun t => eC ((P j).eval ((t : ℝ) + 1))) hN
  have hW := slowWeight_variation_le ε n hN
  have hW' : 1 + 2 * Real.pi * |ε| * N ^ n ≤ Y ^ (K₂ + 3) := by
    have h1 : |ε| * (N : ℝ) ^ n ≤ Y ^ K₂ := by
      rw [le_div_iff₀ (by positivity)] at hε; exact hε
    have h2 : (1 : ℝ) ≤ Y ^ K₂ := one_le_pow₀ hY1
    have h3 : (8 : ℝ) ≤ Y ^ 3 := by
      have := two_pow_le_pow_of_two_le hY 3; norm_num at this; linarith
    rw [pow_add Y K₂ 3]
    have := Real.pi_lt_d2
    have h4 : 2 * Real.pi * |ε| * (N : ℝ) ^ n ≤ 2 * Real.pi * Y ^ K₂ := by
      rw [mul_assoc (2 * Real.pi)]
      exact mul_le_mul_of_nonneg_left h1 (by positivity)
    nlinarith
  set G := ‖∑ t ∈ range k, eC ((P j).eval ((t : ℝ) + 1))‖
  have hk1 : 1 ≤ k := (mem_Icc.1 hk).1
  have hkN : k ≤ N := (mem_Icc.1 hk).2
  have hGk : G ≤ k := by
    refine (norm_sum_le _ _).trans (le_of_eq ?_)
    simp [norm_eC]
  have hNG : (N : ℝ) ≤ Y ^ K₄ * G := by
    have h1 : δ * N / q₀ ≤ Y ^ (K₂ + 3) * G :=
      hjT.trans (hkT.trans (mul_le_mul_of_nonneg_right (hW.trans hW') (norm_nonneg _)))
    rw [div_le_iff₀ hq0R] at h1
    have h2 : δ * N ≤ Y ^ K₃ * (Y ^ (K₂ + 3) * G) := by
      calc δ * N ≤ Y ^ (K₂ + 3) * G * q₀ := h1
        _ ≤ Y ^ (K₂ + 3) * G * Y ^ K₃ := by gcongr
        _ = _ := by ring
    have hK : Y ^ K₄ = Y * (Y ^ K₃ * Y ^ (K₂ + 3)) := by
      rw [← pow_add, ← pow_succ']; congr 1; omega
    rw [hK]
    have hδY : δ * Y = 1 := mul_inv_cancel₀ hδ.ne'
    nlinarith
  -- the induction hypothesis on the prefix
  have hPdeg : (P j).natDegree ≤ d := by
    refine (natDegree_add_le _ _).trans (max_le hplow_deg ?_)
    refine (natDegree_C_mul_le _ _).trans ?_
    refine (natDegree_sub_le _ _).trans (max_le (natDegree_X_le.trans hd) ?_)
    rw [natDegree_one]; omega
  have hYK4 : (2 : ℝ) ≤ Y ^ K₄ :=
    hY.trans (by simpa using pow_le_pow_right₀ hY1 (show 1 ≤ K₄ by omega))
  have hδ'' : 0 < (Y ^ K₄)⁻¹ := by positivity
  have hδ''2 : (Y ^ K₄)⁻¹ ≤ 1 / 2 := by
    rw [inv_le_comm₀ (by positivity) (by norm_num)]; linarith
  have hSk : (Y ^ K₄)⁻¹ * k ≤ G := by
    rw [inv_mul_le_iff₀ (by positivity)]
    have : (k : ℝ) ≤ N := by exact_mod_cast hkN
    linarith
  obtain ⟨r, hr1, hr2, hr3⟩ := hIH (P j) hPdeg k hk1 (Y ^ K₄)⁻¹ hδ'' hδ''2 hSk
  rw [inv_inv, ← pow_mul] at hr2
  have hNk : (N : ℝ) ≤ Y ^ K₄ * k := hNG.trans (by gcongr)
  refine ⟨r * q₀, Nat.one_le_iff_ne_zero.2 (by positivity), ?_, ?_⟩
  · push_cast
    rw [pow_add]
    exact mul_le_mul hr2 hq₀' (by positivity) (by positivity)
  intro l hl
  have hl' := mem_Icc.1 hl
  have hexp_le : ∀ e : ℕ, e ≤ (K₂ + K₃ + 4) * K₁ + K₃ + (K₂ + K₃ + 4) * d + K₂ →
      Y ^ e / (N : ℝ) ^ l ≤
        Y ^ ((K₂ + K₃ + 4) * K₁ + K₃ + (K₂ + K₃ + 4) * d + K₂) / N ^ l := fun e he =>
    div_le_div_of_nonneg_right (pow_le_pow_right₀ hY1 he) (by positivity)
  rcases (show l = n ∨ l ≤ d by omega) with hln | hld
  · -- the leading coefficient
    have heq : (((r * q₀ : ℕ) : ℝ) * p.coeff l) = (r : ℝ) * (q₀ * a) := by
      rw [hln]; push_cast; ring
    rw [heq]
    refine (tnorm_natCast_mul_le _ _).trans ?_
    refine le_trans ?_ (hexp_le (K₄ * K₁ + K₂) (by rw [hK₄]; nlinarith))
    have hlead' : ‖((q₀ * a : ℝ) : UnitAddCircle)‖ ≤ Y ^ K₂ / N ^ l := by rw [hln]; exact hlead
    rw [pow_add, mul_div_assoc]
    exact mul_le_mul hr2 hlead' (norm_nonneg _) (by positivity)
  · -- a lower coefficient
    have hPc : (P j).coeff l = p.coeff l + if l = 1 then (j : ℝ) / q₀ else 0 := by
      simp only [P, coeff_add, coeff_C_mul, coeff_sub, coeff_X, coeff_one]
      rw [hplow_coeff l hld, ite_eq_right (by omega : l ≠ 0), sub_zero]
      by_cases h1 : l = 1
      · rw [ite_eq_left h1.symm, ite_eq_left h1, mul_one]
      · rw [ite_eq_right (Ne.symm h1), ite_eq_right h1, mul_zero]
    have h3 := hr3 l (mem_Icc.2 ⟨hl'.1, hld⟩)
    rw [inv_inv, ← pow_mul] at h3
    have hid : (((r * q₀ : ℕ) : ℝ) * p.coeff l) =
        (q₀ : ℝ) * (r * (P j).coeff l) + ((-(if l = 1 then (r * j : ℤ) else 0) : ℤ) : ℝ) := by
      rw [hPc]
      split_ifs with h1
      · push_cast; field_simp; ring
      · push_cast; ring
    rw [hid, tnorm_add_intCast]
    refine (tnorm_natCast_mul_le _ _).trans ?_
    have hkl : (N : ℝ) ^ l ≤ Y ^ (K₄ * d) * (k : ℝ) ^ l := by
      calc (N : ℝ) ^ l ≤ (Y ^ K₄ * k) ^ l := pow_le_pow_left₀ (by positivity) hNk l
        _ = Y ^ (K₄ * l) * (k : ℝ) ^ l := by rw [mul_pow, ← pow_mul]
        _ ≤ Y ^ (K₄ * d) * (k : ℝ) ^ l := mul_le_mul_of_nonneg_right
            (pow_le_pow_right₀ hY1 (Nat.mul_le_mul_left _ hld)) (by positivity)
    have hk0 : (0 : ℝ) < k := by exact_mod_cast hk1
    calc (q₀ : ℝ) * ‖((r * (P j).coeff l : ℝ) : UnitAddCircle)‖
        ≤ Y ^ K₃ * (Y ^ (K₄ * K₁) / (k : ℝ) ^ l) :=
          mul_le_mul hq₀' h3 (norm_nonneg _) (by positivity)
      _ ≤ Y ^ (K₃ + K₄ * K₁ + K₄ * d) / N ^ l := by
          rw [mul_div_assoc', div_le_div_iff₀ (by positivity) (by positivity)]
          calc Y ^ K₃ * Y ^ (K₄ * K₁) * (N : ℝ) ^ l
              ≤ Y ^ K₃ * Y ^ (K₄ * K₁) * (Y ^ (K₄ * d) * (k : ℝ) ^ l) := by gcongr
            _ = Y ^ (K₃ + K₄ * K₁ + K₄ * d) * (k : ℝ) ^ l := by rw [pow_add, pow_add]; ring
      _ ≤ _ := hexp_le _ (by
          rw [hK₄]
          generalize (K₂ + K₃ + 4) * K₁ = x
          generalize (K₂ + K₃ + 4) * d = y
          omega)

/-! #### The induction on the degree -/

/-- Inductive step of Lemma 3.4: the statement at degree `d ≥ 1` implies it at degree `d + 1`
(small `N` is handled by `q = 1`). -/
lemma invWeylBound_succ {d K₁ : ℕ} (hd : 1 ≤ d) (hIH : InvWeylBound d K₁) :
    InvWeylBound (d + 1) ((8 * K₁ + 4 * d + 17) * (d + 1) +
      (((12 * K₁ + 4 * d + 17) + (8 * K₁ + d + 8) + 4) * K₁ + (8 * K₁ + d + 8) +
        ((12 * K₁ + 4 * d + 17) + (8 * K₁ + d + 8) + 4) * d + (12 * K₁ + 4 * d + 17))) := by
  intro p hp N hN δ hδ hδ2 hS
  have hY := two_le_inv_of_le_half hδ hδ2
  have hY1 : 1 ≤ δ⁻¹ := by linarith
  have hN1 : (1 : ℝ) ≤ N := by exact_mod_cast hN
  by_cases hsmall : (N : ℝ) < δ⁻¹ ^ (8 * K₁ + 4 * d + 17)
  · refine ⟨1, le_rfl, by rw [Nat.cast_one]; exact one_le_pow₀ hY1, fun k hk => ?_⟩
    have hk := mem_Icc.1 hk
    refine (tnorm_le_half _).trans ?_
    rw [le_div_iff₀ (by positivity)]
    have h1 : (N : ℝ) ^ k ≤ (δ⁻¹ ^ (8 * K₁ + 4 * d + 17)) ^ (d + 1) :=
      (pow_le_pow_right₀ hN1 hk.2).trans (pow_le_pow_left₀ (by positivity) hsmall.le _)
    rw [← pow_mul] at h1
    have h2 := pow_le_pow_right₀ hY1 (Nat.le_add_right ((8 * K₁ + 4 * d + 17) * (d + 1))
      (((12 * K₁ + 4 * d + 17) + (8 * K₁ + d + 8) + 4) * K₁ + (8 * K₁ + d + 8) +
        ((12 * K₁ + 4 * d + 17) + (8 * K₁ + d + 8) + 4) * d + (12 * K₁ + 4 * d + 17)))
    have h3 : (0 : ℝ) ≤ N ^ k := by positivity
    linarith
  · rw [not_lt] at hsmall
    obtain ⟨q₀, h1, h2, h3⟩ := leading_coeff_step hd hIH hp hN hδ hδ2 hS hsmall
    obtain ⟨q, hq1, hq2, hq3⟩ := all_coeff_step hd hIH hp hN hδ hδ2 hS h1 h2 h3
    refine ⟨q, hq1, hq2.trans (pow_le_pow_right₀ hY1 (by
      generalize ((12 * K₁ + 4 * d + 17) + (8 * K₁ + d + 8) + 4) * K₁ = x
      generalize ((12 * K₁ + 4 * d + 17) + (8 * K₁ + d + 8) + 4) * d = y
      omega)), fun k hk => (hq3 k hk).trans
        (div_le_div_of_nonneg_right (pow_le_pow_right₀ hY1 (by omega)) (by positivity))⟩

/-- The inductive statement holds at every positive degree. -/
lemma exists_invWeylBound_succ (m : ℕ) : ∃ K, InvWeylBound (m + 1) K := by
  induction m with
  | zero => exact ⟨1, invWeylBound_one⟩
  | succ m ih =>
    obtain ⟨K, hK⟩ := ih
    exact ⟨_, invWeylBound_succ (by omega) hK⟩

/-- The inductive statement holds at every degree. -/
lemma exists_invWeylBound (m : ℕ) : ∃ K, InvWeylBound m K := by
  rcases Nat.eq_zero_or_pos m with rfl | hm
  · obtain ⟨K, hK⟩ := exists_invWeylBound_succ 0
    refine ⟨K, fun p hp N hN δ hδ hδ2 hS => ?_⟩
    obtain ⟨q, hq1, hq2, -⟩ := hK p (by omega) N hN δ hδ hδ2 hS
    exact ⟨q, hq1, hq2, fun k hk => by simp at hk⟩
  · obtain ⟨K, hK⟩ := exists_invWeylBound_succ (m - 1)
    rw [Nat.sub_add_cancel hm] at hK
    exact ⟨K, hK⟩

/-! #### Intervals and weights -/

/-- `C₀ (δ⁻¹)^K ≤ C δ^{-C}` whenever `C ≥ C₀` and `C ≥ K` (for `0 < δ ≤ 1/2`). -/
lemma mul_inv_pow_le_mul_rpow_neg {δ C₀ C : ℝ} (hδ : 0 < δ) (hδ2 : δ ≤ 1 / 2) {K : ℕ}
    (hC₀ : 0 ≤ C₀) (hC : C₀ ≤ C) (hK : (K : ℝ) ≤ C) :
    C₀ * δ⁻¹ ^ K ≤ C * δ ^ (-C) := by
  have hY1 : 1 ≤ δ⁻¹ := by linarith [two_le_inv_of_le_half hδ hδ2]
  rw [Real.rpow_neg hδ.le, ← Real.inv_rpow hδ.le, ← Real.rpow_natCast]
  exact mul_le_mul hC (Real.rpow_le_rpow_of_exponent_le hY1 hK) (by positivity)
    (hC₀.trans hC)

/-- Interval version of the inductive statement: sums over `[A, B] ⊆ [-c₀N, c₀N]`, with the
loss `C₀ (δ⁻¹)^{K+m}`, `C₀ = (m+1)(2(c₀+2))^m (2c₀+1)^K`. -/
lemma invWeyl_Icc_aux {m K : ℕ} (hK : InvWeylBound m K) {c₀ : ℝ} (hc₀ : 0 < c₀)
    {p : ℝ[X]} (hp : p.natDegree ≤ m) {N : ℕ} (hN : 1 ≤ N) {A B : ℤ} {δ : ℝ} (hδ : 0 < δ)
    (hδ2 : δ ≤ 1 / 2) (hA : -(c₀ * N) ≤ (A : ℝ)) (hB : (B : ℝ) ≤ c₀ * N)
    (hS : δ * N ≤ ‖∑ t ∈ Icc A B, eC (p.eval (t : ℝ))‖) :
    ∃ q : ℕ, 1 ≤ q ∧
      (q : ℝ) ≤ (m + 1) * (2 * (c₀ + 2)) ^ m * (2 * c₀ + 1) ^ K * δ⁻¹ ^ (K + m) ∧
      ∀ k ∈ Icc 1 m, ‖((q * p.coeff k : ℝ) : UnitAddCircle)‖ ≤
        (m + 1) * (2 * (c₀ + 2)) ^ m * (2 * c₀ + 1) ^ K * δ⁻¹ ^ (K + m) / N ^ k := by
  set Y := δ⁻¹ with hYdef
  have hY := two_le_inv_of_le_half hδ hδ2
  have hY1 : 1 ≤ Y := by linarith
  have hδY : δ * Y = 1 := mul_inv_cancel₀ hδ.ne'
  have hN0 : (0 : ℝ) < N := by exact_mod_cast hN
  set L := (B + 1 - A).toNat with hL
  set p' := p.comp (X + C ((A : ℝ) - 1))
  have hp' : p'.natDegree ≤ m := by rw [natDegree_comp_X_add_C]; exact hp
  have hsum : ∑ t ∈ Icc A B, eC (p.eval (t : ℝ)) = ∑ u ∈ range L, eC (p'.eval ((u : ℝ) + 1)) := by
    rw [sum_Icc_int_eq_sum_range]
    refine sum_congr rfl fun u _ => ?_
    simp only [p', eval_comp, eval_add, eval_X, eval_C]
    push_cast; ring_nf
  rw [hsum] at hS
  have hSL : ‖∑ u ∈ range L, eC (p'.eval ((u : ℝ) + 1))‖ ≤ L := by
    refine (norm_sum_le _ _).trans (le_of_eq ?_); simp [norm_eC]
  have hLlow : δ * N ≤ L := hS.trans hSL
  have hL1 : 1 ≤ L := by
    have : (0 : ℝ) < L := lt_of_lt_of_le (by positivity) hLlow
    exact_mod_cast this
  have hAB : A ≤ B := by omega
  have hLup : (L : ℝ) ≤ (2 * c₀ + 1) * N := by
    have : ((L : ℤ) : ℝ) = B + 1 - A := by
      rw [hL, Int.toNat_of_nonneg (by omega)]; push_cast; ring
    have hN1 : (1 : ℝ) ≤ N := by exact_mod_cast hN
    push_cast at this
    rw [this]; nlinarith
  set δ' := δ / (2 * c₀ + 1)
  have hc1 : 0 < 2 * c₀ + 1 := by linarith
  have hδ' : 0 < δ' := by positivity
  have hδ'2 : δ' ≤ 1 / 2 := (div_le_self hδ.le (by linarith)).trans hδ2
  have hS' : δ' * L ≤ ‖∑ u ∈ range L, eC (p'.eval ((u : ℝ) + 1))‖ := by
    refine le_trans ?_ hS
    simp only [δ']
    rw [div_mul_eq_mul_div, div_le_iff₀ hc1]
    nlinarith
  obtain ⟨q, hq1, hq2, hq3⟩ := hK p' hp' L hL1 δ' hδ' hδ'2 hS'
  have hinv : δ'⁻¹ = (2 * c₀ + 1) * Y := by simp only [δ']; rw [inv_div]; ring
  rw [hinv, mul_pow] at hq2 hq3
  set C₀ := (m + 1 : ℝ) * (2 * (c₀ + 2)) ^ m
  have hC₀ : 1 ≤ C₀ := one_le_mul_of_one_le_of_one_le (by linarith)
    (one_le_pow₀ (by linarith))
  refine ⟨q, hq1, ?_, ?_⟩
  · calc (q : ℝ) ≤ (2 * c₀ + 1) ^ K * Y ^ K := hq2
      _ ≤ C₀ * (2 * c₀ + 1) ^ K * Y ^ (K + m) := by
          rw [pow_add, mul_assoc C₀, ← mul_assoc _ (Y ^ K)]
          have h1 : (1 : ℝ) ≤ Y ^ m := one_le_pow₀ hY1
          have h2 : 0 ≤ (2 * c₀ + 1) ^ K * Y ^ K := by positivity
          have h3 : 1 ≤ C₀ * Y ^ m := one_le_mul_of_one_le_of_one_le hC₀ h1
          have := mul_le_mul_of_nonneg_left h3 h2
          linarith
  · -- translate back
    set E := (2 * c₀ + 1) ^ K * Y ^ (K + m)
    have hE : ∀ l ∈ Icc 1 m, ‖((q * p'.coeff l : ℝ) : UnitAddCircle)‖ ≤ E / N ^ l := by
      intro l hl
      refine (hq3 l hl).trans ?_
      have hl' := (mem_Icc.1 hl).2
      have hNL : (N : ℝ) ^ l ≤ Y ^ m * (L : ℝ) ^ l := by
        have : (N : ℝ) ≤ Y * L := by nlinarith
        calc (N : ℝ) ^ l ≤ (Y * L) ^ l := pow_le_pow_left₀ (by positivity) this l
          _ = Y ^ l * (L : ℝ) ^ l := mul_pow _ _ _
          _ ≤ Y ^ m * (L : ℝ) ^ l :=
              mul_le_mul_of_nonneg_right (pow_le_pow_right₀ hY1 hl') (by positivity)
      have hL0 : (0 : ℝ) < L := by exact_mod_cast hL1
      rw [div_le_div_iff₀ (by positivity) (by positivity)]
      simp only [E]
      rw [pow_add]
      calc (2 * c₀ + 1) ^ K * Y ^ K * (N : ℝ) ^ l
          ≤ (2 * c₀ + 1) ^ K * Y ^ K * (Y ^ m * (L : ℝ) ^ l) := by gcongr
        _ = _ := by ring
    have hc : |(((1 - A : ℤ)) : ℝ)| ≤ (c₀ + 1) * N := by
      have hN1 : (1 : ℝ) ≤ N := by exact_mod_cast hN
      have hAB' : (A : ℝ) ≤ B := by exact_mod_cast hAB
      push_cast
      rw [abs_le]; constructor <;> nlinarith
    have hback := tnorm_coeff_comp_le hp' (1 - A) q hN0 (by linarith) hc (by positivity) hE
    have hpp : p'.comp (X + C (((1 - A : ℤ)) : ℝ)) = p := by
      simp only [p']
      rw [comp_assoc, add_comp, X_comp, C_comp, add_assoc, ← C_add]
      push_cast
      rw [show (1 : ℝ) - A + (A - 1) = 0 by ring, C_0, add_zero, comp_X]
    rw [hpp] at hback
    intro k hk
    refine (hback k hk).trans (le_of_eq ?_)
    simp only [E, C₀]; ring

/-- Weighted version of the inductive statement (summation by parts reduces it to a prefix
interval). -/
lemma invWeyl_weighted_aux {m K : ℕ} (hK : InvWeylBound m K) {c₀ : ℝ} (hc₀ : 0 < c₀)
    {p : ℝ[X]} (hp : p.natDegree ≤ m) {N : ℕ} (hN : 1 ≤ N) {A B : ℤ} {δ : ℝ} (hδ : 0 < δ)
    (hδ2 : δ ≤ 1 / 2) (hA : -(c₀ * N) ≤ (A : ℝ)) (hB : (B : ℝ) ≤ c₀ * N) (w : ℤ → ℂ)
    (hw : ∀ t ∈ Icc A B, ‖w t‖ ≤ c₀) (hwv : ∑ t ∈ Ico A B, ‖w (t + 1) - w t‖ ≤ c₀)
    (hS : δ * N ≤ ‖∑ t ∈ Icc A B, w t * eC (p.eval (t : ℝ))‖) :
    ∃ q : ℕ, 1 ≤ q ∧
      (q : ℝ) ≤ (m + 1) * (2 * (c₀ + 2)) ^ m * (2 * c₀ + 1) ^ K * (2 * c₀ + 1) ^ (K + m) *
        δ⁻¹ ^ (K + m) ∧
      ∀ k ∈ Icc 1 m, ‖((q * p.coeff k : ℝ) : UnitAddCircle)‖ ≤
        (m + 1) * (2 * (c₀ + 2)) ^ m * (2 * c₀ + 1) ^ K * (2 * c₀ + 1) ^ (K + m) *
          δ⁻¹ ^ (K + m) / N ^ k := by
  have hN0 : (0 : ℝ) < N := by exact_mod_cast hN
  rw [sum_Icc_int_eq_sum_range] at hS
  set L := (B + 1 - A).toNat with hL
  have hL1 : 1 ≤ L := by
    by_contra h0
    have : L = 0 := by omega
    rw [this, sum_range_zero, norm_zero] at hS
    have : 0 < δ * N := by positivity
    linarith
  obtain ⟨k, hk, hkS⟩ := exists_norm_sum_mul_le (fun u : ℕ => w (A + u))
    (fun u : ℕ => eC (p.eval ((A + u : ℤ) : ℝ))) hL1
  have hW : ‖w (A + ((L - 1 : ℕ) : ℤ))‖ +
      ∑ i ∈ range (L - 1), ‖w (A + ((i + 1 : ℕ) : ℤ)) - w (A + (i : ℤ))‖ ≤ 2 * c₀ := by
    have h1 : ‖w (A + ((L - 1 : ℕ) : ℤ))‖ ≤ c₀ := hw _ (by rw [mem_Icc]; omega)
    have h2 : ∑ i ∈ range (L - 1), ‖w (A + ((i + 1 : ℕ) : ℤ)) - w (A + (i : ℤ))‖ =
        ∑ t ∈ Ico A B, ‖w (t + 1) - w t‖ := by
      rw [sum_Ico_int_eq_sum_range, show (B - A).toNat = L - 1 by omega]
      refine sum_congr rfl fun i _ => ?_
      push_cast; rw [add_assoc]
    rw [h2]; linarith
  have hk1 := (mem_Icc.1 hk).1
  have hkL := (mem_Icc.1 hk).2
  have hG : δ / (2 * c₀ + 1) * N ≤ ‖∑ u ∈ range k, eC (p.eval ((A + u : ℤ) : ℝ))‖ := by
    have h1 : δ * N ≤ 2 * c₀ * ‖∑ u ∈ range k, eC (p.eval ((A + u : ℤ) : ℝ))‖ :=
      hS.trans (hkS.trans (mul_le_mul_of_nonneg_right hW (norm_nonneg _)))
    rw [div_mul_eq_mul_div, div_le_iff₀ (by linarith)]
    nlinarith [norm_nonneg (∑ u ∈ range k, eC (p.eval ((A + u : ℤ) : ℝ)))]
  have hGsum : ∑ u ∈ range k, eC (p.eval ((A + u : ℤ) : ℝ)) =
      ∑ t ∈ Icc A (A + k - 1), eC (p.eval (t : ℝ)) := by
    rw [sum_Icc_int_eq_sum_range, show (A + k - 1 + 1 - A).toNat = k by omega]
  rw [hGsum] at hG
  have hc1 : 0 < 2 * c₀ + 1 := by linarith
  have hδ' : 0 < δ / (2 * c₀ + 1) := by positivity
  have hδ'2 : δ / (2 * c₀ + 1) ≤ 1 / 2 := (div_le_self hδ.le (by linarith)).trans hδ2
  have hB' : ((A + k - 1 : ℤ) : ℝ) ≤ c₀ * N := by
    have : A + k - 1 ≤ B := by omega
    have : ((A + k - 1 : ℤ) : ℝ) ≤ B := by exact_mod_cast this
    linarith
  obtain ⟨q, hq1, hq2, hq3⟩ := invWeyl_Icc_aux hK hc₀ hp hN hδ' hδ'2 hA hB' hG
  have hinv : (δ / (2 * c₀ + 1))⁻¹ ^ (K + m) = (2 * c₀ + 1) ^ (K + m) * δ⁻¹ ^ (K + m) := by
    rw [inv_div, div_eq_mul_inv, mul_pow]
  rw [hinv] at hq2 hq3
  refine ⟨q, hq1, hq2.trans (le_of_eq (by ring)), fun k hk => (hq3 k hk).trans
    (le_of_eq (by ring))⟩

/-! #### Lemma 3.4 -/

/-- The real polynomial `∑_{k ≤ m} a_k X^k`. -/
noncomputable def coeffPoly (a : ℕ → ℝ) (m : ℕ) : ℝ[X] :=
  ∑ k ∈ range (m + 1), C (a k) * X ^ k

/-- `∑_{k ≤ m} a_k X^k` has degree at most `m`. -/
lemma coeffPoly_natDegree_le (a : ℕ → ℝ) (m : ℕ) : (coeffPoly a m).natDegree ≤ m :=
  natDegree_sum_le_of_forall_le _ _ fun k hk =>
    (natDegree_C_mul_X_pow_le _ _).trans (by rw [mem_range] at hk; omega)

/-- Evaluation of `∑_{k ≤ m} a_k X^k`. -/
lemma coeffPoly_eval (a : ℕ → ℝ) (m : ℕ) (x : ℝ) :
    (coeffPoly a m).eval x = ∑ k ∈ range (m + 1), a k * x ^ k := by
  simp [coeffPoly, eval_finsetSum]

/-- The coefficients of `∑_{k ≤ m} a_k X^k`. -/
lemma coeffPoly_coeff (a : ℕ → ℝ) {m k : ℕ} (hk : k ≤ m) : (coeffPoly a m).coeff k = a k := by
  simp only [coeffPoly, finsetSum_coeff, coeff_C_mul_X_pow]
  rw [sum_ite_eq, ite_eq_left (mem_range.2 (by omega))]

/-- Blueprint Lemma 3.4 (`lem:inverseweyl`), first assertion: for each `m` there is `C ≥ 1`
such that for every real polynomial `F(t) = ∑_{k=0}^m a_k t^k`, every `N ≥ 1` and every
`0 < δ ≤ 1/2`, if `|∑_{t=1}^N e(F(t))| ≥ δN` then there is an integer `1 ≤ q ≤ C δ^{-C}` with
`‖q a_k‖_𝕋 ≤ C δ^{-C} N^{-k}` for `1 ≤ k ≤ m`. (The blueprint assumes `m ≥ 1`; the case
`m = 0` holds trivially.) -/
theorem exists_inverse_poly_sum (m : ℕ) :
    ∃ C : ℝ, 1 ≤ C ∧ ∀ (a : ℕ → ℝ) (N : ℕ) (δ : ℝ), 1 ≤ N → 0 < δ → δ ≤ 1 / 2 →
      δ * N ≤ ‖∑ t ∈ Icc 1 N, eC (∑ k ∈ range (m + 1), a k * (t : ℝ) ^ k)‖ →
      ∃ q : ℕ, 1 ≤ q ∧ (q : ℝ) ≤ C * δ ^ (-C) ∧
        ∀ k ∈ Icc 1 m, ‖((q * a k : ℝ) : UnitAddCircle)‖ ≤ C * δ ^ (-C) / N ^ k := by
  obtain ⟨K, hK⟩ := exists_invWeylBound m
  refine ⟨max 1 K, le_max_left _ _, fun a N δ hN hδ hδ2 hS => ?_⟩
  have hsum : ∑ t ∈ Icc 1 N, eC (∑ k ∈ range (m + 1), a k * (t : ℝ) ^ k) =
      ∑ t ∈ range N, eC ((coeffPoly a m).eval ((t : ℝ) + 1)) := by
    rw [sum_Icc_one_eq_sum_range]
    refine sum_congr rfl fun t _ => ?_
    rw [coeffPoly_eval]; push_cast; rfl
  rw [hsum] at hS
  obtain ⟨q, hq1, hq2, hq3⟩ := hK _ (coeffPoly_natDegree_le a m) N hN δ hδ hδ2 hS
  have hconv : δ⁻¹ ^ K ≤ max 1 (K : ℝ) * δ ^ (-max 1 (K : ℝ)) := by
    simpa using mul_inv_pow_le_mul_rpow_neg hδ hδ2 (C₀ := 1) (K := K) zero_le_one
      (le_max_left _ _) (le_max_right _ _)
  refine ⟨q, hq1, hq2.trans hconv, fun k hk => ?_⟩
  have := hq3 k hk
  rw [coeffPoly_coeff a (mem_Icc.1 hk).2] at this
  exact this.trans (div_le_div_of_nonneg_right hconv (by positivity))

/-- Blueprint Lemma 3.4 (`lem:inverseweyl`), second assertion (integer intervals): for each `m`
and `c₀ > 0` there is `C ≥ 1` (depending on `m, c₀`) such that for every real polynomial
`F(t) = ∑_{k=0}^m a_k t^k`, every `N ≥ 1`, every `0 < δ ≤ 1/2` and every integer interval
`[A, B] ⊆ [-c₀N, c₀N]`, if `|∑_{t=A}^B e(F(t))| ≥ δN` then there is an integer
`1 ≤ q ≤ C δ^{-C}` with `‖q a_k‖_𝕋 ≤ C δ^{-C} N^{-k}` for `1 ≤ k ≤ m`. (The blueprint's
hypothesis that the interval has length at least `δN` follows from the lower bound on the sum
and is omitted.) -/
theorem exists_inverse_poly_sum_Icc (m : ℕ) {c₀ : ℝ} (hc₀ : 0 < c₀) :
    ∃ C : ℝ, 1 ≤ C ∧ ∀ (a : ℕ → ℝ) (N : ℕ) (A B : ℤ) (δ : ℝ), 1 ≤ N → 0 < δ → δ ≤ 1 / 2 →
      -(c₀ * N) ≤ (A : ℝ) → (B : ℝ) ≤ c₀ * N →
      δ * N ≤ ‖∑ t ∈ Icc A B, eC (∑ k ∈ range (m + 1), a k * (t : ℝ) ^ k)‖ →
      ∃ q : ℕ, 1 ≤ q ∧ (q : ℝ) ≤ C * δ ^ (-C) ∧
        ∀ k ∈ Icc 1 m, ‖((q * a k : ℝ) : UnitAddCircle)‖ ≤ C * δ ^ (-C) / N ^ k := by
  obtain ⟨K, hK⟩ := exists_invWeylBound m
  set C₀ : ℝ := (m + 1) * (2 * (c₀ + 2)) ^ m * (2 * c₀ + 1) ^ K
  have hC₀ : 1 ≤ C₀ := one_le_mul_of_one_le_of_one_le
    (one_le_mul_of_one_le_of_one_le (by linarith) (one_le_pow₀ (by linarith)))
    (one_le_pow₀ (by linarith))
  refine ⟨max C₀ ((K + m : ℕ) : ℝ), hC₀.trans (le_max_left _ _),
    fun a N A B δ hN hδ hδ2 hA hB hS => ?_⟩
  have hsum : ∑ t ∈ Icc A B, eC (∑ k ∈ range (m + 1), a k * (t : ℝ) ^ k) =
      ∑ t ∈ Icc A B, eC ((coeffPoly a m).eval (t : ℝ)) :=
    sum_congr rfl fun t _ => by rw [coeffPoly_eval]
  rw [hsum] at hS
  obtain ⟨q, hq1, hq2, hq3⟩ :=
    invWeyl_Icc_aux hK hc₀ (coeffPoly_natDegree_le a m) hN hδ hδ2 hA hB hS
  have hconv := mul_inv_pow_le_mul_rpow_neg hδ hδ2 (C₀ := C₀) (K := K + m) (by linarith)
    (le_max_left _ _) (le_max_right _ _)
  refine ⟨q, hq1, hq2.trans hconv, fun k hk => ?_⟩
  have := hq3 k hk
  rw [coeffPoly_coeff a (mem_Icc.1 hk).2] at this
  exact this.trans (div_le_div_of_nonneg_right hconv (by positivity))

/-- Blueprint Lemma 3.4 (`lem:inverseweyl`), third assertion (weights): for each `m` and
`c₀ > 0` there is `C ≥ 1` (depending on `m, c₀`) such that for every real polynomial
`F(t) = ∑_{k=0}^m a_k t^k`, every `N ≥ 1`, every `0 < δ ≤ 1/2`, every integer interval
`[A, B] ⊆ [-c₀N, c₀N]` and every weight `w` with `max_{[A,B]} |w| ≤ c₀` and
`∑_{t=A}^{B-1} |w(t+1) - w(t)| ≤ c₀` (implied by the blueprint's
`max |w| + ∑ |w(t+1) - w(t)| ≤ c₀`), if `|∑_{t=A}^B w(t) e(F(t))| ≥ δN` then there is an
integer `1 ≤ q ≤ C δ^{-C}` with `‖q a_k‖_𝕋 ≤ C δ^{-C} N^{-k}` for `1 ≤ k ≤ m`. -/
theorem exists_inverse_poly_sum_weighted (m : ℕ) {c₀ : ℝ} (hc₀ : 0 < c₀) :
    ∃ C : ℝ, 1 ≤ C ∧ ∀ (a : ℕ → ℝ) (N : ℕ) (A B : ℤ) (δ : ℝ) (w : ℤ → ℂ), 1 ≤ N → 0 < δ →
      δ ≤ 1 / 2 → -(c₀ * N) ≤ (A : ℝ) → (B : ℝ) ≤ c₀ * N →
      (∀ t ∈ Icc A B, ‖w t‖ ≤ c₀) → ∑ t ∈ Ico A B, ‖w (t + 1) - w t‖ ≤ c₀ →
      δ * N ≤ ‖∑ t ∈ Icc A B, w t * eC (∑ k ∈ range (m + 1), a k * (t : ℝ) ^ k)‖ →
      ∃ q : ℕ, 1 ≤ q ∧ (q : ℝ) ≤ C * δ ^ (-C) ∧
        ∀ k ∈ Icc 1 m, ‖((q * a k : ℝ) : UnitAddCircle)‖ ≤ C * δ ^ (-C) / N ^ k := by
  obtain ⟨K, hK⟩ := exists_invWeylBound m
  set C₀ : ℝ := (m + 1) * (2 * (c₀ + 2)) ^ m * (2 * c₀ + 1) ^ K * (2 * c₀ + 1) ^ (K + m)
  have hC₀ : 1 ≤ C₀ := one_le_mul_of_one_le_of_one_le (one_le_mul_of_one_le_of_one_le
    (one_le_mul_of_one_le_of_one_le (by linarith) (one_le_pow₀ (by linarith)))
    (one_le_pow₀ (by linarith))) (one_le_pow₀ (by linarith))
  refine ⟨max C₀ ((K + m : ℕ) : ℝ), hC₀.trans (le_max_left _ _),
    fun a N A B δ w hN hδ hδ2 hA hB hw hwv hS => ?_⟩
  have hsum : ∑ t ∈ Icc A B, w t * eC (∑ k ∈ range (m + 1), a k * (t : ℝ) ^ k) =
      ∑ t ∈ Icc A B, w t * eC ((coeffPoly a m).eval (t : ℝ)) :=
    sum_congr rfl fun t _ => by rw [coeffPoly_eval]
  rw [hsum] at hS
  obtain ⟨q, hq1, hq2, hq3⟩ :=
    invWeyl_weighted_aux hK hc₀ (coeffPoly_natDegree_le a m) hN hδ hδ2 hA hB w hw hwv hS
  have hconv := mul_inv_pow_le_mul_rpow_neg hδ hδ2 (C₀ := C₀) (K := K + m) (by linarith)
    (le_max_left _ _) (le_max_right _ _)
  refine ⟨q, hq1, hq2.trans hconv, fun k hk => ?_⟩
  have := hq3 k hk
  rw [coeffPoly_coeff a (mem_Icc.1 hk).2] at this
  exact this.trans (div_le_div_of_nonneg_right hconv (by positivity))

/-! ### Corollary 3.5 -/

/-- Blueprint Corollary 3.5 (`lem:weylcor`), first assertion (slicing): for each `m` and
every real `c₀` there is `C ≥ 1` (depending on `m, c₀`) with the following property. Let `S` be a
nonempty finite set of slices (e.g. the values of the other `n - 1` coordinates of a box, so that
`#S = N^{n-1}`), and on each slice `s ∈ S` let `F_s(t) = ∑_{k=0}^m a_{s,k} t^k` be a real
polynomial phase in the first coordinate `t` and `w_s` a weight with `|w_s| ≤ A` on the integer
interval `[T₀, T₁] ⊆ [-c₀N, c₀N]` and variation `∑_{t=T₀}^{T₁-1} |w_s(t+1) - w_s(t)| ≤ A`. If
`N ≥ 1`, `A > 0`, `0 < δ ≤ 1/2` and `|∑_{s ∈ S} ∑_{t=T₀}^{T₁} w_s(t) e(F_s(t))| ≥ δ A N #S`, then
some slice `s ∈ S` satisfies the conclusion of Lemma 3.4: there is an integer `1 ≤ q ≤ C δ^{-C}`
with `‖q a_{s,k}‖_𝕋 ≤ C δ^{-C} N^{-k}` for `1 ≤ k ≤ m`. -/
theorem exists_slice_inverse_poly_sum_weighted (m : ℕ) (c₀ : ℝ) :
    ∃ C : ℝ, 1 ≤ C ∧ ∀ {ι : Type*} (S : Finset ι) (a : ι → ℕ → ℝ) (w : ι → ℤ → ℂ) (N : ℕ)
      (T₀ T₁ : ℤ) (A δ : ℝ), S.Nonempty → 1 ≤ N → 0 < A → 0 < δ → δ ≤ 1 / 2 →
      -(c₀ * N) ≤ (T₀ : ℝ) → (T₁ : ℝ) ≤ c₀ * N →
      (∀ s ∈ S, ∀ t ∈ Icc T₀ T₁, ‖w s t‖ ≤ A) →
      (∀ s ∈ S, ∑ t ∈ Ico T₀ T₁, ‖w s (t + 1) - w s t‖ ≤ A) →
      δ * A * N * #S ≤
        ‖∑ s ∈ S, ∑ t ∈ Icc T₀ T₁, w s t * eC (∑ k ∈ range (m + 1), a s k * (t : ℝ) ^ k)‖ →
      ∃ s ∈ S, ∃ q : ℕ, 1 ≤ q ∧ (q : ℝ) ≤ C * δ ^ (-C) ∧
        ∀ k ∈ Icc 1 m, ‖((q * a s k : ℝ) : UnitAddCircle)‖ ≤ C * δ ^ (-C) / N ^ k := by
  obtain ⟨C, hC, hmain⟩ := exists_inverse_poly_sum_weighted m (c₀ := max c₀ 1)
    (lt_of_lt_of_le zero_lt_one (le_max_right _ _))
  refine ⟨C, hC, fun S a w N T₀ T₁ A δ hS hN hA hδ hδ2 hT₀ hT₁ hw hwv hsum => ?_⟩
  set G : _ → ℂ := fun s =>
    ∑ t ∈ Icc T₀ T₁, w s t * eC (∑ k ∈ range (m + 1), a s k * (t : ℝ) ^ k) with hG
  obtain ⟨s, hs, hs'⟩ : ∃ s ∈ S, δ * A * N ≤ ‖G s‖ := by
    by_contra h
    push Not at h
    have h1 := Finset.sum_lt_sum_of_nonempty hS h
    rw [sum_const, nsmul_eq_mul] at h1
    have h2 : ‖∑ s ∈ S, G s‖ ≤ ∑ s ∈ S, ‖G s‖ := norm_sum_le _ _
    linarith
  have hc1 : (1 : ℝ) ≤ max c₀ 1 := le_max_right _ _
  have hA' : (A : ℂ) ≠ 0 := by exact_mod_cast hA.ne'
  have hnA : ‖(A : ℂ)‖ = A := by rw [Complex.norm_real, Real.norm_of_nonneg hA.le]
  refine ⟨s, hs, hmain (a s) N T₀ T₁ δ (fun t => w s t / A) hN hδ hδ2
    (le_trans (by nlinarith [le_max_left c₀ 1, (Nat.cast_nonneg N : (0 : ℝ) ≤ N)]) hT₀)
    (hT₁.trans (by nlinarith [le_max_left c₀ 1, (Nat.cast_nonneg N : (0 : ℝ) ≤ N)]))
    (fun t ht => ?_) ?_ ?_⟩
  · rw [norm_div, hnA, div_le_iff₀ hA]
    nlinarith [hw s hs t ht]
  · have : ∑ t ∈ Ico T₀ T₁, ‖w s (t + 1) / A - w s t / A‖ =
        (∑ t ∈ Ico T₀ T₁, ‖w s (t + 1) - w s t‖) / A := by
      rw [sum_div]
      refine sum_congr rfl fun t _ => ?_
      rw [← sub_div, norm_div, hnA]
    rw [this, div_le_iff₀ hA]
    nlinarith [hwv s hs]
  · have : ∑ t ∈ Icc T₀ T₁, w s t / A * eC (∑ k ∈ range (m + 1), a s k * (t : ℝ) ^ k) =
        G s / A := by
      rw [hG, sum_div]
      refine sum_congr rfl fun t _ => ?_
      ring
    rw [this, norm_div, hnA, le_div_iff₀ hA]
    linarith

/-- Blueprint Corollary 3.5 (`lem:weylcor`), first assertion, for slices over `{1, …, N}`: for
each `m` there is `C ≥ 1` such that if `S` is nonempty, `|w_s| ≤ A` on `[1, N]`,
`∑_{t=1}^{N-1} |w_s(t+1) - w_s(t)| ≤ A` and `|∑_{s ∈ S} ∑_{t=1}^N w_s(t) e(F_s(t))| ≥ δ A N #S`
(with `N ≥ 1`, `A > 0`, `0 < δ ≤ 1/2`), then some slice `s ∈ S` has an integer
`1 ≤ q ≤ C δ^{-C}` with `‖q a_{s,k}‖_𝕋 ≤ C δ^{-C} N^{-k}` for `1 ≤ k ≤ m`. -/
theorem exists_slice_inverse_poly_sum_weighted_Icc_one (m : ℕ) :
    ∃ C : ℝ, 1 ≤ C ∧ ∀ {ι : Type*} (S : Finset ι) (a : ι → ℕ → ℝ) (w : ι → ℤ → ℂ) (N : ℕ)
      (A δ : ℝ), S.Nonempty → 1 ≤ N → 0 < A → 0 < δ → δ ≤ 1 / 2 →
      (∀ s ∈ S, ∀ t ∈ Icc (1 : ℤ) N, ‖w s t‖ ≤ A) →
      (∀ s ∈ S, ∑ t ∈ Ico (1 : ℤ) N, ‖w s (t + 1) - w s t‖ ≤ A) →
      δ * A * N * #S ≤
        ‖∑ s ∈ S, ∑ t ∈ Icc (1 : ℤ) N, w s t * eC (∑ k ∈ range (m + 1), a s k * (t : ℝ) ^ k)‖ →
      ∃ s ∈ S, ∃ q : ℕ, 1 ≤ q ∧ (q : ℝ) ≤ C * δ ^ (-C) ∧
        ∀ k ∈ Icc 1 m, ‖((q * a s k : ℝ) : UnitAddCircle)‖ ≤ C * δ ^ (-C) / N ^ k := by
  obtain ⟨C, hC, h⟩ := exists_slice_inverse_poly_sum_weighted m 1
  refine ⟨C, hC, fun S a w N A δ hS hN hA hδ hδ2 hw hwv hsum => ?_⟩
  have hN1 : (1 : ℝ) ≤ N := by exact_mod_cast hN
  exact h S a w N 1 N A δ hS hN hA hδ hδ2 (by push_cast; linarith) (by push_cast; linarith)
    hw hwv hsum

/-- A reduced fraction `b/q` has `‖r b/q‖_𝕋 ≥ 1/q` for every integer `1 ≤ r < q`. -/
lemma one_div_le_tnorm_mul_div {b : ℤ} {q r : ℕ} (hbq : Int.gcd b q = 1) (hr : 1 ≤ r)
    (hrq : r < q) : 1 / (q : ℝ) ≤ ‖((r * (b / q : ℝ) : ℝ) : UnitAddCircle)‖ := by
  have hq0 : (0 : ℤ) < q := by exact_mod_cast (lt_of_le_of_lt hr hrq).trans_le' (by omega)
  have hx : ¬ ∃ n : ℤ, ((r * b : ℤ) / (q : ℤ) - (0 : ℤ) / (1 : ℤ) : ℝ) = n := by
    rintro ⟨n, hn⟩
    have hq' : ((q : ℤ) : ℝ) ≠ 0 := by exact_mod_cast hq0.ne'
    have h1 : ((r * b : ℤ) : ℝ) = (q : ℤ) * n := by
      field_simp at hn; push_cast at hn ⊢; linarith
    have h2 : (r : ℤ) * b = q * n := by exact_mod_cast h1
    have hdvd : (q : ℤ) ∣ (r : ℤ) * b := ⟨n, h2⟩
    have hcop : IsCoprime (q : ℤ) b := by
      rw [Int.isCoprime_iff_gcd_eq_one, Int.gcd_comm]; exact hbq
    have h3 : (q : ℤ) ∣ r := hcop.dvd_of_dvd_mul_right hdvd
    have h4 : (q : ℤ) ≤ r := Int.le_of_dvd (by omega) h3
    omega
  have := one_div_mul_le_norm_addCircle (r * b) 0 hq0 one_pos hx
  convert this using 2
  · push_cast; ring
  · push_cast; congr 1; ring

/-- The single-slice form of Blueprint Corollary 3.5 (`lem:weylcor`), second assertion. -/
lemma norm_sum_le_of_rational_coeff (m : ℕ) :
    ∃ C c : ℝ, 1 ≤ C ∧ 0 < c ∧ ∀ (a : ℕ → ℝ) (N : ℝ) (Q j : ℕ) (b : ℤ) (q : ℕ),
      1 ≤ N → N / 2 ≤ Q → 2 ≤ j → j ≤ m → a j = b / q → Int.gcd b q = 1 →
      Real.sqrt N / 2 ≤ q → (q : ℝ) ≤ N →
      ‖∑ t ∈ Icc 1 Q, eC (∑ k ∈ range (m + 1), a k * (t : ℝ) ^ k)‖ ≤ C * N ^ (-c) * Q := by
  obtain ⟨C₁, hC₁, hinv⟩ := exists_inverse_poly_sum m
  set c : ℝ := 1 / (8 * C₁) with hc
  have hc0 : 0 < c := by positivity
  refine ⟨4 * C₁ + 2, c, by linarith, hc0,
    fun a N Q j b q hN hQ hj2 hjm haj hbq hq1 hqN => ?_⟩
  have hN0 : 0 < N := by linarith
  set Sm := ∑ t ∈ Icc 1 Q, eC (∑ k ∈ range (m + 1), a k * (t : ℝ) ^ k)
  have htriv : ‖Sm‖ ≤ Q := by
    refine (norm_sum_le _ _).trans (le_of_eq ?_); simp [norm_eC]
  have hNc : 0 < N ^ c := Real.rpow_pos_of_pos hN0 c
  have hNneg : N ^ (-c) = (N ^ c)⁻¹ := Real.rpow_neg hN0.le c
  have hQ0 : (0 : ℝ) ≤ Q := Nat.cast_nonneg Q
  -- small `N`
  by_cases hsmall : N ^ c ≤ 4 * C₁ + 2
  · rw [hNneg]
    refine htriv.trans ?_
    rw [mul_assoc, ← div_eq_inv_mul, mul_div_assoc']
    rw [le_div_iff₀ hNc]
    nlinarith
  push Not at hsmall
  by_contra hcon
  push Not at hcon
  set δ := N ^ (-c) with hδ
  have hδ0 : 0 < δ := Real.rpow_pos_of_pos hN0 _
  have hδ2 : δ ≤ 1 / 2 := by
    rw [hNneg, inv_le_comm₀ hNc (by norm_num)]; linarith
  have hQ1 : 1 ≤ Q := by
    have : (1 / 2 : ℝ) ≤ Q := by linarith
    have : (0 : ℝ) < Q := by linarith
    exact_mod_cast this
  have hS : δ * Q ≤ ‖Sm‖ := by
    refine le_trans ?_ hcon.le
    have : δ * Q ≤ (4 * C₁ + 2) * δ * Q := by
      have : 0 ≤ δ * Q := by positivity
      nlinarith
    exact this
  obtain ⟨r, hr1, hr2, hr3⟩ := hinv a Q δ hQ1 hδ0 hδ2 hS
  -- `u = N^{1/8}`
  set u := N ^ ((1 : ℝ) / 8) with hu
  have hu0 : 0 < u := Real.rpow_pos_of_pos hN0 _
  have hδC : δ ^ (-C₁) = u := by
    rw [hδ, ← Real.rpow_mul hN0.le, hu]
    congr 1
    rw [hc]; field_simp
  have hNu : N = u ^ 8 := by
    rw [hu, ← Real.rpow_natCast, ← Real.rpow_mul hN0.le]; norm_num
  have hsqrt : Real.sqrt N = u ^ 4 := by
    rw [hNu, show u ^ 8 = (u ^ 4) ^ 2 by ring, Real.sqrt_sq (by positivity)]
  have hucN : N ^ c = u ^ (1 / C₁) := by
    rw [hu, ← Real.rpow_mul hN0.le]; congr 1; rw [hc]; field_simp
  have hu_big : 4 * C₁ + 2 ≤ u := by
    have h1 : 1 ≤ u ^ (1 / C₁) := by rw [← hucN]; linarith
    have h2 : (u ^ (1 / C₁)) ^ C₁ = u := by
      rw [← Real.rpow_mul hu0.le]; rw [one_div, inv_mul_cancel₀ (by linarith), Real.rpow_one]
    rw [← h2]
    calc 4 * C₁ + 2 ≤ u ^ (1 / C₁) := by rw [← hucN]; exact hsmall.le
      _ = (u ^ (1 / C₁)) ^ (1 : ℝ) := (Real.rpow_one _).symm
      _ ≤ (u ^ (1 / C₁)) ^ C₁ := Real.rpow_le_rpow_of_exponent_le h1 hC₁
  rw [hδC] at hr2 hr3
  -- `r < q`
  have hrq : r < q := by
    have h1 : (r : ℝ) < q := by
      refine lt_of_le_of_lt hr2 (lt_of_lt_of_le ?_ hq1)
      rw [hsqrt]
      have h3 : 4 * C₁ + 2 ≤ u ^ 3 := hu_big.trans (by
        calc u = u ^ 1 := (pow_one u).symm
          _ ≤ u ^ 3 := pow_le_pow_right₀ (by linarith) (by norm_num))
      calc C₁ * u < (2 * C₁ + 1) * u := by nlinarith
        _ = (4 * C₁ + 2) * u / 2 := by ring
        _ ≤ u ^ 3 * u / 2 := by gcongr
        _ = u ^ 4 / 2 := by ring
    exact_mod_cast h1
  have hlow := one_div_le_tnorm_mul_div hbq hr1 hrq
  have hup := hr3 j (mem_Icc.2 ⟨by omega, hjm⟩)
  rw [haj] at hup
  have hq0 : (0 : ℝ) < q := by
    have : (0 : ℝ) < r := by exact_mod_cast hr1
    have : (r : ℝ) < q := by exact_mod_cast hrq
    linarith
  have hQ1' : (1 : ℝ) ≤ Q := by exact_mod_cast hQ1
  have hQj : (Q : ℝ) ^ 2 ≤ (Q : ℝ) ^ j := pow_le_pow_right₀ hQ1' hj2
  have hQ2 : u ^ 16 / 4 ≤ (Q : ℝ) ^ 2 := by
    have : u ^ 8 / 2 ≤ Q := by rw [← hNu]; exact hQ
    have h0 : 0 ≤ u ^ 8 / 2 := by positivity
    nlinarith
  -- `1/q ≤ C₁ u / Q^j ≤ 4 C₁ u / u^16 < 1/u^8 ≤ 1/q`
  have h1 : 1 / (q : ℝ) ≤ C₁ * u / (Q : ℝ) ^ j := hlow.trans hup
  have h2 : 1 / u ^ 8 ≤ 1 / (q : ℝ) := by
    rw [← hNu]; exact one_div_le_one_div_of_le hq0 hqN
  have h3 : C₁ * u / (Q : ℝ) ^ j ≤ C₁ * u / (u ^ 16 / 4) :=
    div_le_div_of_nonneg_left (by positivity) (by positivity) (hQ2.trans hQj)
  have h4 : C₁ * u / (u ^ 16 / 4) < 1 / u ^ 8 := by
    rw [div_lt_div_iff₀ (by positivity) (by positivity)]
    have h7 : 4 * C₁ + 2 ≤ u ^ 7 := hu_big.trans (by
      calc u = u ^ 1 := (pow_one u).symm
        _ ≤ u ^ 7 := pow_le_pow_right₀ (by linarith) (by norm_num))
    have h8 : 4 * C₁ * u < u ^ 8 :=
      calc 4 * C₁ * u < (4 * C₁ + 2) * u := by nlinarith
        _ ≤ u ^ 7 * u := by gcongr
        _ = u ^ 8 := by ring
    calc C₁ * u * u ^ 8 = 4 * C₁ * u * u ^ 8 / 4 := by ring
      _ < u ^ 8 * u ^ 8 / 4 := by gcongr
      _ = 1 * (u ^ 16 / 4) := by ring
  linarith

/-- Blueprint Corollary 3.5 (`lem:weylcor`), second assertion (an exact rational coefficient):
for each degree bound `m` there are `C ≥ 1` and `c > 0` such that the following holds. Let
`N ≥ 1` be real and `Q ≥ N/2` an integer (the blueprint also assumes `Q ≤ N²`, which is not
needed), let `S` be a finite set of slices, and on each slice `s ∈ S` let
`F_s(t) = ∑_{k=0}^m a_{s,k} t^k` be a real polynomial in the first coordinate `t`. Suppose that
for one fixed power `2 ≤ j ≤ m` every slice has an exact rational coefficient
`a_{s,j} = b_s / q_s` in lowest terms, `gcd(b_s, q_s) = 1`, with denominator
`N^{1/2}/2 ≤ q_s ≤ N`. Then the complete sum of side `Q` satisfies
`|∑_{s ∈ S} ∑_{t=1}^Q e(F_s(t))| ≤ C N^{-c} Q #S`. (For the complete sum over a box of side `Q`
in `ℤⁿ`, take `S` to be the box of the other `n - 1` coordinates.) -/
theorem norm_sum_slices_le_of_rational_coeff (m : ℕ) :
    ∃ C c : ℝ, 1 ≤ C ∧ 0 < c ∧ ∀ {ι : Type*} (S : Finset ι) (a : ι → ℕ → ℝ) (b : ι → ℤ)
      (q : ι → ℕ) (N : ℝ) (Q j : ℕ), 1 ≤ N → N / 2 ≤ Q → 2 ≤ j → j ≤ m →
      (∀ s ∈ S, a s j = b s / q s) → (∀ s ∈ S, Int.gcd (b s) (q s) = 1) →
      (∀ s ∈ S, Real.sqrt N / 2 ≤ q s) → (∀ s ∈ S, (q s : ℝ) ≤ N) →
      ‖∑ s ∈ S, ∑ t ∈ Icc 1 Q, eC (∑ k ∈ range (m + 1), a s k * (t : ℝ) ^ k)‖ ≤
        C * N ^ (-c) * Q * #S := by
  obtain ⟨C, c, hC, hc, h⟩ := norm_sum_le_of_rational_coeff m
  refine ⟨C, c, hC, hc, fun S a b q N Q j hN hQ hj2 hjm hab hbq hq1 hqN => ?_⟩
  refine (norm_sum_le _ _).trans ?_
  have := sum_le_sum fun s hs => h (a s) N Q j (b s) (q s) hN hQ hj2 hjm (hab s hs) (hbq s hs)
    (hq1 s hs) (hqN s hs)
  rw [sum_const, nsmul_eq_mul] at this
  linarith

/-! ### Lemma 3.6 -/

/-- The summand `e((A z² + B z)/Q)` of the complete quadratic sum of Lemma 3.6. -/
noncomputable def gaussTerm (A B : ℤ) (Q : ℕ) (z : ℤ) : ℂ :=
  eC ((A * (z : ℝ) ^ 2 + B * z) / Q)

/-- The summand of the complete quadratic sum is `Q`-periodic. -/
lemma gaussTerm_add_mul (A B : ℤ) {Q : ℕ} (hQ : 1 ≤ Q) (z k : ℤ) :
    gaussTerm A B Q (z + Q * k) = gaussTerm A B Q z := by
  have hQ0 : (Q : ℝ) ≠ 0 := by positivity
  unfold gaussTerm
  rw [show (A * (((z + Q * k : ℤ)) : ℝ) ^ 2 + B * ((z + Q * k : ℤ) : ℝ)) / Q =
      (A * (z : ℝ) ^ 2 + B * z) / Q + ((A * (2 * z * k + Q * k ^ 2) + B * k : ℤ) : ℝ) by
    push_cast; field_simp; ring, eC_add, eC_intCast, mul_one]

/-- The summand of the complete quadratic sum only depends on `z mod Q`. -/
lemma gaussTerm_congr (A B : ℤ) {Q : ℕ} (hQ : 1 ≤ Q) {z z' : ℤ} (h : z ≡ z' [ZMOD Q]) :
    gaussTerm A B Q z = gaussTerm A B Q z' := by
  obtain ⟨k, hk⟩ := (Int.modEq_iff_dvd.1 h)
  rw [show z' = z + Q * k by linarith, gaussTerm_add_mul A B hQ]

/-- Translating by `v` with `Q ∣ A v` multiplies the summand by `e(B v / Q)`. -/
lemma gaussTerm_add_of_dvd (A B : ℤ) {Q : ℕ} (hQ : 1 ≤ Q) {v : ℤ} (hv : (Q : ℤ) ∣ A * v)
    (z : ℤ) : gaussTerm A B Q (z + v) = gaussTerm A B Q z * eC (B * v / Q) := by
  obtain ⟨m, hm⟩ := hv
  have hQ0 : (Q : ℝ) ≠ 0 := by positivity
  have hm' : (A : ℝ) * v = Q * m := by exact_mod_cast hm
  unfold gaussTerm
  rw [← eC_add, show (A * (((z + v : ℤ)) : ℝ) ^ 2 + B * ((z + v : ℤ) : ℝ)) / Q =
      ((A * (z : ℝ) ^ 2 + B * z) / Q + B * v / Q) + ((m * (2 * z + v) : ℤ) : ℝ) by
    push_cast; field_simp; linear_combination (2 * (z : ℝ) + v) * hm', eC_add (_ + _),
    eC_intCast, mul_one]

/-- Sums over `ZMod Q` of functions of the canonical representative are sums over
`{0, …, Q - 1}`. -/
lemma sum_zmod_val_eq_sum_range {M : Type*} [AddCommMonoid M] (Q : ℕ) [NeZero Q]
    (g : ℕ → M) : ∑ x : ZMod Q, g x.val = ∑ z ∈ range Q, g z := by
  refine (Finset.sum_nbij' (fun x => x.val) (fun z => (z : ZMod Q)) ?_ ?_ ?_ ?_ ?_)
  · intro x _; simpa using ZMod.val_lt x
  · intro z _; exact mem_univ _
  · intro x _; simp
  · intro z hz
    have hz' : z < Q := by simpa using hz
    exact ZMod.val_natCast_of_lt hz'
  · intro x _; rfl

/-- The summand evaluated at an integer equals the summand at the canonical representative of
its residue class. -/
lemma gaussTerm_val_intCast (A B : ℤ) {Q : ℕ} [NeZero Q] (hQ : 1 ≤ Q) (z : ℤ) :
    gaussTerm A B Q ((z : ZMod Q).val : ℤ) = gaussTerm A B Q z := by
  apply gaussTerm_congr A B hQ
  rw [ZMod.val_intCast]
  exact Int.mod_modEq z Q

/-- Counting the `t ∈ {0, …, Q - 1}` with `Q ∣ 2 A t`: there are at most `2 gcd(A, Q)`. -/
lemma card_filter_dvd_two_mul_le (A : ℤ) {Q : ℕ} (hQ : 1 ≤ Q) :
    #{t ∈ range Q | (Q : ℤ) ∣ 2 * A * ((t : ℕ) : ℤ)} ≤ 2 * Int.gcd A Q := by
  set g := Int.gcd A Q with hg
  have hg0 : 0 < g := Int.gcd_pos_of_ne_zero_right _ (by exact_mod_cast (by omega : Q ≠ 0))
  have hgQ : g ∣ Q := by
    have := Int.gcd_dvd_right A (Q : ℤ)
    exact_mod_cast this
  set v := Q / g with hv
  have hQv : Q = g * v := (Nat.mul_div_cancel' hgQ).symm
  have hv0 : 0 < v := Nat.div_pos (Nat.le_of_dvd (by omega) hgQ) hg0
  set a0 := A / g
  have hA : A = g * a0 := (Int.mul_ediv_cancel' (Int.gcd_dvd_left A Q)).symm
  have hcop : Int.gcd a0 v = 1 := by
    have := Int.gcd_div_gcd_div_gcd (i := A) (j := (Q : ℤ)) (by omega)
    rw [← hg] at this
    have hv' : ((Q : ℤ) / (g : ℤ)) = (v : ℤ) := by rw [hv]; push_cast [Nat.cast_div hgQ]; rfl
    rwa [hv'] at this
  have hkey : ∀ t ∈ ({t ∈ range Q | (Q : ℤ) ∣ 2 * A * ((t : ℕ) : ℤ)} : Finset ℕ), v ∣ 2 * t := by
    intro t ht
    rw [mem_filter] at ht
    have h1 : ((g : ℤ) * v) ∣ (g : ℤ) * (a0 * (2 * t)) := by
      have := ht.2
      rw [hQv, hA] at this
      push_cast at this
      convert this using 1; ring
    have h2 : (v : ℤ) ∣ a0 * (2 * t) := Int.dvd_of_mul_dvd_mul_left (by omega) h1
    have h3 : IsCoprime (v : ℤ) a0 := (Int.isCoprime_iff_gcd_eq_one.2 hcop).symm
    have h4 : (v : ℤ) ∣ ((2 * t : ℕ) : ℤ) := by push_cast; exact h3.dvd_of_dvd_mul_left h2
    exact_mod_cast h4
  calc #{t ∈ range Q | (Q : ℤ) ∣ 2 * A * ((t : ℕ) : ℤ)} ≤ #(range (2 * g)) := by
        refine card_le_card_of_injOn (fun t => 2 * t / v) ?_ ?_
        · intro t ht
          have hk := hkey t ht
          rw [coe_filter] at ht
          simp only [Set.mem_ofPred_eq, mem_range] at ht
          simp only [coe_range, Set.mem_Iio]
          rw [Nat.div_lt_iff_lt_mul hv0]
          rw [hQv] at ht
          nlinarith [ht.1]
        · intro t₁ h₁ t₂ h₂ he
          have e1 := Nat.mul_div_cancel' (hkey t₁ h₁)
          have e2 := Nat.mul_div_cancel' (hkey t₂ h₂)
          simp only at he
          rw [he] at e1
          omega
    _ = 2 * g := card_range _

/-- `e((A(t+s)² + B(t+s))/Q) · conj e((As² + Bs)/Q) = e((At² + Bt)/Q) e(s · 2At / Q)`. -/
lemma gaussTerm_add_mul_conj (A B : ℤ) {Q : ℕ} (hQ : 1 ≤ Q) (s t : ℤ) :
    gaussTerm A B Q (t + s) * (starRingEnd ℂ) (gaussTerm A B Q s) =
      gaussTerm A B Q t * eC ((s : ℝ) * ((2 * A * t : ℤ) : ℝ) / Q) := by
  have hQ0 : (Q : ℝ) ≠ 0 := by positivity
  unfold gaussTerm
  rw [conj_eC, ← eC_add, ← eC_add]
  congr 1
  push_cast
  field_simp
  ring

/-- The `|G|²` computation of Lemma 3.6: `|∑_{z<Q} e((Az² + Bz)/Q)|² ≤ Q · #{t < Q : Q ∣ 2At}`. -/
lemma norm_sum_gaussTerm_sq_le (A B : ℤ) {Q : ℕ} (hQ : 1 ≤ Q) :
    ‖∑ z ∈ range Q, gaussTerm A B Q z‖ ^ 2 ≤
      Q * #{t ∈ range Q | (Q : ℤ) ∣ 2 * A * ((t : ℕ) : ℤ)} := by
  have : NeZero Q := ⟨by omega⟩
  set F : ZMod Q → ℂ := fun x => gaussTerm A B Q (x.val : ℤ) with hFdef
  have hS : ∑ z ∈ range Q, gaussTerm A B Q z = ∑ x, F x :=
    (sum_zmod_val_eq_sum_range Q (fun z => gaussTerm A B Q (z : ℤ))).symm
  have hF : ∀ x y : ZMod Q, F (x + y) = gaussTerm A B Q ((x.val : ℤ) + y.val) := by
    intro x y
    simp only [hFdef]
    rw [← gaussTerm_val_intCast A B hQ ((x.val : ℤ) + y.val)]
    push_cast
    simp
  have horth : ∀ t : ℤ, ∑ y : ZMod Q, eC (((y.val : ℤ) : ℝ) * ((2 * A * t : ℤ) : ℝ) / Q) =
      if (Q : ℤ) ∣ 2 * A * t then (Q : ℂ) else 0 := by
    intro t
    simp only [Int.cast_natCast]
    rw [sum_zmod_val_eq_sum_range Q (fun j => eC ((j : ℝ) * ((2 * A * t : ℤ) : ℝ) / Q))]
    exact sum_eC_mul_div Q hQ _
  have key : (((‖∑ x, F x‖ ^ 2 : ℝ)) : ℂ) = ∑ t : ZMod Q, gaussTerm A B Q (t.val : ℤ) *
      (if (Q : ℤ) ∣ 2 * A * (t.val : ℤ) then (Q : ℂ) else 0) := by
    rw [Complex.ofReal_pow, ← Complex.mul_conj', map_sum, sum_mul_sum, sum_comm]
    calc ∑ y, ∑ x, F x * (starRingEnd ℂ) (F y)
        = ∑ y, ∑ t, F (t + y) * (starRingEnd ℂ) (F y) := by
          refine sum_congr rfl fun y _ => ?_
          exact (Fintype.sum_equiv (Equiv.addRight y) (fun t => F (t + y) * (starRingEnd ℂ) (F y))
            (fun x => F x * (starRingEnd ℂ) (F y)) (fun _ => rfl)).symm
      _ = ∑ y : ZMod Q, ∑ t : ZMod Q, gaussTerm A B Q (t.val : ℤ) *
            eC (((y.val : ℤ) : ℝ) * ((2 * A * (t.val : ℤ) : ℤ) : ℝ) / Q) := by
          refine sum_congr rfl fun y _ => sum_congr rfl fun t _ => ?_
          rw [hF, gaussTerm_add_mul_conj A B hQ]
      _ = _ := by
          rw [sum_comm]
          refine sum_congr rfl fun t _ => ?_
          rw [← mul_sum, horth]
  have hnorm : ‖∑ x, F x‖ ^ 2 ≤ ∑ t : ZMod Q,
      (if (Q : ℤ) ∣ 2 * A * ((t.val : ℕ) : ℤ) then (Q : ℝ) else 0) := by
    have h1 : ‖∑ x, F x‖ ^ 2 = ‖(((‖∑ x, F x‖ ^ 2 : ℝ)) : ℂ)‖ := by
      rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (by positivity)]
    rw [h1, key]
    refine (norm_sum_le _ _).trans (sum_le_sum fun t _ => ?_)
    rw [norm_mul]
    unfold gaussTerm
    rw [norm_eC, one_mul]
    split_ifs <;> simp
  rw [hS]
  refine hnorm.trans (le_of_eq ?_)
  rw [sum_zmod_val_eq_sum_range Q
    (fun t => if (Q : ℤ) ∣ 2 * A * ((t : ℕ) : ℤ) then (Q : ℝ) else 0), ← sum_filter,
    sum_const, nsmul_eq_mul, mul_comm]

/-- Blueprint Lemma 3.6 (`lem:gauss`), first assertion: for integers `A, B` and `Q ≥ 1`, with
`v = Q / gcd(A, Q)` the reduced denominator of `A/Q`, the complete quadratic sum
`G = Q⁻¹ ∑_{z mod Q} e((Az² + Bz)/Q)` satisfies `|G|² ≤ 2/v`. -/
theorem norm_quadratic_complete_sum_sq_le (A B : ℤ) {Q : ℕ} (hQ : 1 ≤ Q) :
    ‖(Q : ℂ)⁻¹ * ∑ z ∈ range Q, eC ((A * (z : ℝ) ^ 2 + B * z) / Q)‖ ^ 2 ≤
      2 / ((Q / Int.gcd A Q : ℕ) : ℝ) := by
  have hQ0 : (0 : ℝ) < Q := by exact_mod_cast hQ
  set g := Int.gcd A Q with hg
  have hg0 : 0 < g := Int.gcd_pos_of_ne_zero_right _ (by exact_mod_cast (by omega : Q ≠ 0))
  have hgQ : g ∣ Q := by
    have := Int.gcd_dvd_right A (Q : ℤ)
    exact_mod_cast this
  have hv : ((Q / g : ℕ) : ℝ) = Q / g := Nat.cast_div hgQ (by exact_mod_cast hg0.ne')
  have hsum : ∑ z ∈ range Q, eC ((A * (z : ℝ) ^ 2 + B * z) / Q) =
      ∑ z ∈ range Q, gaussTerm A B Q z := by
    refine sum_congr rfl fun z _ => ?_
    simp [gaussTerm]
  have h1 := norm_sum_gaussTerm_sq_le A B hQ
  have h2 : ((#{t ∈ range Q | (Q : ℤ) ∣ 2 * A * ((t : ℕ) : ℤ)} : ℕ) : ℝ) ≤ 2 * g := by
    exact_mod_cast card_filter_dvd_two_mul_le A hQ
  have hg0' : (0 : ℝ) < g := by exact_mod_cast hg0
  rw [hsum, norm_mul, mul_pow, norm_inv, Complex.norm_natCast, hv, div_div_eq_mul_div]
  rw [inv_pow, inv_mul_le_iff₀ (by positivity)]
  have h3 : (Q : ℝ) ^ 2 * (2 * g / Q) = Q * (2 * g) := by field_simp
  rw [h3]
  exact h1.trans (by gcongr)

/-- Blueprint Lemma 3.6 (`lem:gauss`), first assertion in the form `|G| ≤ (2/v)^{1/2}`, with
`v = Q / gcd(A, Q)` the reduced denominator of `A/Q`. -/
theorem norm_quadratic_complete_sum_le (A B : ℤ) {Q : ℕ} (hQ : 1 ≤ Q) :
    ‖(Q : ℂ)⁻¹ * ∑ z ∈ range Q, eC ((A * (z : ℝ) ^ 2 + B * z) / Q)‖ ≤
      Real.sqrt (2 / ((Q / Int.gcd A Q : ℕ) : ℝ)) :=
  Real.le_sqrt_of_sq_le (norm_quadratic_complete_sum_sq_le A B hQ)

/-- Translation invariance in Lemma 3.6: with `v = Q / gcd(A, Q)`, a nonzero complete quadratic
sum forces `Q ∣ B v`. -/
lemma dvd_mul_of_sum_gaussTerm_ne_zero (A B : ℤ) {Q : ℕ} (hQ : 1 ≤ Q)
    (h : ∑ z ∈ range Q, gaussTerm A B Q z ≠ 0) :
    (Q : ℤ) ∣ B * ((Q / Int.gcd A Q : ℕ) : ℤ) := by
  have : NeZero Q := ⟨by omega⟩
  have hQ0 : (Q : ℝ) ≠ 0 := by positivity
  set g := Int.gcd A Q with hg
  have hgQ : g ∣ Q := by
    have := Int.gcd_dvd_right A (Q : ℤ)
    exact_mod_cast this
  set v := Q / g with hv
  have hQv : Q = g * v := (Nat.mul_div_cancel' hgQ).symm
  have hA : A = g * (A / g) := (Int.mul_ediv_cancel' (Int.gcd_dvd_left A Q)).symm
  have hAv : (Q : ℤ) ∣ A * v := ⟨A / g, by
    rw [hQv]; push_cast; linear_combination (v : ℤ) * hA⟩
  set F : ZMod Q → ℂ := fun x => gaussTerm A B Q (x.val : ℤ) with hFdef
  have hS : ∑ z ∈ range Q, gaussTerm A B Q z = ∑ x, F x :=
    (sum_zmod_val_eq_sum_range Q (fun z => gaussTerm A B Q (z : ℤ))).symm
  set e := eC (B * ((v : ℤ) : ℝ) / Q) with he
  have hF : ∀ x : ZMod Q, F (x + (v : ZMod Q)) = F x * e := by
    intro x
    simp only [hFdef]
    rw [← gaussTerm_add_of_dvd A B hQ hAv, ← gaussTerm_val_intCast A B hQ ((x.val : ℤ) + v)]
    push_cast
    simp
  have hinv : ∑ x, F x = (∑ x, F x) * e := by
    rw [sum_mul]
    calc ∑ x, F x = ∑ x, F (x + (v : ZMod Q)) :=
          (Fintype.sum_equiv (Equiv.addRight (v : ZMod Q)) (fun x => F (x + (v : ZMod Q))) F
            (fun _ => rfl)).symm
      _ = ∑ x, F x * e := sum_congr rfl fun x _ => hF x
  rw [hS] at h
  have he1 : e = 1 := mul_left_cancel₀ h (by rw [mul_one]; exact hinv.symm)
  obtain ⟨n, hn⟩ := (eC_eq_one_iff _).1 he1
  refine ⟨n, ?_⟩
  have : (B : ℝ) * ((v : ℤ) : ℝ) = Q * n := by rw [← hn]; field_simp
  exact_mod_cast this

/-- Blueprint Lemma 3.6 (`lem:gauss`), second assertion: let `A, a, h` be integers and `Q ≥ 1`,
let `v = Q / gcd(A, Q)` be the reduced denominator of `A/Q`, and let `α = a/q` be reduced with
`q ∣ Q`. If the linear coefficient is `-2αh`, i.e. `B/Q = -2(a/q)h`, i.e. `B = -2ah(Q/q)`, then
`G = Q⁻¹ ∑_{z mod Q} e((Az² + Bz)/Q) ≠ 0` implies `q ∣ 2vh`. -/
theorem dvd_of_quadratic_complete_sum_ne_zero (A B a h : ℤ) {Q q : ℕ} (hQ : 1 ≤ Q)
    (hqQ : q ∣ Q) (haq : Int.gcd a q = 1) (hB : B = -2 * a * h * ((Q / q : ℕ) : ℤ))
    (hG : (Q : ℂ)⁻¹ * ∑ z ∈ range Q, eC ((A * (z : ℝ) ^ 2 + B * z) / Q) ≠ 0) :
    (q : ℤ) ∣ 2 * ((Q / Int.gcd A Q : ℕ) : ℤ) * h := by
  have hsum : ∑ z ∈ range Q, eC ((A * (z : ℝ) ^ 2 + B * z) / Q) =
      ∑ z ∈ range Q, gaussTerm A B Q z := by
    refine sum_congr rfl fun z _ => ?_
    simp [gaussTerm]
  have hS : ∑ z ∈ range Q, gaussTerm A B Q z ≠ 0 := by
    rw [← hsum]; exact right_ne_zero_of_mul hG
  have hd := dvd_mul_of_sum_gaussTerm_ne_zero A B hQ hS
  set v : ℤ := ((Q / Int.gcd A Q : ℕ) : ℤ)
  set r := Q / q with hr
  have hQr : Q = q * r := (Nat.mul_div_cancel' hqQ).symm
  have hr0 : (r : ℤ) ≠ 0 := by
    have : r ≠ 0 := by rintro h0; rw [h0, mul_zero] at hQr; omega
    exact_mod_cast this
  rw [hB, hQr] at hd
  push_cast at hd
  have h1 : (q : ℤ) * r ∣ (a * (2 * v * h)) * r := by
    have := dvd_neg.2 hd
    convert this using 1; ring
  have h2 : (q : ℤ) ∣ a * (2 * v * h) := Int.dvd_of_mul_dvd_mul_right hr0 h1
  have h3 : IsCoprime (q : ℤ) a := (Int.isCoprime_iff_gcd_eq_one.2 haq).symm
  exact h3.dvd_of_dvd_mul_left h2


/-! ### Lemma 3.7 (`lem:periodic`) -/

section PeriodicDecay

open MeasureTheory
open scoped ComplexConjugate SchwartzMap

variable {n : ℕ}

/-- Schwartz decay of order `M` for `φ` and its first derivative, with one constant `K`. -/
lemma exists_schwartz_decay (φ : 𝓢(EuclideanSpace ℝ (Fin n), ℂ)) (M : ℕ) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ x, (1 + ‖x‖) ^ M * ‖φ x‖ ≤ K ∧ (1 + ‖x‖) ^ M * ‖fderiv ℝ φ x‖ ≤ K := by
  refine ⟨2 ^ M * ((Finset.Iic (M, 1)).sup fun m => SchwartzMap.seminorm ℝ m.1 m.2) φ,
    by positivity, fun x => ⟨?_, ?_⟩⟩
  · have := SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℝ) (m := (M, 1)) (k := M) (n := 0)
      le_rfl (by norm_num) φ x
    rwa [norm_iteratedFDeriv_zero] at this
  · have := SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℝ) (m := (M, 1)) (k := M) (n := 1)
      le_rfl le_rfl φ x
    rwa [norm_iteratedFDeriv_one] at this

/-- Transfer of polynomial decay: if `v ≤ u w` then `u^{-M} ≤ w^M v^{-M}`. -/
lemma inv_pow_le_of_le_mul {u v w : ℝ} (hu : 0 < u) (hv : 0 < v) (h : v ≤ u * w)
    (M : ℕ) : (u ^ M)⁻¹ ≤ w ^ M * (v ^ M)⁻¹ := by
  rw [← div_eq_mul_inv, le_div_iff₀ (pow_pos hv M)]
  have h1 : v ^ M ≤ u ^ M * w ^ M := by rw [← mul_pow]; exact pow_le_pow_left₀ hv.le h M
  calc (u ^ M)⁻¹ * v ^ M ≤ (u ^ M)⁻¹ * (u ^ M * w ^ M) := by gcongr
    _ = w ^ M := by field_simp

/-- Pointwise decay `|φ(x)| ≤ K (1 + |x|)^{-M}`. -/
lemma norm_le_of_decay {φ : EuclideanSpace ℝ (Fin n) → ℂ} {M : ℕ} {K : ℝ}
    (hK : ∀ x, (1 + ‖x‖) ^ M * ‖φ x‖ ≤ K) (x : EuclideanSpace ℝ (Fin n)) :
    ‖φ x‖ ≤ K * ((1 + ‖x‖) ^ M)⁻¹ := by
  rw [← div_eq_mul_inv, le_div_iff₀ (by positivity), mul_comm]; exact hK x

/-- Decay at `y` measured from a second point `x`:
`|φ(y)| ≤ K (1 + |y - x|)^M (1 + |x|)^{-M}`. -/
lemma norm_le_of_decay' {φ : EuclideanSpace ℝ (Fin n) → ℂ} {M : ℕ} {K : ℝ}
    (hK : ∀ x, (1 + ‖x‖) ^ M * ‖φ x‖ ≤ K) (x y : EuclideanSpace ℝ (Fin n)) :
    ‖φ y‖ ≤ K * (1 + ‖y - x‖) ^ M * ((1 + ‖x‖) ^ M)⁻¹ := by
  have hK0 : 0 ≤ K := le_trans (by positivity) (hK x)
  refine (norm_le_of_decay hK y).trans ?_
  rw [mul_assoc]
  gcongr
  refine inv_pow_le_of_le_mul (by positivity) (by positivity) ?_ M
  have := norm_le_insert' x y
  nlinarith [norm_nonneg y, norm_nonneg (y - x), norm_sub_rev x y]

/-- Mean value bound for a Schwartz function:
`|φ(y) - φ(x)| ≤ K (1 + |y - x|)^M (1 + |x|)^{-M} |y - x|`. -/
lemma norm_sub_le_of_decay (φ : 𝓢(EuclideanSpace ℝ (Fin n), ℂ)) {M : ℕ} {K : ℝ}
    (hK : ∀ x, (1 + ‖x‖) ^ M * ‖fderiv ℝ φ x‖ ≤ K) (x y : EuclideanSpace ℝ (Fin n)) :
    ‖φ y - φ x‖ ≤ K * (1 + ‖y - x‖) ^ M * ((1 + ‖x‖) ^ M)⁻¹ * ‖y - x‖ := by
  have hK0 : 0 ≤ K := le_trans (by positivity) (hK x)
  refine (convex_closedBall x ‖y - x‖).norm_image_sub_le_of_norm_fderiv_le
    (fun z _ => φ.differentiableAt) (fun z hz => ?_) (Metric.mem_closedBall_self (norm_nonneg _))
    (by simp [dist_eq_norm])
  rw [Metric.mem_closedBall, dist_eq_norm] at hz
  have h1 : ‖fderiv ℝ φ z‖ ≤ K * ((1 + ‖z‖) ^ M)⁻¹ := by
    rw [← div_eq_mul_inv, le_div_iff₀ (by positivity), mul_comm]; exact hK z
  refine h1.trans ?_
  rw [mul_assoc]
  gcongr
  refine inv_pow_le_of_le_mul (by positivity) (by positivity) ?_ M
  have := norm_le_insert' x z
  nlinarith [norm_nonneg z, norm_nonneg (y - x), norm_sub_rev x z]

/-- The `L¹`-normalized dilate `φ_L(z) = L^{-n} φ(z/L)` of Blueprint Lemma 3.7 (`lem:periodic`). -/
noncomputable def dilateL (φ : EuclideanSpace ℝ (Fin n) → ℂ) (L : ℝ)
    (z : EuclideanSpace ℝ (Fin n)) : ℂ :=
  (((L ^ n)⁻¹ : ℝ) : ℂ) * φ (L⁻¹ • z)

/-- `|φ_L(z)| = L^{-n} |φ(z/L)|`. -/
lemma norm_dilateL {φ : EuclideanSpace ℝ (Fin n) → ℂ} {L : ℝ} (hL : 0 < L)
    (z : EuclideanSpace ℝ (Fin n)) : ‖dilateL φ L z‖ = (L ^ n)⁻¹ * ‖φ (L⁻¹ • z)‖ := by
  rw [dilateL, norm_mul, Complex.norm_real, Real.norm_of_nonneg (by positivity)]

/-- `|z/L| = |z|/L` for `L > 0`. -/
lemma norm_inv_smul_of_pos {L : ℝ} (hL : 0 < L) (z : EuclideanSpace ℝ (Fin n)) :
    ‖L⁻¹ • z‖ = ‖z‖ / L := by
  rw [norm_smul, Real.norm_of_nonneg (by positivity), inv_mul_eq_div]

/-- Decay of the dilate: `|φ_L(u)| ≤ K L^{-n} (1 + |u|/L)^{-M}`. -/
lemma norm_dilateL_le {φ : EuclideanSpace ℝ (Fin n) → ℂ} {M : ℕ} {K : ℝ}
    (hK : ∀ x, (1 + ‖x‖) ^ M * ‖φ x‖ ≤ K) {L : ℝ} (hL : 0 < L) (u : EuclideanSpace ℝ (Fin n)) :
    ‖dilateL φ L u‖ ≤ K * ((L ^ n)⁻¹ * ((1 + ‖u‖ / L) ^ M)⁻¹) := by
  rw [norm_dilateL hL]
  have := norm_le_of_decay hK (L⁻¹ • u)
  rw [norm_inv_smul_of_pos hL] at this
  calc (L ^ n)⁻¹ * ‖φ (L⁻¹ • u)‖ ≤ (L ^ n)⁻¹ * (K * ((1 + ‖u‖ / L) ^ M)⁻¹) := by gcongr
    _ = _ := by ring

/-- Decay of the dilate measured from `p`:
`|φ_L(w)| ≤ K (1 + |w - p|/L)^M L^{-n} (1 + |p|/L)^{-M}`. -/
lemma norm_dilateL_le' {φ : EuclideanSpace ℝ (Fin n) → ℂ} {M : ℕ} {K : ℝ}
    (hK : ∀ x, (1 + ‖x‖) ^ M * ‖φ x‖ ≤ K) {L : ℝ} (hL : 0 < L) (p w : EuclideanSpace ℝ (Fin n)) :
    ‖dilateL φ L w‖ ≤ K * (1 + ‖w - p‖ / L) ^ M * ((L ^ n)⁻¹ * ((1 + ‖p‖ / L) ^ M)⁻¹) := by
  rw [norm_dilateL hL]
  have := norm_le_of_decay' hK (L⁻¹ • p) (L⁻¹ • w)
  rw [← smul_sub, norm_inv_smul_of_pos hL, norm_inv_smul_of_pos hL] at this
  calc (L ^ n)⁻¹ * ‖φ (L⁻¹ • w)‖ ≤ (L ^ n)⁻¹ * (K * (1 + ‖w - p‖ / L) ^ M *
        ((1 + ‖p‖ / L) ^ M)⁻¹) := by gcongr
    _ = _ := by ring

/-- Mean value bound for the dilate:
`|φ_L(w) - φ_L(p)| ≤ K (1 + |w - p|/L)^M (|w - p|/L) L^{-n} (1 + |p|/L)^{-M}`. -/
lemma norm_dilateL_sub_le (φ : 𝓢(EuclideanSpace ℝ (Fin n), ℂ)) {M : ℕ} {K : ℝ}
    (hK : ∀ x, (1 + ‖x‖) ^ M * ‖fderiv ℝ φ x‖ ≤ K) {L : ℝ} (hL : 0 < L)
    (p w : EuclideanSpace ℝ (Fin n)) :
    ‖dilateL φ L w - dilateL φ L p‖ ≤
      K * (1 + ‖w - p‖ / L) ^ M * (‖w - p‖ / L) * ((L ^ n)⁻¹ * ((1 + ‖p‖ / L) ^ M)⁻¹) := by
  have e : dilateL φ L w - dilateL φ L p =
      (((L ^ n)⁻¹ : ℝ) : ℂ) * (φ (L⁻¹ • w) - φ (L⁻¹ • p)) := by
    rw [dilateL, dilateL, mul_sub]
  rw [e, norm_mul, Complex.norm_real, Real.norm_of_nonneg (by positivity)]
  have := norm_sub_le_of_decay φ hK (L⁻¹ • p) (L⁻¹ • w)
  rw [← smul_sub, norm_inv_smul_of_pos hL, norm_inv_smul_of_pos hL] at this
  calc (L ^ n)⁻¹ * ‖φ (L⁻¹ • w) - φ (L⁻¹ • p)‖ ≤ (L ^ n)⁻¹ * (K * (1 + ‖w - p‖ / L) ^ M *
        ((1 + ‖p‖ / L) ^ M)⁻¹ * (‖w - p‖ / L)) := by gcongr
    _ = _ := by ring

/-- The product of two decay factors of order `2n+2` at `u` and `v` is dominated by
`B_L(η) B_L(u)` whenever `|η| ≤ |u| + |v|` (via `1 + |η|/L ≤ (1 + |u|/L)(1 + |v|/L)`). -/
lemma decay_mul_decay_le_envelope {L : ℝ} (hL : 0 < L) {u v η : EuclideanSpace ℝ (Fin n)}
    (h : ‖η‖ ≤ ‖u‖ + ‖v‖) :
    ((L ^ n)⁻¹ * ((1 + ‖u‖ / L) ^ (2 * n + 2))⁻¹) * ((L ^ n)⁻¹ * ((1 + ‖v‖ / L) ^ (2 * n + 2))⁻¹)
      ≤ envelope n L η * envelope n L u := by
  have hu : 0 ≤ ‖u‖ / L := by positivity
  have hv : 0 ≤ ‖v‖ / L := by positivity
  have hη : 0 ≤ ‖η‖ / L := by positivity
  have hcab : 1 + ‖η‖ / L ≤ (1 + ‖u‖ / L) * (1 + ‖v‖ / L) := by
    have : ‖η‖ / L ≤ ‖u‖ / L + ‖v‖ / L := by rw [← add_div]; gcongr
    nlinarith [mul_nonneg hu hv]
  unfold envelope
  set a := 1 + ‖u‖ / L
  set b := 1 + ‖v‖ / L
  set c := 1 + ‖η‖ / L
  have ha : 1 ≤ a := by linarith
  have hb : 1 ≤ b := by linarith
  have key : c ^ (n + 1) * a ^ (n + 1) ≤ a ^ (2 * n + 2) * b ^ (2 * n + 2) := by
    have h1 : c ^ (n + 1) ≤ a ^ (n + 1) * b ^ (n + 1) := by
      rw [← mul_pow]; exact pow_le_pow_left₀ (by linarith) hcab _
    have h2 : b ^ (n + 1) ≤ b ^ (2 * n + 2) := pow_le_pow_right₀ hb (by omega)
    have h3 : a ^ (2 * n + 2) = a ^ (n + 1) * a ^ (n + 1) := by rw [← pow_add]; ring_nf
    rw [h3]
    have : 0 ≤ a ^ (n + 1) := by positivity
    calc c ^ (n + 1) * a ^ (n + 1) ≤ a ^ (n + 1) * b ^ (n + 1) * a ^ (n + 1) := by gcongr
      _ ≤ a ^ (n + 1) * b ^ (2 * n + 2) * a ^ (n + 1) := by gcongr
      _ = _ := by ring
  have hpos : 0 < c ^ (n + 1) * a ^ (n + 1) := by positivity
  have e1 : (L ^ n)⁻¹ * (a ^ (2 * n + 2))⁻¹ * ((L ^ n)⁻¹ * (b ^ (2 * n + 2))⁻¹) =
      ((L ^ n)⁻¹ * (L ^ n)⁻¹) * (a ^ (2 * n + 2) * b ^ (2 * n + 2))⁻¹ := by
    rw [mul_inv]; ring
  have e2 : (L ^ n)⁻¹ * (c ^ (n + 1))⁻¹ * ((L ^ n)⁻¹ * (a ^ (n + 1))⁻¹) =
      ((L ^ n)⁻¹ * (L ^ n)⁻¹) * (c ^ (n + 1) * a ^ (n + 1))⁻¹ := by
    rw [mul_inv]; ring
  rw [e1, e2]
  gcongr

/-- Decay of `W_h(u) = φ_L(u) conj φ_L(u + v)` (Blueprint Lemma 3.7 (`lem:periodic`), proof):
`|W_h(u)| ≤ K² B_L(v) B_L(u)`. -/
lemma norm_dilateL_mul_conj_le {φ : EuclideanSpace ℝ (Fin n) → ℂ} {K : ℝ}
    (hK : ∀ x, (1 + ‖x‖) ^ (2 * n + 2) * ‖φ x‖ ≤ K) {L : ℝ} (hL : 0 < L)
    (u v : EuclideanSpace ℝ (Fin n)) :
    ‖dilateL φ L u * conj (dilateL φ L (u + v))‖ ≤ K ^ 2 * (envelope n L v * envelope n L u) := by
  have hK0 : 0 ≤ K := le_trans (by positivity) (hK 0)
  rw [norm_mul, Complex.norm_conj]
  have h1 := norm_dilateL_le hK hL u
  have h2 := norm_dilateL_le hK hL (u + v)
  have h3 := decay_mul_decay_le_envelope (u := u) (v := u + v) (η := v) hL (by
    have := norm_sub_le (u + v) u
    rw [add_sub_cancel_left] at this
    linarith [norm_nonneg u])
  calc ‖dilateL φ L u‖ * ‖dilateL φ L (u + v)‖
      ≤ (K * ((L ^ n)⁻¹ * ((1 + ‖u‖ / L) ^ (2 * n + 2))⁻¹)) *
          (K * ((L ^ n)⁻¹ * ((1 + ‖u + v‖ / L) ^ (2 * n + 2))⁻¹)) :=
        mul_le_mul h1 h2 (norm_nonneg _) (by positivity)
    _ = K ^ 2 * (((L ^ n)⁻¹ * ((1 + ‖u‖ / L) ^ (2 * n + 2))⁻¹) *
          ((L ^ n)⁻¹ * ((1 + ‖u + v‖ / L) ^ (2 * n + 2))⁻¹)) := by ring
    _ ≤ _ := by gcongr

/-- Gradient bound for `W_h` in integrated (Lipschitz) form (Blueprint Lemma 3.7
(`lem:periodic`), proof): for `|w - p| ≤ D L`,
`|W_h(w) - W_h(p)| ≤ 2 K² (1 + D)^{4n+4} (|w - p|/L) B_L(v) B_L(p)`. -/
lemma norm_dilateL_mul_conj_sub_le (φ : 𝓢(EuclideanSpace ℝ (Fin n), ℂ)) {K : ℝ}
    (hK0 : ∀ x, (1 + ‖x‖) ^ (2 * n + 2) * ‖φ x‖ ≤ K)
    (hK1 : ∀ x, (1 + ‖x‖) ^ (2 * n + 2) * ‖fderiv ℝ φ x‖ ≤ K) {L : ℝ} (hL : 0 < L)
    (v p w : EuclideanSpace ℝ (Fin n)) {D : ℝ} (hwp : ‖w - p‖ ≤ D * L) :
    ‖dilateL φ L w * conj (dilateL φ L (w + v)) - dilateL φ L p * conj (dilateL φ L (p + v))‖ ≤
      2 * K ^ 2 * (1 + D) ^ (2 * (2 * n + 2)) * (‖w - p‖ / L) *
        (envelope n L v * envelope n L p) := by
  have hK : 0 ≤ K := le_trans (by positivity) (hK0 0)
  set M := 2 * n + 2
  set t := ‖w - p‖ / L with ht
  have ht0 : 0 ≤ t := by positivity
  have htD : t ≤ D := by rw [ht, div_le_iff₀ hL]; exact hwp
  set X := (L ^ n)⁻¹ * ((1 + ‖p‖ / L) ^ M)⁻¹
  set Y := (L ^ n)⁻¹ * ((1 + ‖p + v‖ / L) ^ M)⁻¹
  have hX : 0 ≤ X := by positivity
  have hY : 0 ≤ Y := by positivity
  set T := (1 + t) ^ M
  have hT : 1 ≤ T := one_le_pow₀ (by linarith)
  have hwv : w + v - (p + v) = w - p := by abel
  have b1 : ‖dilateL φ L w - dilateL φ L p‖ ≤ K * T * t * X := norm_dilateL_sub_le φ hK1 hL p w
  have b2 : ‖dilateL φ L (w + v)‖ ≤ K * T * Y := by
    have := norm_dilateL_le' hK0 hL (p + v) (w + v); rwa [hwv] at this
  have b3 : ‖dilateL φ L p‖ ≤ K * X := norm_dilateL_le hK0 hL p
  have b4 : ‖dilateL φ L (w + v) - dilateL φ L (p + v)‖ ≤ K * T * t * Y := by
    have := norm_dilateL_sub_le φ hK1 hL (p + v) (w + v); rwa [hwv] at this
  have e : dilateL φ L w * conj (dilateL φ L (w + v)) - dilateL φ L p * conj (dilateL φ L (p + v)) =
      (dilateL φ L w - dilateL φ L p) * conj (dilateL φ L (w + v)) +
        dilateL φ L p * conj (dilateL φ L (w + v) - dilateL φ L (p + v)) := by
    rw [map_sub]; ring
  have hXY : X * Y ≤ envelope n L v * envelope n L p :=
    decay_mul_decay_le_envelope hL (by
      have := norm_sub_le (p + v) p
      rw [add_sub_cancel_left] at this
      linarith [norm_nonneg p])
  have hTD : T * T ≤ (1 + D) ^ (2 * M) := by
    rw [← sq, ← pow_mul, mul_comm M 2]
    exact pow_le_pow_left₀ (by linarith) (by linarith) _
  rw [e]
  calc _ ≤ ‖dilateL φ L w - dilateL φ L p‖ * ‖dilateL φ L (w + v)‖ +
        ‖dilateL φ L p‖ * ‖dilateL φ L (w + v) - dilateL φ L (p + v)‖ := by
        refine (norm_add_le _ _).trans ?_
        rw [norm_mul, norm_mul, Complex.norm_conj, Complex.norm_conj]
    _ ≤ (K * T * t * X) * (K * T * Y) + (K * X) * (K * T * t * Y) := by
        gcongr
    _ ≤ (K * T * t * X) * (K * T * Y) + (K * X) * (K * T * t * Y) * T := by
        have : 0 ≤ (K * X) * (K * T * t * Y) := by positivity
        nlinarith
    _ = 2 * K ^ 2 * (T * T) * t * (X * Y) := by ring
    _ ≤ 2 * K ^ 2 * (1 + D) ^ (2 * M) * t * (X * Y) := by gcongr
    _ ≤ 2 * K ^ 2 * (1 + D) ^ (2 * M) * t * (envelope n L v * envelope n L p) := by
        have hD : 0 ≤ D := ht0.trans htD
        exact mul_le_mul_of_nonneg_left hXY (by positivity)

/-! ### Cells `p + [0, Q)^n` and the residue decomposition of `ℤⁿ` -/

/-- The half-open cell `p + [0, Q)^n` in `E`. -/
def cellE (p : EuclideanSpace ℝ (Fin n)) (Q : ℝ) : Set (EuclideanSpace ℝ (Fin n)) :=
  {w | ∀ i, p i ≤ w i ∧ w i < p i + Q}

lemma cellE_eq_preimage (p : EuclideanSpace ℝ (Fin n)) (Q : ℝ) :
    cellE p Q = euclideanEquivPi n ⁻¹' Set.pi Set.univ (fun i => Set.Ico (p i) (p i + Q)) := by
  ext w
  simp only [cellE, Set.mem_ofPred_eq, Set.mem_preimage, Set.mem_pi, Set.mem_univ, Set.mem_Ico,
    true_implies]
  rfl

lemma measurableSet_cellE (p : EuclideanSpace ℝ (Fin n)) (Q : ℝ) : MeasurableSet (cellE p Q) := by
  rw [cellE_eq_preimage]
  exact (euclideanEquivPi n).measurable (MeasurableSet.univ_pi fun _ => measurableSet_Ico)

lemma volume_cellE (p : EuclideanSpace ℝ (Fin n)) {Q : ℝ} (hQ : 0 ≤ Q) :
    volume (cellE p Q) = ENNReal.ofReal (Q ^ n) := by
  rw [cellE_eq_preimage, (measurePreserving_euclideanEquivPi n).measure_preimage
    (MeasurableSet.univ_pi fun _ => measurableSet_Ico).nullMeasurableSet, Real.volume_pi_Ico]
  simp [ENNReal.ofReal_pow hQ]

lemma measureReal_cellE (p : EuclideanSpace ℝ (Fin n)) {Q : ℝ} (hQ : 0 ≤ Q) :
    volume.real (cellE p Q) = Q ^ n := by
  rw [measureReal_def, volume_cellE p hQ, ENNReal.toReal_ofReal (by positivity)]

/-- Points of the cell `p + [0, Q)^n` are within distance `n Q` of `p`. -/
lemma norm_sub_le_of_mem_cellE {p w : EuclideanSpace ℝ (Fin n)} {Q : ℝ} (hQ : 0 ≤ Q)
    (hw : w ∈ cellE p Q) : ‖w - p‖ ≤ n * Q := by
  have h1 : ‖w - p‖ ^ 2 ≤ n * Q ^ 2 := by
    rw [EuclideanSpace.norm_sq_eq]
    calc ∑ i, ‖(w - p) i‖ ^ 2 ≤ ∑ _i : Fin n, Q ^ 2 := by
          refine Finset.sum_le_sum fun i _ => ?_
          have := hw i
          rw [PiLp.sub_apply, Real.norm_eq_abs, sq_abs]
          nlinarith
      _ = n * Q ^ 2 := by simp
  have h2 : (n : ℝ) * Q ^ 2 ≤ (n * Q) ^ 2 := by
    have : (n : ℝ) ≤ (n : ℝ) ^ 2 := by exact_mod_cast Nat.le_self_pow two_ne_zero n
    rw [mul_pow]; exact mul_le_mul_of_nonneg_right this (by positivity)
  exact (pow_le_pow_iff_left₀ (norm_nonneg _) (by positivity) two_ne_zero).1 (h1.trans h2)

/-- Two integers `a, b` with `x ∈ [aQ + s, aQ + s + Q)` and `x ∈ [bQ + s, bQ + s + Q)` coincide. -/
lemma int_eq_of_mem_Ico {a b : ℤ} {Q s x : ℝ} (hQ : 0 < Q)
    (ha : a * Q + s ≤ x ∧ x < a * Q + s + Q) (hb : b * Q + s ≤ x ∧ x < b * Q + s + Q) :
    a = b := by
  have h1 : (a : ℝ) < b + 1 := lt_of_mul_lt_mul_right (by linarith) hQ.le
  have h2 : (b : ℝ) < a + 1 := lt_of_mul_lt_mul_right (by linarith) hQ.le
  have h1' : a < b + 1 := by exact_mod_cast h1
  have h2' : b < a + 1 := by exact_mod_cast h2
  omega

/-- The cells `ι(Qk + s) + [0, Q)^n`, `k ∈ ℤⁿ`, tile `E`, so
`∑_k ∫_{cell k} f = ∫ f` for integrable `f`. -/
lemma hasSum_integral_cellE {f : EuclideanSpace ℝ (Fin n) → ℂ} (hf : Integrable f) {Q : ℕ}
    (hQ : 1 ≤ Q) (s : Fin n → ℤ) :
    HasSum (fun k : Fin n → ℤ => ∫ w in cellE (latEmbed fun i => k i * Q + s i) Q, f w)
      (∫ w, f w) := by
  have hQ0 : (0 : ℝ) < Q := by exact_mod_cast hQ
  set c : (Fin n → ℤ) → Set (EuclideanSpace ℝ (Fin n)) :=
    fun k => cellE (latEmbed fun i => k i * Q + s i) (Q : ℝ) with hc
  have hU : ⋃ k, c k = Set.univ := by
    refine Set.eq_univ_of_forall fun w => Set.mem_iUnion.2 ⟨fun i => ⌊(w i - s i) / Q⌋, fun i => ?_⟩
    have h1 := Int.floor_le ((w i - s i) / Q)
    have h2 := Int.lt_floor_add_one ((w i - s i) / Q)
    rw [le_div_iff₀ hQ0] at h1
    rw [div_lt_iff₀ hQ0] at h2
    have e : latEmbed (fun i => ⌊(w i - s i) / Q⌋ * (Q : ℤ) + s i) i =
        (⌊(w i - s i) / Q⌋ : ℝ) * Q + s i := by
      rw [latEmbed_apply]; push_cast; ring
    rw [e]
    constructor
    · linarith
    · linarith
  have hd : Pairwise (Function.onFun Disjoint c) := by
    intro k k' hkk'
    refine Set.disjoint_left.2 fun w hw hw' => hkk' (funext fun i => ?_)
    have a := hw i
    have b := hw' i
    have e : ∀ k : Fin n → ℤ, latEmbed (fun i => k i * (Q : ℤ) + s i) i = (k i : ℝ) * Q + s i :=
      fun k => by rw [latEmbed_apply]; push_cast; ring
    rw [e] at a b
    exact int_eq_of_mem_Ico hQ0 a b
  have hm : ∀ k, MeasurableSet (c k) := fun k => measurableSet_cellE _ _
  have hi : IntegrableOn f (⋃ k, c k) volume := by rw [hU]; exact hf.integrableOn
  have := hasSum_integral_iUnion hm hd hi
  rwa [hU, Measure.restrict_univ] at this

/-- The coordinatewise division-with-remainder bijection `ℤⁿ ≃ ℤⁿ × (Fin Q)ⁿ`,
`z ↦ (z / Q, z % Q)`. -/
def residueEquiv (n Q : ℕ) [NeZero Q] : (Fin n → ℤ) ≃ (Fin n → ℤ) × (Fin n → Fin Q) :=
  (Equiv.piCongrRight fun _ => Int.divModEquiv Q).trans (Equiv.arrowProdEquivProdArrow _ _ _)

lemma residueEquiv_symm_apply (n Q : ℕ) [NeZero Q] (k : Fin n → ℤ) (r : Fin n → Fin Q) :
    (residueEquiv n Q).symm (k, r) = fun i => k i * Q + ((r i : ℕ) : ℤ) := rfl

/-- Splitting a lattice series into residue classes modulo `Q`:
`∑_z f(z) = ∑_{r ∈ (Fin Q)ⁿ} ∑_k f(Qk + r)`, with each inner series summable. -/
lemma tsum_eq_sum_residues {X : Type*} [NormedAddCommGroup X] [CompleteSpace X] {Q : ℕ}
    [NeZero Q] {f : (Fin n → ℤ) → X} (hf : Summable f) :
    (∀ r : Fin n → Fin Q, Summable fun k : Fin n → ℤ => f fun i => k i * Q + ((r i : ℕ) : ℤ)) ∧
      ∑' z, f z = ∑ r : Fin n → Fin Q, ∑' k : Fin n → ℤ, f fun i => k i * Q + ((r i : ℕ) : ℤ) := by
  set e := (Equiv.prodComm _ _).trans (residueEquiv n Q).symm
  have he : ∀ p : (Fin n → Fin Q) × (Fin n → ℤ), e p = fun i => p.2 i * Q + ((p.1 i : ℕ) : ℤ) :=
    fun _ => rfl
  have hg : Summable (f ∘ e) := e.summable_iff.2 hf
  refine ⟨fun r => hg.prod_factor r, ?_⟩
  rw [← e.tsum_eq, Summable.tsum_prod (f := fun c => f (e c)) hg, tsum_fintype]
  rfl

/-! ### The Riemann-sum comparison on one residue class -/

/-- Riemann-sum comparison on one residue class `s + Qℤⁿ`: if `|W(w) - W(p_k)| ≤ β_k` on the
cell `p_k + [0, Q)^n`, `p_k = ι(Qk + s)`, then `|Q^n ∑_k W(p_k) - ∫ W| ≤ Q^n ∑_k β_k`. -/
lemma norm_riemann_residue_le {W : EuclideanSpace ℝ (Fin n) → ℂ} (hW : Integrable W) {Q : ℕ}
    (hQ : 1 ≤ Q) (s : Fin n → ℤ) {β : (Fin n → ℤ) → ℝ} (hβ : Summable β)
    (hWs : Summable fun k : Fin n → ℤ => W (latEmbed fun i => k i * Q + s i))
    (hb : ∀ k : Fin n → ℤ, ∀ w ∈ cellE (latEmbed fun i => k i * Q + s i) Q,
      ‖W w - W (latEmbed fun i => k i * Q + s i)‖ ≤ β k) :
    ‖(Q : ℂ) ^ n * ∑' k : Fin n → ℤ, W (latEmbed fun i => k i * Q + s i) - ∫ w, W w‖ ≤
      (Q : ℝ) ^ n * ∑' k, β k := by
  have h1 := (hWs.hasSum.mul_left ((Q : ℂ) ^ n)).sub (hasSum_integral_cellE hW hQ s)
  refine h1.norm_le_of_bounded (hβ.hasSum.mul_left ((Q : ℝ) ^ n)) fun k => ?_
  set p := latEmbed fun i => k i * (Q : ℤ) + s i
  have hvol : volume (cellE p (Q : ℝ)) ≠ ⊤ := by
    rw [volume_cellE p (Nat.cast_nonneg Q)]; exact ENNReal.ofReal_ne_top
  have hconst : ∫ _ in cellE p (Q : ℝ), W p = (Q : ℂ) ^ n * W p := by
    rw [setIntegral_const, measureReal_cellE p (Nat.cast_nonneg Q), Complex.real_smul]
    push_cast; ring
  rw [← hconst, ← integral_sub (f := fun _ => W p) (integrableOn_const hvol) hW.integrableOn]
  have := norm_setIntegral_le_of_norm_le_const (μ := volume) (f := fun w => W p - W w)
    (C := β k) hvol.lt_top (fun w hw => by rw [norm_sub_rev]; exact hb k w hw)
  rw [measureReal_cellE p (Nat.cast_nonneg Q)] at this
  linarith

/-! ### Blueprint Lemma 3.7 -/

/-- Continuity of `W_h(w) = φ_L(w) conj φ_L(w + v)`. -/
lemma continuous_dilateL_mul_conj (φ : 𝓢(EuclideanSpace ℝ (Fin n), ℂ)) (L : ℝ)
    (v : EuclideanSpace ℝ (Fin n)) :
    Continuous fun w => dilateL φ L w * conj (dilateL φ L (w + v)) := by
  have hc : Continuous (dilateL φ L) :=
    continuous_const.mul (φ.continuous.comp (continuous_const_smul _))
  exact hc.mul (Complex.continuous_conj.comp (hc.comp (continuous_id.add continuous_const)))

/-- The constant of Blueprint Lemma 3.7 (`lem:periodic`) in terms of a decay constant `K`. -/
noncomputable def periodicConst (n : ℕ) (K : ℝ) : ℝ :=
  2 * K ^ 2 * (1 + n) ^ (2 * (2 * n + 2)) * (n + 1) * envelopeConst n

lemma envelopeConst_nonneg (n : ℕ) : 0 ≤ envelopeConst n := by
  unfold envelopeConst; positivity

/-- Blueprint Lemma 3.7 (`lem:periodic`), last assertion, with explicit decay constant: for
`L > 0` and `v ∈ E`, `W(w) = φ_L(w) conj φ_L(w + v)` is integrable and
`|∫ W| ≤ K² C_n B_L(v)`. -/
lemma integrable_and_norm_integral_dilateL_mul_conj_le {φ : 𝓢(EuclideanSpace ℝ (Fin n), ℂ)}
    {K : ℝ} (hK0 : ∀ x, (1 + ‖x‖) ^ (2 * n + 2) * ‖φ x‖ ≤ K) {L : ℝ} (hL : 0 < L)
    (v : EuclideanSpace ℝ (Fin n)) :
    Integrable (fun w => dilateL φ L w * conj (dilateL φ L (w + v))) ∧
      ‖∫ w, dilateL φ L w * conj (dilateL φ L (w + v))‖ ≤
        K ^ 2 * envelopeConst n * envelope n L v := by
  obtain ⟨hei, heI⟩ := integrable_envelope_and_integral_le (n := n) hL
  have hg : Integrable (fun u => K ^ 2 * envelope n L v * envelope n L u) :=
    hei.const_mul _
  have hb : ∀ u, ‖dilateL φ L u * conj (dilateL φ L (u + v))‖ ≤
      K ^ 2 * envelope n L v * envelope n L u := fun u => by
    rw [mul_assoc]; exact norm_dilateL_mul_conj_le hK0 hL u v
  refine ⟨hg.mono' (continuous_dilateL_mul_conj φ L v).aestronglyMeasurable
    (Filter.Eventually.of_forall hb), ?_⟩
  refine (norm_integral_le_of_norm_le hg (Filter.Eventually.of_forall hb)).trans ?_
  rw [integral_const_mul]
  have : 0 ≤ K ^ 2 * envelope n L v := by have := envelope_nonneg hL v; positivity
  calc K ^ 2 * envelope n L v * ∫ u, envelope n L u ≤ K ^ 2 * envelope n L v * envelopeConst n :=
        mul_le_mul_of_nonneg_left heI this
    _ = _ := by ring

/-- Blueprint Lemma 3.7 (`lem:periodic`), main assertion with explicit decay constant `K`
(see `periodic_riemann_sum` for the statement). -/
lemma periodic_riemann_sum_aux (φ : 𝓢(EuclideanSpace ℝ (Fin n), ℂ)) {K : ℝ}
    (hK0 : ∀ x, (1 + ‖x‖) ^ (2 * n + 2) * ‖φ x‖ ≤ K)
    (hK1 : ∀ x, (1 + ‖x‖) ^ (2 * n + 2) * ‖fderiv ℝ φ x‖ ≤ K)
    {L : ℝ} {Q : ℕ} (hQ : 1 ≤ Q) (hQL : (Q : ℝ) ≤ L) {a : (Fin n → ℤ) → ℂ}
    (ha : ∀ z z' : Fin n → ℤ, (∀ i, z i ≡ z' i [ZMOD Q]) → a z = a z') (ha1 : ∀ z, ‖a z‖ ≤ 1)
    (h : Fin n → ℤ) :
    Summable (fun z => a z * dilateL φ L (latEmbed z) *
        conj (dilateL φ L (latEmbed z + latEmbed h))) ∧
      ‖(∑' z, a z * dilateL φ L (latEmbed z) * conj (dilateL φ L (latEmbed z + latEmbed h))) -
          ((Q : ℂ) ^ n)⁻¹ * (∑ r : Fin n → Fin Q, a fun i => ((r i : ℕ) : ℤ)) *
            ∫ w, dilateL φ L w * conj (dilateL φ L (w + latEmbed h))‖ ≤
        periodicConst n K * (Q / L) * latEnvelope n L h ∧
      ‖∫ w, dilateL φ L w * conj (dilateL φ L (w + latEmbed h))‖ ≤
        periodicConst n K * latEnvelope n L h := by
  have : NeZero Q := ⟨by omega⟩
  have hK : 0 ≤ K := le_trans (by positivity) (hK0 0)
  have hQ0 : (0 : ℝ) < Q := by exact_mod_cast hQ
  have hL1 : 1 ≤ L := le_trans (by exact_mod_cast hQ) hQL
  have hL : 0 < L := by linarith
  set v := latEmbed h
  set W : EuclideanSpace ℝ (Fin n) → ℂ := fun w => dilateL φ L w * conj (dilateL φ L (w + v))
    with hWdef
  obtain ⟨hWi, hWI⟩ := integrable_and_norm_integral_dilateL_mul_conj_le hK0 hL v
  have hev : 0 ≤ envelope n L v := envelope_nonneg hL v
  have hCn := envelopeConst_nonneg n
  obtain ⟨hlat, hlatI⟩ := summable_latEnvelope_and_tsum_le (n := n) hL1
  -- the lattice series
  have hWb : ∀ z, ‖W (latEmbed z)‖ ≤ K ^ 2 * envelope n L v * latEnvelope n L z := fun z => by
    rw [mul_assoc]; exact norm_dilateL_mul_conj_le hK0 hL _ v
  have hWs : Summable fun z => W (latEmbed z) := (hlat.mul_left _).of_norm_bounded hWb
  have hF : (fun z => a z * dilateL φ L (latEmbed z) * conj (dilateL φ L (latEmbed z + v))) =
      fun z => a z * W (latEmbed z) := by
    funext z; simp only [hWdef, mul_assoc]
  have hFs : Summable fun z => a z * W (latEmbed z) :=
    (hlat.mul_left (K ^ 2 * envelope n L v)).of_norm_bounded fun z => by
      rw [norm_mul]
      calc ‖a z‖ * ‖W (latEmbed z)‖ ≤ 1 * (K ^ 2 * envelope n L v * latEnvelope n L z) :=
            mul_le_mul (ha1 z) (hWb z) (norm_nonneg _) zero_le_one
        _ = _ := one_mul _
  -- the constant of the last assertion
  have hC1 : K ^ 2 * envelopeConst n ≤ periodicConst n K := by
    unfold periodicConst
    have h1 : (1 : ℝ) ≤ (1 + (n : ℝ)) ^ (2 * (2 * n + 2)) := one_le_pow₀ (by linarith [n.cast_nonneg (α := ℝ)])
    have h2 : (1 : ℝ) ≤ n + 1 := by linarith [n.cast_nonneg (α := ℝ)]
    have h3 : 0 ≤ K ^ 2 * envelopeConst n := by positivity
    have h4 : (1 : ℝ) ≤ 2 * (1 + n) ^ (2 * (2 * n + 2)) * (n + 1) := by nlinarith
    nlinarith
  refine ⟨by rw [hF]; exact hFs, ?_, hWI.trans (mul_le_mul_of_nonneg_right hC1 hev)⟩
  rw [hF]
  -- residue decomposition
  set rr : (Fin n → Fin Q) → (Fin n → ℤ) := fun r i => ((r i : ℕ) : ℤ)
  set P : (Fin n → Fin Q) → (Fin n → ℤ) → (Fin n → ℤ) := fun r k i => k i * Q + rr r i
  obtain ⟨hFr, hFsum⟩ := tsum_eq_sum_residues (Q := Q) hFs
  obtain ⟨hWr, -⟩ := tsum_eq_sum_residues (Q := Q) hWs
  obtain ⟨hlr, hlsum⟩ := tsum_eq_sum_residues (Q := Q) hlat
  have hper : ∀ r k, a (P r k) = a (rr r) := fun r k =>
    ha _ _ fun i => (Int.modEq_iff_dvd.2 ⟨k i, by simp only [P]; ring⟩).symm
  set S : (Fin n → Fin Q) → ℂ := fun r => ∑' k, W (latEmbed (P r k))
  set T : (Fin n → Fin Q) → ℝ := fun r => ∑' k, latEnvelope n L (P r k)
  set c0 : ℝ := 2 * K ^ 2 * (1 + n) ^ (2 * (2 * n + 2)) * (n * Q / L) * envelope n L v
  have hc0 : 0 ≤ c0 := by positivity
  -- the Riemann sum estimate on each residue class
  have hres : ∀ r, ‖(Q : ℂ) ^ n * S r - ∫ w, W w‖ ≤ (Q : ℝ) ^ n * (c0 * T r) := by
    intro r
    have := norm_riemann_residue_le hWi hQ (rr r) ((hlr r).mul_left c0) (hWr r)
      (fun k w hw => by
        have hwp := norm_sub_le_of_mem_cellE (Nat.cast_nonneg Q) hw
        have hwp' : ‖w - latEmbed (P r k)‖ ≤ n * L :=
          hwp.trans (mul_le_mul_of_nonneg_left hQL n.cast_nonneg)
        refine (norm_dilateL_mul_conj_sub_le φ hK0 hK1 hL v _ w hwp').trans ?_
        have hen := envelope_nonneg hL (latEmbed (P r k))
        have : ‖w - latEmbed (P r k)‖ / L ≤ n * Q / L := by gcongr
        calc 2 * K ^ 2 * (1 + (n : ℝ)) ^ (2 * (2 * n + 2)) * (‖w - latEmbed (P r k)‖ / L) *
              (envelope n L v * envelope n L (latEmbed (P r k)))
            ≤ 2 * K ^ 2 * (1 + (n : ℝ)) ^ (2 * (2 * n + 2)) * (n * Q / L) *
              (envelope n L v * envelope n L (latEmbed (P r k))) := by gcongr
          _ = c0 * latEnvelope n L (P r k) := by simp only [c0, latEnvelope]; ring)
    rwa [tsum_mul_left] at this
  -- assemble
  have hsplit : ∑' z, a z * W (latEmbed z) = ∑ r, a (rr r) * S r := by
    rw [hFsum]
    refine Finset.sum_congr rfl fun r _ => ?_
    simp only [S, ← tsum_mul_left]
    refine tsum_congr fun k => ?_
    rw [← hper r k]
  have hQn : ((Q : ℂ) ^ n) ≠ 0 := pow_ne_zero _ (by exact_mod_cast (NeZero.ne Q))
  have hdiff : ∑' z, a z * W (latEmbed z) - ((Q : ℂ) ^ n)⁻¹ * (∑ r, a (rr r)) * ∫ w, W w =
      ∑ r, a (rr r) * ((Q : ℂ) ^ n)⁻¹ * ((Q : ℂ) ^ n * S r - ∫ w, W w) := by
    rw [hsplit, Finset.mul_sum, Finset.sum_mul, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun r _ => ?_
    field_simp
  rw [hdiff]
  have hQnR : (0 : ℝ) < (Q : ℝ) ^ n := by positivity
  calc ‖∑ r, a (rr r) * ((Q : ℂ) ^ n)⁻¹ * ((Q : ℂ) ^ n * S r - ∫ w, W w)‖
      ≤ ∑ r, ‖a (rr r) * ((Q : ℂ) ^ n)⁻¹ * ((Q : ℂ) ^ n * S r - ∫ w, W w)‖ := norm_sum_le _ _
    _ ≤ ∑ r, c0 * T r := by
        refine Finset.sum_le_sum fun r _ => ?_
        rw [norm_mul, norm_mul, norm_inv, norm_pow, Complex.norm_natCast]
        calc ‖a (rr r)‖ * ((Q : ℝ) ^ n)⁻¹ * ‖(Q : ℂ) ^ n * S r - ∫ w, W w‖
            ≤ 1 * ((Q : ℝ) ^ n)⁻¹ * ((Q : ℝ) ^ n * (c0 * T r)) := by
              gcongr
              · exact ha1 _
              · exact hres r
          _ = c0 * T r := by field_simp
    _ = c0 * ∑' z, latEnvelope n L z := by rw [← Finset.mul_sum, hlsum]
    _ ≤ c0 * envelopeConst n := mul_le_mul_of_nonneg_left hlatI hc0
    _ ≤ periodicConst n K * (Q / L) * latEnvelope n L h := by
        simp only [c0, periodicConst, latEnvelope]
        have hQL' : 0 ≤ (Q : ℝ) / L := by positivity
        have e1 : 2 * K ^ 2 * (1 + (n : ℝ)) ^ (2 * (2 * n + 2)) * (n * Q / L) * envelope n L v *
            envelopeConst n = (2 * K ^ 2 * (1 + (n : ℝ)) ^ (2 * (2 * n + 2)) * envelopeConst n *
              (Q / L) * envelope n L v) * n := by ring
        have e2 : 2 * K ^ 2 * (1 + (n : ℝ)) ^ (2 * (2 * n + 2)) * (n + 1) * envelopeConst n *
            (Q / L) * envelope n L v = (2 * K ^ 2 * (1 + (n : ℝ)) ^ (2 * (2 * n + 2)) *
              envelopeConst n * (Q / L) * envelope n L v) * (n + 1) := by ring
        rw [e1, e2]
        gcongr
        linarith

/-- Blueprint Lemma 3.7 (`lem:periodic`) ("Averaging a periodic phase against a smooth weight").
Fix a Schwartz function `φ` on `E` and put `φ_L(z) = L^{-n} φ(z/L)` (`dilateL φ L`). There is a
constant `C` (depending only on `n` and `φ`) such that for all real `L` and natural `Q` with
`1 ≤ Q ≤ L`, every `a : ℤⁿ → ℂ` which is `Q`-periodic in every coordinate (`a z = a z'` whenever
`z ≡ z' (mod Q)` coordinatewise) with `|a| ≤ 1`, and every `h ∈ ℤⁿ`:
* the series `∑_{z ∈ ℤⁿ} a(z) φ_L(z) conj φ_L(z + h)` is summable;
* `∑_z a(z) φ_L(z) conj φ_L(z + h) = (Q^{-n} ∑_{r mod Q} a(r)) ∫_E φ_L(w) conj φ_L(w + h) dw
  + O((Q/L) B_L(h))`, with the residues `r` ranging over `{0, …, Q-1}ⁿ` and the error bounded by
  `C (Q/L) B_L(h)` (`B_L = latEnvelope n L`);
* `|∫_E φ_L(w) conj φ_L(w + h) dw| ≤ C B_L(h)`. -/
theorem periodic_riemann_sum (φ : 𝓢(EuclideanSpace ℝ (Fin n), ℂ)) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (L : ℝ) (Q : ℕ), 1 ≤ Q → (Q : ℝ) ≤ L →
      ∀ a : (Fin n → ℤ) → ℂ, (∀ z z' : Fin n → ℤ, (∀ i, z i ≡ z' i [ZMOD Q]) → a z = a z') →
      (∀ z, ‖a z‖ ≤ 1) → ∀ h : Fin n → ℤ,
        Summable (fun z => a z * dilateL φ L (latEmbed z) *
            conj (dilateL φ L (latEmbed z + latEmbed h))) ∧
        ‖(∑' z, a z * dilateL φ L (latEmbed z) *
              conj (dilateL φ L (latEmbed z + latEmbed h))) -
            ((Q : ℂ) ^ n)⁻¹ * (∑ r : Fin n → Fin Q, a fun i => ((r i : ℕ) : ℤ)) *
              ∫ w, dilateL φ L w * conj (dilateL φ L (w + latEmbed h))‖ ≤
          C * (Q / L) * latEnvelope n L h ∧
        ‖∫ w, dilateL φ L w * conj (dilateL φ L (w + latEmbed h))‖ ≤ C * latEnvelope n L h := by
  obtain ⟨K, hK, hKb⟩ := exists_schwartz_decay φ (2 * n + 2)
  refine ⟨periodicConst n K, by unfold periodicConst; have := envelopeConst_nonneg n; positivity,
    fun L Q hQ hQL a ha ha1 h => periodic_riemann_sum_aux φ (fun x => (hKb x).1)
      (fun x => (hKb x).2) hQ hQL ha ha1 h⟩

/-- Blueprint Lemma 3.7 (`lem:periodic`), last assertion, for every scale `L > 0`: there is `C`
depending only on `n` and `φ` with `|∫_E φ_L(w) conj φ_L(w + v) dw| ≤ C B_L(v)` for all `v ∈ E`
(and the integrand is integrable). -/
theorem norm_integral_dilateL_mul_conj_le (φ : 𝓢(EuclideanSpace ℝ (Fin n), ℂ)) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (L : ℝ), 0 < L → ∀ v : EuclideanSpace ℝ (Fin n),
      Integrable (fun w => dilateL φ L w * conj (dilateL φ L (w + v))) ∧
        ‖∫ w, dilateL φ L w * conj (dilateL φ L (w + v))‖ ≤ C * envelope n L v := by
  obtain ⟨K, hK, hKb⟩ := exists_schwartz_decay φ (2 * n + 2)
  refine ⟨K ^ 2 * envelopeConst n, by have := envelopeConst_nonneg n; positivity,
    fun L hL v => integrable_and_norm_integral_dilateL_mul_conj_le (fun x => (hKb x).1) hL v⟩

end PeriodicDecay

end Auto
