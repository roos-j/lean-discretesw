  have hc0 : 0 < c := mul_pos hε (Real.log_pos one_lt_two)
  set M := max 1 (1 / c)
  have hM1 : 1 ≤ M := le_max_left _ _
  have hMc : 1 ≤ M * c := by
    have : 1 / c ≤ M := le_max_right _ _
    rw [div_le_iff₀ hc0] at this; linarith
  have hexp : 1 + c * a ≤ (2 : ℝ) ^ (ε * a) := by
    rw [Real.rpow_def_of_pos two_pos]
    have := Real.add_one_le_exp (Real.log 2 * (ε * a))
    have : Real.log 2 * (ε * a) = c * a := by rw [hc]; ring
    linarith
  have ha : (0 : ℝ) ≤ a := Nat.cast_nonneg a
  have : M * (1 + c * a) ≤ M * (2 : ℝ) ^ (ε * a) :=
    mul_le_mul_of_nonneg_left hexp (by linarith)
  nlinarith

